# kriya — primary unit-test suite.
# Stdlib auto-included via cyrius.cyml. We explicitly include the
# project-local source files we exercise so this suite stays
# independent of the dispatcher entry point in src/main.cyr.

# ⚠ M15e, third occurrence. `src/lib/help.cyr` reads `_VERSION_KRIYA` for
# `--version`, so this subset build needs the generated version file too.
# Cyrius only rejects REACHABLE undefined symbols, so a missing include here
# stays green until something in the subset actually touches it — which is why
# this trap keeps firing on the release that adds the first reference, not the
# one that adds the include.
include "src/version_str.cyr"
include "src/lib/exit.cyr"
include "src/lib/errmsg.cyr"
include "src/lib/sys.cyr"
include "src/lib/path.cyr"
# ⚠ M15e, PRE-EMPTIVELY. `src/cmd/find.cyr` (included below) now calls into
# `src/lib/glob.cyr`, and cyrius only rejects REACHABLE undefined symbols — so
# omitting this would stay green until something in the subset touched it. That
# trap has fired three times; this include is added with the reference, not
# after the build breaks.
include "src/lib/glob.cyr"
include "src/lib/str.cyr"
# ⚠ M15e, PRE-EMPTIVELY again. `src/lib/icase.cyr` is exercised directly below;
# `grep.cyr` and `find.cyr` are its live callers but neither is in this subset,
# so a missing include would stay green until one of them arrived.
include "src/lib/icase.cyr"
include "src/lib/fs.cyr"
include "src/lib/protected.cyr"
include "src/lib/args.cyr"
# ⚠ `args.cyr` calls into `help.cyr` since v1.3.0 (`--help` is intercepted in
# `kriya_args_parse_range`), so a subset build must include it too. This is the
# roadmap M15e trap: cyrius only rejects REACHABLE undefined functions, so a
# missing include stays green until something calls it.
include "src/lib/help.cyr"
include "src/cmd/true.cyr"
include "src/cmd/false.cyr"
# ⚠ M15e again. `nl.cyr` and `echo.cyr` are pulled in for their PURE helpers —
# the regex-operator guard, the section classifier, the option-cluster test.
# Nothing here runs a command; these are the parts that are testable without a
# file descriptor, and they are the parts most likely to be quietly wrong.
include "src/cmd/echo.cyr"
include "src/cmd/nl.cyr"

# ⭐ The modes the real callers use, so a test reads as "FORMAT says this, `%b`
# says that" rather than as a bitmask.
#
# ⛔ These are literals because a `var` with an EXPRESSION initializer costs a
# gvar_toks slot — which makes them silently driftable, and they DID drift: 1.4.4
# added `STR_ESC_DQUOTE` and `MODE_FMT = 6` went stale, turning a correct `\"`
# assertion into a failure with no hint of the cause. The `mode constants` group
# below now PINS each literal against the enum, so the next added bit fails on a
# line that names the problem.
var MODE_FMT  = 14;  # ALLOW_C | ALLOW_X | DQUOTE            — printf FORMAT
var MODE_B    = 15;  # ...| OCTAL_PREFIX                     — printf %b
var MODE_ECHO = 7;   # ALLOW_C | ALLOW_X | OCTAL_PREFIX      — echo -e (no DQUOTE)

# Decode the escape at the START of `lit`, which must begin with a backslash.
# `strlen` for the bound is the same thing printf's callers pass.
fn _t_esc(lit, mode, out): i64 {
    return str_escape_decode(lit, 0, strlen(lit), mode, out);
}

# Rewrite `pat` and return the new pattern, storing the verdict via `err_p`.
# ⚠ `strlen` for the bound is exactly what grep's and find's call sites pass.
fn _t_rw(pat, mode, err_p): i64 {
    var len: i64 = 0;
    return icase_rewrite(pat, strlen(pat), mode, &len, err_p);
}

fn main() {
    alloc_init();

    test_group("exit codes");
    assert_eq(EXIT_SUCCESS, 0, "EXIT_SUCCESS == 0");
    assert_eq(EXIT_FAILURE, 1, "EXIT_FAILURE == 1");
    assert_eq(EXIT_USAGE,   2, "EXIT_USAGE == 2");

    test_group("cmd_true / cmd_false");
    assert_eq(cmd_true(1),  EXIT_SUCCESS, "cmd_true returns EXIT_SUCCESS");
    assert_eq(cmd_false(1), EXIT_FAILURE, "cmd_false returns EXIT_FAILURE");

    test_group("path_basename_ptr");
    assert_eq(streq(path_basename_ptr("/usr/bin/cp"),   "cp"),    1, "/usr/bin/cp -> cp");
    assert_eq(streq(path_basename_ptr("cp"),            "cp"),    1, "cp -> cp");
    assert_eq(streq(path_basename_ptr("/cp"),           "cp"),    1, "/cp -> cp");
    assert_eq(streq(path_basename_ptr("./cp"),          "cp"),    1, "./cp -> cp");
    assert_eq(streq(path_basename_ptr("/"),             "/"),     1, "/ -> /");
    assert_eq(streq(path_basename_ptr(""),              ""),      1, "empty -> empty");
    # Trailing slashes are a caller-must-trim invariant for this fast
    # pointer-only function — see path.cyr header. `path_normalize`
    # produces canonical input.

    test_group("path_basename_len");
    assert_eq(path_basename_len("/usr/bin/cp"), 2, "/usr/bin/cp -> 2");
    assert_eq(path_basename_len("cp"),          2, "cp -> 2");
    assert_eq(path_basename_len("/a/b/"),       1, "/a/b/ -> 1 (b, trim trailing)");
    assert_eq(path_basename_len("/"),           1, "/ -> 1");
    assert_eq(path_basename_len(""),            0, "empty -> 0");
    assert_eq(path_basename_len("foo.log"),     7, "foo.log -> 7");
    assert_eq(path_basename_len("/path/to/foo.log"), 7, "/path/to/foo.log -> 7");
    assert_eq(path_basename_len(0),             0, "null -> 0");

    test_group("path_is_absolute");
    assert_eq(path_is_absolute("/foo"),  1, "/foo is absolute");
    assert_eq(path_is_absolute("foo"),   0, "foo is relative");
    assert_eq(path_is_absolute("./foo"), 0, "./foo is relative");
    assert_eq(path_is_absolute(""),      0, "empty is not absolute");
    assert_eq(path_is_absolute(0),       0, "null is not absolute");

    test_group("path_dirname");
    assert_eq(streq(path_dirname("/a/b/c"), "/a/b"), 1, "/a/b/c -> /a/b");
    assert_eq(streq(path_dirname("a/b"),    "a"),    1, "a/b -> a");
    assert_eq(streq(path_dirname("a"),      "."),    1, "a -> .");
    assert_eq(streq(path_dirname("/a"),     "/"),    1, "/a -> /");
    assert_eq(streq(path_dirname("/"),      "/"),    1, "/ -> /");
    assert_eq(streq(path_dirname(""),       "."),    1, "empty -> .");

    test_group("path_normalize");
    assert_eq(streq(path_normalize(""),               "."),    1, "empty -> .");
    assert_eq(streq(path_normalize("."),              "."),    1, ". -> .");
    assert_eq(streq(path_normalize("/"),              "/"),    1, "/ -> /");
    assert_eq(streq(path_normalize("/a/./b"),         "/a/b"), 1, "collapse .");
    assert_eq(streq(path_normalize("/a/b/../c"),      "/a/c"), 1, ".. pops segment");
    assert_eq(streq(path_normalize("/../../a"),       "/a"),   1, "root absorbs ..");
    assert_eq(streq(path_normalize("a/../../b"),      "../b"), 1, "relative keeps leading ..");
    assert_eq(streq(path_normalize("/a/b/"),          "/a/b"), 1, "trailing slash dropped");
    assert_eq(streq(path_normalize("//a//b"),         "/a/b"), 1, "duplicate slashes collapsed");

    test_group("path_join");
    assert_eq(streq(path_join("/a/b", "c"),    "/a/b/c"), 1, "simple join");
    assert_eq(streq(path_join("/a/b/", "c"),   "/a/b/c"), 1, "trailing slash on a");
    assert_eq(streq(path_join("/a", "/b"),     "/b"),     1, "absolute b wins");
    assert_eq(streq(path_join("", "b"),        "b"),      1, "empty a");
    assert_eq(streq(path_join("a", ""),        "a/"),     1, "empty b appends slash");

    test_group("path_is_under");
    assert_eq(path_is_under("/a/b",   "/a/b/c"),       1, "child is under parent");
    assert_eq(path_is_under("/a/b",   "/a/b"),         1, "self is under self");
    assert_eq(path_is_under("/a/b",   "/a/bb"),        0, "prefix-name mismatch");
    assert_eq(path_is_under("/a/b",   "/a/b/../c"),    0, ".. escapes");
    assert_eq(path_is_under("/a",     "/b"),           0, "different root");

    test_group("errmsg_for");
    assert_eq(streq(errmsg_for(1),  "operation not permitted"),       1, "EPERM");
    assert_eq(streq(errmsg_for(2),  "no such file or directory"),     1, "ENOENT");
    assert_eq(streq(errmsg_for(13), "permission denied"),             1, "EACCES");
    assert_eq(streq(errmsg_for(17), "file exists"),                   1, "EEXIST");
    assert_eq(streq(errmsg_for(21), "is a directory"),                1, "EISDIR");
    assert_eq(streq(errmsg_for(32), "broken pipe"),                   1, "EPIPE");
    assert_eq(streq(errmsg_for(999), "unknown error"),                1, "unmapped errno");
    assert_eq(errmsg_is_known(1),   1, "EPERM is known");
    assert_eq(errmsg_is_known(40),  1, "ELOOP boundary");
    assert_eq(errmsg_is_known(0),   0, "0 is not known");
    assert_eq(errmsg_is_known(41),  0, "41 above table");

    test_group("kriya_parse_nonneg_int");
    assert_eq(kriya_parse_nonneg_int("0"),    0,        "\"0\" -> 0");
    assert_eq(kriya_parse_nonneg_int("1"),    1,        "\"1\" -> 1");
    assert_eq(kriya_parse_nonneg_int("42"),   42,       "\"42\" -> 42");
    assert_eq(kriya_parse_nonneg_int("1000"), 1000,     "\"1000\" -> 1000");
    assert_eq(kriya_parse_nonneg_int(""),     0 - 1,    "empty string -> -1");
    assert_eq(kriya_parse_nonneg_int("abc"),  0 - 1,    "non-digit -> -1");
    assert_eq(kriya_parse_nonneg_int("12a"),  0 - 1,    "trailing non-digit -> -1");
    assert_eq(kriya_parse_nonneg_int("-1"),   0 - 1,    "leading sign -> -1");
    assert_eq(kriya_parse_nonneg_int(0),      0 - 1,    "null pointer -> -1");

    test_group("kriya_parse_octal_mode");
    # Comparisons are decimal: 0o755=493, 0o700=448, 0o644=420,
    # 0o777=511, 0o7=7, 0o70=56, 0o1000=512 (out of range).
    assert_eq(kriya_parse_octal_mode("0"),     0,      "\"0\" -> 0");
    assert_eq(kriya_parse_octal_mode("7"),     7,      "\"7\" -> 7");
    assert_eq(kriya_parse_octal_mode("70"),    56,     "\"70\" -> 56");
    assert_eq(kriya_parse_octal_mode("755"),   493,    "\"755\" -> 0o755");
    assert_eq(kriya_parse_octal_mode("0755"),  493,    "\"0755\" -> 0o755");
    assert_eq(kriya_parse_octal_mode("700"),   448,    "\"700\" -> 0o700");
    assert_eq(kriya_parse_octal_mode("0644"),  420,    "\"0644\" -> 0o644");
    assert_eq(kriya_parse_octal_mode("777"),   511,    "\"777\" -> 0o777");
    assert_eq(kriya_parse_octal_mode("7777"),  4095,   "\"7777\" -> 0o7777 (full 12-bit)");
    assert_eq(kriya_parse_octal_mode(""),      0 - 1,  "empty -> -1");
    assert_eq(kriya_parse_octal_mode("8"),     0 - 1,  "non-octal digit 8 -> -1");
    assert_eq(kriya_parse_octal_mode("9"),     0 - 1,  "non-octal digit 9 -> -1");
    assert_eq(kriya_parse_octal_mode("u+x"),   0 - 1,  "symbolic mode -> -1 (deferred to chmod)");
    assert_eq(kriya_parse_octal_mode("10000"), 0 - 1,  "value 0o10000 overflows 12 bits -> -1");
    assert_eq(kriya_parse_octal_mode("755a"),  0 - 1,  "trailing non-digit -> -1");
    assert_eq(kriya_parse_octal_mode("-1"),    0 - 1,  "leading sign -> -1");
    assert_eq(kriya_parse_octal_mode(0),       0 - 1,  "null pointer -> -1");


    # =================================================================
    # ADR 0004 root guard — the highest-consequence predicate in kriya.
    #
    # ⛔ THESE ARE NOT STYLE TESTS. `is_protected_path` is the only thing
    # standing between a mistyped `rm -rf` operand and the filesystem, and it
    # decides purely on TEXT: `fs_path_absolute` then a string compare against
    # the table. That makes it exactly as strong as `path_normalize`'s handling
    # of `..`, `.` and duplicate slashes — so every spelling of "/" that a shell
    # can produce is pinned here rather than trusted.
    #
    # ⚠ There is no safe way to test this end-to-end: exercising it through
    # `rm` means running `rm` against `/` and finding out. The predicate is the
    # test surface, and it has to carry the whole weight.
    # =================================================================
    test_group("is_protected_path — every route to /");
    assert_eq(is_protected_path("/"),                 1, "/ is protected");
    assert_eq(is_protected_path("//"),                1, "// -> /");
    assert_eq(is_protected_path("///"),               1, "/// -> /");
    assert_eq(is_protected_path("/."),                1, "/. -> /");
    assert_eq(is_protected_path("/./"),               1, "/./ -> /");
    assert_eq(is_protected_path("/.."),               1, "/.. -> / (no walk above root)");
    assert_eq(is_protected_path("/../"),              1, "/../ -> /");
    assert_eq(is_protected_path("/../.."),            1, "/../.. -> /");
    assert_eq(is_protected_path("/./././"),           1, "/./././ -> /");
    assert_eq(is_protected_path("//..//"),            1, "//..// -> / (dup slashes + ..)");
    assert_eq(is_protected_path("/home/.."),          1, "/home/.. -> /");
    assert_eq(is_protected_path("/home/../"),         1, "/home/../ -> /");
    assert_eq(is_protected_path("/usr/bin/../../"),   1, "/usr/bin/../../ -> /");
    assert_eq(is_protected_path("/nonexistent/.."),   1, ".. through a missing dir still -> / (text-only)");

    test_group("is_protected_path — must NOT over-refuse");
    assert_eq(is_protected_path("/home"),             0, "/home is not protected");
    assert_eq(is_protected_path("/tmp"),              0, "/tmp is not protected");
    assert_eq(is_protected_path("/home/.."),          1, "(control: /home/.. IS /)");
    assert_eq(is_protected_path("/home/..x"),         0, "/home/..x is a name, not a walk");
    assert_eq(is_protected_path("/..."),              0, "/... is a name, not a walk");

    # =================================================================
    # fs_path_absolute — the frame both the root guard and cp's
    # copy-into-itself check compare in. Absolute inputs must be a pure
    # normalize; that is the half the guard depends on.
    # =================================================================
    test_group("fs_path_absolute");
    assert_eq(streq(fs_path_absolute("/a/b"),        "/a/b"), 1, "already absolute -> normalized");
    assert_eq(streq(fs_path_absolute("/a//b"),       "/a/b"), 1, "duplicate slash collapses");
    assert_eq(streq(fs_path_absolute("/a/./b"),      "/a/b"), 1, "single dot drops");
    assert_eq(streq(fs_path_absolute("/a/c/../b"),   "/a/b"), 1, ".. resolves textually");
    assert_eq(streq(fs_path_absolute("/a/b/"),       "/a/b"), 1, "trailing slash trims");
    assert_eq(streq(fs_path_absolute("/"),           "/"),    1, "/ stays /");
    assert_eq(streq(fs_path_absolute(0),             "/"),    1, "null operand -> /");

    # =================================================================
    # path_is_under — the component-boundary rule. cp's copy-into-itself
    # guard rides on this, so a prefix-without-boundary match would make
    # cp refuse legitimate copies (/var vs /variable).
    # =================================================================
    test_group("path_is_under — component boundaries");
    assert_eq(path_is_under("/a", "/a"),        1, "a path is under itself");
    assert_eq(path_is_under("/a", "/a/b"),      1, "child is under parent");
    assert_eq(path_is_under("/a", "/a/b/c"),    1, "grandchild is under parent");
    assert_eq(path_is_under("/var", "/variable"), 0, "/variable is NOT under /var");
    assert_eq(path_is_under("/a/b", "/a"),      0, "parent is not under child");
    assert_eq(path_is_under("/a", "/b"),        0, "siblings are unrelated");
    assert_eq(path_is_under("/a", "/a/../b"),   0, ".. in the candidate normalizes out first");

    # =================================================================
    # glob_match — lifted out of find.cyr at 1.4.1 and shared with grep.
    # ⭐ Being in src/lib/ is what makes it unit-testable at all: buried in
    # find.cyr it could only ever be exercised end-to-end through `find -name`,
    # so its bracket and backtracking edges had no direct coverage. Two callers
    # with different needs (find sees one path COMPONENT, grep may see a whole
    # path) is exactly when those edges start to matter.
    # =================================================================
    test_group("glob_match — literals, wildcards, brackets");
    assert_eq(glob_match("abc", 3, "abc", 3),      1, "exact literal matches");
    assert_eq(glob_match("abc", 3, "abd", 3),      0, "one byte different fails");
    assert_eq(glob_match("", 0, "", 0),            1, "empty pattern matches empty text");
    assert_eq(glob_match("", 0, "a", 1),           0, "empty pattern does not match text");
    assert_eq(glob_match("*", 1, "", 0),           1, "* matches the empty string");
    assert_eq(glob_match("*", 1, "anything", 8),   1, "* matches everything");
    assert_eq(glob_match("*.c", 3, "main.c", 6),   1, "suffix glob");
    assert_eq(glob_match("*.c", 3, "main.h", 6),   0, "suffix glob rejects");
    assert_eq(glob_match("a?c", 3, "abc", 3),      1, "? matches exactly one");
    assert_eq(glob_match("a?c", 3, "ac", 2),       0, "? does not match zero");
    assert_eq(glob_match("a?c", 3, "abbc", 4),     0, "? does not match two");

    test_group("glob_match — brackets");
    assert_eq(glob_match("[abc]", 5, "b", 1),      1, "bracket set hit");
    assert_eq(glob_match("[abc]", 5, "d", 1),      0, "bracket set miss");
    assert_eq(glob_match("[a-z]", 5, "q", 1),      1, "range hit");
    assert_eq(glob_match("[a-z]", 5, "Q", 1),      0, "range is byte-exact, not case-folded");
    assert_eq(glob_match("[!a]", 4, "b", 1),       1, "negation admits others");
    assert_eq(glob_match("[!a]", 4, "a", 1),       0, "negation rejects the listed byte");
    assert_eq(glob_match("[a-", 3, "a", 1),        0, "unterminated bracket does not match");

    test_group("glob_match — backtracking and slashes");
    # ⚠ The backtrack path: a pattern that must retry the star repeatedly.
    assert_eq(glob_match("*a*a*a*", 7, "aaa", 3),          1, "repeated stars backtrack");
    assert_eq(glob_match("*a*a*a*", 7, "aa", 2),           0, "backtracking still rejects");
    assert_eq(glob_match("*x", 2, "aaaaaaaaaaaaaaaax", 17), 1, "long text, trailing anchor");
    # ⛔ `*` CROSSES `/`. Correct for `find -name`, which is handed a single path
    # component, and it is what lets a `grep --include` pattern containing a
    # slash match against a whole path. A caller wanting segment-awareness must
    # split the path itself — the matcher does not do it for them.
    assert_eq(glob_match("*.c", 3, "sub/main.c", 10),      1, "* crosses a slash");
    assert_eq(glob_match("sub/*.c", 7, "sub/main.c", 10),  1, "pattern may contain a slash");
    assert_eq(glob_match("a/*", 3, "a/b/c", 5),            1, "* spans multiple segments");

    # ⭐ `str_escape_decode` is unit-testable at all BECAUSE it is pure — the two
    # decoders it replaced wrote straight to fd 1, so the only way to check them
    # was to run the binary and read bytes back. Every case below was measured
    # against GNU coreutils 9.11 first; `scripts/smoke-printf.sh` re-checks the
    # same ground end-to-end through the real binary.
    var esc[STR_ESC_OUT_SIZE];

    test_group("str_escape_decode — named escapes");
    assert_eq(_t_esc("\\n", MODE_FMT, &esc), STR_ESC_BYTE, "\\n decodes");
    assert_eq(load64(&esc + STR_ESC_O_BYTE), 10, "\\n is 0x0a");
    assert_eq(load64(&esc + STR_ESC_O_LEN),   2, "\\n consumes 2");
    # ⚠ The escape that was in NEITHER old copy. GNU has had it since 8.1 (2009).
    _t_esc("\\e", MODE_FMT, &esc);
    assert_eq(load64(&esc + STR_ESC_O_BYTE), 27, "\\e is 0x1b (ESC)");
    _t_esc("\\a", MODE_FMT, &esc);
    assert_eq(load64(&esc + STR_ESC_O_BYTE), 7,  "\\a is 0x07");
    _t_esc("\\\\", MODE_FMT, &esc);
    assert_eq(load64(&esc + STR_ESC_O_BYTE), 92, "\\\\ is a backslash");

    test_group("str_escape_decode — unknown escapes keep the backslash");
    # ⛔ GNU prints `\q`, both bytes. The old copies dropped the backslash and
    # printed a bare `q`, silently deleting a byte the user typed.
    assert_eq(_t_esc("\\q", MODE_FMT, &esc), STR_ESC_LITERAL, "\\q is a literal pair");
    assert_eq(load64(&esc + STR_ESC_O_BYTE), 113, "...whose second byte is `q`");
    assert_eq(load64(&esc + STR_ESC_O_LEN),    2, "...consuming both");
    # ⚠ `\"` IS in GNU's named table and `\'` is NOT — the asymmetry is real.
    assert_eq(_t_esc("\\\"", MODE_FMT, &esc), STR_ESC_BYTE,    "\\\" is a plain quote");
    assert_eq(_t_esc("\\'", MODE_FMT, &esc),   STR_ESC_LITERAL, "\\' keeps its backslash");
    # A trailing backslash is a literal backslash, consuming only itself.
    assert_eq(_t_esc("\\", MODE_FMT, &esc), STR_ESC_BYTE, "trailing \\ decodes");
    assert_eq(load64(&esc + STR_ESC_O_BYTE), 92, "...to a backslash");
    assert_eq(load64(&esc + STR_ESC_O_LEN),   1, "...consuming 1");

    test_group("str_escape_decode — the octal rule, both readings");
    # ⛔ THE divergence that made `%b` wrong: same input, two correct answers.
    _t_esc("\\0101", MODE_FMT, &esc);
    assert_eq(load64(&esc + STR_ESC_O_BYTE), 8, "FORMAT \\0101 is `\\010` = backspace");
    assert_eq(load64(&esc + STR_ESC_O_LEN),  4, "...leaving the `1` in the stream");
    _t_esc("\\0101", MODE_B, &esc);
    assert_eq(load64(&esc + STR_ESC_O_BYTE), 65, "%b \\0101 is `A` — the 0 is a PREFIX");
    assert_eq(load64(&esc + STR_ESC_O_LEN),   5, "...consuming all four digits");
    # Without the leading zero both modes agree: 3 digits, no prefix to skip.
    _t_esc("\\101", MODE_B, &esc);
    assert_eq(load64(&esc + STR_ESC_O_BYTE), 65, "%b \\101 is `A` too");
    _t_esc("\\0", MODE_B, &esc);
    assert_eq(load64(&esc + STR_ESC_O_BYTE), 0, "%b \\0 is NUL");
    assert_eq(load64(&esc + STR_ESC_O_LEN),  2, "...consuming just `\\0`");
    # ⚠ Overflow TRUNCATES and still eats three digits. The old copies refused
    # the third digit and left a literal `7` behind.
    _t_esc("\\777", MODE_FMT, &esc);
    assert_eq(load64(&esc + STR_ESC_O_BYTE), 255, "\\777 truncates to 0xff");
    assert_eq(load64(&esc + STR_ESC_O_LEN),    4, "...consuming all three digits");
    _t_esc("\\400", MODE_FMT, &esc);
    assert_eq(load64(&esc + STR_ESC_O_BYTE), 0, "\\400 truncates to 0x00");
    # A non-octal digit ends the run rather than joining it.
    _t_esc("\\18", MODE_FMT, &esc);
    assert_eq(load64(&esc + STR_ESC_O_BYTE), 1, "\\18 is \\1 then a literal 8");
    assert_eq(load64(&esc + STR_ESC_O_LEN),  2, "...consuming 2");

    test_group("str_escape_decode — \\xHH and \\c are opt-in");
    _t_esc("\\x41", MODE_FMT, &esc);
    assert_eq(load64(&esc + STR_ESC_O_BYTE), 65, "\\x41 is `A`");
    assert_eq(load64(&esc + STR_ESC_O_LEN),   4, "...consuming 4");
    _t_esc("\\x4", MODE_FMT, &esc);
    assert_eq(load64(&esc + STR_ESC_O_BYTE), 4, "\\x4 takes one digit");
    _t_esc("\\x41B", MODE_FMT, &esc);
    assert_eq(load64(&esc + STR_ESC_O_LEN), 4, "\\x stops at two digits");
    assert_eq(_t_esc("\\xZ", MODE_FMT, &esc), STR_ESC_ERR, "\\xZ is malformed");
    assert_eq(load64(&esc + STR_ESC_O_LEN), 2, "...and still reports a length");
    assert_eq(_t_esc("\\c", MODE_FMT, &esc), STR_ESC_STOP, "\\c cancels output");
    # ⚠ Mode bits OFF: both fall back to the unknown-escape path, backslash kept.
    assert_eq(_t_esc("\\c", 0, &esc), STR_ESC_LITERAL, "\\c is literal without ALLOW_C");
    assert_eq(_t_esc("\\x41", 0, &esc), STR_ESC_LITERAL, "\\x is literal without ALLOW_X");

    test_group("mode constants still encode what they claim");
    assert_eq(STR_ESC_ALLOW_C | STR_ESC_ALLOW_X | STR_ESC_DQUOTE,
              MODE_FMT, "MODE_FMT == printf FORMAT mode");
    assert_eq(MODE_B, MODE_FMT | STR_ESC_OCTAL_PREFIX, "MODE_B adds the octal prefix");
    assert_eq(STR_ESC_ALLOW_C | STR_ESC_ALLOW_X | STR_ESC_OCTAL_PREFIX,
              MODE_ECHO, "MODE_ECHO == echo -e mode");
    assert_eq(MODE_ECHO & STR_ESC_DQUOTE, 0, "echo does NOT take the DQUOTE bit");

    # ⛔ The one place echo and printf genuinely disagree on a named escape.
    # Measured against GNU: `printf '\"'` emits `"`, `echo -e '\"'` emits `\"`.
    test_group("str_escape_decode — \\\" is mode-gated");
    assert_eq(_t_esc("\\\"", MODE_FMT, &esc), STR_ESC_BYTE,
              "printf drops the backslash");
    assert_eq(load64(&esc + STR_ESC_O_BYTE), 34, "...leaving a plain quote");
    assert_eq(_t_esc("\\\"", MODE_ECHO, &esc), STR_ESC_LITERAL,
              "echo keeps the backslash");
    assert_eq(load64(&esc + STR_ESC_O_LEN), 2, "...consuming both bytes");

    test_group("echo option clusters");
    _echo_init_spec();
    assert_eq(_echo_is_cluster("-n"),   1, "-n is an option");
    assert_eq(_echo_is_cluster("-e"),   1, "-e is an option");
    assert_eq(_echo_is_cluster("-neE"), 1, "-neE is three options");
    assert_eq(_echo_is_cluster("-eE"),  1, "-eE clusters");
    # ⚠ All-or-nothing: ONE foreign character makes the whole token data.
    assert_eq(_echo_is_cluster("-ex"),  0, "-ex is an operand, not -e plus junk");
    assert_eq(_echo_is_cluster("-ne5"), 0, "-ne5 is an operand");
    assert_eq(_echo_is_cluster("-"),    0, "a bare - is an operand");
    assert_eq(_echo_is_cluster("--"),   0, "-- is an operand, not a terminator");
    assert_eq(_echo_is_cluster("hi"),   0, "a plain word is an operand");

    # ⛔ niyama compiles these clean and then matches NOTHING (roadmap M11), so
    # `nl -b p` must refuse them rather than number the wrong lines.
    test_group("nl -b pBRE — GNU-only operators are refused");
    assert_eq(_nl_rx_unsupported("a\\+b"),     43,  "\\+ is caught");
    assert_eq(_nl_rx_unsupported("a\\?b"),     63,  "\\? is caught");
    assert_eq(_nl_rx_unsupported("foo\\|bar"), 124, "\\| is caught");
    assert_eq(_nl_rx_unsupported("\\bfoo"),    98,  "\\b is caught");
    assert_eq(_nl_rx_unsupported("\\wx"),      119, "\\w is caught");
    assert_eq(_nl_rx_unsupported("\\sx"),      115, "\\s is caught");
    # ⚠ These niyama DOES implement — refusing them would be a false alarm.
    assert_eq(_nl_rx_unsupported("\\<foo"),    0, "\\< is supported");
    assert_eq(_nl_rx_unsupported("foo\\>"),    0, "\\> is supported");
    assert_eq(_nl_rx_unsupported("a\\{1,2\\}"), 0, "\\{n,m\\} is supported");
    assert_eq(_nl_rx_unsupported("\\(foo\\)"),  0, "\\(...\\) is supported");
    assert_eq(_nl_rx_unsupported("^a.*z$"),   0, "plain BRE is supported");
    # ⚠ Inside a bracket expression `\` is a literal, so `[\+]` is not the
    # operator and must not be refused.
    assert_eq(_nl_rx_unsupported("[\\+]"),     0, "[\\+] is a bracket literal");
    assert_eq(_nl_rx_unsupported("[]+]"),     0, "[]+] closes on the second ]");
    assert_eq(_nl_rx_unsupported("[^\\|]"),    0, "[^\\|] is negated-bracket data");
    assert_eq(_nl_rx_unsupported("\\\\+"),      0, "\\\\+ is an escaped backslash");

    test_group("nl section classification");
    var nst = alloc(NL_STATE_SIZE);
    store64(nst + NL_S_DELIM, "\\:");
    store64(nst + NL_S_DELIM_LEN, 2);
    assert_eq(_nl_classify(nst, "\\:\\:\\:", 6), NL_SEC_HEADER, "3 reps = header");
    assert_eq(_nl_classify(nst, "\\:\\:", 4),     NL_SEC_BODY,   "2 reps = body");
    assert_eq(_nl_classify(nst, "\\:", 2),         NL_SEC_FOOTER, "1 rep = footer");
    # ⚠ Whole line, not prefix. Four reps is TEXT, not header-plus-footer.
    assert_eq(_nl_classify(nst, "\\:\\:\\:\\:", 8), 0 - 1, "4 reps is text");
    assert_eq(_nl_classify(nst, "\\:\\:\\:x", 7),   0 - 1, "a trailing byte makes it text");
    assert_eq(_nl_classify(nst, " \\:\\:\\:", 7),   0 - 1, "leading space makes it text");
    assert_eq(_nl_classify(nst, "", 0),             0 - 1, "an empty line is text");
    assert_eq(_nl_classify(nst, "hello", 5),        0 - 1, "ordinary text is text");
    # `-d ''` disables matching entirely — the DOCUMENTED behaviour, which is
    # what coreutils 9.4 does. ⛔ 9.11 regressed this; never use it as an oracle.
    store64(nst + NL_S_DELIM_LEN, 0);
    assert_eq(_nl_classify(nst, "\\:\\:\\:", 6), 0 - 1, "-d '' disables sections");
    assert_eq(_nl_classify(nst, "", 0),           0 - 1, "...including for empty lines");

    test_group("icase — ASCII case helpers");
    assert_eq(icase_to_lower(65), 97, "A -> a");
    assert_eq(icase_to_lower(97), 97, "a -> a");
    assert_eq(icase_to_upper(97), 65, "a -> A");
    assert_eq(icase_to_upper(65), 65, "A -> A");
    # ⚠ Only ASCII A-Z / a-z fold. Byte 0xE9 (é in latin-1) is left alone, and
    # so is `_`, which sits BETWEEN the two ranges.
    assert_eq(icase_to_lower(233), 233, "0xE9 is not folded");
    assert_eq(icase_to_lower(95),  95,  "_ is not folded");
    assert_eq(icase_is_upper(90), 1, "Z is upper");
    assert_eq(icase_is_upper(91), 0, "[ is not upper");
    assert_eq(icase_is_lower(97), 1, "a is lower");
    assert_eq(icase_is_lower(96), 0, "` is not lower");

    # ⭐ The bug this library exists for. Lower-casing the TEXT `[[:upper:]]`
    # leaves it unchanged, so against a lower-cased subject it matched NOTHING.
    # GNU makes BOTH case classes mean `[:alpha:]` under -i.
    test_group("icase — the case classes both become [:alpha:]");
    var ie = alloc(8);
    assert_eq(streq(_t_rw("[[:upper:]]", ICASE_MODE_FOLD, ie), "[[:alpha:]]"), 1,
              "[:upper:] -> [:alpha:]");
    assert_eq(streq(_t_rw("[[:lower:]]", ICASE_MODE_FOLD, ie), "[[:alpha:]]"), 1,
              "[:lower:] -> [:alpha:]");
    # ⚠ Every OTHER class is untouched by -i.
    assert_eq(streq(_t_rw("[[:digit:]]", ICASE_MODE_FOLD, ie), "[[:digit:]]"), 1,
              "[:digit:] is unchanged");
    assert_eq(streq(_t_rw("[[:punct:]]", ICASE_MODE_FOLD, ie), "[[:punct:]]"), 1,
              "[:punct:] is unchanged");

    test_group("icase — literals and escapes");
    assert_eq(streq(_t_rw("ABC", ICASE_MODE_FOLD, ie), "abc"), 1, "literals fold");
    # ⛔ The byte after a backslash is copied verbatim. Folding it would turn
    # `\W` into `\w` — a different operator in the dialects that have one.
    assert_eq(streq(_t_rw("\\W", ICASE_MODE_FOLD, ie), "\\W"), 1, "escapes survive");
    assert_eq(streq(_t_rw("A[B-C]D", ICASE_MODE_FOLD, ie), "a[bc]d"), 1,
              "a range folds to its members");
    # CLOSED mode leaves literals for niyama's `(?i)` and closes the SET.
    assert_eq(streq(_t_rw("[a]", ICASE_MODE_CLOSED, ie), "[Aa]"), 1,
              "closed mode emits both cases");
    assert_eq(streq(_t_rw("A", ICASE_MODE_CLOSED, ie), "A"), 1,
              "closed mode leaves literals alone");

    # ⛔ The gate is the UPPER-case fold, not the lower-case one, and the
    # difference is load-bearing: `[A-_]` is accepted where `[B-a]` is refused,
    # though BOTH have a reversed lower-case fold. Measured against GNU.
    test_group("icase — the range rules");
    store64(ie, ICASE_OK);
    assert_eq(_t_rw("[Z-a]", ICASE_MODE_FOLD, ie), 0, "[Z-a] is refused");
    assert_eq(load64(ie), ICASE_E_RANGE, "...as an invalid range");
    store64(ie, ICASE_OK);
    assert_eq(_t_rw("[B-a]", ICASE_MODE_FOLD, ie), 0, "[B-a] is refused");
    store64(ie, ICASE_OK);
    _t_rw("[A-_]", ICASE_MODE_FOLD, ie);
    assert_eq(load64(ie), ICASE_OK, "[A-_] is accepted");
    # ⚠ A raw-reversed range that clears the gate matches NOTHING and is not an
    # error — so `-i` turns what was a hard error into silence.
    store64(ie, ICASE_OK);
    var empty_rw = _t_rw("[a-B]", ICASE_MODE_FOLD, ie);
    assert_eq(load64(ie), ICASE_OK, "[a-B] is accepted");
    assert_eq(streq(empty_rw, "[[:alpha:]]"), 0, "...and is not the alpha class");

    test_group("icase — bracket syntax edges");
    # `]` first is a member; `-` first or last is a member; `^` only negates first.
    assert_eq(streq(_t_rw("[]a]", ICASE_MODE_FOLD, ie), "[]a]"), 1, "] first is a member");
    assert_eq(streq(_t_rw("[a-]", ICASE_MODE_FOLD, ie), "[a-]"), 1, "- last is a member");
    assert_eq(streq(_t_rw("[-a]", ICASE_MODE_FOLD, ie), "[a-]"), 1, "- first re-emits last");
    assert_eq(streq(_t_rw("[^A]", ICASE_MODE_FOLD, ie), "[^a]"), 1, "negation survives");
    # ⛔ A `-` after a COMPLETED range or class is an error unless it is last —
    # GNU refuses `[a-c-e]` and accepts `[a-c-]`.
    store64(ie, ICASE_OK);
    assert_eq(_t_rw("[a-c-e]", ICASE_MODE_FOLD, ie), 0, "[a-c-e] is refused");
    store64(ie, ICASE_OK);
    _t_rw("[a-c-]", ICASE_MODE_FOLD, ie);
    assert_eq(load64(ie), ICASE_OK, "[a-c-] is accepted");
    store64(ie, ICASE_OK);
    assert_eq(_t_rw("[a-[:digit:]]", ICASE_MODE_FOLD, ie), 0, "a class cannot end a range");

    # ⛔ niyama implements neither, and its failure mode is SILENT — `[[=a=]]`
    # matched nothing where GNU matches. Refusing loudly beats numbering the
    # wrong lines, the same call `nl -b pBRE` makes (roadmap M11).
    test_group("icase — [=c=] and [.c.] are refused, not silently empty");
    store64(ie, ICASE_OK);
    assert_eq(_t_rw("[[=a=]]", ICASE_MODE_FOLD, ie), 0, "[=a=] is refused");
    assert_eq(load64(ie), ICASE_E_EQUIV, "...as an equivalence class");
    store64(ie, ICASE_OK);
    assert_eq(_t_rw("[[.a.]]", ICASE_MODE_FOLD, ie), 0, "[.a.] is refused");
    store64(ie, ICASE_OK);
    assert_eq(_t_rw("[abc", ICASE_MODE_FOLD, ie), 0, "an unterminated [ is refused");
    assert_eq(load64(ie), ICASE_E_BRACKET, "...as an unterminated bracket");

    # ⛔ GNU `find` is NOT GNU `grep` — glibc's `RE_ICASE` translates the
    # CANDIDATE as well as the endpoints, so `[b-B]` denotes {b,B} there and
    # NOTHING in grep. ⚠ The two differ in what a range MEANS, not in which
    # ranges are LEGAL: both refuse exactly when `toupper(x) > toupper(y)`.
    test_group("icase — find's translate rule differs from grep's in MEANING");
    var trm = ICASE_MODE_FOLD | ICASE_RANGE_TRANSLATE;
    store64(ie, ICASE_OK);
    var tr_bB = _t_rw("[b-B]", trm, ie);
    assert_eq(load64(ie), ICASE_OK, "[b-B] is legal under translate");
    # ⭐ The load-bearing difference: under translate `[b-B]` denotes {b,B}, so
    # against a lower-cased subject it is the single byte `b`. Under grep's rule
    # the same range is EMPTY, and an empty set has no bracket spelling — it is
    # written as the negation of every byte, which starts `[^`.
    assert_eq(streq(tr_bB, "[b]"), 1, "translate: [b-B] is the byte b");
    store64(ie, ICASE_OK);
    var gr_bB = _t_rw("[b-B]", ICASE_MODE_FOLD, ie);
    assert_eq(streq(gr_bB, "[b]"), 0, "grep's rule: [b-B] is NOT b");
    # ...and the VALIDITY gate is shared, so both refuse this one.
    store64(ie, ICASE_OK);
    assert_eq(_t_rw("[Z-a]", trm, ie), 0, "translate refuses [Z-a]");
    assert_eq(load64(ie), ICASE_E_RANGE, "...as an invalid range");
    store64(ie, ICASE_OK);
    assert_eq(_t_rw("[Z-a]", ICASE_MODE_FOLD, ie), 0, "grep's rule refuses it too");

    # ⚠ The no-`-i` gate is the RAW comparison, giving OPPOSITE answers to the
    # `-i` gate on the same two inputs.
    test_group("icase — the plain range gate is the raw comparison");
    store64(ie, ICASE_OK);
    assert_eq(_t_rw("[b-B]", ICASE_RANGE_PLAIN, ie), 0, "plain [b-B] is refused");
    assert_eq(load64(ie), ICASE_E_RANGE, "...as an invalid range");
    store64(ie, ICASE_OK);
    _t_rw("[Z-a]", ICASE_RANGE_PLAIN, ie);
    assert_eq(load64(ie), ICASE_OK, "plain [Z-a] is ACCEPTED");
    store64(ie, ICASE_OK);
    assert_eq(_t_rw("[a-c-e]", ICASE_RANGE_PLAIN, ie), 0, "plain [a-c-e] is refused");

    # ⛔ The scan runs with AND without `-i`. Refusing on the `-i` path alone
    # left the same pattern loud one way and silently wrong the other.
    test_group("icase — the unsupported-construct scan");
    assert_eq(icase_scan_unsupported("[[=a=]]", 7),   ICASE_E_EQUIV, "[=a=] is caught");
    assert_eq(icase_scan_unsupported("[[.a.]]", 7),   ICASE_E_EQUIV, "[.a.] is caught");
    assert_eq(icase_scan_unsupported("x[[=a=]b]y", 10), ICASE_E_EQUIV, "...mid-pattern too");
    # ⚠ Must not fire on an ordinary bracket that merely contains `.` or `[`,
    # nor read `[:alpha:]`'s own `:]` as the bracket's closing `]`.
    assert_eq(icase_scan_unsupported("[.]", 3),        ICASE_OK, "[.] is ordinary");
    assert_eq(icase_scan_unsupported("[a.b]", 5),      ICASE_OK, "[a.b] is ordinary");
    assert_eq(icase_scan_unsupported("[[:alpha:]]", 11), ICASE_OK, "a class is not a collating symbol");
    assert_eq(icase_scan_unsupported("[[:alpha:].]", 12), ICASE_OK, "class then a literal dot");
    assert_eq(icase_scan_unsupported("[]a]", 4),       ICASE_OK, "] first is a member");
    assert_eq(icase_scan_unsupported("a.b", 3),        ICASE_OK, "no bracket at all");
    # An escaped `[` does not open a bracket expression.
    assert_eq(icase_scan_unsupported("a\\[=b=]", 7),   ICASE_OK, "an escaped [ opens nothing");

    return assert_summary();
}

var exit_code = main();
syscall(SYS_EXIT, exit_code);
