# kriya-grep — fuzz harness for grep's regex parser surface (niyama).
#
# Drives `niyama_bre_compile` and `niyama_re2_compile` with random
# byte sequences up to 64 bytes. For each successfully-compiled NFA,
# also runs a `search` against a fixed haystack to exercise the
# matcher path. Asserts: no panic, no infinite loop (bounded by
# `_NITER`), every return value is in the documented range
# (NFA ptr | 0 for failure; search ≥ 0 | -1).
#
# Deterministic — seeds an inlined xorshift PRNG with a fixed
# constant so each run feeds the same input sequence. A crash gives
# the (seed, iteration-index) pair to replay.

var _F_SEED: i64 = 1442695040888963407;   # constant seed (xorshift)
var _F_NITER: i64 = 1000;
var _F_MAX_PAT_LEN: i64 = 64;

# xorshift64 — small footprint, decent distribution for fuzz input.
fn _f_rng_next(state_ptr): i64 {
    var s = load64(state_ptr);
    if (s == 0) { s = 1; }
    s = s ^ (s << 13);
    s = s ^ (s >> 7);
    s = s ^ (s << 17);
    store64(state_ptr, s);
    return s;
}

# Range [lo, hi) — unbiased modulo for fuzz purposes.
fn _f_rng_range(state_ptr, lo, hi): i64 {
    var v = _f_rng_next(state_ptr);
    if (v < 0) { v = 0 - v; }
    return lo + (v % (hi - lo));
}

fn main() {
    alloc_init();
    var seed[8];
    store64(&seed, _F_SEED);

    test_group("fuzz: niyama_bre_compile");
    var pat_buf = alloc(_F_MAX_PAT_LEN + 1);
    var i: i64 = 0;
    while (i < _F_NITER) {
        var pat_len = _f_rng_range(&seed, 0, _F_MAX_PAT_LEN);
        var j: i64 = 0;
        while (j < pat_len) {
            var b = _f_rng_range(&seed, 1, 128);  # ASCII non-NUL
            store8(pat_buf + j, b);
            j = j + 1;
        }
        store8(pat_buf + pat_len, 0);
        var nfa = niyama_bre_compile(pat_buf);
        # Whether compile succeeds or fails, both are valid outcomes
        # for adversarial input. The assertion is "the call returned" —
        # if it crashed, we wouldn't be here.
        if (nfa != 0) {
            var pos = niyama_bre_search(nfa, "the quick brown fox jumps over the lazy dog");
            assert_gte(pos, 0 - 1, "niyama_bre_search returns >= -1");
        }
        i = i + 1;
    }
    assert_eq(1, 1, "niyama_bre_compile survived 1000 random inputs");

    test_group("fuzz: niyama_re2_compile");
    i = 0;
    while (i < _F_NITER) {
        var pat_len = _f_rng_range(&seed, 0, _F_MAX_PAT_LEN);
        var j: i64 = 0;
        while (j < pat_len) {
            var b = _f_rng_range(&seed, 1, 128);
            store8(pat_buf + j, b);
            j = j + 1;
        }
        store8(pat_buf + pat_len, 0);
        var nfa = niyama_re2_compile(pat_buf);
        if (nfa != 0) {
            var pos = niyama_re2_search(nfa, "the quick brown fox jumps over the lazy dog");
            assert_gte(pos, 0 - 1, "niyama_re2_search returns >= -1");
        }
        i = i + 1;
    }
    assert_eq(1, 1, "niyama_re2_compile survived 1000 random inputs");

    test_group("fuzz: bracket-class boundary patterns");
    # Heavier-weighted bracket characters — these stress the BRE
    # bracket parser, which has handled grep's `-i` edge cases before.
    var bracket_chars = "[]\\^-]+*?.";
    var bc_len = strlen(bracket_chars);
    i = 0;
    while (i < _F_NITER) {
        var pat_len = _f_rng_range(&seed, 0, 32);
        var j: i64 = 0;
        while (j < pat_len) {
            var idx = _f_rng_range(&seed, 0, bc_len);
            store8(pat_buf + j, load8(bracket_chars + idx));
            j = j + 1;
        }
        store8(pat_buf + pat_len, 0);
        var nfa = niyama_bre_compile(pat_buf);
        if (nfa != 0) {
            niyama_bre_search(nfa, "[]^abc-z");
        }
        i = i + 1;
    }
    assert_eq(1, 1, "bracket-heavy patterns survived 1000 iterations");

    return assert_summary();
}

var exit_code = main();
syscall(SYS_EXIT, exit_code);
