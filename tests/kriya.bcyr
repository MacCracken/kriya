# kriya — dispatcher and lib hot-path benchmarks.
#
# Measured here (warm, in-process — see arch note 002 for cold-start
# discussion):
#   - path_basename_ptr over a typical $PATH-shaped argv[0]
#   - streq against the utility name (the dispatch comparison)
#   - cmd_true / cmd_false (the cheapest full utility roundtrip)
#   - path_normalize on a path that exercises `.`, `..` and dupes
#   - fs_inoset insert/lookup, the per-entry cost `du`'s dedup and
#     `cp --preserve=links` both pay on every file they touch
#
# These are the per-step costs that compose the dispatcher hot path.
# True process-spawn cold-start needs `time ./build/kriya true`-style
# external timing — covered by `scripts/bench-coldstart.sh`.

# ⚠ M15e again, one layer down: `help.cyr` reads `_VERSION_KRIYA` for
# `--version`, so the subset needs the generated version file too — the same
# note `tests/kriya.tcyr` carries at its own line 6.
include "src/version_str.cyr"
include "src/lib/exit.cyr"
include "src/lib/errmsg.cyr"
# ⚠ M15e: `src/lib/fs.cyr` needs `sys.cyr`'s `k_*` wrappers in scope even
# though this bench calls only the inode set — cyrius rejects REACHABLE
# undefined symbols, and the reachable set is one edit away from including a
# syscall wrapper. Included with the reference, not after the build breaks.
include "src/lib/sys.cyr"
include "src/lib/fs.cyr"
include "src/lib/path.cyr"
include "src/lib/args.cyr"
# ⛔ M15e, AND IT HAD ALREADY FIRED: `cyrius bench tests/kriya.bcyr` did not
# compile at pin 6.5.35 before this line existed. `true.cyr`/`false.cyr` call
# `help_begin`/`help_positional` and read `HELP_POS_UNBOUNDED`, and `args.cyr`
# has intercepted `--help` through `help.cyr` since v1.3.0 — so the bench subset
# has been one include short since then. Nothing caught it because CI runs
# `cyrius test`, never `cyrius bench`.
include "src/lib/help.cyr"
include "src/cmd/true.cyr"
include "src/cmd/false.cyr"

# The inode set under bench. ⚠ Built in `main` rather than here: a non-literal
# initializer at module scope costs a `gvar_toks` slot.
var _ino_set  = 0;
var _ino_seq  = 0;

var _grep_bench_bre   = 0;
var _grep_bench_re2   = 0;
var _grep_bench_line  = "the quick brown fox jumps over the lazy dog";
var _grep_bench_llen  = 43;

# ---- benchmark fixtures --------------------------------------------------

fn bench_basename_ptr() {
    var r = path_basename_ptr("/usr/local/bin/cp");
    return 0;
}

# The insert path: a fresh key every call, so this measures probe + store +
# the amortised rehash rather than the already-present short-circuit.
fn bench_inoset_insert() {
    _ino_seq = _ino_seq + 1;
    fs_inoset_add(_ino_set, 42, _ino_seq, 0);
    return 0;
}

# The lookup path, which is what a walk over a tree with FEW hard links pays on
# every single file: one hash, one probe, one miss.
fn bench_inoset_miss() {
    fs_inoset_find(_ino_set, 42, 0);
    return 0;
}

fn bench_streq_dispatch_hit() {
    var r = streq("true", "true");
    return 0;
}

fn bench_streq_dispatch_miss() {
    var r = streq("xyz123notinanything", "true");
    return 0;
}

fn bench_cmd_true() {
    var r = cmd_true(1);
    return 0;
}

fn bench_cmd_false() {
    var r = cmd_false(1);
    return 0;
}

fn bench_path_normalize_simple() {
    var r = path_normalize("/usr/local/bin");
    return 0;
}

fn bench_path_normalize_messy() {
    var r = path_normalize("/a/./b/../c//d/e/../../f");
    return 0;
}

fn bench_errmsg_for() {
    var r = errmsg_for(2);
    return 0;
}

fn bench_parse_octal_mode() {
    var r = kriya_parse_octal_mode("0755");
    return 0;
}

fn bench_niyama_bre_search() {
    var r = niyama_bre_search_at(_grep_bench_bre, _grep_bench_line, _grep_bench_llen, 0);
    return 0;
}

fn bench_niyama_re2_search() {
    var r = niyama_re2_search_at(_grep_bench_re2, _grep_bench_line, _grep_bench_llen, 0);
    return 0;
}

# ---- runner --------------------------------------------------------------

fn main() {
    alloc_init();

    var b1 = bench_new("dispatch/path_basename_ptr");
    bench_run_batch(b1, &bench_basename_ptr, 10000, 100);
    bench_report(b1);

    var b2 = bench_new("dispatch/streq_hit");
    bench_run_batch(b2, &bench_streq_dispatch_hit, 10000, 100);
    bench_report(b2);

    var b3 = bench_new("dispatch/streq_miss");
    bench_run_batch(b3, &bench_streq_dispatch_miss, 10000, 100);
    bench_report(b3);

    var b4 = bench_new("util/cmd_true");
    bench_run_batch(b4, &bench_cmd_true, 10000, 100);
    bench_report(b4);

    var b5 = bench_new("util/cmd_false");
    bench_run_batch(b5, &bench_cmd_false, 10000, 100);
    bench_report(b5);

    var b6 = bench_new("path/normalize_simple");
    bench_run_batch(b6, &bench_path_normalize_simple, 1000, 100);
    bench_report(b6);

    var b7 = bench_new("path/normalize_messy");
    bench_run_batch(b7, &bench_path_normalize_messy, 1000, 100);
    bench_report(b7);

    var b8 = bench_new("errmsg/for_known");
    bench_run_batch(b8, &bench_errmsg_for, 10000, 100);
    bench_report(b8);

    var b9 = bench_new("args/parse_octal_mode");
    bench_run_batch(b9, &bench_parse_octal_mode, 10000, 100);
    bench_report(b9);

    # niyama hot-path: per-line search against a typical-length line.
    _grep_bench_bre = niyama_bre_compile("fox");
    _grep_bench_re2 = niyama_re2_compile("fo[xy]");

    var b10 = bench_new("niyama/bre_search_literal");
    bench_run_batch(b10, &bench_niyama_bre_search, 10000, 100);
    bench_report(b10);

    var b11 = bench_new("niyama/re2_search_class");
    bench_run_batch(b11, &bench_niyama_re2_search, 10000, 100);
    bench_report(b11);

    _ino_set = fs_inoset_new();
    _ino_seq = 0;
    var b12 = bench_new("fs/inoset_insert");
    bench_run_batch(b12, &bench_inoset_insert, 10000, 100);
    bench_report(b12);

    var b13 = bench_new("fs/inoset_lookup_miss");
    bench_run_batch(b13, &bench_inoset_miss, 10000, 100);
    bench_report(b13);

    return 0;
}

var r = main();
syscall(SYS_EXIT, r);
