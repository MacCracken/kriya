# kriya-find — fuzz harness for find's predicate-AST parser.
#
# Drives `build/kriya find` with random argv tokens drawn from
# find's lexicon (predicates, operators, glob bytes). Each fork
# executes a finite computation: even pathological argv must
# terminate with a sane exit code (0, 1, or 2). The harness fails
# if any child crashes (exit > 128, SIGSEGV class) or hangs.
#
# Deterministic xorshift seeded with a fixed constant — replayable.

var _FF_SEED: i64 = 6364136223846793005;
var _FF_NITER: i64 = 200;
var _FF_BIN = "build/kriya";

# xorshift64
fn _ff_rng_next(state_ptr): i64 {
    var s = load64(state_ptr);
    if (s == 0) { s = 1; }
    s = s ^ (s << 13);
    s = s ^ (s >> 7);
    s = s ^ (s << 17);
    store64(state_ptr, s);
    return s;
}

fn _ff_rng_range(state_ptr, lo, hi): i64 {
    var v = _ff_rng_next(state_ptr);
    if (v < 0) { v = 0 - v; }
    return lo + (v % (hi - lo));
}

# find's lexicon, lightly biased toward predicates over operators
# (operators alone aren't a valid find invocation, but the parser
# should reject cleanly). Each entry is a cstr* slot.
fn _ff_lexicon(): i64 {
    var v = vec_new();
    vec_push(v, "/tmp");
    vec_push(v, ".");
    vec_push(v, "-name");
    vec_push(v, "*.txt");
    vec_push(v, "-type");
    vec_push(v, "f");
    vec_push(v, "d");
    vec_push(v, "l");
    vec_push(v, "-size");
    vec_push(v, "+1k");
    vec_push(v, "-100c");
    vec_push(v, "-mtime");
    vec_push(v, "+1");
    vec_push(v, "-1");
    vec_push(v, "-mmin");
    vec_push(v, "-empty");
    vec_push(v, "-newer");
    vec_push(v, "VERSION");
    vec_push(v, "-maxdepth");
    vec_push(v, "2");
    vec_push(v, "-mindepth");
    vec_push(v, "-print");
    vec_push(v, "-print0");
    vec_push(v, "-a");
    vec_push(v, "-o");
    vec_push(v, "-and");
    vec_push(v, "-or");
    vec_push(v, "-not");
    vec_push(v, "!");
    vec_push(v, "(");
    vec_push(v, ")");
    vec_push(v, "-P");
    vec_push(v, "-L");
    vec_push(v, "-exec");
    vec_push(v, "echo");
    vec_push(v, ";");
    vec_push(v, "{}");
    return v;
}

# Fork + execve build/kriya with the given argv vec, wait, return
# exit status. Discards stdout/stderr to /dev/null.
fn _ff_run(args): i64 {
    var argc = vec_len(args);
    if (argc < 1) { return 0 - 1; }
    var cmd = vec_get(args, 0);
    var argv = alloc((argc + 1) * 8);
    var i: i64 = 0;
    while (i < argc) {
        store64(argv + i * 8, vec_get(args, i));
        i = i + 1;
    }
    store64(argv + argc * 8, 0);
    var envp = alloc(8);
    store64(envp, 0);
    var pid = sys_fork();
    if (pid < 0) { return 0 - 1; }
    if (pid == 0) {
        var devnull = sys_open("/dev/null", 1, 0);
        if (devnull >= 0) {
            sys_dup2(devnull, 1);
            sys_dup2(devnull, 2);
            sys_close(devnull);
        }
        sys_execve(cmd, argv, envp);
        sys_exit(127);
    }
    var stbuf[1];
    sys_waitpid(pid, &stbuf, 0);
    var st = load32(&stbuf);
    if (WIFEXITED(st) == 1) { return WEXITSTATUS(st); }
    # Killed by signal — for fuzz, we treat anything 128+signum as crash.
    return 0 - 2;
}

fn main() {
    alloc_init();
    var seed[8];
    store64(&seed, _FF_SEED);

    test_group("fuzz: find with random argv from lexicon");
    var lex = _ff_lexicon();
    var lex_n = vec_len(lex);

    var i: i64 = 0;
    while (i < _FF_NITER) {
        var args = vec_new();
        vec_push(args, _FF_BIN);
        vec_push(args, "find");
        var argc = _ff_rng_range(&seed, 1, 8);
        var j: i64 = 0;
        while (j < argc) {
            var idx = _ff_rng_range(&seed, 0, lex_n);
            vec_push(args, vec_get(lex, idx));
            j = j + 1;
        }
        var rc = _ff_run(args);
        # Acceptable: 0 (success), 1 (find-level error), 2 (usage).
        # Unacceptable: any code from a signal kill (we encode as -2)
        # or > 128 (signal+128 convention).
        assert_neq(rc, 0 - 2, "find did not exit cleanly under fuzz");
        if (rc >= 0) {
            if (rc > 128) {
                assert_lt(rc, 129, "find did not crash (no SIG-derived exit)");
            }
        }
        i = i + 1;
    }
    assert_eq(1, 1, "find survived 200 random argv inputs");

    return assert_summary();
}

var exit_code = main();
syscall(SYS_EXIT, exit_code);
