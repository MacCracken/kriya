# false — POSIX `false(1)`: do nothing, exit 1.
# Args ignored per POSIX.
fn cmd_false(start: i64): i64 {
    false_help_declare();
    help_if_requested(0, start);
    return EXIT_FAILURE;
}

# Help/introspection record for `false`. ⭐ Split out so `kriya --list` can
# populate it WITHOUT running the utility — one declaration feeding `--help`,
# `--help=json` and `--list` alike.
fn false_help_declare(): i64 {
    help_begin("false", "Do nothing, unsuccessfully.",
               "false [ignored...]");
    help_positional(0, HELP_POS_UNBOUNDED, "IGNORED");
    help_no_options();
    help_example("false || echo failed");
    return 0;
}
