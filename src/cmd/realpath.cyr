# realpath — GNU `realpath(1)`: canonicalize paths (resolve symlinks,
# `.`, `..`, and produce an absolute form).
#
# Argument shape:
#   realpath [opts] PATH...
#
# Flags:
#   -e / --canonicalize-existing  every path component must exist
#                                 (default; alias for the default mode).
#   -m / --canonicalize-missing   no component need exist; once an
#                                 ENOENT is encountered, the rest of
#                                 the path is appended textually.
#   -q / --quiet                  suppress error messages; the exit
#                                 code still reflects failure.
#   -z / --zero                   NUL-terminate each output instead of \n.
#
# Each PATH is processed independently. The invocation exits with
# EXIT_FAILURE if any PATH fails; the canonical paths for the others
# are still emitted to stdout.
#
# Deferred to follow-up commits: (roadmap 1.6.3)
#   -s / --strip / --no-symlinks  skip symlink resolution (text-only).
#   --relative-to=DIR             print path relative to DIR.
#   --relative-base=DIR           print relative when under DIR, else absolute.
#   -L / --logical                resolve `..` before symlinks (POSIX `cd -L`).
#   -P / --physical               resolve symlinks first (the current default).
#
# Symlink policy (ADR 0003): realpath's *purpose* is to follow
# symlinks — that's the whole utility. ADR 0003's matrix is about
# destructive utilities (cp/mv/rm); realpath is purely informational.
# The 40-symlink hop limit in `fs_realpath` (returns ELOOP) handles
# cycles deterministically.

var _rp_spec  = 0;
var _rp_e_idx = 0;
var _rp_m_idx = 0;
var _rp_q_idx = 0;
var _rp_z_idx = 0;

fn _rp_init_spec(): i64 {
    if (_rp_spec != 0) { return 0; }
    var s = flags_new();
    _rp_e_idx = flags_add_bool(s, 101, "canonicalize-existing", 0, "every component must exist (default)");
    _rp_m_idx = flags_add_bool(s, 109, "canonicalize-missing", 0, "no component need exist");
    _rp_q_idx = flags_add_bool(s, 113, "quiet",   0, "suppress error messages");
    _rp_z_idx = flags_add_bool(s, 122, "zero",    0, "NUL-terminate each output");
    _rp_spec = s;
    realpath_help_declare();
    return 0;
}

# Help/introspection record for `realpath`. ⭐ Split out so `kriya --list` can
# populate it WITHOUT running the utility — one declaration feeding `--help`,
# `--help=json` and `--list` alike.
fn realpath_help_declare(): i64 {
    help_begin("realpath", "Resolve a path to its canonical absolute form.",
               "realpath [OPTIONS] PATH...");
    help_positional(1, HELP_POS_UNBOUNDED, "PATH");
    help_operands("Symlinks are followed and `.`/`..` resolved. -e requires every component to exist, -m allows a missing tail.");
    help_exit(1, "a path could not be resolved");
    help_example("realpath ./src/../README.md");
    help_example("realpath -m /no/such/path");
    return 0;
}

fn _rp_report(operand, errno): i64 {
    k_write( 2, "kriya realpath: ", 16);
    k_write( 2, operand, strlen(operand));
    k_write( 2, ": ", 2);
    if (errmsg_is_known(errno) == 1) {
        var m = errmsg_for(errno);
        k_write( 2, m, strlen(m));
    } else {
        k_write( 2, "errno ", 6);
        var buf[8];
        var i: i64 = 7;
        store8(&buf + i, 0);
        i = i - 1;
        var v = errno;
        if (v == 0) { store8(&buf + i, 48); i = i - 1; }
        while (v > 0) {
            store8(&buf + i, 48 + (v - (v / 10) * 10));
            v = v / 10;
            i = i - 1;
        }
        k_write( 2, &buf + i + 1, 6 - i);
    }
    k_write( 2, "\n", 1);
    return 0;
}

fn cmd_realpath(start: i64): i64 {
    _rp_init_spec();
    if (kriya_args_parse(_rp_spec, start) != 0) {
        k_write( 2, "kriya realpath: error: bad option (see ADR 0002 for accepted syntax)\n", 69);
        return EXIT_USAGE;
    }

    var npos = flags_positional_count(_rp_spec);
    if (npos < 1) {
        k_write( 2, "kriya realpath: error: missing operand\n", 39);
        return EXIT_USAGE;
    }

    var quiet: i64 = 0;
    if (flags_get_bool(_rp_spec, _rp_q_idx) == 1) { quiet = 1; }
    var zero: i64 = 0;
    if (flags_get_bool(_rp_spec, _rp_z_idx) == 1) { zero = 1; }

    # Mode resolution: -m wins over -e if both given (last-mode-wins
    # is the GNU behaviour; the parser doesn't surface order, so we
    # arbitrate by precedence).
    var mode: i64 = FS_REALPATH_REQUIRE_ALL;
    if (flags_get_bool(_rp_spec, _rp_e_idx) == 1) { mode = FS_REALPATH_REQUIRE_ALL; }
    if (flags_get_bool(_rp_spec, _rp_m_idx) == 1) { mode = FS_REALPATH_ALLOW_MISSING; }

    var term_byte: i64 = 10;
    if (zero == 1) { term_byte = 0; }
    var term_buf[2];
    store8(&term_buf, term_byte);

    var out_buf = alloc(16384);
    var any_failed: i64 = 0;
    var i: i64 = 0;
    while (i < npos) {
        var p = flags_positional(_rp_spec, i);
        var n = fs_realpath(p, mode, out_buf, 16384);
        if (n < 0) {
            if (quiet == 0) { _rp_report(p, 0 - n); }
            any_failed = 1;
        } else {
            k_write( 1, out_buf, n);
            k_write( 1, &term_buf, 1);
        }
        i = i + 1;
    }

    if (any_failed == 1) { return EXIT_FAILURE; }
    return EXIT_SUCCESS;
}
