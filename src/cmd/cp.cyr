# cp — POSIX `cp(1)`: copy files and (with -R/-r) directory trees.
#
# Argument shapes:
#   cp [opts] SRC DST                — copy SRC to DST
#   cp [opts] SRC... DIRECTORY       — copy each SRC into DIRECTORY
#   cp -R [opts] SRC DST             — recursive: copy tree at SRC to DST
#   cp -R [opts] SRC... DIRECTORY    — recursive multi-source-into-dir
#
# Flags:
#   -f / --force        overwrite existing destination without prompt.
#   -i / --interactive  prompt before overwrite. Per ADR 0002, on
#                       non-tty stdin this is a usage error (exit 2),
#                       not a hang.
#   -p / --preserve     preserve mode + atime/mtime (POSIX subset).
#   -v / --verbose      print "'src' -> 'dst'" per file.
#   -R / -r             recursive copy of directory contents.
#   -P / --no-deref     preserve all symlinks (DEFAULT under -R per
#                       ADR 0003 — kriya choice closing the POSIX
#                       implementation-defined gap in the safer direction).
#   -H                  follow only command-line symlinks during -R;
#                       preserve those discovered by the walk.
#   -L / --dereference  follow all symlinks during -R.
#
# Symlink policy (ADR 0003):
#   - Non-R single source: follow (POSIX). `cp link file` copies the
#     target's bytes.
#   - -R default = -P:    preserve symlinks. `cp -R a b` copies the
#     same link names; targets are not dereferenced.
#   - -R -H:              follow ONLY the command-line operands.
#   - -R -L:              follow everywhere; the destination is a
#     pure-content tree.
#
# Recursive walks use `openat(O_NOFOLLOW | O_DIRECTORY)` from an
# explicit parent dirfd at every descent (ADR 0003 hard rule). A
# directory entry replaced by a symlink between the lstat that
# classified it and the open that descends fails with ELOOP — no
# silent follow. Destination opens during recursion use O_NOFOLLOW;
# under -f an existing symlink at the destination is unlinked first
# and the open retried.
#
# Root protection (ADR 0004): cp is non-destructive of unnamed data;
# the protected_paths check is rm-only.
#
# Hard-link preservation across same-inode source entries: GNU cp
# preserves them with `--preserve=links`. M2 cp does not preserve
# them by default and does not yet take that flag. Multiple paths
# to the same inode become independent copies in the destination tree.
# Deferred follow-up.
#
# Each top-level (SRC, DST) pair is attempted independently. Exit
# EXIT_FAILURE if any failed.

var _cp_spec  = 0;
var _cp_f_idx = 0;
var _cp_i_idx = 0;
var _cp_p_idx = 0;
var _cp_v_idx = 0;
var _cp_R_idx = 0;
var _cp_r_idx = 0;
var _cp_BIG_P_idx = 0;
var _cp_BIG_H_idx = 0;
var _cp_BIG_L_idx = 0;

# ⛔ A DECLINED `-i` PROMPT IS EXIT 1, NOT 0. GNU returns 1 when you answer `n`
# — verified across three pty runs — and a script testing `cp -i ... && next`
# must not proceed on a copy the user refused. kriya returned 0.
var _cp_declined = 0;

var _cp_buf   = 0;
var _CP_BUFSZ = 65536;

# Symlink policy enum encoded as small integers.
#   POLICY_P = 0: preserve everywhere (default with -R).
#   POLICY_H = 1: follow command-line operands, preserve in-walk.
#   POLICY_L = 2: follow everywhere.
enum CpPolicy {
    CP_POLICY_P = 0;
    CP_POLICY_H = 1;
    CP_POLICY_L = 2;
}

fn _cp_init_spec(): i64 {
    if (_cp_spec != 0) { return 0; }
    var s = flags_new();
    _cp_f_idx     = flags_add_bool(s, 102, "force",       0, "overwrite existing destination");
    _cp_i_idx     = flags_add_bool(s, 105, "interactive", 0, "prompt before overwrite");
    _cp_p_idx     = flags_add_bool(s, 112, "preserve",    0, "preserve mode and timestamps");
    _cp_v_idx     = flags_add_bool(s, 118, "verbose",     0, "print each copy");
    _cp_R_idx     = flags_add_bool(s, 82,  "recursive",   0, "copy directories recursively");
    _cp_r_idx     = flags_add_bool(s, 114, "",            0, "alias for -R");
    _cp_BIG_P_idx = flags_add_bool(s, 80,  "no-deref",    0, "preserve all symlinks (-R default)");
    _cp_BIG_H_idx = flags_add_bool(s, 72,  "",            0, "follow command-line symlinks only (-R)");
    _cp_BIG_L_idx = flags_add_bool(s, 76,  "dereference", 0, "follow all symlinks (-R)");
    _cp_spec = s;
    help_begin("cp", "Copy files and directory trees.",
               "cp [OPTIONS] SOURCE... DEST");
    help_positional(2, HELP_POS_UNBOUNDED, "SOURCE,DEST");
    help_destructive(1);
    help_operands("With one SOURCE, DEST is the new name or an existing directory. With several, DEST must be a directory. Directories need -R/-r. Existing destinations are refused without -f (ADR 0003, ADR 0004).");
    help_exit(1, "a copy failed, or a destination existed without -f");
    help_example("cp notes.txt backup.txt");
    help_example("cp -r src/ dest/");
    help_example("cp -p -f a.conf /etc/a.conf");
    return 0;
}

fn _cp_buf_get(): i64 {
    if (_cp_buf != 0) { return _cp_buf; }
    _cp_buf = alloc(_CP_BUFSZ);
    return _cp_buf;
}

fn _cp_report(operand, errno): i64 {
    k_write( 2, "kriya cp: ", 10);
    k_write( 2, operand, strlen(operand));
    k_write( 2, ": ", 2);
    if (errmsg_is_known(errno) == 1) {
        var m = errmsg_for(errno);
        k_write( 2, m, strlen(m));
    } else {
        k_write( 2, "errno ", 6);
        var buf[8];
        var i: i64 = 7;
        store8(&buf + i, 0);
        i = i - 1;
        var v = errno;
        if (v == 0) { store8(&buf + i, 48); i = i - 1; }
        while (v > 0) {
            store8(&buf + i, 48 + (v - (v / 10) * 10));
            v = v / 10;
            i = i - 1;
        }
        k_write( 2, &buf + i + 1, 6 - i);
    }
    k_write( 2, "\n", 1);
    return 0;
}

fn _cp_isatty(fd): i64 {
    # Portable tty probe: k_isatty does the ioctl(TCGETS) on Linux and
    # returns 0 on agnos (no ioctl/termios) — so -i prompting is never
    # interactive on agnos and falls through to the non-tty path.
    if (k_isatty(fd) == 1) { return 1; }
    return 0;
}

fn _cp_prompt(dst): i64 {
    k_write( 2, "kriya cp: overwrite '", 21);
    k_write( 2, dst, strlen(dst));
    k_write( 2, "'? ", 3);
    var c[8];
    var n = k_read( 0, &c, 8);
    if (n < 1) { return 0; }
    var ch = load8(&c);
    if (ch == 121) { return 1; }
    if (ch == 89)  { return 1; }
    return 0;
}

fn _cp_is_dir_path(path): i64 {
    var buf[144];
    var r = k_stat(path, &buf);
    if (r != 0) { return 0; }
    if (fs_is_dir(&buf) == 1) { return 1; }
    return 0;
}

fn _cp_verbose(src_display, dst_display): i64 {
    k_write( 1, "'", 1);
    k_write( 1, src_display, strlen(src_display));
    k_write( 1, "' -> '", 6);
    k_write( 1, dst_display, strlen(dst_display));
    k_write( 1, "'\n", 2);
    return 0;
}

# Read/write loop. Both fds are already open. Returns 0 on success,
# negative errno on failure (and emits the error report).
fn _cp_copy_loop(src_fd, dst_fd, src_display, dst_display): i64 {
    var buf = _cp_buf_get();
    var bufsz = _CP_BUFSZ;
    var loop: i64 = 1;
    var failed: i64 = 0;
    var first_errno: i64 = 0;
    while (loop == 1) {
        var n = k_read( src_fd, buf, bufsz);
        if (n < 0) {
            if ((0 - n) == 4) {
                # EINTR — retry.
            } else {
                _cp_report(src_display, 0 - n);
                first_errno = 0 - n;
                failed = 1;
                loop = 0;
            }
        } else {
            if (n == 0) {
                loop = 0;
            } else {
                var written: i64 = 0;
                var write_done: i64 = 0;
                while (write_done == 0) {
                    var w = k_write( dst_fd, buf + written, n - written);
                    if (w < 0) {
                        if ((0 - w) != 4) {
                            _cp_report(dst_display, 0 - w);
                            first_errno = 0 - w;
                            failed = 1;
                            write_done = 1;
                            loop = 0;
                        }
                    } else {
                        written = written + w;
                        if (written >= n) { write_done = 1; }
                    }
                }
            }
        }
    }
    if (failed == 1) { return 0 - first_errno; }
    return 0;
}

# Single-file copy (path-based). Used by both the non-recursive and
# the top-level recursive entry when the source is a regular file.
# Source open is path-based (POSIX: follows symlinks).
fn _cp_one(src, dst, force, interactive, preserve, verbose): i64 {
    var src_stat[144];
    var sr = k_stat(src, &src_stat);
    if (sr != 0) {
        _cp_report(src, 0 - sr);
        return sr;
    }
    if (fs_is_dir(&src_stat) == 1) {
        _cp_report(src, 21);
        return 0 - 21;
    }

    var dst_stat[144];
    var dr = k_stat(dst, &dst_stat);
    if (dr == 0) {
        if (load64(&src_stat + 0) == load64(&dst_stat + 0)) {
            if (load64(&src_stat + 8) == load64(&dst_stat + 8)) {
                k_write( 2, "kriya cp: '", 11);
                k_write( 2, src, strlen(src));
                k_write( 2, "' and '", 7);
                k_write( 2, dst, strlen(dst));
                k_write( 2, "' are the same file\n", 20);
                return 0 - 17;
            }
        }
        if (force == 0) {
            if (interactive == 1) {
                if (_cp_isatty(0) == 0) {
                    k_write( 2, "kriya cp: error: -i requires stdin to be a terminal\n", 53);
                    return 0 - 9999;
                }
                if (_cp_prompt(dst) == 0) { _cp_declined = 1; return 0; }
            } else {
                _cp_report(dst, 17);
                return 0 - 17;
            }
        }
    } else {
        if (interactive == 1) {
            if (_cp_isatty(0) == 0) {
                k_write( 2, "kriya cp: error: -i requires stdin to be a terminal\n", 53);
                return 0 - 9999;
            }
        }
    }

    var src_fd = k_open(src, 0, 0);
    if (src_fd < 0) {
        _cp_report(src, 0 - src_fd);
        return src_fd;
    }

    var perms = fs_perms(&src_stat);
    var dst_fd = k_open(dst, 577, perms);
    if (dst_fd < 0) {
        k_close( src_fd);
        _cp_report(dst, 0 - dst_fd);
        return dst_fd;
    }

    var r = _cp_copy_loop(src_fd, dst_fd, src, dst);
    k_close( src_fd);
    k_close( dst_fd);

    if (r != 0) {
        k_unlink(dst);
        return r;
    }

    if (preserve == 1) {
        sys_chmod(dst, perms);
        var ts[32];
        store64(&ts + 0,  load64(&src_stat + 72));
        store64(&ts + 8,  load64(&src_stat + 80));
        store64(&ts + 16, load64(&src_stat + 88));
        store64(&ts + 24, load64(&src_stat + 96));
        if (K_HAVE_UTIMES == 1) { fs_utimensat(0 - 100, dst, &ts, 0); }   # best-effort mtime preserve; no-op on agnos
    }

    if (verbose == 1) { _cp_verbose(src, dst); }
    return 0;
}

# Decide whether to follow a symlink found at the current position.
#   POLICY_P: never follow.
#   POLICY_H: follow only when top_level == 1.
#   POLICY_L: always follow.
fn _cp_should_follow(policy, top_level): i64 {
    if (policy == CP_POLICY_L) { return 1; }
    if (policy == CP_POLICY_H) {
        if (top_level == 1) { return 1; }
    }
    return 0;
}

# Copy a symlink: read its target text, recreate at the destination
# under the same name. fd-based to keep TOCTOU windows tight.
fn _cp_symlink_at(src_dirfd, src_name, src_display, dst_dirfd, dst_name, dst_display, force, verbose): i64 {
    var link_buf = alloc(4096);
    var n = fs_readlinkat(src_dirfd, src_name, link_buf, 4095);
    if (n < 0) {
        _cp_report(src_display, 0 - n);
        return n;
    }
    store8(link_buf + n, 0);

    if (force == 1) { fs_unlinkat(dst_dirfd, dst_name, 0); }

    var r = fs_symlinkat(link_buf, dst_dirfd, dst_name);
    if (r != 0) {
        _cp_report(dst_display, 0 - r);
        return r;
    }
    if (verbose == 1) { _cp_verbose(src_display, dst_display); }
    return 0;
}

# fd-based regular-file copy used during recursion. Source is opened
# from the parent dirfd; destination is opened with O_NOFOLLOW per
# ADR 0003 (under -f, an existing dest symlink is unlinked first).
# `follow` carries the lstat-vs-stat decision from the caller:
# follow=0 means the source was classified via lstat (POLICY_P/H in-walk)
# so we must open with O_NOFOLLOW to close the TOCTOU window where the
# entry could be swapped for a symlink between classify and open
# (M8 mitigation, see CVE-2026-35359 in uutils-coreutils).
fn _cp_file_at(src_dirfd, src_name, src_display, dst_dirfd, dst_name, dst_display, force, interactive, preserve, verbose, src_st, follow): i64 {
    var src_open_flags: i64 = 0;
    if (follow == 0) { src_open_flags = 131072; }     # O_NOFOLLOW
    var src_fd = fs_openat(src_dirfd, src_name, src_open_flags, 0);
    if (src_fd < 0) {
        _cp_report(src_display, 0 - src_fd);
        return src_fd;
    }

    # ⛔ THE RECURSIVE PATH USED TO CLOBBER UNCONDITIONALLY. It opened the
    # destination with O_TRUNC and never asked, so `cp -i -R src dst` overwrote
    # without a single prompt (verified under a real pty: GNU asks, kriya did
    # not), and `cp -R src dst` with no `-f` silently replaced existing files —
    # while the NON-recursive `_cp_one` right above has always refused that
    # without `-f`. cp was inconsistent with itself, and the recursive half was
    # the one contradicting CLAUDE.md's "no silent file overwrites without -f".
    var dst_probe[144];
    var dpr = fs_fstatat(dst_dirfd, dst_name, &dst_probe, 256);   # AT_SYMLINK_NOFOLLOW
    if (dpr == 0) {
        if (force == 0) {
            if (interactive == 1) {
                if (_cp_prompt(dst_display) == 0) {
                    fs_close(src_fd);
                    _cp_declined = 1;
                    return 0;                    # declined: not an error, but exit 1
                }
            } else {
                fs_close(src_fd);
                _cp_report(dst_display, 17);     # EEXIST
                return 0 - 17;
            }
        }
    }

    var perms = fs_perms(src_st);
    # O_WRONLY=1, O_CREAT=64, O_TRUNC=512, O_NOFOLLOW=131072 → 131649.
    var dst_flags = 131649;
    var dst_fd = fs_openat(dst_dirfd, dst_name, dst_flags, perms);
    if (dst_fd < 0) {
        var derrno = 0 - dst_fd;
        # ELOOP (40) means dst was a symlink (O_NOFOLLOW refused). Under
        # -f, replace it. Under EEXIST somehow (O_CREAT|O_TRUNC shouldn't
        # but defensive), same path.
        var recovered: i64 = 0;
        if (force == 1) {
            if (derrno == 40) {
                fs_unlinkat(dst_dirfd, dst_name, 0);
                dst_fd = fs_openat(dst_dirfd, dst_name, dst_flags, perms);
                if (dst_fd >= 0) { recovered = 1; }
            }
        } else {
            if (derrno == 17) {
                _cp_report(dst_display, 17);
                fs_close(src_fd);
                return dst_fd;
            }
        }
        if (recovered == 0) {
            if (dst_fd < 0) {
                fs_close(src_fd);
                _cp_report(dst_display, 0 - dst_fd);
                return dst_fd;
            }
        }
    }

    var r = _cp_copy_loop(src_fd, dst_fd, src_display, dst_display);
    fs_close(src_fd);
    fs_close(dst_fd);

    if (r != 0) {
        fs_unlinkat(dst_dirfd, dst_name, 0);
        return r;
    }

    if (preserve == 1) {
        fs_fchmodat(dst_dirfd, dst_name, perms, 0);
        var ts[32];
        store64(&ts + 0,  load64(src_st + 72));
        store64(&ts + 8,  load64(src_st + 80));
        store64(&ts + 16, load64(src_st + 88));
        store64(&ts + 24, load64(src_st + 96));
        fs_utimensat(dst_dirfd, dst_name, &ts, 0);
    }

    if (verbose == 1) { _cp_verbose(src_display, dst_display); }
    return 0;
}

# Descend into an existing source directory whose mode is in `src_st`.
# This is the only recursive function in the cp implementation —
# per-entry dispatch (file / symlink / sub-directory) is inlined
# below into the iteration loop, so we don't need a separate
# `_cp_recurse_at` (Cyrius has no forward declarations).
#
# `allow_follow` is 1 when we got here via a stat (policy said follow)
# and 0 when we got here via lstat (real directory). Under follow, the
# source open omits O_NOFOLLOW so a symlink-to-directory is honored.
# Under no-follow, the source open uses O_NOFOLLOW so a swapped-in
# symlink fails ELOOP per ADR 0003.
fn _cp_dir_descend_at(src_dirfd, src_name, src_display, dst_dirfd, dst_name, dst_display, policy, allow_follow, force, interactive, preserve, verbose, src_st): i64 {
    var src_fd: i64 = 0;
    if (allow_follow == 1) {
        # O_RDONLY | O_DIRECTORY = 65536. No NOFOLLOW: policy-driven follow.
        src_fd = fs_openat(src_dirfd, src_name, 65536, 0);
    } else {
        src_fd = fs_opendir_nofollow(src_dirfd, src_name);
    }
    if (src_fd < 0) {
        _cp_report(src_display, 0 - src_fd);
        return src_fd;
    }

    # Ensure destination exists as a directory.
    var perms = fs_perms(src_st);
    var mr = fs_mkdirat(dst_dirfd, dst_name, perms);
    if (mr != 0) {
        var derrno = 0 - mr;
        if (derrno == 17) {
            # Already exists — must be a directory.
            var dst_check[144];
            var dchk = fs_lstat_at(dst_dirfd, dst_name, &dst_check);
            if (dchk != 0) {
                fs_close(src_fd);
                _cp_report(dst_display, 0 - dchk);
                return dchk;
            }
            if (fs_is_dir(&dst_check) == 0) {
                fs_close(src_fd);
                _cp_report(dst_display, 20);  # ENOTDIR
                return 0 - 20;
            }
        } else {
            fs_close(src_fd);
            _cp_report(dst_display, derrno);
            return mr;
        }
    }

    var dst_fd = fs_opendir_nofollow(dst_dirfd, dst_name);
    if (dst_fd < 0) {
        fs_close(src_fd);
        _cp_report(dst_display, 0 - dst_fd);
        return dst_fd;
    }

    var any_failed: i64 = 0;
    var ent_buf = alloc(4096);
    var loop: i64 = 1;
    while (loop == 1) {
        var nb = fs_getdents64(src_fd, ent_buf, 4096);
        if (nb < 0) {
            if ((0 - nb) == 4) {
                # EINTR — retry.
            } else {
                _cp_report(src_display, 0 - nb);
                any_failed = 1;
                loop = 0;
            }
        } else {
            if (nb == 0) {
                loop = 0;
            } else {
                var off: i64 = 0;
                while (off < nb) {
                    var ent = ent_buf + off;
                    var reclen = fs_dent_reclen(ent);
                    if (fs_dent_is_dotdot(ent) == 0) {
                        var name = fs_dent_name(ent);
                        var child_src_disp = path_join(src_display, name);
                        var child_dst_disp = path_join(dst_display, name);
                        # Classify the child. policy + top_level=0 →
                        # follow only under POLICY_L.
                        var child_st[144];
                        var follow = _cp_should_follow(policy, 0);
                        var csr: i64 = 0;
                        if (follow == 1) {
                            csr = fs_fstatat(src_fd, name, &child_st, 0);
                        } else {
                            csr = fs_lstat_at(src_fd, name, &child_st);
                        }
                        if (csr != 0) {
                            _cp_report(child_src_disp, 0 - csr);
                            any_failed = 1;
                        } else {
                            var rr: i64 = 0;
                            if (fs_is_lnk(&child_st) == 1) {
                                rr = _cp_symlink_at(src_fd, name, child_src_disp,
                                                    dst_fd, name, child_dst_disp,
                                                    force, verbose);
                            } else {
                                if (fs_is_dir(&child_st) == 1) {
                                    # `follow` carries the lstat-vs-stat decision
                                    # into the descend: if we stat'd to get here,
                                    # the dir open must also follow.
                                    rr = _cp_dir_descend_at(src_fd, name, child_src_disp,
                                                            dst_fd, name, child_dst_disp,
                                                            policy, follow, force, interactive, preserve, verbose, &child_st);
                                } else {
                                    if (fs_is_reg(&child_st) == 1) {
                                        rr = _cp_file_at(src_fd, name, child_src_disp,
                                                         dst_fd, name, child_dst_disp,
                                                         force, interactive, preserve, verbose, &child_st, follow);
                                    } else {
                                        k_write( 2, "kriya cp: ", 10);
                                        k_write( 2, child_src_disp, strlen(child_src_disp));
                                        k_write( 2, ": unsupported file type (FIFO/socket/device)\n", 45);
                                        rr = 0 - 22;
                                    }
                                }
                            }
                            if (rr != 0) { any_failed = 1; }
                        }
                    }
                    off = off + reclen;
                }
            }
        }
    }

    fs_close(src_fd);
    fs_close(dst_fd);

    # Apply -p restoration after content is written so the directory's
    # mtime isn't bumped by the writes inside it.
    if (preserve == 1) {
        fs_fchmodat(dst_dirfd, dst_name, perms, 0);
        var ts[32];
        store64(&ts + 0,  load64(src_st + 72));
        store64(&ts + 8,  load64(src_st + 80));
        store64(&ts + 16, load64(src_st + 88));
        store64(&ts + 24, load64(src_st + 96));
        fs_utimensat(dst_dirfd, dst_name, &ts, 0);
    }

    if (any_failed == 1) { return 0 - 5; }
    return 0;
}

# Top-level recursive entry. Called when -R is set and the source's
# resolved (or unresolved per policy) type is a directory. The
# `allow_follow_top` flag carries the lstat-vs-stat decision that the
# caller (`_cp_recursive_one`) already made.
fn _cp_dir_top(src_path, dst_path, policy, allow_follow_top, force, interactive, preserve, verbose, src_st): i64 {
    return _cp_dir_descend_at(0 - 100, src_path, src_path,
                              0 - 100, dst_path, dst_path,
                              policy, allow_follow_top, force, interactive, preserve, verbose, src_st);
}

# Recursive entry from the per-operand loop. Classifies src and
# dispatches to file/symlink/directory copy.
fn _cp_recursive_one(src, dst, policy, force, interactive, preserve, verbose): i64 {
    # Top-level lstat (or stat if policy follows top).
    var st[144];
    var sr: i64 = 0;
    var follow = _cp_should_follow(policy, 1);
    if (follow == 1) {
        sr = k_stat(src, &st);
    } else {
        sr = fs_lstat_at(0 - 100, src, &st);  # fstatat AT_SYMLINK_NOFOLLOW
    }
    if (sr != 0) {
        _cp_report(src, 0 - sr);
        return sr;
    }

    if (fs_is_lnk(&st) == 1) {
        # Reachable only when not following — copy the symlink itself.
        # k_readlink does readlink(2) on Linux and returns -38 (ENOSYS)
        # on agnos (no symlinks) — so n < 0 there and the error path below
        # reports it gracefully rather than misbehaving.
        var link_buf = alloc(4096);
        var n = k_readlink(src, link_buf, 4095);
        if (n < 0) {
            _cp_report(src, 0 - n);
            return n;
        }
        store8(link_buf + n, 0);
        if (force == 1) { k_unlink(dst); }
        var lr = k_symlink(link_buf, dst);
        if (lr != 0) {
            _cp_report(dst, 0 - lr);
            return lr;
        }
        if (verbose == 1) { _cp_verbose(src, dst); }
        return 0;
    }
    if (fs_is_dir(&st) == 1) {
        # ⛔ REFUSE TO COPY A DIRECTORY INTO ITSELF — THIS RECURSES FOREVER, AND IT IS A TYPO, NOT AN
        # EXOTIC INPUT. `cp -r dir dir/backup` used to descend into the copy it had just made, make
        # another, and descend again: measured at 12,188 directories created before the process
        # DUMPED CORE, with the half-built tree left on disk. On a real filesystem that is a disk-fill
        # plus a crash from one mistyped operand. GNU refuses immediately, and so do we now.
        #
        # ⭐ `dst` IS ALREADY THE EFFECTIVE DESTINATION, which is what makes this check a two-liner:
        # `cmd_cp` resolved `cp -r a b/` to `b/a` via `path_join` before calling here, so the
        # comparison is against the directory that would actually be created, exactly as GNU reports
        # it ("cannot copy a directory, 'a', into itself, 'a/sub/a'").
        #
        # Both sides go through `fs_path_absolute` first: the operands only share a textual prefix once
        # they are in the same frame, so `cp -r /tmp/x/a a/sub` from /tmp/x is caught too.
        # ⚠ Equal paths land here as well (`cp -r a/sub a` resolves `dst` back to `a/sub`), where GNU
        # prefers its "are the same file" wording. Same refusal, same exit code, different sentence.
        var abs_src = fs_path_absolute(src);
        var abs_dst = fs_path_absolute(dst);
        if (path_is_under(abs_src, abs_dst) == 1) {
            k_write( 2, "kriya cp: cannot copy a directory, '", 36);
            k_write( 2, src, strlen(src));
            k_write( 2, "', into itself, '", 17);
            k_write( 2, dst, strlen(dst));
            k_write( 2, "'\n", 2);
            return 0 - 22;                      # EINVAL
        }
        # follow already reflects whether we stat'd (1) or lstat'd (0).
        return _cp_dir_top(src, dst, policy, follow, force, interactive, preserve, verbose, &st);
    }
    if (fs_is_reg(&st) == 1) {
        return _cp_one(src, dst, force, interactive, preserve, verbose);
    }
    k_write( 2, "kriya cp: ", 10);
    k_write( 2, src, strlen(src));
    k_write( 2, ": unsupported file type (FIFO/socket/device)\n", 45);
    return 0 - 22;
}

# Validate a `--preserve=` attribute list. Returns 0 when every attribute is one
# kriya actually preserves, or -1 (after reporting) when it is not.
#
# ⚠ Accepting an attribute kriya does not implement would be the exact bug this
# release is about: `cp --preserve=links` exited 0 while making independent
# copies of what the user asked to stay hard-linked. Naming the unimplemented
# attribute is the honest answer until the inode-set helper lands (roadmap M12c).
fn _cp_check_preserve_list(attrs): i64 {
    var len = strlen(attrs);
    var seg_start: i64 = 0;
    var i: i64 = 0;
    var bad: i64 = 0;
    while (i <= len) {
        var at_end: i64 = 0;
        if (i == len) { at_end = 1; }
        else { if (load8(attrs + i) == 44) { at_end = 1; } }      # ','
        if (at_end == 1) {
            var slen = i - seg_start;
            var ok: i64 = 0;
            if (slen == 4) {
                if (_cp_seg_eq(attrs + seg_start, "mode", 4) == 1) { ok = 1; }
            }
            if (slen == 10) {
                if (_cp_seg_eq(attrs + seg_start, "timestamps", 10) == 1) { ok = 1; }
            }
            if (ok == 0) {
                if (bad == 0) {
                    k_write( 2, "kriya cp: --preserve: '", 23);
                    k_write( 2, attrs + seg_start, slen);
                    k_write( 2, "' is not preserved by kriya (supported: mode, timestamps)\n", 58);
                    bad = 1;
                }
            }
            seg_start = i + 1;
        }
        i = i + 1;
    }
    if (bad == 1) { return 0 - 1; }
    return 0;
}

fn _cp_seg_eq(p, lit, n): i64 {
    var i: i64 = 0;
    while (i < n) {
        if (load8(p + i) != load8(lit + i)) { return 0; }
        i = i + 1;
    }
    return 1;
}

fn cmd_cp(start: i64): i64 {
    _cp_init_spec();
    # GNU's `--preserve[=ATTR_LIST]`. kriya's `-p` preserves mode + atime/mtime,
    # so `mode` and `timestamps` are honoured and the attributes kriya does not
    # implement are REFUSED BY NAME rather than silently ignored — which is what
    # `--preserve=links` used to do: accepted, discarded, exit 0, hard links
    # quietly turned into independent copies.
    if (kriya_args_parse_optval(_cp_spec, start, 0, "preserve") != 0) {
        k_write( 2, "kriya cp: error: bad option (see ADR 0002 for accepted syntax)\n", 63);
        return EXIT_USAGE;
    }

    var npos = flags_positional_count(_cp_spec);
    if (npos < 2) {
        k_write( 2, "kriya cp: error: missing operand (need SRC and DST)\n", 53);
        return EXIT_USAGE;
    }

    var force: i64 = 0;
    if (flags_get_bool(_cp_spec, _cp_f_idx) == 1) { force = 1; }
    var interactive: i64 = 0;
    if (flags_get_bool(_cp_spec, _cp_i_idx) == 1) { interactive = 1; }
    var preserve: i64 = 0;
    if (flags_get_bool(_cp_spec, _cp_p_idx) == 1) { preserve = 1; }
    if (preserve == 1) {
        var attrs = kriya_long_value();
        if (attrs != 0) {
            if (_cp_check_preserve_list(attrs) != 0) { return EXIT_USAGE; }
        }
    }
    var verbose: i64 = 0;
    if (flags_get_bool(_cp_spec, _cp_v_idx) == 1) { verbose = 1; }
    var recursive: i64 = 0;
    if (flags_get_bool(_cp_spec, _cp_R_idx) == 1) { recursive = 1; }
    if (flags_get_bool(_cp_spec, _cp_r_idx) == 1) { recursive = 1; }

    # ADR 0002 hard rule #4: -i on a non-tty stdin is a usage error,
    # invocation-wide, even before any operand classification.
    if (interactive == 1) {
        if (_cp_isatty(0) == 0) {
            k_write( 2, "kriya cp: error: -i requires stdin to be a terminal\n", 53);
            return EXIT_USAGE;
        }
    }

    # Policy resolution: -P / -H / -L are mutually exclusive in spirit
    # but the parser accepts any subset; last-one-wins by precedence
    # L > H > P (matches GNU cp).
    var policy: i64 = CP_POLICY_P;
    if (flags_get_bool(_cp_spec, _cp_BIG_P_idx) == 1) { policy = CP_POLICY_P; }
    if (flags_get_bool(_cp_spec, _cp_BIG_H_idx) == 1) { policy = CP_POLICY_H; }
    if (flags_get_bool(_cp_spec, _cp_BIG_L_idx) == 1) { policy = CP_POLICY_L; }

    var dst_arg = flags_positional(_cp_spec, npos - 1);
    var dst_is_dir = _cp_is_dir_path(dst_arg);

    var any_failed: i64 = 0;
    if (dst_is_dir == 0) {
        if (npos != 2) {
            k_write( 2, "kriya cp: error: with multiple sources, the last operand must be a directory\n", 77);
            return EXIT_USAGE;
        }
        var src = flags_positional(_cp_spec, 0);
        var r: i64 = 0;
        if (recursive == 1) {
            r = _cp_recursive_one(src, dst_arg, policy, force, interactive, preserve, verbose);
        } else {
            r = _cp_one(src, dst_arg, force, interactive, preserve, verbose);
        }
        if (r != 0) { any_failed = 1; }
        if (r == (0 - 9999)) { return EXIT_USAGE; }
    } else {
        var i: i64 = 0;
        while (i < npos - 1) {
            var src = flags_positional(_cp_spec, i);
            var base = path_basename_ptr(src);
            var dst = path_join(dst_arg, base);
            var r: i64 = 0;
            if (recursive == 1) {
                r = _cp_recursive_one(src, dst, policy, force, interactive, preserve, verbose);
            } else {
                r = _cp_one(src, dst, force, interactive, preserve, verbose);
            }
            if (r != 0) { any_failed = 1; }
            if (r == (0 - 9999)) { return EXIT_USAGE; }
            i = i + 1;
        }
    }

    if (any_failed == 1) { return EXIT_FAILURE; }
    # A refused prompt is exit 1, matching GNU.
    if (_cp_declined == 1) { return EXIT_FAILURE; }
    return EXIT_SUCCESS;
}
