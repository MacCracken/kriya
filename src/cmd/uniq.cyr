# uniq — POSIX `uniq(1)`: filter adjacent matching lines.
#
# Argument shape:
#   uniq [opts] [INPUT [OUTPUT]]
#
# Flags:
#   -c / --count       prefix each output line with the run-length.
#   -d / --repeated    only output lines that appeared at least twice.
#   -u / --unique      only output lines that appeared exactly once.
#   -i / --ignore-case case-fold ASCII letters during comparison.
#   -f N / --skip-fields=N    skip the first N blank-separated fields
#                              when comparing.
#   -s N / --skip-chars=N     skip the first N chars (after -f) when
#                              comparing.
#   -w N / --check-chars=N    compare at most N chars (after -f -s).
#   -z / --zero-terminated    NUL-separated lines on both input and output.
#
# **Adjacent only**: uniq compares each line to its immediate
# predecessor. To collapse non-adjacent duplicates, pipe `sort | uniq`
# (this is POSIX-defined behaviour, not a kriya limitation).
#
# `-d` and `-u` are mutually exclusive in spirit; combining them
# produces no output (matches GNU).
#
# Output line semantics: the OUTPUT is always the full unmodified line
# from the input. The comparison-key transformations (`-f`/`-s`/`-w`/`-i`)
# only decide equality, never what gets written.
#
# Positional arguments: zero, one, or two operands. With one operand
# it is the input file (stdin reads if no operand or operand `-`). With
# two operands the second is the output file (truncated, mode 0666).
#
# ⚠ NOTHING IS DEFERRED HERE ANY MORE. This header used to introduce a list
# of pending items; both entries below are now a SHIPPED feature and a settled
# NON-GOAL. A stale "Deferred" heading over closed items reads as an
# admission of gaps that do not exist.
#   ⚠ --all-repeated[=METHOD] / -D and --group[=METHOD] SHIPPED at 1.4.3 —
#   see the notes on `_uq_group_line`. They emit EVERY line of a group, not the
#   representative N times, which matters because -f/-s/-w compare a WINDOW and
#   lines in one group can differ outside it.
#   ⛔ Multi-byte case folding for -i is NOT a gap — GNU does not do it either.
#   Measured under both LC_ALL=C.UTF-8 and LC_ALL=C: `uniq -i` on `café` /
#   `cafÉ` reports TWO lines, i.e. no non-ASCII folding. kriya already matches;
#   adding Unicode folding would DIVERGE from GNU rather than close a gap.

var _uq_spec   = 0;
var _uq_c_idx  = 0;
var _uq_d_idx  = 0;
var _uq_u_idx  = 0;
var _uq_i_idx  = 0;
var _uq_f_idx  = 0;
var _uq_s_idx  = 0;
var _uq_w_idx  = 0;
var _uq_z_idx  = 0;
var _uq_D_idx  = 0;
var _uq_g_idx  = 0;
var _uq_A_idx  = 0;

var _uq_read_buf = 0;
var _UQ_READ_SZ  = 65536;
var _UQ_LINE_SZ  = 65536;

fn _uq_init_spec(): i64 {
    if (_uq_spec != 0) { return 0; }
    var s = flags_new();
    _uq_c_idx = flags_add_bool(s, 99,  "count",            0, "prefix each line with its run count");
    _uq_d_idx = flags_add_bool(s, 100, "repeated",         0, "only repeated lines");
    _uq_u_idx = flags_add_bool(s, 117, "unique",           0, "only unique lines");
    _uq_i_idx = flags_add_bool(s, 105, "ignore-case",      0, "case-fold ASCII letters");
    _uq_f_idx = flags_add_str(s,  102, "skip-fields",      0, "skip N blank-separated fields");
    _uq_s_idx = flags_add_str(s,  115, "skip-chars",       0, "skip N chars (after -f)");
    _uq_w_idx = flags_add_str(s,  119, "check-chars",      0, "compare at most N chars");
    _uq_D_idx = flags_add_bool(s, 68,  "",                 0, "print all lines of each duplicate group");
    _uq_g_idx = flags_add_bool(s, 0,   "group",            0, "all lines, groups separated (separate|prepend|append|both)");  #skip-lint
    _uq_A_idx = flags_add_bool(s, 0,   "all-repeated",     0, "all lines of duplicate groups (none|prepend|separate)");
    _uq_z_idx = flags_add_bool(s, 122, "zero-terminated",  0, "NUL-separated lines");
    _uq_spec = s;
    uniq_help_declare();
    return 0;
}

# Help/introspection record for `uniq`. ⭐ Split out so `kriya --list` can
# populate it WITHOUT running the utility — one declaration feeding `--help`,
# `--help=json` and `--list` alike.
fn uniq_help_declare(): i64 {
    help_begin("uniq", "Report or filter repeated adjacent lines.",
               "uniq [OPTIONS] [INPUT [OUTPUT]]");
    help_positional(0, 2, "INPUT,OUTPUT");
    help_destructive(1);
    help_operands("⚠ Only ADJACENT duplicates are considered — sort the input first if that is not already true. ⚠ --group and --all-repeated print every line of a group; their METHOD vocabularies differ (--group: separate|prepend|append|both; --all-repeated: none|prepend|separate). --group is mutually exclusive with -c/-d/-D/-u. ⛔ With -D, -u prints only the LATER lines of each repeat group and -d is a no-op, matching GNU.");  #skip-lint
    help_exit(1, "input or output could not be handled");
    help_example("sort f | uniq");
    help_example("uniq -c log");
    help_example("uniq -d names");
    return 0;
}

fn _uq_read_buf_get(): i64 {
    if (_uq_read_buf == 0) { _uq_read_buf = alloc(_UQ_READ_SZ); }
    return _uq_read_buf;
}

# ⭐ ONE LINE NOW. The 24-line body this replaces was byte-identical in every
# utility apart from the name; `errmsg_report` in `src/lib/report.cyr` is the
# single implementation of architecture 001's framing, and it shell-quotes the
# operand so a name containing a newline cannot split the diagnostic in two.
fn _uq_report(operand, errno): i64 { return errmsg_report("uniq", operand, errno); }

fn _uq_render_dec(v, buf): i64 {
    if (v == 0) { store8(buf, 48); return 1; }
    var tmp[32];
    var n: i64 = 0;
    var rem = v;
    while (rem > 0) {
        store8(&tmp + n, 48 + (rem - (rem / 10) * 10));
        rem = rem / 10;
        n = n + 1;
    }
    var i: i64 = 0;
    while (i < n) {
        store8(buf + i, load8(&tmp + n - 1 - i));
        i = i + 1;
    }
    return n;
}

# ASCII case-fold byte. Upper → lower; everything else passes through.
fn _uq_fold(b): i64 {
    if (b >= 65) {
        if (b <= 90) { return b + 32; }
    }
    return b;
}

# Locate the comparison-key window within `line[0..len)`:
#   - Skip `skip_f` blank-separated fields from the start.
#   - Then skip `skip_s` chars.
#   - Cap the remaining window at `cw` chars (or full remainder if cw < 0).
# Returns the start offset; writes the comparison length into `out_len_p`.
fn _uq_key_window(line, len, skip_f, skip_s, cw, out_len_p): i64 {
    var pos: i64 = 0;
    # Skip skip_f fields. A "field" per POSIX is "a non-empty sequence
    # of non-blank characters, preceded by zero or more blanks". So
    # the parse is: skip leading blanks, consume non-blanks, repeat.
    # (Cyrius break-in-while is unreliable per CLAUDE.md, so each
    # inner loop uses a done-flag.)
    var fields_skipped: i64 = 0;
    while (fields_skipped < skip_f) {
        # Skip blanks.
        var done_blanks: i64 = 0;
        while (done_blanks == 0) {
            if (pos >= len) { done_blanks = 1; }
            else {
                var b = load8(line + pos);
                if (b == 32) { pos = pos + 1; }
                else {
                    if (b == 9) { pos = pos + 1; }
                    else { done_blanks = 1; }
                }
            }
        }
        if (pos >= len) {
            fields_skipped = skip_f;  # nothing more to skip
        } else {
            # Consume non-blanks.
            var done_field: i64 = 0;
            while (done_field == 0) {
                if (pos >= len) { done_field = 1; }
                else {
                    var b = load8(line + pos);
                    if (b == 32)      { done_field = 1; }
                    else { if (b == 9) { done_field = 1; }
                    else                { pos = pos + 1; } }
                }
            }
            fields_skipped = fields_skipped + 1;
        }
    }

    # Skip skip_s chars.
    var sc: i64 = 0;
    while (sc < skip_s) {
        if (pos >= len) { sc = skip_s; }
        else { pos = pos + 1; sc = sc + 1; }
    }

    var remaining = len - pos;
    if (cw >= 0) {
        if (remaining > cw) { remaining = cw; }
    }
    store64(out_len_p, remaining);
    return pos;
}

# Compare two comparison-key windows. Returns 0 if equal, non-zero
# otherwise. `case_fold` 1 applies ASCII tolower to both before
# byte-compare.
fn _uq_keys_equal(a, alen, b, blen, case_fold): i64 {
    if (alen != blen) { return 0; }
    var i: i64 = 0;
    while (i < alen) {
        var ca = load8(a + i);
        var cb = load8(b + i);
        if (case_fold == 1) {
            ca = _uq_fold(ca);
            cb = _uq_fold(cb);
        }
        if (ca != cb) { return 0; }
        i = i + 1;
    }
    return 1;
}

# Emit a previously-buffered group. `show_d`/`show_u` decide whether
# duplicates / uniques pass the filter; `show_c` prepends the count.
# --- --group / --all-repeated ------------------------------------------
#
# ⭐ THESE EMIT EVERY LINE OF A GROUP, NOT THE REPRESENTATIVE N TIMES. With
# `-f`/`-s`/`-w` the comparison key is a WINDOW, so lines in one group can
# differ outside it — measured against GNU: `uniq --group -f 1` on
# `x a / y a / z b` prints `x a` and `y a`, both of them, not `x a` twice.
#
# ⭐ O(1) MEMORY, NOT O(GROUP). `--group` prints each line as it arrives, since
# every line is emitted and only the SEPARATOR needs to know a group changed.
# `--all-repeated` must know whether a group has more than one line before
# printing its first, so it holds exactly ONE line and streams the rest. A group
# of a million identical lines costs one line of buffer either way.
enum UqGroup {
    UQ_G_OFF      = 0,
    UQ_G_GROUP    = 1,
    UQ_G_ALLREP   = 2,
    # Separator placement. GNU spells these as METHOD words; the values are
    # shared because --group and --all-repeated accept overlapping sets.
    UQ_M_SEPARATE = 0,
    UQ_M_PREPEND  = 1,
    UQ_M_APPEND   = 2,
    UQ_M_BOTH     = 3,
    UQ_M_NONE     = 4,
}
var _uq_gmode   = 0;
var _uq_gmethod = 0;
var _uq_gstarted = 0;   # has any group been emitted yet?
var _uq_held     = 0;   # buffer holding a group's first line (--all-repeated)
var _uq_held_len = 0;
var _uq_has_held = 0;
# ⛔ `-D -u` PRINTS ONLY THE LATER LINES of each repeat group — the first is
# suppressed — and `-D -d` is a no-op. Measured against GNU and order-
# independent (`-u -D` behaves the same). It reads oddly until you see
# coreutils' internal flags: `-u` clears "output first repeated" while `-D`
# sets "output later repeated", so the two combine to mean "the repeats after
# the first". ⚠ Unique groups are never printed under -D whatever -u says.
var _uq_g_skipfirst = 0;

# Parse a METHOD word. `for_group` selects which vocabulary applies: --group
# takes separate|prepend|append|both (default separate) and --all-repeated takes
# none|prepend|separate (default none). ⚠ The two sets OVERLAP but are not the
# same — `--group=none` and `--all-repeated=append` are both errors in GNU, and
# rejecting by vocabulary rather than by a shared list is what keeps that true.
# Returns -1 after reporting an invalid value.
fn _uq_parse_method(arg, for_group): i64 {
    # A BARE option (no `=`) takes the default method.
    if (arg == 0) {
        if (for_group == 1) { return UQ_M_SEPARATE; }
        return UQ_M_NONE;
    }
    # ⛔ `--group=` WITH AN EMPTY VALUE IS AN ERROR, not the default. GNU calls
    # it "ambiguous argument ''" and refuses; treating it as a bare `--group`
    # would accept an invocation GNU rejects, which is the wrong direction for a
    # tool to be permissive in — the caller wrote `=` and meant something.
    if (load8(arg) == 0) {
        if (for_group == 1) {
            k_write( 2, "kriya uniq: error: empty argument for --group (want separate|prepend|append|both)\n", 82);  #skip-lint
        } else {
            k_write( 2, "kriya uniq: error: empty argument for --all-repeated (want none|prepend|separate)\n", 82);  #skip-lint
        }
        return 0 - 1;
    }
    # ⚠ EXACT MATCH ONLY — no prefix acceptance. GNU's argmatch takes any
    # unambiguous prefix (`--group=sep`, `--group=b`), which ADR 0002 rejects for
    # long NAMES ("`--ver` does not match `--version`… silent drift across
    # releases") and the same reasoning applies to their VALUES: a prefix that is
    # unambiguous today becomes ambiguous the day a method is added. Deliberate
    # divergence, recorded in ADR 0002.
    if (for_group == 1) {
        if (streq(arg, "separate") == 1) { return UQ_M_SEPARATE; }
        if (streq(arg, "prepend") == 1)  { return UQ_M_PREPEND; }
        if (streq(arg, "append") == 1)   { return UQ_M_APPEND; }
        if (streq(arg, "both") == 1)     { return UQ_M_BOTH; }
        k_write( 2, "kriya uniq: error: invalid argument for --group (want separate|prepend|append|both)\n", 84);
        return 0 - 1;
    }
    if (streq(arg, "none") == 1)     { return UQ_M_NONE; }
    if (streq(arg, "prepend") == 1)  { return UQ_M_PREPEND; }
    if (streq(arg, "separate") == 1) { return UQ_M_SEPARATE; }
    k_write( 2, "kriya uniq: error: invalid argument for --all-repeated (want none|prepend|separate)\n", 84);
    return 0 - 1;
}

fn _uq_sep(out_fd, term_byte): i64 {
    var tb[2];
    store8(&tb, term_byte);
    k_write( out_fd, &tb, 1);
    return 0;
}

fn _uq_gline(out_fd, line, len, term_byte): i64 {
    if (len > 0) { k_write( out_fd, line, len); }
    var tb[2];
    store8(&tb, term_byte);
    k_write( out_fd, &tb, 1);
    return 0;
}

# Called once per input line. `new_group` is 1 when this line starts a group.
fn _uq_group_line(out_fd, line, len, new_group, term_byte): i64 {
    if (_uq_gmode == UQ_G_GROUP) {
        if (new_group == 1) {
            # ⚠ A separator goes BEFORE this group when the method prepends, or
            # between groups when it separates — and "between" means "not before
            # the first", which is what `_uq_gstarted` tracks.
            if (_uq_gmethod == UQ_M_PREPEND) { _uq_sep(out_fd, term_byte); }
            elif (_uq_gmethod == UQ_M_BOTH)  { _uq_sep(out_fd, term_byte); }
            elif (_uq_gstarted == 1)         { _uq_sep(out_fd, term_byte); }
            _uq_gstarted = 1;
        }
        return _uq_gline(out_fd, line, len, term_byte);
    }
    if (_uq_gmode == UQ_G_ALLREP) {
        if (new_group == 1) {
            # Hold it: whether this group repeats is still unknown.  #skip-lint
            if (_uq_held == 0) { _uq_held = alloc(_UQ_LINE_SZ); }
            if (len > 0) { memcpy(_uq_held, line, len); }
            _uq_held_len = len;
            _uq_has_held = 1;
            return 0;
        }
        if (_uq_has_held == 1) {
            # Second line of the group: the held first line is now known to be
            # part of a repeat, so flush it behind whatever separator applies.
            if (_uq_gmethod == UQ_M_PREPEND) { _uq_sep(out_fd, term_byte); }
            elif (_uq_gmethod == UQ_M_SEPARATE) {
                if (_uq_gstarted == 1) { _uq_sep(out_fd, term_byte); }
            }
            _uq_gstarted = 1;
            if (_uq_g_skipfirst == 0) {
                _uq_gline(out_fd, _uq_held, _uq_held_len, term_byte);
            }
            _uq_has_held = 0;
        }
        return _uq_gline(out_fd, line, len, term_byte);
    }
    return 0;
}

# End of input: an append-style separator is owed, and any held singleton is
# discarded (a group of one is not a repeat).
fn _uq_group_finish(out_fd, term_byte): i64 {
    _uq_has_held = 0;
    if (_uq_gmode == UQ_G_GROUP) {
        if (_uq_gstarted == 1) {
            if (_uq_gmethod == UQ_M_APPEND) { _uq_sep(out_fd, term_byte); }
            elif (_uq_gmethod == UQ_M_BOTH) { _uq_sep(out_fd, term_byte); }
        }
    }
    return 0;
}

fn _uq_emit_group(out_fd, prev, prev_len, count, show_c, show_d, show_u, term_byte): i64 {
    var is_dup: i64 = 0;
    if (count > 1) { is_dup = 1; }
    # ⚠ In --group / --all-repeated mode every line was already emitted by
    # `_uq_group_line`; this representative-per-group path must stay silent.
    if (_uq_gmode != UQ_G_OFF) { return 0; }
    var emit: i64 = 1;
    if (show_d == 1) {
        if (is_dup == 0) { emit = 0; }
    }
    if (show_u == 1) {
        if (is_dup == 1) { emit = 0; }
    }
    if (emit == 0) { return 0; }

    if (show_c == 1) {
        # GNU format: right-justify count in width 7, then 1 space, then line.
        var nb[32];
        var nlen = _uq_render_dec(count, &nb);
        var pad = 7 - nlen;
        var sp[2];
        store8(&sp, 32);
        while (pad > 0) {
            k_write( out_fd, &sp, 1);
            pad = pad - 1;
        }
        k_write( out_fd, &nb, nlen);
        k_write( out_fd, " ", 1);
    }
    if (prev_len > 0) { k_write( out_fd, prev, prev_len); }
    var tb[2];
    store8(&tb, term_byte);
    k_write( out_fd, &tb, 1);
    return 0;
}

fn _uq_run(in_fd, out_fd, skip_f, skip_s, cw, ic, show_c, show_d, show_u, term_byte): i64 {
    var read_buf = _uq_read_buf_get();
    var prev_buf = alloc(_UQ_LINE_SZ);
    var cur_buf  = alloc(_UQ_LINE_SZ);
    var prev_len: i64 = 0;
    var cur_len:  i64 = 0;
    var prev_key_off: i64 = 0;
    var prev_key_len: i64 = 0;
    var count: i64 = 0;  # 0 means "no previous group buffered yet"
    var truncated_warned: i64 = 0;

    var loop: i64 = 1;
    while (loop == 1) {
        var n = k_read( in_fd, read_buf, _UQ_READ_SZ);
        if (n < 0) {
            if ((0 - n) == 4) {
                # EINTR retry.
            } else { return n; }
        } else {
            if (n == 0) {
                # EOF — flush trailing partial line if any.
                if (cur_len > 0) {
                    # Treat as a line.
                    var klen_box[8];
                    var key_off = _uq_key_window(cur_buf, cur_len, skip_f, skip_s, cw, &klen_box);
                    var klen = load64(&klen_box);
                    var equal: i64 = 0;
                    if (count > 0) {
                        equal = _uq_keys_equal(prev_buf + prev_key_off, prev_key_len, cur_buf + key_off, klen, ic);
                    }
                    var ng1: i64 = 1;
                    if (count > 0) {
                        if (equal == 1) { ng1 = 0; }
                    }
                    _uq_group_line(out_fd, cur_buf, cur_len, ng1, term_byte);
                    if (count > 0) {
                        if (equal == 1) {
                            count = count + 1;
                        } else {
                            _uq_emit_group(out_fd, prev_buf, prev_len, count, show_c, show_d, show_u, term_byte);
                            memcpy(prev_buf, cur_buf, cur_len);
                            prev_len = cur_len;
                            prev_key_off = key_off;
                            prev_key_len = klen;
                            count = 1;
                        }
                    } else {
                        memcpy(prev_buf, cur_buf, cur_len);
                        prev_len = cur_len;
                        prev_key_off = key_off;
                        prev_key_len = klen;
                        count = 1;
                    }
                    cur_len = 0;
                }
                # Final flush.
                if (count > 0) {
                    _uq_emit_group(out_fd, prev_buf, prev_len, count, show_c, show_d, show_u, term_byte);
                }
                loop = 0;
            } else {
                var i: i64 = 0;
                while (i < n) {
                    var b = load8(read_buf + i);
                    if (b == term_byte) {
                        # Line complete.
                        var klen_box[8];
                        var key_off = _uq_key_window(cur_buf, cur_len, skip_f, skip_s, cw, &klen_box);
                        var klen = load64(&klen_box);
                        var ng2: i64 = 1;
                        if (count > 0) {
                            var equal = _uq_keys_equal(prev_buf + prev_key_off, prev_key_len, cur_buf + key_off, klen,
                                                       ic);
                            ng2 = 0;
                            if (equal == 1) {
                                _uq_group_line(out_fd, cur_buf, cur_len, 0, term_byte);
                                count = count + 1;
                            } else {
                                _uq_group_line(out_fd, cur_buf, cur_len, 1, term_byte);
                                _uq_emit_group(out_fd, prev_buf, prev_len, count, show_c, show_d, show_u, term_byte);
                                memcpy(prev_buf, cur_buf, cur_len);
                                prev_len = cur_len;
                                prev_key_off = key_off;
                                prev_key_len = klen;
                                count = 1;
                            }
                        } else {
                            _uq_group_line(out_fd, cur_buf, cur_len, 1, term_byte);
                            memcpy(prev_buf, cur_buf, cur_len);
                            prev_len = cur_len;
                            prev_key_off = key_off;
                            prev_key_len = klen;
                            count = 1;
                        }
                        cur_len = 0;
                    } else {
                        if (cur_len < _UQ_LINE_SZ - 1) {
                            store8(cur_buf + cur_len, b);
                            cur_len = cur_len + 1;
                        } else {
                            if (truncated_warned == 0) {
                                k_write( 2, "kriya uniq: warning: line exceeds 64 KiB; truncating\n", 53);
                                truncated_warned = 1;
                            }
                        }
                    }
                    i = i + 1;
                }
            }
        }
    }
    return 0;
}

fn cmd_uniq(start: i64): i64 {
    _uq_init_spec();
    # ⚠ TWO optional-value longs — the first utility to need more than one, which is
    # why `kriya_args_parse_optval` grew a registry at 1.4.3. Both `--group` and
    # `--all-repeated` are legal bare AND with `=METHOD`.
    if (kriya_args_parse_optval2(_uq_spec, start, 0, "group", "all-repeated") != 0) {
        k_write( 2, "kriya uniq: error: bad option (see ADR 0002 for accepted syntax)\n", 65);
        return EXIT_USAGE;
    }

    var show_c: i64 = 0;
    if (flags_get_bool(_uq_spec, _uq_c_idx) == 1) { show_c = 1; }
    var show_d: i64 = 0;
    if (flags_get_bool(_uq_spec, _uq_d_idx) == 1) { show_d = 1; }
    var show_u: i64 = 0;
    if (flags_get_bool(_uq_spec, _uq_u_idx) == 1) { show_u = 1; }
    var ic: i64 = 0;
    if (flags_get_bool(_uq_spec, _uq_i_idx) == 1) { ic = 1; }
    var zero_term: i64 = 0;
    if (flags_get_bool(_uq_spec, _uq_z_idx) == 1) { zero_term = 1; }

    var skip_f: i64 = 0;
    var f_arg = flags_get_str(_uq_spec, _uq_f_idx);
    if (f_arg != 0) {
        if (load8(f_arg) != 0) {
            var v = kriya_parse_nonneg_int(f_arg);
            if (v < 0) {
                k_write( 2, "kriya uniq: error: --skip-fields requires a non-negative integer\n", 65);
                return EXIT_USAGE;
            }
            skip_f = v;
        }
    }
    var skip_s: i64 = 0;
    var s_arg = flags_get_str(_uq_spec, _uq_s_idx);
    if (s_arg != 0) {
        if (load8(s_arg) != 0) {
            var v = kriya_parse_nonneg_int(s_arg);
            if (v < 0) {
                k_write( 2, "kriya uniq: error: --skip-chars requires a non-negative integer\n", 64);
                return EXIT_USAGE;
            }
            skip_s = v;
        }
    }
    var cw: i64 = 0 - 1;  # -1 = no cap
    var w_arg = flags_get_str(_uq_spec, _uq_w_idx);
    if (w_arg != 0) {
        if (load8(w_arg) != 0) {
            var v = kriya_parse_nonneg_int(w_arg);
            if (v < 0) {
                k_write( 2, "kriya uniq: error: --check-chars requires a non-negative integer\n", 65);
                return EXIT_USAGE;
            }
            cw = v;
        }
    }

    var term_byte: i64 = 10;
    if (zero_term == 1) { term_byte = 0; }

    var npos = flags_positional_count(_uq_spec);
    if (npos > 2) {
        k_write( 2, "kriya uniq: error: at most two positional operands (INPUT [OUTPUT])\n", 68);
        return EXIT_USAGE;
    }

    var in_fd: i64 = 0;
    var out_fd: i64 = 1;
    var in_opened: i64 = 0;
    var out_opened: i64 = 0;
    var any_failed: i64 = 0;

    if (npos >= 1) {
        var p = flags_positional(_uq_spec, 0);
        var is_stdin: i64 = 0;
        if (load8(p) == 45) {
            if (load8(p + 1) == 0) { is_stdin = 1; }
        }
        if (is_stdin == 0) {
            in_fd = k_open(p, 0, 0);
            if (in_fd < 0) {
                _uq_report(p, 0 - in_fd);
                return EXIT_FAILURE;
            }
            in_opened = 1;
        }
    }
    if (npos == 2) {
        var p = flags_positional(_uq_spec, 1);
        # O_WRONLY | O_CREAT | O_TRUNC = 577. Mode 0666 = 438.
        out_fd = k_open(p, 577, 438);
        if (out_fd < 0) {
            _uq_report(p, 0 - out_fd);
            if (in_opened == 1) { k_close( in_fd); }
            return EXIT_FAILURE;
        }
        out_opened = 1;
    }

    # ⛔ --group is mutually exclusive with -c/-d/-D/-u, and --all-repeated with
    # -c specifically. GNU's wording, verified: "--group is mutually exclusive
    # with -c/-d/-D/-u" and "printing all duplicated lines and repeat counts is
    # meaningless". ⚠ `--all-repeated -d` and `-u` are ACCEPTED by GNU, so they
    # are not rejected here either.
    var g_arg = kriya_long_value_for("group");
    var a_arg = kriya_long_value_for("all-repeated");
    var d_flag = flags_get_bool(_uq_spec, _uq_D_idx);
    var has_g = flags_get_bool(_uq_spec, _uq_g_idx);
    var has_a = flags_get_bool(_uq_spec, _uq_A_idx);
    if (d_flag == 1) { has_a = 1; }
    if (has_g == 1) {
        var conflict: i64 = 0;
        if (show_c == 1) { conflict = 1; }
        if (show_d == 1) { conflict = 1; }
        if (show_u == 1) { conflict = 1; }
        if (has_a == 1)  { conflict = 1; }
        if (conflict == 1) {
            k_write( 2, "kriya uniq: error: --group is mutually exclusive with -c/-d/-D/-u\n", 66);
            return EXIT_USAGE;
        }
        _uq_gmode = UQ_G_GROUP;
        _uq_gmethod = _uq_parse_method(g_arg, 1);
        if (_uq_gmethod < 0) { return EXIT_USAGE; }
    } elif (has_a == 1) {
        if (show_c == 1) {
            k_write( 2, "kriya uniq: error: printing all duplicated lines and repeat counts is meaningless\n", 82);
            return EXIT_USAGE;
        }
        _uq_gmode = UQ_G_ALLREP;
        if (show_u == 1) { _uq_g_skipfirst = 1; }
        _uq_gmethod = _uq_parse_method(a_arg, 0);
        if (_uq_gmethod < 0) { return EXIT_USAGE; }
    }

    var r = _uq_run(in_fd, out_fd, skip_f, skip_s, cw, ic, show_c, show_d, show_u, term_byte);
    _uq_group_finish(out_fd, term_byte);
    if (r != 0) {
        _uq_report("(read)", 0 - r);
        any_failed = 1;
    }

    if (in_opened == 1)  { k_close( in_fd); }
    if (out_opened == 1) { k_close( out_fd); }

    if (any_failed == 1) { return EXIT_FAILURE; }
    return EXIT_SUCCESS;
}
