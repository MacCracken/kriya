# ln — POSIX `ln(1)`: create hard and symbolic links.
#
# Argument shapes:
#   ln [opts] TARGET                — link TARGET in cwd, named basename(TARGET)
#   ln [opts] TARGET LINKNAME       — create LINKNAME pointing at TARGET
#   ln [opts] TARGET... DIRECTORY   — for each TARGET, create DIRECTORY/basename(TARGET)
#
# Flags:
#   -s / --symbolic        create a symbolic link instead of a hard link.
#   -f / --force           remove an existing destination before linking.
#   -P / --physical        with hard links, link the symlink itself, not
#                          its target (ADR 0003: ln's `-P` semantics).
#   -n / --no-dereference  when LINKNAME is an existing symlink-to-directory,
#                          treat it as the destination (replace the link),
#                          not as a directory to link into. Required for
#                          the `ln -sfn newdir.tmp linkdir` atomic-retarget
#                          idiom called out in ADR 0003.
#   -v / --verbose         print a line per link as it is created.
#
# GNU `-r` (relative symlink resolution), `-T` (no-target-directory),
# `-t` (target-directory), and `-b` / `--backup` are not implemented at
# M2 — separate utility-specific work in M3 once a use case lands.
#
# Symlink policy (ADR 0003):
#   - `ln -s TARGET LINK`     — TARGET is text. No filesystem deref.
#   - `ln TARGET LINK`        — hard link; follow TARGET if it is a
#                               symlink (POSIX). `-P` flips to "link
#                               the symlink itself".
#
# Root protection (ADR 0004): ln is non-destructive of existing data
# unless `-f` is in play; even with `-f`, the operand is the LINK
# being unlinked (a single name), not a recursive walk. No protected_paths
# check is needed.
#
# Each TARGET is attempted independently. Exit EXIT_FAILURE if any
# operation failed, EXIT_SUCCESS otherwise.

var _ln_spec = 0;
var _ln_s_idx = 0;
var _ln_f_idx = 0;
var _ln_P_idx = 0;
var _ln_n_idx = 0;
var _ln_v_idx = 0;
var _ln_r_idx = 0;
var _ln_T_idx = 0;
var _ln_t_idx = 0;

fn _ln_init_spec(): i64 {
    if (_ln_spec != 0) { return 0; }
    var s = flags_new();
    _ln_s_idx = flags_add_bool(s, 115, "symbolic",       0, "create a symbolic link");
    _ln_f_idx = flags_add_bool(s, 102, "force",          0, "remove existing destination first");
    _ln_P_idx = flags_add_bool(s, 80,  "physical",       0, "hard-link the symlink itself, not its target");
    _ln_n_idx = flags_add_bool(s, 110, "no-dereference", 0,
                               "treat symlink-to-directory destination as a name to replace");
    _ln_v_idx = flags_add_bool(s, 118, "verbose",        0, "print each link as it is created");
    _ln_r_idx = flags_add_bool(s, 114, "relative",        0, "make the symlink target relative to the link");
    _ln_T_idx = flags_add_bool(s, 84,  "no-target-directory", 0,
                               "treat the destination as a name, never as a directory");
    _ln_t_idx = flags_add_str(s,  116, "target-directory",  0,
                              "link every operand into this directory");
    _ln_spec = s;
    ln_help_declare();
    return 0;
}

# Help/introspection record for `ln`. ⭐ Split out so `kriya --list` can
# populate it WITHOUT running the utility — one declaration feeding `--help`,
# `--help=json` and `--list` alike.
fn ln_help_declare(): i64 {
    help_begin("ln", "Create hard links and symbolic links.",
               "ln [OPTIONS] TARGET [LINKNAME]");
    help_positional(1, HELP_POS_UNBOUNDED, "TARGET,LINKNAME");
    help_destructive(1);
    help_operands("Without -s a hard link is made. ⚠ Under -f the new link is created under a temporary name and renamed over the destination, so the destination is never lost when the link cannot be made.");  #skip-lint
    help_exit(1, "the link could not be created");
    help_example("ln -s /usr/share/doc docs");
    help_example("ln -f a.txt b.txt");
    help_example("ln -s ../lib/x.so .");
    return 0;
}

fn _ln_report(operand, errno): i64 {
    k_write( 2, "kriya ln: ", 10);
    k_write( 2, operand, strlen(operand));
    k_write( 2, ": ", 2);
    if (errmsg_is_known(errno) == 1) {
        var m = errmsg_for(errno);
        k_write( 2, m, strlen(m));
    } else {
        k_write( 2, "errno ", 6);
        var buf[8];
        var i: i64 = 7;
        store8(&buf + i, 0);
        i = i - 1;
        var v = errno;
        if (v == 0) { store8(&buf + i, 48); i = i - 1; }
        while (v > 0) {
            store8(&buf + i, 48 + (v - (v / 10) * 10));
            v = v / 10;
            i = i - 1;
        }
        k_write( 2, &buf + i + 1, 6 - i);
    }
    k_write( 2, "\n", 1);
    return 0;
}

# lstat-based "is `path` a directory?" — symlinks to directories are
# NOT counted as directories so the `-n` no-dereference policy works.
# k_lstat fills the canonical Linux 144-byte stat layout on BOTH targets
# (on agnos it is identical to k_stat since there are no symlinks).
fn _ln_is_real_dir(path): i64 {
    var buf[144];
    var r = k_lstat(path, &buf);
    if (r != 0) { return 0; }
    var st_mode = load64(&buf + 24);
    if ((st_mode & 61440) == 16384) { return 1; }  # S_IFMT/S_IFDIR
    return 0;
}

# Plain stat (follows symlinks). Used when `-n` is NOT set and we need
# the GNU/POSIX "if destination resolves to a directory, link into it"
# behavior.
fn _ln_resolved_dir(path): i64 {
    var buf[144];
    var r = k_stat(path, &buf);
    if (r != 0) { return 0; }
    var st_mode = load64(&buf + 24);
    if ((st_mode & 61440) == 16384) { return 1; }
    return 0;
}

# ⛔ `_ln_resolve_dest` LIVED HERE AND HAD ZERO CALLERS. It was written to
# compose the final destination for a (target, dest) pair, and `cmd_ln` grew its
# own inline copy of the same three-way classification instead — so the file
# carried two answers to one question, one of them untested and unreachable.
# Removed at v1.6.2, while adding `-t` and `-T` to the arm that is real.
# ⚠ Nothing flags this: cyrius reports unreachable functions as a build NOTE
# with a count in the hundreds (nearly all stdlib), so one more in the pile says
# nothing at all.

# The link NAME for a source operand: its basename, with any trailing slashes
# trimmed, as a fresh cstring.
#
# ⛔ `path_basename_ptr` CANNOT BE USED HERE, and its own header says so — it is a
# pointer-only fast path whose contract is "caller must trim trailing slashes".
# `cmd_ln` handed it raw operand text for as long as the multi-into-directory
# form has existed, so `ln -s f/ dir/` failed with `dir/f/: no such file or
# directory` where GNU creates `dir/f`. `path_basename_len` is the one that
# handles the trim; this wraps it and copies, because the caller needs a string
# it can join.
#
# ⚠ Returns 0 when the operand has no usable basename — `/` is the case, where
# the "basename" is the root itself. The caller reports rather than joining,
# because `path_join(dir, "/")` yields `/` and a link at the filesystem ROOT is
# not what anybody meant.
fn _ln_base_of(p): i64 {
    var n = path_basename_len(p);
    if (n < 1) { return 0; }
    var b = path_basename_ptr(p);
    if (n == 1) {
        if (load8(b) == 47) { return 0; }                # the operand was "/"
    }
    var out = alloc(n + 1);
    memcpy(out, b, n);
    store8(out + n, 0);
    return out;
}

# `-r`: the TARGET text rewritten relative to the directory the LINK will live in.
#
# ⛔ BOTH SIDES ARE CANONICALISED FIRST, and that is measured rather than assumed.
# GNU resolves symlinks in both operands: `ln -sr slink/sub/f out` where `slink`
# is a symlink to `real` writes **real/sub/f**, and a link created inside a
# symlinked directory is expressed relative to the REAL directory. So this is not
# a textual `..`-counting exercise on the strings the user typed.
#
# ⚠ ALLOW_MISSING, not REQUIRE_ALL: `ln -sr nonexistent link` succeeds under GNU
# and writes `nonexistent`. A dangling target resolves through its own link text
# first — measured, `dangling -> /nowhere` came out as the relative form of
# `/nowhere`, not of `dangling`.
#
# ⚠ On a canonicalisation failure the ORIGINAL target is returned unchanged. The
# link is still worth creating; guessing at a relative form we could not compute
# is the one thing that would be worse than not rewriting.
fn _ln_relative_target(target, link): i64 {
    var tbuf = alloc(4096);
    var tn = fs_realpath(target, FS_REALPATH_ALLOW_MISSING, tbuf, 4096);
    if (tn < 0) { return target; }
    var ldir = path_dirname(link);
    var dbuf = alloc(4096);
    var dn = fs_realpath(ldir, FS_REALPATH_ALLOW_MISSING, dbuf, 4096);
    if (dn < 0) { return target; }
    return path_relative(dbuf, tbuf);
}

# Make one link. Returns 0 on success, negative errno on failure.
# `symbolic`: -s flag.  `physical`: -P (no-follow for hard link).
# `force`: -f (unlink existing dest first if needed).
# One link attempt. Returns 0 or a negative errno and reports nothing — the
# caller retries this under -f, so a diagnostic here would fire twice.
#
# Hard link: on Linux, linkat gives an explicit follow policy (SYS_LINKAT = 265,
# AT_FDCWD = -100, AT_SYMLINK_FOLLOW = 1024). Default (no -P) follows the source
# symlink, which is POSIX `ln` behaviour; -P does not. agnos has no *at() family
# and no symlinks, so the plain hard link routes through k_link (ext2 supports
# hard links).
fn _ln_link_once(target, link, symbolic, physical): i64 {
    if (symbolic == 1) {
        return k_symlink(target, link);
    }
    if (K_HAVE_ATFAMILY == 1) {
        var flags: i64 = 1024;
        if (physical == 1) { flags = 0; }
        return fs_linkat(0 - 100, target, 0 - 100, link, flags);
    }
    return k_link(target, link);
}

# "<dirname(link)>/.kriya-ln-tmp-N". Same directory as the final link, so the
# rename that follows is same-filesystem and therefore atomic.
fn _ln_tmp_name(link, n): i64 {
    var dir = path_dirname(link);
    var b = alloc(20);
    var s = ".kriya-ln-tmp-";
    var i: i64 = 0;
    while (i < 14) {
        store8(b + i, load8(s + i));
        i = i + 1;
    }
    store8(b + 14, 48 + n);
    store8(b + 15, 0);
    return path_join(dir, b);
}

fn _ln_make(target, link, symbolic, physical, force, verbose): i64 {
    if (symbolic == 1) {
        # agnos has no symlinks (K_HAVE_SYMLINK == 0); refuse cleanly
        # rather than silently misbehaving. On Linux this branch is DCE'd.
        if (K_HAVE_SYMLINK == 0) {
            k_write( 2, "kriya ln: symbolic links not supported on AGNOS\n", 48);
            return EXIT_FAILURE;
        }
    }

    # ⛔ -f MUST NOT UNLINK BEFORE IT KNOWS A REPLACEMENT CAN BE MADE. It used to
    # unlink unconditionally and then attempt the link, so any failure after that
    # point destroyed the destination and put nothing in its place. Measured:
    # `ln -f /nonexistent-src keep.txt` reported "no such file or directory" and
    # DELETED keep.txt, whose contents were the only copy. GNU reports the same
    # error and leaves the file alone. `ln -f` across filesystems (EXDEV) had the
    # same shape.
    #
    # ⭐ So the link is attempted FIRST, and an existing destination is replaced
    # by LINK-TO-TEMP-THEN-RENAME, which is what GNU does. The destination is
    # never absent: `renameat` swaps a finished link over it atomically, and if
    # anything fails first the temp is cleaned up and the original still stands.
    #
    # ⛔ "UNLINK THEN RETRY" IS NOT GOOD ENOUGH, AND THE REASON IS NON-OBVIOUS.
    # The tempting shortcut is to treat EEXIST as proof the source is linkable
    # and only then unlink — but the KERNEL CHECKS EEXIST BEFORE EXDEV. Verified
    # against linkat(2) directly: a cross-device link onto an existing path
    # answers errno 17, not 18. So that shortcut still deleted the destination
    # and then failed with "invalid cross-device link", which is exactly the bug,
    # narrowed rather than fixed.
    #
    # The temp name needs no `getpid` — `link`/`symlink` are atomic
    # create-if-absent, so a colliding name simply answers EEXIST and we take the
    # next one. Ten candidates is far past any real contention; beyond that we
    # report EEXIST rather than guessing.
    var r = _ln_link_once(target, link, symbolic, physical);
    if (r == (0 - 17)) {                                   # EEXIST
        if (force == 1) {
            var n: i64 = 0;
            var placed: i64 = 0;
            var last = r;
            while (n < 10) {
                if (placed == 0) {
                    var tmp = _ln_tmp_name(link, n);
                    var tr = _ln_link_once(target, tmp, symbolic, physical);
                    if (tr == 0) {
                        var mr = fs_rename(tmp, link);
                        if (mr == 0) {
                            placed = 1;
                            last = 0;
                        } else {
                            k_unlink(tmp);
                            last = mr;
                            n = 10;                        # give up: report mr
                        }
                    } else {
                        # EEXIST means this temp name is taken — try the next.
                        # Anything else is the real reason the link cannot be
                        # made, and the destination must survive it.
                        if (tr != (0 - 17)) {
                            last = tr;
                            n = 10;
                        }
                    }
                }
                n = n + 1;
            }
            r = last;
        }
    }
    if (r != 0) {
        _ln_report(link, 0 - r);
        return r;
    }
    if (verbose == 1) {
        k_write( 1, "kriya ln: '", 11);
        k_write( 1, link, strlen(link));
        if (symbolic == 1) {
            k_write( 1, "' -> '", 6);
        } else {
            k_write( 1, "' => '", 6);  # => for hard, -> for symbolic
        }
        k_write( 1, target, strlen(target));
        k_write( 1, "'\n", 2);
    }
    return 0;
}

# One (target, link) pair, with `-r` applied if it is on. ⚠ The rewrite is
# per-pair because it depends on the LINK's directory, which differs for every
# operand of a multi-source form.
fn _ln_make_pair(target, link, relative, symbolic, physical, force, verbose): i64 {
    var t = target;
    if (relative == 1) { t = _ln_relative_target(target, link); }
    return _ln_make(t, link, symbolic, physical, force, verbose);
}

# How many times a target directory was named. ⚠ The flag table keeps only the
# LAST value, so a repeat is invisible to it — and GNU treats a repeat as fatal
# (`multiple target directories specified`) rather than taking the last. One argv
# walk is the only way to see it, the same shape `cp` needed for a bare `-p`.
fn _ln_count_target_dir(start: i64): i64 {
    var n = kriya_argv_count();
    var i = start;
    var seen: i64 = 0;
    var no_more: i64 = 0;
    while (i < n) {
        var tok = argv(i);
        var tlen = strlen(tok);
        if (no_more == 0) {
            if (tlen >= 2) {
                if (load8(tok) == 45) {
                    if (load8(tok + 1) == 45) {
                        if (tlen == 2) { no_more = 1; }
                        else {
                            if (streq(tok, "--target-directory") == 1) { seen = seen + 1; }
                            else {
                                # ⚠ `match` is a RESERVED KEYWORD in Cyrius and
                                # cannot name a variable — the compiler says so
                                # plainly, but only after you have written it.
                                var pre = "--target-directory=";
                                var k: i64 = 0;
                                var same: i64 = 1;
                                if (tlen < 19) { same = 0; }
                                while (k < 19) {
                                    if (same == 1) {
                                        if (load8(tok + k) != load8(pre + k)) { same = 0; }
                                    }
                                    k = k + 1;
                                }
                                if (same == 1) { seen = seen + 1; }
                            }
                        }
                    } else {
                        var q: i64 = 1;
                        while (q < tlen) {
                            if (load8(tok + q) == 116) { seen = seen + 1; }   # 't'
                            q = q + 1;
                        }
                    }
                }
            }
        }
        i = i + 1;
    }
    return seen;
}

fn cmd_ln(start: i64): i64 {
    _ln_init_spec();
    if (kriya_args_parse(_ln_spec, start) != 0) {
        k_write( 2, "kriya ln: error: bad option (see ADR 0002 for accepted syntax)\n", 63);
        return EXIT_USAGE;
    }

    var npos = flags_positional_count(_ln_spec);
    if (npos < 1) {
        k_write( 2, "kriya ln: error: missing operand\n", 33);
        return EXIT_USAGE;
    }

    var symbolic: i64 = 0;
    if (flags_get_bool(_ln_spec, _ln_s_idx) == 1) { symbolic = 1; }
    var force: i64 = 0;
    if (flags_get_bool(_ln_spec, _ln_f_idx) == 1) { force = 1; }
    var physical: i64 = 0;
    if (flags_get_bool(_ln_spec, _ln_P_idx) == 1) { physical = 1; }
    var no_deref: i64 = 0;
    if (flags_get_bool(_ln_spec, _ln_n_idx) == 1) { no_deref = 1; }
    var verbose: i64 = 0;
    if (flags_get_bool(_ln_spec, _ln_v_idx) == 1) { verbose = 1; }
    var relative: i64 = 0;
    if (flags_get_bool(_ln_spec, _ln_r_idx) == 1) { relative = 1; }
    var no_target_dir: i64 = 0;
    if (flags_get_bool(_ln_spec, _ln_T_idx) == 1) { no_target_dir = 1; }
    var target_dir = flags_get_str(_ln_spec, _ln_t_idx);

    # ⚠ `-r` rewrites the text a SYMLINK carries, so it has nothing to say about
    # a hard link. GNU refuses rather than ignoring the flag — the same
    # accepts-and-lies rule this project applies everywhere else.
    if (relative == 1) {
        if (symbolic == 0) {
            k_write( 2, "kriya ln: error: cannot do --relative without --symbolic\n", 57);
            return EXIT_USAGE;
        }
    }
    # ⚠ The two target-directory flags are opposites; GNU refuses the pair.
    if (target_dir != 0) {
        if (no_target_dir == 1) {
            k_write( 2, "kriya ln: error: cannot combine --target-directory and --no-target-directory\n", 77);
            return EXIT_USAGE;
        }
        # ⛔ A REPEATED `-t` IS FATAL, not last-one-wins. The flag table keeps only
        # the last value, so taking it would silently link into a directory the
        # user also named something else for — GNU says
        # `multiple target directories specified` and refuses.
        if (_ln_count_target_dir(start) > 1) {
            k_write( 2, "kriya ln: error: multiple target directories specified\n", 55);
            return EXIT_USAGE;
        }
    }
    # ⛔ `-T` MEANS "THE DESTINATION IS A NAME", WHICH ONLY MAKES SENSE FOR A PAIR.
    # It was checked in the two-or-more arm alone, so `ln -sT f` fell into the
    # one-operand form and tried to link `f` to itself — reporting `f: file
    # exists` where GNU says `missing destination file operand after 'f'`.
    if (no_target_dir == 1) {
        if (npos < 2) {
            k_write( 2, "kriya ln: error: missing destination file operand after '", 57);
            k_write( 2, flags_positional(_ln_spec, 0), strlen(flags_positional(_ln_spec, 0)));
            k_write( 2, "'\n", 2);
            return EXIT_USAGE;
        }
        if (npos > 2) {
            k_write( 2, "kriya ln: error: extra operand '", 32);
            k_write( 2, flags_positional(_ln_spec, npos - 1), strlen(flags_positional(_ln_spec, npos - 1)));
            k_write( 2, "'\n", 2);
            return EXIT_USAGE;
        }
    }

    var any_failed: i64 = 0;

    # ⭐ `-t DIR`: EVERY operand is a source and DIR is the destination, so the
    # last-operand-is-the-destination rule below does not apply at all. That is
    # the flag's whole purpose — it makes `ln -s ... -t dir` safe to build from a
    # variable that might expand to one name or to none.
    if (target_dir != 0) {
        var td_st[144];
        var tdr = k_stat(target_dir, &td_st);
        if (tdr != 0) {
            # ⚠ The REAL errno, not a hardcoded ENOENT. `-t f/sub` where `f` is a
            # file is ENOTDIR, and reporting "no such file or directory" for it
            # sends the reader looking for something that is right there.
            _ln_report(target_dir, 0 - tdr);
            return EXIT_FAILURE;
        }
        if (fs_is_dir(&td_st) == 0) {
            k_write( 2, "kriya ln: target '", 18);
            k_write( 2, target_dir, strlen(target_dir));
            k_write( 2, "' is not a directory\n", 21);
            return EXIT_FAILURE;
        }
        var ti: i64 = 0;
        while (ti < npos) {
            var tsrc = flags_positional(_ln_spec, ti);
            var tbase = _ln_base_of(tsrc);
            if (tbase == 0) {
                _ln_report(tsrc, 22);                        # EINVAL — "/" has no basename
                any_failed = 1;
                ti = ti + 1;
                continue;
            }
            var tlink = path_join(target_dir, tbase);
            var tr = _ln_make_pair(tsrc, tlink, relative, symbolic, physical, force, verbose);
            if (tr != 0) { any_failed = 1; }
            ti = ti + 1;
        }
        if (any_failed == 1) { return EXIT_FAILURE; }
        return EXIT_SUCCESS;
    }

    if (npos == 1) {
        # ln TARGET — create basename(TARGET) in cwd.
        var target = flags_positional(_ln_spec, 0);
        var base = _ln_base_of(target);
        if (base == 0) {
            _ln_report(target, 22);                          # EINVAL
            return EXIT_FAILURE;
        }
        # Materialise a stable cstring for `base` (it points into
        # `target`'s buffer; safe for our usage since we don't mutate).
        var r = _ln_make_pair(target, base, relative, symbolic, physical, force, verbose);
        if (r != 0) { any_failed = 1; }
    } else {
        # 2+ args. Last is dest_arg. If it resolves to a directory (or
        # is a real directory under -n), all prior args are sources to
        # link into it. Else exactly 2 args is required (target, link).
        var dest_arg = flags_positional(_ln_spec, npos - 1);
        var dest_is_dir: i64 = 0;
        if (no_deref == 1) {
            dest_is_dir = _ln_is_real_dir(dest_arg);
        } else {
            dest_is_dir = _ln_resolved_dir(dest_arg);
        }
        # ⛔ `-T` IS NOT `-n`, and conflating them is the easy mistake. `-n` asks
        # "is the destination a symlink TO a directory — if so replace the link
        # rather than descend into it", and still treats a REAL directory as a
        # place to link into. `-T` says the destination is a NAME, full stop: it
        # never descends, so `ln -sT foo existingdir` fails with EEXIST where the
        # bare form would have created `existingdir/foo`. Measured on both.
        if (no_target_dir == 1) { dest_is_dir = 0; }

        if (dest_is_dir == 0) {
            if (npos != 2) {
                k_write( 2, "kriya ln: error: with multiple sources, the last operand must be a directory\n", 77);
                return EXIT_USAGE;
            }
            var target = flags_positional(_ln_spec, 0);
            var r = _ln_make_pair(target, dest_arg, relative, symbolic, physical, force, verbose);
            if (r != 0) { any_failed = 1; }
        } else {
            # Multi-source-into-dir form.
            var i: i64 = 0;
            while (i < npos - 1) {
                var target = flags_positional(_ln_spec, i);
                var base = _ln_base_of(target);
                if (base == 0) {
                    _ln_report(target, 22);                  # EINVAL
                    any_failed = 1;
                    i = i + 1;
                    continue;
                }
                var link = path_join(dest_arg, base);
                var r = _ln_make_pair(target, link, relative, symbolic, physical, force, verbose);
                if (r != 0) { any_failed = 1; }
                i = i + 1;
            }
        }
    }

    if (any_failed == 1) { return EXIT_FAILURE; }
    return EXIT_SUCCESS;
}
