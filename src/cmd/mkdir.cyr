# mkdir — POSIX `mkdir(1)`: create directories.
#
# Flags:
#   -p / --parents       create parent components as needed; existing
#                        directories are not an error.
#   -m / --mode MODE     set the mode of the named directory (final
#                        component only, per POSIX). Octal only at M2;
#                        symbolic forms (`u+rwx`) land with chmod in M3.
#   -v / --verbose       print a line for each created directory.
#
# Mode handling: sys_mkdir is always called with 0777 so the kernel's
# umask filtering applies (default behaviour). When `-m` is set we
# follow up with sys_chmod on the final component, which bypasses
# umask — matches GNU mkdir. Intermediate `-p` components are NOT
# touched by `-m` (POSIX requires this explicitly).
#
# Symlink policy (ADR 0003): mkdir doesn't traverse symlinks of its
# own volition. With `-p`, if an intermediate component already exists
# as a symlink-to-directory the kernel happily continues (POSIX
# permits this); the resulting EEXIST is treated as success because
# `stat` reports S_IFDIR through the link. This matches GNU and POSIX.
#
# Error continuation: each operand is attempted in turn. The
# invocation's exit code is EXIT_FAILURE if any operand failed,
# EXIT_SUCCESS if all succeeded.

var _mkdir_spec    = 0;
var _mkdir_p_idx   = 0;
var _mkdir_m_idx   = 0;
var _mkdir_v_idx   = 0;

fn _mkdir_init_spec(): i64 {
    if (_mkdir_spec != 0) { return 0; }
    var s = flags_new();
    _mkdir_p_idx = flags_add_bool(s, 112, "parents", 0, "create parents as needed; existing dirs ok");
    _mkdir_m_idx = flags_add_str(s,  109, "mode",    0, "set final-component mode (octal)");
    _mkdir_v_idx = flags_add_bool(s, 118, "verbose", 0, "print a line per created directory");
    _mkdir_spec = s;
    mkdir_help_declare();
    return 0;
}

# Help/introspection record for `mkdir`. ⭐ Split out so `kriya --list` can
# populate it WITHOUT running the utility — one declaration feeding `--help`,
# `--help=json` and `--list` alike.
fn mkdir_help_declare(): i64 {
    help_begin("mkdir", "Create directories.",
               "mkdir [OPTIONS] DIRECTORY...");
    help_positional(1, HELP_POS_UNBOUNDED, "DIRECTORY");
    help_destructive(1);
    help_exit(1, "a directory could not be created");
    help_example("mkdir build");
    help_example("mkdir -p a/b/c");
    help_example("mkdir -m 700 private");
    return 0;
}

# Emit `kriya mkdir: <operand>: <message>\n` per arch note 001.
fn _mkdir_report(operand, errno): i64 {
    k_write( 2, "kriya mkdir: ", 13);
    k_write( 2, operand, strlen(operand));
    k_write( 2, ": ", 2);
    if (errmsg_is_known(errno) == 1) {
        var m = errmsg_for(errno);
        k_write( 2, m, strlen(m));
    } else {
        k_write( 2, "errno ", 6);
        # Render errno as up to 4 digits.
        var buf[8];
        var i: i64 = 7;
        store8(&buf + i, 0);
        i = i - 1;
        var v = errno;
        if (v == 0) { store8(&buf + i, 48); i = i - 1; }
        while (v > 0) {
            store8(&buf + i, 48 + (v - (v / 10) * 10));
            v = v / 10;
            i = i - 1;
        }
        k_write( 2, &buf + i + 1, 6 - i);
    }
    k_write( 2, "\n", 1);
    return 0;
}

# Inspect existing path: return 1 if it is a directory, 0 otherwise.
# Used after EEXIST to honour POSIX's `-p` "existing dir ok / existing
# non-dir error" split.
fn _mkdir_is_dir(path): i64 {
    var buf[144];
    var sr = k_stat(path, &buf);
    if (sr != 0) { return 0; }
    var st_mode = load64(&buf + 24);
    # S_IFMT = 0o170000 (61440); S_IFDIR = 0o040000 (16384).
    if ((st_mode & 61440) == 16384) { return 1; }
    return 0;
}

fn _mkdir_verbose_print(path): i64 {
    k_write( 1, "kriya mkdir: created directory '", 32);
    k_write( 1, path, strlen(path));
    k_write( 1, "'\n", 2);
    return 0;
}

# Single `mkdir(2)` for one final operand. No prefix walking.
# `set_mode`/`mode` carry the `-m` outcome; `verbose` toggles `-v`.
# Returns 0 on success, negative errno on failure.
fn _mkdir_single(path, set_mode, mode, verbose): i64 {
    if (strlen(path) == 0) {
        _mkdir_report(path, 2);
        return 0 - 2;
    }
    var r = k_mkdir(path, 511);
    if (r != 0) {
        _mkdir_report(path, 0 - r);
        return r;
    }
    if (set_mode == 1) {
        var cr = sys_chmod(path, mode);
        if (cr != 0) {
            _mkdir_report(path, 0 - cr);
            return cr;
        }
    }
    if (verbose == 1) { _mkdir_verbose_print(path); }
    return 0;
}

# `mkdir -p PATH`: walk prefixes, creating each missing component.
# Existing directories are silently accepted; an existing non-directory
# is ENOTDIR-style failure. Returns 0 on success, negative errno on
# failure (first failing component wins).
fn _mkdir_with_parents(path, set_mode, mode, verbose): i64 {
    var len = strlen(path);
    if (len == 0) {
        _mkdir_report(path, 2);
        return 0 - 2;
    }

    # Normalize once for the walk. path_normalize collapses `.`, `..`,
    # and duplicate slashes — gives us a clean prefix sequence.
    var norm = path_normalize(path);
    var nlen = strlen(norm);
    if (nlen == 0) { return 0; }

    # Special case: "/" and "." normalize to themselves; nothing to do.
    if (nlen == 1) {
        if (load8(norm) == 47) { return 0; }
        if (load8(norm) == 46) { return 0; }
    }

    var i: i64 = 1;
    var any_made: i64 = 0;
    var last_made: i64 = 0;
    while (i <= nlen) {
        var boundary: i64 = 0;
        if (i == nlen) { boundary = 1; }
        else {
            if (load8(norm + i) == 47) { boundary = 1; }
        }
        if (boundary == 1) {
            var prefix = alloc(i + 1);
            memcpy(prefix, norm, i);
            store8(prefix + i, 0);

            var is_final: i64 = 0;
            if (i == nlen) { is_final = 1; }

            # Skip prefix == "/" (root); the kernel handles it.
            var skip: i64 = 0;
            if (i == 1) {
                if (load8(prefix) == 47) { skip = 1; }
            }

            if (skip == 0) {
                # 0o777 = 511 (Cyrius has no octal literal syntax).
                var r = k_mkdir(prefix, 511);
                if (r == 0) {
                    any_made = 1;
                    last_made = i;
                    if (verbose == 1) { _mkdir_verbose_print(prefix); }
                    if (is_final == 1) {
                        if (set_mode == 1) {
                            var cr = sys_chmod(prefix, mode);
                            if (cr != 0) {
                                _mkdir_report(prefix, 0 - cr);
                                return cr;
                            }
                        }
                    }
                } else {
                    var errno = 0 - r;
                    if (errno == 17) {
                        # EEXIST — ok iff already a directory.
                        if (_mkdir_is_dir(prefix) == 0) {
                            _mkdir_report(prefix, 20);
                            return 0 - 20;
                        }
                        # Existing directory; no chmod, even on final
                        # component, since `-p` says "ok if it exists"
                        # which POSIX takes to mean leave it alone.
                    } else {
                        _mkdir_report(prefix, errno);
                        return r;
                    }
                }
            }
        }
        i = i + 1;
    }
    return 0;
}

fn cmd_mkdir(start: i64): i64 {
    _mkdir_init_spec();
    if (kriya_args_parse(_mkdir_spec, start) != 0) {
        k_write( 2, "kriya mkdir: error: bad option (see ADR 0002 for accepted syntax)\n", 66);
        return EXIT_USAGE;
    }

    var npos = flags_positional_count(_mkdir_spec);
    if (npos < 1) {
        k_write( 2, "kriya mkdir: error: missing operand (need at least one directory name)\n", 71);
        return EXIT_USAGE;
    }

    var parents: i64 = 0;
    if (flags_get_bool(_mkdir_spec, _mkdir_p_idx) == 1) { parents = 1; }
    var verbose: i64 = 0;
    if (flags_get_bool(_mkdir_spec, _mkdir_v_idx) == 1) { verbose = 1; }

    var set_mode: i64 = 0;
    var mode: i64 = 0;
    var mode_str = flags_get_str(_mkdir_spec, _mkdir_m_idx);
    if (mode_str != 0) {
        if (load8(mode_str) != 0) {
            var parsed = kriya_parse_octal_mode(mode_str);
            if (parsed < 0) {
                k_write( 2, "kriya mkdir: error: --mode requires an octal value (e.g. 0755)\n", 63);
                return EXIT_USAGE;
            }
            set_mode = 1;
            mode = parsed;
        }
    }

    var any_failed: i64 = 0;
    var i: i64 = 0;
    while (i < npos) {
        var p = flags_positional(_mkdir_spec, i);
        var r: i64 = 0;
        if (parents == 1) {
            r = _mkdir_with_parents(p, set_mode, mode, verbose);
        } else {
            r = _mkdir_single(p, set_mode, mode, verbose);
        }
        if (r != 0) { any_failed = 1; }
        i = i + 1;
    }

    if (any_failed == 1) { return EXIT_FAILURE; }
    return EXIT_SUCCESS;
}
