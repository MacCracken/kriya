# readlink — POSIX `readlink(1)`: print the value of a symbolic link.
#
# Argument shape:
#   readlink [opts] FILE...
#
# Flags:
#   (no canonicalize flag)         POSIX read-link: print the symlink's
#                                  raw target text. Error if FILE is
#                                  not a symlink (sys_readlink → EINVAL).
#   -f / --canonicalize            canonicalize: every component
#                                  except the last must exist
#                                  (FS_REALPATH_REQUIRE_PARENT).
#   -e / --canonicalize-existing   canonicalize: every component must
#                                  exist (FS_REALPATH_REQUIRE_ALL).
#   -m / --canonicalize-missing    canonicalize: no component need
#                                  exist (FS_REALPATH_ALLOW_MISSING).
#   -n / --no-newline              suppress the trailing newline of
#                                  the FINAL operand's output. Other
#                                  operands still get their newlines.
#   -z / --zero                    NUL-terminate each output (overrides -n).
#   -q / --quiet                   suppress error messages; the exit
#                                  code still reflects failure.
#
# Canonicalize flags are mutually exclusive; if more than one is given
# the LAST one on the command line wins, in any spelling. It is not a
# precedence ladder — `-m -e` is the `-e` answer, as GNU's is.
#
# Each FILE is processed independently. The invocation exits with
# EXIT_FAILURE if any FILE fails; the canonical/raw target paths for
# the others are still emitted to stdout.

var _rl_spec  = 0;
var _rl_f_idx = 0;
var _rl_e_idx = 0;
var _rl_m_idx = 0;
var _rl_n_idx = 0;
var _rl_z_idx = 0;
var _rl_q_idx = 0;
var _rl_s_idx = 0;
var _rl_v_idx = 0;

fn _rl_init_spec(): i64 {
    if (_rl_spec != 0) { return 0; }
    var s = flags_new();
    _rl_f_idx = flags_add_bool(s, 102, "canonicalize",          0, "canonicalize (parent must exist)");
    _rl_e_idx = flags_add_bool(s, 101, "canonicalize-existing", 0, "canonicalize (all must exist)");
    _rl_m_idx = flags_add_bool(s, 109, "canonicalize-missing",  0, "canonicalize (nothing need exist)");
    _rl_n_idx = flags_add_bool(s, 110, "no-newline",            0, "suppress trailing newline of final output");
    _rl_z_idx = flags_add_bool(s, 122, "zero",                  0, "NUL-terminate each output");
    _rl_q_idx = flags_add_bool(s, 113, "quiet",                 0, "suppress error messages (default)");
    # ⚠ `readlink -s` IS NOT `realpath -s`. Here it is a synonym for `-q`; there
    # it means "do not expand symlinks". Two utilities that look alike, one
    # letter, opposite meanings — which is why they do not share a flag table.
    _rl_s_idx = flags_add_bool(s, 115, "silent",                 0, "synonym for -q");
    _rl_v_idx = flags_add_bool(s, 118, "verbose",                0, "report error messages");
    _rl_spec = s;
    readlink_help_declare();
    return 0;
}

# Help/introspection record for `readlink`. ⭐ Split out so `kriya --list` can
# populate it WITHOUT running the utility — one declaration feeding `--help`,
# `--help=json` and `--list` alike.
fn readlink_help_declare(): i64 {
    help_begin("readlink", "Print the target of a symbolic link.",
               "readlink [OPTIONS] FILE...");
    help_positional(1, HELP_POS_UNBOUNDED, "FILE");
    help_operands("Without -f the raw link text is printed and a non-symlink is an error. -f/-e/-m canonicalise, with increasing tolerance for missing components.");  #skip-lint
    help_exit(1, "not a symlink, or the path could not be resolved");
    help_example("readlink /usr/bin/awk");
    help_example("readlink -f ./link");
    return 0;
}

# ⭐ ONE LINE NOW. The 24-line body this replaces was byte-identical in every
# utility apart from the name; `errmsg_report` in `src/lib/report.cyr` is the
# single implementation of architecture 001's framing, and it shell-quotes the
# operand so a name containing a newline cannot split the diagnostic in two.
fn _rl_report(operand, errno): i64 { return errmsg_report("readlink", operand, errno); }

fn cmd_readlink(start: i64): i64 {
    _rl_init_spec();
    if (kriya_args_parse(_rl_spec, start) != 0) {
        k_write( 2, "kriya readlink: error: bad option (see ADR 0002 for accepted syntax)\n", 69);
        return EXIT_USAGE;
    }

    var npos = flags_positional_count(_rl_spec);
    if (npos < 1) {
        k_write( 2, "kriya readlink: error: missing operand\n", 39);
        return EXIT_USAGE;
    }

    # ⛔ SILENT BY DEFAULT, WHICH IS A BREAKING CHANGE AND A DELIBERATE ONE.
    # GNU's `readlink` prints nothing on failure — `readlink plain` is exit 1
    # with no output — while GNU's `realpath` on the same operand is verbose.
    # That asymmetry is GNU's, and `readlink` is the one script authors wrap in
    # `$(readlink -f x)` where a stray stderr line is noise.
    #
    # ⛔ GNU REACHES ITS VERBOSE MODE THROUGH `POSIXLY_CORRECT`, AND THAT
    # VARIABLE BEATS AN EXPLICIT `-q`: measured, `POSIXLY_CORRECT=1 readlink -q
    # plain` still prints the diagnostic. An environment variable overriding a
    # flag the caller wrote is precisely what
    # [ADR 0017](../../docs/adr/0017-environment-variables-configure-features-the-caller-turned-on.md)
    # forbids, so kriya does not honour it — `-v` is the whole opt-in.
    #
    # ⚠ Migration for anyone who relied on kriya's old default: add `-v`.
    var quiet: i64 = 1;
    if (flags_get_bool(_rl_spec, _rl_v_idx) == 1) { quiet = 0; }
    if (flags_get_bool(_rl_spec, _rl_q_idx) == 1) { quiet = 1; }
    if (flags_get_bool(_rl_spec, _rl_s_idx) == 1) { quiet = 1; }
    var no_newline: i64 = 0;
    if (flags_get_bool(_rl_spec, _rl_n_idx) == 1) { no_newline = 1; }
    var zero: i64 = 0;
    if (flags_get_bool(_rl_spec, _rl_z_idx) == 1) { zero = 1; }

    # Determine canonicalize mode.
    # 0 = no canonicalize (POSIX raw read-link).
    # 1 = -f (REQUIRE_PARENT), 2 = -e (REQUIRE_ALL), 3 = -m (ALLOW_MISSING).
    #
    # ⛔ THE THREE ARE LAST-WINS, AND A FIXED PRECEDENCE IS NOT A WAY TO SPELL
    # THAT. This block ranked them `m > e > f` under a comment that called the
    # ranking "matches GNU last-wins" — two incompatible rules in one line, and
    # the ranking is the one that ran. Measured against GNU coreutils 9.11:
    #
    #     $ readlink -m -e nope ; echo rc=$?     rc=1, nothing on stdout
    #     $ kriya readlink -m -e nope            /abs/nope, rc=0
    #
    # A caller checking `readlink -e` for existence got a path back for a file
    # that is not there, because a wrapper had appended `-m` earlier in the line.
    # ⚠ `-e -m` and `-em` agree under BOTH rules, and those are the orders the
    # suite covered.
    #
    # ⭐ The order comes from the parser's expanded argv, so the cluster `-me`
    # answers exactly as the separated `-m -e` does, and each flag's long
    # spelling counts as its own occurrence.
    var canon_mode: i64 = 0;
    var canon_at: i64 = 0;
    var seq_f = kriya_opt_seq(_rl_spec, 102, "canonicalize");
    var seq_e = kriya_opt_seq(_rl_spec, 101, "canonicalize-existing");
    var seq_m = kriya_opt_seq(_rl_spec, 109, "canonicalize-missing");
    if (seq_f > canon_at) { canon_at = seq_f; canon_mode = 1; }
    if (seq_e > canon_at) { canon_at = seq_e; canon_mode = 2; }
    if (seq_m > canon_at) { canon_at = seq_m; canon_mode = 3; }

    # Terminator selection. -z (NUL) overrides -n (no newline on last).
    var term_byte: i64 = 10;
    if (zero == 1) { term_byte = 0; }
    var term_buf[2];
    store8(&term_buf, term_byte);

    var BUFSZ: i64 = 16384;
    var out_buf = alloc(BUFSZ);

    var any_failed: i64 = 0;
    var i: i64 = 0;
    while (i < npos) {
        var p = flags_positional(_rl_spec, i);
        var is_last: i64 = 0;
        if (i == npos - 1) { is_last = 1; }

        var n: i64 = 0;
        if (canon_mode == 0) {
            # POSIX raw read-link. Gated on K_HAVE_READLINK, NOT K_HAVE_SYMLINK: agnos
            # can now CREATE links (symlink#63) while readlink#70 stays pin-blocked, so the
            # two capabilities genuinely diverge. Emit a clear one-line message and
            # mark failure rather than a bare errno. On Linux this
            # branch is DCE'd and the native k_readlink path is taken.
            if (K_HAVE_READLINK == 0) {
                if (quiet == 0) {
                    k_write( 2, "kriya readlink: readlink is not wired on this build\n", 52);
                }
                any_failed = 1;
                i = i + 1;
                continue;
            }
            n = k_readlink(p, out_buf, BUFSZ - 1);
        } else {
            var mode = FS_REALPATH_REQUIRE_PARENT;
            if (canon_mode == 2) { mode = FS_REALPATH_REQUIRE_ALL; }
            if (canon_mode == 3) { mode = FS_REALPATH_ALLOW_MISSING; }
            n = fs_realpath(p, mode, out_buf, BUFSZ);
        }

        if (n < 0) {
            if (quiet == 0) { _rl_report(p, 0 - n); }
            any_failed = 1;
        } else {
            k_write( 1, out_buf, n);
            # Emit terminator: skip ONLY when -n is set, -z is not,
            # and this is the final operand.
            var emit: i64 = 1;
            if (zero == 0) {
                if (no_newline == 1) {
                    if (is_last == 1) { emit = 0; }
                }
            }
            if (emit == 1) {
                k_write( 1, &term_buf, 1);
            }
        }
        i = i + 1;
    }

    if (any_failed == 1) { return EXIT_FAILURE; }
    return EXIT_SUCCESS;
}
