# cut — POSIX `cut(1)`: extract sections from each line of input.
#
# Argument shape:
#   cut OPTIONS [file...]
#
# Modes (exactly one of -b / -c / -f required):
#   -b LIST / --bytes=LIST    extract byte positions.
#   -c LIST / --characters=LIST  extract CHARACTER (codepoint) positions.
#        ⚠ Distinct from -b since 1.4.2: `cut -c2` on `aébc` yields the whole
#        two-byte é, `cut -b2` its lead byte. Matches GNU under a UTF-8 locale;
#        kriya has no locale and decodes unconditionally, as `wc -m` does.
#   -f LIST / --fields=LIST   extract delimited fields.
#
# Other flags:
#   -d DELIM / --delimiter=DELIM   single-byte field delimiter (default TAB).
#   -s / --only-delimited          (with -f) skip lines that have no
#                                   delimiter; default copies them
#                                   through unchanged.
#   --complement                    invert the LIST selection.
#   --output-delimiter=STR         string to join output fields (default
#                                   is the same delimiter as input).
#   -z / --zero-terminated         line terminator is NUL instead of \n.
#
# LIST grammar (comma-separated ranges, 1-indexed, inclusive both ends):
#   N        single position N.
#   N-       position N through end-of-line.
#   -M       position 1 through M.
#   N-M      range N through M.
#
# Stdin reads when no file operand or operand is `-`. Multiple files
# concatenate (no header) — matches GNU.
#
# Deferred: `-c` distinct from `-b` for multi-byte input; LIST shorthand
# like `1,2,3,5-8` is fully supported, but locale-dependent collation
# is not.

var _cut_spec = 0;
var _cut_b_idx = 0;
var _cut_c_idx = 0;
var _cut_f_idx = 0;
var _cut_d_idx = 0;
var _cut_s_idx = 0;
var _cut_cmpl_idx = 0;
var _cut_od_idx = 0;
var _cut_z_idx = 0;

var _cut_read_buf = 0;
var _CUT_READ_SZ  = 65536;
var _CUT_LINE_SZ  = 65536;

fn _cut_init_spec(): i64 {
    if (_cut_spec != 0) { return 0; }
    var s = flags_new();
    _cut_b_idx    = flags_add_str(s,  98,  "bytes",            0, "byte positions");
    _cut_c_idx    = flags_add_str(s,  99,  "characters",       0, "character (codepoint) positions");
    _cut_f_idx    = flags_add_str(s,  102, "fields",           0, "field positions");
    _cut_d_idx    = flags_add_str(s,  100, "delimiter",        0, "field delimiter (1 byte; default TAB)");
    _cut_s_idx    = flags_add_bool(s, 115, "only-delimited",   0, "skip lines without delimiter (-f)");
    _cut_cmpl_idx = flags_add_bool(s, 0,   "complement",       0, "invert LIST");
    _cut_od_idx   = flags_add_str(s,  0,   "output-delimiter", 0, "join output fields with this string");
    _cut_z_idx    = flags_add_bool(s, 122, "zero-terminated",  0, "NUL-separated lines");
    _cut_spec = s;
    cut_help_declare();
    return 0;
}

# Help/introspection record for `cut`. ⭐ Split out so `kriya --list` can
# populate it WITHOUT running the utility — one declaration feeding `--help`,
# `--help=json` and `--list` alike.
fn cut_help_declare(): i64 {
    help_begin("cut", "Print selected parts of each line.",
               "cut OPTIONS [FILE...]");
    help_positional(0, HELP_POS_UNBOUNDED, "FILE");
    help_operands("Exactly one of -b, -c or -f selects what LIST means. ⚠ -c counts CHARACTERS (codepoints) and -b counts BYTES — `cut -c2` on `aébc` yields the whole two-byte é, `cut -b2` its lead byte. An invalid byte counts as one character and passes through unchanged.");  #  #skip-lint
    help_exit(1, "a file could not be read");
    help_example("cut -d: -f1 /etc/passwd");
    help_example("cut -c 1-10 file");
    help_example("cut -f 2,4 --output-delimiter=' ' tsv");
    return 0;
}

fn _cut_buf_get(): i64 {
    if (_cut_read_buf == 0) { _cut_read_buf = alloc(_CUT_READ_SZ); }
    return _cut_read_buf;
}

# ⭐ ONE LINE NOW. The 24-line body this replaces was byte-identical in every
# utility apart from the name; `errmsg_report` in `src/lib/report.cyr` is the
# single implementation of architecture 001's framing, and it shell-quotes the
# operand so a name containing a newline cannot split the diagnostic in two.
fn _cut_report(operand, errno): i64 { return errmsg_report("cut", operand, errno); }

# --- LIST parsing ---
#
# Ranges are stored as pairs (lo, hi) in a 16-byte-per-entry vec.
# `hi == 0` means "open-ended" (N-).
# `lo == 0` is used with hi != 0 to mean "-M" (1..M); we normalize to
# (1, M) at parse time.
# Position numbers are 1-indexed throughout.

fn _cut_range_new(lo, hi): i64 {
    var r = alloc(16);
    store64(r + 0, lo);
    store64(r + 8, hi);
    return r;
}

fn _cut_range_lo(r): i64 { return load64(r + 0); }
fn _cut_range_hi(r): i64 { return load64(r + 8); }

# Parse a non-negative integer at offset; advance offset_p.
fn _cut_parse_uint(s, slen, off_p): i64 {
    var off = load64(off_p);
    var v: i64 = 0;
    var any: i64 = 0;
    while (off < slen) {
        var c = load8(s + off);
        if (c < 48) { off = slen; }
        else { if (c > 57) { off = slen; }
        else {
            v = v * 10 + (c - 48);
            any = any + 1;
            off = off + 1;
        } }
    }
    # Restore proper offset (we need to find where digits ended).
    off = load64(off_p);
    v = 0;
    any = 0;
    var done: i64 = 0;
    while (done == 0) {
        if (off >= slen) { done = 1; }
        else {
            var c = load8(s + off);
            if (c < 48) { done = 1; }
            else { if (c > 57) { done = 1; }
            else {
                v = v * 10 + (c - 48);
                any = 1;
                off = off + 1;
            } }
        }
    }
    store64(off_p, off);
    if (any == 0) { return 0 - 1; }
    return v;
}

# Parse the LIST string into a vec of range records. Returns vec, or 0
# on parse error.
fn _cut_parse_list(s): i64 {
    var slen = strlen(s);
    var ranges = vec_new();
    var off_box[8];
    store64(&off_box, 0);

    var done: i64 = 0;
    while (done == 0) {
        if (load64(&off_box) >= slen) { done = 1; }
        else {
            var ofx = load64(&off_box);
            var first_byte = load8(s + ofx);
            var lo: i64 = 1;
            var hi: i64 = 0;
            var has_lo: i64 = 0;
            if (first_byte == 45) {  # '-'
                # `-M` form. Skip the '-'.
                store64(&off_box, ofx + 1);
                var v = _cut_parse_uint(s, slen, &off_box);
                if (v < 0) { return 0; }
                lo = 1; hi = v; has_lo = 1;
            } else {
                var v = _cut_parse_uint(s, slen, &off_box);
                if (v < 0) { return 0; }
                lo = v; has_lo = 1;
                # See if a '-' follows.
                if (load64(&off_box) < slen) {
                    if (load8(s + load64(&off_box)) == 45) {
                        store64(&off_box, load64(&off_box) + 1);
                        # Optional upper.
                        if (load64(&off_box) < slen) {
                            if (load8(s + load64(&off_box)) != 44) {
                                var v2 = _cut_parse_uint(s, slen, &off_box);
                                if (v2 < 0) { return 0; }
                                hi = v2;
                            } else {
                                hi = 0;  # N- (open)
                            }
                        } else {
                            hi = 0;  # trailing N-
                        }
                    } else {
                        hi = lo;  # N alone → N-N
                    }
                } else {
                    hi = lo;
                }
            }
            if (has_lo == 0) { return 0; }
            if (lo < 1) { lo = 1; }
            vec_push(ranges, _cut_range_new(lo, hi));
            # Consume ',' if present.
            if (load64(&off_box) < slen) {
                if (load8(s + load64(&off_box)) == 44) {
                    store64(&off_box, load64(&off_box) + 1);
                } else {
                    # Malformed — but we accept the rest of the input.
                    return 0;
                }
            }
        }
    }
    return ranges;
}

# Is position `p` (1-indexed) covered by any range in `ranges`?
fn _cut_range_covers(ranges, p): i64 {
    var n = vec_len(ranges);
    var i: i64 = 0;
    while (i < n) {
        var r = vec_get(ranges, i);
        var lo = _cut_range_lo(r);
        var hi = _cut_range_hi(r);
        if (p >= lo) {
            if (hi == 0) { return 1; }
            if (p <= hi) { return 1; }
        }
        i = i + 1;
    }
    return 0;
}

# --- per-line processors ---

fn _cut_write_all(buf, n): i64 {
    var w = 0;
    while (w < n) {
        var wr = k_write( 1, buf + w, n - w);
        if (wr < 0) {
            if ((0 - wr) == 4) {
                # EINTR retry.
            } else { return wr; }
        } else { w = w + wr; }
    }
    return 0;
}

fn _cut_emit_byte(b): i64 {
    var tb[2];
    store8(&tb, b);
    k_write( 1, &tb, 1);
    return 0;
}

# Character mode (-c): positions count CODEPOINTS, not bytes.
#
# ⛔ `-b` and `-c` used to share one emitter, so `-c` was byte-based and
# `cut -c2` on `aébc` returned the FIRST BYTE of é — a broken UTF-8 sequence,
# not a character. Verified against GNU under LC_ALL=C.UTF-8: `-c2` yields the
# whole two-byte é while `-b2` yields the lead byte, and that is the difference
# the two flags exist to express.
#
# ⚠ CODEPOINTS, NOT GRAPHEME CLUSTERS — measured, not assumed. For `a` + `e` +
# U+0301 + `b`, GNU puts the combining acute at position 3 in its own right, so
# `cut -c3` emits the combining mark alone. Counting grapheme clusters would
# put `b` there instead.
#
# ⚠ An INVALID byte counts as one character and is passed through UNCHANGED.
# GNU does this (`cut -c2` on `a\xFFbc` emits the raw 0xFF), and the stdlib
# decoder agrees by consuming one byte on a bad sequence. ⛔ The original bytes
# are emitted, never the decoder's U+FFFD substitute — `cut` selects text, it
# does not repair it.
# Decode one character, REJECTING sequences that are structurally well-formed
# but not valid UTF-8. Returns bytes consumed; a rejected sequence consumes 1.
#
# ⛔ `_uc_decode_utf8` VALIDATES CONTINUATION-BYTE SHAPE ONLY. It never range-
# checks the codepoint it produces, so it accepts three families GNU rejects:
#   * OVERLONG forms — `C0 80` (a two-byte NUL), `E0 80 xx`, `F0 80 xx xx`
#   * UTF-16 SURROGATES — `ED A0 80` decodes to U+D800
#   * OUT OF RANGE — `F4 90 80 80` decodes above U+10FFFF
# Measured against GNU: `cut -c2` on `x\xC0\x80y` emits `c0` there and `c0 80`
# here, because kriya counted the pair as ONE character. A differential fuzz put
# it at 24 divergences in 4123 comparisons — every one malformed, none on valid
# UTF-8.
#
# ⚠ The fix lives HERE, not in the stdlib: `lib/unicode/_decode.cyr` is upstream
# Cyrius. Its contract ("skip the bad byte") is honoured by treating a rejected
# sequence as one byte, which is exactly what GNU's mbrtowc does.
fn _cut_decode_char(line, off, len, cp_out): i64 {
    var n = _uc_decode_utf8(line, off, len, cp_out);
    if (n < 1) { return 1; }
    if (n == 1) { return 1; }
    var cp = load64(cp_out);
    # Shortest-form check: a sequence of length n must encode at least this.
    var min: i64 = 0;
    if (n == 2) { min = 128; }
    elif (n == 3) { min = 2048; }
    else { min = 65536; }
    if (cp < min) {
        store64(cp_out, load8(line + off));
        return 1;
    }
    # UTF-16 surrogate half — never valid in UTF-8.
    if (cp >= 55296) {
        if (cp <= 57343) {
            store64(cp_out, load8(line + off));
            return 1;
        }
    }
    if (cp > 1114111) {
        store64(cp_out, load8(line + off));
        return 1;
    }
    return n;
}

fn _cut_emit_chars(line, len, ranges, complement, term_byte): i64 {
    var i: i64 = 0;
    var pos: i64 = 0;
    var cp[8];
    while (i < len) {
        var n = _cut_decode_char(line, i, len, &cp);
        pos = pos + 1;
        var covered = _cut_range_covers(ranges, pos);
        var emit: i64 = covered;
        if (complement == 1) { emit = 1 - covered; }
        if (emit == 1) { k_write( 1, line + i, n); }
        i = i + n;
    }
    var tb[2];
    store8(&tb, term_byte);
    k_write( 1, &tb, 1);
    return 0;
}

# Bytes/chars mode: emit selected positions from `line[0..len)`.
fn _cut_emit_bytes(line, len, ranges, complement, term_byte): i64 {
    var i: i64 = 0;
    while (i < len) {
        var pos = i + 1;
        var covered = _cut_range_covers(ranges, pos);
        var emit: i64 = covered;
        if (complement == 1) { emit = 1 - covered; }
        if (emit == 1) { _cut_emit_byte(load8(line + i)); }
        i = i + 1;
    }
    var tb[2];
    store8(&tb, term_byte);
    k_write( 1, &tb, 1);
    return 0;
}

# Fields mode: split `line` by `delim` (one byte). Emit selected
# fields joined by `out_delim`. If `only_delim` is 1 and the line has
# no delim, skip the line entirely; otherwise pass it through.
fn _cut_emit_fields(line, len, ranges, complement, delim, out_delim, out_delim_len, only_delim, term_byte): i64 {
    # Check for delimiter presence.
    var has_delim: i64 = 0;
    var i: i64 = 0;
    while (i < len) {
        if (load8(line + i) == delim) { has_delim = 1; i = len; }
        else { i = i + 1; }
    }

    if (has_delim == 0) {
        if (only_delim == 1) { return 0; }
        # Pass through unchanged.
        if (len > 0) { k_write( 1, line, len); }
        var tb[2];
        store8(&tb, term_byte);
        k_write( 1, &tb, 1);
        return 0;
    }

    # Walk fields: each maximal run between delimiters is one field.
    # 1-indexed.
    var field_no: i64 = 1;
    var field_start: i64 = 0;
    var first_emit: i64 = 1;
    var p: i64 = 0;
    while (p <= len) {
        var at_end: i64 = 0;
        if (p == len) { at_end = 1; }
        else { if (load8(line + p) == delim) { at_end = 1; } }
        if (at_end == 1) {
            # Field is line[field_start..p).
            var covered = _cut_range_covers(ranges, field_no);
            var emit: i64 = covered;
            if (complement == 1) { emit = 1 - covered; }
            if (emit == 1) {
                if (first_emit == 0) {
                    k_write( 1, out_delim, out_delim_len);
                }
                if (p > field_start) {
                    k_write( 1, line + field_start, p - field_start);
                }
                first_emit = 0;
            }
            field_no = field_no + 1;
            field_start = p + 1;
        }
        p = p + 1;
    }
    var tb[2];
    store8(&tb, term_byte);
    k_write( 1, &tb, 1);
    return 0;
}

# Stream `in_fd`, accumulate lines, process each.
fn _cut_run(in_fd, mode, ranges, complement, delim, out_delim, out_delim_len, only_delim, term_byte): i64 {
    var read_buf = _cut_buf_get();
    var line_buf = alloc(_CUT_LINE_SZ);
    var line_len: i64 = 0;
    var truncated_warned: i64 = 0;
    var loop: i64 = 1;
    while (loop == 1) {
        var n = k_read( in_fd, read_buf, _CUT_READ_SZ);
        if (n < 0) {
            if ((0 - n) == 4) {
                # EINTR retry.
            } else { return n; }
        } else {
            if (n == 0) {
                if (line_len > 0) {
                    if (mode == 1) {
                        _cut_emit_fields(line_buf, line_len, ranges, complement, delim, out_delim, out_delim_len,
                                         only_delim, term_byte);
                    } else {
if (mode == 2) {
                            _cut_emit_chars(line_buf, line_len, ranges, complement, term_byte);
                        } else {
                            _cut_emit_bytes(line_buf, line_len, ranges, complement, term_byte);
                        }
                    }
                }
                loop = 0;
            } else {
                var i: i64 = 0;
                while (i < n) {
                    var b = load8(read_buf + i);
                    if (b == term_byte) {
                        if (mode == 1) {
                            _cut_emit_fields(line_buf, line_len, ranges, complement, delim, out_delim, out_delim_len,
                                             only_delim, term_byte);
                        } else {
    if (mode == 2) {
                            _cut_emit_chars(line_buf, line_len, ranges, complement, term_byte);
                        } else {
                            _cut_emit_bytes(line_buf, line_len, ranges, complement, term_byte);
                        }
                        }
                        line_len = 0;
                    } else {
                        if (line_len < _CUT_LINE_SZ - 1) {
                            store8(line_buf + line_len, b);
                            line_len = line_len + 1;
                        } else {
                            if (truncated_warned == 0) {
                                k_write( 2, "kriya cut: warning: line exceeds 64 KiB; truncating\n", 52);
                                truncated_warned = 1;
                            }
                        }
                    }
                    i = i + 1;
                }
            }
        }
    }
    return 0;
}

fn cmd_cut(start: i64): i64 {
    _cut_init_spec();
    if (kriya_args_parse(_cut_spec, start) != 0) {
        k_write( 2, "kriya cut: error: bad option (see ADR 0002 for accepted syntax)\n", 64);
        return EXIT_USAGE;
    }

    var b_arg = flags_get_str(_cut_spec, _cut_b_idx);
    var c_arg = flags_get_str(_cut_spec, _cut_c_idx);
    var f_arg = flags_get_str(_cut_spec, _cut_f_idx);
    var has_b: i64 = 0;
    var has_c: i64 = 0;
    var has_f: i64 = 0;
    if (b_arg != 0) { if (load8(b_arg) != 0) { has_b = 1; } }
    if (c_arg != 0) { if (load8(c_arg) != 0) { has_c = 1; } }
    if (f_arg != 0) { if (load8(f_arg) != 0) { has_f = 1; } }

    var n_modes = has_b + has_c + has_f;
    if (n_modes == 0) {
        k_write( 2, "kriya cut: error: must specify -b, -c, or -f\n", 45);
        return EXIT_USAGE;
    }
    if (n_modes > 1) {
        k_write( 2, "kriya cut: error: only one of -b/-c/-f allowed\n", 47);
        return EXIT_USAGE;
    }

    # mode: 0 = bytes/chars, 1 = fields.
    var mode: i64 = 0;
    var list_arg: i64 = 0;
    if (has_b == 1) { list_arg = b_arg; mode = 0; }
    if (has_c == 1) { list_arg = c_arg; mode = 2; }
    if (has_f == 1) { list_arg = f_arg; mode = 1; }

    var ranges = _cut_parse_list(list_arg);
    if (ranges == 0) {
        k_write( 2, "kriya cut: error: bad LIST syntax\n", 34);
        return EXIT_USAGE;
    }
    if (vec_len(ranges) == 0) {
        k_write( 2, "kriya cut: error: empty LIST\n", 29);
        return EXIT_USAGE;
    }

    var complement: i64 = 0;
    if (flags_get_bool(_cut_spec, _cut_cmpl_idx) == 1) { complement = 1; }
    var only_delim: i64 = 0;
    if (flags_get_bool(_cut_spec, _cut_s_idx) == 1) { only_delim = 1; }
    var zero_term: i64 = 0;
    if (flags_get_bool(_cut_spec, _cut_z_idx) == 1) { zero_term = 1; }
    var term_byte: i64 = 10;
    if (zero_term == 1) { term_byte = 0; }

    # Delimiter (1 byte). Default TAB.
    var delim: i64 = 9;
    var d_arg = flags_get_str(_cut_spec, _cut_d_idx);
    if (d_arg != 0) {
        if (load8(d_arg) != 0) {
            if (load8(d_arg + 1) != 0) {
                k_write( 2, "kriya cut: error: --delimiter must be a single byte\n", 52);
                return EXIT_USAGE;
            }
            delim = load8(d_arg);
        }
    }

    # Output delimiter: default is the input delimiter (or TAB if none).
    var out_delim_buf[2];
    store8(&out_delim_buf, delim);
    var out_delim = &out_delim_buf;
    var out_delim_len: i64 = 1;
    var od_arg = flags_get_str(_cut_spec, _cut_od_idx);
    if (od_arg != 0) {
        if (load8(od_arg) != 0) {
            out_delim = od_arg;
            out_delim_len = strlen(od_arg);
        }
    }

    # -s is only meaningful with -f.
    if (only_delim == 1) {
        if (mode != 1) {
            k_write( 2, "kriya cut: error: -s is only valid with -f\n", 43);
            return EXIT_USAGE;
        }
    }

    var npos = flags_positional_count(_cut_spec);
    var any_failed: i64 = 0;

    if (npos < 1) {
        var r = _cut_run(0, mode, ranges, complement, delim, out_delim, out_delim_len, only_delim, term_byte);
        if (r != 0) { _cut_report("(stdin)", 0 - r); any_failed = 1; }
        if (any_failed == 1) { return EXIT_FAILURE; }
        return EXIT_SUCCESS;
    }

    var i: i64 = 0;
    while (i < npos) {
        var p = flags_positional(_cut_spec, i);
        var fd: i64 = 0;
        var is_stdin: i64 = 0;
        if (load8(p) == 45) {
            if (load8(p + 1) == 0) { is_stdin = 1; }
        }
        if (is_stdin == 0) {
            fd = k_open(p, 0, 0);
            if (fd < 0) {
                _cut_report(p, 0 - fd);
                any_failed = 1;
                i = i + 1;
                continue;
            }
        }
        var r = _cut_run(fd, mode, ranges, complement, delim, out_delim, out_delim_len, only_delim, term_byte);
        if (r != 0) {
            _cut_report(p, 0 - r);
            any_failed = 1;
        }
        if (is_stdin == 0) { k_close( fd); }
        i = i + 1;
    }

    if (any_failed == 1) { return EXIT_FAILURE; }
    return EXIT_SUCCESS;
}
