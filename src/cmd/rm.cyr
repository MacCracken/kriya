# rm — POSIX `rm(1)`: remove files and (with -r/-R) directory trees.
#
# Argument shape:
#   rm [opts] file...
#
# Flags:
#   -f / --force         ignore nonexistent files; never prompt;
#                        suppress most error messages.
#   -i / --interactive   prompt before each removal. Per ADR 0002, on
#                        non-tty stdin this is a usage error (exit 2),
#                        not a hang. -f overrides -i.
#   -r / -R / --recursive  remove directories and their contents.
#   -d / --dir           remove empty directories (POSIX-2017 / GNU).
#   -v / --verbose       print "removed 'path'" / "removed directory 'path'".
#
# Symlink policy (ADR 0003 hard rule #1, no exceptions):
# `rm` NEVER follows symlinks. Every operand is unlinked as a name.
# A symlink-to-directory is unlinked, not descended. A symlink-to-file
# is unlinked, not opened. `-r`/`-R` controls recursion into REAL
# directories only. **There is no flag, env var, or build option to
# follow symlinks**, by design.
#
# Recursive walks use `openat(parent_fd, name, O_NOFOLLOW | O_DIRECTORY)`
# at every descent (ADR 0003 hard rule #4). A directory entry replaced
# by a symlink between the lstat that classified it and the open that
# descends fails ELOOP, no silent follow. Within a directory we use
# `unlinkat(parent_fd, name, 0)` for files and symlinks, and
# `unlinkat(parent_fd, name, AT_REMOVEDIR)` for empty subdirectories
# we've already drained.
#
# Root protection (ADR 0004 hard rule, no escape hatch):
# Every operand is absolute-path-resolved and textually canonicalized
# (no symlink resolution) before any unlink. If any operand matches a
# `protected_paths[]` entry, the ENTIRE invocation refuses with
# exit 2 and a `refusing to operate on '<path>'` message. The table
# ships with `/` only. There is no `--no-preserve-root`, no `--preserve-root`
# (the protection is not a toggle), no env-var bypass. Documented in
# `--help` and reinforced here.
#
# Known weakness (per ADR 0004 § "shell-expanded `/*`"): `rm -rf /*`
# expands at the shell to `/bin /boot /dev …`, none of which match `/`.
# Cross-operand bulk-root defense is deferred to a future architecture
# note. Documented in --help.
#
# Each operand is attempted independently after the protected-path
# pre-check. Exit EXIT_FAILURE if any failed, EXIT_SUCCESS otherwise.

var _rm_spec  = 0;
var _rm_f_idx = 0;
var _rm_i_idx = 0;
var _rm_r_idx = 0;
var _rm_R_idx = 0;
var _rm_d_idx = 0;
var _rm_v_idx = 0;

fn _rm_init_spec(): i64 {
    if (_rm_spec != 0) { return 0; }
    var s = flags_new();
    _rm_f_idx = flags_add_bool(s, 102, "force",       0, "ignore nonexistent; never prompt");
    _rm_i_idx = flags_add_bool(s, 105, "interactive", 0, "prompt before each removal");
    _rm_r_idx = flags_add_bool(s, 114, "recursive",   0, "remove directories recursively");
    _rm_R_idx = flags_add_bool(s, 82,  "",            0, "alias for -r");
    _rm_d_idx = flags_add_bool(s, 100, "dir",         0, "remove empty directories");
    _rm_v_idx = flags_add_bool(s, 118, "verbose",     0, "print each removal");
    _rm_spec = s;
    help_begin("rm", "Remove files and directory trees.",
               "rm [OPTIONS] FILE...");
    help_operands("⚠ rm never follows symlinks and no flag opts in (ADR 0003). It refuses `/` with no escape hatch (ADR 0004), refuses a `.`/`..` final component, and refuses a symlink operand carrying a trailing slash (ADR 0010).");
    help_exit(1, "a removal failed, or an operand was refused");
    help_exit(2, "usage error, or a protected path was named");
    help_example("rm stale.log");
    help_example("rm -r -f build/");
    help_example("rm -i important.conf");
    return 0;
}

fn _rm_report(operand, errno): i64 {
    k_write( 2, "kriya rm: ", 10);
    k_write( 2, operand, strlen(operand));
    k_write( 2, ": ", 2);
    if (errmsg_is_known(errno) == 1) {
        var m = errmsg_for(errno);
        k_write( 2, m, strlen(m));
    } else {
        k_write( 2, "errno ", 6);
        var buf[8];
        var i: i64 = 7;
        store8(&buf + i, 0);
        i = i - 1;
        var v = errno;
        if (v == 0) { store8(&buf + i, 48); i = i - 1; }
        while (v > 0) {
            store8(&buf + i, 48 + (v - (v / 10) * 10));
            v = v / 10;
            i = i - 1;
        }
        k_write( 2, &buf + i + 1, 6 - i);
    }
    k_write( 2, "\n", 1);
    return 0;
}

fn _rm_isatty(fd): i64 {
    # Portable tty probe: k_isatty does the ioctl(TCGETS) on Linux and
    # returns 0 on agnos (no ioctl/termios) — so -i prompting is never
    # interactive on agnos and falls through to the non-tty path.
    if (k_isatty(fd) == 1) { return 1; }
    return 0;
}

# Prompt forms:
#   "kriya rm: remove regular empty file 'path'? "
#   "kriya rm: remove regular file 'path'? "
#   "kriya rm: remove symbolic link 'path'? "
#   "kriya rm: descend into directory 'path'? "
#   "kriya rm: remove directory 'path'? "
fn _rm_prompt(kind, display): i64 {
    k_write( 2, "kriya rm: ", 10);
    k_write( 2, kind, strlen(kind));
    k_write( 2, " '", 2);
    k_write( 2, display, strlen(display));
    k_write( 2, "'? ", 3);
    var c[8];
    var n = k_read( 0, &c, 8);
    if (n < 1) { return 0; }
    var ch = load8(&c);
    if (ch == 121) { return 1; }
    if (ch == 89)  { return 1; }
    return 0;
}

fn _rm_verbose(kind_word, display): i64 {
    k_write( 1, kind_word, strlen(kind_word));
    k_write( 1, " '", 2);
    k_write( 1, display, strlen(display));
    k_write( 1, "'\n", 2);
    return 0;
}

# Recursively remove the directory `name` rooted at `parent_dirfd`.
# Caller has confirmed it is a real directory (not a symlink).
# Returns 0 on success, negative errno on failure. With `force`,
# missing entries are not errors; without, they propagate as -ENOENT.
fn _rm_dir_at(parent_dirfd, name, display, force, interactive, verbose): i64 {
    # Open the directory NOFOLLOW. A symlink swap between the
    # classifying lstat and this open fails ELOOP — no silent follow.
    var dir_fd = fs_opendir_nofollow(parent_dirfd, name);
    if (dir_fd < 0) {
        var derrno = 0 - dir_fd;
        if (force == 1) {
            if (derrno == 2) { return 0; }  # ENOENT under -f is fine
        }
        _rm_report(display, derrno);
        return dir_fd;
    }

    # -i: prompt before descending into the directory's contents.
    # GNU rm's "descend into" prompt only fires before recursion, not
    # before each contained entry; per-entry prompts still happen
    # inside the loop.
    if (interactive == 1) {
        if (_rm_prompt("descend into directory", display) == 0) {
            fs_close(dir_fd);
            return 0;
        }
    }

    var any_failed: i64 = 0;
    var ent_buf = alloc(4096);
    var loop: i64 = 1;
    while (loop == 1) {
        var nb = fs_getdents64(dir_fd, ent_buf, 4096);
        if (nb < 0) {
            if ((0 - nb) == 4) {
                # EINTR — retry.
            } else {
                _rm_report(display, 0 - nb);
                any_failed = 1;
                loop = 0;
            }
        } else {
            if (nb == 0) {
                loop = 0;
            } else {
                var off: i64 = 0;
                while (off < nb) {
                    var ent = ent_buf + off;
                    var reclen = fs_dent_reclen(ent);
                    if (fs_dent_is_dotdot(ent) == 0) {
                        var ename = fs_dent_name(ent);
                        var child_disp = path_join(display, ename);
                        # Classify the entry via lstat (ADR 0003: never follow).
                        var st[144];
                        var sr = fs_lstat_at(dir_fd, ename, &st);
                        if (sr != 0) {
                            if (force == 1) {
                                if ((0 - sr) == 2) {
                                    # Vanished between getdents and lstat; tolerable.
                                } else {
                                    _rm_report(child_disp, 0 - sr);
                                    any_failed = 1;
                                }
                            } else {
                                _rm_report(child_disp, 0 - sr);
                                any_failed = 1;
                            }
                        } else {
                            if (fs_is_dir(&st) == 1) {
                                # Real directory — recurse, then remove.
                                var rr = _rm_dir_at(dir_fd, ename, child_disp, force, interactive, verbose);
                                if (rr != 0) { any_failed = 1; }
                            } else {
                                # File, symlink, or other — unlink the name.
                                # Symlinks are unlinked as names (NEVER followed).
                                if (interactive == 1) {
                                    var prompt_kind = "remove";
                                    if (fs_is_lnk(&st) == 1) { prompt_kind = "remove symbolic link"; }
                                    if (fs_is_reg(&st) == 1) {
                                        if (load64(&st + 48) == 0) {
                                            prompt_kind = "remove regular empty file";
                                        } else {
                                            prompt_kind = "remove regular file";
                                        }
                                    }
                                    if (_rm_prompt(prompt_kind, child_disp) == 0) {
                                        off = off + reclen;
                                        continue;
                                    }
                                }
                                var ur = fs_unlinkat(dir_fd, ename, 0);
                                if (ur != 0) {
                                    if (force == 1) {
                                        if ((0 - ur) != 2) {
                                            _rm_report(child_disp, 0 - ur);
                                            any_failed = 1;
                                        }
                                    } else {
                                        _rm_report(child_disp, 0 - ur);
                                        any_failed = 1;
                                    }
                                } else {
                                    if (verbose == 1) { _rm_verbose("removed", child_disp); }
                                }
                            }
                        }
                    }
                    off = off + reclen;
                }
            }
        }
    }

    fs_close(dir_fd);

    if (any_failed == 1) {
        # Don't try to remove the directory itself — its contents
        # weren't fully drained.
        return 0 - 5;
    }

    # Now remove the (drained) directory. With -i and we already
    # prompted "descend into" above, GNU rm doesn't re-prompt; we
    # match that.
    var rmd = fs_unlinkat(parent_dirfd, name, 512);  # AT_REMOVEDIR
    if (rmd != 0) {
        if (force == 1) {
            if ((0 - rmd) == 2) { return 0; }
        }
        _rm_report(display, 0 - rmd);
        return rmd;
    }
    if (verbose == 1) { _rm_verbose("removed directory", display); }
    return 0;
}

# Top-level per-operand handler.
fn _rm_one(operand, force, interactive, recursive, dir_only, verbose): i64 {
    # lstat the operand (NEVER follow).
    var st[144];
    var sr = fs_lstat_at(0 - 100, operand, &st);  # fstatat AT_SYMLINK_NOFOLLOW
    if (sr != 0) {
        if (force == 1) {
            if ((0 - sr) == 2) { return 0; }  # ENOENT under -f
        }
        _rm_report(operand, 0 - sr);
        return sr;
    }

    if (fs_is_dir(&st) == 1) {
        if (recursive == 1) {
            return _rm_dir_at(0 - 100, operand, operand, force, interactive, verbose);
        }
        if (dir_only == 1) {
            # POSIX-2017 / GNU -d: empty dirs only.
            if (interactive == 1) {
                if (_rm_prompt("remove directory", operand) == 0) { return 0; }
            }
            var rmd = k_rmdir(operand);
            if (rmd != 0) {
                if (force == 1) {
                    if ((0 - rmd) == 2) { return 0; }
                }
                _rm_report(operand, 0 - rmd);
                return rmd;
            }
            if (verbose == 1) { _rm_verbose("removed directory", operand); }
            return 0;
        }
        # Directory without -r or -d: error.
        _rm_report(operand, 21);  # EISDIR
        return 0 - 21;
    }

    # File / symlink / special. Unlink the NAME (ADR 0003: never
    # follow). For symlinks specifically, this removes the link and
    # never touches the target.
    if (interactive == 1) {
        var prompt_kind = "remove";
        if (fs_is_lnk(&st) == 1) { prompt_kind = "remove symbolic link"; }
        if (fs_is_reg(&st) == 1) {
            if (load64(&st + 48) == 0) {
                prompt_kind = "remove regular empty file";
            } else {
                prompt_kind = "remove regular file";
            }
        }
        if (_rm_prompt(prompt_kind, operand) == 0) { return 0; }
    }
    var ur = k_unlink(operand);
    if (ur != 0) {
        if (force == 1) {
            if ((0 - ur) == 2) { return 0; }
        }
        _rm_report(operand, 0 - ur);
        return ur;
    }
    if (verbose == 1) { _rm_verbose("removed", operand); }
    return 0;
}

# 1 if `op`'s FINAL path component is "." or ".." — the operand shape POSIX
# requires `rm` to refuse.
#
# ⛔ THIS IS A DATA-LOSS GUARD, NOT A TIDINESS CHECK. Without it `rm -r dir/sub/..`
# resolved to the PARENT and emptied it: measured on a `parent/{keep.txt,sub/}`
# tree, kriya deleted BOTH `keep.txt` and `sub/` and then reported "no such file
# or directory" — an error message for an operation that had already destroyed
# the wrong directory. `rm -r d/.` did the same to `d`'s contents. GNU refuses
# both, and refuses them even under `-f`.
#
# ⚠ The refusal is PER-OPERAND and does not stop the invocation, which is what
# GNU does: other operands still run, and the exit status is 1. That is different
# from the ADR-0004 protected-path check above it, which IS invocation-wide and
# atomic — a distinction worth keeping straight, because they read alike.
#
# Trailing slashes are stripped first: `a/./` names the same directory as `a/.`.
# Only an exact "." or ".." final component counts — `...`, `a..` and `..x` are
# ordinary names and must still be removable.
fn _rm_is_dot_operand(op): i64 {
    if (op == 0) { return 0; }
    var len = strlen(op);
    if (len == 0) { return 0; }

    # Strip trailing '/' down to (but not past) a single leading character, so
    # "/" survives as "/" and is left to the protected-path check.
    var stripping: i64 = 1;
    while (stripping == 1) {
        if (len > 1) {
            if (load8(op + len - 1) == 47) { len = len - 1; }
            else { stripping = 0; }
        } else {
            stripping = 0;
        }
    }

    # Start of the final component.
    var start: i64 = 0;
    var i: i64 = 0;
    while (i < len) {
        if (load8(op + i) == 47) { start = i + 1; }
        i = i + 1;
    }

    var clen = len - start;
    if (clen == 1) {
        if (load8(op + start) == 46) { return 1; }              # "."
        return 0;
    }
    if (clen == 2) {
        if (load8(op + start) == 46) {
            if (load8(op + start + 1) == 46) { return 1; }      # ".."
        }
    }
    return 0;
}

# 1 if `op` carried a trailing slash AND its final component (after stripping
# those slashes) is a symlink — the shape ADR 0010 refuses.
#
# ⛔ `rm -r link/` IS WORSE THAN EITHER FOLLOWING OR REFUSING. A trailing slash is
# POSIX-defined to resolve to the linked-to directory, so the walk descends into
# the target and EMPTIES IT — and then fails to unlink `link` itself, because
# `link/` is not a directory to `unlinkat(AT_REMOVEDIR)`. Measured identical in
# GNU: `real/` loses every file, the symlink survives, exit is non-zero. The
# operation reports failure AFTER destroying the data, so the user sees an error,
# sees the link still there, and reasonably concludes nothing happened.
#
# ⚠ It also contradicts kriya's own floor. ADR 0003 hard rule #1 is that `rm`
# never follows a symlink and no flag opts in; the trailing slash was a
# POSIX-blessed way to follow one, on the utility CLAUDE.md singles out as the
# most dangerous. ADR 0010 closes it.
#
# `rm link` (no slash) is untouched — it unlinks the link, which is both POSIX
# and ADR 0003.
fn _rm_is_slashed_symlink(op): i64 {
    if (op == 0) { return 0; }
    var len = strlen(op);
    if (len < 2) { return 0; }

    # Must have carried at least one trailing slash.
    if (load8(op + len - 1) != 47) { return 0; }

    # Strip them; "/" itself is left to the ADR-0004 protected check.
    var stripping: i64 = 1;
    while (stripping == 1) {
        if (len > 1) {
            if (load8(op + len - 1) == 47) { len = len - 1; }
            else { stripping = 0; }
        } else {
            stripping = 0;
        }
    }
    if (len < 1) { return 0; }

    # Copy the stripped form so lstat sees the name without the slash — with the
    # slash, lstat resolves the target and reports a directory, which is exactly
    # the confusion this guard exists to remove.
    var bare = alloc(len + 1);
    memcpy(bare, op, len);
    store8(bare + len, 0);

    var st[144];
    if (fs_lstat_at(0 - 100, bare, &st) != 0) { return 0; }
    return fs_is_lnk(&st);
}

fn cmd_rm(start: i64): i64 {
    _rm_init_spec();
    if (kriya_args_parse(_rm_spec, start) != 0) {
        k_write( 2, "kriya rm: error: bad option (see ADR 0002 for accepted syntax)\n", 63);
        return EXIT_USAGE;
    }

    var npos = flags_positional_count(_rm_spec);
    var force: i64 = 0;
    if (flags_get_bool(_rm_spec, _rm_f_idx) == 1) { force = 1; }
    var interactive: i64 = 0;
    if (flags_get_bool(_rm_spec, _rm_i_idx) == 1) { interactive = 1; }
    var recursive: i64 = 0;
    if (flags_get_bool(_rm_spec, _rm_r_idx) == 1) { recursive = 1; }
    if (flags_get_bool(_rm_spec, _rm_R_idx) == 1) { recursive = 1; }
    var dir_only: i64 = 0;
    if (flags_get_bool(_rm_spec, _rm_d_idx) == 1) { dir_only = 1; }
    var verbose: i64 = 0;
    if (flags_get_bool(_rm_spec, _rm_v_idx) == 1) { verbose = 1; }

    # POSIX: -f beats -i.
    if (force == 1) { interactive = 0; }

    # No operands: POSIX/GNU `rm` with -f and no operands is a no-op
    # exit 0; without -f it's a usage error.
    if (npos < 1) {
        if (force == 1) { return EXIT_SUCCESS; }
        k_write( 2, "kriya rm: error: missing operand\n", 33);
        return EXIT_USAGE;
    }

    # ADR 0002 hard rule #4: -i + non-tty stdin = invocation-wide
    # usage error.
    if (interactive == 1) {
        if (_rm_isatty(0) == 0) {
            k_write( 2, "kriya rm: error: -i requires stdin to be a terminal\n", 53);
            return EXIT_USAGE;
        }
    }

    # ADR 0004 hard rule: pre-canonicalize every operand and refuse
    # the WHOLE invocation if any matches a protected path. Per ADR
    # 0004 the multi-operand case is atomic: if `rm foo /bar /`
    # comes in, none of foo/bar are touched.
    var i: i64 = 0;
    while (i < npos) {
        var op = flags_positional(_rm_spec, i);
        if (is_protected_path(op) == 1) {
            k_write( 2, "kriya rm: refusing to operate on '", 34);
            k_write( 2, op, strlen(op));
            k_write( 2, "'\n", 2);
            return EXIT_USAGE;
        }
        i = i + 1;
    }

    var any_failed: i64 = 0;
    i = 0;
    while (i < npos) {
        var op = flags_positional(_rm_spec, i);
        # POSIX: refuse a "." or ".." final component. Per-operand skip, not an
        # invocation-wide refusal — see `_rm_is_dot_operand`. `-f` does NOT
        # override this, matching GNU.
        if (_rm_is_dot_operand(op) == 1) {
            k_write( 2, "kriya rm: refusing to remove '.' or '..' directory: skipping '", 62);
            k_write( 2, op, strlen(op));
            k_write( 2, "'\n", 2);
            any_failed = 1;
        } elif (_rm_is_slashed_symlink(op) == 1) {
            # ADR 0010. The message names BOTH intents, because the whole problem
            # is that one trailing slash silently chooses between them.
            k_write( 2, "kriya rm: '", 11);
            k_write( 2, op, strlen(op));
            k_write( 2, "' is a symlink with a trailing slash: refusing (ADR 0010)\n", 58);
            k_write( 2, "kriya rm: use 'rm ", 18);
            var blen = strlen(op);
            while (blen > 1) {
                if (load8(op + blen - 1) == 47) { blen = blen - 1; }
                else { blen = 0 - blen; }
            }
            if (blen < 0) { blen = 0 - blen; }
            k_write( 2, op, blen);
            k_write( 2, "' to remove the link, or name the target directly\n", 50);
            any_failed = 1;
        } else {
            var r = _rm_one(op, force, interactive, recursive, dir_only, verbose);
            if (r != 0) { any_failed = 1; }
        }
        i = i + 1;
    }

    if (any_failed == 1) { return EXIT_FAILURE; }
    return EXIT_SUCCESS;
}
