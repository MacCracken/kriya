# nl — POSIX `nl(1)`: number lines of input.
#
# Argument shape:
#   nl [opts] [file]
#
# Flags:
#   -b TYPE   body numbering (default `t`).
#   -h TYPE   header numbering (default `n`).
#   -f TYPE   footer numbering (default `n`).
#             TYPE is `a` number all, `t` number non-empty only,
#             `n` number none, or `pBRE` number lines matching a BRE.
#   -d DELIM  section delimiter (default `\:`).
#   -i N      number increment (default 1).
#   -l N      with TYPE `a` only: count N consecutive empty lines as one.
#   -n FMT    number format: `ln` left-justified, `rn` right-justified
#             unpadded (default), `rz` right-justified zero-padded.
#   -p        do not reset numbering at section boundaries.
#   -s SEP    separator between number and line (default TAB).
#   -v N      starting line number (default 1).
#   -w N      number column width (default 6).
#
# Sections. A line whose ENTIRE content is the delimiter repeated three
# times is a header marker, twice a body marker, once a footer marker;
# input before the first marker is a BODY section. ⚠ Whole line, not
# prefix: `\:\:\:\:` and ` \:\:\:` are ordinary text, and a run of six is
# NOT header-plus-footer. A marker line is replaced on output by a BARE
# newline — no number, no separator, no padding, whatever `-w` and `-s`
# say. The counter resets to `-v` at every marker unless `-p` is given.
#
# ⛔ `-d ''` disables section matching, which is what GNU DOCUMENTS and
# what coreutils 9.4 does. Do not test that flag against a local GNU:
# 9.11's multi-byte rewrite of `check_section` regressed it into making
# every EMPTY input line a header marker, so the oracle disagrees with
# its own `--help` and with itself across versions.
#
# ⛔ `-b pBRE` is POSIX BRE, NOT the Emacs dialect `find -regex` takes —
# GNU nl dropped Emacs syntax in coreutils 6.6. So a bare `+` here is a
# LITERAL plus and `\+` is one-or-more, the exact opposite of find. The
# warning block in `src/cmd/find.cyr` must not be copied here.
#
# ⚠ GNU's dialect is BRE *plus* the GNU operators (`\+` `\?` `\|` `\b`
# `\w` `\s` …), and niyama implements only the POSIX core. Its failure
# mode for the GNU operators is SILENT — `a\+b` compiles clean and then
# matches nothing, i.e. the WRONG lines get numbered. Those operators are
# therefore refused at parse time; see `_nl_rx_unsupported`. Lifting the
# refusal is a one-line change once niyama grows them (roadmap M11).
#
# Symlink policy / root protection: informational utility; neither
# ADR 0003 nor ADR 0004 applies. Default open follows symlinks.
#
# Streaming: lines are accumulated into a 64 KiB buffer; lines longer
# than that are truncated with a stderr warning. (POSIX nl has no
# defined limit, but 64 KiB covers anything sane; bump if a consumer
# hits it.)

# Numbering styles, shared by -h / -b / -f.
enum NlStyle {
    NL_STYLE_ALL   = 0;   # a — number every line
    NL_STYLE_TEXT  = 1;   # t — number non-empty lines
    NL_STYLE_NONE  = 2;   # n — number nothing (but still pad)
    NL_STYLE_REGEX = 3;   # pBRE — number lines matching
}

enum NlSection {
    NL_SEC_HEADER = 0;
    NL_SEC_BODY   = 1;
    NL_SEC_FOOTER = 2;
}

# ⭐ One state block instead of a 15-argument emitter. Every field is a
# slot; `-h`/`-b`/`-f` are three parallel style+regex pairs indexed by
# the CURRENT section, which is what makes the per-section reset and the
# three independent regexes fall out for free.
enum NlState {
    NL_S_STYLE_H   = 0;
    NL_S_STYLE_B   = 8;
    NL_S_STYLE_F   = 16;
    NL_S_RX_H      = 24;
    NL_S_RX_B      = 32;
    NL_S_RX_F      = 40;
    NL_S_COUNTER   = 48;
    NL_S_INCREMENT = 56;
    NL_S_FMT       = 64;
    NL_S_WIDTH     = 72;
    NL_S_SEP       = 80;
    NL_S_SEP_LEN   = 88;
    NL_S_START     = 96;    # -v: the value each section resets TO
    NL_S_SECTION   = 104;
    NL_S_RENUMBER  = 112;   # 1 = reset per section (default); 0 = -p
    NL_S_JOIN      = 120;   # -l N
    NL_S_BLANKRUN  = 128;
    NL_S_DELIM     = 136;
    NL_S_DELIM_LEN = 144;   # 0 = section matching disabled (-d '')
    NL_STATE_SIZE  = 152;
}

var _nl_spec   = 0;
var _nl_b_idx  = 0;
var _nl_d_idx  = 0;
var _nl_f_idx  = 0;
var _nl_h_idx  = 0;
var _nl_i_idx  = 0;
var _nl_l_idx  = 0;
var _nl_n_idx  = 0;
var _nl_p_idx  = 0;
var _nl_s_idx  = 0;
var _nl_v_idx  = 0;
var _nl_w_idx  = 0;

var _nl_read_buf = 0;
var _NL_READ_SZ  = 65536;

var _nl_line_buf = 0;
var _NL_LINE_SZ  = 65536;

fn _nl_init_spec(): i64 {
    if (_nl_spec != 0) { return 0; }
    var s = flags_new();
    _nl_b_idx = flags_add_str(s, 98,  "body-numbering",   0, "a|t|n|pBRE (default t)");
    _nl_d_idx = flags_add_str(s, 100, "section-delimiter", 0, "section delimiter (default \\:)");
    _nl_f_idx = flags_add_str(s, 102, "footer-numbering", 0, "a|t|n|pBRE (default n)");
    _nl_h_idx = flags_add_str(s, 104, "header-numbering", 0, "a|t|n|pBRE (default n)");
    _nl_i_idx = flags_add_str(s, 105, "line-increment",   0, "increment (default 1)");
    _nl_l_idx = flags_add_str(s, 108, "join-blank-lines", 0, "with -ba, count N blanks as one");
    _nl_n_idx = flags_add_str(s, 110, "number-format",    0, "ln|rn|rz (default rn)");
    _nl_p_idx = flags_add_bool(s, 112, "no-renumber",     0, "do not reset numbering per section");
    _nl_s_idx = flags_add_str(s, 115, "number-separator", 0, "separator (default TAB)");
    _nl_v_idx = flags_add_str(s, 118, "starting-line-number", 0, "first line number (default 1)");
    _nl_w_idx = flags_add_str(s, 119, "number-width",     0, "column width (default 6)");
    _nl_spec = s;
    nl_help_declare();
    return 0;
}

# Help/introspection record for `nl`. ⭐ Split out so `kriya --list` can
# populate it WITHOUT running the utility — one declaration feeding `--help`,
# `--help=json` and `--list` alike.
fn nl_help_declare(): i64 {
    help_begin("nl", "Number lines of files.",
               "nl [OPTIONS] [FILE...]");
    help_positional(0, HELP_POS_UNBOUNDED, "FILE");
    help_exit(1, "a file could not be read");
    help_example("nl notes.txt");
    help_example("nl -b a -w 4 file");
    help_example("nl -h a -f a -d '@:' sectioned.txt");
    return 0;
}

fn _nl_buf_get(): i64 {
    if (_nl_read_buf == 0) { _nl_read_buf = alloc(_NL_READ_SZ); }
    return _nl_read_buf;
}

fn _nl_line_get(): i64 {
    if (_nl_line_buf == 0) { _nl_line_buf = alloc(_NL_LINE_SZ); }
    return _nl_line_buf;
}

# ⭐ ONE LINE NOW. The 24-line body this replaces was byte-identical in every
# utility apart from the name; `errmsg_report` in `src/lib/report.cyr` is the
# single implementation of architecture 001's framing, and it shell-quotes the
# operand so a name containing a newline cannot split the diagnostic in two.
fn _nl_report(operand, errno): i64 { return errmsg_report("nl", operand, errno); }

# Render `v` as decimal into `buf`. Returns byte count.
fn _nl_render_dec(v, buf): i64 {
    if (v == 0) { store8(buf, 48); return 1; }
    var tmp[32];
    var n: i64 = 0;
    var rem = v;
    while (rem > 0) {
        store8(&tmp + n, 48 + (rem - (rem / 10) * 10));
        rem = rem / 10;
        n = n + 1;
    }
    var i: i64 = 0;
    while (i < n) {
        store8(buf + i, load8(&tmp + n - 1 - i));
        i = i + 1;
    }
    return n;
}

# fmt encoded as small int: 0 = rn, 1 = ln, 2 = rz.
fn _nl_emit_number(num, fmt, width): i64 {
    var buf[32];
    var n = _nl_render_dec(num, &buf);
    if (n >= width) {
        # Number is at least as wide as the column — print bare digits.
        k_write( 1, &buf, n);
        return 0;
    }
    var pad = width - n;
    var pad_buf[1];
    if (fmt == 1) {
        # Left-justified: digits then spaces.
        k_write( 1, &buf, n);
        store8(&pad_buf, 32);
        var i: i64 = 0;
        while (i < pad) { k_write( 1, &pad_buf, 1); i = i + 1; }
    } else {
        # Right-justified. fmt 0 (rn) pads with space; fmt 2 (rz) with '0'.
        var pad_char: i64 = 32;
        if (fmt == 2) { pad_char = 48; }
        store8(&pad_buf, pad_char);
        var i: i64 = 0;
        while (i < pad) { k_write( 1, &pad_buf, 1); i = i + 1; }
        k_write( 1, &buf, n);
    }
    return 0;
}

# Emit `width` spaces (used for unnumbered lines).
fn _nl_emit_blank_column(width): i64 {
    var sp[2];
    store8(&sp, 32);
    var i: i64 = 0;
    while (i < width) {
        k_write( 1, &sp, 1);
        i = i + 1;
    }
    return 0;
}

# Process one line. `body_type`: 0=all, 1=non-empty, 2=none.
# `*counter_p` is a single-slot i64 cell at `counter_p` so the caller
# sees increment side-effects.
# --- sections ---

# Does `line` consist of exactly `reps` copies of the delimiter?
fn _nl_is_rep(d, dl, line, reps): i64 {
    var total = dl * reps;
    var i: i64 = 0;
    var ok: i64 = 1;
    var scanning: i64 = 1;
    while (scanning == 1) {
        if (i >= total) { scanning = 0; continue; }
        if (load8(line + i) != load8(d + (i % dl))) { ok = 0; scanning = 0; continue; }
        i = i + 1;
    }
    return ok;
}

# Classify a line as a section marker. Returns NL_SEC_* or (0 - 1) for
# ordinary text. ⚠ The length test is EQUALITY, so a delimiter run that is
# too long is text rather than a marker plus a remainder.
fn _nl_classify(st, line, len): i64 {
    var dl = load64(st + NL_S_DELIM_LEN);
    if (dl == 0) { return 0 - 1; }
    var d = load64(st + NL_S_DELIM);
    var reps: i64 = 3;
    var found: i64 = 0 - 1;
    var scanning: i64 = 1;
    while (scanning == 1) {
        if (reps < 1) { scanning = 0; continue; }
        if (len == dl * reps) {
            if (_nl_is_rep(d, dl, line, reps) == 1) {
                found = 3 - reps;
                scanning = 0;
                continue;
            }
        }
        reps = reps - 1;
    }
    return found;
}

# Enter a new section: reset the counter unless -p, then emit the marker
# line as a BARE newline.
fn _nl_begin_section(st, sec): i64 {
    store64(st + NL_S_SECTION, sec);
    if (load64(st + NL_S_RENUMBER) == 1) {
        store64(st + NL_S_COUNTER, load64(st + NL_S_START));
    }
    k_write( 1, "\n", 1);
    return 0;
}

# --- numbering decision ---

# Should this line carry a number? Consults the style for the CURRENT
# section, and is the only place `-l` is honoured — GNU checks the blank
# run inside `case 'a'` alone, so styles t / n / p ignore it entirely.
fn _nl_should_number(st, line, len): i64 {
    var sec = load64(st + NL_S_SECTION);
    var style = load64(st + NL_S_STYLE_B);
    var rx = load64(st + NL_S_RX_B);
    if (sec == NL_SEC_HEADER) {
        style = load64(st + NL_S_STYLE_H);
        rx = load64(st + NL_S_RX_H);
    }
    if (sec == NL_SEC_FOOTER) {
        style = load64(st + NL_S_STYLE_F);
        rx = load64(st + NL_S_RX_F);
    }

    if (style == NL_STYLE_NONE) { return 0; }
    if (style == NL_STYLE_TEXT) {
        if (len > 0) { return 1; }
        return 0;
    }
    if (style == NL_STYLE_REGEX) {
        # An empty BRE matches every line, empty ones included.
        if (rx == 0) { return 1; }
        if (niyama_bre_search_at(rx, line, len, 0) >= 0) { return 1; }
        return 0;
    }

    # NL_STYLE_ALL.
    if (len > 0) {
        store64(st + NL_S_BLANKRUN, 0);
        return 1;
    }
    var run = load64(st + NL_S_BLANKRUN) + 1;
    if (run >= load64(st + NL_S_JOIN)) {
        store64(st + NL_S_BLANKRUN, 0);
        return 1;
    }
    store64(st + NL_S_BLANKRUN, run);
    return 0;
}

fn _nl_emit_line(st, line, len): i64 {
    var width = load64(st + NL_S_WIDTH);
    var sep = load64(st + NL_S_SEP);
    var sep_len = load64(st + NL_S_SEP_LEN);
    if (_nl_should_number(st, line, len) == 1) {
        var c = load64(st + NL_S_COUNTER);
        _nl_emit_number(c, load64(st + NL_S_FMT), width);
        store64(st + NL_S_COUNTER, c + load64(st + NL_S_INCREMENT));
        k_write( 1, sep, sep_len);
    } else {
        # Unnumbered: GNU emits `width + sep_len` spaces of padding so the
        # unnumbered-line content column-aligns with the numbered-line
        # content column. ⚠ Spaces, never the separator itself.
        _nl_emit_blank_column(width + sep_len);
    }
    if (len > 0) { k_write( 1, line, len); }
    k_write( 1, "\n", 1);
    return 0;
}

fn _nl_feed(st, line, len): i64 {
    var sec = _nl_classify(st, line, len);
    if (sec >= 0) { return _nl_begin_section(st, sec); }
    return _nl_emit_line(st, line, len);
}

fn _nl_run(fd, st): i64 {
    var read_buf = _nl_buf_get();
    var line_buf = _nl_line_get();
    var line_len: i64 = 0;
    var truncated_warned: i64 = 0;
    var loop: i64 = 1;
    while (loop == 1) {
        var n = k_read( fd, read_buf, _NL_READ_SZ);
        if (n < 0) {
            if ((0 - n) == 4) {
                # EINTR — retry.
            } else { return n; }
        } else {
            if (n == 0) {
                # Flush a trailing partial line if any (file without
                # final newline).
                if (line_len > 0) { _nl_feed(st, line_buf, line_len); }
                loop = 0;
            } else {
                var i: i64 = 0;
                while (i < n) {
                    var b = load8(read_buf + i);
                    if (b == 10) {
                        _nl_feed(st, line_buf, line_len);
                        line_len = 0;
                    } else {
                        if (line_len < _NL_LINE_SZ - 1) {
                            store8(line_buf + line_len, b);
                            line_len = line_len + 1;
                        } else {
                            if (truncated_warned == 0) {
                                k_write( 2, "kriya nl: warning: line exceeds 64 KiB; truncating\n", 51);
                                truncated_warned = 1;
                            }
                        }
                    }
                    i = i + 1;
                }
            }
        }
    }
    return 0;
}

# --- option parsing ---

# Which GNU-only regex operator does this pattern use, if any? Returns the
# operator letter, or 0.
#
# ⛔ This exists because niyama fails these SILENTLY. `kriya grep -c 'a\+b'`
# returns 0 where GNU returns 3 — not an error, a wrong answer. For `nl`
# that would mean numbering the wrong lines, so they are refused up front.
# `\<` and `\>` are deliberately absent: niyama does implement those.
#
# ⚠ Bracket expressions are skipped, because `\` inside one is a literal
# backslash in BRE and `[\+]` must not be mistaken for the operator.
fn _nl_rx_unsupported(pat): i64 {
    var n = strlen(pat);
    var i: i64 = 0;
    var bad: i64 = 0;
    var scanning: i64 = 1;
    while (scanning == 1) {
        if (i >= n) { scanning = 0; continue; }
        var c0 = load8(pat + i);
        if (c0 == 91) {
            # Bracket expression: skip a leading `^`, then a leading `]`
            # (which is a literal there), then run to the closing `]`.
            i = i + 1;
            if (load8(pat + i) == 94) { i = i + 1; }
            if (load8(pat + i) == 93) { i = i + 1; }
            var inb: i64 = 1;
            while (inb == 1) {
                if (i >= n) { inb = 0; continue; }
                if (load8(pat + i) == 93) { inb = 0; }
                i = i + 1;
            }
            continue;
        }
        if (c0 != 92) { i = i + 1; continue; }
        if (i + 1 >= n) { scanning = 0; continue; }
        var c = load8(pat + i + 1);
        if (c == 43)  { bad = c; scanning = 0; continue; }   # \+
        if (c == 63)  { bad = c; scanning = 0; continue; }   # \?
        if (c == 124) { bad = c; scanning = 0; continue; }   # \|
        if (c == 98)  { bad = c; scanning = 0; continue; }   # \b
        if (c == 66)  { bad = c; scanning = 0; continue; }   # \B
        if (c == 119) { bad = c; scanning = 0; continue; }   # \w
        if (c == 87)  { bad = c; scanning = 0; continue; }   # \W
        if (c == 115) { bad = c; scanning = 0; continue; }   # \s
        if (c == 83)  { bad = c; scanning = 0; continue; }   # \S
        i = i + 2;
    }
    return bad;
}

fn _nl_emit_flag(letter): i64 {
    var b[2];
    store8(&b, letter);
    k_write( 2, "kriya nl: error: -", 18);
    k_write( 2, &b, 1);
    return 0;
}

# Parse one -h/-b/-f STYLE into a style code, compiling `pBRE` into the
# slot at `rx_p`. Returns the style, or (0 - 1) after reporting an error.
fn _nl_parse_style(arg, rx_p, letter): i64 {
    if (arg == 0) { return 0 - 2; }
    var c0 = load8(arg);
    if (c0 == 0) { return 0 - 2; }
    if (c0 == 97)  { if (load8(arg + 1) == 0) { return NL_STYLE_ALL; } }
    if (c0 == 116) { if (load8(arg + 1) == 0) { return NL_STYLE_TEXT; } }
    if (c0 == 110) { if (load8(arg + 1) == 0) { return NL_STYLE_NONE; } }
    if (c0 == 112) {
        var pat = arg + 1;
        if (load8(pat) == 0) {
            # `-b p` with no pattern: matches every line.
            store64(rx_p, 0);
            return NL_STYLE_REGEX;
        }
        var op = _nl_rx_unsupported(pat);
        if (op != 0) {
            var ob[2];
            store8(&ob, op);
            _nl_emit_flag(letter);
            k_write( 2, " pBRE: niyama does not implement the GNU operator \\", 51);
            k_write( 2, &ob, 1);
            k_write( 2, "; it would silently match nothing (roadmap M11)\n", 48);
            return 0 - 1;
        }
        var nfa = niyama_bre_compile(pat);
        if (nfa == 0) {
            k_write( 2, "kriya nl: error: bad regex: ", 28);
            k_write( 2, pat, strlen(pat));
            k_write( 2, "\n", 1);
            return 0 - 1;
        }
        store64(rx_p, nfa);
        return NL_STYLE_REGEX;
    }
    _nl_emit_flag(letter);
    k_write( 2, " must be a, t, n, or pBRE\n", 26);
    return 0 - 1;
}

# Resolve one style option into the state block. Returns 0 ok, 1 on error.
fn _nl_apply_style(st, idx, style_off, rx_off, letter): i64 {
    var arg = flags_get_str(_nl_spec, idx);
    var s = _nl_parse_style(arg, st + rx_off, letter);
    if (s == (0 - 2)) { return 0; }
    if (s < 0) { return 1; }
    store64(st + style_off, s);
    return 0;
}

fn cmd_nl(start: i64): i64 {
    _nl_init_spec();
    if (kriya_args_parse(_nl_spec, start) != 0) {
        k_write( 2, "kriya nl: error: bad option (see ADR 0002 for accepted syntax)\n", 63);
        return EXIT_USAGE;
    }

    var st = alloc(NL_STATE_SIZE);
    store64(st + NL_S_STYLE_H, NL_STYLE_NONE);
    store64(st + NL_S_STYLE_B, NL_STYLE_TEXT);
    store64(st + NL_S_STYLE_F, NL_STYLE_NONE);
    store64(st + NL_S_RX_H, 0);
    store64(st + NL_S_RX_B, 0);
    store64(st + NL_S_RX_F, 0);
    store64(st + NL_S_INCREMENT, 1);
    store64(st + NL_S_FMT, 0);
    store64(st + NL_S_WIDTH, 6);
    store64(st + NL_S_SEP, "\t");
    store64(st + NL_S_SEP_LEN, 1);
    store64(st + NL_S_START, 1);
    store64(st + NL_S_SECTION, NL_SEC_BODY);
    store64(st + NL_S_RENUMBER, 1);
    store64(st + NL_S_JOIN, 1);
    store64(st + NL_S_BLANKRUN, 0);
    store64(st + NL_S_DELIM, "\\:");
    store64(st + NL_S_DELIM_LEN, 2);

    if (_nl_apply_style(st, _nl_h_idx, NL_S_STYLE_H, NL_S_RX_H, 104) != 0) { return EXIT_USAGE; }
    if (_nl_apply_style(st, _nl_b_idx, NL_S_STYLE_B, NL_S_RX_B, 98)  != 0) { return EXIT_USAGE; }
    if (_nl_apply_style(st, _nl_f_idx, NL_S_STYLE_F, NL_S_RX_F, 102) != 0) { return EXIT_USAGE; }

    # Section delimiter. ⚠ Three shapes, and the one-character shape is the
    # surprising one: GNU implies `:` as the second character (coreutils
    # 9.0), so `-d '\'` reproduces the default and `-d ':'` means `::`.
    var d_arg = flags_get_str(_nl_spec, _nl_d_idx);
    if (d_arg != 0) {
        var dl = strlen(d_arg);
        if (dl == 0) {
            store64(st + NL_S_DELIM_LEN, 0);
        } elif (dl == 1) {
            var db = alloc(3);
            store8(db, load8(d_arg));
            store8(db + 1, 58);
            store8(db + 2, 0);
            store64(st + NL_S_DELIM, db);
            store64(st + NL_S_DELIM_LEN, 2);
        } else {
            store64(st + NL_S_DELIM, d_arg);
            store64(st + NL_S_DELIM_LEN, dl);
        }
    }

    var i_arg = flags_get_str(_nl_spec, _nl_i_idx);
    if (i_arg != 0) {
        if (load8(i_arg) != 0) {
            var v = kriya_parse_nonneg_int(i_arg);
            if (v < 0) {
                k_write( 2, "kriya nl: error: --line-increment requires a non-negative integer\n", 66);
                return EXIT_USAGE;
            }
            store64(st + NL_S_INCREMENT, v);
        }
    }

    # -l N. ⚠ Zero is refused: it would make the blank run never reach the
    # threshold, silently suppressing every blank line's number.
    var l_arg = flags_get_str(_nl_spec, _nl_l_idx);
    if (l_arg != 0) {
        if (load8(l_arg) != 0) {
            var lv = kriya_parse_nonneg_int(l_arg);
            if (lv < 1) {
                k_write( 2, "kriya nl: error: --join-blank-lines requires a positive integer\n", 64);
                return EXIT_USAGE;
            }
            store64(st + NL_S_JOIN, lv);
        }
    }

    # Format. ln=1, rn=0, rz=2.
    var n_arg = flags_get_str(_nl_spec, _nl_n_idx);
    if (n_arg != 0) {
        if (load8(n_arg) != 0) {
            var c0 = load8(n_arg);
            var c1 = load8(n_arg + 1);
            var c2 = load8(n_arg + 2);
            var fmt: i64 = 0 - 1;
            if (c2 == 0) {
                if (c0 == 108) { if (c1 == 110) { fmt = 1; } }        # ln
                if (c0 == 114) {
                    if (c1 == 110) { fmt = 0; }                       # rn
                    if (c1 == 122) { fmt = 2; }                       # rz
                }
            }
            if (fmt < 0) {
                k_write( 2, "kriya nl: error: --number-format must be ln, rn, or rz\n", 55);
                return EXIT_USAGE;
            }
            store64(st + NL_S_FMT, fmt);
        }
    }

    if (flags_get_bool(_nl_spec, _nl_p_idx) == 1) { store64(st + NL_S_RENUMBER, 0); }

    # Separator. POSIX: any string, empty included.
    var s_arg = flags_get_str(_nl_spec, _nl_s_idx);
    if (s_arg != 0) {
        store64(st + NL_S_SEP, s_arg);
        store64(st + NL_S_SEP_LEN, strlen(s_arg));
    }

    var v_arg = flags_get_str(_nl_spec, _nl_v_idx);
    if (v_arg != 0) {
        if (load8(v_arg) != 0) {
            var v = kriya_parse_nonneg_int(v_arg);
            if (v < 0) {
                k_write( 2, "kriya nl: error: --starting-line-number requires a non-negative integer\n", 72);
                return EXIT_USAGE;
            }
            store64(st + NL_S_START, v);
        }
    }

    var w_arg = flags_get_str(_nl_spec, _nl_w_idx);
    if (w_arg != 0) {
        if (load8(w_arg) != 0) {
            var v = kriya_parse_nonneg_int(w_arg);
            if (v < 1) {
                k_write( 2, "kriya nl: error: --number-width requires a positive integer\n", 60);
                return EXIT_USAGE;
            }
            store64(st + NL_S_WIDTH, v);
        }
    }

    store64(st + NL_S_COUNTER, load64(st + NL_S_START));

    var npos = flags_positional_count(_nl_spec);
    var any_failed: i64 = 0;

    if (npos < 1) {
        var r = _nl_run(0, st);
        if (r != 0) { _nl_report("(stdin)", 0 - r); any_failed = 1; }
        if (any_failed == 1) { return EXIT_FAILURE; }
        return EXIT_SUCCESS;
    }

    # Multi-file: GNU nl treats them as one continuous input — the counter
    # does not reset at a file boundary and section state carries across.
    var i: i64 = 0;
    while (i < npos) {
        var p = flags_positional(_nl_spec, i);
        var fd: i64 = 0;
        var is_stdin: i64 = 0;
        if (load8(p) == 45) {
            if (load8(p + 1) == 0) {
                fd = 0;
                is_stdin = 1;
            }
        }
        if (is_stdin == 0) {
            fd = k_open(p, 0, 0);
            if (fd < 0) {
                _nl_report(p, 0 - fd);
                any_failed = 1;
                i = i + 1;
                continue;
            }
        }
        var r = _nl_run(fd, st);
        if (r != 0) {
            _nl_report(p, 0 - r);
            any_failed = 1;
        }
        if (is_stdin == 0) { k_close( fd); }
        i = i + 1;
    }

    if (any_failed == 1) { return EXIT_FAILURE; }
    return EXIT_SUCCESS;
}
