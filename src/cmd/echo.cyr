# echo — POSIX `echo(1)`: print operands separated by spaces, then \n.
#
# kriya recognises a leading `-n` operand as "suppress trailing newline"
# (BSD / GNU / bash convention). Only the literal token `-n` counts;
# `-nn`, `-en`, `--` and friends are data, not flags. This matches GNU
# echo's quirk: option scanning stops at the first non-`-n` operand.
#
# POSIX itself marks the meaning of a leading `-n` as
# implementation-defined; we document this as the kriya choice. `-e`
# / `-E` (escape interpretation) are not implemented yet — they will
# come with an ADR once the C-string escape table lands in `lib/str.cyr`.

# ⭐ The option table, and the parser's only source for it — see the note in
# `src/cmd/date.cyr`. `echo` cannot use `flags_parse`: POSIX echo passes every
# operand through untouched, so a leading `-` after the first operand is DATA,
# not an option, and a general parser would eat it.
var _echo_spec = 0;

fn _echo_init_spec(): i64 {
    if (_echo_spec != 0) { return 0; }
    var s = flags_new();
    flags_add_bool(s, 110, "", 0, "do not output the trailing newline");
    _echo_spec = s;
    return 0;
}

fn cmd_echo(start: i64): i64 {
    _echo_init_spec();
    echo_help_declare();
    help_if_requested(_echo_spec, start);
    var n = kriya_argv_count();
    var i = start;
    var omit_newline: i64 = 0;
    var scanning: i64 = 1;

    while (scanning == 1) {
        var consumed: i64 = 0;
        if (i < n) {
            var tok = argv(i);
            if (load8(tok) == 45) {
                # ⭐ Ask the spec which single letters are options. Still a
                # one-letter-only test: POSIX echo takes no clustered or long
                # options, and `-ne` is an operand, not two flags.
                if (kriya_short_type(_echo_spec, load8(tok + 1)) >= 0) {
                    if (load8(tok + 2) == 0) {
                        omit_newline = 1;
                        i = i + 1;
                        consumed = 1;
                    }
                }
            }
        }
        if (consumed == 0) { scanning = 0; }
    }

    var first = i;
    while (i < n) {
        var arg = argv(i);
        if (i > first) { k_write( 1, " ", 1); }
        k_write( 1, arg, strlen(arg));
        i = i + 1;
    }
    if (omit_newline == 0) { k_write( 1, "\n", 1); }
    return EXIT_SUCCESS;
}

# Help/introspection record for `echo`. ⭐ Split out so `kriya --list` can
# populate it WITHOUT running the utility — one declaration feeding `--help`,
# `--help=json` and `--list` alike.
fn echo_help_declare(): i64 {
    help_begin("echo", "Print arguments separated by spaces.",
               "echo [-n] [STRING...]");
    help_positional(0, HELP_POS_UNBOUNDED, "STRING");
    help_example("echo hello");
    help_example("echo -n no-newline");
    return 0;
}
