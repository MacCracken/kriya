# find — POSIX `find(1)`: walk a file tree, evaluate predicates per entry.
#
# Argument shape:
#   find [STARTPATH...] [EXPRESSION]
#
# Tests (each evaluates true/false per entry). A number N may be written +N (more
# than N) or -N (less than N), as GNU reads it:
#   -name PAT       basename matches fnmatch-style glob (`*`, `?`, `[...]`)
#   -type X         entry is one of {f, d, l, s, p, b, c}
#   -size [+-]N[bcwkMG]  size in units, rounded up (default 512-byte blocks;
#                   c=bytes, w=two-byte words, k=KiB, M=MiB, G=GiB)
#   -mtime [+-]N    last-modified N*24h ago (sign per GNU semantics)
#   -mmin  [+-]N    last-modified N minutes ago
#   -perm MODE      the permission bits are exactly MODE; -perm -MODE: at least
#                   those bits; -perm /MODE: any of them. MODE is octal or
#                   symbolic (`u=rwx,go=rx`), as `chmod` takes it (1.7.1)
#   -uid / -gid [+-]N    the numeric owner or group
#   -user / -group NAME  the owner or group by name, or by number
#   -nouser / -nogroup   no passwd / group entry for the id
#   -empty          regular file size 0 OR directory has no entries
#   -newer REF      mtime newer than REF's (REF followed under -H and -L)
#
# Global options — they apply to the whole walk wherever they are written, and
# evaluate TRUE where they stand (GNU; the last -maxdepth / -mindepth wins):
#   -maxdepth N     descend at most N levels below the starting points
#   -mindepth N     apply the expression only N levels down and below
#   -depth / -d     a directory's entries before the directory (post-order)
#
# Actions (also predicates; default-true unless noted):
#   -print          print the path + newline (default action when none given)
#   -print0         print the path + NUL byte (-print0; pairs with xargs -0)
#   -prune          true; do not descend into this directory. No effect under
#                   -depth (POSIX). Not an action for the implicit -print.
#   -exec CMD... \; fork+exec for each match, `{}` substituted with the path
#   -exec CMD... {} +   one command per BATCH of matches, as many as fit in
#                   131,072 bytes (GNU's accounting, `src/lib/argbatch.cyr`);
#                   always true, a failure is the exit status (1.7.0)
#
# Operators (precedence: ! > -a > -o > ,; juxtaposition is implicit -a):
#   ! EXPR / -not EXPR
#   EXPR1 -a EXPR2 / EXPR1 -and EXPR2
#   EXPR1 -o EXPR2 / EXPR1 -or EXPR2
#   EXPR1 , EXPR2   both, always; the value is EXPR2's (GNU)
#   ( EXPR )        grouping (each paren is its own argv token)
#
# Symlink policy (ADR 0003), last of -H / -L / -P wins:
#   default (-P)    never follow symlinks
#   -H              follow a starting point that is a symlink, nothing below it
#   -L              follow every symlink; a directory reached twice on one path
#                   is a loop, reported, and not entered
#
# Exit codes:
#   0   walk completed; predicates evaluated for every entry
#   1   one or more entries failed to open / stat / exec, an `-exec … +`
#       command failed, or -L found a loop
#   2   usage error (bad expression, unknown predicate)
# ⚠ One deliberate divergence: a `-exec … ;` command that cannot be run or is
# killed makes find exit 1. GNU reports it and exits 0 in that form.
# ⚠ GNU's warnings about `-d` and about a global option written after a test go
# to a TERMINAL only (its `-warn` default follows `isatty(0)`), and kriya prints
# neither. Its warning that `-perm /000` changed meaning in 2007 is about GNU's
# own history — kriya never had the old meaning — and is not printed either.

var _find_spec    = 0;
var _f_L_idx      = 0;
var _f_H_idx      = 0;
var _f_P_idx      = 0;

# Predicate-token kinds.
enum FindNode {
    F_N_AND       = 1,
    F_N_OR        = 2,
    F_N_NOT       = 3,
    F_N_COMMA     = 4,
    F_N_NAME      = 10,
    F_N_TYPE      = 11,
    F_N_SIZE      = 12,
    F_N_MTIME     = 13,
    F_N_MMIN      = 14,
    F_N_EMPTY     = 15,
    F_N_NEWER     = 16,
    F_N_TRUE      = 17,    # a global option where it stands: -depth, -maxdepth, -mindepth
    F_N_PERM      = 18,
    F_N_REGEX     = 19,
    F_N_UID       = 20,
    F_N_GID       = 21,
    F_N_NOUSER    = 22,
    F_N_NOGROUP   = 23,
    F_N_PRINT     = 30,
    F_N_PRINT0    = 31,
    F_N_EXEC      = 32,
    F_N_EXECPLUS  = 33,
    F_N_PRUNE     = 34,
}

enum FindSign {
    F_SIGN_EXACT = 0,
    F_SIGN_PLUS  = 1,
    F_SIGN_MINUS = 2,
}

# `-perm`'s three readings of a mode (GNU's `permissions_type`).
enum FindPerm {
    F_PERM_EXACT = 0,    # MODE:  the permission bits are exactly these
    F_PERM_ALL   = 1,    # -MODE: at least these bits are set
    F_PERM_ANY   = 2,    # /MODE: at least one of them is (GNU's extension)
}

# Parse state — globals for the recursive descent.
var _f_argv_flat = 0;
var _f_argv_n    = 0;
var _f_pos       = 0;
var _f_err       = 0;
var _f_err_msg   = 0;
var _f_now_secs  = 0;
var _f_path_env  = 0;   # cached PATH (heap-copied at startup, stable across exec)

# Walk state.
var _f_any_failed = 0;

# Symlink follow mode: 0=P (default), 1=L (follow everywhere), 2=H (the starting
# points only).
var _f_follow_mode = 0;

# ⛔ THE GLOBAL OPTIONS ARE WALK SETTINGS, NOT TESTS. `-mindepth` used to be a
# test evaluated where it stood, so `find t -print -mindepth 2` printed every
# entry and `find t -mindepth 2 -o -print` printed the shallow ones — both at
# exit 0, where GNU applies the expression only from depth 2 down and prints
# nothing above it. And `-maxdepth` was FIRST-wins where GNU's is last (1.7.1).
# ⚠ `-1` for "no -maxdepth" is set in `cmd_find`: a module-scope `var x = 0 - 1;`
# is an expression initializer and costs a `gvar_toks` slot (CLAUDE.md).
var _f_maxdepth    = 0;
var _f_mindepth    = 0;
var _f_depth_first = 0;    # -depth: post-order
var _f_prune_hit   = 0;    # -prune ran for the entry being evaluated
var _f_walk_path   = 0;    # -L: the directories the walk is inside (`fs_dirstack_*`)
var _f_nostat      = 0;    # the entry being evaluated could not be stat'd (`_f_eval_leaf`)
var _f_nest        = 0;    # parentheses open while parsing
var _f_nest_cap    = 0;    # ...and how many may be: `_f_nest_max`, read once

# ⛔ HOW DEEP `(` MAY NEST. The parser recurses five calls per parenthesis, about
# 1 KiB of stack a level (measured: 2,048 levels overflow a 2 MiB stack, 8,000 fit
# in 8 MiB), and past the stack it died of SIGSEGV where GNU runs it. So the
# limit is half the stack, read from RLIMIT_STACK — 4,096 levels at Linux's usual
# 8 MiB — and deeper is a usage error. Chains of any length are not affected
# (`_f_chain`), and a run of `!` costs a counter (`_f_parse_unary`). ⚠ agnos has
# no rlimits, and its 3,584-byte command line cannot reach 1,024 levels.
fn _f_nest_max(): i64 {
    var sl = ab_stack_limit();
    if (sl == 0) { return 1024; }
    var lim = sl >> 11;                   # bytes / 2,048; RLIM_INFINITY is all ones
    if (lim > 16384) { return 16384; }
    if (lim < 64) { return 64; }
    return lim;
}

# Cached AST root.
var _f_ast = 0;

# ⭐ The PRE-EXPRESSION option table, and the parser's only source for it.
#
# ⛔ This function previously built a spec that was assigned to `_find_spec`,
# never read, and never even CALLED — five releases of a documentation-only
# table sitting beside a parser that hardcoded the same three letters. That is
# the exact second-source-of-truth the 1.3.x arc exists to prevent, and it is
# why `find` rendered `"options": null`: there was nothing trustworthy to show.
#
# ⚠ Only `-H`/`-L`/`-P` belong here. Everything after the start paths is an
# EXPRESSION — `-name`, `-type`, `-exec`, `(`, `!`, `-o` — and those are
# predicates and operators, not options. A flags parser handed find's argv would
# eat `-name` as an unknown option; the walk below owns the grammar and asks
# this spec only about the leading flags.
fn _f_init_spec(): i64 {
    if (_find_spec != 0) { return 0; }
    var s = flags_new();
    _f_L_idx = flags_add_bool(s, 76, "follow",         0, "follow all symlinks");
    _f_H_idx = flags_add_bool(s, 72, "follow-operand", 0, "follow symlinks given as starting points only");
    _f_P_idx = flags_add_bool(s, 80, "no-follow",      0, "never follow symlinks (default)");
    _find_spec = s;
    return 0;
}

# --- Error helper ------------------------------------------------------

fn _f_report_path(path, errno): i64 {
    k_write( 2, "kriya find: ", 12);
    k_write( 2, path, strlen(path));
    k_write( 2, ": ", 2);
    if (errmsg_is_known(errno) == 1) {
        var m = errmsg_for(errno);
        k_write( 2, m, strlen(m));
    } else {
        k_write( 2, "errno ", 6);
        var buf[8];
        var i: i64 = 7;
        store8(&buf + i, 0);
        i = i - 1;
        var v = errno;
        if (v == 0) { store8(&buf + i, 48); i = i - 1; }
        while (v > 0) {
            store8(&buf + i, 48 + (v - (v / 10) * 10));
            v = v / 10;
            i = i - 1;
        }
        k_write( 2, &buf + i + 1, 6 - i);
    }
    k_write( 2, "\n", 1);
    return 0;
}

fn _f_report_usage(msg): i64 {
    k_write( 2, "kriya find: ", 12);
    k_write( 2, msg, strlen(msg));
    k_write( 2, "\n", 1);
    return 0;
}

# --- -regex / -iregex --------------------------------------------------
#
# ⛔ kriya's DEFAULT DIALECT IS POSIX BRE. GNU's is EMACS regex, and the two
# disagree on exactly the characters people reach for: measured against GNU,
# `-regex '.*a+b'` treats `+` as ONE-OR-MORE there and as a LITERAL PLUS here.
# ⚠ That is a silent difference in results, not an error, which is the worst
# shape a divergence can take — so it is stated in `--help`, in ADR 0005, and
# `-regextype emacs` is REFUSED by name rather than quietly treated as BRE.
#
# ⭐ The pattern is matched against the WHOLE PATH AS WRITTEN, anchored at both
# ends — verified against GNU: `find . -regex 'aab'` finds nothing while
# `-regex '\./aab\.c'` finds `./aab.c`, leading `./` included. That is a
# property of the path the walk built, so `find sub` matches `sub/x.c`.
# ASCII case fold for `-iregex` under BRE, which has no inline flag. ⚠ Folding
# the SUBJECT means the PATTERN must already be lower-case to match — the same
# asymmetry `grep -i` carries for BRE, and the reason `-iregex` under
# `-regextype posix-extended` uses niyama's `(?i)` instead.
#
# ⭐ The byte fold is `src/lib/icase.cyr`'s at 1.4.5; this wrapper stays so the
# call sites keep reading in find's own vocabulary. ⛔ The PATTERN fold is no
# longer this function's job, and that was a real bug: lower-casing a pattern's
# bytes does not lower-case the SET a bracket expression denotes, so
# `find -iregex '.*[[:upper:]].*'` matched NOTHING where GNU matches every path.
# `icase_rewrite` does it properly — see the header of `src/lib/icase.cyr`.
fn _f_fold_bytes(src, dst, len): i64 {
    icase_fold_bytes(src, dst, len);
    store8(dst + len, 0);
    return 0;
}

enum FindRegexType {
    F_RX_BRE = 0,
    F_RX_ERE = 1,
}
var _f_regextype = 0;

fn _f_regex_compile(pat, fold): i64 {
    # ⛔ Same rule as grep's, and for the same reason — niyama implements
    # neither `[=c=]` nor `[.c.]` and fails both silently.
    if (icase_scan_unsupported(pat, strlen(pat)) != ICASE_OK) { return 0; }
    # ⚠ Case folding rides on niyama's inline-flag form for ERE, matching how
    # `grep -i -E` does it (ADR 0005). BRE has no inline flag, so `-iregex`
    # under the default dialect folds the SUBJECT instead — the same asymmetry
    # grep already carries.
    if (_f_regextype == F_RX_ERE) {
        if (fold == 1) {
            var buf = alloc(strlen(pat) + 8);
            memcpy(buf, "(?i)", 4);
            memcpy(buf + 4, pat, strlen(pat) + 1);
            return niyama_re2_compile(buf);
        }
        return niyama_re2_compile(pat);
    }
    # ⛔ The POSIX-literal `*` positions niyama gets wrong (1.6.14): `fr/\(*a\)`
    # was refused where GNU matches `fr/*a`. See `icase_bre_literal_stars`.
    var sl: i64 = 0;
    return niyama_bre_compile(icase_bre_literal_stars(pat, strlen(pat), &sl));
}

# --- fnmatch-style glob -----------------------------------------------

# ⚠ The matcher itself now lives in `src/lib/glob.cyr`, shared with `grep`.
# This wrapper stays so find's call sites keep reading in find's own vocabulary.
fn _f_glob_match(pat, plen, text, tlen): i64 {
    return glob_match(pat, plen, text, tlen);
}

# --- Token helpers (argv navigation) ----------------------------------

fn _f_tok(): i64 {
    if (_f_pos >= _f_argv_n) { return 0; }
    return load64(_f_argv_flat + _f_pos * 8);
}

fn _f_consume(): i64 {
    var t = _f_tok();
    _f_pos = _f_pos + 1;
    return t;
}

fn _f_tok_eq(s): i64 {
    var t = _f_tok();
    if (t == 0) { return 0; }
    return streq(t, s);
}

# Parse +/-/exact number prefix. On entry s points to "+N", "-N", or "N".
# Stores sign in *sign_ptr, returns the integer value (or -1 on bad).
#
# ⛔ N WRAPPED PAST 2^64 until 1.6.16: `-mmin -18446744073709551617` asked for
# "less than 1 minute" and matched nothing, where GNU matches everything. N
# SATURATES now, as GNU's does — a time that far back is "longer ago than any
# file" — and the callers only compare it, never multiply it.
fn _f_parse_signed_int(s, sign_ptr): i64 {
    if (s == 0) { return 0 - 1; }
    var i: i64 = 0;
    var sign: i64 = F_SIGN_EXACT;
    if (load8(s) == 43) { sign = F_SIGN_PLUS;  i = 1; }
    elif (load8(s) == 45) { sign = F_SIGN_MINUS; i = 1; }
    if (load8(s + i) == 0) { return 0 - 1; }
    var len: i64 = 0;
    var n = kriya_count_digits(s + i, &len);
    if (load8(s + i + len) != 0) { return 0 - 1; }
    store64(sign_ptr, sign);
    return n;
}

# A number the way GNU's `get_num` reads one for -uid, -gid and -size: `+` (more
# than) or `-` (less than), then `xstrtoumax`'s shape — blanks, one optional `+`,
# digits, nothing after — up to 2^64 - 1. Stores the sign and the value, the value
# as -1 when it is past 2^63 - 1 (`_f_cmp_num` reads that as larger than anything
# a file has). Returns 0, or -1 when it is not a number.
#
# ⛔ `-uid` AND `-gid` TOOK ONLY AN EXACT, BARE NUMBER until 1.7.1, so `-uid +999`
# and `-gid -100` were usage errors where GNU compares, and `-uid ' 5'` and
# `-size ++1c` were refused where GNU reads them. ⚠ The second sign is GNU's too:
# the first `+` is the comparison and the next one belongs to the number.
fn _f_parse_num(s, sign_ptr, val_ptr): i64 {
    if (s == 0) { return 0 - 1; }
    var i: i64 = 0;
    var sign: i64 = F_SIGN_EXACT;
    if (load8(s) == 43) { sign = F_SIGN_PLUS;  i = 1; }
    elif (load8(s) == 45) { sign = F_SIGN_MINUS; i = 1; }
    var v = kriya_parse_bounded(s + i, KRIYA_COUNT_MAX);
    if (v == (0 - 1)) { return 0 - 1; }
    if (v == (0 - 2)) {
        if (kriya_fits_u64(s + i) == 0) { return 0 - 1; }
        v = 0 - 1;
    }
    store64(sign_ptr, sign);
    store64(val_ptr, v);
    return 0;
}

# GNU's `compare_num`: `actual` against `want` under `sign`. `want` = -1 stands
# for a number past 2^63 - 1, more than any size or id: never equal, never
# exceeded, always more.
fn _f_cmp_num(sign, want, actual): i64 {
    if (want < 0) {
        if (sign == F_SIGN_MINUS) { return 1; }
        return 0;
    }
    if (sign == F_SIGN_PLUS)  { if (actual > want) { return 1; } return 0; }
    if (sign == F_SIGN_MINUS) { if (actual < want) { return 1; } return 0; }
    if (actual == want) { return 1; }
    return 0;
}

# Parse a -size argument like "+10c", "-1M", "100": the COUNT, in the unit its
# suffix names, as `_f_parse_num` reads it (sign and count to `*sign_ptr` and
# `*val_ptr`), and the unit's size in bytes to `*unit_ptr`. Returns 0, or -1 when
# it is not one. GNU's rule: the LAST character is the unit when it is one of
# `bcwkMG`, and must be a digit otherwise.
#
# ⛔ IT RETURNED BYTES — the count times the unit — and compared those with the
# file's size, so `find -size -1M` matched every file under a megabyte. GNU
# rounds the file's size UP to the unit and compares counts: `-size -1M` is
# only the empty files, and `-size 1k` includes a one-byte file. POSIX defines
# only blocks and `c`; `k`, `M`, `G` and `w` are GNU's, and so is that rule
# (1.6.16). There is no multiplication to wrap.
fn _f_parse_size(s, sign_ptr, val_ptr, unit_ptr): i64 {
    if (s == 0) { return 0 - 1; }
    var len = strlen(s);
    if (len == 0) { return 0 - 1; }
    var suf = load8(s + len - 1);
    var unit: i64 = 0;
    if      (suf == 98)  { unit = 512; }           # b
    elif    (suf == 99)  { unit = 1; }             # c
    elif    (suf == 119) { unit = 2; }             # w: two-byte words (1.7.1)
    elif    (suf == 107) { unit = 1024; }          # k
    elif    (suf == 77)  { unit = 1048576; }       # M
    elif    (suf == 71)  { unit = 1073741824; }    # G
    elif    (suf < 48)   { return 0 - 1; }
    elif    (suf > 57)   { return 0 - 1; }
    # The number is everything before the unit — a copy, since argv is shared.
    var nlen = len;
    if (unit != 0) { nlen = len - 1; }
    else { unit = 512; }
    var num = alloc(nlen + 1);
    memcpy(num, s, nlen);
    store8(num + nlen, 0);
    if (_f_parse_num(num, sign_ptr, val_ptr) != 0) { return 0 - 1; }
    store64(unit_ptr, unit);
    return 0;
}

# --- AST node allocator -----------------------------------------------

# Node layout (32 bytes):
#   0  kind
#   8  data_a (lhs for binary; predicate primary data)
#   16 data_b (rhs for binary; predicate secondary data)
#   24 data_c (predicate tertiary data, e.g. exec-end-index)
fn _f_node_new(kind, a, b, c): i64 {
    var n = alloc(32);
    store64(n + 0, kind);
    store64(n + 8, a);
    store64(n + 16, b);
    store64(n + 24, c);
    return n;
}

# Forward decls aren't supported — declare recursion order: parse_or →
# parse_and → parse_unary → parse_primary, where primary may call
# parse_or for grouped subexpressions. We achieve this by inlining
# the primary parser's group handling to call parse_or via a state
# pump.

fn _f_set_err(msg): i64 {
    _f_err = 1;
    _f_err_msg = msg;
    return 0;
}

fn _f_parse_primary(): i64 {
    var t = _f_tok();
    if (t == 0) { _f_set_err("missing operand"); return 0; }

    # Group: ( EXPR ), where EXPR may hold `,` too.
    if (streq(t, "(") == 1) {
        if (_f_nest >= _f_nest_cap) { _f_set_err("parentheses nested too deeply for the stack"); return 0; }
        _f_nest = _f_nest + 1;
        _f_consume();
        var inner = _f_parse_list();
        _f_nest = _f_nest - 1;
        if (_f_err == 1) { return 0; }
        if (_f_tok_eq(")") == 0) { _f_set_err("expected ')' to close group"); return 0; }
        _f_consume();
        return inner;
    }

    # Predicates
    if (streq(t, "-name") == 1) {
        _f_consume();
        var pat = _f_consume();
        if (pat == 0) { _f_set_err("-name needs an argument"); return 0; }
        return _f_node_new(F_N_NAME, pat, strlen(pat), 0);
    }
    if (streq(t, "-regextype") == 1) {
        _f_consume();
        var rt = _f_consume();
        if (rt == 0) { _f_set_err("-regextype needs an argument"); return 0; }
        # ⛔ AN OPTION, TRUE WHERE IT STANDS, and it sets the dialect of the -regex
        # tests AFTER it, which record it. It used to swallow the next test as its
        # own operand — so `-regextype posix-extended -not -regex X` and a trailing
        # `-regextype` were usage errors — and the dialect was read again at MATCH
        # time, so a second -regextype ran an ERE through the BRE engine (1.7.1).
        if (streq(rt, "posix-basic") == 1) { _f_regextype = F_RX_BRE; return _f_node_new(F_N_TRUE, 0, 0, 0); }
        if (streq(rt, "posix-extended") == 1) { _f_regextype = F_RX_ERE; return _f_node_new(F_N_TRUE, 0, 0, 0); }
        # ⛔ REFUSED BY NAME, not quietly aliased. GNU's default and its `emacs`
        # type accept `a+` as one-or-more; kriya's engines are POSIX BRE and ERE
        # (ADR 0005), where an unescaped `+` is a LITERAL under BRE. Silently
        # treating `-regextype emacs` as BRE would return different files with
        # no diagnostic — the exact shape this project treats as worse than a
        # clean refusal.
        _f_set_err("-regextype: only posix-basic and posix-extended are supported (ADR 0005); GNU's emacs/findutils-default dialect is not");  #skip-lint
        return 0;
    }
    if (streq(t, "-regex") == 1) {
        _f_consume();
        var rp = _f_consume();
        if (rp == 0) { _f_set_err("-regex needs an argument"); return 0; }
        var rn = _f_regex_compile(rp, 0);
        if (rn == 0) { _f_set_err("-regex pattern failed to compile"); return 0; }
        return _f_node_new(F_N_REGEX, rn, 0, _f_regextype);
    }
    if (streq(t, "-iregex") == 1) {
        _f_consume();
        var ip = _f_consume();
        if (ip == 0) { _f_set_err("-iregex needs an argument"); return 0; }
        # ⚠ Under BRE both sides must be folded: the subject at match time and
        # the pattern here. Folding only one is the classic half-fix that makes
        # `-iregex '.*ABC'` silently match nothing.
        var ierr: i64 = 0;
        var ilen: i64 = 0;
        # ⛔ `ICASE_RANGE_TRANSLATE` because GNU `find` is NOT GNU `grep`: find
        # goes through glibc `regcomp` with `RE_ICASE` and grep does not, and
        # the two disagree on every mixed-case range. See the enum's note.
        var imode = ICASE_MODE_FOLD | ICASE_RANGE_TRANSLATE;
        if (_f_regextype == F_RX_ERE) {
            imode = ICASE_MODE_CLOSED | ICASE_RANGE_TRANSLATE;
        }
        var ifold = icase_rewrite(ip, strlen(ip), imode, &ilen, &ierr);
        if (ifold == 0) {
            if (ierr == ICASE_E_RANGE) {
                _f_set_err("-iregex has an invalid range end");
            } elif (ierr == ICASE_E_EQUIV) {
                _f_set_err("-iregex: niyama implements no [=c=] / [.c.]");
            } else {
                _f_set_err("-iregex has an unterminated [");
            }
            return 0;
        }
        var inn = _f_regex_compile(ifold, 1);
        if (inn == 0) { _f_set_err("-iregex pattern failed to compile"); return 0; }
        return _f_node_new(F_N_REGEX, inn, 1, _f_regextype);
    }
    if (streq(t, "-type") == 1) {
        _f_consume();
        var ta = _f_consume();
        if (ta == 0) { _f_set_err("-type needs an argument"); return 0; }
        if (load8(ta + 1) != 0) { _f_set_err("-type needs a single-letter argument"); return 0; }
        return _f_node_new(F_N_TYPE, load8(ta), 0, 0);
    }
    if (streq(t, "-size") == 1) {
        _f_consume();
        var sa = _f_consume();
        if (sa == 0) { _f_set_err("-size needs an argument"); return 0; }
        var sign: i64 = 0;
        var count: i64 = 0;
        var unit: i64 = 0;
        if (_f_parse_size(sa, &sign, &count, &unit) != 0) { _f_set_err("bad -size argument"); return 0; }
        return _f_node_new(F_N_SIZE, sign, count, unit);
    }
    if (streq(t, "-mtime") == 1) {
        _f_consume();
        var ma = _f_consume();
        if (ma == 0) { _f_set_err("-mtime needs an argument"); return 0; }
        var sg: i64 = 0;
        var n = _f_parse_signed_int(ma, &sg);
        if (n < 0) { _f_set_err("bad -mtime argument"); return 0; }
        return _f_node_new(F_N_MTIME, sg, n, 0);
    }
    if (streq(t, "-mmin") == 1) {
        _f_consume();
        var mma = _f_consume();
        if (mma == 0) { _f_set_err("-mmin needs an argument"); return 0; }
        var sg2: i64 = 0;
        var n2 = _f_parse_signed_int(mma, &sg2);
        if (n2 < 0) { _f_set_err("bad -mmin argument"); return 0; }
        return _f_node_new(F_N_MMIN, sg2, n2, 0);
    }
    if (streq(t, "-empty") == 1) {
        _f_consume();
        return _f_node_new(F_N_EMPTY, 0, 0, 0);
    }
    if (streq(t, "-newer") == 1) {
        _f_consume();
        var rp = _f_consume();
        if (rp == 0) { _f_set_err("-newer needs an argument"); return 0; }
        # stat the ref now; cache mtime in the node.
        # ⛔ FOLLOWED UNDER -H AND -L, as a starting point is. It was always
        # `lstat`ed, so `find -L d -newer LINK` compared against the LINK's own
        # mtime where GNU uses its target's (1.7.1).
        var st[144];
        var r = _f_xstat(rp, 0, &st);
        if (r < 0) { _f_set_err("-newer reference path not found"); return 0; }
        return _f_node_new(F_N_NEWER, load64(&st + FS_STAT_MTIME), load64(&st + FS_STAT_MTIME_NSEC), 0);
    }
    # ⛔ `-user` takes a NAME **or** a numeric id, and the NAME wins when both
    # readings are possible. Measured: with a user literally named `4242` whose
    # uid is 7777, `find -user 4242` matches the uid-7777 files. So the lookup
    # order is name-first, number-only-as-fallback — not "digits mean a number".
    # ⚠ GNU exits 1 here where kriya exits 2 (ADR 0008 usage-error policy); the
    # diagnostic wording differs too, so tests compare refusal, not text.
    if (streq(t, "-user") == 1) {
        _f_consume();
        var ua = _f_consume();
        if (ua == 0) { _f_set_err("-user needs an argument"); return 0; }
        var uid = userdb_user_id(ua);
        # ⚠ A number that is not a name must fit a `uid_t`, as in GNU: past
        # 4294967295 it is refused, where it used to WRAP past 2^64 (1.6.16).
        if (uid < 0) { uid = kriya_parse_bounded(ua, 4294967295); }
        if (uid < 0) { _f_set_err("-user: not the name of a known user"); return 0; }
        return _f_node_new(F_N_UID, uid, F_SIGN_EXACT, 0);
    }
    if (streq(t, "-group") == 1) {
        _f_consume();
        var ga = _f_consume();
        if (ga == 0) { _f_set_err("-group needs an argument"); return 0; }
        var gid = userdb_group_id(ga);
        if (gid < 0) { gid = kriya_parse_bounded(ga, 4294967295); }
        if (gid < 0) { _f_set_err("-group: not the name of a known group"); return 0; }
        return _f_node_new(F_N_GID, gid, F_SIGN_EXACT, 0);
    }
    # ⚠ `-uid` / `-gid` are NUMERIC ONLY — a name is not accepted, which is what
    # makes them the unambiguous form when a user is named after a number. They
    # take `+N` and `-N` as -size does (1.7.1).
    if (streq(t, "-uid") == 1) {
        _f_consume();
        var un = _f_consume();
        if (un == 0) { _f_set_err("-uid needs an argument"); return 0; }
        var us: i64 = 0;
        var uv: i64 = 0;
        if (_f_parse_num(un, &us, &uv) != 0) { _f_set_err("bad -uid value"); return 0; }
        return _f_node_new(F_N_UID, uv, us, 0);
    }
    if (streq(t, "-gid") == 1) {
        _f_consume();
        var gn = _f_consume();
        if (gn == 0) { _f_set_err("-gid needs an argument"); return 0; }
        var gs: i64 = 0;
        var gv: i64 = 0;
        if (_f_parse_num(gn, &gs, &gv) != 0) { _f_set_err("bad -gid value"); return 0; }
        return _f_node_new(F_N_GID, gv, gs, 0);
    }
    # `-perm MODE`: the mode is compiled once and applied to 0 with a umask of 0,
    # twice — for a directory and for anything else, which differ only through
    # `X` — exactly as GNU's `parse_perm` does (`src/lib/mode.cyr`).
    if (streq(t, "-perm") == 1) {
        _f_consume();
        var pa = _f_consume();
        if (pa == 0) { _f_set_err("-perm needs an argument"); return 0; }
        var pkind: i64 = F_PERM_EXACT;
        var pstart: i64 = 0;
        if (load8(pa) == 45) { pkind = F_PERM_ALL; pstart = 1; }
        elif (load8(pa) == 47) { pkind = F_PERM_ANY; pstart = 1; }
        var mc = kmode_compile(pa + pstart);
        # ⛔ `+` BEFORE AN OCTAL DIGIT IS REFUSED, as GNU refuses it. It was GNU's
        # old spelling of `/`, removed in 2005 because `chmod` reads `+222` as
        # "add these bits"; accepting it under either meaning would answer a
        # script written for the other. `+w` and `-+222` are ordinary modes.
        if (load8(pa) == 43) {
            var p1 = load8(pa + 1);
            if (p1 >= 48) { if (p1 < 56) { mc = 0; } }
        }
        if (mc == 0) { _f_set_err("-perm: invalid file mode"); return 0; }
        var pfile = kmode_adjust(0, 0, 0, mc);
        var pdir  = kmode_adjust(0, 1, 0, mc);
        # ⚠ `/MODE` that names no bit at all (`/000`, `/u=`) matches EVERY file,
        # like `-000`: GNU changed it in 2007 from matching none.
        if (pkind == F_PERM_ANY) {
            if (pfile == 0) { if (pdir == 0) { pkind = F_PERM_ALL; } }
        }
        return _f_node_new(F_N_PERM, pkind, pfile, pdir);
    }
    if (streq(t, "-prune") == 1) {
        _f_consume();
        return _f_node_new(F_N_PRUNE, 0, 0, 0);
    }
    # ⚠ `-d` is BSD's spelling, and GNU takes it too; its warning that `-d` is
    # deprecated is printed only on a terminal (see the header).
    if (streq(t, "-depth") == 1 || streq(t, "-d") == 1) {
        _f_consume();
        _f_depth_first = 1;
        return _f_node_new(F_N_TRUE, 0, 0, 0);
    }
    # ⚠ "no entry in the database", NOT "id is zero" and NOT "lookup failed" —
    # with /etc/passwd absent entirely, GNU's `-nouser` matches EVERY file.
    if (streq(t, "-nouser") == 1) {
        _f_consume();
        return _f_node_new(F_N_NOUSER, 0, 0, 0);
    }
    if (streq(t, "-nogroup") == 1) {
        _f_consume();
        return _f_node_new(F_N_NOGROUP, 0, 0, 0);
    }
    if (streq(t, "-maxdepth") == 1) {
        _f_consume();
        var dx = _f_consume();
        if (dx == 0) { _f_set_err("-maxdepth needs an argument"); return 0; }
        # ⚠ GNU's depth is an `int`: past 2147483647 it is out of range. It used
        # to be taken — and past 2^64 to WRAP to a small depth (1.6.16).
        var dv = kriya_parse_nonneg_int(dx);
        if (dv > 2147483647) { dv = 0 - 1; }
        if (dv < 0) { _f_set_err("bad -maxdepth value"); return 0; }
        _f_maxdepth = dv;
        return _f_node_new(F_N_TRUE, 0, 0, 0);
    }
    if (streq(t, "-mindepth") == 1) {
        _f_consume();
        var dy = _f_consume();
        if (dy == 0) { _f_set_err("-mindepth needs an argument"); return 0; }
        var dv2 = kriya_parse_nonneg_int(dy);
        if (dv2 > 2147483647) { dv2 = 0 - 1; }
        if (dv2 < 0) { _f_set_err("bad -mindepth value"); return 0; }
        _f_mindepth = dv2;
        return _f_node_new(F_N_TRUE, 0, 0, 0);
    }
    if (streq(t, "-print") == 1) {
        _f_consume();
        return _f_node_new(F_N_PRINT, 0, 0, 0);
    }
    if (streq(t, "-print0") == 1) {
        _f_consume();
        return _f_node_new(F_N_PRINT0, 0, 0, 0);
    }
    if (streq(t, "-exec") == 1) {
        _f_consume();
        # Collect argv tokens until `;` — or until `+`, when the token before it
        # is exactly `{}`: GNU's rule (Savannah bug 66365, findutils 4.10). Any
        # other `+` is an ordinary argument, so `-exec echo {}x +` still wants
        # its `;`, and `-exec echo + ;` prints a plus.
        var start_pos = _f_pos;
        var found_end: i64 = 0;
        var plus: i64 = 0;
        var prev_braces: i64 = 0;
        var brace_count: i64 = 0;
        while (found_end == 0) {
            var tk = _f_tok();
            if (tk == 0) {
                _f_set_err("-exec missing ';' terminator");
                return 0;
            }
            if (streq(tk, ";") == 1) { found_end = 1; }
            elif (prev_braces == 1) {
                if (streq(tk, "+") == 1) { found_end = 1; plus = 1; }
            }
            if (found_end == 0) {
                prev_braces = 0;
                if (_f_has_braces(tk) == 1) {
                    brace_count = brace_count + 1;
                    if (streq(tk, "{}") == 1) { prev_braces = 1; }
                }
                _f_consume();
            }
        }
        var end_pos = _f_pos;
        _f_consume();  # eat the terminator
        if (end_pos == start_pos) {
            _f_set_err("-exec needs at least one command argument");
            return 0;
        }
        if (plus == 1) {
            # ⚠ EVERY token holding `{}` counts, the command's own included:
            # `-exec sh -c 'echo {}' sh {} +` is refused, as in GNU.
            if (brace_count > 1) {
                _f_set_err("only one instance of {} is supported with -exec ... +");
                return 0;
            }
            return _f_execplus_new(start_pos, end_pos - 1);
        }
        return _f_node_new(F_N_EXEC, start_pos, end_pos, 0);
    }

    _f_set_err("unknown predicate / operator");
    return 0;
}

# Pull the unit-suffix indicator out of an unparsed -size arg so the
# evaluator can choose between byte-exact (`c`) and block-rounded
# (default / `b`). Returns 0 for blocks (default), 1 for bytes.
# ⚠ A run of `!` is COUNTED, not recursed: `! ! x` is `x`, and fifty thousand of
# them cost one counter (GNU recurses, and dies of SIGSEGV at 50,001).
fn _f_parse_unary(): i64 {
    var neg: i64 = 0;
    var more: i64 = 1;
    while (more == 1) {
        var t = _f_tok();
        if (t == 0) { more = 0; }
        elif (streq(t, "!") == 1 || streq(t, "-not") == 1) { _f_consume(); neg = 1 - neg; }
        else { more = 0; }
    }
    if (_f_tok() == 0) { _f_set_err("missing operand"); return 0; }
    var inner = _f_parse_primary();
    if (_f_err == 1) { return 0; }
    if (neg == 1) { return _f_node_new(F_N_NOT, inner, 0, 0); }
    return inner;
}

# A chain of `kind` nodes over the operands in `ops`, built RIGHT-deep.
# ⛔ RIGHT-DEEP ON PURPOSE: `_f_eval`, `_f_has_action` and `_f_flush_execs` walk a
# chain's right spine in a loop and recurse only into left children, so a chain of
# any length costs one frame. Built left-deep, `find . -name a -o -name b -o …`
# over 50,000 names recursed 50,000 deep and died of SIGSEGV where GNU runs it
# (1.7.1). All three operators are associative, `,` included: every operand still
# runs left to right, and the value is the last one's.
fn _f_chain(kind, ops): i64 {
    var i = vec_len(ops) - 1;
    var node = vec_get(ops, i);
    i = i - 1;
    while (i >= 0) {
        node = _f_node_new(kind, vec_get(ops, i), node, 0);
        i = i - 1;
    }
    return node;
}

fn _f_parse_and(): i64 {
    var first = _f_parse_unary();
    if (_f_err == 1) { return 0; }
    var ops: i64 = 0;
    var loop: i64 = 1;
    while (loop == 1) {
        var t = _f_tok();
        var more: i64 = 0;
        if (t == 0) { loop = 0; }
        elif (streq(t, "-a") == 1 || streq(t, "-and") == 1) { _f_consume(); more = 1; }
        # Implicit AND: any token that isn't `)`, `-o`, `-or`, `,`, or EOF
        # is the start of another predicate.
        elif (streq(t, ")") == 1 || streq(t, "-o") == 1 || streq(t, "-or") == 1) { loop = 0; }
        elif (streq(t, ",") == 1) { loop = 0; }
        else { more = 1; }
        if (more == 1) {
            var rhs = _f_parse_unary();
            if (_f_err == 1) { return 0; }
            if (ops == 0) { ops = vec_new(); vec_push(ops, first); }
            vec_push(ops, rhs);
        }
    }
    if (ops == 0) { return first; }
    return _f_chain(F_N_AND, ops);
}

fn _f_parse_or(): i64 {
    var first = _f_parse_and();
    if (_f_err == 1) { return 0; }
    var ops: i64 = 0;
    var loop: i64 = 1;
    while (loop == 1) {
        var t = _f_tok();
        if (t == 0) { loop = 0; }
        elif (streq(t, "-o") == 1 || streq(t, "-or") == 1) {
            _f_consume();
            var rhs = _f_parse_and();
            if (_f_err == 1) { return 0; }
            if (ops == 0) { ops = vec_new(); vec_push(ops, first); }
            vec_push(ops, rhs);
        } else { loop = 0; }
    }
    if (ops == 0) { return first; }
    return _f_chain(F_N_OR, ops);
}

# The whole expression: `-o` lists joined by GNU's `,` — both sides always run,
# and the value is the right one's. Lowest precedence, left to right (1.7.1).
fn _f_parse_list(): i64 {
    var first = _f_parse_or();
    if (_f_err == 1) { return 0; }
    var ops: i64 = 0;
    var loop: i64 = 1;
    while (loop == 1) {
        if (_f_tok_eq(",") == 1) {
            _f_consume();
            var rhs = _f_parse_or();
            if (_f_err == 1) { return 0; }
            if (ops == 0) { ops = vec_new(); vec_push(ops, first); }
            vec_push(ops, rhs);
        } else { loop = 0; }
    }
    if (ops == 0) { return first; }
    return _f_chain(F_N_COMMA, ops);
}

# Return 1 if `n` (rooted at the top of the AST) contains an action node
# anywhere (-print, -print0, -exec). When the expression has no
# explicit action, find appends an implicit -print.
# ⚠ `-prune` is NOT one: GNU's rule is "no actions other than -prune or -print",
# so `find . -name x -prune` still prints what it matched.
fn _f_has_action(n): i64 {
    var cur = n;
    var found: i64 = 0;
    var more: i64 = 1;
    while (more == 1) {
        if (cur == 0) { more = 0; }
        else {
            var k = load64(cur);
            if (k == F_N_PRINT || k == F_N_PRINT0 || k == F_N_EXEC) { found = 1; more = 0; }
            elif (k == F_N_EXECPLUS) { found = 1; more = 0; }
            elif (k == F_N_NOT) { cur = load64(cur + 8); }
            elif (k == F_N_AND || k == F_N_OR || k == F_N_COMMA) {
                # The left child by recursion, the right spine by the loop.
                if (_f_has_action(load64(cur + 8)) == 1) { found = 1; more = 0; }
                else { cur = load64(cur + 16); }
            } else { more = 0; }
        }
    }
    return found;
}

# --- Predicate evaluators ---------------------------------------------

fn _f_eval_size_predicate(sign, want, unit, actual_size): i64 {
    # GNU: the size in UNITS, rounded up — 1..512 bytes is one block, 1..1024
    # one `k` — so an empty file is the only thing smaller than one of anything.
    var actual = actual_size / unit;
    if (actual * unit < actual_size) { actual = actual + 1; }
    return _f_cmp_num(sign, want, actual);
}

# GNU's `pred_perm`. `vfile` / `vdir` are the mode compiled for a file and for a
# directory; they differ only when the mode used `X`.
fn _f_eval_perm_predicate(kind, vfile, vdir, stat_buf): i64 {
    var m = load64(stat_buf + 24);
    var want = vfile;
    if ((m & FS_S_IFMT) == FS_S_IFDIR) { want = vdir; }
    if (kind == F_PERM_ALL) {
        if ((m & want) == want) { return 1; }
        return 0;
    }
    if (kind == F_PERM_ANY) {
        # ⚠ No bit to test is a match — `/u=X` holds none for a plain file, and
        # GNU matches it (Savannah bug 14748).
        if (want == 0) { return 1; }
        if ((m & want) != 0) { return 1; }
        return 0;
    }
    if ((m & KMODE_ALL) == want) { return 1; }
    return 0;
}

fn _f_eval_mtime_predicate(sign, want_days, mtime): i64 {
    # GNU: file ages floor((now - mtime) / 86400) days. -N means age<N,
    # +N means age>N, exact means floor(age) == N.
    var age = _f_now_secs - mtime;
    if (age < 0) { age = 0; }
    var age_days = age / 86400;
    if (sign == F_SIGN_PLUS)  { if (age_days > want_days) { return 1; } return 0; }
    if (sign == F_SIGN_MINUS) { if (age_days < want_days) { return 1; } return 0; }
    return (age_days == want_days);
}

fn _f_eval_mmin_predicate(sign, want_min, mtime): i64 {
    var age = _f_now_secs - mtime;
    if (age < 0) { age = 0; }
    var age_min = age / 60;
    if (sign == F_SIGN_PLUS)  { if (age_min > want_min) { return 1; } return 0; }
    if (sign == F_SIGN_MINUS) { if (age_min < want_min) { return 1; } return 0; }
    return (age_min == want_min);
}

fn _f_eval_type_predicate(letter, stat_buf): i64 {
    var m = load64(stat_buf + 24);
    var ifmt = m & FS_S_IFMT;
    if (letter == 102) { if (ifmt == FS_S_IFREG) { return 1; } return 0; }   # f
    if (letter == 100) { if (ifmt == FS_S_IFDIR) { return 1; } return 0; }   # d
    if (letter == 108) { if (ifmt == FS_S_IFLNK) { return 1; } return 0; }   # l
    if (letter == 115) { if (ifmt == FS_S_IFSOCK) { return 1; } return 0; }   # s
    if (letter == 112) { if (ifmt == FS_S_IFIFO) { return 1; } return 0; }   # p
    if (letter == 98) { if (ifmt == FS_S_IFBLK) { return 1; } return 0; }   # b
    if (letter == 99) { if (ifmt == FS_S_IFCHR) { return 1; } return 0; }   # c
    return 0;
}

# Returns 1 (regular file size 0) OR (directory with no entries beyond .. /.
# Other types yield 0.
fn _f_eval_empty_predicate(path, stat_buf, depth): i64 {
    var m = load64(stat_buf + 24);
    var ifmt = m & FS_S_IFMT;
    if (ifmt == FS_S_IFREG) {
        if (load64(stat_buf + 48) == 0) { return 1; }
        return 0;
    }
    if (ifmt == FS_S_IFDIR) {
        # M8 mitigation: respect _f_follow_mode for NOFOLLOW. Without
        # this, a swapped-in symlink between classifying lstat and this
        # open would be silently followed even under default `-P`.
        # Mirrors the conditional NOFOLLOW pattern used at the main
        # descent site (_f_descend / line ~918).
        var open_flags: i64 = FS_O_DIRECTORY;  # | O_RDONLY
        if (_f_follows(depth) == 0) { open_flags = open_flags | FS_O_NOFOLLOW; }
        var dfd = fs_openat(0 - 100, path, open_flags, 0);
        if (dfd < 0) {
            # ⛔ REPORTED, as GNU's `pred_empty` does, and the exit is 1. A directory
            # -empty could not open was silently "not empty" at exit 0 (1.7.1).
            _f_report_path(path, 0 - dfd);
            _f_any_failed = 1;
            return 0;
        }
        var dbuf = alloc(4096);
        var any: i64 = 0;
        var loop: i64 = 1;
        while (loop == 1) {
            var nb = fs_getdents64(dfd, dbuf, 4096);
            if (nb <= 0) { loop = 0; }
            else {
                var off: i64 = 0;
                while (off < nb) {
                    var ent = dbuf + off;
                    if (fs_dent_is_dotdot(ent) == 0) {
                        any = 1;
                        off = nb;
                        loop = 0;
                    } else {
                        off = off + fs_dent_reclen(ent);
                    }
                }
            }
        }
        fs_close(dfd);
        if (any == 0) { return 1; }
        return 0;
    }
    return 0;
}

# Does `tok` hold `{}` anywhere?
fn _f_has_braces(tok): i64 {
    var i: i64 = 0;
    while (load8(tok + i) != 0) {
        if (load8(tok + i) == 123) { if (load8(tok + i + 1) == 125) { return 1; } }
        i = i + 1;
    }
    return 0;
}

# --- -exec … {} + --------------------------------------------------------
#
# ⭐ ONE COMMAND PER BATCH OF PATHS, counted as GNU counts it: the builder in
# `src/lib/argbatch.cyr`, 131,072 bytes of arguments, the command's own words
# included (1.7.0). ⚠ The predicate is always TRUE; a command that fails, is not
# found or is killed makes find exit 1, which is what POSIX asks of this form.
# Batches run as they fill, and what is left runs after the walk, in the order
# the `-exec`s were written.

enum FindExecPlus {
    F_XP_AB   = 0;     # the builder
    F_XP_PATH = 8;     # the command, resolved once, when it has a name of its own
    F_XP_SIZE = 16;
}

# A `-exec` node for the `+` form: the command and its initial arguments are
# argv[lo..hi), and argv[hi] is the `{}` the batch replaces.
fn _f_execplus_new(lo, hi): i64 {
    var posix_max = ab_posix_max();
    if (posix_max < 0) {
        _f_report_usage("the environment is too large for exec()");
        syscall(SYS_EXIT, EXIT_FAILURE);
    }
    var b = ab_new(ab_default_buf(posix_max), ab_max_arg_count(posix_max));
    var i = lo;
    while (i < hi) {
        var tok = load64(_f_argv_flat + i * 8);
        var len = strlen(tok) + 1;
        if (ab_fits(b, len) == 0) {
            _f_report_usage("cannot fit single argument within argument list size limit");
            syscall(SYS_EXIT, EXIT_FAILURE);
        }
        ab_push(b, tok, len);
        i = i + 1;
    }
    ab_mark_initial(b);
    var st = alloc(F_XP_SIZE);
    store64(st + F_XP_AB, b);
    store64(st + F_XP_PATH, 0);
    return _f_node_new(F_N_EXECPLUS, lo, hi, st);
}

# What a spawn result means for find: 1 when the command ran and exited 0. The
# diagnostics are the same for both forms; `hard` = 1 (the `+` form) makes a
# non-zero exit fail the whole run, as POSIX asks.
fn _f_exec_outcome(r, name, hard): i64 {
    if (k_spawn_execfailed(r) == 1) {
        var e = k_spawn_exec_errno(r);
        if (errmsg_is_known(e) == 1) { errmsg_report("find", name, e); }
        else { report_note("find", name, "cannot execute"); }
        _f_any_failed = 1;
        return 0;
    }
    if (k_spawn_signalled(r) == 1) {
        # GNU says so, in both forms; kriya said nothing.
        var sb = alloc(40);
        memcpy(sb, "terminated by signal ", 21);
        var sn = str_u64_digits(k_spawn_signal(r), 10, 0, sb + 21);
        store8(sb + 21 + sn, 0);
        report_note("find", name, sb);
        _f_any_failed = 1;
        return 0;
    }
    if (k_spawn_exited(r) == 1) {
        if (k_spawn_exit_status(r) == 0) { return 1; }
        if (hard == 1) { _f_any_failed = 1; }
        return 0;
    }
    _f_any_failed = 1;
    return 0;
}

# Run the batch `st` holds, if it holds any path, and empty it.
fn _f_execplus_run(st): i64 {
    var b = load64(st + F_XP_AB);
    if (ab_pending(b) == 0) { return 0; }
    var argvp = ab_window(b, 0, ab_pending(b));
    var name = load64(argvp);
    # With no initial arguments the first PATH is the command (`-exec {} +`,
    # which GNU runs as written), so only a named command is resolved once.
    var exec_path = load64(st + F_XP_PATH);
    if (exec_path == 0) {
        exec_path = _f_resolve_exec(name);
        if (ab_init_argc(b) > 0) { store64(st + F_XP_PATH, exec_path); }
    }
    if (exec_path == 0) {
        report_note("find", name, "command not found");
        _f_any_failed = 1;
    } else {
        _f_exec_outcome(k_spawn_argv(exec_path, argvp, ab_envp(), 0), name, 1);
    }
    ab_clear(b);
    return 0;
}

# Add `path` to its batch, running the batch first when the path would not fit.
fn _f_execplus_add(st, path): i64 {
    var b = load64(st + F_XP_AB);
    var len = strlen(path) + 1;
    if (ab_fits(b, len) == 0) {
        if (ab_pending(b) == 0) {
            _f_report_usage("cannot fit single argument within argument list size limit");
            syscall(SYS_EXIT, EXIT_FAILURE);
        }
        _f_execplus_run(st);
    }
    if (ab_argc(b) == ab_max_count(b)) { _f_execplus_run(st); }
    ab_push(b, path, len);
    if (ab_argc(b) == ab_max_count(b)) { _f_execplus_run(st); }
    return 1;
}

# After the walk: every batch still holding paths runs, in expression order.
fn _f_flush_execs(n): i64 {
    var cur = n;
    var more: i64 = 1;
    while (more == 1) {
        if (cur == 0) { more = 0; }
        else {
            var k = load64(cur);
            if (k == F_N_AND || k == F_N_OR || k == F_N_COMMA) {
                _f_flush_execs(load64(cur + 8));
                cur = load64(cur + 16);
            } elif (k == F_N_NOT) { cur = load64(cur + 8); }
            elif (k == F_N_EXECPLUS) { _f_execplus_run(load64(cur + 24)); more = 0; }
            else { more = 0; }
        }
    }
    return 0;
}

# Thin wrapper over the shared resolver — see `fs_resolve_in_path` in
# `src/lib/fs.cyr`, which is also what `xargs` uses. This file used to carry a
# byte-identical 45-line copy of it, so the CWD-execution hole below had to be
# found and fixed twice.
# ⚠ Returns 0 when the command is not found. The caller MUST NOT pass that to
# exec — it reports the failure instead.
fn _f_resolve_exec(cmd): i64 {
    return fs_resolve_in_path(cmd, _f_path_env);
}

# Run -exec for `path`, with argv tokens at argv_flat[arg_lo..arg_hi).
# Returns 1 (exit 0) / 0 (anything else).
fn _f_run_exec(arg_lo, arg_hi, path): i64 {
    var args = vec_new();
    var i = arg_lo;
    while (i < arg_hi) {
        var tok = load64(_f_argv_flat + i * 8);
        # Substitute `{}` literally → path.
        var tlen = strlen(tok);
        var has_braces: i64 = 0;
        if (tlen == 2) {
            if (load8(tok) == 123 && load8(tok + 1) == 125) { has_braces = 1; }
        }
        if (has_braces == 1) {
            vec_push(args, path);
        } else {
            # Substring substitution: any `{}` inside the token is replaced
            # by the path. Common GNU idiom: `-exec sh -c 'foo {} bar' \;`.
            # We scan + rebuild.
            # ⛔ COUNT THE OCCURRENCES — DO NOT GUESS AT FOUR. The buffer used to be
            # sized `tlen + plen * 4`, which silently assumed at most four `{}` in
            # one token. A fifth ran the rebuild loop past the end of the
            # allocation. Demonstrated with
            # `find t -name f -exec echo '{}-{}-{}-{}-{}' \;`: kriya emitted four
            # copies of the path, a truncated fifth, and then bytes from the
            # ADJACENT HEAP OBJECT — its own cached PATH string — which went into
            # the argument handed to `execve`. That is a heap disclosure straight
            # into a child process's argv, plus corruption of kriya's own state.
            #
            # ⭐ The count makes the size EXACT, not merely bigger: each `{}` is two
            # bytes standing in for `plen`, so the result is `tlen + count*(plen-2)`.
            # That expression is also correct when `plen < 2` (a path like `.`),
            # where the output is SHORTER than the token.
            var count: i64 = 0;
            var k: i64 = 0;
            while (k + 1 < tlen) {
                if (load8(tok + k) == 123 && load8(tok + k + 1) == 125) {
                    count = count + 1;
                    k = k + 2;
                    continue;
                }
                k = k + 1;
            }
            if (count == 0) {
                vec_push(args, tok);
            } else {
                var plen = strlen(path);
                var out_cap = tlen + count * (plen - 2);
                var out = alloc(out_cap + 1);
                var oi: i64 = 0;
                var ki: i64 = 0;
                while (ki < tlen) {
                    if (ki + 1 < tlen) {
                        if (load8(tok + ki) == 123 && load8(tok + ki + 1) == 125) {
                            memcpy(out + oi, path, plen);
                            oi = oi + plen;
                            ki = ki + 2;
                            continue;
                        }
                    }
                    store8(out + oi, load8(tok + ki));
                    oi = oi + 1;
                    ki = ki + 1;
                }
                store8(out + oi, 0);
                vec_push(args, out);
            }
        }
        i = i + 1;
    }
    # PATH-resolve argv[0] since execve doesn't do it for us.
    # ⛔ A 0 here means NOT FOUND and must not reach execve: the kernel resolves a
    # slash-free name against the CURRENT DIRECTORY, so passing it through would
    # run whatever happens to sit in the tree being walked — an attacker-writable
    # location in the common `find /shared -exec` shape.
    var exec_path: i64 = 0;
    if (vec_len(args) > 0) {
        var first = vec_get(args, 0);
        exec_path = _f_resolve_exec(first);
        if (exec_path == 0) {
            k_write( 2, "kriya find: ", 12);
            k_write( 2, first, strlen(first));
            k_write( 2, ": command not found\n", 20);
            _f_any_failed = 1;
            return 0;
        }
        # ⛔ DO NOT write `resolved` back into args[0]. It is the EXEC TARGET,
        # not argv[0] — `execvp` resolves the name to decide what to run and
        # hands the child argv[0] exactly as written. Overwriting made every
        # child report itself by absolute path (`/usr/bin/rm:` where GNU says
        # `rm:`); see `k_spawn_as` in src/lib/spawn.cyr.
    }
    # ⛔ `k_spawn`, NOT stdlib `exec_env` — that one dup2s /dev/null onto fd 2, so
    # the child could not report anything. `find rot -name '*.tmp' -exec rm {} \;`
    # on an unwritable directory printed NOTHING and exited 0 while deleting
    # nothing; GNU prints a "Permission denied" line per file.
    var r = k_spawn_as(exec_path, args, ab_env());
    # POSIX: `-exec` is TRUE only when the utility exits 0.
    # ⚠ A command that could not run or was killed also makes find exit 1 — a
    # kriya decision: GNU says so and exits 0 in this `;` form.
    return _f_exec_outcome(r, vec_get(args, 0), 0);
}

# Evaluate AST node `n` for the given entry context.
# ctx layout:
#   0  path (cstr)
#   8  name (cstr)
#   16 stat_buf ptr
#   24 depth (i64)
# The operators, in a loop down the right spine (see `_f_chain`), recursing only
# into left children. A `!` on the way flips the value the rest produces: under
# `-a` a false left side IS the value, under `-o` a true one is, and past either
# the value is the right side's — so one parity bit carries every `!` above.
fn _f_eval(n, ctx): i64 {
    if (n == 0) { return 1; }
    var cur = n;
    var neg: i64 = 0;
    var result: i64 = 0 - 1;
    while (result < 0) {
        var k = load64(cur);
        if (k == F_N_NOT) { neg = 1 - neg; cur = load64(cur + 8); }
        elif (k == F_N_AND) {
            if (_f_eval(load64(cur + 8), ctx) == 0) { result = 0; }
            else { cur = load64(cur + 16); }
        } elif (k == F_N_OR) {
            if (_f_eval(load64(cur + 8), ctx) == 1) { result = 1; }
            else { cur = load64(cur + 16); }
        } elif (k == F_N_COMMA) {
            _f_eval(load64(cur + 8), ctx);
            cur = load64(cur + 16);
        } else {
            result = _f_eval_leaf(cur, ctx);
        }
    }
    if (neg == 1) { return 1 - result; }
    return result;
}

# 1 for the tests that need the entry's stat: GNU's `need_stat` / `need_type`.
# ⚠ -prune is one of them only without -depth, where it has to know a directory.
fn _f_needs_stat(k): i64 {
    if (k == F_N_TYPE || k == F_N_SIZE || k == F_N_MTIME || k == F_N_MMIN) { return 1; }
    if (k == F_N_EMPTY || k == F_N_NEWER || k == F_N_PERM) { return 1; }
    if (k == F_N_UID || k == F_N_GID || k == F_N_NOUSER || k == F_N_NOGROUP) { return 1; }
    if (k == F_N_PRUNE) {
        if (_f_depth_first == 0) { return 1; }
    }
    return 0;
}

fn _f_eval_leaf(n, ctx): i64 {
    var k = load64(n);
    if (k == F_N_TRUE) { return 1; }
    # ⛔ AN ENTRY THAT COULD NOT BE STAT'D IS STILL EVALUATED, below a starting
    # point: its name is known, its metadata is not. A test that needs the stat is
    # FALSE — silently, since the walk already reported the failure — and one that
    # does not is answered as usual. GNU's FTS_NS; kriya skipped the entry, so
    # `find -L t` did not list a link into an unsearchable directory (1.7.1).
    if (_f_nostat == 1) {
        if (_f_needs_stat(k) == 1) { return 0; }
    }

    var path = load64(ctx + 0);
    var name = load64(ctx + 8);
    var st   = load64(ctx + 16);
    var depth = load64(ctx + 24);

    if (k == F_N_NAME) {
        var pat = load64(n + 8);
        var plen = load64(n + 16);
        return _f_glob_match(pat, plen, name, strlen(name));
    }
    if (k == F_N_REGEX) {
        # ⭐ Whole path, anchored at both ends. niyama's search finds an
        # unanchored match, so a full-length match is required explicitly —
        # `-regex 'aab'` must NOT match `./aab.c`, which is what GNU does.
        var subj = path;
        var slen = strlen(subj);
        var fold = load64(n + 16);
        if (fold == 1) {
            if (load64(n + 24) == F_RX_BRE) {
                var fb = alloc(slen + 1);
                _f_fold_bytes(subj, fb, slen);
                subj = fb;
            }
        }
        var nfa = load64(n + 8);
        if (load64(n + 24) == F_RX_ERE) {
            var rp = niyama_re2_search_at(nfa, subj, slen, 0);
            if (rp != 0) { return 0; }
            if (niyama_re2_group_end(nfa, 0) != slen) { return 0; }
            return 1;
        }
        var bp = niyama_bre_search_at(nfa, subj, slen, 0);
        if (bp != 0) { return 0; }
        if (niyama_bre_group_end(nfa, 0) != slen) { return 0; }
        return 1;
    }
    if (k == F_N_TYPE)   { return _f_eval_type_predicate(load64(n + 8), st); }
    if (k == F_N_SIZE)   { return _f_eval_size_predicate(load64(n + 8), load64(n + 16), load64(n + 24),
          load64(st + 48)); }
    if (k == F_N_MTIME)  { return _f_eval_mtime_predicate(load64(n + 8), load64(n + 16), load64(st + 88)); }
    if (k == F_N_MMIN)   { return _f_eval_mmin_predicate (load64(n + 8), load64(n + 16), load64(st + 88)); }
    if (k == F_N_EMPTY)  { return _f_eval_empty_predicate(path, st, depth); }
    if (k == F_N_PERM)   { return _f_eval_perm_predicate(load64(n + 8), load64(n + 16), load64(n + 24), st); }
    if (k == F_N_PRUNE) {
        # POSIX: always true, and no effect under -depth, where the entries are
        # already done by the time their directory is evaluated.
        if (_f_depth_first == 0) {
            if ((load64(st + 24) & FS_S_IFMT) == FS_S_IFDIR) { _f_prune_hit = 1; }
        }
        return 1;
    }
    if (k == F_N_NEWER)  {
        # ⛔ TO THE NANOSECOND, as GNU's `timespec_cmp` compares. Whole seconds
        # made `touch stamp; make; find . -newer stamp` miss everything written
        # in stamp's own second — at exit 0 (1.7.1).
        var fsec = load64(st + FS_STAT_MTIME);
        if (fsec > load64(n + 8)) { return 1; }
        if (fsec < load64(n + 8)) { return 0; }
        if (load64(st + FS_STAT_MTIME_NSEC) > load64(n + 16)) { return 1; }
        return 0;
    }
    if (k == F_N_UID) {
        return _f_cmp_num(load64(n + 16), load64(n + 8), load64(st + 28) & 4294967295);
    }
    if (k == F_N_GID) {
        return _f_cmp_num(load64(n + 16), load64(n + 8), load64(st + 32) & 4294967295);
    }
    if (k == F_N_NOUSER) {
        if (userdb_user_name(load64(st + 28) & 4294967295) == 0) { return 1; }
        return 0;
    }
    if (k == F_N_NOGROUP) {
        if (userdb_group_name(load64(st + 32) & 4294967295) == 0) { return 1; }
        return 0;
    }
    if (k == F_N_PRINT) {
        k_write( 1, path, strlen(path));
        var nl[2]; store8(&nl, 10);
        k_write( 1, &nl, 1);
        return 1;
    }
    if (k == F_N_PRINT0) {
        k_write( 1, path, strlen(path));
        var nz[2]; store8(&nz, 0);
        k_write( 1, &nz, 1);
        return 1;
    }
    if (k == F_N_EXECPLUS) {
        return _f_execplus_add(load64(n + 24), path);
    }
    if (k == F_N_EXEC) {
        return _f_run_exec(load64(n + 8), load64(n + 16), path);
    }
    return 0;
}

# --- Walk -------------------------------------------------------------

# 1 when the walk follows a symlink at `depth`: always under -L, at the starting
# points under -H, never under -P.
fn _f_follows(depth): i64 {
    if (_f_follow_mode == 1) { return 1; }
    if (_f_follow_mode == 2) {
        if (depth == 0) { return 1; }
    }
    return 0;
}

# Stat `path` as -P, -H or -L says for `depth` — GNU's `optionp_stat`,
# `optionh_stat` and `optionl_stat`, the stat its TESTS use (`-newer`'s reference
# here). A link that cannot be followed because it is dangling (ENOENT) or runs
# through a non-directory (ENOTDIR) answers as the link itself (`fallback_stat`).
fn _f_xstat(path, depth, buf): i64 {
    if (_f_follows(depth) == 0) { return fs_lstat_at(0 - 100, path, buf); }
    var r = fs_fstatat(0 - 100, path, buf, 0);
    if (r == (0 - 2))  { return fs_lstat_at(0 - 100, path, buf); }
    if (r == (0 - 20)) { return fs_lstat_at(0 - 100, path, buf); }
    return r;
}

# The name -name tests: the last component, with a starting point's trailing
# slashes left off, as GNU's `base_name` + `strip_trailing_slashes` leave them —
# `t/` is `t`, `./` is `.`, and `/` and `//` are `/`.
# ⛔ `find dir/ -name dir` matched nothing, because the name was the empty string
# after the slash — and so `find dir/ -name dir -prune -o -print` listed the tree
# it was told to prune (1.7.1). Only a starting point can end in a slash; the walk
# builds every other path.
fn _f_name_of(path): i64 {
    var len = strlen(path);
    var end = len;
    var more: i64 = 1;
    while (more == 1) {
        if (end <= 1) { more = 0; }
        elif (load8(path + end - 1) != 47) { more = 0; }
        else { end = end - 1; }
    }
    var p = path;
    if (end < len) {
        p = alloc(end + 1);
        memcpy(p, path, end);
        store8(p + end, 0);
    }
    var b = path_basename_ptr(p);
    if (b == 0) { return p; }
    if (load8(b) == 0) { return p; }
    return b;
}

# Evaluate the expression for one entry, when it is deep enough to be looked at.
# ⛔ THE PRUNE FLAG IS CLEARED FIRST, EVEN FOR AN ENTRY ABOVE -mindepth. Cleared
# only on the way to `_f_eval`, it survived from the last entry evaluated to the
# next one that was not — so `find a b -mindepth 1 -name x -prune -o -print`,
# with `a/x` the last entry under `a`, never entered `b` at all.
fn _f_visit(ctx, depth): i64 {
    _f_prune_hit = 0;
    if (depth < _f_mindepth) { return 0; }
    _f_eval(_f_ast, ctx);
    return 0;
}

fn _f_walk(path, depth): i64 {
    # The WALK's stat, which is fts's rather than the tests': a dangling link
    # (ENOENT) is the link itself, silently, and any other failure is reported.
    # ⛔ BELOW A STARTING POINT, AN ENTRY THAT CANNOT BE STAT'D IS STILL EVALUATED,
    # as GNU does (FTS_NS): reported once, exit 1, its name tested and its
    # metadata unknown (`_f_nostat`). A link through a non-directory (ENOTDIR,
    # `l -> file/x`) is the one exception to "unknown": GNU's tests fall back to
    # the link's own stat, so `-type l` is true of it. ELOOP is a loop and is not
    # evaluated; neither is a starting point. kriya skipped every such entry, so
    # `find -L t` did not list a link into an unsearchable directory (1.7.1).
    var st_buf = alloc(144);
    var r: i64 = 0;
    var follows = _f_follows(depth);
    if (follows == 1) {
        r = fs_fstatat(0 - 100, path, st_buf, 0);
        if (r == (0 - 2)) { r = fs_lstat_at(0 - 100, path, st_buf); }
    } else {
        r = fs_lstat_at(0 - 100, path, st_buf);
    }
    var nostat: i64 = 0;
    if (r < 0) {
        _f_report_path(path, 0 - r);
        _f_any_failed = 1;
        if (depth == 0) { return 0; }
        if (r == (0 - 40)) { return 0; }
        if (r == (0 - 20)) {
            if (follows == 1) { r = fs_lstat_at(0 - 100, path, st_buf); }
        }
        if (r < 0) {
            nostat = 1;
            var z: i64 = 0;
            while (z < 144) { store8(st_buf + z, 0); z = z + 1; }
        }
    }
    # ⛔ 32, NOT 4. A FUNCTION-LOCAL `var X[N]` IS N BYTES — the ×8 u64 unit applies only at module
    # scope. This held four i64 fields in a 4-byte slot and smashed 24 bytes of neighbouring stack.
    # It was SILENT for a year: the old register allocator happened to leave dead space there. The
    # cyrius 6.5.x codegen-quality work repacked the frame, the overflow started landing on live
    # state, and `find` regressed from 40/40 to 8/40 — it printed the root and never descended,
    # because the clobber reached the very `st_buf` the is-a-directory test reads.
    # ⚠ The unit rule is non-uniform enough to be worth MEASURING rather than assuming; measured
    # here at 6.5.18 with a two-local probe (`&b - &a` = 8 for `var x[4]`).
    var ctx[32];
    store64(&ctx + 0,  path);
    store64(&ctx + 8,  _f_name_of(path));
    store64(&ctx + 16, st_buf);
    store64(&ctx + 24, depth);

    var descend: i64 = 0;
    if ((load64(st_buf + 24) & FS_S_IFMT) == FS_S_IFDIR) { descend = 1; }
    # ⛔ -L: A DIRECTORY THE WALK IS ALREADY INSIDE IS A LOOP. `find -L` over a
    # link to an ancestor went forty levels deep — until the path held forty
    # links and the kernel said ELOOP — listing the same tree forty times where
    # GNU names the loop and goes on (1.7.1). GNU does not evaluate the entry
    # either. ⚠ -P and -H cannot loop: nothing below a starting point is followed.
    # ⚠ An inode of 0 is agnos saying "no inode" (FAT), not an inode to compare.
    if (descend == 1) {
        if (_f_follow_mode == 1) {
            if (fs_ino(st_buf) != 0) {
                if (fs_dirstack_has(_f_walk_path, fs_dev(st_buf), fs_ino(st_buf)) == 1) {
                    report_note("find", path, "file system loop detected");
                    _f_any_failed = 1;
                    return 0;
                }
            }
        }
    }
    if (_f_maxdepth >= 0) {
        if (depth >= _f_maxdepth) { descend = 0; }
    }

    if (nostat == 1) {
        # Its type is unknown, so it is not entered — GNU's `state.type` of 0.
        _f_nostat = 1;
        _f_visit(&ctx, depth);
        _f_nostat = 0;
        return 0;
    }
    if (_f_depth_first == 0) {
        _f_visit(&ctx, depth);
        if (_f_prune_hit == 1) { descend = 0; }
        if (descend == 1) { _f_descend(path, depth, st_buf); }
        return 0;
    }
    # -depth: the entries first. ⚠ An unreadable directory is still evaluated
    # after its error, as GNU's -depth does; without -depth it already was.
    if (descend == 1) { _f_descend(path, depth, st_buf); }
    _f_visit(&ctx, depth);
    return 0;
}

# Walk the entries of the directory `path`, whose stat is `st_buf`.
fn _f_descend(path, depth, st_buf): i64 {
    var open_flags: i64 = FS_O_DIRECTORY;  # | O_RDONLY
    if (_f_follows(depth) == 0) { open_flags = open_flags | FS_O_NOFOLLOW; }
    var dfd = fs_openat(0 - 100, path, open_flags, 0);
    if (dfd < 0) {
        _f_report_path(path, 0 - dfd);
        _f_any_failed = 1;
        return 0;
    }
    # ⛔ A push that fails leaves the ancestor unrecorded, which is exactly what a
    # loop needs to go unnoticed — so do not descend (`fs_dirstack_push`).
    var pushed: i64 = 0;
    if (_f_follow_mode == 1) {
        if (fs_dirstack_push(_f_walk_path, fs_dev(st_buf), fs_ino(st_buf)) != 0) {
            report_note("find", path, "cannot track directory depth: out of memory");
            _f_any_failed = 1;
            fs_close(dfd);
            return 0;
        }
        pushed = 1;
    }
    var dbuf = alloc(4096);
    var loop: i64 = 1;
    while (loop == 1) {
        var nb = fs_getdents64(dfd, dbuf, 4096);
        if (nb < 0) {
            if ((0 - nb) == 4) {
                # EINTR retry
            } else {
                _f_report_path(path, 0 - nb);
                _f_any_failed = 1;
                loop = 0;
            }
        } else {
            if (nb == 0) { loop = 0; }
            else {
                var off: i64 = 0;
                while (off < nb) {
                    var ent = dbuf + off;
                    var reclen = fs_dent_reclen(ent);
                    var ename = fs_dent_name(ent);
                    if (fs_dent_is_dotdot(ent) == 0) {
                        var elen = strlen(ename);
                        var plen = strlen(path);
                        var sep: i64 = 1;
                        if (plen > 0) {
                            if (load8(path + plen - 1) == 47) { sep = 0; }
                        }
                        var sub = alloc(plen + sep + elen + 1);
                        memcpy(sub, path, plen);
                        if (sep == 1) { store8(sub + plen, 47); }
                        memcpy(sub + plen + sep, ename, elen);
                        store8(sub + plen + sep + elen, 0);
                        _f_walk(sub, depth + 1);
                    }
                    off = off + reclen;
                }
            }
        }
    }
    if (pushed == 1) { fs_dirstack_pop(_f_walk_path); }
    fs_close(dfd);
    return 0;
}

# --- Entry point ------------------------------------------------------

fn cmd_find(start: i64): i64 {
    _f_init_spec();
    find_help_declare();
    help_if_requested(_find_spec, start);
    # find DOES NOT go through the standard flags parser — its expression
    # grammar uses tokens like `-type` / `-name` that would be rejected
    # as unknown options. Instead we walk argv directly: -L / -H / -P
    # may appear as the first one or two tokens, then start paths, then
    # the expression.
    _f_now_secs = clock_epoch_secs();
    _f_any_failed = 0;
    _f_err = 0;
    _f_err_msg = 0;
    _f_follow_mode = 0;
    _f_maxdepth = 0 - 1;
    _f_mindepth = 0;
    _f_depth_first = 0;
    _f_prune_hit = 0;
    _f_walk_path = 0;
    _f_nostat = 0;
    _f_nest = 0;
    _f_nest_cap = _f_nest_max();
    _f_regextype = F_RX_BRE;
    # Snapshot PATH up-front, once, for every `-exec`. ⚠ It began as a
    # workaround: the stdlib `getenv` read /proc/self/environ into a stack
    # buffer on every call, which came back empty after a fork+exec+waitpid
    # cycle. Since cyrius 6.5.36 it reads once into a heap cache, so the
    # snapshot is only the cheaper way to ask.
    _f_path_env = getenv("PATH");

    var total = kriya_argv_count();
    # Build a private flat argv view of argv[start..].
    var slice_n = total - start;
    if (slice_n < 0) { slice_n = 0; }
    _f_argv_flat = alloc(slice_n * 8);
    _f_argv_n = slice_n;
    var fi: i64 = 0;
    while (fi < slice_n) {
        store64(_f_argv_flat + fi * 8, kriya_arg(start + fi));
        fi = fi + 1;
    }

    # Pre-expression flags: -L / -H / -P (zero, one, or more, last wins).
    var head: i64 = 0;
    var consumed_head: i64 = 1;
    while (consumed_head == 1) {
        consumed_head = 0;
        if (head < _f_argv_n) {
            var t0 = load64(_f_argv_flat + head * 8);
            # ⚠ The spec decides WHETHER a leading token is one of the three
            # pre-expression flags; this walk decides what each MEANS, because
            # they set a mode rather than a boolean. Adding a fourth is a spec
            # row plus one arm here, and `--help` needs no separate edit.
            var t0len = strlen(t0);
            var is_pre: i64 = 0;
            if (t0len == 2) {
                if (load8(t0) == 45) {
                    if (kriya_short_type(_find_spec, load8(t0 + 1)) >= 0) { is_pre = 1; }
                }
            }
            # `--` ends the leading options, as in GNU: `find -- "$dir"` (1.7.1).
            if (streq(t0, "--") == 1) { head = head + 1; }
            elif (is_pre == 0) { consumed_head = 0; }
            elif (streq(t0, "-L") == 1) { _f_follow_mode = 1; head = head + 1; consumed_head = 1; }
            elif (streq(t0, "-P") == 1) { _f_follow_mode = 0; head = head + 1; consumed_head = 1; }
            elif (streq(t0, "-H") == 1) { _f_follow_mode = 2; head = head + 1; consumed_head = 1; }
        }
    }

    # Split start paths vs expression. Start paths are leading argv
    # tokens that don't look like predicates / operators. Once we hit
    # an arg starting with `-`, `!`, or `(`, the expression begins.
    # ⛔ FLAG + CONTINUE, NOT `break` — this loop declares `var t` and `var c0`,
    # and CLAUDE.md's hard rule is that `break` inside a `while` that declares a
    # `var` is unreliable: Cyrius hoists the declaration to the enclosing loop,
    # and whether the exit path is correct depends on frame layout. ⚠ It WORKED
    # at every pin up to 6.5.36 — measured — which is exactly why it survived:
    # the watchlist recorded "zero instances" while four sat here, because the
    # detection had been run by eye rather than mechanically.
    var expr_start: i64 = head;
    var scanning: i64 = 1;
    while (scanning == 1) {
        if (expr_start >= _f_argv_n) { scanning = 0; }
        else {
            var t = load64(_f_argv_flat + expr_start * 8);
            var c0 = load8(t);
            var stop: i64 = 0;
            # GNU's `looks_like_expression(arg, leading)`: `-X…` and a bare `!` or
            # `(` start the expression. A bare `-` is a file, and so are `)` and `,`
            # among the starting points (1.7.1; `)` and `-` were usage errors).
            if (c0 == 45) { if (load8(t + 1) != 0) { stop = 1; } }
            if (c0 == 33) { if (load8(t + 1) == 0) { stop = 1; } }
            if (c0 == 40) { if (load8(t + 1) == 0) { stop = 1; } }
            if (stop == 1) { scanning = 0; }
            else { expr_start = expr_start + 1; }
        }
    }

    var start_paths = vec_new();
    var sp: i64 = head;
    while (sp < expr_start) {
        vec_push(start_paths, load64(_f_argv_flat + sp * 8));
        sp = sp + 1;
    }
    if (vec_len(start_paths) == 0) { vec_push(start_paths, "."); }

    _f_pos = expr_start;
    if (_f_pos >= _f_argv_n) {
        _f_ast = _f_node_new(F_N_PRINT, 0, 0, 0);
    } else {
        _f_ast = _f_parse_list();
        if (_f_err == 1) {
            _f_report_usage(_f_err_msg);
            return EXIT_USAGE;
        }
        if (_f_pos != _f_argv_n) {
            _f_report_usage("trailing tokens after expression (missing operator?)");
            return EXIT_USAGE;
        }
        # If the user wrote no action, GNU implicitly appends -print
        # in an AND with the expression.
        if (_f_has_action(_f_ast) == 0) {
            _f_ast = _f_node_new(F_N_AND, _f_ast, _f_node_new(F_N_PRINT, 0, 0, 0), 0);
        }
    }

    if (_f_follow_mode == 1) { _f_walk_path = fs_dirstack_new(); }

    var npaths = vec_len(start_paths);
    var pi: i64 = 0;
    while (pi < npaths) {
        var p = vec_get(start_paths, pi);
        _f_walk(p, 0);
        pi = pi + 1;
    }
    _f_flush_execs(_f_ast);

    if (_f_any_failed == 1) { return EXIT_FAILURE; }
    return EXIT_SUCCESS;
}

# Help/introspection record for `find`. ⭐ Split out so `kriya --list` can
# populate it WITHOUT running the utility — one declaration feeding `--help`,
# `--help=json` and `--list` alike.
fn find_help_declare(): i64 {
    help_begin("find", "Walk a file tree and evaluate predicates.",
      "find [STARTPATH...] [EXPRESSION]");
    help_positional(0, HELP_POS_UNBOUNDED, "STARTPATH,EXPRESSION");
    help_destructive(1);
    help_operands("Predicates combine with !, -a, -o and GNU's `,` (both sides run; the value is the right one's); parentheses group. The default action is -print. -maxdepth, -mindepth and -depth are global: they apply to the whole walk wherever they are written. -prune stops the walk entering a directory, and has no effect under -depth. -perm takes a mode as chmod does, octal or symbolic: MODE is exactly those bits, -MODE all of them, /MODE any of them. Numbers take +N (more than) and -N (less than). Symlinks are not followed unless -L is given; -H follows only the starting points (ADR 0003). ⚠ -regex/-iregex match the WHOLE PATH as written (leading `./` included) and default to POSIX BRE — GNU defaults to EMACS regex, where an unescaped `+` is a quantifier rather than a literal. Use -regextype posix-extended for `+`/`?`; -regextype emacs is refused by name (ADR 0005). `-exec CMD {} +` runs CMD once per batch of paths, as many as fit in 131,072 bytes, as GNU does; it is always true, and a CMD that fails makes find exit 1.");  #skip-lint
    help_exit(1, "an entry could not be read, -exec reported failure, or -L found a loop");
    help_example("find . -name '*.log'");
    help_example("find /var -type f -size +1M");
    help_example("find . -name .git -prune -o -type f -print");
    help_example("find /usr/bin -perm -4000");
    help_example("find . -name '*.tmp' -exec rm {} ';'");
    help_example("find . -name '*.o' -exec rm -- {} +");
    return 0;
}
