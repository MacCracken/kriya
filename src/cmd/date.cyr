# date — POSIX `date(1)`: print the current time, optionally
# strftime-formatted.
#
# Argument shape:
#   date [-u] [-d STRING] [+FORMAT]
#
# Flags:
#   -u / --utc / --universal   force UTC. At v0.7.0 this is a no-op:
#                              kriya date ALWAYS prints UTC because
#                              tzfile parsing (/etc/localtime, TZ env
#                              with POSIX-style offset rules) is a
#                              multi-hundred-LOC follow-up not in M6 (roadmap: Gated — Upstream chrono)
#                              scope. The flag is accepted so scripts
#                              that pass it work; it's just the default.
#
#   -d / --date=STRING         the time STRING describes, not now: GNU's free-form
#                              dates (`2024-01-15 10:30`, `@1700000000`, `1 day ago`,
#                              `next friday`), in UTC — src/lib/datetime.cyr (1.9.3,
#                              ADR 0035). The last -d wins. An invalid STRING exits 2.
#
# Operand:
#   +FORMAT                    strftime-style format string. Without
#                              `+FORMAT` the default is GNU's:
#                              `%a %b %_d %H:%M:%S %Z %Y`.
#
# Local-time defer: GNU `date` defaults to local time. kriya `date`
# defaults to UTC at v0.7.0. The deviation is documented in --help
# (when --help ships) and here. Tzfile-aware operation lands behind
# a known follow-up; until then UTC is the floor that requires no (roadmap: Gated — Upstream chrono)
# external state.
#
# strftime specifiers shipped (cell-by-cell against GNU under TZ=UTC):
#   %Y  year, 4 digits           %y  year, 2 digits (yy)
#   %m  month, 01-12             %d  day-of-month, 01-31
#   %e  day-of-month, space-pad  %_d like %e (GNU pad-flag form)
#   %H  hour, 00-23              %I  hour, 01-12
#   %M  minute, 00-59            %S  second, 00-60
#   %p  AM/PM                    %P  am/pm
#   %j  day-of-year, 001-366
#   %u  weekday 1=Mon..7=Sun     %w  weekday 0=Sun..6=Sat
#   %a  short weekday (Mon)      %A  full weekday (Monday)
#   %b / %h short month (Jan)    %B  full month (January)
#   %Z  timezone name (UTC)      %z  timezone offset (+0000)
#   %s  epoch seconds            %N  nanoseconds (since 1.9.3; nine zeros before)
#   %T  same as %H:%M:%S         %R  same as %H:%M
#   %D  same as %m/%d/%y         %F  same as %Y-%m-%d
#   %%  literal %                %n  newline           %t  tab
#
# A specifier GNU defines and kriya does not render (`%V`, `%c`, `%C`, …) is
# REFUSED by name: the field is left out, the rest prints, exit 1. A byte that
# is not a specifier at all (`%@`) is echoed verbatim, as GNU does.
#
# ⛔ A DIRECTIVE IS `%` [flags `_-0^#+`] [width] [`E`|`O`] [`:`…] CONVERSION, and
# kriya renders only the bare form, plus `%_d`. GNU renders every decorated form
# of a conversion it defines, so until 1.8.5 `date +%-d` printed the three bytes
# `%-d` at exit 0. A decorated conversion is refused now, and a decorated
# NON-conversion is echoed — except where GNU's echo is not the bytes (it pads
# to a width and uppercases under `^`), which is refused too. ⚠ Two refusals
# where GNU prints the echo, both deliberate until roadmap 1.9.4 renders the
# forms: an `E`/`O` on a conversion GNU does not take it on (`%Ea`; the set moved
# between 9.7 and 9.12), and a width no wider than an invalid directive's echo.

var _date_weekday_short: i64 = 0;   # lazy-init 7×4-byte cstrs ("Mon"...)
var _date_weekday_full:  i64 = 0;
var _date_month_short:   i64 = 0;   # 12×4-byte ("Jan"...)
var _date_month_full:    i64 = 0;

fn _date_init_names(): i64 {
    if (_date_weekday_short != 0) { return 0; }
    var ws = alloc(7 * 8);
    store64(ws + 0,  "Sun");
    store64(ws + 8,  "Mon");
    store64(ws + 16, "Tue");
    store64(ws + 24, "Wed");
    store64(ws + 32, "Thu");
    store64(ws + 40, "Fri");
    store64(ws + 48, "Sat");
    _date_weekday_short = ws;
    var wf = alloc(7 * 8);
    store64(wf + 0,  "Sunday");
    store64(wf + 8,  "Monday");
    store64(wf + 16, "Tuesday");
    store64(wf + 24, "Wednesday");
    store64(wf + 32, "Thursday");
    store64(wf + 40, "Friday");
    store64(wf + 48, "Saturday");
    _date_weekday_full = wf;
    var ms = alloc(12 * 8);
    store64(ms + 0,   "Jan");
    store64(ms + 8,   "Feb");
    store64(ms + 16,  "Mar");
    store64(ms + 24,  "Apr");
    store64(ms + 32,  "May");
    store64(ms + 40,  "Jun");
    store64(ms + 48,  "Jul");
    store64(ms + 56,  "Aug");
    store64(ms + 64,  "Sep");
    store64(ms + 72,  "Oct");
    store64(ms + 80,  "Nov");
    store64(ms + 88,  "Dec");
    _date_month_short = ms;
    var mf = alloc(12 * 8);
    store64(mf + 0,   "January");
    store64(mf + 8,   "February");
    store64(mf + 16,  "March");
    store64(mf + 24,  "April");
    store64(mf + 32,  "May");
    store64(mf + 40,  "June");
    store64(mf + 48,  "July");
    store64(mf + 56,  "August");
    store64(mf + 64,  "September");
    store64(mf + 72,  "October");
    store64(mf + 80,  "November");
    store64(mf + 88,  "December");
    _date_month_full = mf;
    return 0;
}

# Write a 2-digit zero-padded value at buf+pos. Returns pos+2.
fn _date_w2(buf, pos, val): i64 {
    store8(buf + pos, 48 + val / 10);
    store8(buf + pos + 1, 48 + val % 10);
    return pos + 2;
}

# Write a 2-digit space-padded value at buf+pos. Returns pos+2.
fn _date_w2_sp(buf, pos, val): i64 {
    var tens = val / 10;
    if (tens == 0) {
        store8(buf + pos, 32);
    } else {
        store8(buf + pos, 48 + tens);
    }
    store8(buf + pos + 1, 48 + val % 10);
    return pos + 2;
}

fn _date_w3(buf, pos, val): i64 {
    store8(buf + pos, 48 + val / 100);
    store8(buf + pos + 1, 48 + (val / 10) % 10);
    store8(buf + pos + 2, 48 + val % 10);
    return pos + 3;
}

fn _date_w4(buf, pos, val): i64 {
    store8(buf + pos, 48 + val / 1000);
    store8(buf + pos + 1, 48 + (val / 100) % 10);
    store8(buf + pos + 2, 48 + (val / 10) % 10);
    store8(buf + pos + 3, 48 + val % 10);
    return pos + 4;
}

# A year as glibc's `%Y` writes it: at least four characters, a minus sign counted among them,
# so -1 is `-001` and 10000 is `10000` (1.9.3: `date -d` reaches any year). With `plus` (glibc's
# `%+4Y`, inside `%F`), a year past four digits takes a `+`: `+10000`.
fn _date_wyear(buf, pos, y, plus): i64 {
    var p = pos;
    var mag = y;
    var width: i64 = 4;
    if (y < 0) {
        store8(buf + p, 45);
        p = p + 1;
        mag = 0 - y;
        width = 3;
    } elif (plus == 1) {
        if (y > 9999) {
            store8(buf + p, 43);
            p = p + 1;
        }
    }
    var tmp[24];
    var k: i64 = 0;
    if (mag == 0) { store8(&tmp, 48); k = 1; }
    while (mag > 0) {
        store8(&tmp + k, 48 + mag % 10);
        mag = mag / 10;
        k = k + 1;
    }
    while (k < width) {
        store8(&tmp + k, 48);
        k = k + 1;
    }
    while (k > 0) {
        k = k - 1;
        store8(buf + p, load8(&tmp + k));
        p = p + 1;
    }
    return p;
}

# glibc's `%y`: the last two digits of the year's magnitude.
fn _date_y2(y): i64 {
    if (y < 0) { return (0 - y) % 100; }
    return y % 100;
}

# The nanoseconds `%N` prints: 0 unless `-d` gave a fraction (1.9.3).
var _date_nsec = 0;

# Append a null-terminated string to buf at pos. Returns new pos.
fn _date_wstr(buf, pos, s): i64 {
    var i: i64 = 0;
    while (load8(s + i) != 0) {
        store8(buf + pos + i, load8(s + i));
        i = i + 1;
    }
    return pos + i;
}

# Append signed decimal at buf+pos. Returns new pos.
fn _date_wint(buf, pos, v): i64 {
    var p = pos;
    if (v < 0) {
        store8(buf + p, 45);
        p = p + 1;
        v = 0 - v;
    }
    var tmp[24];
    var k: i64 = 0;
    if (v == 0) {
        store8(&tmp, 48);
        k = 1;
    } else {
        while (v > 0) {
            store8(&tmp + k, 48 + (v - (v / 10) * 10));
            v = v / 10;
            k = k + 1;
        }
    }
    while (k > 0) {
        k = k - 1;
        store8(buf + p, load8(&tmp + k));
        p = p + 1;
    }
    return p;
}

# Render a single conversion spec `c` into buf at pos. `parts` is
# `kdt_civil`'s record; `wkday` is 0..6 (Sun..Sat); `epoch` is
# raw seconds. Returns the new buf offset.
# Set when the format asked for a specifier kriya cannot render.
var _date_bad: i64 = 0;

# strftime specifiers GNU defines that kriya does not render yet. ⚠ All but the
# locale four are pure arithmetic on a broken-down time and need no tzfile, so
# they are roadmap 1.9.4 rather than the Gated chrono item local time waits on.
# ⛔ `%C %k %l %U %W` were missing from this list until 1.8.5 and echoed at
# exit 0, found by sweeping every byte after `%` against GNU.
fn _date_is_deferred_spec(c): i64 {  #skip-lint
    if (c == 86) { return 1; }   # V  ISO week number
    if (c == 71) { return 1; }   # G  ISO week-based year
    if (c == 103) { return 1; }  # g  ISO week-based year, 2-digit
    if (c == 99) { return 1; }   # c  locale date and time
    if (c == 120) { return 1; }  # x  locale date
    if (c == 88) { return 1; }   # X  locale time
    if (c == 114) { return 1; }  # r  locale 12-hour time
    if (c == 113) { return 1; }  # q  quarter
    if (c == 67) { return 1; }   # C  century
    if (c == 107) { return 1; }  # k  hour, space-padded
    if (c == 108) { return 1; }  # l  12-hour hour, space-padded
    if (c == 85) { return 1; }   # U  week number, Sunday first
    if (c == 87) { return 1; }   # W  week number, Monday first
    return 0;
}

# Every conversion letter GNU `date` renders — the same on 9.4, 9.7 and 9.12,
# measured by sweeping every byte after `%`.
fn _date_is_conv(c): i64 {
    var s = "abcdeghjklmnpqrstuwxyzABCDFGHIMNPRSTUVWXYZ";
    var j: i64 = 0;
    var hit: i64 = 0;
    while (load8(s + j) != 0) {
        if (load8(s + j) == c) { hit = 1; }
        j = j + 1;
    }
    return hit;
}

# The directive scanned last by `_date_scan_directive`.
var _dd_caret = 0;    # a `^` among the flags
var _dd_width = 0;    # width digits present
var _dd_colons = 0;   # `:` count before the conversion

# Scan the directive whose `%` is at `src + i`: flags, width, one `E`/`O`, then
# colons. Returns the index of the conversion byte, which may be the NUL.
fn _date_scan_directive(src, i): i64 {
    _dd_caret = 0;
    _dd_width = 0;
    _dd_colons = 0;
    var j = i + 1;
    var more: i64 = 1;
    while (more == 1) {
        var fc = load8(src + j);
        more = 0;
        if (fc == 95) { more = 1; }   # _
        if (fc == 45) { more = 1; }   # -
        if (fc == 48) { more = 1; }   # 0
        if (fc == 94) { more = 1; _dd_caret = 1; }   # ^
        if (fc == 35) { more = 1; }   # #
        if (fc == 43) { more = 1; }   # +
        if (more == 1) { j = j + 1; }
    }
    var digit: i64 = 1;
    while (digit == 1) {
        var dc = load8(src + j);
        digit = 0;
        if (dc >= 48) { if (dc <= 57) { digit = 1; } }
        if (digit == 1) {
            _dd_width = 1;
            j = j + 1;
        }
    }
    return _date_scan_tail(src, j);
}

fn _date_scan_tail(src, j): i64 {
    var k = j;
    if (load8(src + k) == 69) { k = k + 1; }        # E
    elif (load8(src + k) == 79) { k = k + 1; }      # O
    while (load8(src + k) == 58) {                  # :
        _dd_colons = _dd_colons + 1;
        k = k + 1;
    }
    return k;
}

# Refuse a directive by name: the field is left out, and the run exits 1.
fn _date_refuse(src, i, n, message): i64 {
    var d = alloc(n + 1);
    memcpy(d, src + i, n);
    store8(d + n, 0);
    report_note("date", d, message);
    _date_bad = 1;
    return 0;
}

# A decorated directive: `%` at `src + i`, its conversion byte at `src + cv`.
# Returns the new buf offset. ⚠ An echo can be longer than the buffer's safety
# margin, so it flushes what is pending and writes the directive itself.
fn _date_decorated(buf, pos, src, i, cv, parts): i64 {
    var c = load8(src + cv);
    var n = cv - i + 1;
    if (c == 0) { n = cv - i; }
    if (n == 3) {
        if (load8(src + i + 1) == 95) {
            if (c == 100) { return _date_w2_sp(buf, pos, load64(parts + 16)); }   # %_d is %e
        }
    }
    var conv: i64 = 0;
    if (_dd_colons == 0) { conv = _date_is_conv(c); }
    elif (c == 122) { if (_dd_colons <= 3) { conv = 1; } }   # %:z %::z %:::z
    if (conv == 1) {
        _date_refuse(src, i, n, "flags, widths and modifiers are not implemented (see roadmap 1.9.4)");
        return pos;
    }
    # Not a conversion: GNU echoes the directive — but pads that echo to a width
    # and uppercases it under `^`, and a lowercase byte is the only one `^` moves.
    var reshaped = _dd_width;
    if (_dd_caret == 1) { if (c >= 97) { if (c <= 122) { reshaped = 1; } } }
    if (reshaped == 1) {
        _date_refuse(src, i, n, "flags, widths and modifiers are not implemented (see roadmap 1.9.4)");
        return pos;
    }
    k_write( 1, buf, pos);
    k_write( 1, src + i, n);
    return 0;
}

fn _date_render_spec(buf, pos, c, parts, wkday, epoch): i64 {
    if (c == 89) { return _date_wyear(buf, pos, load64(parts), 0); }                       # %Y
    if (c == 121) { return _date_w2(buf, pos, _date_y2(load64(parts))); }                   # %y
    if (c == 109) { return _date_w2(buf, pos, load64(parts + 8)); }                          # %m
    if (c == 100) { return _date_w2(buf, pos, load64(parts + 16)); }                         # %d
    if (c == 101) { return _date_w2_sp(buf, pos, load64(parts + 16)); }                      # %e
    if (c == 72) { return _date_w2(buf, pos, load64(parts + 24)); }                         # %H
    if (c == 73) {                                                                           # %I
        var h = load64(parts + 24) % 12;
        if (h == 0) { h = 12; }
        return _date_w2(buf, pos, h);
    }
    if (c == 77) { return _date_w2(buf, pos, load64(parts + 32)); }                         # %M
    if (c == 83) { return _date_w2(buf, pos, load64(parts + 40)); }                         # %S
    if (c == 112) {                                                                          # %p AM/PM
        if (load64(parts + 24) < 12) { return _date_wstr(buf, pos, "AM"); }
        return _date_wstr(buf, pos, "PM");
    }
    if (c == 80) {                                                                           # %P am/pm
        if (load64(parts + 24) < 12) { return _date_wstr(buf, pos, "am"); }
        return _date_wstr(buf, pos, "pm");
    }
    if (c == 106) {                                                                          # %j
        return _date_w3(buf, pos, load64(parts + 56));
    }
    if (c == 117) {                                                                          # %u 1=Mon..7=Sun
        var u = wkday;
        if (u == 0) { u = 7; }
        store8(buf + pos, 48 + u);
        return pos + 1;
    }
    if (c == 119) {                                                                          # %w 0=Sun..6=Sat
        store8(buf + pos, 48 + wkday);
        return pos + 1;
    }
    if (c == 97) {                                                                           # %a
        _date_init_names();
        return _date_wstr(buf, pos, load64(_date_weekday_short + wkday * 8));
    }
    if (c == 65) {                                                                           # %A
        _date_init_names();
        return _date_wstr(buf, pos, load64(_date_weekday_full + wkday * 8));
    }
    if (c == 98) {                                                                           # %b
        _date_init_names();
        var m = load64(parts + 8);
        return _date_wstr(buf, pos, load64(_date_month_short + (m - 1) * 8));
    }
    if (c == 104) {                                                                          # %h alias %b
        _date_init_names();
        var m = load64(parts + 8);
        return _date_wstr(buf, pos, load64(_date_month_short + (m - 1) * 8));
    }
    if (c == 66) {                                                                           # %B
        _date_init_names();
        var m = load64(parts + 8);
        return _date_wstr(buf, pos, load64(_date_month_full + (m - 1) * 8));
    }
    if (c == 90) { return _date_wstr(buf, pos, "UTC"); }                                    # %Z
    if (c == 122) { return _date_wstr(buf, pos, "+0000"); }                                 # %z
    if (c == 115) { return _date_wint(buf, pos, epoch); }                                   # %s
    if (c == 78) {                                                                           # %N
        var nb[16];
        var nv = _date_nsec;
        var nk: i64 = 8;
        while (nk >= 0) {
            store8(&nb + nk, 48 + nv % 10);
            nv = nv / 10;
            nk = nk - 1;
        }
        store8(&nb + 9, 0);
        return _date_wstr(buf, pos, &nb);
    }
    if (c == 84) {                                                                           # %T = %H:%M:%S
        var p = _date_w2(buf, pos, load64(parts + 24));
        store8(buf + p, 58); p = p + 1;
        p = _date_w2(buf, p, load64(parts + 32));
        store8(buf + p, 58); p = p + 1;
        return _date_w2(buf, p, load64(parts + 40));
    }
    if (c == 82) {                                                                           # %R = %H:%M
        var p = _date_w2(buf, pos, load64(parts + 24));
        store8(buf + p, 58); p = p + 1;
        return _date_w2(buf, p, load64(parts + 32));
    }
    if (c == 68) {                                                                           # %D = %m/%d/%y
        var p = _date_w2(buf, pos, load64(parts + 8));
        store8(buf + p, 47); p = p + 1;
        p = _date_w2(buf, p, load64(parts + 16));
        store8(buf + p, 47); p = p + 1;
        return _date_w2(buf, p, _date_y2(load64(parts)));
    }
    if (c == 70) {                                                                           # %F = %Y-%m-%d
        var p = _date_wyear(buf, pos, load64(parts), 1);
        store8(buf + p, 45); p = p + 1;
        p = _date_w2(buf, p, load64(parts + 8));
        store8(buf + p, 45); p = p + 1;
        return _date_w2(buf, p, load64(parts + 16));
    }
    if (c == 110) { store8(buf + pos, 10); return pos + 1; }                                # %n
    if (c == 116) { store8(buf + pos, 9);  return pos + 1; }                                # %t
    if (c == 37)  { store8(buf + pos, 37); return pos + 1; }                                # %%
    # ⚠ Two different failures. A specifier GNU DEFINES and kriya does not render
    # is a wrong answer if emitted verbatim — `date +%V` printing the two bytes
    # "%V" where a week number belonged, exit 0. A specifier that is not a
    # specifier at all is passed through verbatim, which IS what GNU does
    # (verified: `date +%@` prints `%@` on both).
    if (_date_is_deferred_spec(c) == 1) {  #skip-lint
        var eb[8];
        store8(&eb, 37);
        store8(&eb + 1, c);
        store8(&eb + 2, 0);
        report_note("date", &eb, "specifier not implemented (see roadmap 1.9.4)");
        _date_bad = 1;
        return pos;
    }
    store8(buf + pos, 37);
    store8(buf + pos + 1, c);
    return pos + 2;
}

# Format the timestamp using FMT (cstr; if 0, use the default).
fn _date_format(fmt, epoch, buf, bufsz): i64 {
    # ⛔ `epoch_to_date` counted up from 1970 and `_date_weekday` truncated, so a time before 1970
    # came out wrong in both. Neither showed while `date` printed only the present (1.9.3).
    var pbuf[64];
    kdt_civil(epoch, &pbuf);
    var parts = &pbuf;
    var wkday = load64(&pbuf + 48);
    var pos: i64 = 0;
    var i: i64 = 0;
    var default_fmt = "%a %b %e %H:%M:%S %Z %Y";
    var src = fmt;
    if (src == 0) { src = default_fmt; }
    while (load8(src + i) != 0) {
        var c = load8(src + i);
        if (pos >= bufsz - 32) {
            # Safety margin — flush early.
            k_write( 1, buf, pos);
            pos = 0;
        }
        if (c == 37) {                          # `%`
            var next = load8(src + i + 1);
            if (next == 0) {
                # Trailing % — emit literally.
                store8(buf + pos, 37);
                pos = pos + 1;
                i = i + 1;
            } else {
                # ⛔ `%_` at the very end used to skip the NUL (`i + 3`) and read
                # past the format. The scan stops at it instead.
                var cv = _date_scan_directive(src, i);
                if (cv == i + 1) {
                    pos = _date_render_spec(buf, pos, next, parts, wkday, epoch);
                    i = i + 2;
                } else {
                    pos = _date_decorated(buf, pos, src, i, cv, parts);
                    i = cv + 1;
                    if (load8(src + cv) == 0) { i = cv; }
                }
            }
        } else {
            store8(buf + pos, c);
            pos = pos + 1;
            i = i + 1;
        }
    }
    store8(buf + pos, 10);                       # trailing newline
    pos = pos + 1;
    k_write( 1, buf, pos);
    return 0;
}

# ⭐ THE OPTION TABLE, AND THE PARSER'S ONLY SOURCE FOR IT. `date` cannot hand
# its whole argv to `flags_parse` — `+FORMAT` is an operand that begins with a
# character no option parser would accept — so it walks argv itself. But the
# walk ASKS this spec what exists rather than hardcoding letters, which is what
# makes rendering it in `--help` and `--help=json` honest: it IS the parser's
# data, not a description of it.
#
# ⛔ A spec the parser does not consult is a second source of truth, and that is
# exactly what 1.3.0 and 1.3.1 were built to avoid. `find` carried one for five
# releases — built, never read, never even called — until 1.3.7 deleted it.
var _date_spec = 0;

fn _date_init_spec(): i64 {
    if (_date_spec != 0) { return 0; }
    var s = flags_new();
    flags_add_bool(s, 117, "utc",       0, "no-op; kriya date is UTC-only (ADR 0007)");
    flags_add_bool(s, 0,   "universal", 0, "synonym for --utc");
    flags_add_str(s, 100,  "date",      0, "show the time described by STRING, not now");
    _date_spec = s;
    return 0;
}

fn cmd_date(start: i64): i64 {
    _date_init_spec();
    date_help_declare();
    help_if_requested(_date_spec, start);
    var n_argv = kriya_argv_count();
    var fmt: i64 = 0;
    var dstr: i64 = 0;          # the last -d STRING, as in GNU
    var i = start;
    while (i < n_argv) {
        var tok = kriya_arg(i);
        var tlen = strlen(tok);
        if (tlen >= 1) {
            if (load8(tok) == 43) {              # `+`
                fmt = tok + 1;
                i = i + 1;
                continue;
            }
            if (load8(tok) == 45) {
                if (tlen == 1) {
                    k_write( 2, "kriya date: error: lone `-` is not a valid operand\n", 51);
                    return EXIT_USAGE;
                }
                if (load8(tok + 1) == 45) {
                    # Long option.
                    if (tlen == 2) {
                        i = i + 1;
                        continue;
                    }
                    var name = tok + 2;
                    var nlen = tlen - 2;
                    # `--date=STRING` or `--date STRING` (1.9.3).
                    if (nlen >= 4) {
                        if (memeq(name, "date", 4) == 1) {
                            if (nlen == 4) {
                                if (i + 1 >= n_argv) {
                                    k_write( 2, "kriya date: --date needs a STRING\n", 34);
                                    return EXIT_USAGE;
                                }
                                dstr = kriya_arg(i + 1);
                                i = i + 2;
                                continue;
                            }
                            if (load8(name + 4) == 61) {
                                dstr = name + 5;
                                i = i + 1;
                                continue;
                            }
                        }
                    }
                    # ⭐ Ask the spec. Adding a long option is one spec row, and
                    # `--help` picks it up without a second edit here.
                    var hit: i64 = 0;
                    if (kriya_long_type(_date_spec, name, nlen) >= 0) { hit = 1; }
                    if (hit == 1) {
                        i = i + 1;
                        continue;
                    }
                    k_write( 2, "kriya date: error: unknown long option (--utc, --universal and --date are accepted; --reference, --rfc-email and --iso-8601 are roadmap 1.9.4)\n", 143);  #skip-lint
                    return EXIT_USAGE;
                }
                # Short options: `-u`, a no-op bool, and `-d STRING` (1.9.3), whose value is the
                # rest of the token or the next argument.
                var p: i64 = 1;
                var ok: i64 = 1;
                var took_next: i64 = 0;
                while (p < tlen) {
                    var c = load8(tok + p);
                    # ⭐ Ask the spec, same as the long form above.
                    var ty = kriya_short_type(_date_spec, c);
                    if (ty > 0) {
                        if (p + 1 < tlen) { dstr = tok + p + 1; }
                        else {
                            if (i + 1 >= n_argv) {
                                k_write( 2, "kriya date: -d needs a STRING\n", 30);
                                return EXIT_USAGE;
                            }
                            dstr = kriya_arg(i + 1);
                            took_next = 1;
                        }
                        p = tlen;
                    } elif (ty == 0) {
                        p = p + 1;
                    } else {
                        ok = 0;
                        p = tlen;
                    }
                }
                if (ok == 0) {
                    k_write( 2, "kriya date: error: unknown short option (-u and -d are accepted; -r/-R/-I are roadmap 1.9.4)\n", 93);  #skip-lint
                    return EXIT_USAGE;
                }
                i = i + 1 + took_next;
                continue;
            }
        }
        k_write( 2, "kriya date: error: unexpected operand (use +FORMAT)\n", 52);
        return EXIT_USAGE;
    }

    # ⛔ `%N` PRINTED NINE ZEROS until 1.9.3, because "now" was sampled in whole seconds. It is
    # the nanosecond clock now, as GNU's is.
    var nowns = clock_epoch_ns();
    var epoch = nowns / 1000000000;
    _date_nsec = nowns % 1000000000;
    if (dstr != 0) {
        # ⭐ GNU's `parse_datetime`, in UTC (src/lib/datetime.cyr, 1.9.3).
        var res[16];
        var pr = kdt_parse(dstr, nowns / 1000000000, nowns % 1000000000, &res);
        if (pr == KDT_TZ) {
            var tzm = "a TZ= in a date string needs time zone data, which kriya does not read (ADR 0007)";
            report_note("date", dstr, tzm);
            return EXIT_USAGE;
        }
        if (pr != KDT_OK) {
            report_note("date", dstr, "invalid date");
            return EXIT_USAGE;
        }
        epoch = load64(&res);
        _date_nsec = load64(&res + 8);
    }
    # A year a `struct tm` cannot hold is out of range, as it is for GNU's localtime.
    var cyr[64];
    kdt_civil(epoch, &cyr);
    if (load64(&cyr) > KDT_YEAR_MAX || load64(&cyr) < KDT_YEAR_MIN) {
        var eb[32];
        var en = _date_wint(&eb, 0, epoch);
        store8(&eb + en, 0);
        report_note("date", &eb, "time is out of range");
        # GNU 9.6 and later still end the output line (`show_date_helper`); 9.4 wrote nothing.
        k_write( 1, "\n", 1);
        return EXIT_FAILURE;
    }
    var buf = alloc(4096);
    _date_format(fmt, epoch, buf, 4096);
    if (_date_bad == 1) { return EXIT_FAILURE; }
    return EXIT_SUCCESS;
}

# Help/introspection record for `date`. ⭐ Split out so `kriya --list` can
# populate it WITHOUT running the utility — one declaration feeding `--help`,
# `--help=json` and `--list` alike.
fn date_help_declare(): i64 {
    help_begin("date", "Print the current date and time, or the one -d describes.",
      "date [OPTIONS] [+FORMAT]");
    help_positional(0, 1, "+FORMAT");
    help_operands("UTC only until tzfile parsing lands (ADR 0007); -u is accepted as a no-op, and -d reads GNU's free-form dates as UTC (a TZ=\"...\" in the string is refused). Specifiers kriya cannot render are refused rather than echoed back.");  #skip-lint
    help_example("date");
    help_example("date '+%Y-%m-%d'");
    help_example("date -u '+%H:%M:%S'");
    help_example("date -d '1 day ago' +%F");
    help_example("date -d @1700000000");
    return 0;
}
