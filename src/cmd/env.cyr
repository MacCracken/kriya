# env — POSIX `env(1)`: print the environment, or run a command in a
# modified environment.
#
# Argument shape (in token order):
#   env [OPTIONS] [NAME=VALUE...] [COMMAND [ARG...]]
#
# Options:
#   -i / --ignore-environment / `-`   start with an empty environment
#                                     (`-` alone is the POSIX synonym).
#   -u / --unset NAME                 unset NAME (may repeat).
#   -0 / --null                       print env entries NUL-terminated
#                                     instead of newline-terminated.
#                                     Only meaningful when no COMMAND.
#   -S / --split-string STRING        split STRING into words (1.8.3) and read
#                                     them where -S stood, options included —
#                                     what a `#!/usr/bin/env -S cmd -x` line
#                                     needs, since the kernel hands env the
#                                     rest of that line as ONE argument. GNU's
#                                     grammar: blanks separate; '...' keeps
#                                     everything but \\ and \'; "..." takes
#                                     \" \\ \$, \_ as a space and ${NAME};
#                                     unquoted, \_ separates, \c ends the
#                                     string, \f \n \r \t \v are controls and
#                                     # at a word start is a comment. Only
#                                     ${NAME} expands, from the environment env
#                                     was given, and is not re-split.
#   -C / --chdir DIR                  chdir to DIR before COMMAND is looked up
#                                     (1.8.3); a failure is exit 125.
#   --                                end of options; subsequent tokens
#                                     are still scanned for NAME=VALUE
#                                     assignments until the first
#                                     non-assignment, which becomes
#                                     COMMAND.
#
# State machine: option-parsing -> assignment-parsing -> command-and-args.
#   - In option-parsing: any token without a leading `-` and containing
#     `=` flips to assignment-parsing (re-processed there). Any token
#     without a leading `-` and without `=` flips to command-and-args.
#   - In assignment-parsing: any token without `=` flips to
#     command-and-args.
#
# With COMMAND: PATH-resolve argv[0] (unless it contains `/`), then
# `sys_execve` directly — env(1) REPLACES itself with the target; it
# does not fork. Exit codes follow GNU on exec failure: 127 for
# "command not found" (ENOENT / ENOTDIR, which is also what an unmatched
# PATH search reports), 126 for other exec failures.
#
# Without COMMAND: print the (possibly modified) environment to stdout,
# entries separated by `\n` (or `\0` with `-0`). Exit 0.

var _env_clear_env:  i64 = 0;
var _env_null_sep:   i64 = 0;
# In-order op list: parallel vecs. _env_ops_kind holds 0=unset / 1=set
# at each slot; _env_ops_payload holds the corresponding NAME (for
# unset) or "NAME=VALUE" (for set). Order matters: `FOO=x -u FOO`
# yields no FOO, `-u FOO FOO=x` yields FOO=x.
var _env_ops_kind:    i64 = 0;
var _env_ops_payload: i64 = 0;
var _env_cmd_argv:    i64 = 0;   # vec of cstr* (command + args)
var _env_toks:        i64 = 0;   # the tokens being parsed: argv, with -S's words spliced in
var _env_chdir:       i64 = 0;   # -C DIR, or 0

# --- -S / --split-string (1.8.3) -----------------------------------------------
#
# GNU's grammar, measured against coreutils 9.4 and 9.7 and reproduced: blanks (space, \t, \n,
# \v, \f, \r) separate words; `#` at the START of a word comments out the rest. In single quotes
# only `\\` and `\'` are special. In double quotes `\"` `\\` `\$` are the character, `\_` is a
# space, `${VAR}` expands, and `\c` is an error. Unquoted, `\_` separates words, `\c` ends the
# string, `\# \$ \' \" \\` are the character, and `\f \n \r \t \v` the control character. Only
# `${NAME}` expands, the value NOT re-split. The words then go back into the option stream, so
# `-S '-i FOO=1 cmd'` is three more options and a command. An error is reported in GNU's words
# and is a usage error (exit 2; GNU's env uses 125 for every failure of its own).
fn _env_s_err(msg, tail): i64 {
    k_write( 2, "kriya env: ", 11);
    k_write( 2, msg, strlen(msg));
    if (tail != 0) { k_write( 2, tail, strlen(tail)); }
    k_write( 2, "\n", 1);
    syscall(SYS_EXIT, EXIT_USAGE);
    return 0;
}

fn _env_s_blank(c): i64 {
    if (c == 32) { return 1; }
    if (c >= 9) { if (c <= 13) { return 1; } }
    return 0;
}

fn _env_s_namech(c, first): i64 {
    if (c == 95) { return 1; }
    if (c >= 65) { if (c <= 90) { return 1; } }
    if (c >= 97) { if (c <= 122) { return 1; } }
    if (first == 0) { if (c >= 48) { if (c <= 57) { return 1; } } }
    return 0;
}

# Append byte `c` to the word being built in `w` (a growable buffer: [ptr, len, cap]).
fn _env_s_put(w, c): i64 {
    var len = load64(w + 8);
    var cap = load64(w + 16);
    if (len + 2 > cap) {
        var ncap = cap * 2;
        if (ncap < 64) { ncap = 64; }
        var nb = alloc(ncap);
        if (len > 0) { memcpy(nb, load64(w), len); }
        store64(w, nb);
        store64(w + 16, ncap);
    }
    store8(load64(w) + len, c);
    store64(w + 8, len + 1);
    return 0;
}

fn _env_s_end(w, words): i64 {
    var len = load64(w + 8);
    var out = alloc(len + 1);
    if (len > 0) { memcpy(out, load64(w), len); }
    store8(out + len, 0);
    vec_push(words, out);
    store64(w + 8, 0);
    return 0;
}

# `${NAME}` at `str + i` (the `$`): appends the value to `w` and returns the index after the `}`,
# NEGATED when NAME is unset.
#
# ⛔ AN UNSET NAME STARTS NO WORD; A SET ONE STARTS ONE EVEN WHEN EMPTY. GNU calls
# `check_start_new_arg` only on a non-NULL getenv, so `A=1 ${NOPE} B=2` is two words
# and `${NOPE}#x` is still a comment, while `E= … -S 'x ${E}'` passes an empty
# argument. The first cut started a word for every `${…}`; a differential fuzz of
# 20,000 random -S strings against GNU 9.7 found it in 82 of them.
fn _env_s_var(str, i, w): i64 {
    var bad: i64 = 0;
    if (load8(str + i + 1) != 123) { bad = 1; }
    var j = i + 2;
    if (bad == 0) {
        if (_env_s_namech(load8(str + j), 1) == 0) { bad = 1; }
    }
    if (bad == 0) {
        while (_env_s_namech(load8(str + j), 0) == 1) { j = j + 1; }
        if (load8(str + j) != 125) { bad = 1; }
    }
    if (bad == 1) { _env_s_err("only ${VARNAME} expansion is supported, error at: ", str + i); }
    var n = j - (i + 2);
    var name = alloc(n + 1);
    memcpy(name, str + i + 2, n);
    store8(name + n, 0);
    var v = getenv(name);
    if (v == 0) { return 0 - (j + 1); }
    var k: i64 = 0;
    while (load8(v + k) != 0) { _env_s_put(w, load8(v + k)); k = k + 1; }
    return j + 1;
}

# Split the -S string into a vec of words.
fn _env_split(str): i64 {
    var words = vec_new();
    var w = alloc(24);
    store64(w, 0); store64(w + 8, 0); store64(w + 16, 0);
    var in_word: i64 = 0;
    var quote: i64 = 0;                  # 0, 39 ('), 34 (")
    var i: i64 = 0;
    var go: i64 = 1;
    while (go == 1) {
        var c = load8(str + i);
        if (c == 0) {
            if (quote != 0) { _env_s_err("no terminating quote in -S string", 0); }
            go = 0;
        } elif (quote == 39) {
            if (c == 39) { quote = 0; i = i + 1; }
            elif (c == 92) {
                var n1 = load8(str + i + 1);
                if (n1 == 92 || n1 == 39) { _env_s_put(w, n1); i = i + 2; }
                else { _env_s_put(w, c); i = i + 1; }
            } else { _env_s_put(w, c); i = i + 1; }
        } elif (c == 92) {
            var e = load8(str + i + 1);
            var take: i64 = 0 - 1;
            if (e == 0) { _env_s_err("invalid backslash at end of string in -S", 0); }
            if (e == 34 || e == 35) { take = e; }
            if (e == 36 || e == 39) { take = e; }
            if (e == 92) { take = 92; }
            if (e == 102) { take = 12; }
            if (e == 110) { take = 10; }
            if (e == 114) { take = 13; }
            if (e == 116) { take = 9; }
            if (e == 118) { take = 11; }
            if (e == 95) {
                if (quote == 34) { take = 32; }
                else {
                    # Unquoted `\_` separates words.
                    if (in_word == 1) { _env_s_end(w, words); in_word = 0; }
                    take = 0 - 2;
                }
            }
            if (e == 99) {
                if (quote == 34) { _env_s_err("'\\c' must not appear in double-quoted -S string", 0); }
                take = 0 - 3;
            }
            if (take == (0 - 1)) {
                var sq = alloc(3);
                store8(sq, 92); store8(sq + 1, e); store8(sq + 2, 0);
                k_write( 2, "kriya env: invalid sequence '", 29);
                k_write( 2, sq, 2);
                k_write( 2, "' in -S\n", 8);
                syscall(SYS_EXIT, EXIT_USAGE);
            }
            if (take == (0 - 3)) { go = 0; }
            elif (take >= 0) { _env_s_put(w, take); in_word = 1; i = i + 2; }
            else { i = i + 2; }
        } elif (c == 36) {
            var vi = _env_s_var(str, i, w);
            if (vi < 0) { i = 0 - vi; }
            else { in_word = 1; i = vi; }
        } elif (quote == 34) {
            if (c == 34) { quote = 0; } else { _env_s_put(w, c); }
            i = i + 1;
        } elif (_env_s_blank(c) == 1) {
            if (in_word == 1) { _env_s_end(w, words); in_word = 0; }
            i = i + 1;
        } elif (c == 35) {
            if (in_word == 0) { go = 0; }        # a comment, to the end
            else { _env_s_put(w, c); i = i + 1; }
        } elif (c == 39 || c == 34) {
            quote = c;
            in_word = 1;                          # '' is an argument
            i = i + 1;
        } else {
            _env_s_put(w, c);
            in_word = 1;
            i = i + 1;
        }
    }
    if (in_word == 1) { _env_s_end(w, words); }
    return words;
}

# Replace `consumed` tokens at `at` in `_env_toks` with `words`.
fn _env_splice(at, consumed, words): i64 {
    var nv = vec_new();
    var n = vec_len(_env_toks);
    var i: i64 = 0;
    while (i < at) { vec_push(nv, vec_get(_env_toks, i)); i = i + 1; }
    var k: i64 = 0;
    while (k < vec_len(words)) { vec_push(nv, vec_get(words, k)); k = k + 1; }
    i = at + consumed;
    while (i < n) { vec_push(nv, vec_get(_env_toks, i)); i = i + 1; }
    _env_toks = nv;
    return 0;
}

# Find an `=` in `tok` (within `tlen` bytes). Returns index of `=` or
# -1 if absent. Returns -1 also if `=` is at position 0 (empty name).
fn _env_find_eq(tok, tlen): i64 {
    var i: i64 = 0;
    while (i < tlen) {
        if (load8(tok + i) == 61) {
            if (i == 0) { return 0 - 1; }
            return i;
        }
        i = i + 1;
    }
    return 0 - 1;
}

# Byte-equal: are the first `n` bytes of `a` and `b` identical?
fn _env_bytes_eq(a, b, n): i64 {
    var i: i64 = 0;
    while (i < n) {
        if (load8(a + i) != load8(b + i)) { return 0; }
        i = i + 1;
    }
    return 1;
}

# Load /proc/self/environ into a vec of cstr* pointing into a single
# heap buffer. Each entry is already NUL-terminated by the kernel.
fn _env_load_environ(): i64 {
    var v = vec_new();
    var fd = k_open("/proc/self/environ", 0, 0);
    if (fd < 0) { return v; }
    var cap: i64 = 4096;
    var buf = alloc(cap);
    var used: i64 = 0;
    var loop: i64 = 1;
    while (loop == 1) {
        if (used + 4096 > cap) {
            var newcap = cap * 2;
            var newbuf = alloc(newcap);
            memcpy(newbuf, buf, used);
            buf = newbuf;
            cap = newcap;
        }
        var n = k_read( fd, buf + used, 4096);
        if (n < 0) {
            if ((0 - n) == 4) {
                # EINTR retry
            } else { loop = 0; }
        } else {
            if (n == 0) { loop = 0; }
            else { used = used + n; }
        }
    }
    k_close( fd);
    var s: i64 = 0;
    var i: i64 = 0;
    while (i < used) {
        if (load8(buf + i) == 0) {
            if (i > s) { vec_push(v, buf + s); }
            s = i + 1;
        }
        i = i + 1;
    }
    return v;
}

# Length of NAME portion of "NAME=VAL" (offset of `=`). Returns -1 if
# the entry has no `=` (corrupt env entry — caller filters it out).
fn _env_name_len(entry): i64 {
    var i: i64 = 0;
    while (load8(entry + i) != 0) {
        if (load8(entry + i) == 61) { return i; }
        i = i + 1;
    }
    return 0 - 1;
}

# Find a working-env entry whose NAME matches `name` of length `nlen`.
# Returns index or -1.
fn _env_find_name(work, name, nlen): i64 {
    var n = vec_len(work);
    var i: i64 = 0;
    while (i < n) {
        var entry = vec_get(work, i);
        var elen = _env_name_len(entry);
        if (elen == nlen) {
            if (_env_bytes_eq(name, entry, nlen) == 1) { return i; }
        }
        i = i + 1;
    }
    return 0 - 1;
}

# Remove the entry at `idx` by sliding the tail down by one slot.
# (vec.cyr doesn't expose remove-at; we read+write through vec_set
# and decrement length via repeated pops.)
fn _env_vec_remove(v, idx): i64 {
    var n = vec_len(v);
    if (idx < 0) { return 0; }
    if (idx >= n) { return 0; }
    var i: i64 = idx;
    while (i < n - 1) {
        vec_set(v, i, vec_get(v, i + 1));
        i = i + 1;
    }
    vec_pop(v);
    return 0;
}

# Apply ops in the order they were seen. Each set replaces any
# existing entry with the same NAME; each unset removes it.
fn _env_apply_mods(base): i64 {
    # Filter out malformed entries from base first (no `=`).
    var work = vec_new();
    var n = vec_len(base);
    var i: i64 = 0;
    while (i < n) {
        var entry = vec_get(base, i);
        if (_env_name_len(entry) > 0) { vec_push(work, entry); }
        i = i + 1;
    }
    var nops = vec_len(_env_ops_kind);
    var k: i64 = 0;
    while (k < nops) {
        var kind = vec_get(_env_ops_kind, k);
        var pay  = vec_get(_env_ops_payload, k);
        if (kind == 0) {
            # Unset NAME.
            var ulen = strlen(pay);
            var idx = _env_find_name(work, pay, ulen);
            if (idx >= 0) { _env_vec_remove(work, idx); }
        } else {
            # Set "NAME=VALUE": replace existing (preserve position) or append.
            var nlen = _env_name_len(pay);
            if (nlen > 0) {
                var existing = _env_find_name(work, pay, nlen);
                if (existing >= 0) {
                    vec_set(work, existing, pay);
                } else {
                    vec_push(work, pay);
                }
            }
        }
        k = k + 1;
    }
    return work;
}

# Resolve `cmd` against the PATH in the MODIFIED env vec — the one the command
# will run under, as GNU's `execvp` does after env has rewritten `environ`.
# Thin wrapper over the shared `fs_resolve_in_path`; returns 0 when nothing is
# found.
#
# ⛔ (1.8.3) env HAD ITS OWN COPY OF THE RESOLVER, AND IT KEPT THE HOLE THE SHARED
# ONE CLOSED. Both "PATH is unset" and "searched PATH, found nothing" returned
# the bare name, and `execve("ls")` is resolved by the kernel against the current
# directory. In a directory holding an attacker's `./ls`, `env -i ls` and
# `env PATH=/nonexist ls` both printed PWNED-FROM-CWD; GNU runs /bin/ls and exits
# 127 respectively. xargs and find had moved to the shared resolver; env, the one
# utility whose whole job is to exec a command, had not.
fn _env_resolve(cmd, env): i64 {
    var path_val: i64 = 0;
    var n = vec_len(env);
    var k: i64 = 0;
    while (k < n) {
        var entry = vec_get(env, k);
        if (_env_bytes_eq(entry, "PATH=", 5) == 1) {
            path_val = entry + 5;
            k = n;
        }
        k = k + 1;
    }
    return fs_resolve_in_path(cmd, path_val);
}

# Write env vec to stdout. Entries separated by `\n` or `\0` per -0.
fn _env_print(env): i64 {
    var n = vec_len(env);
    var i: i64 = 0;
    var sep: i64 = 10;  # '\n'
    if (_env_null_sep == 1) { sep = 0; }
    while (i < n) {
        var entry = vec_get(env, i);
        var elen  = strlen(entry);
        k_write( 1, entry, elen);
        var s[1];
        store8(&s, sep);
        k_write( 1, &s, 1);
        i = i + 1;
    }
    return 0;
}

# Execute `cmd_argv` (vec of cstr*) under `env_vec`. Builds the flat
# argv and envp arrays then calls sys_execve directly — env(1)
# REPLACES itself with the target program; no fork.
fn _env_exec(cmd_argv, env_vec): i64 {
    var ac = vec_len(cmd_argv);
    if (ac < 1) { return 127; }
    var raw_cmd = vec_get(cmd_argv, 0);
    var resolved = _env_resolve(raw_cmd, env_vec);

    var argv_flat = alloc((ac + 1) * 8);
    var ai: i64 = 0;
    while (ai < ac) {
        store64(argv_flat + ai * 8, vec_get(cmd_argv, ai));
        ai = ai + 1;
    }
    store64(argv_flat + ac * 8, 0);

    var ec = vec_len(env_vec);
    var envp_flat = alloc((ec + 1) * 8);
    var ei: i64 = 0;
    while (ei < ec) {
        store64(envp_flat + ei * 8, vec_get(env_vec, ei));
        ei = ei + 1;
    }
    store64(envp_flat + ec * 8, 0);

    # agnos has no execve (no in-place process replacement — only
    # execwait/spawn). Refuse the exec-a-command path cleanly; the
    # var-print / -i modes above never reach here so they still work.
    #ifdef CYRIUS_TARGET_AGNOS
    k_write( 2, "kriya env: exec not supported on AGNOS\n", 39);
    return EXIT_FAILURE;
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    # Nothing on PATH is ENOENT, reported as if execve had said it.
    var r: i64 = 0 - 2;
    if (resolved != 0) { r = sys_execve(resolved, argv_flat, envp_flat); }
    # If we got here, the command did not start. r is negative-errno.
    var errno = 0 - r;
    k_write( 2, "kriya env: ", 11);
    k_write( 2, raw_cmd, strlen(raw_cmd));
    k_write( 2, ": ", 2);
    if (errmsg_is_known(errno) == 1) {
        var m = errmsg_for(errno);
        k_write( 2, m, strlen(m));
    } else {
        k_write( 2, "exec failed", 11);
    }
    k_write( 2, "\n", 1);
    # GNU's exit-code rule: ENOENT or ENOTDIR -> 127, anything else -> 126.
    if (errno == 2)  { return 127; }
    if (errno == 20) { return 127; }
    return 126;
    #endif
}

# ⭐ THE OPTION TABLE, AND THE AUTHORITY ON WHAT IS ACCEPTED — see the fuller
# note in `src/cmd/du.cyr`. The walk owns each option's MEANING; this spec owns
# whether an option exists at all, so `--help=json` cannot advertise a flag the
# parser rejects, nor miss one it accepts.
var _env_spec = 0;

fn _env_init_spec(): i64 {
    if (_env_spec != 0) { return 0; }
    var s = flags_new();
    flags_add_bool(s, 105, "ignore-environment", 0, "start with an empty environment");
    flags_add_str(s,  117, "unset",              0, "remove NAME from the environment");
    flags_add_bool(s, 48,  "null",               0, "NUL-terminate each output line");
    flags_add_str(s,  83,  "split-string",       0, "split STRING into words, read as options and command (#! lines)");
    flags_add_str(s,  67,  "chdir",              0, "change to DIR before running COMMAND");
    _env_spec = s;
    return 0;
}

fn cmd_env(start: i64): i64 {
    _env_init_spec();
    env_help_declare();
    help_if_requested(_env_spec, start);
    _env_clear_env    = 0;
    _env_null_sep     = 0;
    _env_ops_kind     = vec_new();
    _env_ops_payload  = vec_new();
    _env_cmd_argv     = vec_new();

    var n_argv = kriya_argv_count();
    # The tokens are parsed from a vec, because -S splices its words in where it stood.
    _env_toks = vec_new();
    var ti = start;
    while (ti < n_argv) { vec_push(_env_toks, kriya_arg(ti)); ti = ti + 1; }
    _env_chdir = 0;
    # Pre-command mode accepts options + NAME=VAL in any interleave.
    # ⚠ NOT GNU's rule, whatever this said before 1.8.3: GNU's getopt string
    # starts with `+`, so its first NAME=VALUE ends option parsing and
    # `env A=1 -u A cmd` runs `-u` as the command. kriya reads that -u as an
    # option, and smoke-env pins it. The transition to command mode happens when
    # we see a token that's neither a flag nor a NAME=VALUE assignment.
    # `--` disables option recognition but leaves assignment scanning
    # active until the first non-assignment.
    var in_command:     i64 = 0;
    var no_more_opts:   i64 = 0;
    var i: i64 = 0;
    while (i < vec_len(_env_toks)) {
        var tok = vec_get(_env_toks, i);
        var tlen = strlen(tok);
        if (in_command == 1) {
            vec_push(_env_cmd_argv, tok);
            i = i + 1;
            continue;
        }
        # Pre-command: options-allowed branch unless `--` was seen.
        if (no_more_opts == 0) {
            # Single `-` alone => -i synonym (POSIX).
            if (tlen == 1) {
                if (load8(tok) == 45) {
                    _env_clear_env = 1;
                    i = i + 1;
                    continue;
                }
            }
            if (tlen >= 2) {
                if (load8(tok) == 45) {
                    if (load8(tok + 1) == 45) {
                        if (tlen == 2) {
                            # `--`: stop option recognition. Assignments
                            # still scanned in the no_more_opts branch
                            # below until the first non-assignment.
                            no_more_opts = 1;
                            i = i + 1;
                            continue;
                        }
                        # --name or --name=val
                        var eq_off: i64 = 0;
                        var k: i64 = 2;
                        while (k < tlen) {
                            if (load8(tok + k) == 61) { eq_off = k; k = tlen; }
                            k = k + 1;
                        }
                        var name_len: i64 = tlen - 2;
                        if (eq_off > 0) { name_len = eq_off - 2; }
                        # --ignore-environment
                        if (name_len == 18) {
                            if (_env_bytes_eq(tok + 2, "ignore-environment", 18) == 1) {
                                if (eq_off > 0) {
                                    k_write( 2, "kriya env: error: --ignore-environment does not take a value\n", 61);
                                    return EXIT_USAGE;
                                }
                                _env_clear_env = 1;
                                i = i + 1;
                                continue;
                            }
                        }
                        # --null
                        if (name_len == 4) {
                            if (_env_bytes_eq(tok + 2, "null", 4) == 1) {
                                if (eq_off > 0) {
                                    k_write( 2, "kriya env: error: --null does not take a value\n", 47);
                                    return EXIT_USAGE;
                                }
                                _env_null_sep = 1;
                                i = i + 1;
                                continue;
                            }
                        }
                        # --unset NAME / --unset=NAME
                        if (name_len == 5) {
                            if (_env_bytes_eq(tok + 2, "unset", 5) == 1) {
                                var uname: i64 = 0;
                                if (eq_off > 0) {
                                    uname = tok + eq_off + 1;
                                } else {
                                    i = i + 1;
                                    if (i >= vec_len(_env_toks)) {
                                        k_write( 2, "kriya env: error: --unset requires an argument\n", 47);
                                        return EXIT_USAGE;
                                    }
                                    uname = vec_get(_env_toks, i);
                                }
                                if (load8(uname) == 0) {
                                    k_write( 2, "kriya env: error: --unset NAME must not be empty\n", 49);
                                    return EXIT_USAGE;
                                }
                                vec_push(_env_ops_kind, 0);
                                vec_push(_env_ops_payload, uname);
                                i = i + 1;
                                continue;
                            }
                        }
                        # --split-string=S / --chdir=DIR, or the value as the next word.
                        var lkind: i64 = 0;
                        if (name_len == 12) {
                            if (_env_bytes_eq(tok + 2, "split-string", 12) == 1) { lkind = 83; }
                        }
                        if (name_len == 5) {
                            if (_env_bytes_eq(tok + 2, "chdir", 5) == 1) { lkind = 67; }
                        }
                        if (lkind != 0) {
                            var lval: i64 = 0;
                            var lused: i64 = 1;
                            if (eq_off > 0) { lval = tok + eq_off + 1; }
                            else {
                                if (i + 1 >= vec_len(_env_toks)) {
                                    if (lkind == 67) {
                                        k_write( 2, "kriya env: error: --chdir requires an argument\n", 47);
                                    } else {
                                        k_write( 2, "kriya env: error: --split-string requires an argument\n", 54);
                                    }
                                    return EXIT_USAGE;
                                }
                                lval = vec_get(_env_toks, i + 1);
                                lused = 2;
                            }
                            if (lkind == 67) { _env_chdir = lval; i = i + lused; continue; }
                            # -S: its words take its place, and are read from here as options.
                            _env_splice(i, lused, _env_split(lval));
                            continue;
                        }
                        k_write( 2, "kriya env: error: unknown option\n", 33);
                        return EXIT_USAGE;
                    }
                    # Short option(s). Walk chars.
                    var p: i64 = 1;
                    var consumed_next: i64 = 0;
                    var split_at: i64 = 0;
                    var loop: i64 = 1;
                    while (loop == 1) {
                        if (p >= tlen) {
                            loop = 0;
                        } else {
                            var ch = load8(tok + p);
                            if (ch == 105) {           # -i
                                _env_clear_env = 1;
                                p = p + 1;
                            } else {
                                if (ch == 48) {        # -0
                                    _env_null_sep = 1;
                                    p = p + 1;
                                } else {
                                    if (ch == 117) {   # -u (takes value)
                                        var uname: i64 = 0;
                                        if (p + 1 < tlen) {
                                            uname = tok + p + 1;
                                        } else {
                                            if (i + 1 >= vec_len(_env_toks)) {
                                                k_write( 2, "kriya env: error: -u requires an argument\n", 42);
                                                return EXIT_USAGE;
                                            }
                                            uname = vec_get(_env_toks, i + 1);
                                            consumed_next = 1;
                                        }
                                        if (load8(uname) == 0) {
                                            k_write( 2, "kriya env: error: -u NAME must not be empty\n", 44);
                                            return EXIT_USAGE;
                                        }
                                        vec_push(_env_ops_kind, 0);
                                        vec_push(_env_ops_payload, uname);
                                        loop = 0;
                                    } elif (ch == 83 || ch == 67) {
                                        # -S STRING / -C DIR: the rest of the word, or the next one.
                                        var sval: i64 = 0;
                                        if (p + 1 < tlen) { sval = tok + p + 1; }
                                        else {
                                            if (i + 1 >= vec_len(_env_toks)) {
                                                if (ch == 67) {
                                                    k_write( 2, "kriya env: error: -C requires an argument\n", 42);
                                                } else {
                                                    k_write( 2, "kriya env: error: -S requires an argument\n", 42);
                                                }
                                                return EXIT_USAGE;
                                            }
                                            sval = vec_get(_env_toks, i + 1);
                                            consumed_next = 1;
                                        }
                                        if (ch == 67) { _env_chdir = sval; }
                                        else { split_at = sval; }
                                        loop = 0;
                                    } else {
                                        k_write( 2, "kriya env: error: unknown option\n", 33);
                                        return EXIT_USAGE;
                                    }
                                }
                            }
                        }
                    }
                    if (split_at != 0) {
                        # The cluster's other letters are done; -S's words replace the token
                        # (and its value) and are read from here.
                        var used: i64 = 1;
                        if (consumed_next == 1) { used = 2; }
                        _env_splice(i, used, _env_split(split_at));
                        continue;
                    }
                    if (consumed_next == 1) {
                        i = i + 2;
                    } else {
                        i = i + 1;
                    }
                    continue;
                }
            }
            # Not an option. NAME=VALUE assignment vs command head.
            var eq = _env_find_eq(tok, tlen);
            if (eq > 0) {
                vec_push(_env_ops_kind, 1);
                vec_push(_env_ops_payload, tok);
                i = i + 1;
                continue;
            }
            in_command = 1;
            vec_push(_env_cmd_argv, tok);
            i = i + 1;
            continue;
        }
        # no_more_opts == 1: assignment-or-command, no option dispatch.
        var eq3 = _env_find_eq(tok, tlen);
        if (eq3 > 0) {
            vec_push(_env_ops_kind, 1);
            vec_push(_env_ops_payload, tok);
            i = i + 1;
            continue;
        }
        in_command = 1;
        vec_push(_env_cmd_argv, tok);
        i = i + 1;
    }

    var base = 0;
    if (_env_clear_env == 1) {
        base = vec_new();
    } else {
        base = _env_load_environ();
    }
    var env = _env_apply_mods(base);

    if (vec_len(_env_cmd_argv) == 0) {
        if (_env_chdir != 0) {
            k_write( 2, "kriya env: error: must specify command with --chdir (-C)\n", 57);
            return EXIT_USAGE;
        }
        _env_print(env);
        return EXIT_SUCCESS;
    }
    # -C: before the command is resolved, so `./cmd` and a relative PATH entry are found from
    # DIR, as GNU's are. ⚠ A failure is 125, GNU's: no command ran, and 1 is a status the
    # command itself could have returned.
    if (_env_chdir != 0) {
        var cr = sys_chdir(_env_chdir);
        if (cr < 0) {
            k_write( 2, "kriya env: cannot change directory to '", 39);
            k_write( 2, _env_chdir, strlen(_env_chdir));
            k_write( 2, "': ", 3);
            if (errmsg_is_known(0 - cr) == 1) {
                var cm = errmsg_for(0 - cr);
                k_write( 2, cm, strlen(cm));
            }
            k_write( 2, "\n", 1);
            return 125;
        }
    }
    return _env_exec(_env_cmd_argv, env);
}

# Help/introspection record for `env`. ⭐ Split out so `kriya --list` can
# populate it WITHOUT running the utility — one declaration feeding `--help`,
# `--help=json` and `--list` alike.
fn env_help_declare(): i64 {
    help_begin("env", "Run a command in a modified environment.",
      "env [OPTIONS] [NAME=VALUE...] [COMMAND [ARG...]]");
    help_positional(0, HELP_POS_UNBOUNDED, "NAME=VALUE,COMMAND,ARG");
    help_destructive(1);
    help_operands("Assignments and -u removals apply in the order written. With no COMMAND, the resulting environment is printed.");  #skip-lint
    help_exit(125, "-C could not change to DIR");
    help_exit(126, "the command was found but not executable");
    help_exit(127, "the command was not found");
    help_example("env");
    help_example("env -i PATH=/bin sh");
    help_example("env -u DEBUG make");
    help_example("env -C /tmp -S \"-i PATH=/bin sh -c 'pwd'\"");
    return 0;
}
