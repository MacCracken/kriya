# rmdir — POSIX `rmdir(1)`: remove empty directories.
#
# Flags:
#   -p / --parents                 also remove each non-empty prefix
#                                  of the operand, stopping at the
#                                  first non-empty parent.
#   -v / --verbose                 print a line per removed directory.
#   --ignore-fail-on-non-empty     (GNU) under -p, ENOTEMPTY on a
#                                  parent is success, not failure.
#                                  Lets best-effort cleanup scripts
#                                  cascade up without worrying about
#                                  ambient unrelated entries.
#
# rmdir never deletes a non-empty directory (POSIX) — that's `rm -r`'s
# job under ADR 0003/0004. The kernel returns ENOTEMPTY (39); we
# render it through the standard errmsg table.
#
# Symlink policy (ADR 0003): rmdir operates on the named entry. Called
# on a symlink, `sys_rmdir` returns ENOTDIR (the symlink itself is not
# a directory); no traversal, no follow. Consistent with the matrix in
# ADR 0003 — rmdir is in the same family as rm in that respect.
#
# Root protection (ADR 0004): rmdir does NOT consult `protected_paths[]`.
# ADR 0004's scope is `rm` only; the kernel already refuses rmdir("/")
# with EBUSY (Linux); and legitimate uses like `rmdir /var/empty`
# (when empty) should remain available.
#
# Error continuation: each operand is attempted in turn. Exit code is
# EXIT_FAILURE if any operand failed, EXIT_SUCCESS otherwise.

var _rmdir_spec       = 0;
var _rmdir_p_idx      = 0;
var _rmdir_v_idx      = 0;
var _rmdir_ignore_idx = 0;

fn _rmdir_init_spec(): i64 {
    if (_rmdir_spec != 0) { return 0; }
    var s = flags_new();
    _rmdir_p_idx      = flags_add_bool(s, 112, "parents", 0, "remove empty parent directories too");
    _rmdir_v_idx      = flags_add_bool(s, 118, "verbose", 0, "print a line per removed directory");
    _rmdir_ignore_idx = flags_add_bool(s,   0, "ignore-fail-on-non-empty", 0, "ENOTEMPTY is not an error (use with -p)");
    _rmdir_spec = s;
    return 0;
}

fn _rmdir_report(operand, errno): i64 {
    syscall(1, 2, "kriya rmdir: ", 13);
    syscall(1, 2, operand, strlen(operand));
    syscall(1, 2, ": ", 2);
    if (errmsg_is_known(errno) == 1) {
        var m = errmsg_for(errno);
        syscall(1, 2, m, strlen(m));
    } else {
        syscall(1, 2, "errno ", 6);
        var buf[8];
        var i: i64 = 7;
        store8(&buf + i, 0);
        i = i - 1;
        var v = errno;
        if (v == 0) { store8(&buf + i, 48); i = i - 1; }
        while (v > 0) {
            store8(&buf + i, 48 + (v - (v / 10) * 10));
            v = v / 10;
            i = i - 1;
        }
        syscall(1, 2, &buf + i + 1, 6 - i);
    }
    syscall(1, 2, "\n", 1);
    return 0;
}

fn _rmdir_verbose_print(path): i64 {
    syscall(1, 1, "kriya rmdir: removed directory '", 32);
    syscall(1, 1, path, strlen(path));
    syscall(1, 1, "'\n", 2);
    return 0;
}

# Single rmdir on a final operand. Returns 0 on success, negative
# errno on failure. `verbose`/`ignore_non_empty` toggle reporting and
# ENOTEMPTY treatment.
fn _rmdir_one(path, verbose, ignore_non_empty): i64 {
    if (strlen(path) == 0) {
        _rmdir_report(path, 2);
        return 0 - 2;
    }
    var r = sys_rmdir(path);
    if (r == 0) {
        if (verbose == 1) { _rmdir_verbose_print(path); }
        return 0;
    }
    var errno = 0 - r;
    if (ignore_non_empty == 1) {
        if (errno == 39) { return 0; }
        # On Linux some filesystems return EEXIST instead of ENOTEMPTY
        # for "directory not empty" — accept that too under
        # --ignore-fail-on-non-empty (matches GNU rmdir).
        if (errno == 17) { return 0; }
    }
    _rmdir_report(path, errno);
    return r;
}

# `rmdir -p PATH`: try to remove PATH, then walk up its prefix,
# removing each parent until one is non-empty (or we hit a relative
# root / "/"). Stops at the first non-success that isn't suppressed
# by --ignore-fail-on-non-empty.
fn _rmdir_with_parents(path, verbose, ignore_non_empty): i64 {
    var norm = path_normalize(path);
    var current = norm;

    var stop: i64 = 0;
    var last_result: i64 = 0;
    while (stop == 0) {
        var clen = strlen(current);
        if (clen == 0) { stop = 1; }
        else {
            # Stop conditions: bare root "/" or bare "." (nothing to walk further).
            if (clen == 1) {
                if (load8(current) == 47) { stop = 1; }
                if (stop == 0) {
                    if (load8(current) == 46) { stop = 1; }
                }
            }
        }
        if (stop == 0) {
            var r = _rmdir_one(current, verbose, ignore_non_empty);
            if (r != 0) {
                last_result = r;
                stop = 1;
            } else {
                # Continue up. path_dirname returns the parent in
                # canonical form. When we reach "/" or ".", the next
                # iteration's stop check fires.
                current = path_dirname(current);
            }
        }
    }
    return last_result;
}

fn cmd_rmdir(start: i64): i64 {
    _rmdir_init_spec();
    if (kriya_args_parse(_rmdir_spec, start) != 0) {
        syscall(1, 2, "kriya rmdir: error: bad option (see ADR 0002 for accepted syntax)\n", 66);
        return EXIT_USAGE;
    }

    var npos = flags_positional_count(_rmdir_spec);
    if (npos < 1) {
        syscall(1, 2, "kriya rmdir: error: missing operand (need at least one directory name)\n", 72);
        return EXIT_USAGE;
    }

    var parents: i64 = 0;
    if (flags_get_bool(_rmdir_spec, _rmdir_p_idx) == 1) { parents = 1; }
    var verbose: i64 = 0;
    if (flags_get_bool(_rmdir_spec, _rmdir_v_idx) == 1) { verbose = 1; }
    var ignore_non_empty: i64 = 0;
    if (flags_get_bool(_rmdir_spec, _rmdir_ignore_idx) == 1) { ignore_non_empty = 1; }

    var any_failed: i64 = 0;
    var i: i64 = 0;
    while (i < npos) {
        var p = flags_positional(_rmdir_spec, i);
        var r: i64 = 0;
        if (parents == 1) {
            r = _rmdir_with_parents(p, verbose, ignore_non_empty);
        } else {
            r = _rmdir_one(p, verbose, ignore_non_empty);
        }
        if (r != 0) { any_failed = 1; }
        i = i + 1;
    }

    if (any_failed == 1) { return EXIT_FAILURE; }
    return EXIT_SUCCESS;
}
