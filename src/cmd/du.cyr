# du — POSIX `du(1)`: directory-tree size.
#
# Argument shape:
#   du [opts] [FILE...]
#
# Flags:
#   -s / --summarize       only print a total for each operand
#   -a / --all             show counts for every file, not just dirs
#   -c / --total           grand total line at the end
#   -h / --human-readable  K/M/G with 1-decimal precision
#   -k                     1024-byte blocks (default — matches GNU
#                          without POSIXLY_CORRECT)
#   -b / --bytes           apparent size (st_size), not allocated blocks
#   -L / --dereference     follow symbolic links
#   -P / --no-dereference  do NOT follow (default per ADR 0003)
#   -d N / --max-depth=N   only print entries at depth <= N (counting
#                          operand at depth 0)
#   -S / --separate-dirs   do not include subdirectories in dir totals
#   -l / --count-links     count a hard-linked file once per NAME rather
#                          than once per file (turns the dedup off)
#   -x / --one-file-system do not enter a directory on another file system;
#                          it is neither counted nor listed (1.8.3)
#   --exclude=PATTERN      skip entries matching PATTERN, a glob tried against
#                          the path and every suffix after a `/` (GNU's rule;
#                          `*` crosses `/`); repeatable
#   -X F / --exclude-from=F  the patterns in F, one a line (trailing blanks
#                          trimmed, blank lines skipped, as gnulib reads them)
#   --inodes               count entries instead of sizes (-b is ignored, with
#                          GNU's warning; -h humanizes the count)
#   -0 / --null            end each output line with NUL, not newline
#
# Size accounting:
#   Default unit is the allocated 1024-byte block. The kernel reports
#   st_blocks in 512-byte units; we divide by 2 with ceiling rounding
#   so a 1-byte file shows as 1 KiB block. `-b/--apparent-size` uses
#   st_size directly (st_size byte count, rounded up to whole KiB
#   units unless `-h` overrides).
#
# Symlink policy (ADR 0003): default `-P` lstats every entry. Symbolic
# links contribute their own name-target byte count and are NOT
# descended. `-L` switches to stat (follow) at every level.
#
# Hardlink dedup (v1.6.0): a file reached under two names is counted
# ONCE. `-l`/`--count-links` turns that off and restores the pre-1.6.0
# behaviour. A repeat contributes no bytes and prints no line at all —
# not a zero line, no line — which is what GNU does.
#
# WHAT GETS TRACKED is GNU's rule (1.8.3): with two or more operands, or under -L,
# every entry the walk counts; otherwise only non-directories with more than one link,
# which is the only way a single -P walk reaches a file twice. The set is sparse
# (`fs_inobits_*`, a 512-byte bitmap per 4,096-inode chunk): /usr's 202,663 entries
# cost 43 KB. ⭐ Until 1.8.3 it was `fs_inoset`, 32 bytes an entry, so kriya tracked
# operands and multi-link files only, and `du DIR DIR/f` listed f where GNU omits it.
#
# ⛔ CYCLE DETECTION UNDER -L IS NOT PART OF THE DEDUP AND SURVIVES -l.
# `du -L` over a symlink pointing at an ancestor recursed until the stack
# died — a core dump, reproducible in three commands — because nothing
# remembered which directories the walk had already entered. GNU answers
# the same tree in milliseconds with `-l` or without it.
#

var _du_summarize:   i64 = 0;
var _du_all:         i64 = 0;
var _du_total:       i64 = 0;
var _du_human:       i64 = 0;
var _du_bytes:       i64 = 0;
var _du_follow:      i64 = 0;
var _du_max_depth:   i64 = 0;
var _du_have_depth:  i64 = 0;
var _du_sep_dirs:    i64 = 0;
var _du_grand:       i64 = 0;
var _du_count_links: i64 = 0;
var _du_xdev_on:     i64 = 0;    # -x: do not enter a directory on another file system
var _du_xdev:        i64 = 0;    # ...the current operand's device
var _du_excl:        i64 = 0;    # --exclude / -X patterns (a vec), 0 for none
var _du_inodes:      i64 = 0;    # --inodes: count entries, not sizes
var _du_null:        i64 = 0;    # -0: end each line with NUL
var _du_obuf:        i64 = 0;    # the output line, reused (see `_du_emit`)
var _du_ocap:        i64 = 0;

# The (dev, ino) sets. ⚠ Bare-literal init: a `var x = fs_inoset_new();` at
# module scope would be a non-literal initializer and cost one of the 4,096
# `gvar_toks` slots. They are built in `cmd_du` instead, once per invocation.
#   `_du_seen` — the dedup, disabled by -l.
#   `_du_path` — the directories the walk is currently INSIDE, which is cycle
#                detection and is NOT disabled by -l.
#
# ⛔ `_du_path` IS A STACK, NOT A SET, AND THE DIFFERENCE IS THE WHOLE POINT. A
# set of every directory ever entered also stops a symlink loop — and it is
# wrong: two symlinks pointing at one directory are not a loop, and GNU's
# `du -alL` counts that directory through BOTH of them (measured: 12 blocks
# across `real`, `link1` and `link2`, where the set answered 4). Only membership
# of the CURRENT PATH means "descending here would not terminate".
var _du_seen:        i64 = 0;
var _du_path:        i64 = 0;
var _du_hash_all:    i64 = 0;    # GNU's `hash_all`: 2+ operands, or -L — track every entry

# ⛔ THE WALK USED TO ALLOCATE AND NEVER FREE (1.8.3): a 4 KiB getdents buffer per directory and a
# joined path per entry, from the bump allocator. `du -s /usr` (202,663 entries) peaked at 72 MB
# where GNU's takes 7.6, and 103 MB against 12.6 under -L. 1.8.3 kept ONE getdents buffer per
# DEPTH and ONE path buffer that each level appends its name to and truncates again on the way
# out, as GNU's fts does. Since 1.8.6 the getdents buffers are the shared walk's
# (src/lib/walk.cyr): one per OPEN directory, at most 32, where one per depth was 400 MB at
# 100,000 levels.
var _du_pb:          i64 = 0;    # the path being walked, NUL-terminated at the current level
var _du_pcap:        i64 = 0;
var _du_wk:          i64 = 0;    # the walk, made in `cmd_du`

# Append `/name` to the path buffer at `plen` (no `/` after one already there, and none
# before the first name — `path_join`'s rule), growing it by doubling; the new length.
# ⚠ The buffer can MOVE, so a caller reads `_du_pb` again after any call that appends.
fn _du_path_push(plen, name): i64 {
    var nl = strlen(name);
    var sep: i64 = 0;
    if (plen > 0) {
        if (load8(_du_pb + plen - 1) != 47) { sep = 1; }
    }
    var need = plen + sep + nl + 1;
    if (need > _du_pcap) {
        var ncap = _du_pcap * 2;
        if (ncap < 4096) { ncap = 4096; }
        while (ncap < need) { ncap = ncap * 2; }
        var nb = alloc(ncap);
        if (plen > 0) { memcpy(nb, _du_pb, plen); }
        _du_pb = nb;
        _du_pcap = ncap;
    }
    if (sep == 1) { store8(_du_pb + plen, 47); }
    memcpy(_du_pb + plen + sep, name, nl);
    store8(_du_pb + plen + sep + nl, 0);
    return plen + sep + nl;
}

# Round-up division: (a + b - 1) / b.
fn _du_div_ceil(a, b): i64 {
    if (b <= 0) { return 0; }
    return (a + b - 1) / b;
}

# st_blocks (offset 64) is in 512-byte units. Convert to 1024-byte
# allocated blocks with ceiling rounding.
fn _du_block_size_1k(st): i64 {
    var b = load64(st + 64);
    return _du_div_ceil(b, 2);
}

# Apparent size: st_size (offset 48), in bytes, rounded up to 1024-byte
# units. (When `-h` overrides, we keep the byte value and let the
# formatter pick units; when default, we report KiB blocks.)
fn _du_apparent_size(st): i64 {
    return load64(st + 48);
}

# Compute the numeric size for a stat buf according to the active mode.
# Modes (in increasing complexity):
#   default:     1024-byte allocated blocks (st_blocks/2, round-up)
#   -h:          allocated bytes (st_blocks*512) — formatter picks unit
#   -b:          apparent bytes (st_size) — raw byte count
#   -b -h:       apparent bytes — formatter picks unit
fn _du_size(st): i64 {
    if (_du_inodes == 1) { return 1; }
    if (_du_bytes == 1) {
        return _du_apparent_size(st);
    }
    if (_du_human == 1) {
        return load64(st + 64) * 512;
    }
    return _du_block_size_1k(st);
}

# Format size for output. With -h, choose smallest unit where value
# < 1024 (K/M/G/T) and print with 1 decimal except K which prints whole.
# Without -h, print the integer KiB-block count as-is.
fn _du_fmt_size(buf, pos, size): i64 {
    if (_du_human == 0) {
        return _date_wint(buf, pos, size);  # signed int writer; sizes are non-negative here
    }
    if (size < 1024) {
        var p = _date_wint(buf, pos, size);
        return p;
    }
    # Pick the largest 1024^k <= size, capping at T (1024^4).
    var units = "KMGT";
    var u: i64 = 0;
    var v = size;
    while (v >= 1024) {
        v = v / 1024;
        u = u + 1;
        if (u >= 4) {
            u = 4;
            v = 0;
        }
    }
    # Recompute v at scale `u` with one-decimal precision.
    # GNU's -h shows e.g. "1.4K", "200K", "4.0G". Whole numbers omit decimals
    # when they're round; we always emit a single fractional digit when
    # below 10, omit when >= 10. Simplify: always emit `int.frac<unit>`
    # if value < 10*unit, else `int<unit>`.
    var scale: i64 = 1;
    var s: i64 = 0;
    while (s < u) { scale = scale * 1024; s = s + 1; }
    var whole = size / scale;
    if (whole >= 10) {
        # Round half-up.
        var rounded = _du_div_ceil(size, scale);
        var p = _date_wint(buf, pos, rounded);
        store8(buf + p, load8(units + (u - 1)));
        return p + 1;
    }
    # Fractional. tenths = (size mod scale) * 10 / scale, ceil.
    var rem = size - whole * scale;
    var tenths = _du_div_ceil(rem * 10, scale);
    if (tenths >= 10) {
        whole = whole + 1;
        tenths = 0;
    }
    var p = _date_wint(buf, pos, whole);
    store8(buf + p, 46);
    p = p + 1;
    store8(buf + p, 48 + tenths);
    p = p + 1;
    store8(buf + p, load8(units + (u - 1)));
    return p + 1;
}

# Emit a "SIZE\tPATH\n" line.
# ⛔ ONE REUSED BUFFER (1.8.3). Each line allocated a fresh 2 KiB buffer and never freed it, so
# `du -a /usr` peaked at 406 MB (GNU 7.9) — and copied the path into it unbounded, so a path past
# ~2 KB wrote off the end of the allocation (silent only because nothing had claimed the bump
# space after it yet). The buffer grows to the longest line instead.
fn _du_emit(size, path): i64 {
    var plen = strlen(path);
    # ⭐ The path is quoted on a terminal (GNU 9.12), never under -0.
    var quoted: i64 = 0;
    if (_du_null == 0) { quoted = quote_tty(); }
    var need = plen + 64;                          # the size field needs under 32
    if (quoted == 1) { need = quote_bufsz(plen) + 64; }
    if (need > _du_ocap) {
        var ncap = _du_ocap * 2;
        if (ncap < 4096) { ncap = 4096; }
        while (ncap < need) { ncap = ncap * 2; }
        _du_obuf = alloc(ncap);
        _du_ocap = ncap;
    }
    var buf = _du_obuf;
    var p = _du_fmt_size(buf, 0, size);
    store8(buf + p, 9);
    p = p + 1;
    if (quoted == 1) {
        p = p + quote_shell(path, plen, QUOTE_IF_NEEDED, buf + p);
    } else {
        memcpy(buf + p, path, plen);
        p = p + plen;
    }
    if (_du_null == 1) { store8(buf + p, 0); } else { store8(buf + p, 10); }
    p = p + 1;
    k_write( 1, buf, p);
    return 0;
}

# --exclude / -X: GNU's `excluded_file_name` with EXCLUDE_WILDCARDS and no EXCLUDE_ANCHORED —
# fnmatch with no flags, so `*` crosses `/`, against the whole path AND every suffix that starts
# after a `/` (not after `//`). So `sub`, `a/sub` and `*/a` all match `t/a/sub`-shaped paths, and
# a pattern naming the operand excludes it.
fn _du_excluded(path): i64 {
    if (_du_excl == 0) { return 0; }
    var n = vec_len(_du_excl);
    var plen = strlen(path);
    var k: i64 = 0;
    while (k < n) {
        var pat = vec_get(_du_excl, k);
        var pl = strlen(pat);
        if (glob_match(pat, pl, path, plen) == 1) { return 1; }
        var i: i64 = 0;
        while (i < plen) {
            if (load8(path + i) == 47) {
                if (load8(path + i + 1) != 47) {
                    if (load8(path + i + 1) != 0) {
                        if (glob_match(pat, pl, path + i + 1, plen - i - 1) == 1) { return 1; }
                    }
                }
            }
            i = i + 1;
        }
        k = k + 1;
    }
    return 0;
}

# C's isspace(): space, \t \n \v \f \r.
fn _du_ws(c): i64 {
    if (c == 32) { return 1; }
    if (c >= 9) { if (c <= 13) { return 1; } }
    return 0;
}

# -X FILE: a pattern per line, as GNU's `add_exclude_file` reads it. 0, or the negative errno.
fn _du_exclude_file(file): i64 {
    var fd = k_open(file, FS_O_CLOEXEC, 0);
    if (fd < 0) { return fd; }
    var cap: i64 = 4096;
    var buf = alloc(cap);
    var len: i64 = 0;
    var more: i64 = 1;
    while (more == 1) {
        if (len + 1024 > cap) {
            var nb = alloc(cap * 2);
            memcpy(nb, buf, len);
            buf = nb;
            cap = cap * 2;
        }
        var r = k_read( fd, buf + len, cap - len - 1);
        if (r > 0) { len = len + r; }
        elif (r != (0 - 4)) { more = 0; }
    }
    k_close(fd);
    if (_du_excl == 0) { _du_excl = vec_new(); }
    var st: i64 = 0;
    var i: i64 = 0;
    while (i <= len) {
        var at_end: i64 = 0;
        if (i == len) { at_end = 1; }
        elif (load8(buf + i) == 10) { at_end = 1; }
        if (at_end == 1) {
            # ⚠ gnulib's `add_exclude_fp`: the line end is `\n`, a space character, so it trims
            # TRAILING whitespace off each pattern and skips a line that is empty after that.
            var e = i;
            var trimming: i64 = 1;
            while (trimming == 1) {
                if (e <= st) { trimming = 0; }
                elif (_du_ws(load8(buf + e - 1)) == 0) { trimming = 0; }
                else { e = e - 1; }
            }
            if (e > st) {
                var pat = alloc(e - st + 1);
                memcpy(pat, buf + st, e - st);
                store8(pat + e - st, 0);
                vec_push(_du_excl, pat);
            }
            st = i + 1;
        }
        i = i + 1;
    }
    return 0;
}

# 1 when this entry has already been accounted for and must contribute
# nothing — no bytes to any total, and no line of output.
#
# ⭐ ONE FUNCTION FOR TWO JOBS THAT LOOK ALIKE AND ARE NOT. The first half is
# cycle detection and runs under -L whatever the dedup flags say; the second is
# the hardlink dedup and is what `-l` switches off. Folding them into one flag
# would make `du -lL` over a symlink loop crash again.
fn _du_seen_skip(st, depth): i64 {
    var is_dir = fs_is_dir(st);
    if (_du_follow == 1) {
        if (is_dir == 1) {
            if (fs_dirstack_has(_du_path, fs_dev(st), fs_ino(st)) == 1) { return 1; }
        }
    }
    if (_du_count_links == 1) { return 0; }
    # ⭐ GNU's rule exactly (1.8.3): with two or more operands, or under -L, EVERY entry is
    # tracked, so anything reached twice is counted once; otherwise only non-directories with
    # more than one link, the only way a single -P walk reaches a file twice. The sparse set
    # (`fs_inobits_*`, about a bit an entry) is what makes "every entry" affordable: with
    # `fs_inoset`'s 32 bytes an entry kriya tracked operands and multi-link files only, and
    # `du DIR DIR/f` listed f where GNU omits it.
    var track = _du_hash_all;
    if (is_dir == 0) {
        if (fs_nlink(st) > 1) { track = 1; }
    }
    if (track == 1) { return fs_inobits_add(_du_seen, fs_dev(st), fs_ino(st)); }
    return fs_inobits_has(_du_seen, fs_dev(st), fs_ino(st));
}

# ⭐ 1 when a stat that said ENOENT is about an entry that has gone since the directory read
# (1.8.7). GNU 9.12's `du` skips such an entry in silence, at exit 0 — "no longer fail merely
# because files may be being removed in parallel" — where kriya said *cannot access* and exited 1
# (22 runs in 200 of `du -a` over a churned directory; GNU's none). ⚠ Under -L, ENOENT is also a
# DANGLING SYMLINK, which is still there and still reported, as in GNU: only when the lstat agrees
# is the entry gone. ⚠ Below the operands only — a missing operand still fails.
fn _du_vanished(dirfd, fullpath, name, r): i64 {
    if (r != (0 - 2)) { return 0; }
    if (_du_follow == 0) { return 1; }
    var lst[144];
    if (fs_stat_entry(dirfd, fullpath, name, &lst, 0) == (0 - 2)) { return 1; }
    return 0;
}

# Write `kriya du: cannot access 'PATH': MESSAGE`, and fail the run.
fn _du_cannot(path, errno): i64 {
    k_write( 2, "kriya du: cannot access '", 25);
    k_write( 2, path, strlen(path));
    k_write( 2, "': ", 3);
    if (errmsg_is_known(errno) == 1) {
        var m = errmsg_for(errno);
        k_write( 2, m, strlen(m));
    }
    k_write( 2, "\n", 1);
    _du_any_failed = 1;
    return 0;
}

# ⭐ THE WALK IS A LOOP SINCE 1.8.9. It was a recursion, and with descriptors no longer the limit
# (1.8.6) the stack was: a stack guard stopped it at 10,767 levels under 8 MiB, where GNU's has no
# limit. Each directory is now a level of the shared walk (src/lib/walk.cyr), its state in the
# level's slots:
#   U0  its path's length in `_du_pb`
#   U1  `printed`, the total its own line shows (`-S` leaves subdirectories out of it)
#   U2  `full`, the true subtree total its parent and `-c` need
#   U3  1 when it was pushed on the `-L` ancestor stack
# `_du_enter` is the old function's top half and `_du_leave` its bottom half; the loop in
# `_du_tree` is the recursion between them.
enum DuSlot { DU_U_PLEN = 0, DU_U_PRINTED = 1, DU_U_FULL = 2, DU_U_PUSHED = 3, }

# Look at `name` in `parent_dirfd` (its path `_du_pb`, `plen` long) at `depth`. A directory is
# opened as level `depth` and the result is -1; anything else is accounted for here and the
# result is its size (0 when it is skipped, vanished or could not be read).
fn _du_enter(parent_dirfd, name, plen, depth): i64 {
    var display = _du_pb;
    # A pattern can name an operand: GNU then prints nothing for it, at exit 0. (Children are
    # tested by the loop, before their stat.)
    if (depth == 0) {
        if (_du_excluded(display) == 1) { return 0; }
    }
    # Stat (or lstat) the directory entry itself.
    var st[144];
    var sr: i64 = 0;
    if (_du_follow == 1) {
        sr = fs_stat_entry(parent_dirfd, display, name, &st, 1);
    } else {
        sr = fs_stat_entry(parent_dirfd, display, name, &st, 0);
    }
    if (sr != 0) {
        # Gone since the parent's loop stat'd it: nothing to count, nothing to say.
        if (depth > 0) {
            if (_du_vanished(parent_dirfd, display, name, sr) == 1) { return 0; }
        }
        _du_cannot(display, 0 - sr);
        return 0;
    }
    # -x: the operand's device is the file system this walk stays on.
    if (depth == 0) { _du_xdev = fs_dev(&st); }
    # ⚠ Before ANY accounting: a repeat contributes nothing, and for a directory
    # under -L that also means the walk does not descend into it a second time.
    if (_du_seen_skip(&st, depth) == 1) { return 0; }

    var self_size = _du_size(&st);

    # Non-directory: report as appropriate.
    if (fs_is_dir(&st) == 0) {
        # File / symlink / other: report only if -a or if depth==0.
        var should_emit: i64 = 0;
        if (depth == 0) { should_emit = 1; }
        if (_du_all == 1)       { should_emit = 1; }
        if (_du_summarize == 1) {
            if (depth != 0) { should_emit = 0; }
        }
        if (_du_have_depth == 1) {
            if (depth > _du_max_depth) { should_emit = 0; }
        }
        if (should_emit == 1) { _du_emit(self_size, display); }
        if (depth == 0) { _du_grand = _du_grand + self_size; }
        return self_size;
    }

    # Directory: a level of the shared walk, which keeps at most 32 directories open however
    # deep the tree is.
    var dir_fd: i64 = 0;
    if (_du_follow == 1) {
        # O_RDONLY | O_DIRECTORY (per-arch value, see fs.cyr).
        dir_fd = wk_open(_du_wk, depth, parent_dirfd, name, FS_O_DIRECTORY);
    } else {
        dir_fd = wk_open(_du_wk, depth, parent_dirfd, name, FS_O_DIRECTORY | FS_O_NOFOLLOW);
    }
    if (dir_fd < 0) {
        # ⭐ A directory gone before it could be opened is left out whole, its own size and its
        # line too, as GNU 9.12 does.
        if (depth > 0) {
            if (dir_fd == (0 - 2)) { return 0; }
        }
        # ⛔ A DIRECTORY THAT CANNOT BE READ STILL HAS ITS LINE (1.8.9), as GNU's FTS_DNR does:
        # *cannot read directory*, then the directory's own blocks on their line, then the walk
        # goes on. kriya said *cannot access* and printed no line, and under `-b` it added the
        # directory's st_size to its parent, where a directory counts nothing: `du -ba x` over an
        # unreadable `x/u` said 65 where GNU says 5. Pre-existing; found by comparing /etc.
        k_write( 2, "kriya du: cannot read directory '", 33);
        k_write( 2, display, strlen(display));
        k_write( 2, "': ", 3);
        if (errmsg_is_known(0 - dir_fd) == 1) {
            var rm = errmsg_for(0 - dir_fd);
            k_write( 2, rm, strlen(rm));
        }
        k_write( 2, "\n", 1);
        _du_any_failed = 1;
        var own: i64 = self_size;
        if (_du_bytes == 1) { own = 0; }
        var show: i64 = 1;
        if (_du_summarize == 1) {
            if (depth != 0) { show = 0; }
        }
        if (_du_have_depth == 1) {
            if (depth > _du_max_depth) { show = 0; }
        }
        if (show == 1) { _du_emit(own, display); }
        if (depth == 0) { _du_grand = _du_grand + own; }
        return own;
    }

    # ⚠ Ancestor bookkeeping, and ONLY under -L: without a symlink there is no
    # way back up, so a -P walk cannot cycle and need not pay the scan.
    # ⛔ A push that FAILS means the ancestor is unrecorded, which is exactly the
    # state the unbounded descent needs — so refuse to descend instead.
    var pushed: i64 = 0;
    if (_du_follow == 1) {
        if (fs_dirstack_push(_du_path, fs_dev(&st), fs_ino(&st)) != 0) {
            k_write( 2, "kriya du: cannot track directory depth: out of memory\n", 54);
            _du_any_failed = 1;
            wk_close(_du_wk, depth, display);
            return self_size;
        }
        pushed = 1;
    }

    # ⛔ TWO RUNNING TOTALS, NOT ONE, AND `-S` IS WHY. `printed` is this
    # directory's LINE — which `-S` strips subdirectories out of — while `full`
    # is the true subtree size the parent and the `-c` grand total need. One
    # variable served both, so `du -cS` reported a total that no line in its own
    # output added up to: 4 where GNU said 12, because each operand contributed
    # only its own blocks plus its direct files. Pre-existing; found while
    # measuring the dedup.
    var self_blocks: i64 = self_size;
    # In -b/--apparent-size mode, directories don't contribute their
    # own st_size — only file content bytes count toward apparent size.
    # (Matches GNU's --apparent-size dir handling.)
    if (_du_bytes == 1) { self_blocks = 0; }
    wk_set_u(_du_wk, depth, DU_U_PLEN, plen);
    wk_set_u(_du_wk, depth, DU_U_PRINTED, self_blocks);
    wk_set_u(_du_wk, depth, DU_U_FULL, self_blocks);
    wk_set_u(_du_wk, depth, DU_U_PUSHED, pushed);
    return 0 - 1;
}

# Leave level `depth`, read to its end: its line, and its full total.
fn _du_leave(depth): i64 {
    var plen = wk_u(_du_wk, depth, DU_U_PLEN);
    store8(_du_pb + plen, 0);
    var display = _du_pb;
    var printed = wk_u(_du_wk, depth, DU_U_PRINTED);
    var full = wk_u(_du_wk, depth, DU_U_FULL);
    wk_close(_du_wk, depth, display);
    if (wk_u(_du_wk, depth, DU_U_PUSHED) == 1) { fs_dirstack_pop(_du_path); }
    # ⛔ The way back up was not the way down: the walk is over, and this line is not printed.
    if (wk_broken(_du_wk) == 1) {
        _du_any_failed = 1;
        return full;
    }

    # Decide whether to print this directory line.
    var print_dir: i64 = 1;
    if (_du_summarize == 1) {
        if (depth != 0) { print_dir = 0; }
    }
    if (_du_have_depth == 1) {
        if (depth > _du_max_depth) { print_dir = 0; }
    }
    if (print_dir == 1) { _du_emit(printed, display); }

    # Grand-total accumulates the OPERAND-level subtree only (matches
    # GNU's -c semantics — sum of what the user named). ⚠ `full`, not
    # `printed`: GNU's `-c` total equals the whole tree even under `-S`.
    if (depth == 0) {
        _du_grand = _du_grand + full;
    }
    return full;
}

# Add `sz` to level `depth`'s totals: both, or only `full` for a subdirectory under -S.
fn _du_add(depth, sz, subdir): i64 {
    wk_set_u(_du_wk, depth, DU_U_FULL, wk_u(_du_wk, depth, DU_U_FULL) + sz);
    var to_line: i64 = 1;
    if (subdir == 1) {
        if (_du_sep_dirs == 1) { to_line = 0; }
    }
    if (to_line == 1) {
        wk_set_u(_du_wk, depth, DU_U_PRINTED, wk_u(_du_wk, depth, DU_U_PRINTED) + sz);
    }
    return 0;
}

# One operand, whose path is already in `_du_pb`.
fn _du_tree(op, plen0): i64 {
    if (_du_enter(0 - 100, op, plen0, 0) != (0 - 1)) { return 0; }
    var depth: i64 = 0;
    var running: i64 = 1;
    while (running == 1) {
        var ent = wk_next(_du_wk, depth);
        if (ent <= 0) {
            # ⚠ A read error ends the directory silently, as it always has here.
            var full = _du_leave(depth);
            if (depth == 0) {
                running = 0;
            } else {
                depth = depth - 1;
                # ⚠ `_du_leave` returns the FULL subtree total, never the `-S`-stripped
                # one — that distinction is the whole reason the two totals are separate.
                _du_add(depth, full, 1);
            }
            continue;
        }
        # ⛔ `dir_fd` IS FETCHED AGAIN FOR EVERY ENTRY: a child deeper than the walk's budget
        # closes this directory and reopens it under another descriptor number.
        var dir_fd = wk_fd(_du_wk, depth);
        var plen = wk_u(_du_wk, depth, DU_U_PLEN);
        var ename = fs_dent_name(ent);
        var clen = _du_path_push(plen, ename);
        var child_disp = _du_pb;
        var skip_child: i64 = 0;
        if (_du_excluded(child_disp) == 1) { skip_child = 1; }
        # Classify via lstat (or stat with -L).
        var cst[144];
        var csr: i64 = 0;
        if (skip_child == 0) {
            if (_du_follow == 1) {
                csr = fs_stat_entry(dir_fd, child_disp, ename, &cst, 1);
            } else {
                csr = fs_stat_entry(dir_fd, child_disp, ename, &cst, 0);
            }
        }
        # -x: a directory on another file system is not entered, counted or
        # listed, as GNU's FTS_XDEV skip. A non-directory there still counts.
        if (skip_child == 0) {
            if (csr == 0) {
                if (_du_xdev_on == 1) {
                    if (fs_is_dir(&cst) == 1) {
                        if (fs_dev(&cst) != _du_xdev) { skip_child = 1; }
                    }
                }
            }
        }
        # Vanished since the read: skipped like an excluded entry, in silence.
        if (skip_child == 0) {
            if (csr != 0) {
                if (_du_vanished(dir_fd, child_disp, ename, csr) == 1) { skip_child = 1; }
            }
        }
        var entered: i64 = 0;
        if (skip_child == 1) {
            csr = 0 - 1;
        } elif (csr != 0) {
            # ⛔ THIS ARM DID NOT EXIST. A child whose stat failed
            # was dropped in silence and `du` exited 0 over a tree
            # it could not fully read — and `-L` makes it easy to
            # reach, since a broken symlink answers ENOENT and a
            # self-referential one answers ELOOP where the default
            # `-P` lstat succeeds on both. GNU diagnoses and exits 1.
            _du_cannot(child_disp, 0 - csr);
        } elif (fs_is_dir(&cst) == 1) {
            var r = _du_enter(dir_fd, ename, clen, depth + 1);
            if (r == (0 - 1)) {
                entered = 1;
                depth = depth + 1;
            } else {
                _du_add(depth, r, 1);
            }
        } else {
            # ⚠ The dedup gates the BYTES and the `-a` LINE
            # together. A second hardlink name printing `0`
            # would be a different output from GNU's, which
            # omits the line entirely.
            if (_du_seen_skip(&cst, depth + 1) == 0) {
                var sz = _du_size(&cst);
                _du_add(depth, sz, 0);
                # Emit per-file lines under -a.
                var depth_ok: i64 = 1;
                if (_du_have_depth == 1) {
                    if (depth + 1 > _du_max_depth) { depth_ok = 0; }
                }
                if (_du_summarize == 1) { depth_ok = 0; }
                if (_du_all == 1) {
                    if (depth_ok == 1) { _du_emit(sz, child_disp); }
                }
                # _du_grand is operand-level only — children
                # fold into the top-level subtree below.
            }
        }
        # Back to this level's path, unless the walk went down into the child.
        if (entered == 0) { store8(_du_pb + plen, 0); }
    }
    return 0;
}

var _du_any_failed: i64 = 0;

# ⭐ THE OPTION TABLE, AND THE AUTHORITY ON WHAT IS ACCEPTED.
#
# `du` walks argv itself, so the per-letter meanings live in that walk — but
# the walk asks THIS spec whether a letter exists before dispatching on it, and
# rejects anything the spec does not carry. That makes the invariant a consumer
# needs true by construction: **every option `--help=json` advertises is
# accepted, and nothing outside the table is.** A letter added to the walk but
# not to the spec is refused at the gate rather than silently working while
# being undocumented — which is the direction that matters.
#
# ⛔ A spec the parser never consults is a second source of truth. `find` carried
# one for five releases — built, never read, never even called.
var _du_spec = 0;

fn _du_init_spec(): i64 {
    if (_du_spec != 0) { return 0; }
    var s = flags_new();
    flags_add_bool(s, 115, "summarize",      0, "only print a total for each operand");
    flags_add_bool(s, 97,  "all",            0, "show counts for every file, not just directories");
    flags_add_bool(s, 99,  "total",          0, "grand total line at the end");
    flags_add_bool(s, 104, "human-readable", 0, "K/M/G with 1-decimal precision");
    flags_add_bool(s, 107, "",               0, "1024-byte blocks (the default)");
    flags_add_bool(s, 98,  "bytes",          0, "apparent size (st_size), not allocated blocks");
    flags_add_bool(s, 76,  "dereference",    0, "follow symbolic links");
    flags_add_bool(s, 80,  "no-dereference", 0, "do not follow symlinks (default, ADR 0003)");
    flags_add_bool(s, 83,  "separate-dirs",  0, "do not include subdirectories in directory totals");
    flags_add_bool(s, 108, "count-links",    0, "count sizes many times if hard linked");
    flags_add_int(s,  100, "max-depth",      0, "only print entries at depth <= N");
    flags_add_bool(s, 120, "one-file-system", 0, "skip directories on other file systems");
    flags_add_str(s,  0,   "exclude",        0, "skip entries matching PATTERN (a glob; repeatable)");
    flags_add_str(s,  88,  "exclude-from",   0, "skip entries matching any pattern in FILE");
    flags_add_bool(s, 0,   "inodes",         0, "count inodes, not sizes");
    flags_add_bool(s, 48,  "null",           0, "end each output line with NUL, not newline");
    _du_spec = s;
    return 0;
}

# The `-d` / `--max-depth` value, or -1 after reporting it in GNU's words.
#
# ⛔ IT WRAPPED UNTIL 1.6.16: `du -d 18446744073709551617` ran at depth ONE, exit
# 0, where GNU refuses the number. Anything past 2^63 - 1 is refused now, as in
# GNU; blanks and a `+` in front are GNU's too (`du -d ' 1'`).
# ⚠ Two GNU readings stay refused, both exit 2: a NEGATIVE depth, which GNU
# clamps to 0, and hex or octal (`0x2`, and `010` as eight), since GNU reads the
# value in base 0. kriya reads decimal, as `ls -w` does (ADR 0019).
fn _du_depth_value(arg): i64 {
    var v = kriya_parse_bounded(arg, KRIYA_COUNT_MAX);
    if (v < 0) {
        report_note("du", arg, "invalid maximum depth");
        return 0 - 1;
    }
    return v;
}

fn cmd_du(start: i64): i64 {
    _du_init_spec();
    du_help_declare();
    help_if_requested(_du_spec, start);
    _du_summarize   = 0;
    _du_all         = 0;
    _du_total       = 0;
    _du_human       = 0;
    _du_bytes       = 0;
    _du_follow      = 0;
    _du_max_depth   = 0;
    _du_have_depth  = 0;
    _du_sep_dirs    = 0;
    _du_grand       = 0;
    _du_any_failed  = 0;
    _du_count_links = 0;
    _du_xdev_on     = 0;
    _du_excl        = 0;
    _du_inodes      = 0;
    _du_null        = 0;
    # ⚠ Built here, not memoized like `_du_spec`: one set per invocation, shared
    # across every operand, so a hard link is deduped ACROSS operands the way GNU
    # does — and so a second in-process `cmd_du` would not inherit the first's.
    _du_seen        = fs_inobits_new();
    _du_path        = fs_dirstack_new();

    var n_argv = kriya_argv_count();
    # ⛔ THIS WAS A FIXED 512-SLOT ARRAY WITH NO BOUND CHECK, and `du *` in a
    # directory of more than 512 entries walked straight off the end of it —
    # a heap smash from a glob, not from anything exotic. Sized to argv, which
    # is the only real bound, so the store below cannot overrun by construction.
    var operands_cap = n_argv - start;
    if (operands_cap < 1) { operands_cap = 1; }
    var operands_buf = alloc(operands_cap * 8);
    if (operands_buf == 0) {
        k_write( 2, "kriya du: out of memory\n", 24);
        return EXIT_FAILURE;
    }
    var n_operands: i64 = 0;
    var no_more_opts: i64 = 0;

    var i = start;
    while (i < n_argv) {
        var tok = kriya_arg(i);
        var tlen = strlen(tok);
        if (no_more_opts == 0) {
            if (tlen >= 2) {
                if (load8(tok) == 45) {
                    if (load8(tok + 1) == 45) {
                        if (tlen == 2) {
                            no_more_opts = 1;
                            i = i + 1;
                            continue;
                        }
                        # Long option.
                        var eq_off: i64 = 0;
                        var k: i64 = 2;
                        while (k < tlen) {
                            if (load8(tok + k) == 61) { eq_off = k; k = tlen; }
                            k = k + 1;
                        }
                        var nlen = tlen - 2;
                        if (eq_off > 0) { nlen = eq_off - 2; }
                        # ⭐ Same gate for long forms.
                        if (kriya_long_type(_du_spec, tok + 2, nlen) < 0) {
                            k_write( 2, "kriya du: error: unknown long option\n", 37);
                            return EXIT_USAGE;
                        }
                        var handled: i64 = 0;
                        if (nlen == 9) {
                            if (_seq_bytes_eq(tok + 2, "summarize", 9) == 1) { _du_summarize = 1; handled = 1; }
                            if (_seq_bytes_eq(tok + 2, "max-depth", 9) == 1) {
                                var darg: i64 = 0;
                                if (eq_off > 0) {
                                    darg = tok + eq_off + 1;
                                } else {
                                    i = i + 1;
                                    if (i >= n_argv) {
                                        k_write( 2, "kriya du: error: --max-depth requires an argument\n", 50);
                                        return EXIT_USAGE;
                                    }
                                    darg = kriya_arg(i);
                                }
                                var dval = _du_depth_value(darg);
                                if (dval < 0) { return EXIT_USAGE; }
                                _du_max_depth = dval;
                                _du_have_depth = 1;
                                handled = 1;
                            }
                        }
                        if (nlen == 3) {
                            if (_seq_bytes_eq(tok + 2, "all", 3) == 1) { _du_all = 1; handled = 1; }
                        }
                        if (nlen == 5) {
                            if (_seq_bytes_eq(tok + 2, "total", 5) == 1) { _du_total = 1; handled = 1; }
                            if (_seq_bytes_eq(tok + 2, "bytes", 5) == 1) { _du_bytes = 1; handled = 1; }
                        }
                        if (nlen == 14) {
                            if (_seq_bytes_eq(tok + 2, "human-readable", 14) == 1) { _du_human = 1; handled = 1; }
                        }
                        if (nlen == 13) {
                            if (_seq_bytes_eq(tok + 2, "separate-dirs", 13) == 1) { _du_sep_dirs = 1; handled = 1; }
                        }
                        if (nlen == 11) {
                            if (_seq_bytes_eq(tok + 2, "dereference", 11) == 1) { _du_follow = 1; handled = 1; }
                            if (_seq_bytes_eq(tok + 2, "count-links", 11) == 1) { _du_count_links = 1; handled = 1; }
                        }
                        if (nlen == 14) {
                            if (_seq_bytes_eq(tok + 2, "no-dereference", 14) == 1) { _du_follow = 0; handled = 1; }
                        }
                        if (nlen == 15) {
                            if (_seq_bytes_eq(tok + 2, "one-file-system", 15) == 1) { _du_xdev_on = 1; handled = 1; }
                        }
                        if (nlen == 6) {
                            if (_seq_bytes_eq(tok + 2, "inodes", 6) == 1) { _du_inodes = 1; handled = 1; }
                        }
                        if (nlen == 4) {
                            if (_seq_bytes_eq(tok + 2, "null", 4) == 1) { _du_null = 1; handled = 1; }
                        }
                        # --exclude=PATTERN / --exclude-from=FILE (or the value as the next word).
                        var xkind: i64 = 0;
                        if (nlen == 7) {
                            if (_seq_bytes_eq(tok + 2, "exclude", 7) == 1) { xkind = 1; }
                        }
                        if (nlen == 12) {
                            if (_seq_bytes_eq(tok + 2, "exclude-from", 12) == 1) { xkind = 2; }
                        }
                        if (xkind != 0) {
                            var xarg: i64 = 0;
                            if (eq_off > 0) {
                                xarg = tok + eq_off + 1;
                            } else {
                                i = i + 1;
                                if (i >= n_argv) {
                                    k_write( 2, "kriya du: error: --exclude needs an argument\n", 45);
                                    return EXIT_USAGE;
                                }
                                xarg = kriya_arg(i);
                            }
                            if (xkind == 1) {
                                if (_du_excl == 0) { _du_excl = vec_new(); }
                                vec_push(_du_excl, xarg);
                            } else {
                                var xr = _du_exclude_file(xarg);
                                if (xr < 0) { errmsg_report("du", xarg, 0 - xr); return EXIT_FAILURE; }
                            }
                            handled = 1;
                        }
                        if (handled == 0) {
                            k_write( 2, "kriya du: error: unknown long option\n", 37);
                            return EXIT_USAGE;
                        }
                        i = i + 1;
                        continue;
                    }
                    # Short options.
                    var p: i64 = 1;
                    var consumed_next: i64 = 0;
                    var loop: i64 = 1;
                    while (loop == 1) {
                        if (p >= tlen) {
                            loop = 0;
                        } else {
                            var c = load8(tok + p);
                            # ⭐ The spec is the gate: a letter it does not carry
                            # is rejected here, before the meaning chain below.
                            if (kriya_short_type(_du_spec, c) < 0) {
                                k_write( 2, "kriya du: error: unknown short option\n", 38);
                                return EXIT_USAGE;
                            }
                            if (c == 115) {                # -s
                                _du_summarize = 1; p = p + 1;
                            } else { if (c == 97) {        # -a
                                    _du_all = 1; p = p + 1;
                                } else { if (c == 99) {        # -c
                                        _du_total = 1; p = p + 1;
                                    } else { if (c == 104) {       # -h
                                            _du_human = 1; p = p + 1;
                                        } else { if (c == 107) {       # -k
                                                _du_bytes = 0; p = p + 1;
                                            } else { if (c == 98) {        # -b
                                                    _du_bytes = 1; p = p + 1;
                                                } else { if (c == 76) {        # -L
                                                        _du_follow = 1; p = p + 1;
                                                    } else { if (c == 80) {        # -P
                                                            _du_follow = 0; p = p + 1;
                                                        } else { if (c == 83) {        # -S
                                                                _du_sep_dirs = 1; p = p + 1;
                                                            } else { if (c == 108) {       # -l
                                                                    _du_count_links = 1; p = p + 1;
                                                                } else { if (c == 120) {       # -x
                                                                    _du_xdev_on = 1; p = p + 1;
                                                                } else { if (c == 48) {        # -0
                                                                    _du_null = 1; p = p + 1;
                                                                } else { if (c == 88) {        # -X FILE
                                                                    var xfile: i64 = 0;
                                                                    if (p + 1 < tlen) {
                                                                        xfile = tok + p + 1;
                                                                    } else {
                                                                        if (i + 1 >= n_argv) {
                                                                            k_write( 2, "kriya du: error: -X requires an argument\n", 41);  #skip-lint
                                                                            return EXIT_USAGE;
                                                                        }
                                                                        xfile = kriya_arg(i + 1);
                                                                        consumed_next = 1;
                                                                    }
                                                                    var xfr = _du_exclude_file(xfile);
                                                                    if (xfr < 0) {
                                                                        errmsg_report("du", xfile, 0 - xfr);
                                                                        return EXIT_FAILURE;
                                                                    }
                                                                    loop = 0;
                                                                } else { if (c == 100) {       # -d N
                                                                        var sarg: i64 = 0;
                                                                        if (p + 1 < tlen) {
                                                                            sarg = tok + p + 1;
                                                                        } else {
                                                                            if (i + 1 >= n_argv) {
                                                                                k_write( 2, "kriya du: error: -d requires an argument\n", 41);  #skip-lint
                                                                                return EXIT_USAGE;
                                                                            }
                                                                            sarg = kriya_arg(i + 1);
                                                                            consumed_next = 1;
                                                                        }
                                                                        var dval = _du_depth_value(sarg);
                                                                        if (dval < 0) { return EXIT_USAGE; }
                                                                        _du_max_depth = dval;
                                                                        _du_have_depth = 1;
                                                                        loop = 0;
                                                                    } else {
                                                                        k_write( 2,
                                                                          "kriya du: error: unknown short option\n",
                                                                          38);
                                                                        return EXIT_USAGE;
                                                                    } } } } } } } } } } } } } }
                        }
                    }
                    if (consumed_next == 1) { i = i + 2; } else { i = i + 1; }
                    continue;
                }
            }
        }
        # Positional (operand path).
        store64(operands_buf + n_operands * 8, tok);
        n_operands = n_operands + 1;
        i = i + 1;
    }

    # GNU's --inodes: -b (apparent size) means nothing for a count, and GNU says so.
    if (_du_inodes == 1) {
        if (_du_bytes == 1) {
            k_write( 2, "kriya du: warning: options --apparent-size and -b are ineffective with --inodes\n", 80);  #skip-lint
            _du_bytes = 0;
        }
    }

    # GNU rejects -a + -s as mutually exclusive.
    if (_du_all == 1) {
        if (_du_summarize == 1) {
            k_write( 2, "kriya du: error: cannot both summarize and show all entries\n", 60);
            return EXIT_USAGE;
        }
    }

    if (n_operands == 0) {
        # Default to ".".
        store64(operands_buf, ".");
        n_operands = 1;
    }
    _du_hash_all = 0;
    if (n_operands > 1) { _du_hash_all = 1; }
    if (_du_follow == 1) { _du_hash_all = 1; }

    if (_du_wk == 0) { _du_wk = wk_new(WK_READ, "du"); }
    var oi: i64 = 0;
    while (oi < n_operands) {
        var op = load64(operands_buf + oi * 8);
        wk_reset(_du_wk);
        _du_tree(op, _du_path_push(0, op));
        oi = oi + 1;
    }

    if (_du_total == 1) {
        _du_emit(_du_grand, "total");
    }
    if (_du_any_failed == 1) { return EXIT_FAILURE; }
    return EXIT_SUCCESS;
}

# Help/introspection record for `du`. ⭐ Split out so `kriya --list` can
# populate it WITHOUT running the utility — one declaration feeding `--help`,
# `--help=json` and `--list` alike.
fn du_help_declare(): i64 {
    help_begin("du", "Summarise disk usage of files and directories.",
      "du [OPTIONS] [FILE...]");
    help_positional(0, HELP_POS_UNBOUNDED, "FILE");
    help_operands("Reports 1024-byte blocks by default. A file reached under several names is counted once; -l counts it every time. --exclude=PATTERN skips an entry whose path, or any part of it after a `/`, matches the glob (repeatable; -X FILE reads one a line). -x does not enter directories on other file systems. --inodes counts entries instead of sizes. -0 ends each line with NUL.");  #skip-lint
    help_exit(1, "a path could not be read");
    help_example("du -sh .");
    help_example("du -a -d 1 /var");
    help_example("du -b file.bin");
    help_example("du -sl /var/cache");
    help_example("du -sh --exclude='*.o' --exclude=.git src");
    help_example("du -x --inodes -d 1 /");
    return 0;
}
