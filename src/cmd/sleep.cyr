# sleep — POSIX `sleep(1)`: pause for the given number of seconds.
#
# Accepts a non-negative decimal with an optional unit suffix:
# `1`, `1.5`, `0.25`, `1s`, `2m`, `1h`, `1d`. A bare number is seconds, as POSIX
# requires; the fractional and suffix forms are the GNU extension.
#
# ⚠ The suffix/fraction support was deferred here "until the wider duration
# parser lands in lib/chrono.cyr". Checked at pin 6.5.35: chrono has duration
# CONSTRUCTORS but no duration STRING parser, so there was nothing to wait for —
# it is `kriya_parse_duration_ms` in `src/lib/args.cyr` now.
#
# ⚠ Still one operand only. GNU sums multiple (`sleep 1m 30s`); POSIX specifies
# exactly one, and summing would make `sleep 1 2` silently mean 3 rather than an
# error. Named as a follow-up rather than assumed.

fn cmd_sleep(start: i64): i64 {
    help_begin("sleep", "Pause for a duration.",
               "sleep DURATION");
    help_positional(1, 1, "DURATION");
    help_no_options();
    help_operands("DURATION is a non-negative number with an optional s/m/h/d suffix. One operand only; GNU sums several, POSIX specifies one.");
    help_example("sleep 5");
    help_example("sleep 0.25");
    help_example("sleep 2m");
    help_if_requested(0, start);
    var n = kriya_argv_count();
    if (start >= n) {
        k_write( 2, "kriya sleep: error: expected 1 positional argument(s), got 0\n", 62);
        return EXIT_USAGE;
    }
    if (start + 1 < n) {
        k_write( 2, "kriya sleep: error: too many operands (POSIX sleep takes one integer)\n", 71);
        return EXIT_USAGE;
    }
    var arg = argv(start);
    var ms = kriya_parse_duration_ms(arg);
    if (ms < 0) {
        k_write( 2, "kriya sleep: error: DURATION must be a non-negative number with an optional s/m/h/d suffix\n", 91);
        return EXIT_USAGE;
    }
    if (ms > 0) {
        sleep_ms(ms);
    }
    return EXIT_SUCCESS;
}
