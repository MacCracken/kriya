# mv — POSIX `mv(1)`: rename files / move across filesystems.
#
# Argument shapes:
#   mv [opts] SRC DST                — rename SRC to DST
#   mv [opts] SRC... DIRECTORY       — move each SRC into DIRECTORY
#
# Flags:
#   -f / --force        overwrite without prompt (default — POSIX mv
#                       silently overwrites; this flag is here so
#                       scripts can be explicit and to override an
#                       earlier `-i`).
#   -i / --interactive  prompt before overwrite. Per ADR 0002, on
#                       non-tty stdin this is a usage error (exit 2),
#                       not a hang.
#   -n / --no-clobber   refuse to overwrite an existing destination
#                       (silently — not an error).
#   -v / --verbose      print "renamed 'src' -> 'dst'" per move.
#
# Last-one-wins precedence for -f/-i/-n is GNU's behaviour but
# requires order info the parser doesn't surface. Instead we apply:
# -n beats -i; -f beats -i; -f beats -n. Practical effect: scripts
# that want strict no-clobber pass -n alone; scripts that want
# strict overwrite pass -f alone.
#
# Symlink policy (ADR 0003):
#   - mv operates on the named entry. A source that IS a symlink is
#     renamed as a link — its target is untouched.
#   - Destination that is a symlink-to-directory is REFUSED (hard
#     rule #3). The user must `rm linkdir && mv src linkdir` to be
#     explicit, or use `ln -sfn target linkdir` for atomic retarget.
#
# Cross-filesystem moves (rename(2) returns -EXDEV / -18):
#   - Regular file: fall back to `_cp_one` + `k_unlink(src)`.
#   - Symlink: readlink + sys_symlink at dst + k_unlink(src).
#   - Directory: `_cp_recursive_one` with POLICY_P (preserve symlinks
#     per ADR 0003, preserve mode + timestamps) followed by `_rm_dir_at`
#     to drain the source tree. On either failure the destination
#     tree is best-effort rolled back so the user doesn't end up with
#     two authoritative copies — same semantic as the regular-file
#     unlink-failure rollback below.
#
# Root protection (ADR 0004): mv is not in the protected_paths scope
# (that's rm-only). The kernel returns EBUSY on rename("/", ...) and
# similar; we let that propagate.
#
# Each (SRC, DST) pair is attempted independently. Exit EXIT_FAILURE
# if any failed.

var _mv_spec  = 0;
var _mv_b_idx = 0;
var _mv_bk_idx = 0;
var _mv_S_idx = 0;
var _mv_f_idx = 0;
var _mv_i_idx = 0;
var _mv_n_idx = 0;
var _mv_v_idx = 0;

fn _mv_init_spec(): i64 {
    if (_mv_spec != 0) { return 0; }
    var s = flags_new();
    _mv_f_idx = flags_add_bool(s, 102, "force",       0, "overwrite without prompting (default)");
    _mv_i_idx = flags_add_bool(s, 105, "interactive", 0, "prompt before overwrite");
    _mv_n_idx = flags_add_bool(s, 110, "no-clobber",  0, "refuse to overwrite existing dest");
    _mv_v_idx = flags_add_bool(s, 118, "verbose",     0, "print each rename");
    # ⭐ THE BACKUP TRIO, shared with the other two utilities via
    # `src/lib/backup.cyr`. ⛔ `-b` IS SHORT-ONLY AND `--backup` REQUIRES ITS
    # VALUE, because GNU's `--backup[=CONTROL]` is an optional-value flag and
    # ADR 0002 rule 3 forbids those — the same split `tee` got for `-p` and
    # `--output-error=MODE` at 1.6.4.
    _mv_b_idx  = flags_add_bool(s, 98, 0, 0, "back up each existing destination");
    _mv_bk_idx = flags_add_str(s, 0, "backup", 0, "none|off|numbered|t|existing|nil|simple|never");
    _mv_S_idx  = flags_add_str(s, 83, "suffix", 0, "simple-backup suffix (implies -b)");
    _mv_spec = s;
    mv_help_declare();
    return 0;
}

# Help/introspection record for `mv`. ⭐ Split out so `kriya --list` can
# populate it WITHOUT running the utility — one declaration feeding `--help`,
# `--help=json` and `--list` alike.
fn mv_help_declare(): i64 {
    help_begin("mv", "Move or rename files and directories.",
               "mv [OPTIONS] SOURCE... DEST");
    help_positional(2, HELP_POS_UNBOUNDED, "SOURCE,DEST");
    help_destructive(1);
    help_operands("A same-filesystem move is a rename; across filesystems it is a copy followed by a removal. ⚠ If the copy succeeds and the source removal fails, the destination is KEPT and the failure reported (ADR 0009). -b honours $VERSION_CONTROL and $SIMPLE_BACKUP_SUFFIX (ADR 0017); the command line wins.");  #skip-lint
    help_exit(1, "a move failed");
    help_example("mv old.txt new.txt");
    help_example("mv -n a.txt b.txt /tmp/");
    help_example("mv build/ /var/tmp/build/");
    return 0;
}

# ⭐ ONE LINE NOW. The 24-line body this replaces was byte-identical in every
# utility apart from the name; `errmsg_report` in `src/lib/report.cyr` is the
# single implementation of architecture 001's framing, and it shell-quotes the
# operand so a name containing a newline cannot split the diagnostic in two.
fn _mv_report(operand, errno): i64 { return errmsg_report("mv", operand, errno); }

fn _mv_isatty(fd): i64 {
    # Portable tty probe: k_isatty does the ioctl(TCGETS) on Linux and
    # returns 0 on agnos (no ioctl/termios) — so -i prompting is never
    # interactive on agnos and falls through to the non-tty path.
    if (k_isatty(fd) == 1) { return 1; }
    return 0;
}

fn _mv_prompt(dst): i64 {
    k_write( 2, "kriya mv: overwrite '", 21);
    k_write( 2, dst, strlen(dst));
    k_write( 2, "'? ", 3);
    var c[8];
    var n = k_read( 0, &c, 8);
    if (n < 1) { return 0; }
    var ch = load8(&c);
    if (ch == 121) { return 1; }
    if (ch == 89)  { return 1; }
    return 0;
}

fn _mv_is_dir_path(path): i64 {
    var buf[144];
    var r = k_stat(path, &buf);
    if (r != 0) { return 0; }
    if (fs_is_dir(&buf) == 1) { return 1; }
    return 0;
}

# Is `path` a symlink whose target is a directory? Used for the
# ADR 0003 hard refusal: mv must not overwrite a symlink-to-dir.
fn _mv_is_symlink_to_dir(path): i64 {
    var l[144];
    var lr = fs_lstat_at(0 - 100, path, &l);  # lstat
    if (lr != 0) { return 0; }
    if (fs_is_lnk(&l) == 0) { return 0; }
    var s[144];
    var sr = k_stat(path, &s);
    if (sr != 0) { return 0; }
    if (fs_is_dir(&s) == 1) { return 1; }
    return 0;
}

fn _mv_verbose(src, dst): i64 {
    k_write( 1, "renamed '", 9);
    k_write( 1, src, strlen(src));
    k_write( 1, "' -> '", 6);
    k_write( 1, dst, strlen(dst));
    k_write( 1, "'\n", 2);
    return 0;
}

# Cross-FS regular-file move: lstat src (to decide between regular
# file and symlink), copy + unlink. Returns 0 / negative errno.
fn _mv_cross_fs(src, dst, src_st, verbose): i64 {
    if (fs_is_lnk(src_st) == 1) {
        # Symlink: replicate by reading the target text and recreating.
        # k_readlink does readlink(2) on Linux and returns -38 (ENOSYS)
        # on agnos (no symlinks) — n < 0 there routes to the error path.
        var link_buf = alloc(4096);
        var n = k_readlink(src, link_buf, 4095);
        if (n < 0) {
            _mv_report(src, 0 - n);
            return n;
        }
        store8(link_buf + n, 0);
        # If dst already exists as a symlink or regular file, we already
        # would have handled the existence check. Symlink creation
        # needs a clean target; remove whatever's there.
        k_unlink(dst);
        var sr = k_symlink(link_buf, dst);
        if (sr != 0) {
            _mv_report(dst, 0 - sr);
            return sr;
        }
        # ⛔ THE LINK'S OWN OWNERSHIP AND TIMESTAMPS TRAVEL WITH IT. This arm
        # recreates the symlink directly rather than going through `cp`, so it
        # also missed the metadata `cp` learned to carry at v1.6.1 — a
        # cross-filesystem move of a symlink arrived owned by the caller and
        # stamped now, which is the exact surface M8 audit row 35351 names.
        # Measured against GNU, which keeps both.
        _cp_symlink_meta(0 - 100, dst, src_st, CP_PRES_MV);
        # Unlink the source symlink.
        var ur = k_unlink(src);
        if (ur != 0) {
            _mv_report(src, 0 - ur);
            return ur;
        }
        if (verbose == 1) { _mv_verbose(src, dst); }
        return 0;
    }

    if (fs_is_dir(src_st) == 1) {
        # Cross-FS directory move: cp -R (POLICY_P preserves symlinks
        # per ADR 0003; preserve=1 carries mode + timestamps) followed
        # by rm -r of the source.
        #
        # ⛔ THE ROLLBACK BELONGS TO EXACTLY ONE OF THESE TWO FAILURES (ADR 0009).
        # If the COPY failed, the source is untouched and the destination is a
        # useless fragment — deleting it loses nothing. If the copy SUCCEEDED and
        # the source removal failed, the destination is the ONLY complete copy of
        # everything `_rm_dir_at` already drained, because a recursive removal
        # partially succeeds. Rolling back there destroyed the data outright.
        #
        # Measured before ADR 0009: with the source's PARENT unwritable, so the
        # final rmdir fails after the contents are gone, `mv ro/tree /other/moved`
        # left `ro/tree` empty AND deleted the destination — both files gone from
        # the filesystem. GNU keeps the destination and reports the removal error.
        # ⛔ A NON-EMPTY DESTINATION DIRECTORY IS REFUSED, and it was not — which
        # made `mv` DESTROY DATA and disagree with itself depending on which
        # filesystem the operands were on. The same-filesystem arm gets this free
        # from `rename()`, which answers ENOTEMPTY; the cross-filesystem arm went
        # straight to `cp -R -f`, MERGED the source over whatever was there,
        # overwrote same-named files, exited 0 and removed the source.
        #
        # ⚠ Worse on failure: the ADR-0009 rollback below then recursively
        # deletes `dst` — a destination this `mv` did not create — so a copy that
        # failed halfway took the user's pre-existing tree with it.
        #
        # Measured: `mv tree DEST/` with `DEST/tree/shared.txt` already there gave
        # `FROM-SOURCE` and exit 0 under kriya, against GNU's exit 1 and
        # `unable to remove target: Directory not empty` with both trees intact.
        # ⚠ An EMPTY destination directory is still replaced — that is what
        # `rename()` allows on one filesystem, and what GNU does across two.
        var dst_probe[144];
        if (fs_lstat_at(0 - 100, dst, &dst_probe) == 0) {
            if (fs_is_dir(&dst_probe) == 1) {
                if (fs_dir_is_empty(dst) == 0) {
                    _mv_report(dst, 39);                     # ENOTEMPTY
                    return 0 - 39;
                }
            }
        }
        var cr = _cp_recursive_one(src, dst, 0, 1, 0, CP_PRES_MV, 0);
        if (cr != 0) {
            _rm_dir_at(0 - 100, dst, dst, 1, 0, 0);   # copy failed: source intact
            return cr;
        }
        var rr = _rm_dir_at(0 - 100, src, src, 1, 0, 0);
        if (rr != 0) {
            # Copy is durable — KEEP it. Two visible trees beat zero.
            # ⚠ No `_mv_report` here: `_rm_dir_at` has already printed the failure.
            # It carries a `kriya rm:` prefix inside an `mv` invocation, which is
            # accurate but leaks the implementation; GNU says `mv: cannot remove`.
            # One slightly-mislabelled line beats two identical ones.
            return rr;
        }
        if (verbose == 1) { _mv_verbose(src, dst); }
        return 0;
    }

    if (fs_is_reg(src_st) == 0) {
        # FIFO / sock / char / block: we don't synthesise these.
        k_write( 2, "kriya mv: ", 10);
        k_write( 2, src, strlen(src));
        k_write( 2, ": cannot move across filesystems (unsupported file type)\n", 57);
        return 0 - 22;
    }

    # Regular file: cp_one (which follows POSIX semantics: stats src,
    # opens both, copies bytes, preserves mode and times when asked).
    # We always pass preserve=1 for mv since the move should retain
    # the file's identity/metadata.
    # ⚠ CP_PRES_MV, not a bare 1 and not CP_PRES_P. `preserve` became a
    # CpPreserve bitmask at v1.6.0, and at v1.6.1 a cross-filesystem move carries
    # EVERYTHING a rename would have kept — mode, ownership, timestamps and
    # extended attributes. ⛔ Dropping the last two was M8 audit rows 35351 and
    # 35354, measured live against GNU: `mv` a group-owned file with a `user.*`
    # attribute across a filesystem boundary and GNU kept both while kriya kept
    # neither.
    var r = _cp_one(src, dst, 1, 0, CP_PRES_MV, 0);  # force=1, interactive=0, verbose=0
    if (r != 0) { return r; }

    var ur = k_unlink(src);
    if (ur != 0) {
        # cp succeeded but src could not be unlinked. Same rule as the directory
        # branch (ADR 0009): once the copy is durable the destination stays.
        # ⚠ Benign here — a single unlink either works or leaves the source whole,
        # so the old rollback lost nothing. It is unified anyway so the rule is
        # one sentence rather than a per-branch judgement, and so `mv` matches GNU.
        _mv_report(src, 0 - ur);
        return ur;
    }
    if (verbose == 1) { _mv_verbose(src, dst); }
    return 0;
}

# Move one SRC to DST. Returns 0 or negative errno; 0 - 9999 is the
# invocation-wide -i-on-non-tty sentinel (matches cp.cyr's pattern).
fn _mv_one(src, dst, force, interactive, no_clobber, verbose): i64 {
    # Stat source. We need to know its type and inode for the
    # self-move and cross-FS checks. Use lstat so a source-symlink
    # is treated as a link (POSIX).
    var src_st[144];
    var sr = fs_lstat_at(0 - 100, src, &src_st);  # fstatat AT_SYMLINK_NOFOLLOW
    if (sr != 0) {
        _mv_report(src, 0 - sr);
        return sr;
    }

    # Destination existence + ADR 0003 hard rule #3 check.
    var dst_st[144];
    var dr = fs_lstat_at(0 - 100, dst, &dst_st);  # lstat dst
    if (dr == 0) {
        # Self-move: same dev + ino — silent no-op per POSIX/GNU.
        if (load64(&src_st + 0) == load64(&dst_st + 0)) {
            if (load64(&src_st + 8) == load64(&dst_st + 8)) {
                k_write( 2, "kriya mv: '", 11);
                k_write( 2, src, strlen(src));
                k_write( 2, "' and '", 7);
                k_write( 2, dst, strlen(dst));
                k_write( 2, "' are the same file\n", 20);
                return 0 - 17;
            }
        }
        # ADR 0003 hard rule #3: refuse to overwrite a symlink-to-dir.
        if (fs_is_lnk(&dst_st) == 1) {
            if (_mv_is_symlink_to_dir(dst) == 1) {
                k_write( 2, "kriya mv: ", 10);
                k_write( 2, dst, strlen(dst));
                k_write( 2, ": refusing to overwrite symbolic link to directory\n", 51);
                return 0 - 1;
            }
        }
        # Existing dest gating: -n silent skip, -i prompt, -f / default
        # silent overwrite.
        if (no_clobber == 1) {
            # Silent skip — not an error.
            return 0;
        }
        if (force == 0) {
            if (interactive == 1) {
                if (_mv_isatty(0) == 0) {
                    k_write( 2, "kriya mv: error: -i requires stdin to be a terminal\n", 52);
                    return 0 - 9999;
                }
                if (_mv_prompt(dst) == 0) { return 0; }
            }
        }
        # ⭐ AFTER `-n` AND THE PROMPT, NOT BEFORE. `mv -n` is a silent skip, and
        # a backup taken before that check would move the destination aside for a
        # move that then does not happen — losing the file `-n` exists to
        # protect. Measured against GNU: `mv -bn src dst` makes no backup.
        #
        # ⚠ It also has to precede BOTH move paths — the `rename(2)` below and
        # the cross-filesystem copy — which it does by sitting above the branch.
        if (backup_control() != BACKUP_NONE) {
            var bkr = backup_make(dst);
            if (bkr != 0) {
                _mv_report(dst, 0 - bkr);
                return bkr;
            }
        }
    } else {
        if (interactive == 1) {
            if (_mv_isatty(0) == 0) {
                k_write( 2, "kriya mv: error: -i requires stdin to be a terminal\n", 52);
                return 0 - 9999;
            }
        }
    }

    # Try the cheap path: rename(2). Same-FS success in one syscall,
    # atomic. EXDEV means cross-FS; fall back to copy+unlink.
    var rr = fs_rename(src, dst);
    if (rr == 0) {
        if (verbose == 1) { _mv_verbose(src, dst); }
        return 0;
    }

    var rerr = 0 - rr;
    if (rerr == 18) {
        # EXDEV — cross-filesystem move.
        return _mv_cross_fs(src, dst, &src_st, verbose);
    }

    # Other failures: report and bail.
    _mv_report(dst, rerr);
    return rr;
}

fn cmd_mv(start: i64): i64 {
    _mv_init_spec();
    if (kriya_args_parse(_mv_spec, start) != 0) {
        k_write( 2, "kriya mv: error: bad option (see ADR 0002 for accepted syntax)\n", 63);
        return EXIT_USAGE;
    }
    # ⛔ RESOLVED ONCE, BEFORE ANY OPERAND IS TOUCHED. An invalid control name is
    # a usage error and GNU performs no copy at all — measured:
    # `VERSION_CONTROL=bogus cp -b src dst` exits 1 with the destination
    # unchanged. Resolving per operand would back some of them up and then fail.
    var _bk = backup_resolve(flags_get_bool(_mv_spec, _mv_b_idx),
                             flags_get_str(_mv_spec, _mv_bk_idx),
                             flags_get_str(_mv_spec, _mv_S_idx));
    if (_bk == BACKUP_INVALID) {
        k_write( 2, "kriya mv: error: invalid backup control ", 40);
        k_write( 2, "(want none, off, numbered, t, existing, nil, simple or never)\n", 62);
        return EXIT_USAGE;
    }

    var npos = flags_positional_count(_mv_spec);
    if (npos < 2) {
        k_write( 2, "kriya mv: error: missing operand (need SRC and DST)\n", 52);
        return EXIT_USAGE;
    }

    var force: i64 = 0;
    if (flags_get_bool(_mv_spec, _mv_f_idx) == 1) { force = 1; }
    var interactive: i64 = 0;
    if (flags_get_bool(_mv_spec, _mv_i_idx) == 1) { interactive = 1; }
    var no_clobber: i64 = 0;
    if (flags_get_bool(_mv_spec, _mv_n_idx) == 1) { no_clobber = 1; }
    var verbose: i64 = 0;
    if (flags_get_bool(_mv_spec, _mv_v_idx) == 1) { verbose = 1; }

    # ADR 0002 hard rule #4 enforcement is invocation-wide: if the
    # user asked for interactive prompts and stdin is not a tty,
    # the flag is misused regardless of whether any specific operand
    # would have triggered a prompt.
    if (interactive == 1) {
        if (_mv_isatty(0) == 0) {
            k_write( 2, "kriya mv: error: -i requires stdin to be a terminal\n", 52);
            return EXIT_USAGE;
        }
    }

    var dst_arg = flags_positional(_mv_spec, npos - 1);

    # ADR 0003 hard rule #3 applies to the destination operand
    # regardless of arg-shape. Refuse the whole invocation if the
    # last operand is a symlink-to-directory — even in the
    # multi-into-dir shape where the user might have meant "drop
    # files into the link's target". The explicit path is to
    # `rm linkdir && mv ...` or use `ln -sfn` for atomic retarget.
    if (_mv_is_symlink_to_dir(dst_arg) == 1) {
        k_write( 2, "kriya mv: ", 10);
        k_write( 2, dst_arg, strlen(dst_arg));
        k_write( 2, ": refusing to overwrite symbolic link to directory\n", 51);
        return EXIT_FAILURE;
    }

    var dst_is_dir = _mv_is_dir_path(dst_arg);

    var any_failed: i64 = 0;
    if (dst_is_dir == 0) {
        if (npos != 2) {
            k_write( 2, "kriya mv: error: with multiple sources, the last operand must be a directory\n", 77);
            return EXIT_USAGE;
        }
        var src = flags_positional(_mv_spec, 0);
        var r = _mv_one(src, dst_arg, force, interactive, no_clobber, verbose);
        if (r != 0) { any_failed = 1; }
        if (r == (0 - 9999)) { return EXIT_USAGE; }
    } else {
        var i: i64 = 0;
        while (i < npos - 1) {
            var src = flags_positional(_mv_spec, i);
            var base = path_basename_ptr(src);
            var dst = path_join(dst_arg, base);
            var r = _mv_one(src, dst, force, interactive, no_clobber, verbose);
            if (r != 0) { any_failed = 1; }
            if (r == (0 - 9999)) { return EXIT_USAGE; }
            i = i + 1;
        }
    }

    if (any_failed == 1) { return EXIT_FAILURE; }
    return EXIT_SUCCESS;
}
