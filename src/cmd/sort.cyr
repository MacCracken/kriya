# sort — POSIX `sort(1)`: sort, merge or check lines of text.
#
# Argument shape:
#   sort [opts] [file...]
#
# Ordering options, for the whole line or as a key's own letters (`-k2,2n`):
#   -b  skip leading blanks              -d  dictionary order: blanks and alphanumerics only
#   -f  fold lower case to upper case    -i  skip non-printing bytes
#   -g  general numeric (strtold)        -h  human numeric (`2K` < `1M`)
#   -M  month names (`JAN` < `DEC`)      -n  numeric (digit strings, any length)
#   -R  random: the key's salted MD5     -V  version order (gnulib's filevercmp)
#   -r  reverse
# Other options:
#   -k POS1[,POS2]   a key, `F[.C][OPTS][,F[.C][OPTS]]`; every `-k` is one more key, in order.
#   -t SEP           one-byte field separator, `\0` for NUL.
#   -c, --check[=diagnose-first]     exit 1 at the first disorder, and say where.
#   -C, --check=quiet|silent         the same, silently.
#   -m               merge files that are already sorted.
#   -o FILE          write to FILE, which may be one of the inputs.
#   -s               stable: lines that tie on every key keep their input order.
#   -u               only the first line of each run of equal keys.
#   -z               lines end in NUL.
#   -S SIZE          memory before temporary files: K M G T ... (powers of 1024), b, N%; KiB alone.
#   -T DIR           temporary files in DIR; repeat for several, used in turn.
#   --sort=WORD      general-numeric, human-numeric, month, numeric, random or version.
#   --random-source=FILE   salt `-R` with FILE's first 16 bytes instead of getrandom.
#
# Exit status, as POSIX and GNU: 0 sorted (or checked and in order), 1 `-c`/`-C` found the input
# out of order, 2 for every error. ⛔ Read errors exited 1 until 1.9.1, which under `-c` is the
# answer "not sorted".
#
# ⭐ THE KEY MODEL IS GNU'S `sort.c`, FUNCTION FOR FUNCTION (1.9.1): `begfield`, `limfield`,
# `keycompare` and `compare`, the key letters' inheritance from the global options, the
# incompatible-option check and `mergefps`. Each comparator is the one GNU calls: `strnumcmp` for
# `-n`, `strtold` for `-g` (the x86 `long double`, as xfloat reads it — ADR 0032), the unit table
# for `-h`, `getmonth`, `filenvercmp` (src/lib/vercmp.cyr) and an MD5 of a salted key for `-R`
# (src/lib/md5.cyr), so `--random-source=FILE` gives GNU's shuffle byte for byte. Everything is
# the C locale, which is the only one kriya has.
#
# **Stable merge sort** over records that point into one input buffer: no key is copied unless a
# comparator needs a transformed or NUL-terminated copy (`-d`/`-i`/`-f` under `-V`/`-R`, and `-g`).
# The first key's bounds are found once per line, as GNU's `fillbuf` finds them, and so are its
# MD5 digest under `-R` and its value under `-g`.
#
# Memory: a budget of 512 MiB (`-S SIZE`) for the input and its line records together. Past it,
# since 1.9.2, sorted runs go to temporary files in `-T DIR` (or $TMPDIR, or /tmp) and are merged,
# `-m` merges its inputs from runs, and `-c` checks a buffer at a time: see "beyond memory".
#
# ⛔ HISTORY THAT SHAPED THIS (each pinned in scripts/smoke-sort.sh):
#   - A repeated `-k` kept only the LAST key until 1.9.1: `sort -k2,2 -k1,1` sorted by field 1,
#     exit 0. Every `-k` is now collected in command-line order.
#   - `-f` folded to LOWER case until 1.9.1. GNU folds to upper, and the six bytes between `Z`
#     and `a` show it: `sort -f` of `_` and `a` puts `a` first.
#   - Files were concatenated before lines were split, so a file without a final newline ran into
#     the next file's first line. Each file's last line ends where the file does, as in GNU.
#   - `-k F` meant `-k F,F`, and `-k F1,F2` was cut to F1, until 1.3.3; a field skipped the blanks
#     in front of it, and `-n` parsed into an i64, until 1.6.16.

var _so_spec = 0;
var _so_n_idx = 0;
var _so_r_idx = 0;
var _so_u_idx = 0;
var _so_f_idx = 0;
var _so_b_idx = 0;
var _so_t_idx = 0;
var _so_k_idx = 0;
var _so_c_idx = 0;
var _so_o_idx = 0;
var _so_z_idx = 0;
var _so_s_idx = 0;
var _so_d_idx = 0;
var _so_g_idx = 0;
var _so_h_idx = 0;
var _so_i_idx = 0;
var _so_mm_idx = 0;
var _so_rr_idx = 0;
var _so_v_idx = 0;
var _so_m_idx = 0;
var _so_cc_idx = 0;
var _so_sort_idx = 0;
var _so_rs_idx = 0;
var _so_ss_idx = 0;
var _so_tt_idx = 0;

var _SORT_READ_BUFSZ: i64 = 65536;

# Every error is 2, as POSIX's ">1" and GNU's SORT_FAILURE; 1 is only ever "out of order".
enum SoExit {
    SO_EXIT_TROUBLE = 2;
}

fn _so_init_spec(): i64 {
    if (_so_spec != 0) { return 0; }
    var s = flags_new();
    _so_n_idx = flags_add_bool(s, 110, "numeric-sort",         0, "compare leading numbers");
    _so_r_idx = flags_add_bool(s, 114, "reverse",              0, "reverse the sort");
    _so_u_idx = flags_add_bool(s, 117, "unique",               0, "output only the first of equal lines");
    _so_f_idx = flags_add_bool(s, 102, "ignore-case",          0, "fold lower case to upper case");
    _so_b_idx = flags_add_bool(s, 98,  "ignore-leading-blanks", 0, "skip leading blanks in keys");
    _so_d_idx = flags_add_bool(s, 100, "dictionary-order",     0, "compare only blanks and alphanumerics");
    _so_g_idx = flags_add_bool(s, 103, "general-numeric-sort", 0, "compare as floating-point numbers");
    _so_h_idx = flags_add_bool(s, 104, "human-numeric-sort",   0, "compare numbers with K, M, G suffixes");
    _so_i_idx = flags_add_bool(s, 105, "ignore-nonprinting",   0, "skip non-printing bytes");
    _so_mm_idx = flags_add_bool(s, 77, "month-sort",           0, "compare month names");
    _so_rr_idx = flags_add_bool(s, 82, "random-sort",          0, "shuffle, grouping equal keys");
    _so_v_idx = flags_add_bool(s, 86,  "version-sort",         0, "compare version numbers");
    _so_sort_idx = flags_add_str(s, 0, "sort",                 0, "sort by WORD: general-numeric, human-numeric, ...");
    _so_rs_idx = flags_add_str(s, 0,   "random-source",        0, "salt -R from FILE");
    _so_ss_idx = flags_add_str(s, 83,  "buffer-size",          0, "use SIZE of memory before temporary files");
    _so_tt_idx = flags_add_str(s, 84,  "temporary-directory",  0, "temporary files in DIR (repeatable)");
    _so_t_idx = flags_add_str(s,  116, "field-separator",      0, "field separator (1 byte)");
    _so_k_idx = flags_add_str(s,  107, "key",                  0, "sort key POS1[,POS2]; repeatable");
    _so_c_idx = flags_add_bool(s, 99,  "check",                0, "check the input is sorted");
    _so_cc_idx = flags_add_bool(s, 67, 0,                      0, "check the input is sorted, silently");
    _so_m_idx = flags_add_bool(s, 109, "merge",                0, "merge already-sorted files");
    _so_o_idx = flags_add_str(s,  111, "output",               0, "write output to FILE");
    _so_z_idx = flags_add_bool(s, 122, "zero-terminated",      0, "NUL-separated lines");
    _so_s_idx = flags_add_bool(s, 115, "stable",               0, "keep lines with equal keys in input order");
    _so_spec = s;
    sort_help_declare();
    return 0;
}

# Help/introspection record for `sort`. ⭐ Split out so `kriya --list` can
# populate it WITHOUT running the utility — one declaration feeding `--help`,
# `--help=json` and `--list` alike.
fn sort_help_declare(): i64 {
    help_begin("sort", "Sort, merge or check lines of text.",
      "sort [OPTIONS] [FILE...]");
    help_positional(0, HELP_POS_UNBOUNDED, "FILE");
    help_destructive(1);
    help_operands("Sorts in memory up to -S (512 MiB), then through temporary files in -T DIR, $TMPDIR or /tmp.");
    help_exit(1, "-c or -C found the input out of order");
    help_exit(2, "a usage error, or a file could not be read or written");
    help_example("sort names.txt");
    help_example("sort -n -r nums");
    help_example("sort -t: -k3,3n -k1,1 /etc/passwd");
    return 0;
}

# ⭐ ONE LINE NOW. The 24-line body this replaces was byte-identical in every
# utility apart from the name; `errmsg_report` in `src/lib/report.cyr` is the
# single implementation of architecture 001's framing, and it shell-quotes the
# operand so a name containing a newline cannot split the diagnostic in two.
fn _so_report(operand, errno): i64 { return errmsg_report("sort", operand, errno); }

fn _so_say(msg): i64 {
    k_write( 2, "kriya sort: ", 12);
    k_write( 2, msg, strlen(msg));
    k_write( 2, "\n", 1);
    return 0;
}

# --- byte classes: GNU's `inittables` in the C locale -----------------------------------------
#
# A blank is space, tab or newline — the newline matters only under `-z`. `-d` skips what is
# neither blank nor alphanumeric, `-i` what is not printable, `-f` maps through `toupper`.
var _so_t_blank = 0;
var _so_t_dict = 0;
var _so_t_print = 0;
var _so_t_upper = 0;

fn _so_tables(): i64 {
    if (_so_t_blank != 0) { return 0; }
    _so_t_blank = alloc(256);
    _so_t_dict = alloc(256);
    _so_t_print = alloc(256);
    _so_t_upper = alloc(256);
    var c: i64 = 0;
    while (c < 256) {
        var bl: i64 = 0;
        if (c == 32) { bl = 1; }
        if (c == 9) { bl = 1; }
        if (c == 10) { bl = 1; }
        store8(_so_t_blank + c, bl);
        var alnum: i64 = 0;
        if (c >= 48) { if (c <= 57) { alnum = 1; } }
        if (c >= 65) { if (c <= 90) { alnum = 1; } }
        if (c >= 97) { if (c <= 122) { alnum = 1; } }
        var nd: i64 = 0;
        if (bl == 0) { if (alnum == 0) { nd = 1; } }
        store8(_so_t_dict + c, nd);
        var np: i64 = 1;
        if (c >= 32) { if (c <= 126) { np = 0; } }
        store8(_so_t_print + c, np);
        var up = c;
        if (c >= 97) { if (c <= 122) { up = c - 32; } }
        store8(_so_t_upper + c, up);
        c = c + 1;
    }
    return 0;
}

fn _so_blank(c): i64 { return load8(_so_t_blank + c); }

# --- keys ----------------------------------------------------------------------------------------
#
# A key is GNU's `struct keyfield`. Field and character counts are zero-based, as GNU stores them
# after parsing: `-k2.3` is SWORD 1, SCHAR 2. SWORD -1 is GNU's SIZE_MAX, "from the start of the
# line", and EWORD -1 "to its end". A count too large for an i64 saturates, where GNU's saturates
# at SIZE_MAX; both are past any line.
enum SoKey {
    SO_K_SWORD  = 0;
    SO_K_SCHAR  = 8;
    SO_K_EWORD  = 16;
    SO_K_ECHAR  = 24;
    SO_K_SKIPS  = 32;    # -b at the start
    SO_K_SKIPE  = 40;    # -b at the end
    SO_K_IGNORE = 48;    # 0, or the table of bytes to skip (-d or -i)
    SO_K_TRANS  = 56;    # 0, or the fold table (-f)
    SO_K_NUM    = 64;
    SO_K_GEN    = 72;
    SO_K_HUM    = 80;
    SO_K_MON    = 88;
    SO_K_VER    = 96;
    SO_K_RAND   = 104;
    SO_K_REV    = 112;
    SO_K_SZ     = 120;
}

fn _so_key_new(): i64 {
    var k = alloc(SO_K_SZ);
    var o: i64 = 0;
    while (o < SO_K_SZ) { store64(k + o, 0); o = o + 8; }
    store64(k + SO_K_EWORD, 0 - 1);
    return k;
}

# The keys in comparison order: every `-k`, or the global options alone when there is none.
var _so_keys = 0;
var _so_nkeys = 0;
var _so_gkey = 0;

# -1 for blank-separated fields, else the separator byte.
var _so_tab = 0 - 1;

# `-u`, `-s` and the global `-r`, for `_so_compare`.
var _so_unique = 0;
var _so_stable = 0;
var _so_reverse = 0;

# GNU's `set_ordering`: the letters at `s + pos`, onto `key`. `bl` is 1 for a key's start, 2 for
# its end and 3 for a global option, which decides what `b` sets. Returns the position of the
# first byte that is not one.
fn _so_set_ordering(s, pos, key, bl): i64 {
    var p = pos;
    var going: i64 = 1;
    while (going == 1) {
        var c = load8(s + p);
        var known: i64 = 1;
        if (c == 98) {
            if (bl != 2) { store64(key + SO_K_SKIPS, 1); }
            if (bl != 1) { store64(key + SO_K_SKIPE, 1); }
        } elif (c == 100) { store64(key + SO_K_IGNORE, _so_t_dict); }
        elif (c == 102) { store64(key + SO_K_TRANS, _so_t_upper); }
        elif (c == 103) { store64(key + SO_K_GEN, 1); }
        elif (c == 104) { store64(key + SO_K_HUM, 1); }
        elif (c == 105) {
            # `-d` implies `-i`, so an `i` never overrides a `d`, in either order.
            if (load64(key + SO_K_IGNORE) == 0) { store64(key + SO_K_IGNORE, _so_t_print); }
        } elif (c == 77) { store64(key + SO_K_MON, 1); }
        elif (c == 110) { store64(key + SO_K_NUM, 1); }
        elif (c == 82) { store64(key + SO_K_RAND, 1); }
        elif (c == 114) { store64(key + SO_K_REV, 1); }
        elif (c == 86) { store64(key + SO_K_VER, 1); }
        else { known = 0; }
        if (known == 1) { p = p + 1; } else { going = 0; }
    }
    return p;
}

# 1 when the key has no ordering options of its own — `-r` does not count — so that it takes the
# global ones: GNU's `default_key_compare`.
fn _so_key_default(k): i64 {
    var o: i64 = SO_K_SKIPS;
    while (o < SO_K_REV) {
        if (load64(k + o) != 0) { return 0; }
        o = o + 8;
    }
    return 1;
}

# The key's letters as GNU's `key_to_opts` spells them, for "options '-XY' are incompatible".
# `b` and `r` are left out, as GNU clears them before it asks.
fn _so_key_opts(k, out): i64 {
    var n: i64 = 0;
    if (load64(k + SO_K_IGNORE) == _so_t_dict) { store8(out + n, 100); n = n + 1; }
    if (load64(k + SO_K_TRANS) != 0) { store8(out + n, 102); n = n + 1; }
    if (load64(k + SO_K_GEN) != 0) { store8(out + n, 103); n = n + 1; }
    if (load64(k + SO_K_HUM) != 0) { store8(out + n, 104); n = n + 1; }
    if (load64(k + SO_K_IGNORE) == _so_t_print) { store8(out + n, 105); n = n + 1; }
    if (load64(k + SO_K_MON) != 0) { store8(out + n, 77); n = n + 1; }
    if (load64(k + SO_K_NUM) != 0) { store8(out + n, 110); n = n + 1; }
    if (load64(k + SO_K_RAND) != 0) { store8(out + n, 82); n = n + 1; }
    if (load64(k + SO_K_VER) != 0) { store8(out + n, 86); n = n + 1; }
    store8(out + n, 0);
    return n;
}

# GNU's `check_ordering_compatibility` for one key: at most one of -n -g -h -M, and of those
# with -V, -R, -d and -i, which count as one between them. 0 when compatible.
fn _so_key_incompatible(k): i64 {
    var n = load64(k + SO_K_NUM) + load64(k + SO_K_GEN) + load64(k + SO_K_HUM) + load64(k + SO_K_MON);
    var other: i64 = 0;
    if (load64(k + SO_K_VER) != 0) { other = 1; }
    if (load64(k + SO_K_RAND) != 0) { other = 1; }
    if (load64(k + SO_K_IGNORE) != 0) { other = 1; }
    if (n + other > 1) { return 1; }
    return 0;
}

# One count of a key spec at `s + *pos_p` — GNU's `parse_field_count`, which is `xstrtoumax`:
# white space, an optional `+`, digits. Stores the value, saturated, in `*val_p` and advances.
# Returns 0 when there are no digits.
fn _so_field_count(s, pos_p, val_p): i64 {
    var i = load64(pos_p);
    var ws: i64 = 1;
    while (ws == 1) {
        var c = load8(s + i);
        if (c == 32) { i = i + 1; }
        elif (c >= 9) {
            if (c <= 13) { i = i + 1; } else { ws = 0; }
        } else { ws = 0; }
    }
    if (load8(s + i) == 43) { i = i + 1; }
    var len: i64 = 0;
    var n = kriya_count_digits(s + i, &len);
    if (len == 0) { return 0; }
    store64(pos_p, i + len);
    store64(val_p, n);
    return 1;
}

# A `-k` spec, `F[.C][OPTS][,F[.C][OPTS]]`, as GNU's `main` reads it. Returns the key, or reports
# the spec in GNU's words and returns 0.
fn _so_parse_key(spec): i64 {
    var k = _so_key_new();
    var pos: i64 = 0;
    var v: i64 = 0;
    if (_so_field_count(spec, &pos, &v) == 0) {
        report_note("sort", spec, "invalid number at field start");
        return 0;
    }
    if (v == 0) {
        report_note("sort", spec, "field number is zero");
        return 0;
    }
    store64(k + SO_K_SWORD, v - 1);
    if (load8(spec + pos) == 46) {
        pos = pos + 1;
        if (_so_field_count(spec, &pos, &v) == 0) {
            report_note("sort", spec, "invalid number after '.'");
            return 0;
        }
        if (v == 0) {
            report_note("sort", spec, "character offset is zero");
            return 0;
        }
        store64(k + SO_K_SCHAR, v - 1);
    }
    if (load64(k + SO_K_SWORD) == 0) {
        if (load64(k + SO_K_SCHAR) == 0) { store64(k + SO_K_SWORD, 0 - 1); }
    }
    pos = _so_set_ordering(spec, pos, k, 1);
    if (load8(spec + pos) == 44) {
        pos = pos + 1;
        if (_so_field_count(spec, &pos, &v) == 0) {
            report_note("sort", spec, "invalid number after ','");
            return 0;
        }
        if (v == 0) {
            report_note("sort", spec, "field number is zero");
            return 0;
        }
        store64(k + SO_K_EWORD, v - 1);
        if (load8(spec + pos) == 46) {
            pos = pos + 1;
            if (_so_field_count(spec, &pos, &v) == 0) {
                report_note("sort", spec, "invalid number after '.'");
                return 0;
            }
            # ⚠ An end offset of 0 is valid, "the end of the field", unlike a start offset.
            store64(k + SO_K_ECHAR, v);
        }
        pos = _so_set_ordering(spec, pos, k, 2);
    }
    if (load8(spec + pos) != 0) {
        report_note("sort", spec, "stray character in field spec");
        return 0;
    }
    return k;
}

# --- fields: GNU's `begfield` and `limfield` -----------------------------------------------------
#
# A line is `len` bytes at `text`, its terminator not included.
#
# ⛔ WITHOUT `-t` A FIELD INCLUDES THE BLANKS IN FRONT OF IT. GNU and POSIX split between a
# non-blank and a blank, so field 2 of `a  b` is `  b`; `-b` is the option that drops them.
#
# ⚠ An end `F.C` can reach past field F: GNU counts C characters from the start of field F to the
# end of the LINE, not of the field (the `POSIX_UNSPECIFIED` block in GNU's source is compiled
# out). So `-k1,1.5` of `ab cdef` is `ab cd`.

# The first `c` in [p, e), or `e`.
fn _so_memchr(p, e, c): i64 {
    var q = p;
    while (q < e) {
        if (load8(q) == c) { return q; }
        q = q + 1;
    }
    return e;
}

fn _so_skip_blanks(p, e): i64 {
    var q = p;
    while (q < e && load8(_so_t_blank + load8(q)) == 1) { q = q + 1; }
    return q;
}

# Past one blank-separated field: its leading blanks, then its non-blanks.
fn _so_skip_field(p, e): i64 {
    var q = _so_skip_blanks(p, e);
    while (q < e && load8(_so_t_blank + load8(q)) == 0) { q = q + 1; }
    return q;
}

fn _so_begfield(text, len, k): i64 {
    var ptr = text;
    var lim = text + len;
    var sword = load64(k + SO_K_SWORD);
    while (ptr < lim && sword > 0) {
        sword = sword - 1;
        if (_so_tab >= 0) {
            ptr = _so_memchr(ptr, lim, _so_tab);
            if (ptr < lim) { ptr = ptr + 1; }
        } else {
            ptr = _so_skip_field(ptr, lim);
        }
    }
    if (load64(k + SO_K_SKIPS) == 1) { ptr = _so_skip_blanks(ptr, lim); }
    var schar = load64(k + SO_K_SCHAR);
    if (schar < lim - ptr) { ptr = ptr + schar; } else { ptr = lim; }
    return ptr;
}

fn _so_limfield(text, len, k): i64 {
    var ptr = text;
    var lim = text + len;
    var eword = load64(k + SO_K_EWORD);
    var echar = load64(k + SO_K_ECHAR);
    if (echar == 0) { eword = eword + 1; }
    while (ptr < lim && eword > 0) {
        eword = eword - 1;
        if (_so_tab >= 0) {
            ptr = _so_memchr(ptr, lim, _so_tab);
            if (ptr < lim) {
                # Past the separator only when another field or some characters follow.
                var past: i64 = 0;
                if (eword != 0) { past = 1; }
                if (echar != 0) { past = 1; }
                if (past == 1) { ptr = ptr + 1; }
            }
        } else {
            ptr = _so_skip_field(ptr, lim);
        }
    }
    if (echar != 0) {
        if (load64(k + SO_K_SKIPE) == 1) { ptr = _so_skip_blanks(ptr, lim); }
        if (echar < lim - ptr) { ptr = ptr + echar; } else { ptr = lim; }
    }
    return ptr;
}

# The bounds of key `k` in a line: the start into `*beg_p`, the limit into `*lim_p`.
fn _so_key_bounds(text, len, k, beg_p, lim_p): i64 {
    var lim = text + len;
    if (load64(k + SO_K_EWORD) >= 0) { lim = _so_limfield(text, len, k); }
    var beg = text;
    if (load64(k + SO_K_SWORD) >= 0) {
        beg = _so_begfield(text, len, k);
    } elif (load64(k + SO_K_SKIPS) == 1) {
        beg = _so_skip_blanks(text, lim);
    }
    # A field end before its start is an empty key.
    if (lim < beg) { lim = beg; }
    store64(beg_p, beg);
    store64(lim_p, lim);
    return 0;
}

# --- records ------------------------------------------------------------------------------------
#
# One per line, in a flat array: the line's address and length, the first key's bounds, and AUX,
# the first key's cached digest (`-R`) or value (`-g`), or 0.
enum SoRec {
    SO_R_TEXT = 0;
    SO_R_LEN  = 8;
    SO_R_KBEG = 16;
    SO_R_KLIM = 24;
    SO_R_AUX  = 32;
    SO_R_SZ   = 40;
}

# --- comparators ----------------------------------------------------------------------------------

# memcmp's sign over `n` bytes, eight at a time while they are equal.
fn _so_memcmp(a, b, n): i64 {
    var i: i64 = 0;
    while (i + 8 <= n && load64(a + i) == load64(b + i)) { i = i + 8; }
    while (i < n) {
        var ca = load8(a + i);
        var cb = load8(b + i);
        if (ca != cb) { return ca - cb; }
        i = i + 1;
    }
    return 0;
}

# Bytes then lengths: GNU's `memcmp` and `_GL_CMP`.
fn _so_cmp_text(a, alen, b, blen): i64 {
    var m = alen;
    if (blen < m) { m = blen; }
    var d = _so_memcmp(a, b, m);
    if (d != 0) { return d; }
    if (alen < blen) { return 0 - 1; }
    if (alen > blen) { return 1; }
    return 0;
}

# The number at the front of a key, for `-n` and `-h`, as GNU's `strnumcmp` reads it in the C
# locale: blanks skipped, an optional `-`, digits, an optional `.` and more digits — and nothing
# else, so `+5`, `1e3`'s `e` and `1,000`'s `,` end it. Stored in `rec` as (sign, integer digits'
# address, their count, fraction digits' address, their count), leading zeros and trailing
# fraction zeros dropped, so equal numbers have equal records and zero has sign 0 whether written
# `-0` or `.00`.
fn _so_num_read(p0, len, rec): i64 {
    var e = p0 + len;
    var p = _so_skip_blanks(p0, e);
    var neg: i64 = 0;
    if (p < e) {
        if (load8(p) == 45) { neg = 1; p = p + 1; }
    }
    while (p < e && load8(p) == 48) { p = p + 1; }
    var ioff = p;
    while (p < e && _vc_isdigit(load8(p)) == 1) { p = p + 1; }
    var ilen = p - ioff;
    var foff = p;
    var flen: i64 = 0;
    if (p < e) {
        if (load8(p) == 46) {
            p = p + 1;
            foff = p;
            while (p < e && _vc_isdigit(load8(p)) == 1) { p = p + 1; }
            flen = p - foff;
            while (flen > 0 && load8(foff + flen - 1) == 48) { flen = flen - 1; }
        }
    }
    var sign: i64 = 1;
    if (neg == 1) { sign = 0 - 1; }
    if (ilen + flen == 0) { sign = 0; }
    store64(rec, sign);
    store64(rec + 8, ioff);
    store64(rec + 16, ilen);
    store64(rec + 24, foff);
    store64(rec + 32, flen);
    return 0;
}

# `-n`: -1 / 0 / +1.
#
# ⛔ IT PARSED EACH KEY INTO AN i64, AND AN i64 IS NOT A NUMBER LINE (fixed at 1.6.16): past 2^63
# a key wrapped, and the parse stopped at the `.`. GNU compares the digit strings, never
# converting, so any length is exact, and so does this: sign, then the integer part's length,
# then its digits, then the fraction's digits. For two negatives the order flips.
fn _so_cmp_numeric(a, alen, b, blen): i64 {
    var ra[40];
    var rb[40];
    _so_num_read(a, alen, &ra);
    _so_num_read(b, blen, &rb);
    var sa = load64(&ra);
    var sb = load64(&rb);
    if (sa < sb) { return 0 - 1; }
    if (sa > sb) { return 1; }
    if (sa == 0) { return 0; }
    var mag: i64 = 0;
    var ila = load64(&ra + 16);
    var ilb = load64(&rb + 16);
    if (ila < ilb) { mag = 0 - 1; }
    if (ila > ilb) { mag = 1; }
    if (mag == 0) { mag = _so_memcmp(load64(&ra + 8), load64(&rb + 8), ila); }
    if (mag == 0) {
        var fla = load64(&ra + 32);
        var flb = load64(&rb + 32);
        mag = _so_cmp_text(load64(&ra + 24), fla, load64(&rb + 24), flb);
    }
    if (mag < 0) { mag = 0 - 1; }
    if (mag > 0) { mag = 1; }
    if (sa < 0) { return 0 - mag; }
    return mag;
}

# `-h`'s unit, GNU's `find_unit_order`: none < K (or k) < M < G < T < P < E < Z < Y < R < Q,
# negative for a negative number, and counted only when some digit is above 0.
fn _so_unit_order(p0, e): i64 {
    var p = p0;
    var neg: i64 = 0;
    if (p < e) { if (load8(p) == 45) { neg = 1; p = p + 1; } }
    var maxd: i64 = 0;
    while (p < e && _vc_isdigit(load8(p)) == 1) {
        if (load8(p) > maxd) { maxd = load8(p); }
        p = p + 1;
    }
    if (p < e) {
        if (load8(p) == 46) {
            p = p + 1;
            while (p < e && _vc_isdigit(load8(p)) == 1) {
                if (load8(p) > maxd) { maxd = load8(p); }
                p = p + 1;
            }
        }
    }
    if (maxd <= 48) { return 0; }
    var c: i64 = 0;
    if (p < e) { c = load8(p); }
    var ord: i64 = 0;
    if (c == 75) { ord = 1; }
    if (c == 107) { ord = 1; }
    if (c == 77) { ord = 2; }
    if (c == 71) { ord = 3; }
    if (c == 84) { ord = 4; }
    if (c == 80) { ord = 5; }
    if (c == 69) { ord = 6; }
    if (c == 90) { ord = 7; }
    if (c == 89) { ord = 8; }
    if (c == 82) { ord = 9; }
    if (c == 81) { ord = 10; }
    if (neg == 1) { return 0 - ord; }
    return ord;
}

fn _so_cmp_human(a, alen, b, blen): i64 {
    var ea = a + alen;
    var eb = b + blen;
    var pa = _so_skip_blanks(a, ea);
    var pb = _so_skip_blanks(b, eb);
    var d = _so_unit_order(pa, ea) - _so_unit_order(pb, eb);
    if (d != 0) { return d; }
    return _so_cmp_numeric(pa, ea - pa, pb, eb - pb);
}

# `-M`: 1 to 12 for a key starting, after blanks, with JAN to DEC in any case; 0 otherwise.
fn _so_month(p0, len): i64 {
    var e = p0 + len;
    var p = _so_skip_blanks(p0, e);
    if (e - p < 3) { return 0; }
    var c1 = load8(_so_t_upper + load8(p));
    var c2 = load8(_so_t_upper + load8(p + 1));
    var c3 = load8(_so_t_upper + load8(p + 2));
    var names = "JANFEBMARAPRMAYJUNJULAUGSEPOCTNOVDEC";
    var m: i64 = 0;
    while (m < 12) {
        var q = names + m * 3;
        if (load8(q) == c1) {
            if (load8(q + 1) == c2) {
                if (load8(q + 2) == c3) { return m + 1; }
            }
        }
        m = m + 1;
    }
    return 0;
}

# `-g`'s reading of a NUL-terminated key, GNU's `strtold`: 1 and the value in `rec` when a number
# was read, 0 for a conversion error.
fn _so_gen_read(s, rec): i64 {
    if (xf_parse(s, XF_LDBL, rec) == 0) { return 0; }
    return 1;
}

# `-g`, GNU's `general_numcompare`: conversion errors first, then NaNs, then numbers, -0 == +0.
# Two NaNs order as their `%Lf` spellings, so `-nan` before `nan`.
fn _so_cmp_general(oka, ra, okb, rb): i64 {
    if (oka == 0) {
        if (okb == 0) { return 0; }
        return 0 - 1;
    }
    if (okb == 0) { return 1; }
    var c = xf_cmp(ra, rb);
    if (c != 2) { return c; }
    if (xf_is_nan(rb) == 0) { return 0 - 1; }
    if (xf_is_nan(ra) == 0) { return 1; }
    var sa = load64(ra + XF_SIGN);
    var sb = load64(rb + XF_SIGN);
    if (sa == sb) { return 0; }
    if (sa == 1) { return 0 - 1; }
    return 1;
}

# --- -R: the salted MD5 ------------------------------------------------------------------------
var _so_rand_ctx = 0;    # MD5 state after the 16-byte salt
var _so_rand_tmp = 0;    # a context to continue it in

fn _so_digest(p, len, out): i64 {
    memcpy(_so_rand_tmp, _so_rand_ctx, MD5_CTXSZ);
    md5_update(_so_rand_tmp, p, len);
    md5_final(_so_rand_tmp, out);
    return 0;
}

# GNU's `compare_random` in the C locale: the digests, then on a collision the keys themselves.
fn _so_cmp_random(a, alen, b, blen): i64 {
    var da[16];
    var db[16];
    _so_digest(a, alen, &da);
    _so_digest(b, blen, &db);
    var d = _so_memcmp(&da, &db, 16);
    if (d != 0) { return d; }
    return _so_cmp_text(a, alen, b, blen);
}

# Salt `-R`: FILE's first 16 bytes, or getrandom. Returns 0, or the exit status.
fn _so_random_init(src): i64 {
    var salt[16];
    var got: i64 = 0;
    if (src != 0) {
        var fd = k_open(src, 0, 0);
        if (fd < 0) {
            _so_report(src, 0 - fd);
            return SO_EXIT_TROUBLE;
        }
        var more: i64 = 1;
        while (more == 1) {
            var n = k_read( fd, &salt + got, 16 - got);
            if (n < 0) {
                if ((0 - n) != 4) {
                    k_close( fd);
                    _so_report(src, 0 - n);
                    return SO_EXIT_TROUBLE;
                }
            } elif (n == 0) { more = 0; }
            else {
                got = got + n;
                if (got >= 16) { more = 0; }
            }
        }
        k_close( fd);
        if (got < 16) {
            report_note("sort", src, "end of file");
            return SO_EXIT_TROUBLE;
        }
    } else {
        var tries: i64 = 0;
        while (got < 16 && tries < 64) {
            var r = sys_getrandom(&salt + got, 16 - got, 0);
            if (r > 0) { got = got + r; }
            tries = tries + 1;
        }
        if (got < 16) {
            report_note("sort", "getrandom", "open failed");
            return SO_EXIT_TROUBLE;
        }
    }
    _so_rand_ctx = alloc(MD5_CTXSZ);
    _so_rand_tmp = alloc(MD5_CTXSZ);
    md5_init(_so_rand_ctx);
    md5_update(_so_rand_ctx, &salt, 16);
    return 0;
}

# --- transformed copies --------------------------------------------------------------------------
#
# `-V` and `-R` compare the key with `-d`/`-i` bytes dropped and `-f` applied, so they need a copy;
# `-g` needs one that ends in NUL. Two scratch buffers, one per side, grown on demand.
var _so_xa = 0;
var _so_xa_cap = 0;
var _so_xb = 0;
var _so_xb_cap = 0;

fn _so_scratch(side, need): i64 {
    if (side == 0) {
        if (need + 1 > _so_xa_cap) {
            var c = need + 1;
            if (c < 4096) { c = 4096; }
            if (c < _so_xa_cap * 2) { c = _so_xa_cap * 2; }
            _so_xa = alloc(c);
            _so_xa_cap = c;
        }
        return _so_xa;
    }
    if (need + 1 > _so_xb_cap) {
        var c2 = need + 1;
        if (c2 < 4096) { c2 = 4096; }
        if (c2 < _so_xb_cap * 2) { c2 = _so_xb_cap * 2; }
        _so_xb = alloc(c2);
        _so_xb_cap = c2;
    }
    return _so_xb;
}

# The key at `p` with `ign`'s bytes dropped and `trans` applied, NUL-terminated, in scratch
# `side`. Returns its address; the length goes to `*len_p`.
fn _so_xform(side, p, len, ign, trans, len_p): i64 {
    var d = _so_scratch(side, len);
    var n: i64 = 0;
    var i: i64 = 0;
    while (i < len) {
        var c = load8(p + i);
        var keep: i64 = 1;
        if (ign != 0) { if (load8(ign + c) == 1) { keep = 0; } }
        if (keep == 1) {
            if (trans != 0) { c = load8(trans + c); }
            store8(d + n, c);
            n = n + 1;
        }
        i = i + 1;
    }
    store8(d + n, 0);
    store64(len_p, n);
    return d;
}

# --- keycompare and compare --------------------------------------------------------------------

# Key `k` of lines `ra` and `rb`, whose bounds are [a, a + alen) and [b, b + blen). `first` is 1
# for the first key, whose AUX cache the records hold. The caller applies `-r`.
fn _so_key_diff(k, first, ra, rb, a, alen, b, blen): i64 {
    var ign = load64(k + SO_K_IGNORE);
    var trans = load64(k + SO_K_TRANS);
    if (load64(k + SO_K_NUM) == 1) { return _so_cmp_numeric(a, alen, b, blen); }
    if (load64(k + SO_K_HUM) == 1) {
        # ⛔ `-f` IS NOT A NO-OP UNDER `-h`: GNU folds the key before it looks for a unit, so `1e3`
        # becomes `1E3`, an exa. It is under `-n`, `-g` and `-M`, which read no case.
        if (trans != 0) {
            var ha: i64 = 0;
            var hb: i64 = 0;
            var ua = _so_xform(0, a, alen, 0, trans, &ha);
            var ub = _so_xform(1, b, blen, 0, trans, &hb);
            return _so_cmp_human(ua, ha, ub, hb);
        }
        return _so_cmp_human(a, alen, b, blen);
    }
    if (load64(k + SO_K_MON) == 1) { return _so_month(a, alen) - _so_month(b, blen); }
    if (load64(k + SO_K_GEN) == 1) {
        if (first == 1) {
            var xa = load64(ra + SO_R_AUX);
            var xb = load64(rb + SO_R_AUX);
            return _so_cmp_general(load64(xa), xa + 8, load64(xb), xb + 8);
        }
        var la: i64 = 0;
        var lb: i64 = 0;
        var ga[32];
        var gb[32];
        var oka = _so_gen_read(_so_xform(0, a, alen, 0, 0, &la), &ga);
        var okb = _so_gen_read(_so_xform(1, b, blen, 0, 0, &lb), &gb);
        return _so_cmp_general(oka, &ga, okb, &gb);
    }
    if (load64(k + SO_K_RAND) == 1) {
        if (first == 1) {
            var d = _so_memcmp(load64(ra + SO_R_AUX), load64(rb + SO_R_AUX), 16);
            if (d != 0) { return d; }
        }
        var pa = a;
        var pb = b;
        var ta = alen;
        var tb = blen;
        var xf: i64 = 0;
        if (ign != 0) { xf = 1; }
        if (trans != 0) { xf = 1; }
        if (xf == 1) {
            pa = _so_xform(0, a, alen, ign, trans, &ta);
            pb = _so_xform(1, b, blen, ign, trans, &tb);
        }
        if (first == 1) { return _so_cmp_text(pa, ta, pb, tb); }
        return _so_cmp_random(pa, ta, pb, tb);
    }
    if (load64(k + SO_K_VER) == 1) {
        if (ign != 0) {
            var va: i64 = 0;
            var vb: i64 = 0;
            var qa = _so_xform(0, a, alen, ign, trans, &va);
            var qb = _so_xform(1, b, blen, ign, trans, &vb);
            return filenvercmp(qa, va, qb, vb);
        }
        if (trans != 0) {
            var wa: i64 = 0;
            var wb: i64 = 0;
            var sa = _so_xform(0, a, alen, 0, trans, &wa);
            var sb = _so_xform(1, b, blen, 0, trans, &wb);
            return filenvercmp(sa, wa, sb, wb);
        }
        return filenvercmp(a, alen, b, blen);
    }
    if (ign != 0) {
        # GNU's CMP_WITH_IGNORE: skip ignored bytes on both sides, compare, until one runs out.
        var pa2 = a;
        var pb2 = b;
        var ea = a + alen;
        var eb = b + blen;
        while (1 == 1) {
            while (pa2 < ea && load8(ign + load8(pa2)) == 1) { pa2 = pa2 + 1; }
            while (pb2 < eb && load8(ign + load8(pb2)) == 1) { pb2 = pb2 + 1; }
            var hava: i64 = 0;
            var havb: i64 = 0;
            if (pa2 < ea) { hava = 1; }
            if (pb2 < eb) { havb = 1; }
            if (hava == 0) { return hava - havb; }
            if (havb == 0) { return 1; }
            var ca = load8(pa2);
            var cb = load8(pb2);
            if (trans != 0) {
                ca = load8(trans + ca);
                cb = load8(trans + cb);
            }
            if (ca != cb) { return ca - cb; }
            pa2 = pa2 + 1;
            pb2 = pb2 + 1;
        }
    }
    if (trans != 0) {
        var m = alen;
        if (blen < m) { m = blen; }
        var i: i64 = 0;
        while (i < m) {
            var fa = load8(trans + load8(a + i));
            var fb = load8(trans + load8(b + i));
            if (fa != fb) { return fa - fb; }
            i = i + 1;
        }
        if (alen < blen) { return 0 - 1; }
        if (alen > blen) { return 1; }
        return 0;
    }
    return _so_cmp_text(a, alen, b, blen);
}

# GNU's `keycompare`: the keys in order until one differs, reversed by that key's `-r`.
fn _so_keycompare(ra, rb): i64 {
    var k = load64(_so_keys);
    var a = load64(ra + SO_R_KBEG);
    var b = load64(rb + SO_R_KBEG);
    var d = _so_key_diff(k, 1, ra, rb, a, load64(ra + SO_R_KLIM) - a, b, load64(rb + SO_R_KLIM) - b);
    var ki: i64 = 1;
    while (d == 0 && ki < _so_nkeys) {
        k = load64(_so_keys + ki * 8);
        var ab[8];
        var al[8];
        var bb[8];
        var bl[8];
        _so_key_bounds(load64(ra + SO_R_TEXT), load64(ra + SO_R_LEN), k, &ab, &al);
        _so_key_bounds(load64(rb + SO_R_TEXT), load64(rb + SO_R_LEN), k, &bb, &bl);
        var pa = load64(&ab);
        var pb = load64(&bb);
        d = _so_key_diff(k, 0, ra, rb, pa, load64(&al) - pa, pb, load64(&bl) - pb);
        ki = ki + 1;
    }
    if (d == 0) { return 0; }
    if (load64(k + SO_K_REV) == 1) { return 0 - d; }
    return d;
}

# Order two lines: negative, 0 or positive — GNU's `compare`.
#
# ⛔ THE LAST-RESORT COMPARISON (1.6.16): when the keys tie, the whole lines decide, as bytes,
# never folded — unless `-u` (equal keys ARE the duplicates) or `-s` (equal keys keep input
# order); the global `-r` reverses it. With no key at all only the last resort runs.
fn _so_compare(ra, rb): i64 {
    if (_so_nkeys > 0) {
        var d = _so_keycompare(ra, rb);
        if (d != 0) { return d; }
        if (_so_unique == 1) { return 0; }
        if (_so_stable == 1) { return 0; }
    }
    var r = _so_cmp_text(load64(ra + SO_R_TEXT), load64(ra + SO_R_LEN), load64(rb + SO_R_TEXT), load64(rb + SO_R_LEN));
    if (_so_reverse == 1) { return 0 - r; }
    return r;
}

# Stable bottom-up merge sort of `n` record pointers at `src`, with `tmp` as the other half.
# Returns whichever of the two holds the result.
fn _so_merge_sort(src, tmp, n): i64 {
    var from = src;
    var to = tmp;
    var width: i64 = 1;
    while (width < n) {
        var start: i64 = 0;
        while (start < n) {
            var mid = start + width;
            if (mid > n) { mid = n; }
            var end = start + 2 * width;
            if (end > n) { end = n; }
            var l = start;
            var r = mid;
            var k = start;
            while (k < end) {
                var take_left: i64 = 0;
                if (l < mid) {
                    if (r >= end) { take_left = 1; }
                    elif (_so_compare(load64(from + l * 8), load64(from + r * 8)) <= 0) { take_left = 1; }
                }
                if (take_left == 1) {
                    store64(to + k * 8, load64(from + l * 8));
                    l = l + 1;
                } else {
                    store64(to + k * 8, load64(from + r * 8));
                    r = r + 1;
                }
                k = k + 1;
            }
            start = end;
        }
        var t = from;
        from = to;
        to = t;
        width = width * 2;
    }
    return from;
}

# --- input ----------------------------------------------------------------------------------------

# The lines of [p, e) with terminator `term`; a last line without one still counts.
fn _so_count_lines(p, e, term): i64 {
    var n: i64 = 0;
    var q = p;
    var last = p;
    while (q < e) {
        if (load8(q) == term) {
            n = n + 1;
            last = q + 1;
        }
        q = q + 1;
    }
    if (last < e) { n = n + 1; }
    return n;
}

# Records for the lines of [p, e) from index `ri` on, each with its pointer in `ptrs`. Returns
# the next index.
fn _so_fill_records(p, e, term, recs, ptrs, ri): i64 {
    var i = ri;
    var start = p;
    var q = p;
    while (q <= e) {
        var at_end: i64 = 0;
        if (q == e) {
            if (start < e) { at_end = 1; }
        } elif (load8(q) == term) { at_end = 1; }
        if (at_end == 1) {
            var r = recs + i * SO_R_SZ;
            store64(r + SO_R_TEXT, start);
            store64(r + SO_R_LEN, q - start);
            store64(r + SO_R_KBEG, start);
            store64(r + SO_R_KLIM, q);
            store64(r + SO_R_AUX, 0);
            store64(ptrs + i * 8, r);
            i = i + 1;
            start = q + 1;
        }
        q = q + 1;
    }
    return i;
}

# The first key's bounds, and its digest or value, for every record — as GNU's `fillbuf` finds
# the first key once per line.
# The bytes each line's first-key cache takes: a digest under `-R`, a value under `-g`, else 0.
fn _so_auxsz(): i64 {
    if (_so_nkeys == 0) { return 0; }
    var k = load64(_so_keys);
    if (load64(k + SO_K_RAND) == 1) { return 16; }
    if (load64(k + SO_K_GEN) == 1) { return 40; }
    return 0;
}

# One record's first-key bounds, and its digest or value in `slot` when `_so_auxsz` says so.
fn _so_rec_keys(r, slot): i64 {
    if (_so_nkeys == 0) { return 0; }
    var k = load64(_so_keys);
    _so_key_bounds(load64(r + SO_R_TEXT), load64(r + SO_R_LEN), k, r + SO_R_KBEG, r + SO_R_KLIM);
    if (slot == 0) { return 0; }
    var kb = load64(r + SO_R_KBEG);
    var kl = load64(r + SO_R_KLIM) - kb;
    var tl: i64 = 0;
    if (load64(k + SO_K_RAND) == 1) {
        var t = kb;
        tl = kl;
        var xf: i64 = 0;
        if (load64(k + SO_K_IGNORE) != 0) { xf = 1; }
        if (load64(k + SO_K_TRANS) != 0) { xf = 1; }
        if (xf == 1) { t = _so_xform(0, kb, kl, load64(k + SO_K_IGNORE), load64(k + SO_K_TRANS), &tl); }
        _so_digest(t, tl, slot);
    } else {
        store64(slot, _so_gen_read(_so_xform(0, kb, kl, 0, 0, &tl), slot + 8));
    }
    store64(r + SO_R_AUX, slot);
    return 0;
}

# The first key's bounds, and its digest or value, for every record — as GNU's `fillbuf` finds
# the first key once per line.
fn _so_prepare(ptrs, n): i64 {
    if (_so_nkeys == 0) { return 0; }
    var auxsz = _so_auxsz();
    var aux: i64 = 0;
    if (auxsz > 0) { aux = alloc(n * auxsz + 8); }
    var i: i64 = 0;
    while (i < n) {
        var slot: i64 = 0;
        if (auxsz > 0) { slot = aux + i * auxsz; }
        _so_rec_keys(load64(ptrs + i * 8), slot);
        i = i + 1;
    }
    return 0;
}

# --- output ---------------------------------------------------------------------------------------
var _so_ob = 0;
var _so_obn = 0;
var _so_ofd = 1;
var _SO_OBSZ: i64 = 65536;

fn _so_write_all(fd, buf, n): i64 {
    var w: i64 = 0;
    while (w < n) {
        var wr = k_write( fd, buf + w, n - w);
        if (wr < 0) {
            if ((0 - wr) != 4) { return wr; }
        } else { w = w + wr; }
    }
    return 0;
}

fn _so_flush(): i64 {
    if (_so_obn == 0) { return 0; }
    var r = _so_write_all(_so_ofd, _so_ob, _so_obn);
    _so_obn = 0;
    return r;
}

# One line and its terminator into the output buffer. Returns 0 or a negative errno.
fn _so_emit(p, n, term): i64 {
    if (_so_obn + n + 1 > _SO_OBSZ) {
        var r = _so_flush();
        if (r != 0) { return r; }
    }
    if (n + 1 > _SO_OBSZ) {
        var r2 = _so_write_all(_so_ofd, p, n);
        if (r2 != 0) { return r2; }
        store8(_so_ob, term);
        _so_obn = 1;
        return 0;
    }
    memcpy(_so_ob + _so_obn, p, n);
    store8(_so_ob + _so_obn + n, term);
    _so_obn = _so_obn + n + 1;
    return 0;
}

# --- beyond memory: temporary runs and GNU's merge (1.9.2) -------------------------------------
#
# ⭐ NO MODE TRUNCATES ANY MORE. Until 1.9.2 an input past the 256 MiB buffer was cut there, with a
# warning, in sort, `-m` and `-c` alike. Now the budget (`-S`, default 512 MiB) covers the input's
# bytes and its line records together, as GNU's buffer does, and past it:
#
#   - sort: each full buffer is sorted and written to a temporary file, a RUN; runs are merged
#     sixteen at a time as they pile up, and the last ones into the output, in GNU's `merge` order;
#   - `-m`: each input is copied to a run of its own, and the runs merged exactly as in memory;
#   - `-c`: the input is checked a buffer at a time, the last line of one against the first of
#     the next.
#
# A run is created in the next `-T` directory (round robin, as GNU's), or `$TMPDIR`, or /tmp,
# opened twice (to write, and to read from the start) and unlinked at once: nothing is left
# behind however `sort` ends, an interrupt included, and agnos needs no lseek to read it back.
#
# ⚠ Equal lines keep their input order through every merge, a tie going to the earlier run, so
# the output is the in-memory sort's byte for byte: `-s`, `-u` and the last-resort compare
# included. `-u` drops duplicates inside each run and again at each merge, which keeps the first
# of each group either way. GNU merges sixteen inputs at a time (NMERGE) and so does this, which
# keeps the descriptors open few. ⚠ The grouping cannot show in the output, even under `-m -u`
# over unsorted files: within a group a line from elsewhere never lands between two equal lines,
# so merging groups first gives the one merge's order (measured against 1.9.1's one merge).

enum SoSrc {
    SO_S_KIND = 0;      # 0 records in memory, 1 a run on disk
    SO_S_PTRS = 8;
    SO_S_IDX  = 16;
    SO_S_END  = 24;
    SO_S_RD   = 32;
    SO_S_SZ   = 40;
}

enum SoRd {
    SO_RD_FD   = 0;
    SO_RD_BUF  = 8;
    SO_RD_CAP  = 16;
    SO_RD_POS  = 24;
    SO_RD_END  = 32;
    SO_RD_EOF  = 40;
    SO_RD_HAS  = 48;
    SO_RD_REC  = 56;     # the current line's record, SO_R_SZ bytes
    SO_RD_AUX  = 96;     # its first-key cache, 40 bytes
    SO_RD_SZ   = 136;
}

var _so_budget = 536870912;     # 512 MiB: input bytes plus 56 a line, more with a cache
var _so_tdirs = 0;
var _so_tdir_i = 0;
var _so_tseq = 0;
var _so_err = 0;                # a fatal error inside the merge machinery, already reported
var _so_rd_free = 0;            # readers not in use
var _so_keep_rec = 0;
var _so_keep_buf = 0;
var _so_keep_cap = 0;
var _so_keep_aux = 0;
var _so_out_fd = 1;             # the output, which a merge into a run hands `_so_ofd` back to
var _so_term = 10;              # the line terminator: newline, or NUL under -z
var _SO_NMERGE: i64 = 16;
var _SO_RDBUF: i64 = 65536;

# Per-line memory, for the budget: the record, its pointer twice (sort and merge), the cache.
fn _so_line_cost(): i64 { return SO_R_SZ + 16 + _so_auxsz(); }

# A temporary run: written through `*wfd_p`, read from the start through `*rfd_p`, its name
# already gone. 0, or the exit status after a diagnostic.
fn _so_temp_new(wfd_p, rfd_p): i64 {
    var nd = vec_len(_so_tdirs);
    var dir = vec_get(_so_tdirs, _so_tdir_i);
    _so_tdir_i = (_so_tdir_i + 1) % nd;
    var dl = strlen(dir);
    var name = alloc(dl + 64);
    var tries: i64 = 0;
    while (tries < 1000) {
        memcpy(name, dir, dl);
        var p = dl;
        var tag = "/kriya-sort.";
        memcpy(name + p, tag, 12);
        p = p + 12;
        p = p + _so_put_dec(name + p, sys_getpid());
        store8(name + p, 46);
        p = p + 1;
        p = p + _so_put_dec(name + p, _so_tseq);
        store8(name + p, 0);
        _so_tseq = _so_tseq + 1;
        var wfd = k_open(name, 0o301, 0o600);               # O_WRONLY | O_CREAT | O_EXCL
        if (wfd >= 0) {
            var rfd = k_open(name, 0, 0);
            k_unlink(name);
            if (rfd < 0) {
                k_close( wfd);
                k_write( 2, "kriya sort: cannot create temporary file in ", 44);
                _report_operand(dir);
                _so_errtail(0 - rfd);
                return SO_EXIT_TROUBLE;
            }
            store64(wfd_p, wfd);
            store64(rfd_p, rfd);
            return 0;
        }
        if (wfd != (0 - 17)) {                              # anything but EEXIST
            k_write( 2, "kriya sort: cannot create temporary file in ", 44);
            _report_operand(dir);
            _so_errtail(0 - wfd);
            return SO_EXIT_TROUBLE;
        }
        tries = tries + 1;
    }
    k_write( 2, "kriya sort: cannot create temporary file in ", 44);
    _report_operand(dir);
    _so_errtail(17);
    return SO_EXIT_TROUBLE;
}

# `: ERROR` and a newline to stderr.
fn _so_errtail(errno): i64 {
    k_write( 2, ": ", 2);
    if (errmsg_is_known(errno) == 1) {
        var m = errmsg_for(errno);
        k_write( 2, m, strlen(m));
    } else { k_write( 2, "error", 5); }
    k_write( 2, "\n", 1);
    return 0;
}

# `v` (>= 0) in decimal at `out`; returns the digits written.
fn _so_put_dec(out, v): i64 {
    var tmp[24];
    var t: i64 = 0;
    var r = v;
    if (r == 0) { store8(&tmp, 48); t = 1; }
    while (r > 0) {
        store8(&tmp + t, 48 + (r % 10));
        r = r / 10;
        t = t + 1;
    }
    var i: i64 = 0;
    while (i < t) {
        store8(out + i, load8(&tmp + t - 1 - i));
        i = i + 1;
    }
    return t;
}

# A reader, from the free list or new, reading `fd` from where it is.
fn _so_rd_get(fd): i64 {
    var rd = _so_rd_free;
    if (rd != 0) { _so_rd_free = load64(rd + SO_RD_HAS); }
    else {
        rd = alloc(SO_RD_SZ);
        store64(rd + SO_RD_BUF, alloc(_SO_RDBUF));
        store64(rd + SO_RD_CAP, _SO_RDBUF);
    }
    store64(rd + SO_RD_FD, fd);
    store64(rd + SO_RD_POS, 0);
    store64(rd + SO_RD_END, 0);
    store64(rd + SO_RD_EOF, 0);
    store64(rd + SO_RD_HAS, 0);
    return rd;
}

fn _so_rd_put(rd): i64 {
    k_close( load64(rd + SO_RD_FD));
    store64(rd + SO_RD_HAS, _so_rd_free);
    _so_rd_free = rd;
    return 0;
}

# The next line of a run into the reader's record. 1 when there is one, 0 at the end.
fn _so_rd_next(rd): i64 {
    var buf = load64(rd + SO_RD_BUF);
    while (1 == 1) {
        var pos = load64(rd + SO_RD_POS);
        var end = load64(rd + SO_RD_END);
        var q = _so_memchr(buf + pos, buf + end, _so_term);
        var take: i64 = 0 - 1;
        if (q < buf + end) { take = q - buf; }
        elif (load64(rd + SO_RD_EOF) == 1) {
            if (pos >= end) {
                store64(rd + SO_RD_HAS, 0);
                return 0;
            }
            take = end;
        }
        if (take >= 0) {
            var r = rd + SO_RD_REC;
            store64(r + SO_R_TEXT, buf + pos);
            store64(r + SO_R_LEN, take - pos);
            store64(r + SO_R_KBEG, buf + pos);
            store64(r + SO_R_KLIM, buf + take);
            store64(r + SO_R_AUX, 0);
            var slot: i64 = 0;
            if (_so_auxsz() > 0) { slot = rd + SO_RD_AUX; }
            _so_rec_keys(r, slot);
            store64(rd + SO_RD_POS, take + 1);
            store64(rd + SO_RD_HAS, 1);
            return 1;
        }
        # No whole line left: keep the partial one at the front, grow if it fills the buffer.
        if (pos > 0) {
            memcpy(buf, buf + pos, end - pos);
            end = end - pos;
            store64(rd + SO_RD_POS, 0);
            store64(rd + SO_RD_END, end);
        }
        var cap = load64(rd + SO_RD_CAP);
        if (end == cap) {
            var nb = alloc(cap * 2);
            memcpy(nb, buf, end);
            buf = nb;
            store64(rd + SO_RD_BUF, nb);
            store64(rd + SO_RD_CAP, cap * 2);
            cap = cap * 2;
        }
        var n = k_read( load64(rd + SO_RD_FD), buf + end, cap - end);
        if (n < 0) {
            if (n != (0 - 4)) {
                k_write( 2, "kriya sort: read failed: a temporary file", 41);
                _so_errtail(0 - n);
                _so_err = 1;
                store64(rd + SO_RD_HAS, 0);
                return 0;
            }
        } elif (n == 0) {
            store64(rd + SO_RD_EOF, 1);
        } else {
            store64(rd + SO_RD_END, end + n);
        }
    }
    return 0;
}

fn _so_src_mem(ptrs, lo, hi): i64 {
    var s = alloc(SO_S_SZ);
    store64(s + SO_S_KIND, 0);
    store64(s + SO_S_PTRS, ptrs);
    store64(s + SO_S_IDX, lo);
    store64(s + SO_S_END, hi);
    store64(s + SO_S_RD, 0);
    return s;
}

# A run on disk read through `rfd`, its first line loaded.
fn _so_src_file(rfd): i64 {
    var s = alloc(SO_S_SZ);
    store64(s + SO_S_KIND, 1);
    var rd = _so_rd_get(rfd);
    store64(s + SO_S_RD, rd);
    _so_rd_next(rd);
    return s;
}

fn _so_src_head(s): i64 {
    if (load64(s + SO_S_KIND) == 0) {
        var i = load64(s + SO_S_IDX);
        if (i < load64(s + SO_S_END)) { return load64(load64(s + SO_S_PTRS) + i * 8); }
        return 0;
    }
    var rd = load64(s + SO_S_RD);
    if (rd == 0) { return 0; }
    if (load64(rd + SO_RD_HAS) == 1) { return rd + SO_RD_REC; }
    return 0;
}

# Past the current line; a finished run gives its reader back.
fn _so_src_adv(s): i64 {
    if (load64(s + SO_S_KIND) == 0) {
        store64(s + SO_S_IDX, load64(s + SO_S_IDX) + 1);
        return 0;
    }
    var rd = load64(s + SO_S_RD);
    if (_so_rd_next(rd) == 0) {
        _so_rd_put(rd);
        store64(s + SO_S_RD, 0);
    }
    return 0;
}

# A copy of record `r` that outlives its reader's buffer, for `-u`'s comparison.
fn _so_keep(r): i64 {
    var len = load64(r + SO_R_LEN);
    if (_so_keep_rec == 0) {
        _so_keep_rec = alloc(SO_R_SZ);
        _so_keep_aux = alloc(40);
    }
    if (len + 1 > _so_keep_cap) {
        var c = len + 1;
        if (c < 4096) { c = 4096; }
        if (c < _so_keep_cap * 2) { c = _so_keep_cap * 2; }
        _so_keep_buf = alloc(c);
        _so_keep_cap = c;
    }
    memcpy(_so_keep_buf, load64(r + SO_R_TEXT), len);
    var k = _so_keep_rec;
    store64(k + SO_R_TEXT, _so_keep_buf);
    store64(k + SO_R_LEN, len);
    store64(k + SO_R_KBEG, _so_keep_buf);
    store64(k + SO_R_KLIM, _so_keep_buf + len);
    store64(k + SO_R_AUX, 0);
    var slot: i64 = 0;
    if (_so_auxsz() > 0) { slot = _so_keep_aux; }
    _so_rec_keys(k, slot);
    return k;
}

# GNU's `mergefps` over `k` sources from `srcs[at]`: the smallest current line each time, a tie
# to the earlier source, and under `-u` the first of each run of equal lines. To memory when
# `dptrs` is not 0 (every source then in memory too), returning how many; else written through
# `_so_ofd`, returning 0 or a negative errno.
fn _so_merge_srcs(srcs, at, k, dptrs): i64 {
    var ord = alloc(k * 8 + 8);
    var na: i64 = 0;
    var f: i64 = 0;
    while (f < k) {
        var sf = vec_get(srcs, at + f);
        var hf = _so_src_head(sf);
        if (hf != 0) {
            var pos = na;
            var placing: i64 = 1;
            while (placing == 1) {
                if (pos == 0) { placing = 0; }
                else {
                    var g = load64(ord + (pos - 1) * 8);
                    if (_so_compare(_so_src_head(vec_get(srcs, at + g)), hf) > 0) {
                        store64(ord + pos * 8, g);
                        pos = pos - 1;
                    } else { placing = 0; }
                }
            }
            store64(ord + pos * 8, f);
            na = na + 1;
        }
        f = f + 1;
    }
    var out: i64 = 0;
    var prev: i64 = 0;
    while (na > 0) {
        var f0 = load64(ord);
        var s0 = vec_get(srcs, at + f0);
        var rec = _so_src_head(s0);
        var emit: i64 = 1;
        if (_so_unique == 1) {
            if (prev != 0) {
                if (_so_compare(prev, rec) == 0) { emit = 0; }
            }
        }
        if (emit == 1) {
            if (dptrs != 0) {
                store64(dptrs + out * 8, rec);
                out = out + 1;
                prev = rec;
            } else {
                var w = _so_emit(load64(rec + SO_R_TEXT), load64(rec + SO_R_LEN), _so_term);
                if (w != 0) { return w; }
                if (_so_unique == 1) { prev = _so_keep(rec); }
            }
        }
        _so_src_adv(s0);
        if (_so_err != 0) { return 0 - 5; }
        var nh = _so_src_head(s0);
        if (nh == 0) {
            var j: i64 = 1;
            while (j < na) {
                store64(ord + (j - 1) * 8, load64(ord + j * 8));
                j = j + 1;
            }
            na = na - 1;
        } else {
            var lo: i64 = 1;
            var hi = na;
            while (lo < hi) {
                var probe = (lo + hi) / 2;
                var g2 = load64(ord + probe * 8);
                var c2 = _so_compare(nh, _so_src_head(vec_get(srcs, at + g2)));
                var before: i64 = 0;
                if (c2 < 0) { before = 1; }
                if (c2 == 0) { if (f0 < g2) { before = 1; } }
                if (before == 1) { hi = probe; } else { lo = probe + 1; }
            }
            var j2: i64 = 1;
            while (j2 < lo) {
                store64(ord + (j2 - 1) * 8, load64(ord + j2 * 8));
                j2 = j2 + 1;
            }
            store64(ord + (lo - 1) * 8, f0);
        }
    }
    if (dptrs != 0) { return out; }
    return 0;
}

# Write lines through `_so_ofd` into a new run and return it as a source, or 0 after a reported
# error (`_so_err` set). `wfd` is the run's write end, `rfd` its read end.
fn _so_run_done(wfd, rfd, werr): i64 {
    if (werr == 0) { werr = _so_flush(); }
    k_close( wfd);
    _so_ofd = _so_out_fd;
    if (werr != 0) {
        k_write( 2, "kriya sort: write failed: a temporary file", 42);
        _so_errtail(0 - werr);
        _so_err = 1;
        k_close( rfd);
        return 0;
    }
    return _so_src_file(rfd);
}

# Sources `srcs[at .. at + k)` merged into one new source: in memory when they all are, else a
# run on disk. 0 after a reported error.
fn _so_merge_new(srcs, at, k): i64 {
    var allmem: i64 = 1;
    var total: i64 = 0;
    var i: i64 = 0;
    while (i < k) {
        var s = vec_get(srcs, at + i);
        if (load64(s + SO_S_KIND) != 0) { allmem = 0; }
        else { total = total + load64(s + SO_S_END) - load64(s + SO_S_IDX); }
        i = i + 1;
    }
    if (allmem == 1) {
        var d = alloc(total * 8 + 8);
        var cnt = _so_merge_srcs(srcs, at, k, d);
        return _so_src_mem(d, 0, cnt);
    }
    var fds[16];
    if (_so_temp_new(&fds, &fds + 8) != 0) {
        _so_err = 1;
        return 0;
    }
    _so_flush();
    _so_ofd = load64(&fds);
    var werr = _so_merge_srcs(srcs, at, k, 0);
    return _so_run_done(load64(&fds), load64(&fds + 8), werr);
}

# GNU's `merge` up to its last pass: while more than NMERGE sources remain, merge them NMERGE at
# a time from the front, with GNU's one shorter merge so that the rest fit the next pass. Returns
# how many are left for the caller's last merge into the output, or -1 after a reported error.
fn _so_merge_reduce(srcs): i64 {
    var n = vec_len(srcs);
    while (_SO_NMERGE < n) {
        var out: i64 = 0;
        var inp: i64 = 0;
        while (_SO_NMERGE <= n - inp) {
            var m = _so_merge_new(srcs, inp, _SO_NMERGE);
            if (m == 0) { return 0 - 1; }
            vec_set(srcs, out, m);
            out = out + 1;
            inp = inp + _SO_NMERGE;
        }
        var remainder = n - inp;
        var cheap = _SO_NMERGE - out % _SO_NMERGE;
        if (cheap < remainder) {
            var ns = remainder - cheap + 1;
            var m2 = _so_merge_new(srcs, inp, ns);
            if (m2 == 0) { return 0 - 1; }
            vec_set(srcs, out, m2);
            out = out + 1;
            inp = inp + ns;
        }
        var j: i64 = 0;
        while (inp + j < n) {
            vec_set(srcs, out + j, vec_get(srcs, inp + j));
            j = j + 1;
        }
        n = n - (inp - out);
    }
    return n;
}

# The external sort's pending runs, oldest first, and the level of each: sixteen of one level
# become one of the next as soon as they are there, so open descriptors stay few.
var _so_pend = 0;
var _so_plev = 0;

fn _so_pend_push(src): i64 {
    vec_push(_so_pend, src);
    vec_push(_so_plev, 0);
    var going: i64 = 1;
    while (going == 1) {
        going = 0;
        var n = vec_len(_so_pend);
        if (n >= _SO_NMERGE) {
            var lv = vec_get(_so_plev, n - 1);
            var same: i64 = 1;
            var i: i64 = n - _SO_NMERGE;
            while (i < n) {
                if (vec_get(_so_plev, i) != lv) { same = 0; }
                i = i + 1;
            }
            if (same == 1) {
                var m = _so_merge_new(_so_pend, n - _SO_NMERGE, _SO_NMERGE);
                if (m == 0) { return 1; }
                var keep = vec_new();
                var keepl = vec_new();
                var j: i64 = 0;
                while (j < n - _SO_NMERGE) {
                    vec_push(keep, vec_get(_so_pend, j));
                    vec_push(keepl, vec_get(_so_plev, j));
                    j = j + 1;
                }
                vec_push(keep, m);
                vec_push(keepl, lv + 1);
                _so_pend = keep;
                _so_plev = keepl;
                going = 1;
            }
        }
    }
    return 0;
}

# Reusable arrays for one buffer's records.
var _so_c_recs = 0;
var _so_c_ptrs = 0;
var _so_c_tmp = 0;
var _so_c_aux = 0;
var _so_c_cap = 0;

# Records for the lines of buf[0..len), every one terminated; the pointers go to `_so_c_ptrs`.
# Returns how many.
fn _so_chunk_records(buf, len): i64 {
    var n = _so_count_lines(buf, buf + len, _so_term);
    if (n > _so_c_cap) {
        var c = n;
        if (c < _so_c_cap * 2) { c = _so_c_cap * 2; }
        _so_c_recs = alloc(c * SO_R_SZ + 8);
        _so_c_ptrs = alloc(c * 8 + 8);
        _so_c_tmp = alloc(c * 8 + 8);
        var a = _so_auxsz();
        if (a > 0) { _so_c_aux = alloc(c * a + 8); }
        _so_c_cap = c;
    }
    _so_fill_records(buf, buf + len, _so_term, _so_c_recs, _so_c_ptrs, 0);
    var auxsz = _so_auxsz();
    var i: i64 = 0;
    while (i < n) {
        var slot: i64 = 0;
        if (auxsz > 0) { slot = _so_c_aux + i * auxsz; }
        _so_rec_keys(load64(_so_c_ptrs + i * 8), slot);
        i = i + 1;
    }
    return n;
}

# Sort buf[0..len) and write it out as a run, pushed onto the pending list. 0, or 1 after a
# reported error.
fn _so_spill(buf, len): i64 {
    var n = _so_chunk_records(buf, len);
    var order = _so_merge_sort(_so_c_ptrs, _so_c_tmp, n);
    var fds[16];
    if (_so_temp_new(&fds, &fds + 8) != 0) { return 1; }
    _so_ofd = load64(&fds);
    var werr: i64 = 0;
    var prev: i64 = 0;
    var i: i64 = 0;
    while (i < n && werr == 0) {
        var rec = load64(order + i * 8);
        var emit: i64 = 1;
        if (_so_unique == 1) {
            if (prev != 0) {
                if (_so_compare(prev, rec) == 0) { emit = 0; }
            }
        }
        if (emit == 1) {
            werr = _so_emit(load64(rec + SO_R_TEXT), load64(rec + SO_R_LEN), _so_term);
            prev = rec;
        }
        i = i + 1;
    }
    var src = _so_run_done(load64(&fds), load64(&fds + 8), werr);
    if (src == 0) { return 1; }
    return _so_pend_push(src);
}

# Physical memory in bytes, for `-S N%`: /proc/meminfo's MemTotal, or 64 MiB, gnulib's guess.
fn _so_physmem(): i64 {
    var fd = k_open("/proc/meminfo", 0, 0);
    if (fd < 0) { return 67108864; }
    var b[512];
    var n = k_read( fd, &b, 511);
    k_close( fd);
    if (n <= 0) { return 67108864; }
    store8(&b + n, 0);
    var i: i64 = 0;
    while (i < n) {
        if (load8(&b + i) >= 48) {
            if (load8(&b + i) <= 57) {
                var len: i64 = 0;
                var kb = kriya_count_digits(&b + i, &len);
                return kriya_count_mul(kb, 1024);
            }
        }
        if (load8(&b + i) == 10) { return 67108864; }
        i = i + 1;
    }
    return 67108864;
}

# GNU's `specify_sort_size`: bytes, -1 when malformed, -2 when too large, -3 for a bad suffix.
# Units `EgGkKmMPQRtTYZ` (powers of 1024), `b` for bytes, `%` of physical memory; a bare number is
# KiB.
fn _so_parse_size(val): i64 {
    var o[32];
    var e = kriya_xstrtou(val, "EgGkKmMPQRtTYZ", &o);
    var end = load64(&o + 8);
    var hi = load64(&o + 16);
    var lo = load64(&o + 24);
    var lastdig: i64 = 0;
    if (end > 0) { if (_vc_isdigit(load8(val + end - 1)) == 1) { lastdig = 1; } }
    if (e == 0) {
        if (lastdig == 1) {
            _kx_hi = hi;
            _kx_lo = lo;
            _kx_ovf = 0;
            _kx_mul(1024);
            if (_kx_ovf == 1) { return 0 - 2; }
            hi = _kx_hi;
            lo = _kx_lo;
        }
    }
    if (e == KRIYA_XS_BADSUFFIX) {
        if (lastdig == 1) {
            if (load8(val + end + 1) == 0) {
                var c = load8(val + end);
                if (c == 98) { e = 0; }
                if (c == 37) {
                    var nd = f64_add(f64_mul(f64_from(hi), 0x41F0000000000000), f64_from(lo));   # 2^32
                    var mem = f64_div(f64_mul(f64_from(_so_physmem()), nd), 0x4059000000000000); # 100
                    if (f64_ge(mem, 0x43F0000000000000) == 1) { return 0 - 2; }               # 2^64
                    if (f64_ge(mem, 0x43D0000000000000) == 1) { return 4611686018427387904; }  # 2^62
                    return f64_to(mem);
                }
            }
        }
    }
    if (e == 0) {
        if (hi > 2147483647) { return KRIYA_COUNT_MAX; }
        return (hi << 32) | lo;
    }
    if (e == KRIYA_XS_OVERFLOW) { return 0 - 2; }
    if ((e & KRIYA_XS_BADSUFFIX) != 0) { return 0 - 3; }
    return 0 - 1;
}

# --- reading the inputs ---------------------------------------------------------------------------
var _so_buf = 0;
var _so_bcap = 0;

# Double the input buffer for a line longer than it.
fn _so_grow(have): i64 {
    var nb = alloc(_so_bcap * 2);
    if (nb == 0) { return 1; }
    memcpy(nb, _so_buf, have);
    _so_buf = nb;
    _so_bcap = _so_bcap * 2;
    return 0;
}

# The last terminator in buf[0..have), plus one; 0 when there is none.
fn _so_cut(have): i64 {
    var q = have;
    while (q > 0) {
        if (load8(_so_buf + q - 1) == _so_term) { return q; }
        q = q - 1;
    }
    return 0;
}

# Open input `p` ("-" is standard input). Returns the descriptor, or a negative errno.
fn _so_open_in(p): i64 {
    if (load8(p) == 45) {
        if (load8(p + 1) == 0) { return 0; }
    }
    return k_open(p, 0, 0);
}

fn _so_count_terms(p, n): i64 {
    var c: i64 = 0;
    var i: i64 = 0;
    while (i < n) {
        if (load8(p + i) == _so_term) { c = c + 1; }
        i = i + 1;
    }
    return c;
}

# Write the records `order[0..n)` to the output, the first of each run of equal lines under -u.
# Opens `-o` first. Returns the exit status.
fn _so_open_out(): i64 {
    _so_out_fd = 1;
    if (_so_outfile != 0) {
        var fd = k_open(_so_outfile, 0o1101, 0o666);        # O_WRONLY | O_CREAT | O_TRUNC
        if (fd < 0) {
            _so_report(_so_outfile, 0 - fd);
            return SO_EXIT_TROUBLE;
        }
        _so_out_fd = fd;
    }
    _so_ofd = _so_out_fd;
    return 0;
}

fn _so_close_out(werr): i64 {
    if (werr == 0) { werr = _so_flush(); }
    if (_so_out_fd != 1) { k_close( _so_out_fd); }
    if (werr != 0) {
        _so_report("(write)", 0 - werr);  # its name is roadmap 1.10.5's
        return SO_EXIT_TROUBLE;
    }
    return EXIT_SUCCESS;
}

fn _so_output_records(order, n): i64 {
    var oc = _so_open_out();
    if (oc != 0) { return oc; }
    var werr: i64 = 0;
    var prev: i64 = 0;
    var i: i64 = 0;
    while (i < n && werr == 0) {
        var rec = load64(order + i * 8);
        var emit: i64 = 1;
        if (_so_unique == 1) {
            # The first of each run of equal keys: each line against the last one written.
            if (prev != 0) {
                if (_so_compare(prev, rec) == 0) { emit = 0; }
            }
        }
        if (emit == 1) {
            werr = _so_emit(load64(rec + SO_R_TEXT), load64(rec + SO_R_LEN), _so_term);
            prev = rec;
        }
        i = i + 1;
    }
    return _so_close_out(werr);
}

# The last merge, from the reduced sources into the output.
fn _so_output_merge(srcs): i64 {
    var n = _so_merge_reduce(srcs);
    if (n < 0) { return SO_EXIT_TROUBLE; }
    var oc = _so_open_out();
    if (oc != 0) { return oc; }
    var w = _so_merge_srcs(srcs, 0, n, 0);
    if (_so_err != 0) {
        _so_close_out(0);
        return SO_EXIT_TROUBLE;
    }
    return _so_close_out(w);
}

# Read operand `fi` (of `npos`) into the buffer, a buffer at a time: `full` is called back when
# the bytes and their records pass the budget, with the buffer's length, and returns 0 to go on.
# A file's last line ends where the file does: a missing terminator is added. Returns 0 or the
# exit status. `*have_p` and `*lines_p` carry the buffer's length and whole lines across files.
fn _so_read_input(p, have_p, lines_p, mode): i64 {
    var fd = _so_open_in(p);
    if (fd < 0) {
        _so_report(p, 0 - fd);
        return SO_EXIT_TROUBLE;
    }
    var cost = _so_line_cost();
    var last: i64 = 0 - 1;
    var going: i64 = 1;
    while (going == 1) {
        var have = load64(have_p);
        if (have == _so_bcap) {
            var fr = _so_full(have_p, lines_p, mode);
            if (fr != 0) {
                if (fd != 0) { k_close( fd); }
                return fr;
            }
            have = load64(have_p);
        }
        var room = _so_bcap - have;
        if (room > _SORT_READ_BUFSZ * 16) { room = _SORT_READ_BUFSZ * 16; }
        var n = k_read( fd, _so_buf + have, room);
        if (n < 0) {
            if (n != (0 - 4)) {
                if (fd != 0) { k_close( fd); }
                _so_report(p, 0 - n);
                return SO_EXIT_TROUBLE;
            }
        } elif (n == 0) {
            going = 0;
        } else {
            store64(lines_p, load64(lines_p) + _so_count_terms(_so_buf + have, n));
            store64(have_p, have + n);
            last = load8(_so_buf + have + n - 1);
            # -c keeps one line back, so it needs two before the budget can make progress.
            var need: i64 = 1;
            if (mode == 2) { need = 2; }
            if (load64(lines_p) >= need) {
                if (have + n + load64(lines_p) * cost >= _so_budget) {
                    var fr2 = _so_full(have_p, lines_p, mode);
                    if (fr2 != 0) {
                        if (fd != 0) { k_close( fd); }
                        return fr2;
                    }
                }
            }
        }
    }
    if (fd != 0) { k_close( fd); }
    if (last >= 0) {
        if (last != _so_term) {
            if (load64(have_p) == _so_bcap) {
                var fr3 = _so_full(have_p, lines_p, mode);
                if (fr3 != 0) { return fr3; }
            }
            var h = load64(have_p);
            store8(_so_buf + h, _so_term);
            store64(have_p, h + 1);
            store64(lines_p, load64(lines_p) + 1);
        }
    }
    return 0;
}

# The buffer is full. Sort (mode 0): spill its whole lines as a run. Check (mode 2): check them
# and keep the last. A buffer holding no whole line grows instead. Returns 0 or the exit status.
var _so_chk_line = 1;           # -c: the line number of the buffer's first line
fn _so_full(have_p, lines_p, mode): i64 {
    var have = load64(have_p);
    var cut = _so_cut(have);
    if (cut == 0) {
        if (_so_grow(have) != 0) { return SO_EXIT_TROUBLE; }
        return 0;
    }
    var keep_from = cut;
    if (mode == 0) {
        if (_so_spill(_so_buf, cut) != 0) { return SO_EXIT_TROUBLE; }
    } else {
        # Keep the last whole line, to compare with the next buffer's first. A buffer that
        # holds only that line grows instead.
        var q = cut - 1;
        while (q > 0 && load8(_so_buf + q - 1) != _so_term) { q = q - 1; }
        if (q == 0) {
            if (_so_grow(have) != 0) { return SO_EXIT_TROUBLE; }
            return 0;
        }
        var cr = _so_check_chunk(cut);
        if (cr != 0) { return cr; }
        keep_from = q;
        _so_chk_line = _so_chk_line + _so_count_lines(_so_buf, _so_buf + q, _so_term);
    }
    memcpy(_so_buf, _so_buf + keep_from, have - keep_from);
    store64(have_p, have - keep_from);
    store64(lines_p, _so_count_terms(_so_buf, have - keep_from));
    return 0;
}

# -c / -C over buf[0..len): each line against the one before it. ⚠ With `-u` the order must be
# STRICT, as GNU checks it: an equal pair is a disorder. Returns 0, or 1 at a disorder.
fn _so_check_chunk(len): i64 {
    var n = _so_chunk_records(_so_buf, len);
    var ci: i64 = 1;
    while (ci < n) {
        var cmp = _so_compare(load64(_so_c_ptrs + (ci - 1) * 8), load64(_so_c_ptrs + ci * 8));
        var disorder: i64 = 0;
        if (cmp > 0) { disorder = 1; }
        if (_so_unique == 1) {
            if (cmp == 0) { disorder = 1; }
        }
        if (disorder == 1) {
            if (_so_checkonly == 99) {
                k_write( 2, "kriya sort: disorder at line ", 29);
                _so_put_num(_so_chk_line + ci);
                k_write( 2, "\n", 1);
            }
            return EXIT_FAILURE;
        }
        ci = ci + 1;
    }
    return 0;
}

# sort: every input a buffer at a time; in memory when it all fits, else runs and a merge.
fn _so_sort_inputs(npos): i64 {
    _so_pend = vec_new();
    _so_plev = vec_new();
    var have[8];
    var lines[8];
    store64(&have, 0);
    store64(&lines, 0);
    var nf = npos;
    if (nf < 1) { nf = 1; }
    var fi: i64 = 0;
    while (fi < nf) {
        var p = "-";
        if (npos > 0) { p = flags_positional(_so_spec, fi); }
        var r = _so_read_input(p, &have, &lines, 0);
        if (r != 0) { return r; }
        fi = fi + 1;
    }
    if (vec_len(_so_pend) == 0) {
        var n = _so_chunk_records(_so_buf, load64(&have));
        var order = _so_merge_sort(_so_c_ptrs, _so_c_tmp, n);
        return _so_output_records(order, n);
    }
    if (load64(&have) > 0) {
        if (_so_spill(_so_buf, load64(&have)) != 0) { return SO_EXIT_TROUBLE; }
    }
    return _so_output_merge(_so_pend);
}

# -c / -C: operand 0 (or standard input), checked a buffer at a time.
fn _so_check_input(npos): i64 {
    var have[8];
    var lines[8];
    store64(&have, 0);
    store64(&lines, 0);
    _so_chk_line = 1;
    var p = "-";
    if (npos > 0) { p = flags_positional(_so_spec, 0); }
    var r = _so_read_input(p, &have, &lines, 2);
    if (r != 0) { return r; }
    var cr = _so_check_chunk(load64(&have));
    if (cr != 0) { return cr; }
    return EXIT_SUCCESS;
}

# A run holding buf[a..b) and then the rest of `fd` (when `fd` >= 0), its last line terminated.
# 0 after a reported error.
fn _so_copy_run(a, b, fd, name): i64 {
    var fds[16];
    if (_so_temp_new(&fds, &fds + 8) != 0) {
        _so_err = 1;
        return 0;
    }
    var wfd = load64(&fds);
    var werr = _so_write_all(wfd, _so_buf + a, b - a);
    var last: i64 = 0 - 1;
    if (b > a) { last = load8(_so_buf + b - 1); }
    if (fd >= 0) {
        var tmp = alloc(_SORT_READ_BUFSZ);
        var going: i64 = 1;
        while (going == 1 && werr == 0) {
            var n = k_read( fd, tmp, _SORT_READ_BUFSZ);
            if (n < 0) {
                if (n != (0 - 4)) {
                    _so_report(name, 0 - n);
                    _so_err = 1;
                    k_close( wfd);
                    k_close( load64(&fds + 8));
                    return 0;
                }
            } elif (n == 0) { going = 0; }
            else {
                werr = _so_write_all(wfd, tmp, n);
                last = load8(tmp + n - 1);
            }
        }
    }
    if (werr == 0) {
        if (last >= 0) {
            if (last != _so_term) {
                var t[8];
                store8(&t, _so_term);
                werr = _so_write_all(wfd, &t, 1);
            }
        }
    }
    _so_obn = 0;
    return _so_run_done(wfd, load64(&fds + 8), werr);
}

# -m: every input whole in memory when they fit, merged there; else each copied to a run of its
# own and the runs merged. Both by GNU's NMERGE grouping, which bounds the open runs.
fn _so_merge_inputs(npos): i64 {
    var nf = npos;
    if (nf < 1) { nf = 1; }
    var fbyte = alloc(nf * 8 + 8);
    var have[8];
    var lines[8];
    store64(&have, 0);
    store64(&lines, 0);
    var cost = _so_line_cost();
    var fi: i64 = 0;
    var over: i64 = 0 - 1;     # the operand that did not fit, once one does not
    var ofd: i64 = 0 - 1;
    while (fi < nf && over < 0) {
        store64(fbyte + fi * 8, load64(&have));
        var p = "-";
        if (npos > 0) { p = flags_positional(_so_spec, fi); }
        var fd = _so_open_in(p);
        if (fd < 0) {
            _so_report(p, 0 - fd);
            return SO_EXIT_TROUBLE;
        }
        var last: i64 = 0 - 1;
        var going: i64 = 1;
        while (going == 1) {
            var h = load64(&have);
            var room = _so_bcap - h - 1;                  # one byte kept for a terminator
            if (room > _SORT_READ_BUFSZ * 16) { room = _SORT_READ_BUFSZ * 16; }
            var fits: i64 = 1;
            if (room <= 0) { fits = 0; }
            if (h + load64(&lines) * cost >= _so_budget) { fits = 0; }
            if (fits == 0) {
                over = fi;
                ofd = fd;
                going = 0;
            } else {
                var n = k_read( fd, _so_buf + h, room);
                if (n < 0) {
                    if (n != (0 - 4)) {
                        _so_report(p, 0 - n);
                        return SO_EXIT_TROUBLE;
                    }
                } elif (n == 0) { going = 0; }
                else {
                    store64(&lines, load64(&lines) + _so_count_terms(_so_buf + h, n));
                    store64(&have, h + n);
                    last = load8(_so_buf + h + n - 1);
                }
            }
        }
        if (over < 0) {
            if (fd != 0) { k_close( fd); }
            if (last >= 0) {
                if (last != _so_term) {
                    store8(_so_buf + load64(&have), _so_term);
                    store64(&have, load64(&have) + 1);
                    store64(&lines, load64(&lines) + 1);
                }
            }
            fi = fi + 1;
        }
    }
    var srcs = vec_new();
    if (over < 0) {
        store64(fbyte + nf * 8, load64(&have));
        var total = _so_chunk_records(_so_buf, load64(&have));
        var j: i64 = 0;
        var at: i64 = 0;
        while (j < nf) {
            var cnt = _so_count_lines(_so_buf + load64(fbyte + j * 8), _so_buf + load64(fbyte + (j + 1) * 8),
              _so_term);
            vec_push(srcs, _so_src_mem(_so_c_ptrs, at, at + cnt));
            at = at + cnt;
            j = j + 1;
        }
        if (at != total) { return SO_EXIT_TROUBLE; }
        return _so_output_merge(srcs);
    }
    # Past the budget: every input becomes a run, in order, and the runs are merged.
    var k: i64 = 0;
    while (k < over) {
        var s = _so_copy_run(load64(fbyte + k * 8), load64(fbyte + (k + 1) * 8), 0 - 1, "");
        if (s == 0) { return SO_EXIT_TROUBLE; }
        vec_push(srcs, s);
        k = k + 1;
    }
    var pname = "-";
    if (npos > 0) { pname = flags_positional(_so_spec, over); }
    var s2 = _so_copy_run(load64(fbyte + over * 8), load64(&have), ofd, pname);
    if (ofd != 0) { k_close( ofd); }
    if (s2 == 0) { return SO_EXIT_TROUBLE; }
    vec_push(srcs, s2);
    k = over + 1;
    while (k < nf) {
        var p2 = "-";
        if (npos > 0) { p2 = flags_positional(_so_spec, k); }
        var fd2 = _so_open_in(p2);
        if (fd2 < 0) {
            _so_report(p2, 0 - fd2);
            return SO_EXIT_TROUBLE;
        }
        var s3 = _so_copy_run(0, 0, fd2, p2);
        if (fd2 != 0) { k_close( fd2); }
        if (s3 == 0) { return SO_EXIT_TROUBLE; }
        vec_push(srcs, s3);
        k = k + 1;
    }
    return _so_output_merge(srcs);
}

# --- options --------------------------------------------------------------------------------------

# A `--check=` or `--sort=` value refused, in kriya's framing with GNU's choices.
fn _so_bad_word(opt, val, why, choices): i64 {
    k_write( 2, "kriya sort: ", 12);
    k_write( 2, opt, strlen(opt));
    k_write( 2, ": '", 3);
    k_write( 2, val, strlen(val));
    k_write( 2, "' ", 2);
    k_write( 2, why, strlen(why));
    k_write( 2, " (use ", 6);
    k_write( 2, choices, strlen(choices));
    k_write( 2, ")\n", 2);
    return EXIT_USAGE;
}

var _so_checkonly = 0;   # 0, 99 (`c`, diagnose) or 67 (`C`, quiet)
var _so_size_opt = 0 - 1;   # the largest -S, in bytes, or -1
var _so_outfile = 0;
var _so_rsource = 0;

# One `-c`, `-C` or `--check[=WORD]`. Returns 0 or the exit status.
fn _so_opt_check(c): i64 {
    if (_so_checkonly != 0) {
        if (_so_checkonly != c) {
            _so_say("options '-cC' are incompatible");
            return EXIT_USAGE;
        }
    }
    _so_checkonly = c;
    return 0;
}

# The options whose ORDER or REPETITION matters, walked in command-line order over the expanded
# argv the way `kriya_opt_seq` walks it: every `-k` (each one more key), `-t` (a second, different
# one is an error), `-o` and `--random-source` (likewise), `-c`/`-C`/`--check`, and `--sort`.
# Returns 0 or the exit status.
#
# ⛔ THE FLAG TABLE KEEPS ONE VALUE PER OPTION, so a repeated `-k` kept only the LAST key until
# 1.9.1: `sort -k2,2 -k1,1` sorted exactly as `sort -k1,1`, exit 0, where GNU sorts by field 2,
# then field 1.
fn _so_scan_opts(): i64 {
    var av = kriya_expanded_argv();
    var n  = kriya_expanded_argc();
    if (av == 0) { return 0; }
    var no_more: i64 = 0;
    var i: i64 = 1;
    while (i < n) {
        var tok  = load64(av + i * 8);
        var tlen = strlen(tok);
        var step: i64 = 1;
        var which: i64 = 0;       # the option's short letter, or 1 random-source, 2 sort
        var val: i64 = 0;
        if (no_more == 0) {
            if (tlen >= 2) {
                if (load8(tok) == 45) {
                    if (load8(tok + 1) == 45) {
                        if (tlen == 2) { no_more = 1; }
                        else {
                            var eq: i64 = 0;
                            var e: i64 = 2;
                            while (e < tlen && eq == 0) {
                                if (load8(tok + e) == 61) { eq = e; }
                                e = e + 1;
                            }
                            var nlen = tlen - 2;
                            if (eq > 0) {
                                nlen = eq - 2;
                                val = tok + eq + 1;
                            }
                            var lt = kriya_long_type(_so_spec, tok + 2, nlen);
                            if (lt > 0) {
                                if (eq == 0) {
                                    if (i + 1 < n) { val = load64(av + (i + 1) * 8); }
                                    step = 2;
                                }
                            }
                            if (lt == 0) { val = kriya_expanded_optval(i); }
                            var nm = alloc(nlen + 1);
                            memcpy(nm, tok + 2, nlen);
                            store8(nm + nlen, 0);
                            if (streq(nm, "key") == 1) { which = 107; }
                            elif (streq(nm, "field-separator") == 1) { which = 116; }
                            elif (streq(nm, "output") == 1) { which = 111; }
                            elif (streq(nm, "random-source") == 1) { which = 1; }
                            elif (streq(nm, "sort") == 1) { which = 2; }
                            elif (streq(nm, "check") == 1) { which = 99; }
                            elif (streq(nm, "buffer-size") == 1) { which = 83; }
                            elif (streq(nm, "temporary-directory") == 1) { which = 84; }
                        }
                    } else {
                        var c = load8(tok + 1);
                        var ty = kriya_short_type(_so_spec, c);
                        if (ty >= 0) {
                            which = c;
                            if (ty > 0) {
                                if (i + 1 < n) { val = load64(av + (i + 1) * 8); }
                                step = 2;
                            }
                        }
                    }
                }
            }
        }
        if (which == 107) {
            var k = _so_parse_key(val);
            if (k == 0) { return EXIT_USAGE; }
            vec_push(_so_keys, k);
        } elif (which == 116) {
            if (load8(val) == 0) {
                _so_say("empty tab");
                return EXIT_USAGE;
            }
            var nt = load8(val);
            if (load8(val + 1) != 0) {
                if (streq(val, "\\0") == 1) { nt = 0; }
                else {
                    report_note("sort", val, "multi-character tab");
                    return EXIT_USAGE;
                }
            }
            if (_so_tab >= 0) {
                if (_so_tab != nt) {
                    _so_say("incompatible tabs");
                    return EXIT_USAGE;
                }
            }
            _so_tab = nt;
        } elif (which == 111) {
            if (_so_outfile != 0) {
                if (streq(_so_outfile, val) == 0) {
                    _so_say("multiple output files specified");
                    return EXIT_USAGE;
                }
            }
            _so_outfile = val;
        } elif (which == 1) {
            if (_so_rsource != 0) {
                if (streq(_so_rsource, val) == 0) {
                    _so_say("multiple random sources specified");
                    return EXIT_USAGE;
                }
            }
            _so_rsource = val;
        } elif (which == 2) {
            var words = "general-numeric\0human-numeric\0month\0numeric\0random\0version";
            var sc = kriya_argmatch(val, words, "ghMnRV", 6);
            if (sc < 0) {
                var why = "is not a sort order";
                if (sc == 0 - 2) { why = "is ambiguous"; }
                return _so_bad_word("--sort", val,
                  why, "general-numeric, human-numeric, month, numeric, random or version");
            }
            var one[2];
            store8(&one, sc);
            store8(&one + 1, 0);
            _so_set_ordering(&one, 0, _so_gkey, 3);
        } elif (which == 99) {
            var cc: i64 = 99;
            if (val != 0) {
                cc = kriya_argmatch(val, "quiet\0silent\0diagnose-first", "CCc", 3);
                if (cc < 0) {
                    var why2 = "is not a check mode";
                    if (cc == 0 - 2) { why2 = "is ambiguous"; }
                    return _so_bad_word("--check", val, why2, "quiet, silent or diagnose-first");
                }
            }
            var rc = _so_opt_check(cc);
            if (rc != 0) { return rc; }
        } elif (which == 67) {
            var rc2 = _so_opt_check(67);
            if (rc2 != 0) { return rc2; }
        } elif (which == 83) {
            # GNU's `-S`: several take the largest, so that their order does not matter.
            var sz = _so_parse_size(val);
            if (sz < 0) {
                var smsg = "invalid -S argument";
                if (sz == (0 - 2)) { smsg = "-S argument too large"; }
                if (sz == (0 - 3)) { smsg = "invalid suffix in -S argument"; }
                report_note("sort", val, smsg);
                return EXIT_USAGE;
            }
            if (sz > _so_size_opt) { _so_size_opt = sz; }
        } elif (which == 84) {
            vec_push(_so_tdirs, val);
        }
        i = i + step;
    }
    return 0;
}

# Render `v` (>= 0) in decimal to fd 2.
fn _so_put_num(v): i64 {
    var tmp[32];
    var t: i64 = 31;
    var rem = v;
    if (rem == 0) { store8(&tmp + t, 48); t = t - 1; }
    while (rem > 0) {
        store8(&tmp + t, 48 + (rem % 10));
        rem = rem / 10;
        t = t - 1;
    }
    k_write( 2, &tmp + t + 1, 31 - t);
    return 0;
}

fn cmd_sort(start: i64): i64 {
    _so_init_spec();
    _so_tables();
    # GNU's `--check[=quiet|silent|diagnose-first]`. The value used to be
    # swallowed, so `--check=quiet` still printed the disorder line it exists to
    # suppress.
    if (kriya_args_parse_optval(_so_spec, start, 0, "check") != 0) {
        k_write( 2, "kriya sort: error: bad option (see ADR 0002 for accepted syntax)\n", 65);
        return EXIT_USAGE;
    }
    _so_keys = vec_new();
    _so_gkey = _so_key_new();
    store64(_so_gkey + SO_K_SWORD, 0 - 1);
    _so_tab = 0 - 1;
    _so_checkonly = 0;
    _so_outfile = 0;
    _so_rsource = 0;
    _so_size_opt = 0 - 1;
    _so_tdirs = vec_new();
    var rc = _so_scan_opts();
    if (rc != 0) { return rc; }
    _so_budget = 536870912;
    if (_so_size_opt >= 0) {
        # At least a little, and no more than the allocator can map in one piece.
        _so_budget = _so_size_opt;
        if (_so_budget < 1024) { _so_budget = 1024; }
        if (_so_budget > 1610612736) { _so_budget = 1610612736; }
    }

    # The global letters. Their order never matters: `-d` wins over `-i` either way round.
    var g = _so_gkey;
    if (flags_get_bool(_so_spec, _so_b_idx) == 1) { _so_set_ordering("b", 0, g, 3); }
    if (flags_get_bool(_so_spec, _so_d_idx) == 1) { _so_set_ordering("d", 0, g, 3); }
    if (flags_get_bool(_so_spec, _so_f_idx) == 1) { _so_set_ordering("f", 0, g, 3); }
    if (flags_get_bool(_so_spec, _so_g_idx) == 1) { _so_set_ordering("g", 0, g, 3); }
    if (flags_get_bool(_so_spec, _so_h_idx) == 1) { _so_set_ordering("h", 0, g, 3); }
    if (flags_get_bool(_so_spec, _so_i_idx) == 1) { _so_set_ordering("i", 0, g, 3); }
    if (flags_get_bool(_so_spec, _so_mm_idx) == 1) { _so_set_ordering("M", 0, g, 3); }
    if (flags_get_bool(_so_spec, _so_n_idx) == 1) { _so_set_ordering("n", 0, g, 3); }
    if (flags_get_bool(_so_spec, _so_r_idx) == 1) { _so_set_ordering("r", 0, g, 3); }
    if (flags_get_bool(_so_spec, _so_rr_idx) == 1) { _so_set_ordering("R", 0, g, 3); }
    if (flags_get_bool(_so_spec, _so_v_idx) == 1) { _so_set_ordering("V", 0, g, 3); }
    _so_unique = flags_get_bool(_so_spec, _so_u_idx);
    _so_stable = flags_get_bool(_so_spec, _so_s_idx);
    var merge_only = flags_get_bool(_so_spec, _so_m_idx);
    var term_byte: i64 = 10;
    if (flags_get_bool(_so_spec, _so_z_idx) == 1) { term_byte = 0; }

    # ⭐ A key with no letters of its own takes all the global ones, `-r` included — GNU's rule, so
    # `-n -k2,2` is `-k2,2n`. A key with any letter, even only `b`, takes none: `-n -k2b` is text.
    var nk = vec_len(_so_keys);
    var need_random: i64 = 0;
    var ki: i64 = 0;
    while (ki < nk) {
        var k = vec_get(_so_keys, ki);
        if (_so_key_default(k) == 1) {
            if (load64(k + SO_K_REV) == 0) {
                var o: i64 = SO_K_SKIPS;
                while (o <= SO_K_REV) {
                    store64(k + o, load64(g + o));
                    o = o + 8;
                }
            }
        }
        if (load64(k + SO_K_RAND) == 1) { need_random = 1; }
        ki = ki + 1;
    }
    if (nk == 0) {
        if (_so_key_default(g) == 0) {
            vec_push(_so_keys, g);
            nk = 1;
            if (load64(g + SO_K_RAND) == 1) { need_random = 1; }
        }
    }
    ki = 0;
    while (ki < nk) {
        var kk = vec_get(_so_keys, ki);
        if (_so_key_incompatible(kk) == 1) {
            var opts[16];
            _so_key_opts(kk, &opts);
            k_write( 2, "kriya sort: options '-", 22);
            k_write( 2, &opts, strlen(&opts));
            k_write( 2, "' are incompatible\n", 19);
            return EXIT_USAGE;
        }
        ki = ki + 1;
    }
    _so_nkeys = nk;
    var karr = alloc(nk * 8 + 8);
    ki = 0;
    while (ki < nk) {
        store64(karr + ki * 8, vec_get(_so_keys, ki));
        ki = ki + 1;
    }
    _so_keys = karr;
    _so_reverse = load64(g + SO_K_REV);
    if (need_random == 1) {
        var rr = _so_random_init(_so_rsource);
        if (rr != 0) { return rr; }
    }

    var npos = flags_positional_count(_so_spec);
    if (_so_checkonly != 0) {
        if (npos > 1) {
            k_write( 2, "kriya sort: extra operand ", 26);
            _report_operand(flags_positional(_so_spec, 1));
            k_write( 2, " not allowed with -", 19);
            var cl[2];
            store8(&cl, _so_checkonly);
            k_write( 2, &cl, 1);
            k_write( 2, "\n", 1);
            return EXIT_USAGE;
        }
        if (_so_outfile != 0) {
            var co[8];
            store8(&co, _so_checkonly);
            store8(&co + 1, 111);
            store8(&co + 2, 0);
            k_write( 2, "kriya sort: options '-", 22);
            k_write( 2, &co, 2);
            k_write( 2, "' are incompatible\n", 19);
            return EXIT_USAGE;
        }
    }

    _so_term = term_byte;
    if (vec_len(_so_tdirs) == 0) {
        var td = getenv("TMPDIR");
        if (td == 0) { td = "/tmp"; }
        vec_push(_so_tdirs, td);
    }
    _so_tdir_i = 0;
    _so_err = 0;
    _so_out_fd = 1;
    _so_ofd = 1;
    _so_ob = alloc(_SO_OBSZ);
    _so_obn = 0;
    # The input buffer: the budget, or a little more for one byte past it.
    _so_bcap = _so_budget;
    if (_so_bcap > 1610612736) { _so_bcap = 1610612736; }
    _so_buf = alloc(_so_bcap + 8);
    if (_so_buf == 0) {
        k_write( 2, "kriya sort: memory exhausted\n", 29);
        return SO_EXIT_TROUBLE;
    }
    if (_so_checkonly != 0) { return _so_check_input(npos); }
    if (merge_only == 1) { return _so_merge_inputs(npos); }
    return _so_sort_inputs(npos);
}
