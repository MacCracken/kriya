# sort — POSIX `sort(1)`: line-oriented sort.
#
# Argument shape:
#   sort [opts] [file...]
#
# Flags:
#   -n / --numeric-sort       compare leading numeric strings.
#   -r / --reverse            reverse the sort.
#   -u / --unique             output only the first of equal lines.
#   -f / --ignore-case        case-fold ASCII letters in comparisons.
#   -b / --ignore-leading-blanks  skip leading spaces/tabs in keys.
#   -t SEP / --field-separator=SEP   single-byte field delimiter.
#   -k F[,F2] / --key=...     sort by fields F through F2 (to the end of the
#                             line without F2), 1-indexed.
#   -c / --check              verify input is already sorted; exit 1
#                             on first out-of-order line.
#   -o FILE / --output=FILE   write output to FILE (truncate, mode 0666)
#                             instead of stdout.
#   -z / --zero-terminated    NUL-separated lines on input and output.
#   -s / --stable             lines whose keys tie keep their input order,
#                             instead of being compared whole.
#
# **Stable merge sort** in heap-allocated record arrays. The input is
# read into one contiguous buffer; each line becomes a 16-byte record
# (offset + length pointing into the buffer). Comparison receives the
# raw line bytes and applies `-b`/`-f`/`-k`/`-t` transformations on
# the fly without materialising key copies.
#
# Memory cap: a single 256 MiB input buffer (`_SORT_INPUT_CAP`). If
# the input exceeds the cap, a stderr warning is emitted and the
# input is truncated to the cap. **External-sort fallback for files
# larger than this is a clear follow-up**; for typical script use, (roadmap 1.8.2)
# 256 MiB covers the vast majority of cases.
#
# Deferred (each a named follow-up): (roadmap 1.8.1 / 1.8.2)
#   -h / --human-numeric-sort    K/M/G suffix-aware numeric sort.
#   -V / --version-sort          natural-version-string ordering.
#   -g / --general-numeric-sort  full strtod-style numeric (scientific).
#   -M / --month-sort            locale month-name ordering.
#   -R / --random-sort           shuffle.
#   -m / --merge                 merge already-sorted inputs.
#   -d / --dictionary-order      only blanks + alnums compared.
#   -i / --ignore-nonprinting    skip non-printable bytes.
#   Multi-key sorting (-k F1 -k F2 ...) — first ship supports one key.
#   ⚠ `-k F1,F2` end-field key range SHIPS — verified byte-identical to GNU for
#   ⚠ `-k` KEY WINDOWS were wrong until 1.3.3 and the comment here hid it: it
#     claimed the `F1,F2` range "SHIPS — verified byte-identical to GNU", but
#     the only cases verified were `-k1,1` and `-k2,2`, where start == end and
#     truncation is invisible. A real range was silently cut to F1, and a bare
#     `-k F` was read as `-k F,F` when POSIX and GNU mean field F to END OF
#     LINE. Both diverge only when the start field TIES, which no test had.
#     Fixed and pinned against GNU in scripts/smoke-sort.sh.
#   External-sort fallback for inputs larger than 256 MiB.
#   `-S SIZE` and `-T DIR` (only relevant under external-sort).

var _so_spec = 0;
var _so_n_idx = 0;
var _so_r_idx = 0;
var _so_u_idx = 0;
var _so_f_idx = 0;
var _so_b_idx = 0;
var _so_t_idx = 0;
var _so_k_idx = 0;
var _so_c_idx = 0;
var _so_o_idx = 0;
var _so_z_idx = 0;
var _so_s_idx = 0;

var _SORT_INPUT_CAP: i64 = 268435456;  # 256 MiB
var _SORT_READ_BUFSZ: i64 = 65536;

fn _so_init_spec(): i64 {
    if (_so_spec != 0) { return 0; }
    var s = flags_new();
    _so_n_idx = flags_add_bool(s, 110, "numeric-sort",         0, "numeric compare");
    _so_r_idx = flags_add_bool(s, 114, "reverse",              0, "reverse the sort");
    _so_u_idx = flags_add_bool(s, 117, "unique",               0, "output only unique lines");
    _so_f_idx = flags_add_bool(s, 102, "ignore-case",          0, "case-fold ASCII");
    _so_b_idx = flags_add_bool(s, 98,  "ignore-leading-blanks", 0, "skip leading blanks in key");
    _so_t_idx = flags_add_str(s,  116, "field-separator",      0, "field separator (1 byte)");
    _so_k_idx = flags_add_str(s,  107, "key",                  0, "sort key field (1-indexed)");
    _so_c_idx = flags_add_bool(s, 99,  "check",                0, "verify input is sorted");
    _so_o_idx = flags_add_str(s,  111, "output",               0, "write output to FILE");
    _so_z_idx = flags_add_bool(s, 122, "zero-terminated",      0, "NUL-separated lines");
    _so_s_idx = flags_add_bool(s, 115, "stable",               0, "keep lines with equal keys in input order");
    _so_spec = s;
    sort_help_declare();
    return 0;
}

# Help/introspection record for `sort`. ⭐ Split out so `kriya --list` can
# populate it WITHOUT running the utility — one declaration feeding `--help`,
# `--help=json` and `--list` alike.
fn sort_help_declare(): i64 {
    help_begin("sort", "Sort lines of text.",
      "sort [OPTIONS] [FILE...]");
    help_positional(0, HELP_POS_UNBOUNDED, "FILE");
    help_destructive(1);
    help_operands("⚠ Sorts in memory with a 256 MiB cap; an external-sort fallback is a named follow-up.");  # roadmap 1.8.2  #skip-lint
    help_exit(1, "-c found the input unsorted, or a file could not be read");
    help_example("sort names.txt");
    help_example("sort -n -r nums");
    help_example("sort -t: -k1,1 /etc/passwd");
    return 0;
}

# ⭐ ONE LINE NOW. The 24-line body this replaces was byte-identical in every
# utility apart from the name; `errmsg_report` in `src/lib/report.cyr` is the
# single implementation of architecture 001's framing, and it shell-quotes the
# operand so a name containing a newline cannot split the diagnostic in two.
fn _so_report(operand, errno): i64 { return errmsg_report("sort", operand, errno); }

# Line record layout (16 bytes):
#   offset 0 : byte offset into the input buffer
#   offset 8 : line length (excluding terminator)
fn _so_rec_off(r): i64 { return load64(r); }
fn _so_rec_len(r): i64 { return load64(r + 8); }

# Slurp `fd` into `buf` up to `cap` bytes. Returns total bytes read.
# On overflow, sets `*overflow_p` to 1 and truncates.
fn _so_slurp(fd, buf, cap, overflow_p): i64 {
    var have: i64 = 0;
    var read_buf = alloc(_SORT_READ_BUFSZ);
    var loop: i64 = 1;
    while (loop == 1) {
        var room = cap - have;
        if (room <= 0) {
            # Drain remaining bytes (so we know if there was more).
            var n = k_read( fd, read_buf, _SORT_READ_BUFSZ);
            if (n <= 0) { loop = 0; }
            else { store64(overflow_p, 1); }
        } else {
            var n = k_read( fd, read_buf, _SORT_READ_BUFSZ);
            if (n < 0) {
                if ((0 - n) == 4) {
                    # EINTR retry.
                } else { return n; }
            } else {
                if (n == 0) { loop = 0; }
                else {
                    var copy_n = n;
                    if (copy_n > room) {
                        copy_n = room;
                        store64(overflow_p, 1);
                    }
                    memcpy(buf + have, read_buf, copy_n);
                    have = have + copy_n;
                }
            }
        }
    }
    return have;
}

# Build a vec of line records from `buf[0..size)`. Term byte is the
# line terminator (10 or 0). A trailing partial line (no terminator)
# still becomes a record.
fn _so_build_records(buf, size, term): i64 {
    var v = vec_new();
    var line_start: i64 = 0;
    var i: i64 = 0;
    while (i < size) {
        if (load8(buf + i) == term) {
            var rec = alloc(16);
            store64(rec, line_start);
            store64(rec + 8, i - line_start);
            vec_push(v, rec);
            line_start = i + 1;
        }
        i = i + 1;
    }
    if (line_start < size) {
        var rec = alloc(16);
        store64(rec, line_start);
        store64(rec + 8, size - line_start);
        vec_push(v, rec);
    }
    return v;
}

fn _so_fold(b): i64 {
    if (b >= 65) {
        if (b <= 90) { return b + 32; }
    }
    return b;
}

# End field of `-k F1,F2`. 0 means NO end was given, which in POSIX and GNU means
# **the key runs to the end of the line** — not "just field F1".
#
# ⛔ kriya read `-k F` as `-k F,F` for five releases. That is invisible until the
# named field TIES, and then it silently reorders:
#
#   printf 'a:1:z\nb:1:a\n' | sort -t: -k2
#   GNU:   b:1:a  a:1:z     (key "1:z" vs "1:a")
#   kriya: a:1:z  b:1:a     (key "1" vs "1" — tie, whole-line fallback)
#
# Exit 0, plausible output, wrong order — in the COMMON form of the flag.
var _so_key_end = 0;

# The comparison key within a line: with `-k`, from the start of field F1 to the
# end of field F2 (or of the line), found the way GNU's `begfield` and
# `limfield` find them; then, with `-b`, past leading blanks. Returns the start
# offset and writes the length to `*out_len_p`.
fn _so_key_window(buf, line_off, line_len, ignore_blanks, has_key, key_field, has_delim, delim, out_len_p): i64 {
    var start = line_off;
    var endp = line_off + line_len;
    if (has_key == 1) {
        start = _so_field_start(buf, line_off, endp, key_field - 1, has_delim, delim);
        if (_so_key_end > 0) {
            var lim = _so_field_limit(buf, line_off, endp, _so_key_end, has_delim, delim);
            # ⚠ An end field BEFORE the start field is an EMPTY key, as in GNU —
            # every line then ties on it and the whole line decides.
            if (lim < start) { lim = start; }
            endp = lim;
        }
    }
    if (ignore_blanks == 1) {
        var skipping: i64 = 1;
        while (skipping == 1) {
            if (start >= endp) { skipping = 0; }
            elif (_so_is_blank(load8(buf + start)) == 1) { start = start + 1; }
            else { skipping = 0; }
        }
    }
    store64(out_len_p, endp - start);
    return start;
}

fn _so_is_blank(c): i64 {
    if (c == 32) { return 1; }
    if (c == 9) { return 1; }
    return 0;
}

# Where field `n` + 1 (1-based) starts: `n` fields skipped from `p`, stopping at
# `e` — GNU's `begfield`.
#
# ⛔ WITHOUT `-t` A FIELD INCLUDES THE BLANKS IN FRONT OF IT, and this used to
# skip them. GNU and POSIX both split between a non-blank and a blank, so
# ` b` is one field of ` b` and field 2 of `a  b` is `  b`: `sort -k1` of ` b`
# and `a` puts ` b` FIRST, as a space sorts before a letter, and kriya put it
# last — at exit 0, on any indented or column-aligned input (1.6.16). `-b` is
# the flag that drops them, and it still does.
fn _so_field_start(buf, p, e, n, has_delim, delim): i64 {
    var k = n;
    while (k > 0) {
        if (p >= e) { k = 0; }
        else {
            if (has_delim == 1) {
                p = _so_skip_to(buf, p, e, delim);
                if (p < e) { p = p + 1; }
            } else {
                p = _so_skip_field(buf, p, e);
            }
            k = k - 1;
        }
    }
    return p;
}

# Where field `n` (1-based) ends, counted from the start of the line at `p` —
# GNU's `limfield` for a key with no character offset. With `-t` it stops at
# the separator that closes field `n`; without, at the blank after its text.
fn _so_field_limit(buf, p, e, n, has_delim, delim): i64 {
    var k = n;
    while (k > 0) {
        if (p >= e) { k = 0; }
        else {
            if (has_delim == 1) {
                p = _so_skip_to(buf, p, e, delim);
                k = k - 1;
                if (k > 0) {
                    if (p < e) { p = p + 1; }
                }
            } else {
                p = _so_skip_field(buf, p, e);
                k = k - 1;
            }
        }
    }
    return p;
}

# The first `delim` at or after `p`, or `e`.
fn _so_skip_to(buf, p, e, delim): i64 {
    var q = p;
    var going: i64 = 1;
    while (going == 1) {
        if (q >= e) { going = 0; }
        elif (load8(buf + q) == delim) { going = 0; }
        else { q = q + 1; }
    }
    return q;
}

# Past one blank-separated field: its leading blanks, then its non-blanks.
fn _so_skip_field(buf, p, e): i64 {
    var q = p;
    var phase: i64 = 0;
    var going: i64 = 1;
    while (going == 1) {
        if (q >= e) { going = 0; }
        else {
            var blank = _so_is_blank(load8(buf + q));
            if (phase == 0) {
                if (blank == 1) { q = q + 1; } else { phase = 1; }
            } else {
                if (blank == 1) { going = 0; } else { q = q + 1; }
            }
        }
    }
    return q;
}

# The number at the front of a key, for `-n`, as GNU reads it in the C locale:
# blanks skipped, an optional `-`, digits, an optional `.` and more digits —
# and nothing else, so `+5`, `1e3`'s `e` and `1,000`'s `,` end it. Stored in
# `rec` as (sign, integer digits' offset, their count, fraction digits' offset,
# their count), leading zeros and trailing fraction zeros dropped, so equal
# numbers have equal records and zero has sign 0 whether written `-0` or `.00`.
fn _so_num_read(buf, off, len, rec): i64 {
    var p = off;
    var e = off + len;
    var blank: i64 = 1;
    while (blank == 1) {
        if (p >= e) { blank = 0; }
        elif (load8(buf + p) == 32) { p = p + 1; }
        elif (load8(buf + p) == 9) { p = p + 1; }
        else { blank = 0; }
    }
    var neg: i64 = 0;
    if (p < e) {
        if (load8(buf + p) == 45) { neg = 1; p = p + 1; }
    }
    var zeros: i64 = 1;
    while (zeros == 1) {
        if (p >= e) { zeros = 0; }
        elif (load8(buf + p) == 48) { p = p + 1; }
        else { zeros = 0; }
    }
    var ioff = p;
    var digits: i64 = 1;
    while (digits == 1) {
        if (p >= e) { digits = 0; }
        else {
            var c = load8(buf + p);
            if (c < 48) { digits = 0; }
            elif (c > 57) { digits = 0; }
            else { p = p + 1; }
        }
    }
    var ilen = p - ioff;
    var foff = p;
    var flen: i64 = 0;
    if (p < e) {
        if (load8(buf + p) == 46) {
            p = p + 1;
            foff = p;
            var fd: i64 = 1;
            while (fd == 1) {
                if (p >= e) { fd = 0; }
                else {
                    var c2 = load8(buf + p);
                    if (c2 < 48) { fd = 0; }
                    elif (c2 > 57) { fd = 0; }
                    else { p = p + 1; }
                }
            }
            flen = p - foff;
            var trim: i64 = 1;
            while (trim == 1) {
                if (flen == 0) { trim = 0; }
                elif (load8(buf + foff + flen - 1) == 48) { flen = flen - 1; }
                else { trim = 0; }
            }
        }
    }
    var sign: i64 = 1;
    if (neg == 1) { sign = 0 - 1; }
    if (ilen + flen == 0) { sign = 0; }
    store64(rec, sign);
    store64(rec + 8, ioff);
    store64(rec + 16, ilen);
    store64(rec + 24, foff);
    store64(rec + 32, flen);
    return 0;
}

# `-n`'s comparison: -1 / 0 / +1.
#
# ⛔ IT PARSED EACH KEY INTO AN i64, AND AN i64 IS NOT A NUMBER LINE. Past 2^63 a
# key WRAPPED — `9223372036854775808` sorted as a negative, first, and
# `18446744073709551617` as 1, below `2` — and the parse stopped at the `.`, so
# `-1.25` and `-1.5` tied as -1 and the whole-line fallback put `-1.25` FIRST.
# GNU compares the digit strings, never converting, so any length is exact; so
# does this, since 1.6.16: sign, then the integer part's length, then its
# digits, then the fraction's digits. For two negatives the order flips.
fn _so_cmp_numeric(buf, a_off, a_len, b_off, b_len): i64 {
    var ra[40];
    var rb[40];
    _so_num_read(buf, a_off, a_len, &ra);
    _so_num_read(buf, b_off, b_len, &rb);
    var sa = load64(&ra);
    var sb = load64(&rb);
    if (sa < sb) { return 0 - 1; }
    if (sa > sb) { return 1; }
    if (sa == 0) { return 0; }
    var mag: i64 = 0;
    var ila = load64(&ra + 16);
    var ilb = load64(&rb + 16);
    if (ila < ilb) { mag = 0 - 1; }
    if (ila > ilb) { mag = 1; }
    if (mag == 0) {
        var ia = load64(&ra + 8);
        var ib = load64(&rb + 8);
        var k: i64 = 0;
        while (k < ila) {
            if (mag == 0) {
                var ca = load8(buf + ia + k);
                var cb = load8(buf + ib + k);
                if (ca < cb) { mag = 0 - 1; }
                if (ca > cb) { mag = 1; }
            }
            k = k + 1;
        }
    }
    if (mag == 0) {
        var fa = load64(&ra + 24);
        var fb = load64(&rb + 24);
        var fla = load64(&ra + 32);
        var flb = load64(&rb + 32);
        var j: i64 = 0;
        var fin: i64 = 0;
        while (fin == 0) {
            if (j >= fla) {
                if (j < flb) { mag = 0 - 1; }
                fin = 1;
            } elif (j >= flb) {
                mag = 1;
                fin = 1;
            } else {
                var da = load8(buf + fa + j);
                var db = load8(buf + fb + j);
                if (da < db) { mag = 0 - 1; fin = 1; }
                elif (da > db) { mag = 1; fin = 1; }
                else { j = j + 1; }
            }
        }
    }
    if (sa < 0) { return 0 - mag; }
    return mag;
}

# Byte / case-fold compare.
fn _so_cmp_bytes(buf, a_off, a_len, b_off, b_len, fold): i64 {
    var i: i64 = 0;
    var minlen = a_len;
    if (b_len < minlen) { minlen = b_len; }
    while (i < minlen) {
        var ca = load8(buf + a_off + i);
        var cb = load8(buf + b_off + i);
        if (fold == 1) {
            ca = _so_fold(ca);
            cb = _so_fold(cb);
        }
        if (ca != cb) { return ca - cb; }
        i = i + 1;
    }
    if (a_len < b_len) { return 0 - 1; }
    if (a_len > b_len) { return 1; }
    return 0;
}

# `-u` and `-s`, set once by `cmd_sort`: both end a comparison at the key.
var _so_unique = 0;
var _so_stable = 0;

# Order two lines: -1 / 0 / +1.
#
# ⛔ THE LAST-RESORT COMPARISON WAS APPLIED IN TWO OF FOUR CASES, and `-u`/`-s`
# never saw it (1.6.16). GNU's rule is one sentence: when a KEY is compared — a
# `-k`, or `-n`, `-f` or `-b`, which compare the whole line as a key — and the
# keys tie, the whole lines are compared as bytes, unless `-u` (equal keys ARE
# the duplicates) or `-s` (equal keys keep input order); `-r` reverses both.
# kriya skipped it for `-n -k`, `-f` and `-b`, so tied lines kept INPUT order
# (`sort -f` of `a`, `A` answered `a A`; GNU `A a`), applied it under `-u`, so
# `sort -nu` of `1`, `01`, `1.0` printed three lines where GNU prints one, and
# took `-s` as a no-op.
fn _so_compare(buf, a_rec, b_rec, numeric, reverse, fold, ignore_blanks, has_key, key_field, has_delim, delim): i64 {
    var keyed: i64 = 0;
    if (has_key == 1) { keyed = 1; }
    if (numeric == 1) { keyed = 1; }
    if (fold == 1) { keyed = 1; }
    if (ignore_blanks == 1) { keyed = 1; }
    var r: i64 = 0;
    if (keyed == 1) {
        var a_len_box[8];
        var a_off = _so_key_window(buf, _so_rec_off(a_rec), _so_rec_len(a_rec), ignore_blanks, has_key,
          key_field, has_delim, delim, &a_len_box);
        var a_len = load64(&a_len_box);
        var b_len_box[8];
        var b_off = _so_key_window(buf, _so_rec_off(b_rec), _so_rec_len(b_rec), ignore_blanks, has_key,
          key_field, has_delim, delim, &b_len_box);
        var b_len = load64(&b_len_box);
        if (numeric == 1) {
            r = _so_cmp_numeric(buf, a_off, a_len, b_off, b_len);
        } else {
            r = _so_cmp_bytes(buf, a_off, a_len, b_off, b_len, fold);
        }
        if (reverse == 1) { r = 0 - r; }
        if (r != 0) { return r; }
        if (_so_unique == 1) { return 0; }
        if (_so_stable == 1) { return 0; }
    }
    # The last resort: the whole lines, as bytes, never folded.
    r = _so_cmp_bytes(buf, _so_rec_off(a_rec), _so_rec_len(a_rec), _so_rec_off(b_rec), _so_rec_len(b_rec), 0);
    if (reverse == 1) { r = 0 - r; }
    return r;
}

# Stable bottom-up iterative merge sort on a vec of records. Uses one
# auxiliary heap array of same length. The comparator state is passed
# as a single context pointer (24 bytes: buf + flag word + key field + delim word).
fn _so_merge_sort(records, buf, numeric, reverse, fold, ignore_blanks, has_key, key_field, has_delim, delim): i64 {
    var n = vec_len(records);
    if (n < 2) { return 0; }
    # Allocate aux + a flat record-pointer array view of `records` for
    # easier in-place merging.
    var src = alloc(n * 8);
    var dst = alloc(n * 8);
    var i: i64 = 0;
    while (i < n) {
        store64(src + i * 8, vec_get(records, i));
        i = i + 1;
    }

    var width: i64 = 1;
    while (width < n) {
        var start: i64 = 0;
        while (start < n) {
            var mid = start + width;
            if (mid > n) { mid = n; }
            var end = start + 2 * width;
            if (end > n) { end = n; }
            # Merge [start..mid) and [mid..end) into dst[start..end).
            var l = start;
            var r = mid;
            var k = start;
            while (k < end) {
                var take_left: i64 = 0;
                if (l >= mid) {
                    take_left = 0;
                } else {
                    if (r >= end) {
                        take_left = 1;
                    } else {
                        var a = load64(src + l * 8);
                        var b = load64(src + r * 8);
                        var cmp = _so_compare(buf, a, b, numeric, reverse, fold, ignore_blanks, has_key, key_field,
                          has_delim, delim);
                        if (cmp <= 0) { take_left = 1; }
                    }
                }
                if (take_left == 1) {
                    store64(dst + k * 8, load64(src + l * 8));
                    l = l + 1;
                } else {
                    store64(dst + k * 8, load64(src + r * 8));
                    r = r + 1;
                }
                k = k + 1;
            }
            start = end;
        }
        # Swap src and dst.
        var tmp = src;
        src = dst;
        dst = tmp;
        width = width * 2;
    }

    # Final result is in `src`; write back into the vec.
    i = 0;
    while (i < n) {
        vec_set(records, i, load64(src + i * 8));
        i = i + 1;
    }
    return 0;
}

fn _so_write_all(fd, buf, n): i64 {
    var w: i64 = 0;
    while (w < n) {
        var wr = k_write( fd, buf + w, n - w);
        if (wr < 0) {
            if ((0 - wr) == 4) {
                # EINTR retry.
            } else { return wr; }
        } else { w = w + wr; }
    }
    return 0;
}

# One field number of a `-k` spec at `s + *pos`: blanks, a `+`, digits — GNU's
# shape — SATURATED past 2^63 - 1 as GNU saturates it. Advances `*pos`; -1 when
# there are no digits.
fn _so_key_field(s, pos_p): i64 {
    var i = load64(pos_p);
    var ws: i64 = 1;
    while (ws == 1) {
        var c = load8(s + i);
        if (c == 32) { i = i + 1; }
        elif (c == 9) { i = i + 1; }
        else { ws = 0; }
    }
    if (load8(s + i) == 43) { i = i + 1; }
    var len: i64 = 0;
    var n = kriya_count_digits(s + i, &len);
    store64(pos_p, i + len);
    if (len == 0) { return 0 - 1; }
    return n;
}

# A `-k F1[,F2]` spec: returns F1 and stores F2 (0 for "to the end of the line")
# in `*end_p`, or reports the spec and returns -1.
#
# ⚠ WHAT GNU ACCEPTS AND KRIYA CANNOT HONOUR, IT REFUSES, and says which (roadmap
# 1.8.1): a key's own ordering letters (`2n`, `2,2r`) and a character offset
# (`2.3`) are GNU syntax kriya has no semantics for. The one-key case of the
# first has an exact spelling today — `-n -k2,2` is `-k2,2n`, because a key with
# no letters of its own takes the global ones and the last-resort comparison
# ignores them in both.
fn _so_parse_key(spec, end_p): i64 {
    store64(end_p, 0);
    var pos: i64 = 0;
    var f1 = _so_key_field(spec, &pos);
    if (f1 < 0) {
        report_note("sort", spec, "invalid number at field start");
        return 0 - 1;
    }
    if (f1 == 0) {
        report_note("sort", spec, "field number is zero");
        return 0 - 1;
    }
    var f2: i64 = 0;
    var c = load8(spec + pos);
    if (c == 44) {
        pos = pos + 1;
        f2 = _so_key_field(spec, &pos);
        if (f2 < 0) {
            report_note("sort", spec, "invalid number after ','");
            return 0 - 1;
        }
        if (f2 == 0) {
            report_note("sort", spec, "field number is zero");
            return 0 - 1;
        }
        c = load8(spec + pos);
    }
    if (c != 0) {
        if (c == 46) {
            report_note("sort", spec, "a character offset in a key is not supported yet (roadmap 1.8.1)");  #skip-lint
            return 0 - 1;
        }
        if (_so_is_key_letter(c) == 1) {
            report_note("sort", spec, "a key's own ordering options are not supported yet; -n -k2,2 is -k2,2n (roadmap 1.8.1)");  #skip-lint
            return 0 - 1;
        }
        report_note("sort", spec, "stray character in field spec");
        return 0 - 1;
    }
    # ⚠ `-k 2,1` is valid: an end before the start is an EMPTY key, as in GNU
    # (`_so_key_window`). This refused it until 1.6.16.
    store64(end_p, f2);
    return f1;
}

# 1 for the letters GNU takes after a key field: b d f g h i M n R r V.
fn _so_is_key_letter(c): i64 {
    if (c == 98) { return 1; }
    if (c == 100) { return 1; }
    if (c == 102) { return 1; }
    if (c == 103) { return 1; }
    if (c == 104) { return 1; }
    if (c == 105) { return 1; }
    if (c == 77) { return 1; }
    if (c == 110) { return 1; }
    if (c == 82) { return 1; }
    if (c == 114) { return 1; }
    if (c == 86) { return 1; }
    return 0;
}

fn cmd_sort(start: i64): i64 {
    _so_init_spec();
    # GNU's `--check[=quiet|silent|diagnose-first]`. The value used to be
    # swallowed, so `--check=quiet` still printed the disorder line it exists to
    # suppress.
    if (kriya_args_parse_optval(_so_spec, start, 0, "check") != 0) {
        k_write( 2, "kriya sort: error: bad option (see ADR 0002 for accepted syntax)\n", 65);
        return EXIT_USAGE;
    }

    var numeric: i64 = 0;
    if (flags_get_bool(_so_spec, _so_n_idx) == 1) { numeric = 1; }
    var reverse: i64 = 0;
    if (flags_get_bool(_so_spec, _so_r_idx) == 1) { reverse = 1; }
    var unique: i64 = 0;
    if (flags_get_bool(_so_spec, _so_u_idx) == 1) { unique = 1; }
    _so_unique = unique;
    _so_stable = flags_get_bool(_so_spec, _so_s_idx);
    var fold: i64 = 0;
    if (flags_get_bool(_so_spec, _so_f_idx) == 1) { fold = 1; }
    var ignore_blanks: i64 = 0;
    if (flags_get_bool(_so_spec, _so_b_idx) == 1) { ignore_blanks = 1; }
    var check_mode: i64 = 0;
    if (flags_get_bool(_so_spec, _so_c_idx) == 1) { check_mode = 1; }
    # `quiet`/`silent` suppress the diagnostic but keep the exit status;
    # `diagnose-first` is the default. Anything else is refused by name.
    var check_quiet: i64 = 0;
    if (check_mode == 1) {
        var cv = kriya_long_value();
        if (cv != 0) {
            if (streq(cv, "quiet") == 1)             { check_quiet = 1; }
            elif (streq(cv, "silent") == 1)          { check_quiet = 1; }
            elif (streq(cv, "diagnose-first") == 1)  { check_quiet = 0; }
            else {
                k_write( 2, "kriya sort: --check: '", 22);
                k_write( 2, cv, strlen(cv));
                k_write( 2, "' is not a check mode (use quiet, silent or diagnose-first)\n", 60);
                return EXIT_USAGE;
            }
        }
    }
    var zero_term: i64 = 0;
    if (flags_get_bool(_so_spec, _so_z_idx) == 1) { zero_term = 1; }

    var term_byte: i64 = 10;
    if (zero_term == 1) { term_byte = 0; }

    var has_delim: i64 = 0;
    var delim: i64 = 0;
    var t_arg = flags_get_str(_so_spec, _so_t_idx);
    if (t_arg != 0) {
        if (load8(t_arg) != 0) {
            if (load8(t_arg + 1) != 0) {
                k_write( 2, "kriya sort: error: --field-separator must be a single byte\n", 59);
                return EXIT_USAGE;
            }
            has_delim = 1;
            delim = load8(t_arg);
        }
    }
    var has_key: i64 = 0;
    var key_field: i64 = 1;
    var k_arg = flags_get_str(_so_spec, _so_k_idx);
    if (k_arg != 0) {
        # ⛔ THIS USED TO ACCEPT `F1,F2` AND SILENTLY SORT BY F1 ALONE, and to read
        # a bare `-k F` as `-k F,F` when POSIX and GNU both mean "field F to END
        # OF LINE". A real range diverges whenever the start field TIES:
        #
        #   printf 'a:1:z\nb:1:a\n' | sort -t: -k2,3
        #   GNU:   b:1:a  a:1:z        (key is "1:z" vs "1:a")
        #   kriya: a:1:z  b:1:a        (key truncated to "1")
        #
        # ⛔ AND UNTIL 1.6.16 IT DROPPED WHATEVER FOLLOWED THE DIGITS. `sort -k2n`
        # sorted field 2 as TEXT at exit 0, where GNU sorts it as a number, and
        # `-k2r`, `-k2,2.1` and `-k 2,-1` lost their `r`, `.1` and `-1` the same
        # way. `_so_parse_key` reads the whole spec, and what kriya cannot honour
        # yet — a key's own ordering letters, character offsets — it REFUSES, the
        # rule the range above already followed (roadmap 1.8.1).
        var kend: i64 = 0;
        var v = _so_parse_key(k_arg, &kend);
        if (v < 0) { return EXIT_USAGE; }
        _so_key_end = kend;
        has_key = 1;
        key_field = v;
    }

    var npos = flags_positional_count(_so_spec);

    # Slurp all inputs into one buffer.
    var buf = alloc(_SORT_INPUT_CAP);
    var have: i64 = 0;
    var overflow_box[8];
    store64(&overflow_box, 0);

    if (npos < 1) {
        var n = _so_slurp(0, buf, _SORT_INPUT_CAP, &overflow_box);
        if (n < 0) {
            _so_report("(stdin)", 0 - n);
            return EXIT_FAILURE;
        }
        have = n;
    } else {
        var i: i64 = 0;
        while (i < npos) {
            var p = flags_positional(_so_spec, i);
            var fd: i64 = 0;
            var is_stdin: i64 = 0;
            if (load8(p) == 45) {
                if (load8(p + 1) == 0) { is_stdin = 1; }
            }
            if (is_stdin == 0) {
                fd = k_open(p, 0, 0);
                if (fd < 0) {
                    _so_report(p, 0 - fd);
                    return EXIT_FAILURE;
                }
            }
            var room = _SORT_INPUT_CAP - have;
            var n = _so_slurp(fd, buf + have, room, &overflow_box);
            if (is_stdin == 0) { k_close( fd); }
            if (n < 0) {
                _so_report(p, 0 - n);
                return EXIT_FAILURE;
            }
            have = have + n;
            i = i + 1;
        }
    }

    if (load64(&overflow_box) == 1) {
        k_write( 2, "kriya sort: warning: input exceeds 256 MiB; external-sort fallback deferred — truncating\n", 91);  # roadmap 1.8.2  #skip-lint
    }

    var records = _so_build_records(buf, have, term_byte);
    var nrec = vec_len(records);

    # -c check mode: walk pairs.
    if (check_mode == 1) {
        var i: i64 = 1;
        while (i < nrec) {
            var a = vec_get(records, i - 1);
            var b = vec_get(records, i);
            var cmp = _so_compare(buf, a, b, numeric, reverse, fold, ignore_blanks, has_key, key_field, has_delim,
              delim);
            # ⚠ `-c -u` checks STRICT order, as GNU does: an equal pair is a disorder.
            var disorder: i64 = 0;
            if (cmp > 0) { disorder = 1; }
            if (unique == 1) {
                if (cmp == 0) { disorder = 1; }
            }
            if (disorder == 1) {
                if (check_quiet == 1) { return EXIT_FAILURE; }
                k_write( 2, "kriya sort: disorder at line ", 29);
                # Render i+1.
                var nb[32];
                var nlen: i64 = 0;
                if (i + 1 == 0) { store8(&nb, 48); nlen = 1; }
                else {
                    var tmp[32];
                    var t: i64 = 0;
                    var rem = i + 1;
                    while (rem > 0) {
                        store8(&tmp + t, 48 + (rem - (rem / 10) * 10));
                        rem = rem / 10;
                        t = t + 1;
                    }
                    var k: i64 = 0;
                    while (k < t) {
                        store8(&nb + k, load8(&tmp + t - 1 - k));
                        k = k + 1;
                    }
                    nlen = t;
                }
                k_write( 2, &nb, nlen);
                k_write( 2, "\n", 1);
                return EXIT_FAILURE;
            }
            i = i + 1;
        }
        return EXIT_SUCCESS;
    }

    _so_merge_sort(records, buf, numeric, reverse, fold, ignore_blanks, has_key, key_field, has_delim, delim);

    # Determine output fd.
    var out_fd: i64 = 1;
    var out_opened: i64 = 0;
    var o_arg = flags_get_str(_so_spec, _so_o_idx);
    if (o_arg != 0) {
        if (load8(o_arg) != 0) {
            out_fd = k_open(o_arg, 0o1101, 0o666);  # O_WRONLY | O_CREAT | O_TRUNC
            if (out_fd < 0) {
                _so_report(o_arg, 0 - out_fd);
                return EXIT_FAILURE;
            }
            out_opened = 1;
        }
    }

    var tb[2];
    store8(&tb, term_byte);

    var prev_rec: i64 = 0;
    var i: i64 = 0;
    while (i < nrec) {
        var rec = vec_get(records, i);
        var emit: i64 = 1;
        if (unique == 1) {
            if (prev_rec != 0) {
                var cmp = _so_compare(buf, prev_rec, rec, numeric, 0, fold, ignore_blanks, has_key, key_field,
                  has_delim, delim);
                # Note: reverse=0 here so we test equality, not order.
                if (cmp == 0) { emit = 0; }
            }
        }
        if (emit == 1) {
            var rlen = _so_rec_len(rec);
            if (rlen > 0) {
                var wr = _so_write_all(out_fd, buf + _so_rec_off(rec), rlen);
                if (wr != 0) {
                    _so_report("(write)", 0 - wr);
                    if (out_opened == 1) { k_close( out_fd); }
                    return EXIT_FAILURE;
                }
            }
            _so_write_all(out_fd, &tb, 1);
            prev_rec = rec;
        }
        i = i + 1;
    }

    if (out_opened == 1) { k_close( out_fd); }
    return EXIT_SUCCESS;
}
