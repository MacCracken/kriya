# tail — POSIX `tail(1)`: emit the last N lines/bytes of each input.
#
# Argument shape:
#   tail [opts] [file...]
#
# Flags:
#   -n / --lines=[+]N  emit the last N lines (default 10) — or, written `+N`,
#                      everything from line N on.
#   -c / --bytes=[+]N  emit the last N bytes — or everything from byte N on.
#   -q / --quiet       never emit the `==> FILE <==` header.
#   -v / --verbose     always emit the header.
#   -f / --follow[=descriptor|name]   print what is appended, to any number of files.
#   -F                 --follow=name --retry.
#   --retry            keep trying a file that cannot be opened.
#   --pid=PID          with -f, exit once PID (each PID, repeatable) has exited.
#   -s / --sleep-interval=N           seconds between checks, default 0.2.
#   --max-unchanged-stats=N           under --follow=name, reopen after N quiet checks.
#   [+-]NUM[bcl][f]    the obsolescent form, FIRST ARGUMENT ONLY
#                      (`_tail_obs_parse` has the grammar).
#
# N takes GNU's units since 1.9.2: `-c 1K`, `-n +2M`, `-c 1KB` (`kriya_xstrtou`).
#
# Default: 10 lines. When neither `-q` nor `-v` is set, the header is
# emitted iff there is more than one file operand.
#
# Implementation: for the last N, buffer the input (up to a 16 MiB cap)
# into memory, then scan backwards from EOF to find the Nth-from-last
# newline (for `-n`) or the byte at offset `size - N` (for `-c`). This is
# the straightforward path that works for both seekable files and pipes.
# A seek-back-from-end fast path for huge files is a clearly-named
# follow-up — see deferrals below. (roadmap 1.10.1) The `+N` forms need no
# buffer at all: they skip, then stream (`_tail_from`).
#
# Cap: if input exceeds 16 MiB, the buffer is truncated to the LAST
# 16 MiB (head bytes discarded). For `-n N` this means the result is
# correct as long as N lines fit in the last 16 MiB; otherwise the
# user sees up to 16 MiB worth of trailing content. A warning to
# stderr is emitted when truncation happens.
#
# Follow mode is GNU's polling loop, ported in 1.9.2 (see "follow mode" below).
#
# Deferred (a named follow-up): (roadmap 1.10.1)
#   Seek-from-end fast path  for large seekable files (avoids the 16MB cap),
#                            and a ring buffer for pipes (roadmap 1.10.1).

var _tail_spec  = 0;
var _tail_n_idx = 0;
var _tail_c_idx = 0;
var _tail_q_idx = 0;
var _tail_v_idx = 0;
var _tail_f_idx = 0;
var _tail_ff_idx = 0;
var _tail_retry_idx = 0;
var _tail_pid_idx = 0;
var _tail_s_idx = 0;
var _tail_mus_idx = 0;

var _TAIL_CAP_BYTES: i64 = 16777216;  # 16 MiB
var _TAIL_READ_BUFSZ: i64 = 65536;
var _TAIL_FOLLOW_POLL_MS: i64 = 200;   # poll interval for -f (200ms)

var _tail_rbuf = 0;                    # `_tail_from`'s read window, reused

# The obsolescent first argument, parsed: offsets into a 32-byte record.
enum TailObs {
    TAIL_OBS_COUNT  = 0;   # the count, saturated
    TAIL_OBS_BYTES  = 8;   # 1 when it counts bytes, 0 for lines
    TAIL_OBS_START  = 16;  # 1 for the `+` form: counted from the start
    TAIL_OBS_FOLLOW = 24;  # 1 when it ends in `f`
}

fn _tail_init_spec(): i64 {
    if (_tail_spec != 0) { return 0; }
    var s = flags_new();
    _tail_n_idx = flags_add_str(s,  110, "lines",   0, "emit last N lines (default 10); +N: from line N on");
    _tail_c_idx = flags_add_str(s,  99,  "bytes",   0, "emit last N bytes; +N: from byte N on");
    _tail_q_idx = flags_add_bool(s, 113, "quiet",   0, "suppress filename headers");
    _tail_v_idx = flags_add_bool(s, 118, "verbose", 0, "always emit filename headers");
    _tail_f_idx = flags_add_bool(s, 102, "follow",  0, "output appended data as the file grows (=name, =descriptor)");
    _tail_ff_idx = flags_add_bool(s, 70, 0,         0, "--follow=name --retry");
    _tail_retry_idx = flags_add_bool(s, 0, "retry",  0, "keep trying to open a file that is inaccessible");
    _tail_pid_idx = flags_add_str(s, 0, "pid",       0, "with -f, exit after process PID dies (repeatable)");
    _tail_s_idx = flags_add_str(s, 115, "sleep-interval", 0, "with -f, N seconds between checks (0.2)");
    _tail_mus_idx = flags_add_str(s, 0, "max-unchanged-stats", 0, "under --follow=name, reopen after N checks");
    _tail_spec = s;
    tail_help_declare();
    return 0;
}

# Help/introspection record for `tail`. ⭐ Split out so `kriya --list` can
# populate it WITHOUT running the utility — one declaration feeding `--help`,
# `--help=json` and `--list` alike.
fn tail_help_declare(): i64 {
    help_begin("tail", "Print the last part of files.",
      "tail [OPTIONS] [FILE...]");
    help_positional(0, HELP_POS_UNBOUNDED, "FILE");
    help_operands("Defaults to 10 lines. A count written +N starts at line (or byte) N instead. The obsolescent `tail -5` form (also `+5`, `-5c`, `-5f`) is accepted, first argument only. -f follows any number of files by descriptor, -F by name with retry, polling every 0.2 s (-s).");  #skip-lint
    help_exit(1, "a file could not be read");
    help_example("tail -n 50 app.log");
    help_example("tail -f app.log");
    help_example("tail -F --pid=1234 app.log other.log");
    help_example("tail -c 200 blob.bin");
    help_example("tail -n +2 data.csv");
    return 0;
}

# ⭐ ONE LINE NOW. The 24-line body this replaces was byte-identical in every
# utility apart from the name; `errmsg_report` in `src/lib/report.cyr` is the
# single implementation of architecture 001's framing, and it shell-quotes the
# operand so a name containing a newline cannot split the diagnostic in two.
fn _tail_report(operand, errno): i64 { return errmsg_report("tail", operand, errno); }

fn _tail_emit_header(name, first): i64 {
    if (first == 0) { k_write( 1, "\n", 1); }
    k_write( 1, "==> ", 4);
    k_write( 1, name, strlen(name));
    k_write( 1, " <==\n", 5);
    return 0;
}

fn _tail_write_all(buf, n): i64 {
    var written: i64 = 0;
    while (written < n) {
        var w = k_write( 1, buf + written, n - written);
        if (w < 0) {
            if ((0 - w) == 4) {
                # EINTR — retry.
            } else { return w; }
        } else {
            written = written + w;
        }
    }
    return 0;
}

# Read all of `fd` into a heap buffer, capped at `_TAIL_CAP_BYTES`.
# When the cap is hit, the buffer holds the LAST cap-bytes (head is
# discarded). Returns (buf, size) via two store64 slots in `out_buf_size_pair`.
# `out_buf_size_pair` is a 24-byte record: ptr/size/truncated_flag.
fn _tail_slurp(fd, name, out): i64 {
    var cap = _TAIL_CAP_BYTES;
    var buf = alloc(cap);
    var have: i64 = 0;
    var truncated: i64 = 0;
    var read_buf = alloc(_TAIL_READ_BUFSZ);
    var loop: i64 = 1;
    while (loop == 1) {
        var n = k_read( fd, read_buf, _TAIL_READ_BUFSZ);
        if (n < 0) {
            if ((0 - n) == 4) {
                # EINTR — retry.
            } else { return n; }
        } else {
            if (n == 0) { loop = 0; }
            else {
                if (have + n <= cap) {
                    memcpy(buf + have, read_buf, n);
                    have = have + n;
                } else {
                    # Need to discard from the head to make room.
                    truncated = 1;
                    if (n >= cap) {
                        # New chunk alone exceeds cap: keep the last cap bytes of it.
                        memcpy(buf, read_buf + (n - cap), cap);
                        have = cap;
                    } else {
                        # Shift existing content left by `shift` bytes to make room.
                        var shift = (have + n) - cap;
                        var keep = have - shift;
                        # Move bytes [shift..have) → [0..keep)
                        var i: i64 = 0;
                        while (i < keep) {
                            store8(buf + i, load8(buf + shift + i));
                            i = i + 1;
                        }
                        memcpy(buf + keep, read_buf, n);
                        have = cap;
                    }
                }
            }
        }
    }
    if (truncated == 1) {
        k_write( 2, "kriya tail: ", 12);
        k_write( 2, name, strlen(name));
        k_write( 2, ": input exceeds 16 MiB buffer; showing last 16 MiB only\n", 56);
    }
    store64(out + 0, buf);
    store64(out + 8, have);
    store64(out + 16, truncated);
    return 0;
}

# Find the start byte-offset within `buf[0..size)` for the last `n` lines.
# A "line" ends at a newline; the final byte before EOF (if it's not a
# newline) still counts as part of the trailing partial line.
#
# Walk backwards from `size - 1`, counting newlines encountered. The
# starting position itself is NOT examined (the loop pre-decrements),
# so a trailing newline at `size - 1` is naturally skipped — the first
# newline the loop sees is the one separating the second-to-last line
# from the last. When we've encountered `n` newlines, the byte after
# the `n`-th one is the start of the last `n` lines. If the walk
# reaches offset 0 without finding `n` newlines, the entire buffer is
# fewer than `n` lines — return 0 (emit the whole input).
fn _tail_line_start(buf, size, n): i64 {
    if (n == 0)    { return size; }
    if (size == 0) { return 0; }
    var pos = size - 1;
    var found: i64 = 0;
    var done: i64 = 0;
    while (done == 0) {
        if (pos == 0) { done = 1; }
        else {
            pos = pos - 1;
            if (load8(buf + pos) == 10) {
                found = found + 1;
                if (found >= n) {
                    return pos + 1;
                }
            }
        }
    }
    return 0;
}

# `tail`'s obsolescent first argument (1.6.15): `+` or `-`, optional digits,
# then optionally `b` (512-byte blocks), `c` (bytes) or `l` (lines), then
# optionally `f` (follow) — GNU's grammar, measured on coreutils 9.11. Without
# digits the count is the default ten (so `-b` is ten blocks, and `+` alone is
# from line 10). Returns 1 and fills `rec` when `tok` is that form, 0 when not.
#
# ⚠ Three spellings that fit are NOT taken: `-` (standard input) and `-c` (the
# option, whose value is the next argument), exactly as in GNU, and a bare `-f`,
# which means the same either way and is left to the option parser.
# ⚠ A `+` form is also a legal FILE NAME; `_tail_plus_is_count` decides.
fn _tail_obs_parse(tok, rec): i64 {
    var c0 = load8(tok);
    var from: i64 = 0;
    if (c0 == 43) {
        from = 1;
    } elif (c0 == 45) {
        var c1 = load8(tok + 1);
        if (c1 == 0) { return 0; }                                  # `-`
        if (load8(tok + 2) == 0) {
            if (c1 == 99) { return 0; }                             # `-c`
            if (c1 == 102) { return 0; }                            # `-f`
        }
    } else {
        return 0;
    }
    var len: i64 = 0;
    var n = kriya_count_digits(tok + 1, &len);
    if (len == 0) { n = 10; }
    var p = 1 + len;
    var bytes: i64 = 0;
    var c = load8(tok + p);
    if (c == 98) {                                                  # b
        bytes = 1;
        n = kriya_count_mul(n, 512);
        p = p + 1;
    } elif (c == 99) {                                              # c
        bytes = 1;
        p = p + 1;
    } elif (c == 108) {                                             # l
        p = p + 1;
    }
    var follow: i64 = 0;
    if (load8(tok + p) == 102) {                                    # f
        follow = 1;
        p = p + 1;
    }
    if (load8(tok + p) != 0) { return 0; }
    store64(rec + TAIL_OBS_COUNT, n);
    store64(rec + TAIL_OBS_BYTES, bytes);
    store64(rec + TAIL_OBS_START, from);
    store64(rec + TAIL_OBS_FOLLOW, follow);
    return 1;
}

# Is a first argument of the `+` form a count here, or a file name? GNU's rule,
# measured: a count when nothing follows it, or one operand that is not an
# option, or `--` and at most one operand after that. Otherwise it is a file —
# `tail +3 a b` reads a file named `+3`, then `a` and `b`.
#
# ⚠ THE `-` FORMS DO NOT ASK. GNU applies this rule to them as well and refuses
# `tail -5 a b` outright ("option used in invalid context"); kriya has taken the
# first-argument `-5` whatever follows since the obsolescent form first shipped
# (`smoke-head-tail.sh` carries that deviation). A token that begins with `-`
# can never be a file name, so accepting it is never a misreading — the rule
# exists to tell a count from a NAME, and only `+` forms can be one.
fn _tail_plus_is_count(start): i64 {
    var rest = kriya_argv_count() - start - 1;
    if (rest == 0) { return 1; }
    var a1 = load64(kriya_argv_flat() + (start + 1) * 8);
    var dd = streq(a1, "--");
    if (rest == 1) {
        if (dd == 1) { return 1; }
        if (load8(a1) != 45) { return 1; }
        if (load8(a1 + 1) == 0) { return 1; }                        # `-`, stdin
        return 0;
    }
    if (rest == 2) { return dd; }
    return 0;
}

# Everything from line or byte `n` on (`tail -n +N`, `-c +N`), counting from 1;
# `+0` means `+1`, as in GNU. Returns 0 or a negative errno.
#
# ⭐ STREAMED: it skips, then copies, holding nothing but the read window — so
# unlike the last-N path there is no 16 MiB cap here, and `tail -n +2` of an
# endless pipe starts printing at once. A regular file skips its bytes with a
# seek rather than a read.
#
# ⚠ WITH `-f`, THE SKIP COVERS WHAT THE FILE HELD AT THE START, in both modes:
# once EOF is reached, everything appended is printed. That is GNU's behaviour
# for lines (measured: `tail -n +5 -f` of three lines prints lines 4 on as they
# arrive). For bytes past the end GNU seeks beyond EOF, then reports its own
# seek as "file truncated" and prints the whole file; kriya does not copy that.
fn _tail_from(fd, n, bytes): i64 {
    var skip = n - 1;
    if (n == 0) { skip = 0; }
    if (bytes == 1) {
        if (skip > 0) {
            if (K_HAVE_LSEEK == 1) {
                var st[144];
                if (fs_fstatat(fd, "", &st, 4096) == 0) {           # AT_EMPTY_PATH: fstat
                    if ((load64(&st + FS_STAT_MODE) & FS_S_IFMT) == FS_S_IFREG) {
                        var pos = k_lseek(fd, 0, 1);                # SEEK_CUR
                        if (pos >= 0) {
                            # ⛔ NEVER PAST THE END. A seek to `+99999999999999999999`
                            # (saturated) succeeds, and the read after it fails with
                            # EINVAL — an offset that close to 2^63 cannot be read
                            # from — so the command exited 1 where GNU prints
                            # nothing. Past the end there is nothing to print anyway.
                            var left = load64(&st + FS_STAT_SIZE) - pos;
                            if (skip >= left) {
                                if (k_lseek(fd, 0, 2) >= 0) { skip = 0; }       # SEEK_END
                            } else {
                                if (k_lseek(fd, skip, 1) >= 0) { skip = 0; }    # SEEK_CUR
                            }
                        }
                    }
                }
            }
        }
    }
    if (_tail_rbuf == 0) { _tail_rbuf = alloc(_TAIL_READ_BUFSZ); }
    var buf = _tail_rbuf;
    var loop: i64 = 1;
    while (loop == 1) {
        var got = k_read( fd, buf, _TAIL_READ_BUFSZ);
        if (got < 0) {
            if ((0 - got) != 4) { return got; }                    # EINTR retries
        } elif (got == 0) {
            loop = 0;
        } else {
            var off: i64 = 0;
            if (skip > 0) {
                if (bytes == 1) {
                    off = skip;
                    if (off > got) { off = got; }
                    skip = skip - off;
                } else {
                    var scanning: i64 = 1;
                    while (scanning == 1) {
                        if (off >= got) { scanning = 0; }
                        elif (skip == 0) { scanning = 0; }
                        else {
                            if (load8(buf + off) == 10) { skip = skip - 1; }
                            off = off + 1;
                        }
                    }
                }
            }
            if (off < got) {
                var wr = _tail_write_all(buf + off, got - off);
                if (wr != 0) { return wr; }
            }
        }
    }
    return 0;
}

# A `-n` / `-c` value: `N` or `-N` for the last N, `+N` for from N on. Returns
# the count (saturated) or -1; `*from_p` is set to 1 for the `+N` form.
#
# ⚠ ONLY THE FIRST BYTE DECIDES, as in GNU — so `tail -n ' +3'` is the LAST three
# lines: the blank is first, and the `+` that `kriya_parse_count_units` then
# accepts after it is a sign, not the start-from marker. ⭐ GNU's units since 1.9.2:
# `-c 1K`, `-n +2M`.
fn _tail_count(arg, from_p): i64 {
    store64(from_p, 0);
    var a = arg;
    var c0 = load8(a);
    if (c0 == 43) {
        store64(from_p, 1);          # the `+` stays: the parser takes it
    } elif (c0 == 45) {
        a = a + 1;
    }
    return kriya_parse_count_units(a);
}

# --- follow mode: GNU's polling `tail_forever` and `recheck`, ported (1.9.2) ----------------
#
# ⭐ GNU'S POLLING LOOP, FUNCTION FOR FUNCTION, from coreutils 9.12's `tail.c`: `tail_file` for the
# first output, `record_open_fd`, `recheck`, `any_live_files`, `some_writers_exist` and
# `tail_forever`. kriya has no inotify, so it is the loop GNU runs under `---disable-inotify`, and
# that is what `smoke-tail-follow.sh` compares against; in steady state GNU's inotify loop prints
# the same bytes.
#
#   - Every followed file is a TailFs record. Each round every file is fstat'ed; a file whose
#     mode, size and mtime have not moved is skipped, and one that has is read to its end, with a
#     `==> NAME <==` header when the output switches to it.
#   - `--follow=descriptor` (`-f`) stays with the open file, renamed or removed. `--follow=name`
#     reopens the NAME after `--max-unchanged-stats` quiet rounds (5) or when the file is gone,
#     and says *has been replaced*, *has become inaccessible* or *has appeared*. `--retry` (in
#     `-F`) keeps trying a name that cannot be opened.
#   - `--pid=PID`, repeatable: when every PID has exited, one more round, then exit.
#   - A pipe or FIFO given as standard input is not followed, as POSIX requires.
#   - When stdout is a pipe whose reader has gone, tail dies of SIGPIPE at the next round instead
#     of at the next write.
#
# ⚠ The default interval is 0.2 s, not GNU's 1.0: GNU's polling interval is its fallback, and its
# inotify loop answers at once; 0.2 s keeps kriya near that. `-s` sets it.
# ⚠ agnos has no fstat on a descriptor and no lseek, so there the file is stat'ed by name and a
# truncated file is reopened.

enum TailFs {
    TF_NAME     = 0;     # the operand; "-" for standard input
    TF_PRETTY   = 8;     # "standard input" for "-"
    TF_FD       = 16;    # -1 when not open
    TF_ERRNUM   = 24;    # 0, the last errno, or -1
    TF_IGNORE   = 32;
    TF_TAILABLE = 40;
    TF_MODE     = 48;
    TF_DEV      = 56;
    TF_INO      = 64;
    TF_MSEC     = 72;
    TF_MNSEC    = 80;
    TF_POS      = 88;    # read position, for a regular file
    TF_UNCH     = 96;    # unchanged stats since the last open
    TF_BLOCKING = 104;   # 1 blocking, 0 non-blocking, -1 unknown
    TF_SZ       = 112;
}

var _tail_forever = 0;
var _tail_by_name = 0;      # --follow=name or -F
var _tail_reopen = 0;       # --retry or -F
var _tail_pidv = 0;         # the PIDs still alive at the last look
var _tail_had_pids = 0;     # 1 when --pid stands
var _tail_sleep_ns = 200000000;
var _tail_max_unch = 5;
var _tail_headers = 0;
var _tail_hdr_first = 1;
var _tail_monitor = 0;
var _tail_dbuf = 0;

fn _tail_header(name): i64 {
    if (_tail_hdr_first == 0) { k_write( 1, "\n", 1); }
    _tail_hdr_first = 0;
    k_write( 1, "==> ", 4);
    k_write( 1, name, strlen(name));
    k_write( 1, " <==\n", 5);
    return 0;
}

# A follow diagnostic: `kriya tail: PRE NAME MSG`, then `: ERROR` when `errno` > 0.
fn _tail_note_pre(pre, name, msg, errno): i64 {
    k_write( 2, "kriya tail: ", 12);
    k_write( 2, pre, strlen(pre));
    _report_operand(name);
    k_write( 2, msg, strlen(msg));
    if (errno > 0) {
        k_write( 2, ": ", 2);
        if (errmsg_is_known(errno) == 1) {
            var m = errmsg_for(errno);
            k_write( 2, m, strlen(m));
        } else { k_write( 2, "error", 5); }
    }
    k_write( 2, "\n", 1);
    return 0;
}

fn _tail_note(name, msg, errno): i64 { return _tail_note_pre("", name, msg, errno); }

fn _tail_type(mode): i64 { return mode & FS_S_IFMT; }
fn _tail_is_reg(mode): i64 {
    if ((mode & FS_S_IFMT) == FS_S_IFREG) { return 1; }
    return 0;
}

# GNU's IS_TAILABLE_FILE_TYPE: a regular file, a FIFO, a socket or a character device.
fn _tail_tailable_type(mode): i64 {
    var t = mode & FS_S_IFMT;
    if (t == FS_S_IFREG) { return 1; }
    if (t == FS_S_IFIFO) { return 1; }
    if (t == FS_S_IFSOCK) { return 1; }
    if (t == FS_S_IFCHR) { return 1; }
    return 0;
}

fn _tail_fd_stat(fd, name, st): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    if (fd == 0) { return 0 - 38; }
    return k_stat(name, st);
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    return fs_fstatat(fd, "", st, 4096);                    # AT_EMPTY_PATH: fstat
    #endif
}

# GNU's SAME_INODE: the record and `st` are one file.
fn _tail_same_file(f, st): i64 {
    if (load64(f + TF_INO) != load64(st + FS_STAT_INO)) { return 0; }
    if (load64(f + TF_DEV) != load64(st + FS_STAT_DEV)) { return 0; }
    return 1;
}

fn _tail_close(fd): i64 {
    if (fd > 0) { k_close( fd); }
    return 0;
}

# GNU's `record_open_fd`: `pos` < 0 asks the descriptor where it is.
fn _tail_record(f, fd, pos, st, blocking): i64 {
    store64(f + TF_FD, fd);
    store64(f + TF_MSEC, load64(st + FS_STAT_MTIME));
    store64(f + TF_MNSEC, load64(st + FS_STAT_MTIME_NSEC));
    store64(f + TF_DEV, load64(st + FS_STAT_DEV));
    store64(f + TF_INO, load64(st + FS_STAT_INO));
    var mode = load64(st + FS_STAT_MODE) & 0xffffffff;
    store64(f + TF_MODE, mode);
    if (_tail_is_reg(mode) == 1) {
        var p = pos;
        if (p < 0) {
            p = k_lseek(fd, 0, 1);                          # SEEK_CUR
            if (p < 0) { p = 0; }
        }
        store64(f + TF_POS, p);
    }
    store64(f + TF_BLOCKING, blocking);
    store64(f + TF_UNCH, 0);
    store64(f + TF_IGNORE, 0);
    return 0;
}

# GNU's `recheck`: open and stat the NAME again and act on what changed.
fn _tail_recheck(f, blocking): i64 {
    var name = load64(f + TF_NAME);
    var pretty = load64(f + TF_PRETTY);
    var is_stdin = streq(name, "-");
    var prev = load64(f + TF_ERRNUM);
    var fd: i64 = 0;
    var open_err: i64 = 0;
    if (is_stdin == 0) {
        var fl: i64 = 0;
        if (blocking == 0) { fl = 2048; }                   # O_NONBLOCK
        fd = k_open(name, fl, 0);
        if (fd < 0) {
            open_err = 0 - fd;
            fd = 0 - 1;
        }
    }
    var st[144];
    var sr: i64 = 0;
    if (fd >= 0) { sr = _tail_fd_stat(fd, name, &st); }
    var ok: i64 = 0;
    var bad: i64 = 0;
    if (fd < 0) { bad = 1; }
    if (sr < 0) { bad = 1; }
    if (bad == 1) {
        var en = open_err;
        if (fd >= 0) { en = 0 - sr; }
        store64(f + TF_ERRNUM, en);
        if (fd < 0) {
            if (load64(f + TF_TAILABLE) == 1) { _tail_note(pretty, " has become inaccessible", en); }
        } elif (prev != en) {
            _tail_note(pretty, "", en);
        }
    } elif (_tail_tailable_type(load64(&st + FS_STAT_MODE)) == 0) {
        store64(f + TF_ERRNUM, 0 - 1);
        var ign: i64 = 1;
        if (_tail_reopen == 1) { if (_tail_by_name == 1) { ign = 0; } }
        store64(f + TF_IGNORE, ign);
        var say: i64 = 0;
        if (load64(f + TF_TAILABLE) == 1) { say = 1; }
        if (prev >= 0) { if (prev != 21) { say = 1; } }     # EISDIR
        if (say == 1) {
            var um = " has been replaced with an untailable file";
            if (ign == 1) { um = " has been replaced with an untailable file; giving up on this name"; }
            _tail_note(pretty, um, 0);
        }
    } else {
        ok = 1;
        store64(f + TF_ERRNUM, 0);
    }
    store64(f + TF_TAILABLE, ok);
    var new_file: i64 = 0;
    if (ok == 0) {
        _tail_close(fd);
        _tail_close(load64(f + TF_FD));
        store64(f + TF_FD, 0 - 1);
    } elif (prev != 0 && prev != 2) {                         # ENOENT
        new_file = 1;
        _tail_note(pretty, " has become accessible", 0);
    } elif (load64(f + TF_FD) < 0) {
        new_file = 1;
        _tail_note(pretty, " has appeared;  following new file", 0);
    } elif (_tail_same_file(f, &st) == 0) {
        new_file = 1;
        _tail_note(pretty, " has been replaced;  following new file", 0);
        _tail_close(load64(f + TF_FD));
    } else {
        _tail_close(fd);
    }
    if (new_file == 1) {
        var b = blocking;
        if (is_stdin == 1) { b = 0 - 1; }
        _tail_record(f, fd, 0 - 1, &st, b);
    }
    return 0;
}

# GNU's `any_live_files`.
fn _tail_any_live(F, n): i64 {
    if (_tail_reopen == 1) { if (_tail_by_name == 1) { return 1; } }
    var i: i64 = 0;
    while (i < n) {
        var f = F + i * TF_SZ;
        if (load64(f + TF_FD) >= 0) { return 1; }
        if (load64(f + TF_IGNORE) == 0) { if (_tail_reopen == 1) { return 1; } }
        i = i + 1;
    }
    return 0;
}

# GNU's `some_writers_exist`: drop every PID that no longer exists.
fn _tail_writers_alive(): i64 {
    var keep = vec_new();
    var i: i64 = 0;
    while (i < vec_len(_tail_pidv)) {
        var pid = vec_get(_tail_pidv, i);
        if (sys_kill(pid, 0) != (0 - 3)) { vec_push(keep, pid); }   # ESRCH
        i = i + 1;
    }
    _tail_pidv = keep;
    if (vec_len(keep) > 0) { return 1; }
    return 0;
}

# GNU's `check_output_alive`: stdout is a pipe whose reader has gone.
fn _tail_output_broken(): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    return 0;
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    var pfd[8];
    store64(&pfd, 0);
    store32(&pfd, 1);                                       # fd 1
    store16(&pfd + 4, 128);                                 # POLLRDBAND
    var ts[16];
    store64(&ts, 0);
    store64(&ts + 8, 0);
    var r = sys_ppoll(&pfd, 1, &ts, 0, 8);
    if (r <= 0) { return 0; }
    if ((load16(&pfd + 6) & 56) != 0) { return 1; }         # POLLERR | POLLHUP | POLLNVAL
    return 0;
    #endif
}

fn _tail_nap(ns): i64 {
    var ts[16];
    var rem[16];
    store64(&ts, ns / 1000000000);
    store64(&ts + 8, ns % 1000000000);
    var r = sys_nanosleep(&ts, &rem);
    while (r == (0 - 4)) {                                  # EINTR: sleep the rest
        store64(&ts, load64(&rem));
        store64(&ts + 8, load64(&rem + 8));
        r = sys_nanosleep(&ts, &rem);
    }
    return 0;
}

# GNU's `dump_remainder`: read and print to EOF, or one buffer when `one` is 1. Returns the bytes
# read, or -1 after a fatal read or write error (already reported).
fn _tail_dump(fd, pretty, one): i64 {
    if (_tail_dbuf == 0) { _tail_dbuf = alloc(_TAIL_READ_BUFSZ); }
    var total: i64 = 0;
    var going: i64 = 1;
    while (going == 1) {
        var n = k_read( fd, _tail_dbuf, _TAIL_READ_BUFSZ);
        if (n < 0) {
            if (n == (0 - 4)) {
                # EINTR: read again.
            } elif (n == (0 - 11)) {
                going = 0;                                  # EAGAIN: nothing yet
            } else {
                _tail_note_pre("error reading ", pretty, "", 0 - n);
                return 0 - 1;
            }
        } elif (n == 0) {
            going = 0;
        } else {
            var wr = _tail_write_all(_tail_dbuf, n);
            if (wr != 0) {
                _tail_report("(write)", 0 - wr);
                return 0 - 1;
            }
            total = total + n;
            if (one == 1) { going = 0; }
        }
    }
    return total;
}

# Clear or set O_NONBLOCK as `blocking` asks; 0 on success.
fn _tail_set_blocking(fd, blocking): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    return 0;
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    var fl = sys_fcntl(fd, 3, 0);                           # F_GETFL
    if (fl < 0) { return fl; }
    var nf = fl | 2048;
    if (blocking == 1) { nf = fl & (0 - 2049); }
    if (nf == fl) { return 0; }
    return sys_fcntl(fd, 4, nf);                            # F_SETFL
    #endif
}

# One file of one round of GNU's `tail_forever`. Returns 1 when it read something, 0 when not,
# -1 after a fatal error. `*last_p` is the file the output was last switched to.
fn _tail_poll_one(F, n, i, blocking, last_p): i64 {
    var f = F + i * TF_SZ;
    if (load64(f + TF_IGNORE) == 1) { return 0; }
    var fd = load64(f + TF_FD);
    if (fd < 0) {
        _tail_recheck(f, blocking);
        return 0;
    }
    var pretty = load64(f + TF_PRETTY);
    var mode = load64(f + TF_MODE);
    if (load64(f + TF_BLOCKING) != blocking) {
        var sb = _tail_set_blocking(fd, blocking);
        if (sb == 0) { store64(f + TF_BLOCKING, blocking); }
        elif (_tail_is_reg(mode) == 0) {
            _tail_note(pretty, ": cannot change nonblocking mode", 0 - sb);
            return 0 - 1;
        }
    }
    var read_unchanged: i64 = 0;
    var st[144];
    if (load64(f + TF_BLOCKING) == 0) {
        var sr = _tail_fd_stat(fd, load64(f + TF_NAME), &st);
        if (sr < 0) {
            store64(f + TF_FD, 0 - 1);
            store64(f + TF_ERRNUM, 0 - sr);
            _tail_note(pretty, "", 0 - sr);
            _tail_close(fd);
            return 0;
        }
        var smode = load64(&st + FS_STAT_MODE) & 0xffffffff;
        var same: i64 = 1;
        if (load64(f + TF_MODE) != smode) { same = 0; }
        if (_tail_is_reg(smode) == 1) {
            if (load64(f + TF_POS) != load64(&st + FS_STAT_SIZE)) { same = 0; }
        }
        if (load64(f + TF_MSEC) != load64(&st + FS_STAT_MTIME)) { same = 0; }
        if (load64(f + TF_MNSEC) != load64(&st + FS_STAT_MTIME_NSEC)) { same = 0; }
        if (same == 1) {
            var u = load64(f + TF_UNCH);
            store64(f + TF_UNCH, u + 1);
            if (_tail_max_unch <= u) {
                if (_tail_by_name == 1) {
                    _tail_recheck(f, load64(f + TF_BLOCKING));
                    store64(f + TF_UNCH, 0);
                }
            }
            if (fd != load64(f + TF_FD)) { return 0; }
            if (_tail_is_reg(smode) == 1) { return 0; }
            if (n > 1) { return 0; }
            read_unchanged = 1;
        }
        store64(f + TF_MSEC, load64(&st + FS_STAT_MTIME));
        store64(f + TF_MNSEC, load64(&st + FS_STAT_MTIME_NSEC));
        store64(f + TF_MODE, smode);
        if (read_unchanged == 0) { store64(f + TF_UNCH, 0); }
        if (_tail_is_reg(mode) == 1) {
            if (load64(&st + FS_STAT_SIZE) < load64(f + TF_POS)) {
                _tail_note(pretty, ": file truncated", 0);
                if (K_HAVE_LSEEK == 1) {
                    var np = k_lseek(fd, 0, 0);
                    if (np < 0) {
                        _tail_note(pretty, ": cannot seek to offset 0", 0 - np);
                        return 0 - 1;
                    }
                } else {
                    # No lseek: read the file again from a new descriptor.
                    var nfd = k_open(load64(f + TF_NAME), 0, 0);
                    if (nfd >= 0) {
                        _tail_close(fd);
                        fd = nfd;
                        store64(f + TF_FD, fd);
                    }
                }
                store64(f + TF_POS, 0);
            }
        }
        if (i != load64(last_p)) {
            if (_tail_headers == 1) { _tail_header(pretty); }
            store64(last_p, i);
        }
    }
    var one: i64 = 0;
    if (load64(f + TF_BLOCKING) != 0) { one = 1; }
    var nr = _tail_dump(fd, pretty, one);
    if (nr < 0) { return 0 - 1; }
    if (nr > 0) {
        if (_tail_is_reg(mode) == 1) { store64(f + TF_POS, load64(f + TF_POS) + nr); }
        if (read_unchanged == 1) { store64(f + TF_UNCH, 0); }
        return 1;
    }
    return 0;
}

# GNU's `tail_forever`, polling. Returns -1 when every --pid writer has exited, or 1 after a fatal
# error ("no files remaining" included).
fn _tail_forever_loop(F, n): i64 {
    var last[8];
    store64(&last, n - 1);
    while (1 == 1) {
        var blocking: i64 = 0;
        if (_tail_had_pids == 0) {
            if (_tail_by_name == 0) {
                if (n == 1) {
                    if (load64(F + TF_FD) >= 0) {
                        if (_tail_is_reg(load64(F + TF_MODE)) == 0) { blocking = 1; }
                    }
                }
            }
        }
        var any_input: i64 = 0;
        var i: i64 = 0;
        while (i < n) {
            var r = _tail_poll_one(F, n, i, blocking, &last);
            if (r < 0) { return 1; }
            if (r == 1) { any_input = 1; }
            i = i + 1;
        }
        if (_tail_any_live(F, n) == 0) {
            k_write( 2, "kriya tail: no files remaining\n", 31);
            return 1;
        }
        if (_tail_monitor == 1) {
            if (_tail_output_broken() == 1) {
                sys_kill(sys_getpid(), 13);                 # SIGPIPE, as GNU's die_pipe raises
                return 1;
            }
        }
        if (any_input == 0) {
            var nap: i64 = 1;
            if (_tail_had_pids == 1) {
                if (vec_len(_tail_pidv) == 0) { return 0 - 1; }
                # No writer left: one more round without sleeping, to read what they wrote.
                if (_tail_writers_alive() == 0) { nap = 0; }
            }
            if (nap == 1) { _tail_nap(_tail_sleep_ns); }
        }
    }
    return 0;
}

# GNU's `tail_file` under `-f`: the first output, then the record the loop follows. 1 when ok.
fn _tail_file_follow(f, nfiles, mode_bytes, limit, from_start): i64 {
    var name = load64(f + TF_NAME);
    var pretty = load64(f + TF_PRETTY);
    var is_stdin = streq(name, "-");
    var nonblocking: i64 = 0;
    if (_tail_had_pids == 1) { nonblocking = 1; }
    if (nfiles > 1) { nonblocking = 1; }
    var fd: i64 = 0;
    if (is_stdin == 0) {
        var fl: i64 = 0;
        if (nonblocking == 1) { fl = 2048; }
        fd = k_open(name, fl, 0);
    }
    store64(f + TF_TAILABLE, 0);
    if (fd < 0) {
        store64(f + TF_FD, 0 - 1);
        store64(f + TF_ERRNUM, 0 - fd);
        store64(f + TF_IGNORE, 1 - _tail_reopen);
        store64(f + TF_DEV, 0);
        store64(f + TF_INO, 0);
        _tail_report(name, 0 - fd);
        return 0;
    }
    if (_tail_headers == 1) { _tail_header(pretty); }
    var ok: i64 = 1;
    var st[144];
    var sr = _tail_fd_stat(fd, name, &st);
    if (sr < 0) {
        ok = 0;
        store64(f + TF_ERRNUM, 0 - sr);
        _tail_note(pretty, ": cannot fstat", 0 - sr);
    } else {
        var r = _tail_emit_one(fd, pretty, mode_bytes, limit, from_start);
        if (r != 0) {
            ok = 0;
            store64(f + TF_ERRNUM, 0 - r);
            _tail_report(pretty, 0 - r);
        } else { store64(f + TF_ERRNUM, 0); }
        if (_tail_tailable_type(load64(&st + FS_STAT_MODE)) == 1) {
            store64(f + TF_TAILABLE, 1);
        } else {
            ok = 0;
            store64(f + TF_ERRNUM, 0 - 1);
            if (_tail_reopen == 1) { _tail_note(pretty, ": cannot follow end of this type of file", 0); }
            else { _tail_note(pretty, ": cannot follow end of this type of file; giving up on this name", 0); }
        }
    }
    if (ok == 0) {
        store64(f + TF_IGNORE, 1 - _tail_reopen);
        _tail_close(fd);
        store64(f + TF_FD, 0 - 1);
        return 0;
    }
    var b: i64 = 1;
    if (is_stdin == 1) { b = 0 - 1; }
    _tail_record(f, fd, 0 - 1, &st, b);
    return 1;
}

# GNU's `ignore_fifo_and_pipe`: a "-" that is a pipe or FIFO is not followed. 1 when some file is.
fn _tail_drop_pipes(F, n): i64 {
    var viable: i64 = 0;
    var i: i64 = 0;
    while (i < n) {
        var f = F + i * TF_SZ;
        var pipe: i64 = 0;
        if (streq(load64(f + TF_NAME), "-") == 1) {
            if (load64(f + TF_IGNORE) == 0) {
                if (load64(f + TF_FD) >= 0) {
                    if (_tail_type(load64(f + TF_MODE)) == FS_S_IFIFO) { pipe = 1; }
                }
            }
        }
        if (pipe == 1) {
            store64(f + TF_FD, 0 - 1);
            store64(f + TF_ERRNUM, 0 - 1);
            store64(f + TF_IGNORE, 1);
        } else { viable = 1; }
        i = i + 1;
    }
    return viable;
}

# `-s SECONDS`: any non-negative `strtod` number, `inf` included, as nanoseconds; -1 when it is
# not one.
fn _tail_parse_secs(s): i64 {
    var rec[32];
    var n = xf_parse(s, XF_DBL, &rec);
    if (n == 0) { return 0 - 1; }
    if (load8(s + n) != 0) { return 0 - 1; }
    if (xf_is_nan(&rec) == 1) { return 0 - 1; }
    if (xf_is_zero(&rec) == 1) { return 0; }
    if (load64(&rec + XF_SIGN) == 1) { return 0 - 1; }
    if (xf_is_inf(&rec) == 1) { return 4611686018427387904; }
    var ns = f64_mul(xf_to_f64(&rec), 0x41CDCD6500000000);  # 1e9
    if (f64_ge(ns, 0x43D0000000000000) == 1) { return 4611686018427387904; }   # 2^62
    return f64_to(ns);
}

fn _tail_emit_one(fd, name, mode_bytes, limit, from_start): i64 {
    if (from_start == 1) { return _tail_from(fd, limit, mode_bytes); }
    var slurp[24];
    var r = _tail_slurp(fd, name, &slurp);
    if (r != 0) { return r; }
    var buf  = load64(&slurp + 0);
    var size = load64(&slurp + 8);

    var emit_off: i64 = 0;
    var emit_len: i64 = 0;
    if (mode_bytes == 1) {
        if (limit >= size) {
            emit_off = 0;
            emit_len = size;
        } else {
            emit_off = size - limit;
            emit_len = limit;
        }
    } else {
        emit_off = _tail_line_start(buf, size, limit);
        emit_len = size - emit_off;
    }
    if (emit_len > 0) {
        var wr = _tail_write_all(buf + emit_off, emit_len);
        if (wr != 0) { return wr; }
    }
    return 0;
}

# The follow options, walked in command-line order over the expanded argv as `kriya_opt_seq`
# walks it, because their order matters: `-f` and `--follow[=WORD]` set the mode, `-F` sets name
# and `--retry`, and the last of the three wins, as in GNU (`-F -f` follows the descriptor, with
# `--retry`). `--retry`, every `--pid`, `-s` and `--max-unchanged-stats` are read on the way.
# Returns 0 or the exit status.
fn _tail_scan_follow(): i64 {
    var av = kriya_expanded_argv();
    var n  = kriya_expanded_argc();
    _tail_pidv = vec_new();
    if (av == 0) { return 0; }
    var no_more: i64 = 0;
    var i: i64 = 1;
    while (i < n) {
        var tok  = load64(av + i * 8);
        var tlen = strlen(tok);
        var step: i64 = 1;
        var which: i64 = 0;   # 102 -f, 70 -F, 1 --follow, 2 --retry, 3 --pid, 115 -s, 4 --max-unchanged-stats
        var val: i64 = 0;
        if (no_more == 0) {
            if (tlen >= 2) {
                if (load8(tok) == 45) {
                    if (load8(tok + 1) == 45) {
                        if (tlen == 2) { no_more = 1; }
                        else {
                            var eq: i64 = 0;
                            var e: i64 = 2;
                            while (e < tlen && eq == 0) {
                                if (load8(tok + e) == 61) { eq = e; }
                                e = e + 1;
                            }
                            var nlen = tlen - 2;
                            if (eq > 0) {
                                nlen = eq - 2;
                                val = tok + eq + 1;
                            }
                            var lt = kriya_long_type(_tail_spec, tok + 2, nlen);
                            if (lt > 0) {
                                if (eq == 0) {
                                    if (i + 1 < n) { val = load64(av + (i + 1) * 8); }
                                    step = 2;
                                }
                            }
                            if (lt == 0) { val = kriya_expanded_optval(i); }
                            var nm = alloc(nlen + 1);
                            memcpy(nm, tok + 2, nlen);
                            store8(nm + nlen, 0);
                            if (streq(nm, "follow") == 1) { which = 1; }
                            elif (streq(nm, "retry") == 1) { which = 2; }
                            elif (streq(nm, "pid") == 1) { which = 3; }
                            elif (streq(nm, "sleep-interval") == 1) { which = 115; }
                            elif (streq(nm, "max-unchanged-stats") == 1) { which = 4; }
                        }
                    } else {
                        var c = load8(tok + 1);
                        var ty = kriya_short_type(_tail_spec, c);
                        if (ty >= 0) {
                            which = c;
                            if (ty > 0) {
                                if (i + 1 < n) { val = load64(av + (i + 1) * 8); }
                                step = 2;
                            }
                        }
                    }
                }
            }
        }
        if (which == 102) {
            _tail_forever = 1;
            _tail_by_name = 0;
        } elif (which == 70) {
            _tail_forever = 1;
            _tail_by_name = 1;
            _tail_reopen = 1;
        } elif (which == 1) {
            _tail_forever = 1;
            _tail_by_name = 0;
            if (val != 0) {
                var m = kriya_argmatch(val, "descriptor\0name", "dn", 2);
                if (m < 0) {
                    k_write( 2, "kriya tail: --follow: '", 23);
                    k_write( 2, val, strlen(val));
                    if (m == (0 - 2)) { k_write( 2, "' is ambiguous", 14); }
                    else { k_write( 2, "' is not a follow mode", 22); }
                    k_write( 2, " (use name or descriptor)\n", 26);
                    return EXIT_USAGE;
                }
                if (m == 110) { _tail_by_name = 1; }
            }
        } elif (which == 2) {
            _tail_reopen = 1;
        } elif (which == 3) {
            # GNU's `xdectoumax (optarg, 0, PID_T_MAX, "")`: decimal, 0 to 2^31 - 1.
            var po[32];
            var pe = kriya_xstrtou(val, "", &po);
            var pok: i64 = 0;
            if (pe == 0) { if (load64(&po) <= 2147483647) { pok = 1; } }
            if (pok == 0) {
                report_note("tail", val, "invalid PID");
                return EXIT_USAGE;
            }
            vec_push(_tail_pidv, load64(&po));
        } elif (which == 115) {
            var ns = _tail_parse_secs(val);
            if (ns < 0) {
                report_note("tail", val, "invalid number of seconds");
                return EXIT_USAGE;
            }
            _tail_sleep_ns = ns;
        } elif (which == 4) {
            var mo[32];
            var me = kriya_xstrtou(val, "", &mo);
            if (me == 0) { _tail_max_unch = load64(&mo); }
            elif (me == KRIYA_XS_OVERFLOW) { _tail_max_unch = KRIYA_COUNT_MAX; }
            else {
                report_note("tail", val, "invalid maximum number of unchanged stats between opens");
                return EXIT_USAGE;
            }
        }
        i = i + step;
    }
    return 0;
}

# GNU's `main` from the first output on, under `-f` / `-F`. `npos` operands, or standard input.
fn _tail_follow_main(npos, mode_bytes, limit, from_start): i64 {
    var n = npos;
    if (n < 1) { n = 1; }
    var F = alloc(n * TF_SZ);
    var z: i64 = 0;
    while (z < n * TF_SZ) { store64(F + z, 0); z = z + 8; }
    var found_hyphen: i64 = 0;
    var i: i64 = 0;
    while (i < n) {
        var nm = "-";
        if (npos > 0) { nm = flags_positional(_tail_spec, i); }
        var f = F + i * TF_SZ;
        store64(f + TF_NAME, nm);
        store64(f + TF_PRETTY, nm);
        store64(f + TF_FD, 0 - 1);
        if (streq(nm, "-") == 1) {
            found_hyphen = 1;
            store64(f + TF_PRETTY, "standard input");
        }
        i = i + 1;
    }
    if (found_hyphen == 1) {
        if (_tail_by_name == 1) {
            k_write( 2, "kriya tail: cannot follow '-' by name\n", 38);
            return EXIT_USAGE;
        }
        var blocking_stdin: i64 = 0;
        if (_tail_had_pids == 0) {
            if (n == 1) {
                var s0[144];
                if (_tail_fd_stat(0, "-", &s0) == 0) {
                    if (_tail_is_reg(load64(&s0 + FS_STAT_MODE)) == 0) { blocking_stdin = 1; }
                }
            }
        }
        if (blocking_stdin == 0) {
            if (k_isatty(0) == 1) {
                k_write( 2, "kriya tail: warning: following standard input indefinitely is ineffective\n", 74);
            }
        }
    }
    var ok: i64 = 1;
    i = 0;
    while (i < n) {
        if (_tail_file_follow(F + i * TF_SZ, n, mode_bytes, limit, from_start) == 0) { ok = 0; }
        i = i + 1;
    }
    if (_tail_drop_pipes(F, n) == 1) {
        var so[144];
        _tail_monitor = 0;
        if (_tail_fd_stat(1, "", &so) == 0) {
            if (_tail_type(load64(&so + FS_STAT_MODE)) == FS_S_IFIFO) { _tail_monitor = 1; }
        }
        if (_tail_forever_loop(F, n) == 1) { return EXIT_FAILURE; }
    }
    if (ok == 0) { return EXIT_FAILURE; }
    return EXIT_SUCCESS;
}

fn cmd_tail(start: i64): i64 {
    _tail_init_spec();
    # ⭐ THE OBSOLESCENT FIRST ARGUMENT IS PARSED HERE, BEFORE THE OPTION PARSER
    # SEES IT, and dropped from what the parser gets (`kriya_obs_consume_first`).
    # POSIX marks `tail -5` obsolescent but every shell script in existence still
    # uses it, and GNU's form goes further than bare digits: `+5` starts at line
    # five, `-5c` is five bytes, `-5f` follows. Until 1.6.15 only the bare digits
    # were taken, `-5c` exited 2, and `tail +5 f` read a FILE named `+5`.
    # ⚠ FIRST ARGUMENT ONLY — `tail -c 3 -5` is a usage error, as it is in GNU.
    # The expander enforces that and names the offender (`_kriya_obsnum_trailing`).
    var obs[32];
    var have_obs: i64 = 0;
    if (start < kriya_argv_count()) {
        var tok0 = load64(kriya_argv_flat() + start * 8);
        if (_tail_obs_parse(tok0, &obs) == 1) {
            have_obs = 1;
            if (load8(tok0) == 43) { have_obs = _tail_plus_is_count(start); }
        }
        if (have_obs == 1) { kriya_obs_consume_first(); }
    }
    if (kriya_args_parse_optval(_tail_spec, start, 110, "follow") != 0) {
        k_write( 2, "kriya tail: error: bad option (see ADR 0002 for accepted syntax)\n", 65);
        return EXIT_USAGE;
    }

    _tail_forever = 0;
    _tail_by_name = 0;
    _tail_reopen = 0;
    _tail_had_pids = 0;
    _tail_hdr_first = 1;
    if (have_obs == 1) {
        if (load64(&obs + TAIL_OBS_FOLLOW) == 1) { _tail_forever = 1; }
    }
    var src = _tail_scan_follow();
    if (src != 0) { return src; }

    # ⛔ -n AND -c ARE LAST-WINS HERE FOR THE SAME REASON THEY ARE IN `head`, and
    # this block had the same shape and the same defect. Measured against GNU
    # coreutils 9.11 on `abcdefghij\nklmnop\n`:
    #
    #     $ tail -c 3 -n 1 h.txt      klmnop      (the -n answer)
    #     $ kriya tail -c 3 -n 1      op          (the -c answer)
    #
    # ⚠ `-n 1 -c 3` agrees under both rules, and that is the order the suite
    # covered. See the longer note in `src/cmd/head.cyr` — the two utilities are
    # a pair and a fix to one that skips the other is half a fix.
    # ⭐ The obsolescent first argument is not in the expanded argv at all: it
    # comes first, so any `-n` or `-c` after it wins.
    var mode_bytes: i64 = 0;
    var limit: i64 = 10;
    var from_start: i64 = 0;
    if (have_obs == 1) {
        limit = load64(&obs + TAIL_OBS_COUNT);
        mode_bytes = load64(&obs + TAIL_OBS_BYTES);
        from_start = load64(&obs + TAIL_OBS_START);
    }

    var n_arg = flags_get_str(_tail_spec, _tail_n_idx);
    var c_arg = flags_get_str(_tail_spec, _tail_c_idx);

    # ⚠ BOTH ARE VALIDATED EVEN THOUGH ONLY ONE IS USED: a bad count is a usage
    # error whichever flag ends up losing.
    #
    # ⛔ AN EMPTY VALUE IS AN ERROR, NOT AN ABSENT OPTION. `--lines=` used to be
    # skipped over — the option was thrown away and the DEFAULT ten lines
    # printed, at exit 0. See the same note in `head.cyr`; both had it, because
    # both were written from the same shape.
    var n_val: i64 = 0 - 1;
    var c_val: i64 = 0 - 1;
    var n_from: i64 = 0;
    var c_from: i64 = 0;
    if (n_arg != 0) {
        n_val = _tail_count(n_arg, &n_from);
        if (n_val < 0) {
            report_note("tail", n_arg, "invalid number of lines");
            return EXIT_USAGE;
        }
    }
    if (c_arg != 0) {
        c_val = _tail_count(c_arg, &c_from);
        if (c_val < 0) {
            report_note("tail", c_arg, "invalid number of bytes");
            return EXIT_USAGE;
        }
    }
    var n_at: i64 = 0;
    var c_at: i64 = 0;
    if (n_val >= 0) { n_at = kriya_opt_seq(_tail_spec, 110, "lines"); }
    if (c_val >= 0) { c_at = kriya_opt_seq(_tail_spec, 99,  "bytes"); }
    if (n_at > c_at) {
        limit = n_val;
        mode_bytes = 0;
        from_start = n_from;
    }
    if (c_at > n_at) {
        limit = c_val;
        mode_bytes = 1;
        from_start = c_from;
    }

    # GNU's warnings for the options that mean nothing without `-f`.
    if (_tail_reopen == 1) {
        if (_tail_forever == 0) {
            _tail_reopen = 0;
            k_write( 2, "kriya tail: warning: --retry ignored; --retry is useful only when following\n", 76);
        } elif (_tail_by_name == 0) {
            k_write( 2, "kriya tail: warning: --retry only effective for the initial open\n", 65);
        }
    }
    if (vec_len(_tail_pidv) > 0) {
        if (_tail_forever == 0) {
            k_write( 2, "kriya tail: warning: PID ignored; --pid=PID is useful only when following\n", 74);
        } else { _tail_had_pids = 1; }
    }

    var npos = flags_positional_count(_tail_spec);

    # ⛔ `-q` AND `-v` WERE A PRECEDENCE LADDER TWENTY LINES BELOW THE ONE THIS
    # RELEASE REPLACED. Quiet won unconditionally here and verbose won
    # unconditionally on the stdin path above, so the bug ran in both
    # directions: `tail -q -v a b` dropped BOTH headers and concatenated two
    # files with nothing marking the boundary, at exit 0, and `tail -v -q < f`
    # emitted a header GNU suppresses. GNU resolves the pair by LAST
    # OCCURRENCE, exactly as it does `-n`/`-c`.
    #
    # ⚠ The multi-file case is the one that costs something: `-q -v a b` is how
    # a script forces headers back on after a wrapper injected `-q`, and the
    # answer it got could not be split back into two files.
    var show_headers: i64 = 0;
    if (npos > 1) { show_headers = 1; }
    var q_at = kriya_opt_seq(_tail_spec, 113, "quiet");
    var v_at = kriya_opt_seq(_tail_spec, 118, "verbose");
    if (v_at > q_at) { show_headers = 1; }
    if (q_at > v_at) { show_headers = 0; }
    _tail_headers = show_headers;

    # ⭐ `-f` on several files, `-F`, `--follow=name`, `--retry` and `--pid` (1.9.2): GNU's loop.
    # Until 1.9.2 `-f` took one file and refused two, exit 2.
    if (_tail_forever == 1) {
        return _tail_follow_main(npos, mode_bytes, limit, from_start);
    }

    var any_failed: i64 = 0;
    if (npos < 1) {
        if (show_headers == 1) { _tail_emit_header("standard input", 1); }
        var r = _tail_emit_one(0, "standard input", mode_bytes, limit, from_start);
        if (r != 0) {
            _tail_report("(stdin)", 0 - r);
            any_failed = 1;
        }
        if (any_failed == 1) { return EXIT_FAILURE; }
        return EXIT_SUCCESS;
    }

    var i: i64 = 0;
    var first: i64 = 1;
    while (i < npos) {
        var p = flags_positional(_tail_spec, i);
        var fd: i64 = 0;
        var name: i64 = p;
        var is_stdin: i64 = 0;
        if (load8(p) == 45) {
            if (load8(p + 1) == 0) {
                fd = 0;
                is_stdin = 1;
                name = "standard input";
            }
        }
        if (is_stdin == 0) {
            fd = k_open(p, 0, 0);
            if (fd < 0) {
                _tail_report(p, 0 - fd);
                any_failed = 1;
                i = i + 1;
                continue;
            }
        }
        if (show_headers == 1) { _tail_emit_header(name, first); }
        var r = _tail_emit_one(fd, name, mode_bytes, limit, from_start);
        if (r != 0) {
            _tail_report(name, 0 - r);
            any_failed = 1;
        }
        if (is_stdin == 0) { k_close( fd); }
        first = 0;
        i = i + 1;
    }

    if (any_failed == 1) { return EXIT_FAILURE; }
    return EXIT_SUCCESS;
}
