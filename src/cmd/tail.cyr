# tail — POSIX `tail(1)`: emit the last N lines/bytes of each input.
#
# Argument shape:
#   tail [opts] [file...]
#
# Flags:
#   -n / --lines=N    emit the last N lines (default 10).
#   -c / --bytes=N    emit the last N bytes.
#   -q / --quiet      never emit the `==> FILE <==` header.
#   -v / --verbose    always emit the header.
#
# Default: 10 lines. When neither `-q` nor `-v` is set, the header is
# emitted iff there is more than one file operand.
#
# Implementation: buffer the input (up to a 16 MiB cap) into memory,
# then scan backwards from EOF to find the Nth-from-last newline (for
# `-n`) or the byte at offset `size - N` (for `-c`). This is the
# straightforward path that works for both seekable files and pipes.
# A seek-back-from-end fast path for huge files is a clearly-named
# follow-up — see deferrals below.
#
# Cap: if input exceeds 16 MiB, the buffer is truncated to the LAST
# 16 MiB (head bytes discarded). For `-n N` this means the result is
# correct as long as N lines fit in the last 16 MiB; otherwise the
# user sees up to 16 MiB worth of trailing content. A warning to
# stderr is emitted when truncation happens.
#
# Deferred (each a named follow-up):
#   -f / --follow            follow mode (inotify or stat-loop).
#   -F                       --follow=name --retry compound.
#   -n +N / -c +N            start-from-line/byte semantics.
#   --pid=PID                terminate when PID exits (with -f).
#   k/M/G suffixes           on N — shared with head; one parser when extracted.
#   Seek-from-end fast path  for large seekable files (avoids the 16MB cap).

var _tail_spec  = 0;
var _tail_n_idx = 0;
var _tail_c_idx = 0;
var _tail_q_idx = 0;
var _tail_v_idx = 0;

var _TAIL_CAP_BYTES: i64 = 16777216;  # 16 MiB
var _TAIL_READ_BUFSZ: i64 = 65536;

fn _tail_init_spec(): i64 {
    if (_tail_spec != 0) { return 0; }
    var s = flags_new();
    _tail_n_idx = flags_add_str(s,  110, "lines",   0, "emit last N lines (default 10)");
    _tail_c_idx = flags_add_str(s,  99,  "bytes",   0, "emit last N bytes");
    _tail_q_idx = flags_add_bool(s, 113, "quiet",   0, "suppress filename headers");
    _tail_v_idx = flags_add_bool(s, 118, "verbose", 0, "always emit filename headers");
    _tail_spec = s;
    return 0;
}

fn _tail_report(operand, errno): i64 {
    syscall(1, 2, "kriya tail: ", 12);
    syscall(1, 2, operand, strlen(operand));
    syscall(1, 2, ": ", 2);
    if (errmsg_is_known(errno) == 1) {
        var m = errmsg_for(errno);
        syscall(1, 2, m, strlen(m));
    } else {
        syscall(1, 2, "errno ", 6);
        var buf[8];
        var i: i64 = 7;
        store8(&buf + i, 0);
        i = i - 1;
        var v = errno;
        if (v == 0) { store8(&buf + i, 48); i = i - 1; }
        while (v > 0) {
            store8(&buf + i, 48 + (v - (v / 10) * 10));
            v = v / 10;
            i = i - 1;
        }
        syscall(1, 2, &buf + i + 1, 6 - i);
    }
    syscall(1, 2, "\n", 1);
    return 0;
}

fn _tail_emit_header(name, first): i64 {
    if (first == 0) { syscall(1, 1, "\n", 1); }
    syscall(1, 1, "==> ", 4);
    syscall(1, 1, name, strlen(name));
    syscall(1, 1, " <==\n", 5);
    return 0;
}

fn _tail_write_all(buf, n): i64 {
    var written: i64 = 0;
    while (written < n) {
        var w = syscall(1, 1, buf + written, n - written);
        if (w < 0) {
            if ((0 - w) == 4) {
                # EINTR — retry.
            } else { return w; }
        } else {
            written = written + w;
        }
    }
    return 0;
}

# Read all of `fd` into a heap buffer, capped at `_TAIL_CAP_BYTES`.
# When the cap is hit, the buffer holds the LAST cap-bytes (head is
# discarded). Returns (buf, size) via two store64 slots in `out_buf_size_pair`.
# `out_buf_size_pair` is a 24-byte record: ptr/size/truncated_flag.
fn _tail_slurp(fd, name, out): i64 {
    var cap = _TAIL_CAP_BYTES;
    var buf = alloc(cap);
    var have: i64 = 0;
    var truncated: i64 = 0;
    var read_buf = alloc(_TAIL_READ_BUFSZ);
    var loop: i64 = 1;
    while (loop == 1) {
        var n = syscall(0, fd, read_buf, _TAIL_READ_BUFSZ);
        if (n < 0) {
            if ((0 - n) == 4) {
                # EINTR — retry.
            } else { return n; }
        } else {
            if (n == 0) { loop = 0; }
            else {
                if (have + n <= cap) {
                    memcpy(buf + have, read_buf, n);
                    have = have + n;
                } else {
                    # Need to discard from the head to make room.
                    truncated = 1;
                    if (n >= cap) {
                        # New chunk alone exceeds cap: keep the last cap bytes of it.
                        memcpy(buf, read_buf + (n - cap), cap);
                        have = cap;
                    } else {
                        # Shift existing content left by `shift` bytes to make room.
                        var shift = (have + n) - cap;
                        var keep = have - shift;
                        # Move bytes [shift..have) → [0..keep)
                        var i: i64 = 0;
                        while (i < keep) {
                            store8(buf + i, load8(buf + shift + i));
                            i = i + 1;
                        }
                        memcpy(buf + keep, read_buf, n);
                        have = cap;
                    }
                }
            }
        }
    }
    if (truncated == 1) {
        syscall(1, 2, "kriya tail: ", 12);
        syscall(1, 2, name, strlen(name));
        syscall(1, 2, ": input exceeds 16 MiB buffer; showing last 16 MiB only\n", 56);
    }
    store64(out + 0, buf);
    store64(out + 8, have);
    store64(out + 16, truncated);
    return 0;
}

# Find the start byte-offset within `buf[0..size)` for the last `n` lines.
# A "line" ends at a newline; the final byte before EOF (if it's not a
# newline) still counts as part of the trailing partial line.
#
# Walk backwards from `size - 1`, counting newlines encountered. The
# starting position itself is NOT examined (the loop pre-decrements),
# so a trailing newline at `size - 1` is naturally skipped — the first
# newline the loop sees is the one separating the second-to-last line
# from the last. When we've encountered `n` newlines, the byte after
# the `n`-th one is the start of the last `n` lines. If the walk
# reaches offset 0 without finding `n` newlines, the entire buffer is
# fewer than `n` lines — return 0 (emit the whole input).
fn _tail_line_start(buf, size, n): i64 {
    if (n == 0)    { return size; }
    if (size == 0) { return 0; }
    var pos = size - 1;
    var found: i64 = 0;
    var done: i64 = 0;
    while (done == 0) {
        if (pos == 0) { done = 1; }
        else {
            pos = pos - 1;
            if (load8(buf + pos) == 10) {
                found = found + 1;
                if (found >= n) {
                    return pos + 1;
                }
            }
        }
    }
    return 0;
}

fn _tail_emit_one(fd, name, mode_bytes, limit): i64 {
    var slurp[24];
    var r = _tail_slurp(fd, name, &slurp);
    if (r != 0) { return r; }
    var buf  = load64(&slurp + 0);
    var size = load64(&slurp + 8);

    var emit_off: i64 = 0;
    var emit_len: i64 = 0;
    if (mode_bytes == 1) {
        if (limit >= size) {
            emit_off = 0;
            emit_len = size;
        } else {
            emit_off = size - limit;
            emit_len = limit;
        }
    } else {
        emit_off = _tail_line_start(buf, size, limit);
        emit_len = size - emit_off;
    }
    if (emit_len > 0) {
        var wr = _tail_write_all(buf + emit_off, emit_len);
        if (wr != 0) { return wr; }
    }
    return 0;
}

fn cmd_tail(start: i64): i64 {
    _tail_init_spec();
    if (kriya_args_parse(_tail_spec, start) != 0) {
        syscall(1, 2, "kriya tail: error: bad option (see ADR 0002 for accepted syntax)\n", 65);
        return EXIT_USAGE;
    }

    var quiet: i64 = 0;
    if (flags_get_bool(_tail_spec, _tail_q_idx) == 1) { quiet = 1; }
    var verbose: i64 = 0;
    if (flags_get_bool(_tail_spec, _tail_v_idx) == 1) { verbose = 1; }

    var mode_bytes: i64 = 0;
    var limit: i64 = 10;

    var n_arg = flags_get_str(_tail_spec, _tail_n_idx);
    var c_arg = flags_get_str(_tail_spec, _tail_c_idx);

    if (n_arg != 0) {
        if (load8(n_arg) != 0) {
            var v = kriya_parse_nonneg_int(n_arg);
            if (v < 0) {
                syscall(1, 2, "kriya tail: error: --lines requires a non-negative integer\n", 59);
                return EXIT_USAGE;
            }
            limit = v;
            mode_bytes = 0;
        }
    }
    if (c_arg != 0) {
        if (load8(c_arg) != 0) {
            var v = kriya_parse_nonneg_int(c_arg);
            if (v < 0) {
                syscall(1, 2, "kriya tail: error: --bytes requires a non-negative integer\n", 59);
                return EXIT_USAGE;
            }
            limit = v;
            mode_bytes = 1;
        }
    }

    var npos = flags_positional_count(_tail_spec);
    var any_failed: i64 = 0;

    if (npos < 1) {
        if (verbose == 1) { _tail_emit_header("standard input", 1); }
        var r = _tail_emit_one(0, "standard input", mode_bytes, limit);
        if (r != 0) {
            _tail_report("(stdin)", 0 - r);
            any_failed = 1;
        }
        if (any_failed == 1) { return EXIT_FAILURE; }
        return EXIT_SUCCESS;
    }

    var show_headers: i64 = 0;
    if (npos > 1) { show_headers = 1; }
    if (verbose == 1) { show_headers = 1; }
    if (quiet == 1)   { show_headers = 0; }

    var i: i64 = 0;
    var first: i64 = 1;
    while (i < npos) {
        var p = flags_positional(_tail_spec, i);
        var fd: i64 = 0;
        var name: i64 = p;
        var is_stdin: i64 = 0;
        if (load8(p) == 45) {
            if (load8(p + 1) == 0) {
                fd = 0;
                is_stdin = 1;
                name = "standard input";
            }
        }
        if (is_stdin == 0) {
            fd = sys_open(p, 0, 0);
            if (fd < 0) {
                _tail_report(p, 0 - fd);
                any_failed = 1;
                i = i + 1;
                continue;
            }
        }
        if (show_headers == 1) { _tail_emit_header(name, first); }
        var r = _tail_emit_one(fd, name, mode_bytes, limit);
        if (r != 0) {
            _tail_report(name, 0 - r);
            any_failed = 1;
        }
        if (is_stdin == 0) { syscall(3, fd); }
        first = 0;
        i = i + 1;
    }

    if (any_failed == 1) { return EXIT_FAILURE; }
    return EXIT_SUCCESS;
}
