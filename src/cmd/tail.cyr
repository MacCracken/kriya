# tail — POSIX `tail(1)`: emit the last N lines/bytes of each input.
#
# Argument shape:
#   tail [opts] [file...]
#
# Flags:
#   -n / --lines=N    emit the last N lines (default 10).
#   -c / --bytes=N    emit the last N bytes.
#   -q / --quiet      never emit the `==> FILE <==` header.
#   -v / --verbose    always emit the header.
#
# Default: 10 lines. When neither `-q` nor `-v` is set, the header is
# emitted iff there is more than one file operand.
#
# Implementation: buffer the input (up to a 16 MiB cap) into memory,
# then scan backwards from EOF to find the Nth-from-last newline (for
# `-n`) or the byte at offset `size - N` (for `-c`). This is the
# straightforward path that works for both seekable files and pipes.
# A seek-back-from-end fast path for huge files is a clearly-named
# follow-up — see deferrals below. (roadmap 1.9.x)
#
# Cap: if input exceeds 16 MiB, the buffer is truncated to the LAST
# 16 MiB (head bytes discarded). For `-n N` this means the result is
# correct as long as N lines fit in the last 16 MiB; otherwise the
# user sees up to 16 MiB worth of trailing content. A warning to
# stderr is emitted when truncation happens.
#
# Deferred (each a named follow-up): (roadmap 1.8.2)
#   ⚠ `-f` itself SHIPPED at v0.5.0 (200ms stat-cadence poll loop, single file).
#     This block listed it as deferred until v1.2.0 — verified against the built  #skip-lint
#     binary, which follows a growing file correctly.
#   -f on MULTIPLE files     the single-file restriction is real and enforced;
#                            `tail -f a b` errors (see _tail_report_usage below).
#   -F                       --follow=name --retry compound.
#   -n +N / -c +N            start-from-line/byte semantics.
#   --pid=PID                terminate when PID exits (with -f).
#   k/M/G suffixes           on N — shared with head; one parser when extracted.
#   Seek-from-end fast path  for large seekable files (avoids the 16MB cap).

var _tail_spec  = 0;
var _tail_n_idx = 0;
var _tail_c_idx = 0;
var _tail_q_idx = 0;
var _tail_v_idx = 0;
var _tail_f_idx = 0;

var _TAIL_CAP_BYTES: i64 = 16777216;  # 16 MiB
var _TAIL_READ_BUFSZ: i64 = 65536;
var _TAIL_FOLLOW_POLL_MS: i64 = 200;   # poll interval for -f (200ms)

fn _tail_init_spec(): i64 {
    if (_tail_spec != 0) { return 0; }
    var s = flags_new();
    _tail_n_idx = flags_add_str(s,  110, "lines",   0, "emit last N lines (default 10)");
    _tail_c_idx = flags_add_str(s,  99,  "bytes",   0, "emit last N bytes");
    _tail_q_idx = flags_add_bool(s, 113, "quiet",   0, "suppress filename headers");
    _tail_v_idx = flags_add_bool(s, 118, "verbose", 0, "always emit filename headers");
    _tail_f_idx = flags_add_bool(s, 102, "follow",  0, "output new lines as the file grows");
    _tail_spec = s;
    tail_help_declare();
    return 0;
}

# Help/introspection record for `tail`. ⭐ Split out so `kriya --list` can
# populate it WITHOUT running the utility — one declaration feeding `--help`,
# `--help=json` and `--list` alike.
fn tail_help_declare(): i64 {
    help_begin("tail", "Print the last part of files.",
               "tail [OPTIONS] [FILE...]");
    help_positional(0, HELP_POS_UNBOUNDED, "FILE");
    help_operands("Defaults to 10 lines. ⚠ -f follows a single file by polling its path; multi-file follow is not supported.");  #skip-lint
    help_exit(1, "a file could not be read");
    help_example("tail -n 50 app.log");
    help_example("tail -f app.log");
    help_example("tail -c 200 blob.bin");
    return 0;
}

# ⭐ ONE LINE NOW. The 24-line body this replaces was byte-identical in every
# utility apart from the name; `errmsg_report` in `src/lib/report.cyr` is the
# single implementation of architecture 001's framing, and it shell-quotes the
# operand so a name containing a newline cannot split the diagnostic in two.
fn _tail_report(operand, errno): i64 { return errmsg_report("tail", operand, errno); }

fn _tail_emit_header(name, first): i64 {
    if (first == 0) { k_write( 1, "\n", 1); }
    k_write( 1, "==> ", 4);
    k_write( 1, name, strlen(name));
    k_write( 1, " <==\n", 5);
    return 0;
}

fn _tail_write_all(buf, n): i64 {
    var written: i64 = 0;
    while (written < n) {
        var w = k_write( 1, buf + written, n - written);
        if (w < 0) {
            if ((0 - w) == 4) {
                # EINTR — retry.
            } else { return w; }
        } else {
            written = written + w;
        }
    }
    return 0;
}

# Read all of `fd` into a heap buffer, capped at `_TAIL_CAP_BYTES`.
# When the cap is hit, the buffer holds the LAST cap-bytes (head is
# discarded). Returns (buf, size) via two store64 slots in `out_buf_size_pair`.
# `out_buf_size_pair` is a 24-byte record: ptr/size/truncated_flag.
fn _tail_slurp(fd, name, out): i64 {
    var cap = _TAIL_CAP_BYTES;
    var buf = alloc(cap);
    var have: i64 = 0;
    var truncated: i64 = 0;
    var read_buf = alloc(_TAIL_READ_BUFSZ);
    var loop: i64 = 1;
    while (loop == 1) {
        var n = k_read( fd, read_buf, _TAIL_READ_BUFSZ);
        if (n < 0) {
            if ((0 - n) == 4) {
                # EINTR — retry.
            } else { return n; }
        } else {
            if (n == 0) { loop = 0; }
            else {
                if (have + n <= cap) {
                    memcpy(buf + have, read_buf, n);
                    have = have + n;
                } else {
                    # Need to discard from the head to make room.
                    truncated = 1;
                    if (n >= cap) {
                        # New chunk alone exceeds cap: keep the last cap bytes of it.
                        memcpy(buf, read_buf + (n - cap), cap);
                        have = cap;
                    } else {
                        # Shift existing content left by `shift` bytes to make room.
                        var shift = (have + n) - cap;
                        var keep = have - shift;
                        # Move bytes [shift..have) → [0..keep)
                        var i: i64 = 0;
                        while (i < keep) {
                            store8(buf + i, load8(buf + shift + i));
                            i = i + 1;
                        }
                        memcpy(buf + keep, read_buf, n);
                        have = cap;
                    }
                }
            }
        }
    }
    if (truncated == 1) {
        k_write( 2, "kriya tail: ", 12);
        k_write( 2, name, strlen(name));
        k_write( 2, ": input exceeds 16 MiB buffer; showing last 16 MiB only\n", 56);
    }
    store64(out + 0, buf);
    store64(out + 8, have);
    store64(out + 16, truncated);
    return 0;
}

# Find the start byte-offset within `buf[0..size)` for the last `n` lines.
# A "line" ends at a newline; the final byte before EOF (if it's not a
# newline) still counts as part of the trailing partial line.
#
# Walk backwards from `size - 1`, counting newlines encountered. The
# starting position itself is NOT examined (the loop pre-decrements),
# so a trailing newline at `size - 1` is naturally skipped — the first
# newline the loop sees is the one separating the second-to-last line
# from the last. When we've encountered `n` newlines, the byte after
# the `n`-th one is the start of the last `n` lines. If the walk
# reaches offset 0 without finding `n` newlines, the entire buffer is
# fewer than `n` lines — return 0 (emit the whole input).
fn _tail_line_start(buf, size, n): i64 {
    if (n == 0)    { return size; }
    if (size == 0) { return 0; }
    var pos = size - 1;
    var found: i64 = 0;
    var done: i64 = 0;
    while (done == 0) {
        if (pos == 0) { done = 1; }
        else {
            pos = pos - 1;
            if (load8(buf + pos) == 10) {
                found = found + 1;
                if (found >= n) {
                    return pos + 1;
                }
            }
        }
    }
    return 0;
}

# --- follow mode (-f) ------------------------------------------------
#
# After the initial "last N" output, this loop polls the file every
# `_TAIL_FOLLOW_POLL_MS` ms via path-based `sys_stat`. When the size
# grows, the new bytes are read from the open fd (whose position is
# at the previous EOF after `_tail_emit_one`'s slurp) and emitted.
# When the size shrinks (truncation), we emit a `truncated` warning
# and lseek the fd back to 0 so the rewritten content shows up on
# the next read.
#
# Single-file -f only at first ship. Multi-file -f (with header
# switching) is a clear follow-up; stdin -f is silently downgraded (roadmap 1.8.2)
# to non-follow because we cannot seek/stat a pipe meaningfully.
#
# Termination: SIGINT (Ctrl-C) exits via the kernel default (exit
# 130) per arch note 002 — no handler installed.

fn _tail_follow(fd, name): i64 {
    # Initial size = current file size at this point. Anything past
    # this is "new content".
    var st[144];
    var sr = k_stat(name, &st);
    if (sr != 0) {
        _tail_report(name, 0 - sr);
        return sr;
    }
    var last_size = load64(&st + 48);  # st_size

    var buf = alloc(_TAIL_READ_BUFSZ);
    var loop: i64 = 1;
    while (loop == 1) {
        sleep_ms(_TAIL_FOLLOW_POLL_MS);

        var st2[144];
        var sr2 = k_stat(name, &st2);
        if (sr2 != 0) {
            # File vanished. Keep waiting; GNU's default tail -f
            # behaviour is to ignore disappearance until --retry/-F.
            # We do the same: continue polling.
        } else {
            var cur_size = load64(&st2 + 48);
            if (cur_size < last_size) {
                # Truncation. Emit warning to stderr and seek to 0.
                k_write( 2, "kriya tail: ", 12);
                k_write( 2, name, strlen(name));
                k_write( 2, ": file truncated\n", 17);
                # lseek(fd, 0, SEEK_SET) to re-read the rewritten file.
                # agnos has no lseek (K_HAVE_LSEEK == 0): fall back to
                # leaving the fd where it is — the read loop below still
                # streams forward from the current position. On Linux the
                # seek is behavior-neutral with the old syscall(8,...).
                if (K_HAVE_LSEEK == 1) {
                    k_lseek(fd, 0, 0);
                }
                last_size = 0;
                # Fall through to the "read new bytes" path with cur_size.
            }
            if (cur_size > last_size) {
                var to_read = cur_size - last_size;
                var done: i64 = 0;
                while (done == 0) {
                    var chunk = _TAIL_READ_BUFSZ;
                    if (to_read < chunk) { chunk = to_read; }
                    var n = k_read( fd, buf, chunk);
                    if (n < 0) {
                        if ((0 - n) == 4) {
                            # EINTR retry.
                        } else {
                            _tail_report(name, 0 - n);
                            done = 1;
                            loop = 0;
                        }
                    } else {
                        if (n == 0) {
                            # File grew per stat but read returns 0 —
                            # could be a race; just stop this round.
                            done = 1;
                        } else {
                            var wr = _tail_write_all(buf, n);
                            if (wr != 0) {
                                _tail_report(name, 0 - wr);
                                done = 1;
                                loop = 0;
                            } else {
                                to_read = to_read - n;
                                if (to_read <= 0) { done = 1; }
                            }
                        }
                    }
                }
                last_size = cur_size;
            }
        }
    }
    return 0;
}

fn _tail_emit_one(fd, name, mode_bytes, limit): i64 {
    var slurp[24];
    var r = _tail_slurp(fd, name, &slurp);
    if (r != 0) { return r; }
    var buf  = load64(&slurp + 0);
    var size = load64(&slurp + 8);

    var emit_off: i64 = 0;
    var emit_len: i64 = 0;
    if (mode_bytes == 1) {
        if (limit >= size) {
            emit_off = 0;
            emit_len = size;
        } else {
            emit_off = size - limit;
            emit_len = limit;
        }
    } else {
        emit_off = _tail_line_start(buf, size, limit);
        emit_len = size - emit_off;
    }
    if (emit_len > 0) {
        var wr = _tail_write_all(buf + emit_off, emit_len);
        if (wr != 0) { return wr; }
    }
    return 0;
}

fn cmd_tail(start: i64): i64 {
    _tail_init_spec();
    # 110 = 'n': the obsolescent bare-digit form. POSIX marks `head -5` / `tail -5`
    # obsolescent but every shell script in existence still uses it, and it is only
    # unambiguous here because neither utility registers a digit as a short option.
    # ⚠ FIRST ARGUMENT ONLY — `head -c 3 -5` is a usage error, as it is in GNU.
    # The expander enforces that and names the offender (`_kriya_obsnum_trailing`).
    if (kriya_args_parse_optval(_tail_spec, start, 110, "follow") != 0) {
        k_write( 2, "kriya tail: error: bad option (see ADR 0002 for accepted syntax)\n", 65);
        return EXIT_USAGE;
    }

    var quiet: i64 = 0;
    if (flags_get_bool(_tail_spec, _tail_q_idx) == 1) { quiet = 1; }
    var verbose: i64 = 0;
    if (flags_get_bool(_tail_spec, _tail_v_idx) == 1) { verbose = 1; }
    var follow: i64 = 0;
    if (flags_get_bool(_tail_spec, _tail_f_idx) == 1) { follow = 1; }
    # GNU's `--follow[=name|descriptor]`. The value used to be swallowed.
    # ⚠ kriya's follow is a stat-cadence poll on the PATH, so `=name` is exact
    # and `=descriptor` is an approximation — a file replaced under the same
    # name is followed either way, where GNU's `=descriptor` would stay with the
    # old fd. Accepted rather than refused because scripts pass it routinely and
    # the difference only shows under rotation; `-F` (the retry compound) stays
    # deferred. (roadmap 1.8.2)
    if (follow == 1) {
        var fv = kriya_long_value();
        if (fv != 0) {
            if (streq(fv, "name") == 1) { }
            elif (streq(fv, "descriptor") == 1) { }
            else {
                k_write( 2, "kriya tail: --follow: '", 23);
                k_write( 2, fv, strlen(fv));
                k_write( 2, "' is not a follow mode (use name or descriptor)\n", 48);
                return EXIT_USAGE;
            }
        }
    }

    var mode_bytes: i64 = 0;
    var limit: i64 = 10;

    var n_arg = flags_get_str(_tail_spec, _tail_n_idx);
    var c_arg = flags_get_str(_tail_spec, _tail_c_idx);

    if (n_arg != 0) {
        if (load8(n_arg) != 0) {
            var v = kriya_parse_nonneg_int(n_arg);
            if (v < 0) {
                k_write( 2, "kriya tail: error: --lines requires a non-negative integer\n", 59);
                return EXIT_USAGE;
            }
            limit = v;
            mode_bytes = 0;
        }
    }
    if (c_arg != 0) {
        if (load8(c_arg) != 0) {
            var v = kriya_parse_nonneg_int(c_arg);
            if (v < 0) {
                k_write( 2, "kriya tail: error: --bytes requires a non-negative integer\n", 59);
                return EXIT_USAGE;
            }
            limit = v;
            mode_bytes = 1;
        }
    }

    var npos = flags_positional_count(_tail_spec);
    var any_failed: i64 = 0;

    # Multi-file follow is a separate codepath (per-file polling + header
    # switching). First ship rejects it cleanly; single-file -f works.
    if (follow == 1) {
        if (npos > 1) {
            k_write( 2, "kriya tail: error: multi-file --follow not yet supported (single file only)\n", 76);  # roadmap 1.8.2  #skip-lint
            return EXIT_USAGE;
        }
    }

    if (npos < 1) {
        if (verbose == 1) { _tail_emit_header("standard input", 1); }
        var r = _tail_emit_one(0, "standard input", mode_bytes, limit);
        if (r != 0) {
            _tail_report("(stdin)", 0 - r);
            any_failed = 1;
        }
        # -f on stdin: silently downgrade. We can't sys_stat a pipe
        # by path, and tail -f on stdin is a no-op once the writer
        # closes (POSIX behaviour).
        if (any_failed == 1) { return EXIT_FAILURE; }
        return EXIT_SUCCESS;
    }

    var show_headers: i64 = 0;
    if (npos > 1) { show_headers = 1; }
    if (verbose == 1) { show_headers = 1; }
    if (quiet == 1)   { show_headers = 0; }

    var i: i64 = 0;
    var first: i64 = 1;
    while (i < npos) {
        var p = flags_positional(_tail_spec, i);
        var fd: i64 = 0;
        var name: i64 = p;
        var is_stdin: i64 = 0;
        if (load8(p) == 45) {
            if (load8(p + 1) == 0) {
                fd = 0;
                is_stdin = 1;
                name = "standard input";
            }
        }
        if (is_stdin == 0) {
            fd = k_open(p, 0, 0);
            if (fd < 0) {
                _tail_report(p, 0 - fd);
                any_failed = 1;
                i = i + 1;
                continue;
            }
        }
        if (show_headers == 1) { _tail_emit_header(name, first); }
        var r = _tail_emit_one(fd, name, mode_bytes, limit);
        if (r != 0) {
            _tail_report(name, 0 - r);
            any_failed = 1;
        }
        # Follow mode: after the initial output, poll for growth.
        # Skipped for stdin since pipes don't have a stat-able path.
        if (follow == 1) {
            if (is_stdin == 0) {
                _tail_follow(fd, name);
                # _tail_follow only returns on read/write error or
                # SIGINT (handled by kernel default → exit 130).
            }
        }
        if (is_stdin == 0) { k_close( fd); }
        first = 0;
        i = i + 1;
    }

    if (any_failed == 1) { return EXIT_FAILURE; }
    return EXIT_SUCCESS;
}
