# true — POSIX `true(1)`: do nothing, exit 0.
# Args ignored per POSIX (true takes none, but extras must not fail).
fn cmd_true(start: i64): i64 {
    true_help_declare();
    help_if_requested(0, start);
    return EXIT_SUCCESS;
}

# Help/introspection record for `true`. ⭐ Split out so `kriya --list` can
# populate it WITHOUT running the utility — one declaration feeding `--help`,
# `--help=json` and `--list` alike.
fn true_help_declare(): i64 {
    help_begin("true", "Do nothing, successfully.",
               "true [ignored...]");
    help_positional(0, HELP_POS_UNBOUNDED, "IGNORED");
    help_no_options();
    help_example("true && echo ok");
    return 0;
}
