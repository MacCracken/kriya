# grep — POSIX `grep(1)`: search for lines matching a pattern.
#
# Argument shape:
#   grep [opts] PATTERN [FILE...]
#   grep [opts] -e PATTERN [-f FILE] [FILE...]
#
# Pattern flavors (per ADR 0005):
#   default      POSIX BRE via niyama_bre_*
#   -E / -E      POSIX ERE via niyama_re2_*
#   -G           alias for default (BRE)
#   -F           fixed-string byte scan, no engine
#   -P           not supported in v1.0 — usage error (see ADR 0005)
#
# Pattern source:
#   positional[0]    when no -e and no -f
#   -e PATTERN       repeatable; every -e contributes a pattern (shipped 1.2.1,
#                    via `kriya_argv_collect` — see CHANGELOG)
#   -f FILE          patterns from file, one per line (full multi-pattern path)
#
# Modifier flags:
#   -i   ASCII case-insensitive (pattern + input pre-folded for BRE/-F;
#        `(?i)` inline-prefix for RE2 per ADR 0005)
#   -v   invert: emit lines that DO NOT match
#   -w   word-boundary: match must be flanked by non-[A-Za-z0-9_] (or BOL/EOL)
#   -x   whole-line: match must span the entire line
#   -c   per-file match count instead of matching lines
#   -l   list filenames with at least one match (per-file)
#   -L   list filenames with NO matches (per-file)
#   -n   prefix each emit with `LINENO:`
#   -q   quiet: exit on first match, no output
#   -A N / -B N / -C N   trailing / leading / both context around each match
#   -Z   NUL after each FILE NAME (pairs with `xargs -0`, like `find -print0`)
#
# Context rules, each verified against GNU rather than inferred:
#   * a CONTEXT line's field separator is `-`; a MATCHING line's is `:`. That is
#     the only marker distinguishing them inside a block.
#   * `--` separates NON-CONTIGUOUS groups, and appears between FILES too.
#   * `grep -C 0` still separates; a plain `grep` never does. The trigger is
#     "a context option was supplied", not "the value is nonzero" — which is why
#     the spec defaults are (0 - 1) rather than 0.
#   * overlapping windows MERGE into one block, with no separator.
#   * an explicit -A or -B overrides the -C that set both.
#   * -c / -l / -L / -q / -o ignore context (GNU ignores rather than erroring).
#
# ⚠ GNU's `-NUM` shorthand (`grep -3` for `-C 3`) is NOT implemented. It needs a
# bare `-DIGIT` to be read as an option rather than an operand — the same shape
# `seq -5` handles with a dedicated argv walk — and grep goes through the shared
# parser, where a digit is not a registered short. Deferred, roadmap 1.4.x.
#   -s   suppress filesystem-error messages
#   -h / -H   filename header control (auto when 2+ operands or -r)
#   -o   emit only the matched substring(s) on each matching line
#   -r / -R   recurse into directory operands; never follow symlinks
#   -z   NUL-separated input + output
#
# Exit codes:
#   0   at least one line matched (or, for -L, at least one file had no matches)
#   1   no matches
#   2   usage error or no patterns supplied

# --- Globals -------------------------------------------------------------

var _grep_spec    = 0;
var _gr_i_idx     = 0;
var _gr_v_idx     = 0;
var _gr_w_idx     = 0;
var _gr_x_idx     = 0;
var _gr_c_idx     = 0;
var _gr_l_idx     = 0;
var _gr_L_idx     = 0;
var _gr_n_idx     = 0;
var _gr_q_idx     = 0;
var _gr_s_idx     = 0;
var _gr_h_idx     = 0;
var _gr_H_idx     = 0;
var _gr_o_idx     = 0;
var _gr_r_idx     = 0;
var _gr_R_idx     = 0;
var _gr_z_idx     = 0;
var _gr_E_idx     = 0;
var _gr_G_idx     = 0;
var _gr_F_idx     = 0;
var _gr_P_idx     = 0;
var _gr_e_idx     = 0;
var _gr_f_idx     = 0;
var _gr_A_idx     = 0;
var _gr_B_idx     = 0;
var _gr_C_idx     = 0;
var _gr_Z_idx     = 0;
var _gr_inc_idx   = 0;
var _gr_exc_idx   = 0;

var _gr_read_buf  = 0;
var _gr_line_buf  = 0;
var _gr_fold_buf  = 0;
var _GR_READ_SZ   = 65536;
var _GR_LINE_SZ   = 65536;

# Engine kinds.
enum GrepEng {
    GR_ENG_BRE   = 0,
    GR_ENG_RE2   = 1,
    GR_ENG_FIXED = 2,
}

# Pattern handle layout (40 bytes):
#   0  : engine kind (GrepEng)
#   8  : nfa pointer (0 for fixed-string)
#   16 : pattern bytes pointer (raw or folded)
#   24 : pattern length
#   32 : fold flag (1 if pre-folded for -i + BRE/F)

fn _gr_init_spec(): i64 {
    if (_grep_spec != 0) { return 0; }
    var s = flags_new();
    _gr_i_idx = flags_add_bool(s, 105, "ignore-case",       0, "ASCII case-insensitive match");
    _gr_v_idx = flags_add_bool(s, 118, "invert-match",      0, "emit non-matching lines");
    _gr_w_idx = flags_add_bool(s, 119, "word-regexp",       0, "match must be flanked by non-word");
    _gr_x_idx = flags_add_bool(s, 120, "line-regexp",       0, "match must span the entire line");
    _gr_c_idx = flags_add_bool(s, 99,  "count",             0, "print match count per file");
    _gr_l_idx = flags_add_bool(s, 108, "files-with-matches",0, "print filenames with matches");
    _gr_L_idx = flags_add_bool(s, 76,  "files-without-match",0,"print filenames without matches");
    _gr_n_idx = flags_add_bool(s, 110, "line-number",       0, "prefix each line with line number");
    _gr_q_idx = flags_add_bool(s, 113, "quiet",             0, "no output; exit code only");
    _gr_s_idx = flags_add_bool(s, 115, "no-messages",       0, "suppress filesystem error messages");
    _gr_h_idx = flags_add_bool(s, 104, "no-filename",       0, "never prefix filename");
    _gr_H_idx = flags_add_bool(s, 72,  "with-filename",     0, "always prefix filename");
    _gr_o_idx = flags_add_bool(s, 111, "only-matching",     0, "emit only the matched substring");
    _gr_r_idx = flags_add_bool(s, 114, "recursive",         0, "recurse into directory operands");
    _gr_R_idx = flags_add_bool(s, 82,  "dereference-recursive", 0, "alias for -r (no symlink follow either)");
    _gr_z_idx = flags_add_bool(s, 122, "null-data",         0, "NUL-separated input + output");
    _gr_E_idx = flags_add_bool(s, 69,  "extended-regexp",   0, "ERE pattern (via niyama_re2)");
    _gr_G_idx = flags_add_bool(s, 71,  "basic-regexp",      0, "BRE pattern (default)");
    _gr_F_idx = flags_add_bool(s, 70,  "fixed-strings",     0, "literal-string match (no regex)");
    _gr_P_idx = flags_add_bool(s, 80,  "perl-regexp",       0, "PCRE (rejected in v1.0 per ADR 0005)");
    _gr_e_idx = flags_add_str(s,  101, "regexp",            0, "pattern (overrides positional[0])");
    _gr_A_idx = flags_add_int(s,  65,  "after-context",     (0 - 1), "print NUM lines after each match");
    _gr_B_idx = flags_add_int(s,  66,  "before-context",    (0 - 1), "print NUM lines before each match");
    _gr_C_idx = flags_add_int(s,  67,  "context",           (0 - 1), "print NUM lines before and after");
    _gr_inc_idx = flags_add_str(s,  0, "include",  0, "admit files matching GLOB (rightmost --include/--exclude wins)");
    _gr_exc_idx = flags_add_str(s,  0, "exclude",  0, "skip files matching GLOB (rightmost --include/--exclude wins)");
    _gr_Z_idx = flags_add_bool(s, 90,  "null",              0, "NUL after each file name (pairs with xargs -0)");
    _gr_f_idx = flags_add_str(s,  102, "file",              0, "read patterns from file, one per line");
    _grep_spec = s;
    grep_help_declare();
    return 0;
}

# Help/introspection record for `grep`. ⭐ Split out so `kriya --list` can
# populate it WITHOUT running the utility — one declaration feeding `--help`,
# `--help=json` and `--list` alike.
fn grep_help_declare(): i64 {
    help_begin("grep", "Search files for lines matching a pattern.",
               "grep [OPTIONS] PATTERN [FILE...]");
    help_positional(0, HELP_POS_UNBOUNDED, "PATTERN,FILE");
    help_operands("PATTERN is an operand only when neither -e nor -f supplies it. BRE by default; -E for ERE, -F for fixed strings. ⚠ Context lines print with `-` where matching lines print `:`, and `--` separates non-adjacent groups. ⚠ -r skips symlinks (ADR 0003). -P is rejected (ADR 0005). GNU's -NUM shorthand is not implemented (roadmap 1.4.x). ⚠ --include/--exclude: the RIGHTMOST matching one wins, and a name matching neither is decided by the FIRST option's type — so `--exclude=X --include=*.c` searches everything while `--include=*.c --exclude=X` searches only .c files. Under -r the glob sees the BASE NAME (a pattern with `/` never matches); for a command-line operand it sees the path as typed and each `/`-suffix. Directories are never filtered.");  #skip-lint
    help_exit(0, "at least one line matched");
    help_exit(1, "no line matched");
    help_exit(2, "an error occurred");
    help_example("grep -n TODO src/*.cyr");  #skip-lint
    help_example("grep -r -i error logs/");
    help_example("grep -e a -e b file");
    help_example("grep -C 2 -n panic server.log");
    help_example("grep -r --include=*.c --exclude=*_test.c panic src/");
    help_example("grep -rlZ TODO src/ | xargs -0 wc -l");  #skip-lint
    return 0;
}

fn _gr_read_get(): i64 {
    if (_gr_read_buf != 0) { return _gr_read_buf; }
    _gr_read_buf = alloc(_GR_READ_SZ);
    return _gr_read_buf;
}

fn _gr_line_get(): i64 {
    if (_gr_line_buf != 0) { return _gr_line_buf; }
    _gr_line_buf = alloc(_GR_LINE_SZ);
    return _gr_line_buf;
}

fn _gr_fold_get(): i64 {
    if (_gr_fold_buf != 0) { return _gr_fold_buf; }
    _gr_fold_buf = alloc(_GR_LINE_SZ);
    return _gr_fold_buf;
}

# --- Error reporting ----------------------------------------------------

fn _gr_report(operand, errno, suppress): i64 {
    if (suppress == 1) { return 0; }
    k_write( 2, "kriya grep: ", 12);
    k_write( 2, operand, strlen(operand));
    k_write( 2, ": ", 2);
    if (errmsg_is_known(errno) == 1) {
        var m = errmsg_for(errno);
        k_write( 2, m, strlen(m));
    } else {
        k_write( 2, "errno ", 6);
        var buf[8];
        var i: i64 = 7;
        store8(&buf + i, 0);
        i = i - 1;
        var v = errno;
        if (v == 0) { store8(&buf + i, 48); i = i - 1; }
        while (v > 0) {
            store8(&buf + i, 48 + (v - (v / 10) * 10));
            v = v / 10;
            i = i - 1;
        }
        k_write( 2, &buf + i + 1, 6 - i);
    }
    k_write( 2, "\n", 1);
    return 0;
}

# Render decimal `v` into buf. Returns byte count.
fn _gr_render_dec(v, buf): i64 {
    if (v == 0) { store8(buf, 48); return 1; }
    var tmp[32];
    var n: i64 = 0;
    var rem = v;
    while (rem > 0) {
        store8(&tmp + n, 48 + (rem - (rem / 10) * 10));
        rem = rem / 10;
        n = n + 1;
    }
    var i: i64 = 0;
    while (i < n) {
        store8(buf + i, load8(&tmp + n - 1 - i));
        i = i + 1;
    }
    return n;
}

fn _gr_emit_dec(v): i64 {
    var buf[32];
    var n = _gr_render_dec(v, &buf);
    k_write( 1, &buf, n);
    return 0;
}

# --- Case fold helpers --------------------------------------------------
#
# ⭐ Lifted to `src/lib/icase.cyr` at 1.4.5. The old local pair (a byte fold
# plus a pattern fold that lower-cased every unescaped byte) was correct for
# literals and quietly wrong for bracket expressions: lower-casing the TEXT
# `[[:upper:]]` leaves it unchanged, so against a lower-cased subject it matched
# NOTHING where GNU matches every alphabetic line. ⚠ `find -iregex` folds both
# sides the same way and had the same bug, which is what makes this shared code
# rather than a grep-local fix.

# Set by `_gr_compile` when the pattern rewrite fails, so the caller can say
# WHICH pattern rule was broken instead of a flat "bad pattern".
var _gr_icase_err = 0;

# --- Engine compile + match --------------------------------------------

# Allocate a 40-byte handle.
fn _gr_handle_new(kind, nfa, pat, pat_len, fold): i64 {
    var h = alloc(40);
    store64(h + 0,  kind);
    store64(h + 8,  nfa);
    store64(h + 16, pat);
    store64(h + 24, pat_len);
    store64(h + 32, fold);
    return h;
}

# 1 if `pat` contains no character that is special in EITHER BRE or ERE, so it
# means the same thing as a literal byte string under both.
#
# ⛔ WITHOUT THIS, A PLAIN WORD COMPILED TO AN NFA AND THE NFA ATE THE HEAP.
# Measured: `grep -c "line 000005"` over a 13.6 MB file SEGFAULTS under
# `ulimit -v 1048576` — roughly 320 bytes retained per input byte — while GNU
# answers in constant memory. The pattern is a literal; nothing about it needed
# a regex engine.
#
# ⭐ Routing to `GR_ENG_FIXED` is behaviour-preserving, not an approximation:
# `-F` is already a full citizen of the match path. Verified that `-w`, `-x`,
# `-i`, `-o`, `-v` and `-c` produce identical output on both engines, so the only
# thing that changes is which matcher runs underneath.
#
# ⚠ The set is the UNION of both dialects, deliberately over-broad. `+` and `?`
# are literal in BRE and special in ERE; treating them as special everywhere
# costs one NFA compile for `grep "a+b"` and removes a whole class of
# "which dialect am I in" reasoning from the fast path. A false negative here is
# a missed optimisation; a false positive would be a wrong answer.
fn _gr_is_literal(pat, pat_len): i64 {
    var i: i64 = 0;
    while (i < pat_len) {
        var c = load8(pat + i);
        if (c == 46)  { return 0; }    # .
        if (c == 42)  { return 0; }    # *
        if (c == 43)  { return 0; }    # +
        if (c == 63)  { return 0; }    # ?
        if (c == 91)  { return 0; }    # [
        if (c == 93)  { return 0; }    # ]
        if (c == 94)  { return 0; }    # ^
        if (c == 36)  { return 0; }    # $
        if (c == 40)  { return 0; }    # (
        if (c == 41)  { return 0; }    # )
        if (c == 123) { return 0; }    # {
        if (c == 125) { return 0; }    # }
        if (c == 124) { return 0; }    # |
        if (c == 92)  { return 0; }    # backslash
        i = i + 1;
    }
    return 1;
}

# Compile one pattern under the chosen engine flag set. Returns handle or 0.
# `engine_flag`: 0=BRE, 1=RE2, 2=fixed. `ignore_case`: 1 if -i.
fn _gr_compile(pat, engine_flag, ignore_case): i64 {
    _gr_icase_err = ICASE_OK;
    var pat_len = strlen(pat);
    # ⛔ Checked on EVERY regex pattern, with or without `-i`. See the note on
    # `icase_scan_unsupported`: refusing only under `-i` would leave the same
    # pattern loud one way and silently wrong the other.
    if (engine_flag != GR_ENG_FIXED) {
        var uns = icase_scan_unsupported(pat, pat_len);
        if (uns != ICASE_OK) {
            _gr_icase_err = uns;
            return 0;
        }
        # ⛔ And validate bracket RANGES on the no-`-i` path, which nothing did
        # before. niyama accepts a reversed range and silently matches nothing —
        # or, for `[a-c-e]`, silently matches the WRONG FIVE lines. Refusing
        # only under `-i` would leave the identical pattern loud one way and
        # silently wrong the other, the same trap `icase_scan_unsupported`
        # exists to avoid. ⚠ The verdict is kept; the rewritten pattern is not.
        if (ignore_case == 0) {
            var vlen: i64 = 0;
            var verr: i64 = ICASE_OK;
            if (icase_rewrite(pat, pat_len, ICASE_RANGE_PLAIN, &vlen, &verr) == 0) {
                _gr_icase_err = verr;
                return 0;
            }
        }
    }
    # A metacharacter-free pattern is a literal in every dialect — take the byte
    # scanner and skip the NFA entirely. See `_gr_is_literal`.
    var eff_engine = engine_flag;
    if (eff_engine != GR_ENG_FIXED) {
        if (_gr_is_literal(pat, pat_len) == 1) { eff_engine = GR_ENG_FIXED; }
    }
    if (eff_engine == GR_ENG_FIXED) {
        if (ignore_case == 1) {
            var folded_len: i64 = 0;
            var folded = alloc(pat_len + 1);
            icase_fold_bytes(pat, folded, pat_len);
            store8(folded + pat_len, 0);
            return _gr_handle_new(GR_ENG_FIXED, 0, folded, pat_len, 1);
        }
        return _gr_handle_new(GR_ENG_FIXED, 0, pat, pat_len, 0);
    }
    if (eff_engine == GR_ENG_RE2) {
        # Prepend (?i) for case-insensitive — niyama_re2 honors the inline flag.
        # ⚠ But only for LITERALS: measured, `(?i)` case-closes a RANGE and does
        # NOT touch a NAMED CLASS, so `-E -i '[[:upper:]]'` matched upper case
        # only. The bracket expressions are rewritten closed-under-case first,
        # which also supplies the range validation `(?i)` never did.
        var compile_pat = pat;
        if (ignore_case == 1) {
            var rw_len: i64 = 0;
            var rw = icase_rewrite(pat, pat_len, ICASE_MODE_CLOSED, &rw_len, &_gr_icase_err);
            if (rw == 0) { return 0; }
            pat = rw;
            pat_len = rw_len;
            var buf = alloc(pat_len + 5);
            store8(buf + 0, 40);   # (
            store8(buf + 1, 63);   # ?
            store8(buf + 2, 105);  # i
            store8(buf + 3, 41);   # )
            var k: i64 = 0;
            while (k < pat_len) {
                store8(buf + 4 + k, load8(pat + k));
                k = k + 1;
            }
            store8(buf + 4 + pat_len, 0);
            compile_pat = buf;
        }
        var nfa = niyama_re2_compile(compile_pat);
        if (nfa == 0) { return 0; }
        return _gr_handle_new(GR_ENG_RE2, nfa, compile_pat, strlen(compile_pat), 0);
    }
    # BRE
    var use_pat = pat;
    var use_len = pat_len;
    var fold = 0;
    if (ignore_case == 1) {
        var fl: i64 = 0;
        use_pat = icase_rewrite(pat, pat_len, ICASE_MODE_FOLD, &fl, &_gr_icase_err);
        if (use_pat == 0) { return 0; }
        use_len = fl;
        fold = 1;
    }
    var bnfa = niyama_bre_compile(use_pat);
    if (bnfa == 0) { return 0; }
    return _gr_handle_new(GR_ENG_BRE, bnfa, use_pat, use_len, fold);
}

# Run `handle` against `line` (len bytes). Returns match start offset, or
# -1 if no match. `match_end_ptr`, if non-zero, receives the match end
# offset (exclusive) for -o support.
fn _gr_search(handle, line, len, match_end_ptr): i64 {
    var kind = load64(handle + 0);
    if (kind == GR_ENG_FIXED) {
        var pat = load64(handle + 16);
        var plen = load64(handle + 24);
        if (plen == 0) {
            if (match_end_ptr != 0) { store64(match_end_ptr, 0); }
            return 0;
        }
        if (plen > len) { return 0 - 1; }
        var i: i64 = 0;
        var limit = len - plen;
        while (i <= limit) {
            var k: i64 = 0;
            var ok: i64 = 1;
            while (ok == 1) {
                if (k == plen) { ok = 2; }
                else {
                    if (load8(line + i + k) != load8(pat + k)) { ok = 0; }
                    else { k = k + 1; }
                }
            }
            if (ok == 2) {
                if (match_end_ptr != 0) { store64(match_end_ptr, i + plen); }
                return i;
            }
            i = i + 1;
        }
        return 0 - 1;
    }
    var nfa = load64(handle + 8);
    if (kind == GR_ENG_RE2) {
        var p = niyama_re2_search_at(nfa, line, len, 0);
        if (p >= 0) {
            if (match_end_ptr != 0) {
                var e = niyama_re2_group_end(nfa, 0);
                if (e < 0) { e = p; }
                store64(match_end_ptr, e);
            }
        }
        return p;
    }
    # BRE
    var bp = niyama_bre_search_at(nfa, line, len, 0);
    if (bp >= 0) {
        if (match_end_ptr != 0) {
            var be = niyama_bre_group_end(nfa, 0);
            if (be < 0) { be = bp; }
            store64(match_end_ptr, be);
        }
    }
    return bp;
}

# --- Word + whole-line wrappers ----------------------------------------

fn _gr_is_word_byte(c): i64 {
    if (c >= 48 && c <= 57)  { return 1; }
    if (c >= 65 && c <= 90)  { return 1; }
    if (c >= 97 && c <= 122) { return 1; }
    if (c == 95)             { return 1; }
    return 0;
}

# Iterate matches across the line. For each match, the caller's check
# (word/whole-line) decides whether to accept. Returns 1 (line matches),
# 0 (no acceptable match), and writes the first accepted match's
# (start, end) into the out-pointers when non-zero. `from_ptr` may be
# non-zero to continue iteration (used by -o multi-match emit).
fn _gr_check_line(handles, n_handles, line, len, word_mode, xline_mode,
                  match_start_ptr, match_end_ptr, from): i64 {
    var h_i: i64 = 0;
    while (h_i < n_handles) {
        var handle = vec_get(handles, h_i);
        var pos = from;
        var done: i64 = 0;
        while (done == 0) {
            var me: i64 = 0;
            var ms: i64 = 0;
            ms = _gr_search_at(handle, line, len, pos, &me);
            if (ms < 0) { done = 1; }
            else {
                var ok: i64 = 1;
                if (word_mode == 1) {
                    if (ms > 0) {
                        if (_gr_is_word_byte(load8(line + ms - 1)) == 1) { ok = 0; }
                    }
                    if (me < len) {
                        if (_gr_is_word_byte(load8(line + me)) == 1) { ok = 0; }
                    }
                }
                if (xline_mode == 1) {
                    if (ms != 0)    { ok = 0; }
                    if (me != len)  { ok = 0; }
                }
                if (ok == 1) {
                    if (match_start_ptr != 0) { store64(match_start_ptr, ms); }
                    if (match_end_ptr != 0)   { store64(match_end_ptr, me); }
                    return 1;
                }
                # Move past this match start to keep looking for an
                # acceptable one further along the line.
                pos = ms + 1;
                if (pos > len) { done = 1; }
            }
        }
        h_i = h_i + 1;
    }
    return 0;
}

# Wrapper that searches from offset `from` instead of always 0.
fn _gr_search_at(handle, line, len, from, match_end_ptr): i64 {
    var kind = load64(handle + 0);
    if (kind == GR_ENG_FIXED) {
        var pat = load64(handle + 16);
        var plen = load64(handle + 24);
        if (plen == 0) {
            if (match_end_ptr != 0) { store64(match_end_ptr, from); }
            return from;
        }
        if (from + plen > len) { return 0 - 1; }
        var i: i64 = from;
        var limit = len - plen;
        while (i <= limit) {
            var k: i64 = 0;
            var ok: i64 = 1;
            while (ok == 1) {
                if (k == plen) { ok = 2; }
                else {
                    if (load8(line + i + k) != load8(pat + k)) { ok = 0; }
                    else { k = k + 1; }
                }
            }
            if (ok == 2) {
                if (match_end_ptr != 0) { store64(match_end_ptr, i + plen); }
                return i;
            }
            i = i + 1;
        }
        return 0 - 1;
    }
    var nfa = load64(handle + 8);
    if (kind == GR_ENG_RE2) {
        var p = niyama_re2_search_at(nfa, line, len, from);
        if (p >= 0) {
            if (match_end_ptr != 0) {
                var e = niyama_re2_group_end(nfa, 0);
                if (e < 0) { e = p; }
                store64(match_end_ptr, e);
            }
        }
        return p;
    }
    var bp = niyama_bre_search_at(nfa, line, len, from);
    if (bp >= 0) {
        if (match_end_ptr != 0) {
            var be = niyama_bre_group_end(nfa, 0);
            if (be < 0) { be = bp; }
            store64(match_end_ptr, be);
        }
    }
    return bp;
}

# --- Emit helpers -------------------------------------------------------

# Emit `name:` prefix (or `name:LINENO:`) when needed. Uses the configured
# field separator (`:` or `-` for context lines — but we don't ship context).
# `sep` is the byte that follows each prefix field: ':' on a MATCHING line and
# '-' on a CONTEXT line. That distinction is the only thing telling a reader
# which lines inside a context block actually matched, so it is not cosmetic.
#
# ⚠ `-Z` replaces the byte after the FILE NAME only — never the one after the
# line number. Verified against GNU: `grep -HnZ` emits `f\0 3 : line`, so a
# consumer splitting on NUL gets the name while one reading the rest still sees
# the match-vs-context marker.
# --- Context ring (-A / -B / -C) ---------------------------------------
#
# ⭐ SLOTS GROW BY DOUBLING RATHER THAN BEING SIZED FOR THE WORST CASE. A ring of
# `before_ctx` slots each big enough for grep's 64 KiB line cap would be 6.4 MB
# at `-B 100` and 640 MB at `-B 10000`, for input whose lines are almost always
# short. Each slot instead starts at 256 bytes and doubles when a longer line
# arrives, so memory tracks the content actually seen. ⚠ The superseded buffer
# is not reclaimed — `alloc` is a bump allocator — but doubling makes the total
# discarded per slot smaller than the slot's final size, which is the standard
# geometric bound.
#
# ⚠ Deliberately NOT capping `-B`: a cap is a silent divergence the day someone
# passes a bigger number, and the growth policy above makes one unnecessary.
#
# Slot layout (32 B): +0 buf, +8 cap, +16 len, +24 lineno.
var _GR_CTX_SLOT = 32;
var _GR_CTX_MIN  = 256;

var _gr_ring      = 0;   # slot array
var _gr_ring_cap  = 0;   # number of slots (= before_ctx)
var _gr_ring_n    = 0;   # slots currently filled (<= cap)
var _gr_ring_head = 0;   # index of the OLDEST buffered line

# Has anything been emitted yet in this grep run? ⚠ Spans FILES: GNU prints a
# `--` between the last group of one file and the first of the next, so this
# cannot be reset per file.
var _gr_ctx_emitted = 0;
# Last line number emitted for the CURRENT file; 0 = nothing yet.
var _gr_ctx_last    = 0;

fn _gr_ring_init(before): i64 {
    _gr_ring_cap  = before;
    _gr_ring_n    = 0;
    _gr_ring_head = 0;
    if (before <= 0) { return 0; }
    if (_gr_ring != 0) { return 0; }
    _gr_ring = alloc(before * _GR_CTX_SLOT);
    var i: i64 = 0;
    while (i < before) {
        store64(_gr_ring + i * _GR_CTX_SLOT, 0);
        store64(_gr_ring + i * _GR_CTX_SLOT + 8, 0);
        i = i + 1;
    }
    return 0;
}

# Remember `line` as possible leading context, evicting the oldest when full.
fn _gr_ring_push(line, len, lineno): i64 {
    if (_gr_ring_cap <= 0) { return 0; }
    var idx = _gr_ring_head;
    if (_gr_ring_n < _gr_ring_cap) {
        idx = (_gr_ring_head + _gr_ring_n) % _gr_ring_cap;
        _gr_ring_n = _gr_ring_n + 1;
    } else {
        _gr_ring_head = (_gr_ring_head + 1) % _gr_ring_cap;
    }
    var sp = _gr_ring + idx * _GR_CTX_SLOT;
    var cap = load64(sp + 8);
    if (cap < len) {
        var want = _GR_CTX_MIN;
        while (want < len) { want = want * 2; }
        store64(sp, alloc(want));
        store64(sp + 8, want);
    }
    if (len > 0) { memcpy(load64(sp), line, len); }
    store64(sp + 16, len);
    store64(sp + 24, lineno);
    return 0;
}

fn _gr_ring_clear(): i64 {
    _gr_ring_n = 0;
    _gr_ring_head = 0;
    return 0;
}

# Line number of the oldest buffered line, or `fallback` when empty.
fn _gr_ring_first_lineno(fallback): i64 {
    if (_gr_ring_n <= 0) { return fallback; }
    return load64(_gr_ring + _gr_ring_head * _GR_CTX_SLOT + 24);
}

# ⛔ `--` GOES BETWEEN NON-CONTIGUOUS GROUPS, AND ONLY WHEN A CONTEXT FLAG WAS
# GIVEN. `grep -C 0` still separates (verified against GNU) while a plain
# `grep` never does — so the trigger is "the option was supplied", not "the
# value is nonzero".
fn _gr_ctx_gap(first_line, term): i64 {
    if (_gr_ctx_emitted == 0) { return 0; }
    var contiguous: i64 = 0;
    if (_gr_ctx_last > 0) {
        if (first_line <= _gr_ctx_last + 1) { contiguous = 1; }
    }
    if (contiguous == 1) { return 0; }
    k_write( 1, "--", 2);
    var tb[2];
    store8(&tb, term);
    k_write( 1, &tb, 1);
    return 0;
}

# --- --include / --exclude ---------------------------------------------
#
# ⛔ THREE RULES HERE ARE NOT WHAT A CAREFUL READING WOULD GUESS, and a first
# implementation got all three wrong while passing a nine-case test — because
# none of those cases discriminated them. All measured against GNU:
#
#  1. ⛔ PRECEDENCE IS RIGHTMOST-WINS, not "exclude beats include". A later
#     `--include` re-admits a file an earlier `--exclude` rejected:
#       --include='*.h' --exclude='a.c' --include='*.c'   searches a.c.
#
#  2. ⛔ THE DEFAULT FOR AN UNMATCHED NAME IS SET BY THE FIRST OPTION'S TYPE.
#     If the first is an --include, unmatched names are skipped; if the first is
#     an --exclude, they are searched. So putting --exclude before --include
#     silently destroys the "only these files" meaning of --include:
#       --include='*.c' --exclude='zzz'   searches only .c files
#       --exclude='zzz' --include='*.c'   searches EVERYTHING
#     Same two options, order swapped, opposite result.
#
#  3. ⛔ THE SUBJECT DIFFERS BY HOW GREP REACHED THE FILE. Under -r descent the
#     glob sees the BASE NAME only, so a pattern containing '/' can never match.
#     For a file named on the COMMAND LINE it sees the operand as typed and
#     every trailing part beginning after a '/', so `--exclude='sub/c.c'` and
#     `--exclude='c.c'` both skip the operand `sub/c.c`. The identical file is
#     therefore filtered differently depending on how it was found.
#
# ⚠ Also measured: directories are exempt entirely (never pruned, always
# descended — that is `--exclude-dir`, not shipped, roadmap 1.4.x); stdin is
# never filtered; and an excluded operand that cannot be OPENED still reports
# its error and exits 2, because filtering happens after the open attempt.
enum GrFilterKind {
    GR_FILT_INCLUDE = 1,
    GR_FILT_EXCLUDE = 2,
}
var _gr_filt_kind = 0;   # vec of GR_FILT_*
var _gr_filt_pat  = 0;   # vec of cstr, parallel
var _gr_filt_n    = 0;
var _gr_filt_first = 0;  # kind of the FIRST option given; 0 = none given

# Collect the two options IN COMMAND-LINE ORDER. ⚠ `kriya_argv_collect` gathers
# one option name at a time and so loses the interleaving, which rules 1 and 2
# both depend on — hence a dedicated walk.
fn _gr_filter_init(): i64 {
    _gr_filt_kind = vec_new();
    _gr_filt_pat  = vec_new();
    _gr_filt_n    = 0;
    _gr_filt_first = 0;
    var n = kriya_argv_count();
    var flat = kriya_argv_flat();
    var i: i64 = 1;
    while (i < n) {
        var tok = load64(flat + i * 8);
        var tlen = strlen(tok);
        var kind: i64 = 0;
        var pat: i64 = 0;
        if (tlen >= 9) {
            if (_seq_bytes_eq(tok, "--include", 9) == 1) { kind = GR_FILT_INCLUDE; }
            if (_seq_bytes_eq(tok, "--exclude", 9) == 1) { kind = GR_FILT_EXCLUDE; }
        }
        if (kind != 0) {
            # ⚠ `--exclude-dir` also starts with `--exclude`; it is a DIFFERENT
            # option and must not be swallowed here.
            if (tlen > 9) {
                if (load8(tok + 9) == 61) { pat = tok + 10; }
                else { kind = 0; }
            } else {
                i = i + 1;
                if (i < n) { pat = load64(flat + i * 8); }
            }
        }
        if (kind != 0) {
            if (pat != 0) {
                vec_push(_gr_filt_kind, kind);
                vec_push(_gr_filt_pat, pat);
                _gr_filt_n = _gr_filt_n + 1;
                if (_gr_filt_first == 0) { _gr_filt_first = kind; }
            }
        }
        i = i + 1;
    }
    return 0;
}

# Does `pat` match `subject`? `whole_path == 1` selects the command-line rule:
# the operand as typed, plus every suffix starting after a '/'.
fn _gr_filt_hit(pat, subject, whole_path): i64 {
    var plen = strlen(pat);
    if (whole_path == 0) {
        var base = path_basename_ptr(subject);
        return glob_match(pat, plen, base, strlen(base));
    }
    var slen = strlen(subject);
    if (glob_match(pat, plen, subject, slen) == 1) { return 1; }
    var i: i64 = 0;
    while (i < slen) {
        if (load8(subject + i) == 47) {
            if (glob_match(pat, plen, subject + i + 1, slen - i - 1) == 1) { return 1; }
        }
        i = i + 1;
    }
    return 0;
}

# 1 when the file should be searched.
fn _gr_name_allowed(path, whole_path): i64 {
    if (_gr_filt_n == 0) { return 1; }
    # Rightmost match decides.
    var decided: i64 = 0;
    var i: i64 = 0;
    while (i < _gr_filt_n) {
        if (_gr_filt_hit(vec_get(_gr_filt_pat, i), path, whole_path) == 1) {
            decided = vec_get(_gr_filt_kind, i);
        }
        i = i + 1;
    }
    if (decided == GR_FILT_INCLUDE) { return 1; }
    if (decided == GR_FILT_EXCLUDE) { return 0; }
    # Nothing matched: the FIRST option's type sets the default.
    if (_gr_filt_first == GR_FILT_INCLUDE) { return 0; }
    return 1;
}

fn _gr_emit_prefix2(name, show_name, show_line, lineno, sep, null_fname): i64 {
    if (show_name == 1) {
        k_write( 1, name, strlen(name));
        var sb[2];
        if (null_fname == 1) { store8(&sb, 0); }
        else { store8(&sb, sep); }
        k_write( 1, &sb, 1);
    }
    if (show_line == 1) {
        _gr_emit_dec(lineno);
        var lb[2];
        store8(&lb, sep);
        k_write( 1, &lb, 1);
    }
    return 0;
}

fn _gr_emit_prefix(name, show_name, show_line, lineno): i64 {
    return _gr_emit_prefix2(name, show_name, show_line, lineno, 58, 0);
}

# --- Pattern intake -----------------------------------------------------

# Append each newline-separated pattern in `buf` (`len` bytes) to vec
# `out`. Skips a single empty pattern at EOF (matches GNU). Returns 0.
fn _gr_split_patterns(buf, len, out): i64 {
    var i: i64 = 0;
    var start: i64 = 0;
    while (i < len) {
        if (load8(buf + i) == 10) {
            var slen = i - start;
            var s = alloc(slen + 1);
            if (slen > 0) { memcpy(s, buf + start, slen); }
            store8(s + slen, 0);
            vec_push(out, s);
            start = i + 1;
        }
        i = i + 1;
    }
    if (start < len) {
        var rlen = len - start;
        var r = alloc(rlen + 1);
        memcpy(r, buf + start, rlen);
        store8(r + rlen, 0);
        vec_push(out, r);
    }
    return 0;
}

# Read entire `path` into a freshly-alloc'd buffer. Returns (ptr, length
# via *out_len), or -errno via negative return when out_len is unused.
fn _gr_slurp(path, out_len_ptr): i64 {
    var fd = k_open(path, 0, 0);
    if (fd < 0) { return fd; }
    var cap: i64 = 4096;
    var buf = alloc(cap);
    var used: i64 = 0;
    var loop: i64 = 1;
    while (loop == 1) {
        if (used + 4096 > cap) {
            var newcap = cap * 2;
            var newbuf = alloc(newcap);
            memcpy(newbuf, buf, used);
            buf = newbuf;
            cap = newcap;
        }
        var n = k_read( fd, buf + used, 4096);
        if (n < 0) {
            if ((0 - n) == 4) {
                # EINTR — retry.
            } else {
                k_close( fd);
                return n;
            }
        } else {
            if (n == 0) { loop = 0; }
            else { used = used + n; }
        }
    }
    k_close( fd);
    store64(out_len_ptr, used);
    return buf;
}

# --- File processing ---------------------------------------------------

# Process one fd as a stream. Returns 1 if any line matched (post-invert),
# 0 if none. On read error, reports + returns -errno (negated for caller).
# `name` is the display name (or 0 for no-name mode; required when
# show_name is 1).
fn _gr_process_fd(fd, name, handles, n_handles, opts, term_byte): i64 {
    var invert      = load64(opts + 0);
    var word_mode   = load64(opts + 8);
    var xline_mode  = load64(opts + 16);
    var count_mode  = load64(opts + 24);
    var list_match  = load64(opts + 32);   # -l
    var list_nomatch= load64(opts + 40);   # -L
    var show_name   = load64(opts + 48);
    var show_lineno = load64(opts + 56);
    var quiet_mode  = load64(opts + 64);
    var only_match  = load64(opts + 72);   # -o
    var before_ctx  = load64(opts + 80);   # -B
    var after_ctx   = load64(opts + 88);   # -A
    var ctx_active  = load64(opts + 96);   # any of -A/-B/-C supplied
    var null_fname  = load64(opts + 104);  # -Z

    var read_buf = _gr_read_get();
    # ⚠ Reset only the per-FILE half. `_gr_ctx_emitted` spans files so a `--`
    # can separate the last group of one from the first of the next.
    _gr_ctx_last = 0;
    _gr_ring_clear();
    var after_left: i64 = 0;
    var line_buf = _gr_line_get();
    var fold_buf = _gr_fold_get();
    var fold_active = load64(handles + 0);  # 0 here is a flag stored separately
    fold_active = load64(opts + 80);        # 1 if BRE/F with -i (caller computes)

    var line_len: i64 = 0;
    var lineno:   i64 = 0;
    var matches:  i64 = 0;
    var any_match: i64 = 0;
    var truncated_warned: i64 = 0;
    var loop: i64 = 1;
    var early_exit: i64 = 0;
    # Single-byte line-terminator scratch buffer. term_byte is a constant
    # parameter, so fill it once here and reuse &tb at every emit site
    # (Cyrius hoists branch-local `var`s to the enclosing scope, so per-site
    # redeclaration would collide as a duplicate variable).
    var tb[2]; store8(&tb, term_byte);
    while (loop == 1) {
        var n = k_read( fd, read_buf, _GR_READ_SZ);
        if (n < 0) {
            if ((0 - n) == 4) {
                # EINTR — retry.
            } else { return n; }
        } else {
            var consume_last: i64 = 0;
            if (n == 0) {
                # EOF — flush trailing line.
                if (line_len > 0) { consume_last = 1; }
                loop = 0;
            }
            var bi: i64 = 0;
            var done_chunk: i64 = 0;
            while (done_chunk == 0) {
                var have_line: i64 = 0;
                if (consume_last == 1) {
                    have_line = 1;
                    consume_last = 0;
                    done_chunk = 1;
                } else {
                    if (bi >= n) { done_chunk = 1; }
                    else {
                        var b = load8(read_buf + bi);
                        if (b == term_byte) {
                            have_line = 1;
                            bi = bi + 1;
                        } else {
                            if (line_len < _GR_LINE_SZ - 1) {
                                store8(line_buf + line_len, b);
                                line_len = line_len + 1;
                            } else {
                                if (truncated_warned == 0) {
                                    k_write( 2, "kriya grep: warning: line exceeds 64 KiB; truncating\n", 53);
                                    truncated_warned = 1;
                                }
                            }
                            bi = bi + 1;
                        }
                    }
                }
                if (have_line == 1) {
                    lineno = lineno + 1;
                    # Apply -i input fold if engine demands it.
                    var search_buf = line_buf;
                    if (fold_active == 1) {
                        icase_fold_bytes(line_buf, fold_buf, line_len);
                        search_buf = fold_buf;
                    }
                    var ms: i64 = 0;
                    var me: i64 = 0;
                    var matched = _gr_check_line(handles, n_handles, search_buf, line_len,
                                                 word_mode, xline_mode, &ms, &me, 0);
                    if (invert == 1) {
                        if (matched == 1) { matched = 0; } else { matched = 1; }
                    }
                    if (matched == 1) {
                        matches = matches + 1;
                        any_match = 1;
                        if (quiet_mode == 1) {
                            early_exit = 1;
                            done_chunk = 1;
                            loop = 0;
                        } elif (list_match == 1) {
                            k_write( 1, name, strlen(name));
                            # ⚠ Under -Z the NUL REPLACES the terminator, it is
                            # not added to it: GNU emits `f\0f2\0` with no
                            # newline anywhere, which is what `xargs -0` wants.
                            var lz[2];
                            if (null_fname == 1) { store8(&lz, 0); }
                            else { store8(&lz, term_byte); }
                            k_write( 1, &lz, 1);
                            early_exit = 1;
                            done_chunk = 1;
                            loop = 0;
                        } elif (list_nomatch == 1) {
                            # -L: matching means "this file does NOT qualify";
                            # we can early-exit since we just need to know
                            # there was a match.
                            early_exit = 1;
                            done_chunk = 1;
                            loop = 0;
                        } elif (count_mode == 1) {
                            # No emit yet — total flushed at file end.
                        } elif (only_match == 1) {
                            # -o: emit each match substring on its own line,
                            # walking the line for additional matches. Note
                            # the first (ms, me) is already valid.
                            var op: i64 = 0;
                            var cur_ms = ms;
                            var cur_me = me;
                            var more: i64 = 1;
                            while (more == 1) {
                                _gr_emit_prefix(name, show_name, show_lineno, lineno);
                                # Emit raw bytes (not folded) from line_buf.
                                if (cur_me > cur_ms) {
                                    k_write( 1, line_buf + cur_ms, cur_me - cur_ms);
                                }
                                k_write( 1, &tb, 1);
                                # Advance past this match to find the next.
                                var next_from = cur_me;
                                if (next_from == cur_ms) { next_from = cur_ms + 1; }
                                if (next_from > line_len) { more = 0; }
                                else {
                                    var nm: i64 = 0;
                                    var ne: i64 = 0;
                                    var got = _gr_check_line(handles, n_handles, search_buf,
                                                             line_len, word_mode, xline_mode,
                                                             &nm, &ne, next_from);
                                    if (got == 1) { cur_ms = nm; cur_me = ne; }
                                    else { more = 0; }
                                }
                            }
                        } elif (ctx_active == 1) {
                            # Leading context first: the buffered lines are the
                            # group's opening, so the `--` decision is made from
                            # the OLDEST of them, not from the matching line.
                            _gr_ctx_gap(_gr_ring_first_lineno(lineno), term_byte);
                            var ri: i64 = 0;
                            while (ri < _gr_ring_n) {
                                var sp = _gr_ring + ((_gr_ring_head + ri) % _gr_ring_cap) * _GR_CTX_SLOT;
                                _gr_emit_prefix2(name, show_name, show_lineno,
                                                 load64(sp + 24), 45, null_fname);
                                var sl = load64(sp + 16);
                                if (sl > 0) { k_write( 1, load64(sp), sl); }
                                k_write( 1, &tb, 1);
                                ri = ri + 1;
                            }
                            _gr_ring_clear();
                            _gr_emit_prefix2(name, show_name, show_lineno, lineno, 58, null_fname);
                            if (line_len > 0) { k_write( 1, line_buf, line_len); }
                            k_write( 1, &tb, 1);
                            _gr_ctx_last = lineno;
                            _gr_ctx_emitted = 1;
                            after_left = after_ctx;
                        } else {
                            _gr_emit_prefix2(name, show_name, show_lineno, lineno, 58, null_fname);
                            if (line_len > 0) {
                                k_write( 1, line_buf, line_len);
                            }
                            k_write( 1, &tb, 1);
                        }
                    } elif (ctx_active == 1) {
                        # Not a match. Either it is trailing context for the
                        # group just emitted, or it becomes leading context for
                        # a group that may not arrive.
                        if (after_left > 0) {
                            _gr_emit_prefix2(name, show_name, show_lineno, lineno, 45, null_fname);
                            if (line_len > 0) { k_write( 1, line_buf, line_len); }
                            k_write( 1, &tb, 1);
                            after_left = after_left - 1;
                            _gr_ctx_last = lineno;
                            _gr_ctx_emitted = 1;
                        } else {
                            _gr_ring_push(line_buf, line_len, lineno);
                        }
                    }
                    line_len = 0;
                }
            }
        }
    }
    # Per-file count emit.
    if (early_exit == 0) {
        if (count_mode == 1) {
            if (quiet_mode == 0) {
                if (show_name == 1) {
                    k_write( 1, name, strlen(name));
                    # ⚠ Here the NUL replaces the ':' separator and the trailing
                    # newline STAYS — unlike -l above, where it replaces the
                    # terminator. GNU: `f\0 2 \n`.
                    var cz[2];
                    if (null_fname == 1) { store8(&cz, 0); }
                    else { store8(&cz, 58); }
                    k_write( 1, &cz, 1);
                }
                _gr_emit_dec(matches);
                k_write( 1, &tb, 1);
            }
        } elif (list_nomatch == 1) {
            # -L: emit name only if NO matches were seen.
            if (any_match == 0) {
                if (quiet_mode == 0) {
                    k_write( 1, name, strlen(name));
                    var Lz[2];
                    if (null_fname == 1) { store8(&Lz, 0); }
                    else { store8(&Lz, term_byte); }
                    k_write( 1, &Lz, 1);
                }
            }
        }
    }
    if (any_match == 1) { return 1; }
    if (list_nomatch == 1) {
        # -L "matched" means the file qualified (no internal match).
        return 1 - any_match;
    }
    return 0;
}

# Recursive directory walk. Each regular file under the entry
# (`parent_dirfd`, `dir_name`) is grepped; symlinks are skipped per ADR 0003.
# `dir_path` is the accumulated path, carried for DIAGNOSTICS AND agnos ONLY.
# Returns 1 if any match anywhere, 0 otherwise.
#
# ⛔ THE DESCENT IS FROM A PARENT FD, NOT BY PATH — AND IT DID NOT USED TO BE.
# Every level re-opened the accumulated path with `fs_openat(AT_FDCWD, …)`, so
# each descent re-resolved every ancestor component. Replace a directory with a
# symlink to `/etc` mid-walk and the walk follows it out of the tree and greps
# whatever it lands on, reporting the hits under the ORIGINAL path. `O_NOFOLLOW`
# on the file open was no defence: it guards the final component only.
#
# `rm`, `cp` and `find` have descended from a parent fd since M2 (ADR 0003 hard
# rule); `grep -r` was the one recursive walk still doing it by path, and the M8
# audit's per-file O_NOFOLLOW mitigation hid how much was left open.
fn _gr_walk_dir(parent_dirfd, dir_name, dir_path, handles, n_handles, opts, term_byte, suppress): i64 {
    var dir_fd = fs_open_entry_dir(parent_dirfd, dir_path, dir_name);
    if (dir_fd < 0) {
        _gr_report(dir_path, 0 - dir_fd, suppress);
        return 0;
    }
    var found_any: i64 = 0;
    var dent_buf = alloc(4096);
    var loop: i64 = 1;
    while (loop == 1) {
        var nb = fs_getdents64(dir_fd, dent_buf, 4096);
        if (nb < 0) {
            if ((0 - nb) == 4) {
                # EINTR — retry.
            } else {
                _gr_report(dir_path, 0 - nb, suppress);
                fs_close(dir_fd);
                return found_any;
            }
        } else {
            if (nb == 0) { loop = 0; }
            else {
                var off: i64 = 0;
                while (off < nb) {
                    var ent = dent_buf + off;
                    var reclen = fs_dent_reclen(ent);
                    var name = fs_dent_name(ent);
                    var is_dd = fs_dent_is_dotdot(ent);
                    if (is_dd == 0) {
                        var st[144];  # 144 bytes (18 i64 slots)
                        # Built BEFORE the stat: `fs_stat_entry`'s agnos arm needs
                        # the full path (no dirfd-relative stat there), and every
                        # diagnostic below wants it too.
                        var nlen = strlen(name);
                        var dlen = strlen(dir_path);
                        var sep = 1;
                        if (dlen > 0) {
                            if (load8(dir_path + dlen - 1) == 47) { sep = 0; }
                        }
                        var sub = alloc(dlen + sep + nlen + 1);
                        memcpy(sub, dir_path, dlen);
                        if (sep == 1) { store8(sub + dlen, 47); }
                        memcpy(sub + dlen + sep, name, nlen);
                        store8(sub + dlen + sep + nlen, 0);
                        var r = fs_stat_entry(dir_fd, sub, name, &st, 0);
                        if (r == 0) {
                            if (fs_is_dir(&st) == 1) {
                                if (_gr_walk_dir(dir_fd, name, sub, handles, n_handles,
                         opts, term_byte, suppress) == 1) {
                                    found_any = 1;
                                }
                            } elif (fs_is_reg(&st) == 1) {
                                # M8 mitigation: O_NOFOLLOW (131072) to close
                                # the TOCTOU window between lstat-classify and
                                # this open. If the regular file was swapped
                                # for a symlink, ELOOP — we report and skip
                                # rather than leak the target's bytes.
                                # See CVE-2026-35359 in uutils-coreutils.
                                var fd = fs_open_entry_file(dir_fd, sub, name);
                                if (fd < 0) {
                                    _gr_report(sub, 0 - fd, suppress);
                                } else {
                                    # ⚠ Filter here, not at emit time: a file
                                    # excluded by name must not be opened or
                                    # counted, and must not affect the exit
                                    # status.
                                    var pr: i64 = 0;
                                    if (_gr_name_allowed(sub, 0) == 1) {
                                        pr = _gr_process_fd(fd, sub, handles, n_handles, opts, term_byte);
                                    } else {
                                        k_close(fd);
                                    }
                                    k_close( fd);
                                    if (pr < 0) { _gr_report(sub, 0 - pr, suppress); }
                                    elif (pr == 1) { found_any = 1; }
                                }
                            }
                            # Skip symlinks (ADR 0003) and other types.
                        }
                    }
                    off = off + reclen;
                }
            }
        }
    }
    fs_close(dir_fd);
    return found_any;
}

# --- Entry point --------------------------------------------------------

fn cmd_grep(start: i64): i64 {
    _gr_init_spec();
    if (kriya_args_parse(_grep_spec, start) != 0) {
        k_write( 2, "kriya grep: error: bad option (see ADR 0002 for accepted syntax)\n", 65);
        return EXIT_USAGE;
    }

    # -P is rejected per ADR 0005.
    if (flags_get_bool(_grep_spec, _gr_P_idx) == 1) {
        k_write( 2, "kriya grep: -P (PCRE) is not supported; use -E for extended regex\n", 66);
        return EXIT_USAGE;
    }

    # Engine selection. -E and -F are exclusive; -G is the BRE default.
    var want_E = flags_get_bool(_grep_spec, _gr_E_idx);
    var want_F = flags_get_bool(_grep_spec, _gr_F_idx);
    if (want_E + want_F > 1) {
        k_write( 2, "kriya grep: error: -E and -F are mutually exclusive\n", 52);
        return EXIT_USAGE;
    }
    var engine: i64 = GR_ENG_BRE;
    if (want_E == 1) { engine = GR_ENG_RE2; }
    if (want_F == 1) { engine = GR_ENG_FIXED; }

    var ignore_case = flags_get_bool(_grep_spec, _gr_i_idx);
    var invert      = flags_get_bool(_grep_spec, _gr_v_idx);
    var word_mode   = flags_get_bool(_grep_spec, _gr_w_idx);
    var xline_mode  = flags_get_bool(_grep_spec, _gr_x_idx);
    var count_mode  = flags_get_bool(_grep_spec, _gr_c_idx);
    var list_match  = flags_get_bool(_grep_spec, _gr_l_idx);
    var list_nomatch= flags_get_bool(_grep_spec, _gr_L_idx);
    var lineno_mode = flags_get_bool(_grep_spec, _gr_n_idx);
    var quiet_mode  = flags_get_bool(_grep_spec, _gr_q_idx);
    var suppress    = flags_get_bool(_grep_spec, _gr_s_idx);
    var name_no     = flags_get_bool(_grep_spec, _gr_h_idx);
    var name_force  = flags_get_bool(_grep_spec, _gr_H_idx);
    var only_match  = flags_get_bool(_grep_spec, _gr_o_idx);
    var rec_mode    = flags_get_bool(_grep_spec, _gr_r_idx) | flags_get_bool(_grep_spec, _gr_R_idx);
    var zero_term   = flags_get_bool(_grep_spec, _gr_z_idx);
    var term_byte: i64 = 10;
    if (zero_term == 1) { term_byte = 0; }

    # Collect patterns: -e first, then -f, then positional[0].
    var patterns = vec_new();
    # ⛔ EVERY `-e`, NOT JUST THE LAST. `grep -e alpha -e gamma` used to match only
    # `gamma` — the spec has one value slot, so earlier patterns were overwritten
    # during parsing with no diagnostic and exit 0. grep's matcher has always been
    # multi-pattern (that is how `-f` works); only the collection was lossy.
    var e_count = kriya_argv_collect(101, "regexp", patterns);
    var e_arg: i64 = 0;
    if (e_count == 0) { e_arg = flags_get_str(_grep_spec, _gr_e_idx); }
    if (e_arg != 0) {
        if (load8(e_arg) != 0 || strlen(e_arg) == 0) {
            # Even empty -e is a valid pattern (matches every position).
            vec_push(patterns, e_arg);
        }
    }
    var f_arg = flags_get_str(_grep_spec, _gr_f_idx);
    if (f_arg != 0) {
        if (load8(f_arg) != 0) {
            var flen: i64 = 0;
            var fbuf = _gr_slurp(f_arg, &flen);
            if (fbuf < 0) {
                _gr_report(f_arg, 0 - fbuf, suppress);
                return EXIT_USAGE;
            }
            _gr_split_patterns(fbuf, flen, patterns);
        }
    }

    var first_positional_is_pattern = 0;
    var npos = flags_positional_count(_grep_spec);
    if (vec_len(patterns) == 0) {
        # No -e/-f: positional[0] is the pattern.
        if (npos < 1) {
            k_write( 2, "kriya grep: error: no pattern (provide PATTERN or -e or -f)\n", 60);
            return EXIT_USAGE;
        }
        vec_push(patterns, flags_positional(_grep_spec, 0));
        first_positional_is_pattern = 1;
    }
    if (vec_len(patterns) == 0) {
        # -f was empty and no positional pattern. POSIX: an empty pattern
        # file means no patterns; every line is a non-match.
        # Continue (return code will reflect zero matches).
    }

    # Compile each pattern.
    var handles = vec_new();
    var pi: i64 = 0;
    var np = vec_len(patterns);
    while (pi < np) {
        var p = vec_get(patterns, pi);
        var h = _gr_compile(p, engine, ignore_case);
        if (h == 0) {
            # ⚠ Name the rule that was broken. "bad pattern" alone sent readers
            # looking for a typo when the real answer was a range GNU also
            # refuses, or a construct niyama does not implement.
            if (_gr_icase_err == ICASE_E_RANGE) {
                k_write( 2, "kriya grep: error: invalid range end in: ", 41);
            } elif (_gr_icase_err == ICASE_E_EQUIV) {
                k_write( 2, "kriya grep: error: niyama implements no [=c=] / [.c.] in: ", 58);
            } elif (_gr_icase_err == ICASE_E_BRACKET) {
                k_write( 2, "kriya grep: error: unterminated [ in: ", 38);
            } else {
                k_write( 2, "kriya grep: error: bad pattern: ", 32);
            }
            k_write( 2, p, strlen(p));
            k_write( 2, "\n", 1);
            return EXIT_USAGE;
        }
        vec_push(handles, h);
        pi = pi + 1;
    }
    var n_handles = vec_len(handles);

    # Decide whether input pre-fold is needed.
    #
    # ⛔ DERIVED FROM THE HANDLES, NOT FROM THE INVOCATION FLAG. `engine` is what
    # the user asked for (`-E`/`-F`/`-G`); `_gr_compile` may legitimately choose
    # something else per pattern, because a metacharacter-free pattern is routed
    # to the fixed engine regardless of dialect. Keying off `engine` meant
    # `grep -i -E foo` folded the PATTERN (fixed-engine behaviour) but not the
    # INPUT (RE2 behaviour) and silently stopped matching `FOO BAR` — a wrong
    # answer with exit 0, caught by the smoke suite the moment the fast path
    # landed.
    #
    # ⚠ Folding the input is safe for an RE2 handle in the mixed case: the fold
    # is ASCII and length-preserving, so match offsets still line up for `-o`,
    # and `(?i)` matches a folded input fine. The printed line is always the
    # original, never the folded copy.
    var fold_active: i64 = 0;
    if (ignore_case == 1) {
        if (engine == GR_ENG_BRE) { fold_active = 1; }
        var fh: i64 = 0;
        while (fh < n_handles) {
            if (load64(vec_get(handles, fh)) == GR_ENG_FIXED) { fold_active = 1; }
            fh = fh + 1;
        }
    }

    # Compute file operand list (positional after the pattern slot).
    var file_start: i64 = 0;
    if (first_positional_is_pattern == 1) { file_start = 1; }
    var n_files = npos - file_start;

    # Filename display rules:
    #   -h forces off; -H forces on; otherwise on when (n_files >= 2 OR -r/-R).
    var show_name: i64 = 0;
    if (n_files >= 2) { show_name = 1; }
    if (rec_mode == 1) { show_name = 1; }
    if (name_force == 1) { show_name = 1; }
    if (name_no == 1)    { show_name = 0; }
    if (list_match == 1) { show_name = 1; }
    if (list_nomatch == 1) { show_name = 1; }

    # Pack options into a 96-byte block to keep the helper signatures sane.
    var opts = alloc(128);
    store64(opts + 0,  invert);
    store64(opts + 8,  word_mode);
    store64(opts + 16, xline_mode);
    store64(opts + 24, count_mode);
    store64(opts + 32, list_match);
    store64(opts + 40, list_nomatch);
    store64(opts + 48, show_name);
    store64(opts + 56, lineno_mode);
    store64(opts + 64, quiet_mode);
    store64(opts + 72, only_match);
    # ⛔ `-C N` is shorthand for `-A N -B N`, and an EXPLICIT -A or -B wins over it
    # — GNU resolves `-C 5 -A 1` to one line after and five before. Reading -C
    # first and letting the specific flags overwrite gives that for free.
    var ctx_active: i64 = 0;
    var before_ctx: i64 = 0;
    var after_ctx:  i64 = 0;
    # ⚠ The spec default is (0 - 1), i.e. "not supplied" — distinct from an
    # explicit 0, which still activates the `--` separator. A plain 0 default
    # could not tell `grep -C 0` from `grep`.
    var c_val = flags_get_int(_grep_spec, _gr_C_idx);
    var b_val = flags_get_int(_grep_spec, _gr_B_idx);
    var a_val = flags_get_int(_grep_spec, _gr_A_idx);
    if (c_val >= 0) {
        ctx_active = 1;
        before_ctx = c_val;
        after_ctx  = c_val;
    }
    if (b_val >= 0) {
        ctx_active = 1;
        before_ctx = b_val;
    }
    if (a_val >= 0) {
        ctx_active = 1;
        after_ctx = a_val;
    }
    if (before_ctx < 0) { before_ctx = 0; }
    if (after_ctx  < 0) { after_ctx  = 0; }
    # ⚠ Context is meaningless for the modes that do not emit lines, and GNU
    # ignores it there rather than erroring. -o emits substrings, not lines.
    if (count_mode == 1)  { ctx_active = 0; }
    if (list_match == 1)  { ctx_active = 0; }
    if (list_nomatch == 1){ ctx_active = 0; }
    if (quiet_mode == 1)  { ctx_active = 0; }
    if (only_match == 1)  { ctx_active = 0; }
    if (ctx_active == 0)  { before_ctx = 0; after_ctx = 0; }
    _gr_filter_init();
    _gr_ring_init(before_ctx);
    store64(opts + 80, before_ctx);
    store64(opts + 88, after_ctx);
    store64(opts + 96, ctx_active);
    store64(opts + 104, flags_get_bool(_grep_spec, _gr_Z_idx));
    store64(opts + 80, fold_active);

    var any_match: i64 = 0;
    var any_failed: i64 = 0;

    if (n_files == 0) {
        # Stdin mode.
        if (rec_mode == 1) {
            k_write( 2, "kriya grep: error: -r requires file operands\n", 45);
            return EXIT_USAGE;
        }
        var r = _gr_process_fd(0, "(standard input)", handles, n_handles, opts, term_byte);
        if (r < 0) { _gr_report("(standard input)", 0 - r, suppress); any_failed = 1; }
        elif (r == 1) { any_match = 1; }
    } else {
        var fi: i64 = 0;
        while (fi < n_files) {
            var name = flags_positional(_grep_spec, file_start + fi);
            var is_stdin: i64 = 0;
            if (load8(name) == 45) {
                if (load8(name + 1) == 0) { is_stdin = 1; }
            }
            if (is_stdin == 1) {
                var rr = _gr_process_fd(0, "(standard input)", handles, n_handles, opts, term_byte);
                if (rr < 0) { _gr_report("(standard input)", 0 - rr, suppress); any_failed = 1; }
                elif (rr == 1) { any_match = 1; }
            } else {
                # stat to decide file vs directory
                var st[144];
                var lr = fs_lstat_at(0 - 100, name, &st);
                if (lr < 0) {
                    _gr_report(name, 0 - lr, suppress);
                    any_failed = 1;
                } elif (fs_is_dir(&st) == 1) {
                    if (rec_mode == 1) {
                        # Top level: AT_FDCWD + the operand. A symlinked operand
                        # never reaches here — the lstat above classifies it as
                        # a non-directory.
                        if (_gr_walk_dir(0 - 100, name, name, handles, n_handles, opts, term_byte, suppress) == 1) {
                            any_match = 1;
                        }
                    } else {
                        if (suppress == 0) {
                            k_write( 2, "kriya grep: ", 12);
                            k_write( 2, name, strlen(name));
                            k_write( 2, ": Is a directory\n", 17);
                        }
                        any_failed = 1;
                    }
                } elif (_gr_name_allowed(name, 1) == 0) {
                    # ⚠ GNU applies --include/--exclude to files named EXPLICITLY
                    # on the command line, not only to those found under -r.
                    # Measured: `grep --include='*.c' -l hit a.c b.h` reports
                    # only a.c. A filtered operand is silently skipped — not an
                    # error, and it does not affect the exit status.
                    var skipped: i64 = 0;
                } else {
                    var fd = k_open(name, 0, 0);
                    if (fd < 0) {
                        _gr_report(name, 0 - fd, suppress);
                        any_failed = 1;
                    } else {
                        var pr = _gr_process_fd(fd, name, handles, n_handles, opts, term_byte);
                        k_close( fd);
                        if (pr < 0) { _gr_report(name, 0 - pr, suppress); any_failed = 1; }
                        elif (pr == 1) { any_match = 1; }
                    }
                }
            }
            fi = fi + 1;
        }
    }

    # GNU exit-code policy: 0 if any match, 1 if no match, 2 on error
    # (subsumes usage and filesystem errors when -s is not set). With -s,
    # filesystem errors don't bump the code to 2 — they just go silent.
    if (any_failed == 1) {
        if (suppress == 0) { return 2; }
    }
    if (any_match == 1) { return 0; }
    return 1;
}
