# printf — POSIX `printf(1)`: formatted text output.
#
# Argument shape:
#   printf FORMAT [ARGUMENT...]
#
# Conversions (this ship):
#   %d / %i    signed decimal integer
#   %u         unsigned decimal (i64 reinterpreted)
#   %o         unsigned octal
#   %x / %X    unsigned hex (lower/upper)
#   %c         first byte of the argument
#   %s         string
#   %b         string with `\\…` escape processing (POSIX printf-specific)
#   %%         literal `%`
#
# Flags:
#   -          left-justify within width
#   +          always emit sign on signed conversions
#   ` `        space before non-negative on signed conversions
#   #          alternate form: `0x` / `0X` prefix for `%x`/`%X`, leading
#              `0` for `%o`
#   0          zero-pad (ignored if `-` or precision given on ints)
#
# Width / precision: literal digits (`%5d`, `%.3s`) and `*` to consume
# the next argument as an integer (`%*d`, `%.*s`, `%*.*d`).
#
# Escape sequences in FORMAT (always honored — printf processes them
# directly, unlike most utilities where `\n` in arg is literal):
#   \\  \a (07)  \b (08)  \e (1b)  \f (0c)  \n (0a)  \r (0d)  \t (09)
#   \v (0b)  \"  \NNN (1-3 octal digits)  \xHH (1-2 hex digits)
#   \c    cancel the rest of the output and exit 0
#
# ⭐ The table itself lives in `src/lib/str.cyr` and is called from BOTH escape
# paths here — see that file's header for the six divergences from GNU that two
# separate copies had accumulated. ⚠ The paths differ in ONE rule and it is
# passed as a mode bit: a FORMAT `\0101` is `\010` then a literal `1`, while a
# `%b` operand reads the `0` as a PREFIX and gets `A`. Both match GNU.
#
# **Argument reuse**: when args exceed format specifiers, the FORMAT
# is reapplied from the start until args are exhausted (POSIX). When
# args are short, missing args default to 0 / "".
#
# Deferred (each named follow-up): (roadmap 1.8.0)
#   %e / %E / %f / %F / %g / %G / %a / %A   floating-point conversions.
#     Cyrius's float-printing story isn't settled, and most script
#     usage hits `%d`/`%s`. Defer until a real consumer needs floats.
#   Positional args `%N$s`.
#
# ⚠ `\xHH` hex escape LEFT this list — it shipped and is documented above with
# the rest of the escape table. A deferral block that keeps a shipped feature
# reads as an admission of a gap that does not exist.

# Set when a directive or escape could not be honoured. printf used to WARN on
# stderr, write the bare conversion character to stdout and exit 0 — so a script
# using `%f` got the letter "f" where a number belonged and believed it worked.
var _pf_bad: i64 = 0;

var _pf_spec = 0;
var _pf_buf  = 0;
var _PF_BUFSZ: i64 = 4096;  # per-conversion scratch

fn _pf_init_spec(): i64 {
    if (_pf_spec != 0) { return 0; }
    var s = flags_new();
    _pf_spec = s;
    printf_help_declare();
    return 0;
}

# Help/introspection record for `printf`. ⭐ Split out so `kriya --list` can
# populate it WITHOUT running the utility — one declaration feeding `--help`,
# `--help=json` and `--list` alike.
fn printf_help_declare(): i64 {
    help_begin("printf", "Format and print arguments.",
               "printf FORMAT [ARGUMENT...]");
    help_positional(1, HELP_POS_UNBOUNDED, "FORMAT,ARGUMENT");
    help_operands("The FORMAT is reused until the arguments are exhausted. ⚠ Floating-point conversions are not implemented and fail rather than printing the conversion letter.");  #skip-lint
    help_exit(1, "an invalid conversion or escape was found");
    help_example("printf '%s=%d\\n' a 1");
    help_example("printf '%-10s|\\n' left");
    help_example("printf '\\x41\\n'");
    return 0;
}

fn _pf_buf_get(): i64 {
    if (_pf_buf == 0) { _pf_buf = alloc(_PF_BUFSZ); }
    return _pf_buf;
}

# Emit one byte to stdout.
fn _pf_putc(c): i64 {
    var b[2];
    store8(&b, c);
    k_write( 1, &b, 1);
    return 0;
}

# Emit `n` bytes from `p`.
fn _pf_puts(p, n): i64 {
    k_write( 1, p, n);
    return 0;
}

fn _pf_pad(c, n): i64 {
    var b[2];
    store8(&b, c);
    var i: i64 = 0;
    while (i < n) {
        k_write( 1, &b, 1);
        i = i + 1;
    }
    return 0;
}

# Parse a signed decimal integer from `s` (null-terminated). Returns
# 0 on null or empty. Octal (`0` prefix), hex (`0x`/`0X` prefix), and
# POSIX char-constant `'X'` (returns X's byte value) all supported.
fn _pf_parse_int(s): i64 {
    if (s == 0) { return 0; }
    if (load8(s) == 0) { return 0; }
    # `'X` or `"X` form (POSIX): use byte value of X.
    if (load8(s) == 39) { return load8(s + 1) & 255; }
    if (load8(s) == 34) { return load8(s + 1) & 255; }
    var pos: i64 = 0;
    var neg: i64 = 0;
    if (load8(s) == 45) { neg = 1; pos = 1; }
    else { if (load8(s) == 43) { pos = 1; } }
    var v: i64 = 0;
    # Detect base.
    var base: i64 = 10;
    if (load8(s + pos) == 48) {
        if (load8(s + pos + 1) == 120) { base = 16; pos = pos + 2; }
        else { if (load8(s + pos + 1) == 88) { base = 16; pos = pos + 2; }
        else { if (load8(s + pos + 1) != 0) { base = 8; pos = pos + 1; } } }
    }
    while (load8(s + pos) != 0) {
        var c = load8(s + pos);
        var d: i64 = 0 - 1;
        if (c >= 48) { if (c <= 57) { d = c - 48; } }
        if (base == 16) {
            if (c >= 97) { if (c <= 102) { d = c - 87; } }
            if (c >= 65) { if (c <= 70)  { d = c - 55; } }
        }
        if (d < 0) { pos = pos; pos = strlen(s); }
        else {
            if (d >= base) { pos = strlen(s); }
            else {
                v = v * base + d;
                pos = pos + 1;
            }
        }
    }
    if (neg == 1) { v = 0 - v; }
    return v;
}

# Render an integer in the given base into `buf`. Returns digit count.
# Always positive; sign handled by caller. Uppercase for `upper == 1`.
fn _pf_render_int_base(v, base, upper, buf): i64 {
    if (v == 0) { store8(buf, 48); return 1; }
    var tmp[64];
    var n: i64 = 0;
    var rem = v;
    while (rem > 0) {
        var d = rem - (rem / base) * base;
        var c: i64 = 48;
        if (d < 10) { c = 48 + d; }
        else {
            if (upper == 1) { c = 55 + d; }
            else            { c = 87 + d; }
        }
        store8(&tmp + n, c);
        rem = rem / base;
        n = n + 1;
    }
    var i: i64 = 0;
    while (i < n) {
        store8(buf + i, load8(&tmp + n - 1 - i));
        i = i + 1;
    }
    return n;
}

# Emit a signed integer with full flag/width/precision processing.
# `left`, `plus`, `space`, `hash`, `zero` are flag booleans.
# `width` < 0 → unspecified. `prec` < 0 → unspecified.
# `unsigned_mode` = 1 forces non-negative interpretation (for `%u`).
# `base` is 10/8/16. `upper` only relevant for hex.
fn _pf_emit_int(v, base, upper, left, plus, space, hash, zero, width, prec, unsigned_mode): i64 {
    var sign_char: i64 = 0;  # 0 = none, else literal byte
    var abs_v = v;
    if (unsigned_mode == 0) {
        if (base == 10) {
            if (v < 0) {
                sign_char = 45;  # '-'
                abs_v = 0 - v;
            } else {
                if (plus == 1)  { sign_char = 43; }     # '+'
                else { if (space == 1) { sign_char = 32; } }
            }
        }
    }

    # Render digits.
    var digits[64];
    var dn = _pf_render_int_base(abs_v, base, upper, &digits);

    # Apply precision: minimum digit count = prec.
    var digit_pad_zeros: i64 = 0;
    if (prec >= 0) {
        if (prec > dn) { digit_pad_zeros = prec - dn; }
        # When precision is given, the `0` flag is ignored (POSIX).
        zero = 0;
        # Special case: precision 0 + value 0 → emit nothing for the digits.
        if (prec == 0) {
            if (abs_v == 0) {
                dn = 0;
            }
        }
    }

    # Alternate form (#):
    #   octal: prepend `0` (only if not already starts with 0; cheaper:
    #          add it always, but ensure precision still wins).
    #   hex:   prepend `0x` / `0X` for non-zero.
    var alt_prefix: i64 = 0;
    var alt_prefix_len: i64 = 0;
    var alt_buf[4];
    if (hash == 1) {
        if (base == 8) {
            if (digit_pad_zeros > 0) {
                # Precision already gives us a leading zero. No-op.
            } else {
                if (dn == 0) {
                    # Value 0 with %#o and precision 0 → emit "0".
                    store8(&digits, 48);
                    dn = 1;
                } else {
                    if (load8(&digits) != 48) {
                        store8(&alt_buf, 48);
                        alt_prefix = &alt_buf;
                        alt_prefix_len = 1;
                    }
                }
            }
        } else { if (base == 16) {
            if (abs_v != 0) {
                store8(&alt_buf, 48);  # '0'
                if (upper == 1) { store8(&alt_buf + 1, 88); }
                else            { store8(&alt_buf + 1, 120); }
                alt_prefix = &alt_buf;
                alt_prefix_len = 2;
            }
        } }
    }

    var sign_len: i64 = 0;
    if (sign_char != 0) { sign_len = 1; }

    var content_len = sign_len + alt_prefix_len + digit_pad_zeros + dn;
    var pad: i64 = 0;
    if (width > 0) { if (content_len < width) { pad = width - content_len; } }

    var pad_char: i64 = 32;
    if (zero == 1) {
        if (left == 0) { pad_char = 48; }
    }

    if (left == 1) {
        # left-justify: content then padding.
        if (sign_char != 0) { _pf_putc(sign_char); }
        if (alt_prefix_len > 0) { _pf_puts(alt_prefix, alt_prefix_len); }
        _pf_pad(48, digit_pad_zeros);
        if (dn > 0) { _pf_puts(&digits, dn); }
        _pf_pad(32, pad);
    } else {
        if (pad_char == 48) {
            # zero-padding goes AFTER sign/prefix.
            if (sign_char != 0) { _pf_putc(sign_char); }
            if (alt_prefix_len > 0) { _pf_puts(alt_prefix, alt_prefix_len); }
            _pf_pad(48, pad);
            _pf_pad(48, digit_pad_zeros);
            if (dn > 0) { _pf_puts(&digits, dn); }
        } else {
            _pf_pad(32, pad);
            if (sign_char != 0) { _pf_putc(sign_char); }
            if (alt_prefix_len > 0) { _pf_puts(alt_prefix, alt_prefix_len); }
            _pf_pad(48, digit_pad_zeros);
            if (dn > 0) { _pf_puts(&digits, dn); }
        }
    }
    return 0;
}

# Emit a string with flags applied. `prec` truncates length.
fn _pf_emit_str(s, left, width, prec): i64 {
    var slen = 0;
    if (s != 0) { slen = strlen(s); }
    if (prec >= 0) { if (slen > prec) { slen = prec; } }
    var pad: i64 = 0;
    if (width > 0) { if (slen < width) { pad = width - slen; } }
    if (left == 1) {
        if (slen > 0) { _pf_puts(s, slen); }
        _pf_pad(32, pad);
    } else {
        _pf_pad(32, pad);
        if (slen > 0) { _pf_puts(s, slen); }
    }
    return 0;
}

# The escape modes, named once. ⚠ The ONLY difference between printf's two
# escape paths is the octal rule — `\0101` is backspace-then-`1` in a FORMAT
# string and `A` in a `%b` operand. GNU's own decoder is one function with one
# `octal_0` flag for exactly this; kriya's is now the same shape.
fn _pf_esc_mode_fmt(): i64 { return STR_ESC_ALLOW_C | STR_ESC_ALLOW_X; }
fn _pf_esc_mode_b(): i64   { return STR_ESC_ALLOW_C | STR_ESC_ALLOW_X | STR_ESC_OCTAL_PREFIX; }

# Emit one decoded escape. Returns 1 if `\c` was seen (caller stops output
# entirely), 0 otherwise; `out_len_p` receives the input bytes consumed.
fn _pf_emit_decoded(s, i, slen, mode, out_len_p): i64 {
    var esc[STR_ESC_OUT_SIZE];
    var v = str_escape_decode(s, i, slen, mode, &esc);
    store64(out_len_p, load64(&esc + STR_ESC_O_LEN));
    if (v == STR_ESC_STOP) { return 1; }
    if (v == STR_ESC_ERR) {
        k_write( 2, "kriya printf: missing hexadecimal number in escape\n", 51);
        _pf_bad = 1;
        return 0;
    }
    if (v == STR_ESC_LITERAL) { _pf_putc(92); }
    _pf_putc(load64(&esc + STR_ESC_O_BYTE));
    return 0;
}

# Process backslash escapes in a string for `%b`. Returns 1 if `\c`
# was encountered (caller should stop output entirely).
fn _pf_emit_b(s): i64 {
    if (s == 0) { return 0; }
    var slen = strlen(s);
    var mode = _pf_esc_mode_b();
    var stopped: i64 = 0;
    var i: i64 = 0;
    while (i < slen) {
        var b = load8(s + i);
        if (b != 92) {
            _pf_putc(b);
            i = i + 1;
        } else {
            var elen_box[8];
            var stop = _pf_emit_decoded(s, i, slen, mode, &elen_box);
            if (stop == 1) {
                stopped = 1;
                i = slen;
            } else {
                # ⚠ A malformed `\x` stops this operand too — GNU exits 1 there
                # rather than printing the rest. Before the shared decoder `%b`
                # had no `\x` at all and printed a literal `xZ`.
                if (_pf_bad == 1) { i = slen; }
                else { i = i + load64(&elen_box); }
            }
        }
    }
    return stopped;
}

# Process FORMAT-string escapes (always-on). Returns 1 if `\c` was seen —
# GNU cancels the remaining output and exits 0. `out_len_p` receives the
# escape's length, the backslash included.
fn _pf_emit_escape(s, i, slen, out_len_p): i64 {
    return _pf_emit_decoded(s, i, slen, _pf_esc_mode_fmt(), out_len_p);
}

# One byte to stderr — the conversion letter inside a diagnostic.
fn _pf_errc(c): i64 {
    var b[8];
    store8(&b, c);
    k_write( 2, &b, 1);
    return 0;
}

# e E f F g G a A — the conversions kriya does not implement, as opposed to ones
# that are simply invalid. Worth telling apart in the diagnostic.
fn _pf_is_float_conv(c): i64 {
    if (c == 101) { return 1; }   # e
    if (c == 69)  { return 1; }   # E
    if (c == 102) { return 1; }   # f
    if (c == 70)  { return 1; }   # F
    if (c == 103) { return 1; }   # g
    if (c == 71)  { return 1; }   # G
    if (c == 97)  { return 1; }   # a
    if (c == 65)  { return 1; }   # A
    return 0;
}

fn _pf_process(fmt, arg_count): i64 {
    var slen = strlen(fmt);
    var args_idx: i64 = 0;
    var stop: i64 = 0;
    var loop_outer: i64 = 1;

    while (loop_outer == 1) {
        var any_conversion: i64 = 0;
        var i: i64 = 0;
        while (i < slen) {
            # ⚠ A bad escape or directive STOPS processing, matching GNU: output
            # already written stays (`printf 'abc\xZdef'` emits "abc"), but
            # nothing after the error is emitted. Without this the offending
            # bytes were printed as literals — `\xZ` left a stray `Z` on stdout.
            if (stop == 1) { i = slen; }
            elif (_pf_bad == 1) { i = slen; }
            else {
                var b = load8(fmt + i);
                if (b == 92) {
                    # ⚠ `\c` cancels the rest of the output HERE too, not just in
                    # `%b` — GNU exits 0 on the spot, argument reuse included.
                    var elen_box[8];
                    if (_pf_emit_escape(fmt, i, slen, &elen_box) == 1) { stop = 1; }
                    i = i + load64(&elen_box);
                } else {
                    if (b == 37) {
                        i = i + 1;
                        # Flags.
                        var left: i64 = 0;
                        var plus: i64 = 0;
                        var space: i64 = 0;
                        var hash: i64 = 0;
                        var zero: i64 = 0;
                        var done_flags: i64 = 0;
                        while (done_flags == 0) {
                            var f = load8(fmt + i);
                            if (f == 45)      { left = 1; i = i + 1; }
                            else { if (f == 43) { plus = 1; i = i + 1; }
                            else { if (f == 32) { space = 1; i = i + 1; }
                            else { if (f == 35) { hash = 1; i = i + 1; }
                            else { if (f == 48) { zero = 1; i = i + 1; }
                            else { done_flags = 1; } } } } }
                        }
                        # Width.
                        var width: i64 = 0 - 1;
                        if (load8(fmt + i) == 42) {
                            i = i + 1;
                            var warg = "0";
                            if (args_idx < arg_count) {
                                warg = flags_positional(_pf_spec, args_idx + 1);
                                args_idx = args_idx + 1;
                            }
                            width = _pf_parse_int(warg);
                            if (width < 0) {
                                left = 1;
                                width = 0 - width;
                            }
                        } else {
                            var wv: i64 = 0;
                            var wany: i64 = 0;
                            var wdone: i64 = 0;
                            while (wdone == 0) {
                                var wc = load8(fmt + i);
                                if (wc < 48) { wdone = 1; }
                                else { if (wc > 57) { wdone = 1; }
                                else {
                                    wv = wv * 10 + (wc - 48);
                                    wany = 1;
                                    i = i + 1;
                                } }
                            }
                            if (wany == 1) { width = wv; }
                        }
                        # Precision.
                        var prec: i64 = 0 - 1;
                        if (load8(fmt + i) == 46) {
                            i = i + 1;
                            if (load8(fmt + i) == 42) {
                                i = i + 1;
                                var parg = "0";
                                if (args_idx < arg_count) {
                                    parg = flags_positional(_pf_spec, args_idx + 1);
                                    args_idx = args_idx + 1;
                                }
                                prec = _pf_parse_int(parg);
                                if (prec < 0) { prec = 0 - 1; }
                            } else {
                                var pv: i64 = 0;
                                var pdone: i64 = 0;
                                var pany: i64 = 0;
                                while (pdone == 0) {
                                    var pc = load8(fmt + i);
                                    if (pc < 48) { pdone = 1; }
                                    else { if (pc > 57) { pdone = 1; }
                                    else {
                                        pv = pv * 10 + (pc - 48);
                                        pany = 1;
                                        i = i + 1;
                                    } }
                                }
                                prec = pv;
                                if (pany == 0) { prec = 0; }
                            }
                        }
                        # Conversion.
                        var conv = load8(fmt + i);
                        if (conv == 0) {
                            # Trailing '%' — emit literally per POSIX.
                            _pf_putc(37);
                        } else {
                            i = i + 1;
                            if (conv == 37) {
                                _pf_putc(37);
                            } else { if (conv == 99) {
                                # %c: first byte of next arg, padded.
                                var s = "";
                                if (args_idx < arg_count) {
                                    s = flags_positional(_pf_spec, args_idx + 1);
                                    args_idx = args_idx + 1;
                                }
                                var ch: i64 = 0;
                                if (s != 0) { if (load8(s) != 0) { ch = load8(s); } }
                                var ch_buf[2];
                                store8(&ch_buf, ch);
                                _pf_emit_str(&ch_buf, left, width, 1);
                                any_conversion = 1;
                            } else { if (conv == 115) {
                                var s: i64 = 0;
                                if (args_idx < arg_count) {
                                    s = flags_positional(_pf_spec, args_idx + 1);
                                    args_idx = args_idx + 1;
                                }
                                _pf_emit_str(s, left, width, prec);
                                any_conversion = 1;
                            } else { if (conv == 98) {
                                var s: i64 = 0;
                                if (args_idx < arg_count) {
                                    s = flags_positional(_pf_spec, args_idx + 1);
                                    args_idx = args_idx + 1;
                                }
                                if (_pf_emit_b(s) == 1) { stop = 1; }
                                any_conversion = 1;
                            } else { if (conv == 100) {
                                var s = "0";
                                if (args_idx < arg_count) {
                                    s = flags_positional(_pf_spec, args_idx + 1);
                                    args_idx = args_idx + 1;
                                }
                                var v = _pf_parse_int(s);
                                _pf_emit_int(v, 10, 0, left, plus, space, hash, zero, width, prec, 0);
                                any_conversion = 1;
                            } else { if (conv == 105) {
                                var s = "0";
                                if (args_idx < arg_count) {
                                    s = flags_positional(_pf_spec, args_idx + 1);
                                    args_idx = args_idx + 1;
                                }
                                var v = _pf_parse_int(s);
                                _pf_emit_int(v, 10, 0, left, plus, space, hash, zero, width, prec, 0);
                                any_conversion = 1;
                            } else { if (conv == 117) {
                                var s = "0";
                                if (args_idx < arg_count) {
                                    s = flags_positional(_pf_spec, args_idx + 1);
                                    args_idx = args_idx + 1;
                                }
                                var v = _pf_parse_int(s);
                                _pf_emit_int(v, 10, 0, left, plus, space, hash, zero, width, prec, 1);
                                any_conversion = 1;
                            } else { if (conv == 111) {
                                var s = "0";
                                if (args_idx < arg_count) {
                                    s = flags_positional(_pf_spec, args_idx + 1);
                                    args_idx = args_idx + 1;
                                }
                                var v = _pf_parse_int(s);
                                _pf_emit_int(v, 8, 0, left, plus, space, hash, zero, width, prec, 1);
                                any_conversion = 1;
                            } else { if (conv == 120) {
                                var s = "0";
                                if (args_idx < arg_count) {
                                    s = flags_positional(_pf_spec, args_idx + 1);
                                    args_idx = args_idx + 1;
                                }
                                var v = _pf_parse_int(s);
                                _pf_emit_int(v, 16, 0, left, plus, space, hash, zero, width, prec, 1);
                                any_conversion = 1;
                            } else { if (conv == 88) {
                                var s = "0";
                                if (args_idx < arg_count) {
                                    s = flags_positional(_pf_spec, args_idx + 1);
                                    args_idx = args_idx + 1;
                                }
                                var v = _pf_parse_int(s);
                                _pf_emit_int(v, 16, 1, left, plus, space, hash, zero, width, prec, 1);
                                any_conversion = 1;
                            } else {
                                # ⛔ NOT A WARNING, AND NOTHING GOES TO STDOUT. This used to
                                # write a warning to stderr, emit the bare conversion letter
                                # to stdout (dropping the `%`) and exit 0 — so `printf '%f'
                                # 1.5` produced the text "f" and reported success. GNU exits 1
                                # on an invalid conversion and prints nothing.
                                # The float conversions get their own message: they are a
                                # named kriya gap, not a user typo.
                                _pf_bad = 1;
                                if (_pf_is_float_conv(conv) == 1) {
                                    k_write( 2, "kriya printf: %", 15);
                                    _pf_errc(conv);
                                    k_write( 2, ": floating-point conversions are not implemented\n", 49);
                                } else {
                                    k_write( 2, "kriya printf: %", 15);
                                    _pf_errc(conv);
                                    k_write( 2, ": invalid conversion specification\n", 35);
                                }
                            } } } } } } } } } }
                        }
                    } else {
                        _pf_putc(b);
                        i = i + 1;
                    }
                }
            }
        }
        # End-of-format pass.
        if (_pf_bad == 1) { loop_outer = 0; }
        if (stop == 1) { loop_outer = 0; }
        else {
            if (any_conversion == 0) { loop_outer = 0; }
            else {
                if (args_idx >= arg_count) { loop_outer = 0; }
            }
        }
    }
    return 0;
}

fn cmd_printf(start: i64): i64 {
    _pf_init_spec();
    if (kriya_args_parse(_pf_spec, start) != 0) {
        k_write( 2, "kriya printf: error: bad option (see ADR 0002 for accepted syntax)\n", 67);
        return EXIT_USAGE;
    }

    var npos = flags_positional_count(_pf_spec);
    if (npos < 1) {
        k_write( 2, "kriya printf: error: missing FORMAT\n", 36);
        return EXIT_USAGE;
    }

    var fmt = flags_positional(_pf_spec, 0);

    # Set up: positional indexing starts at 1 (0 is FORMAT). We pass
    # npos and an args_idx that walks from arg index 1 upward by
    # adjusting _pf_process's view. Easiest: use a separate `arg_count`
    # = npos - 1 and treat positional(1) as the first arg.
    #
    # _pf_process indexes 0..npos directly into the original positional
    # list, but we want the FORMAT excluded. Simplest fix: have
    # _pf_process accept a base-offset. The function above uses
    # `flags_positional(_pf_spec, args_idx)`; we'll re-implement the
    # offset inside this caller by wrapping... actually easier: just
    # pre-bump args_idx by 1 inside the function. Or do it here.
    #
    # The cleanest approach: have _pf_process treat the args as
    # positions [1..npos). I'll do that by passing the FORMAT in
    # separately and shifting npos.

    # Wrapper: _pf_process_args treats the arg pool as starting at
    # index 1 (skipping FORMAT). Reimplemented inline above uses
    # args_idx starting from 0. To avoid touching _pf_process, we
    # save and restore by NOT including FORMAT in the count and
    # making _pf_process see a shifted view via a tiny shim.
    #
    # Simpler path: inline a one-arg shift inside _pf_process by
    # adding `+ 1` to every `flags_positional(_pf_spec, args_idx)`.
    # I'll do that here by storing the shift in a global. But it's
    # cleaner to just pre-collect the args pointers into a side vec.

    var arg_count = npos - 1;
    # Process with a small wrapper: _pf_process is already written to
    # use the global spec; to shift past FORMAT, we set a global
    # `_pf_arg_base` (added below) that the helper uses.
    _pf_process(fmt, arg_count);
    if (_pf_bad == 1) { return EXIT_FAILURE; }
    return EXIT_SUCCESS;
}
