# printf — POSIX `printf(1)`: formatted text output.
#
# Argument shape:
#   printf FORMAT [ARGUMENT...]
#
# ⭐ EVERY ARGUMENT IS DATA, a leading `-` included — ADR 0025 (1.6.17).
# `--help` and `--version` are options only as the SOLE argument, and
# a first `--` is dropped, as POSIX asks of a utility with no options; nothing
# else is an option. So `printf '%d\n' -5` prints -5, `printf -x` prints `-x`,
# and `printf '%s|' a -- b` prints the `--` — GNU's rule, measured on 9.4 and
# 9.11. ⛔ The shared parser used to read them: `-5` was *bad option*, exit 2,
# and a `--` among the arguments was DELETED from the output.
#
# Conversions (this ship):
#   %d / %i    signed decimal integer
#   %u         unsigned decimal
#   %o         unsigned octal
#   %x / %X    unsigned hex (lower/upper)
#   %c         first byte of the argument — a NUL byte when it is empty
#   %s         string
#   %b         string with `\\…` escape processing (POSIX printf-specific)
#   %%         literal `%`
#
# Flags:
#   -          left-justify within width
#   +          always emit sign on signed conversions
#   ` `        space before non-negative on signed conversions
#   #          alternate form: `0x` / `0X` prefix for `%x`/`%X`, leading
#              `0` for `%o`
#   0          zero-pad (ignored if `-` or precision given on ints)
#   ' and I    grouping and locale digits — nothing, in kriya's C locale
#
# ⛔ GNU REFUSES A FLAG ITS CONVERSION CANNOT USE, AND SO DOES THIS (1.6.17):
# `%#d`, `%0s`, `%'x` and `%.3c` are *invalid conversion specification*, exit 1
# — kriya printed them. The length modifiers `l L h j t z` are read and
# ignored, as GNU's are, where kriya refused them: every integer here is 64
# bits, so `%ld` is `%d` and `%hhd 300` is 300. `%%` and `%b` take nothing
# between them and the `%`, so `%5%` and `%-b` fail, and a FORMAT ending
# inside a directive (`abc%`) is invalid too — GNU's answer to what POSIX
# leaves unspecified.
#
# Width / precision: literal digits (`%5d`, `%.3s`) and `*` to consume
# the next argument as an integer (`%*d`, `%.*s`, `%*.*d`). A negative `*`
# width left-justifies; a negative `*` precision is no precision.
# ⛔ A FIELD TOO LARGE FOR GNU IS NOT PRINTED (1.6.17). The digits WRAPPED —
# `%18446744073709551617d 5` printed `5` — and below the wrap a huge width was
# a HANG: the padding was one `write(2)` per byte. GNU refuses an integer or `%c`
# field past INT_MAX - 2 and a `%s` width past INT_MAX, then carries on with the
# rest of the format and exits 1; so does this, naming the directive. A `*` value
# outside int is FATAL, as GNU's is: *invalid field width* / *invalid
# precision*. ⚠ A `%s` precision past INT_MAX is no limit (9.11; 9.4 refuses).
#
# ⛔ AN ARGUMENT IS READ AS GNU READS IT, AND WHAT IS NOT A NUMBER IS SAID
# (1.6.17). `strtoimax` for `%d %i` and `*`, `strtoumax` for `%u %o %x %X`: blanks,
# a sign, `0x` hex or `0` octal, or `'X` / `"X` for X's byte. POSIX then asks for
# a diagnostic, the value read so far and a non-zero exit, and output carries on:
#   `%d 99999999999999999999`   9223372036854775807, *numerical result out of range*
#   `%u -1`                     18446744073709551615, and no diagnostic
#   `%d 5x`                     5, *value not completely converted*
#   `%d abc`, `%d ''`           0, *expected a numeric value*
# It used to WRAP the first (7766279631452241919, exit 0), print a bare `-` for
# 2^63, print NOTHING for `%u` past 2^63 — there was no unsigned path — and take
# all three bad ones in silence.
# ⚠ Version split: GNU 9.4 accepts `%d ''` as 0 at exit 0; 9.11, and this, do not.
# ⚠ A character constant is its first BYTE — GNU's answer in the C locale. In a
#   UTF-8 locale GNU reads the whole character.
# ⚠ ONE DELIBERATE DIVERGENCE, TOWARD POSIX: after a conversion error, `\c`
#   still exits 1. GNU's `\c` calls `exit (EXIT_SUCCESS)` whatever came before,
#   and POSIX says such an error *shall not exit with a zero exit status*.
#
# Escape sequences in FORMAT (always honored — printf processes them
# directly, unlike most utilities where `\n` in arg is literal):
#   \\  \a (07)  \b (08)  \e (1b)  \f (0c)  \n (0a)  \r (0d)  \t (09)
#   \v (0b)  \"  \NNN (1-3 octal digits)  \xHH (1-2 hex digits)
#   \c    cancel the rest of the output and exit 0
#
# ⭐ The table itself lives in `src/lib/str.cyr` and is called from BOTH escape
# paths here — see that file's header for the six divergences from GNU that two
# separate copies had accumulated. ⚠ The paths differ in ONE rule and it is
# passed as a mode bit: a FORMAT `\0101` is `\010` then a literal `1`, while a
# `%b` operand reads the `0` as a PREFIX and gets `A`. Both match GNU.
#
# **Argument reuse**: when args exceed format specifiers, the FORMAT
# is reapplied from the start until args are exhausted (POSIX). When
# args are short, missing args default to 0 / "". A pass that uses NO
# argument ends it, and whatever is left is named in a warning, as GNU does.
#
# Deferred (each named follow-up): (roadmap 1.8.0)
#   %e / %E / %f / %F / %g / %G / %a / %A   floating-point conversions.
#     Cyrius's float-printing story isn't settled, and most script
#     usage hits `%d`/`%s`. Defer until a real consumer needs floats.
#   Positional args `%N$s`.
#   `%q`, GNU's shell-quoted string. Refused by name, as the floats are.
#
# ⚠ `\xHH` hex escape LEFT this list — it shipped and is documented above with
# the rest of the escape table. A deferral block that keeps a shipped feature
# reads as an admission of a gap that does not exist.

# Set when a directive or escape could not be honoured, and processing STOPS.
# printf used to WARN on stderr, write the bare conversion character to stdout
# and exit 0 — so a script using `%f` got the letter "f" where a number belonged
# and believed it worked.
var _pf_bad: i64 = 0;
# Set when something failed and output CARRIES ON: an argument that was not
# entirely a number, a field too wide to print. Exit 1 at the end.
var _pf_failed: i64 = 0;
# Set by `\c`: nothing more is printed.
var _pf_stop: i64 = 0;

# The arguments: argv index of the first one after FORMAT, how many, and the
# next to consume.
var _pf_argv0: i64 = 0;
var _pf_nargs: i64 = 0;
var _pf_ai: i64 = 0;

var _pf_spec = 0;

fn _pf_init_spec(): i64 {
    if (_pf_spec != 0) { return 0; }
    var s = flags_new();
    _pf_spec = s;
    printf_help_declare();
    return 0;
}

# Help/introspection record for `printf`. ⭐ Split out so `kriya --list` can
# populate it WITHOUT running the utility — one declaration feeding `--help`,
# `--help=json` and `--list` alike.
fn printf_help_declare(): i64 {
    help_begin("printf", "Format and print arguments.",
      "printf FORMAT [ARGUMENT...]");
    help_positional(1, HELP_POS_UNBOUNDED, "FORMAT,ARGUMENT");
    help_operands("Every argument is data, a leading - included (ADR 0025): --help and --version are options only as the sole argument, and a first -- is dropped. The FORMAT is reused until the arguments are exhausted. ⚠ Floating-point conversions and %q are not implemented and fail rather than printing the conversion letter.");  #skip-lint
    help_exit(1, "a conversion or escape was invalid, or an argument was not entirely a number");
    help_example("printf '%s=%d\\n' a 1");
    help_example("printf '%d\\n' -5");
    help_example("printf '%-10s|\\n' left");
    help_example("printf '\\x41\\n'");
    return 0;
}

# Emit one byte to stdout.
fn _pf_putc(c): i64 {
    var b[2];
    store8(&b, c);
    k_write( 1, &b, 1);
    return 0;
}

# Emit `n` bytes from `p`.
fn _pf_puts(p, n): i64 {
    k_write( 1, p, n);
    return 0;
}

# The next argument, or 0 once they have run out.
fn _pf_next_arg(): i64 {
    if (_pf_ai >= _pf_nargs) { return 0; }
    var a = kriya_arg(_pf_argv0 + _pf_ai);
    _pf_ai = _pf_ai + 1;
    return a;
}

# The value of digit `c` in `base`, or -1.
fn _pf_digit(c, base): i64 {
    var d: i64 = 0 - 1;
    if (c >= 48) { if (c <= 57) { d = c - 48; } }
    if (c >= 97) { if (c <= 102) { d = c - 87; } }
    if (c >= 65) { if (c <= 70) { d = c - 55; } }
    if (d >= base) { return 0 - 1; }
    return d;
}

# GNU's `vstrtoimax` (`uns` = 0) or `vstrtoumax` (`uns` = 1) of an argument: its
# value, with GNU's diagnostic and exit status 1 when it is not all number. A
# MISSING argument (`s` = 0) is 0 and says nothing, as in GNU.
#
# ⚠ The magnitude is accumulated UNSIGNED, up to 2^64 - 1, whatever the
# conversion: `strtoumax` takes all of it and negates a `-` modulo 2^64 (`%u -1`
# is 2^64 - 1), and `strtoimax` then needs one more bit than an i64 has for
# -2^63. Out of range, the first saturates to 2^64 - 1 and the second to the
# i64 end its sign points at.
fn _pf_num(s, uns): i64 {
    if (s == 0) { return 0; }
    var c0 = load8(s);
    var cc: i64 = 0;
    if (c0 == 39) { cc = 1; }
    if (c0 == 34) { cc = 1; }
    if (cc == 1) {
        if (load8(s + 1) != 0) {
            if (load8(s + 2) != 0) {
                report_note("printf", s + 2, "warning: character(s) following character constant have been ignored");  #skip-lint
            }
            return load8(s + 1);
        }
    }
    var i: i64 = 0;
    var ws: i64 = 1;
    while (ws == 1) {
        var c = load8(s + i);
        var sp: i64 = 0;
        if (c == 32) { sp = 1; }
        if (c >= 9) { if (c <= 13) { sp = 1; } }
        if (sp == 1) { i = i + 1; } else { ws = 0; }
    }
    var neg: i64 = 0;
    if (load8(s + i) == 45) { neg = 1; i = i + 1; }
    elif (load8(s + i) == 43) { i = i + 1; }
    # Base 0: `0x` then a hex digit is hex, a leading `0` is octal — and is
    # itself a digit, so `0x` alone and `08` are 0 with junk after it.
    var base: i64 = 10;
    if (load8(s + i) == 48) {
        base = 8;
        var x = load8(s + i + 1);
        var hx: i64 = 0;
        if (x == 120) { hx = 1; }
        if (x == 88) { hx = 1; }
        if (hx == 1) {
            if (_pf_digit(load8(s + i + 2), 16) >= 0) { base = 16; i = i + 2; }
        }
    }
    # 2^64 - 1 is `limit * base + last`.
    var limit: i64 = 1844674407370955161;
    var last: i64 = 5;
    if (base == 16) { limit = 1152921504606846975; last = 15; }
    if (base == 8) { limit = 2305843009213693951; last = 7; }
    var mag: i64 = 0;
    var nd: i64 = 0;
    var over: i64 = 0;
    var more: i64 = 1;
    while (more == 1) {
        var d = _pf_digit(load8(s + i), base);
        if (d < 0) { more = 0; }
        else {
            # Read unsigned: a magnitude with the top bit set is past every limit.
            if (mag < 0) { over = 1; }
            elif (mag > limit) { over = 1; }
            elif (mag == limit) { if (d > last) { over = 1; } }
            if (over == 0) { mag = mag * base + d; }
            nd = nd + 1;
            i = i + 1;
        }
    }
    if (nd == 0) {
        report_note("printf", s, "expected a numeric value");
        _pf_failed = 1;
        return 0;
    }
    var v: i64 = 0;
    if (uns == 1) {
        if (over == 1) { v = 0 - 1; }
        elif (neg == 1) { v = 0 - mag; }
        else { v = mag; }
    } else {
        if (over == 0) {
            if (neg == 1) {
                # Down to -2^63, whose magnitude is i64's minimum read unsigned.
                if (mag < 0) {
                    if (mag != (0 - KRIYA_COUNT_MAX) - 1) { over = 1; }
                }
                v = 0 - mag;
            } else {
                if (mag < 0) { over = 1; }
                v = mag;
            }
        }
        if (over == 1) {
            if (neg == 1) { v = (0 - KRIYA_COUNT_MAX) - 1; } else { v = KRIYA_COUNT_MAX; }
        }
    }
    if (over == 1) {
        errmsg_report("printf", s, 34);                  # ERANGE
        _pf_failed = 1;
    } elif (load8(s + i) != 0) {
        report_note("printf", s, "value not completely converted");
        _pf_failed = 1;
    }
    return v;
}

# Emit an integer with full flag/width/precision processing. `v` is SIGNED when
# `signed_conv` = 1 (`%d %i`) and a 64-bit unsigned pattern otherwise.
# `width` < 0 → unspecified. `prec` < 0 → unspecified.
# `base` is 10/8/16. `upper` only relevant for hex.
fn _pf_emit_int(v, signed_conv, base, upper, left, plus, space, hash, zero, width, prec): i64 {
    var sign_char: i64 = 0;  # 0 = none, else literal byte
    var mag = v;
    if (signed_conv == 1) {
        if (v < 0) {
            sign_char = 45;  # '-'
            mag = 0 - v;     # i64's minimum stays itself, and reads right unsigned
        } else {
            if (plus == 1)  { sign_char = 43; }     # '+'
            else { if (space == 1) { sign_char = 32; } }
        }
    }

    # Render digits.
    var digits[24];
    var dn = str_u64_digits(mag, base, upper, &digits);

    # Apply precision: minimum digit count = prec.
    var digit_pad_zeros: i64 = 0;
    if (prec >= 0) {
        if (prec > dn) { digit_pad_zeros = prec - dn; }
        # When precision is given, the `0` flag is ignored (POSIX).
        zero = 0;
        # Special case: precision 0 + value 0 → emit nothing for the digits.
        if (prec == 0) {
            if (mag == 0) {
                dn = 0;
            }
        }
    }

    # Alternate form (#):
    #   octal: prepend `0` (only if not already starts with 0; cheaper:
    #          add it always, but ensure precision still wins).
    #   hex:   prepend `0x` / `0X` for non-zero.
    var alt_prefix: i64 = 0;
    var alt_prefix_len: i64 = 0;
    var alt_buf[4];
    if (hash == 1) {
        if (base == 8) {
            if (digit_pad_zeros > 0) {
                # Precision already gives us a leading zero. No-op.
            } else {
                if (dn == 0) {
                    # Value 0 with %#o and precision 0 → emit "0".
                    store8(&digits, 48);
                    dn = 1;
                } else {
                    if (load8(&digits) != 48) {
                        store8(&alt_buf, 48);
                        alt_prefix = &alt_buf;
                        alt_prefix_len = 1;
                    }
                }
            }
        } else { if (base == 16) {
                if (mag != 0) {
                    store8(&alt_buf, 48);  # '0'
                    if (upper == 1) { store8(&alt_buf + 1, 88); }
                    else            { store8(&alt_buf + 1, 120); }
                    alt_prefix = &alt_buf;
                    alt_prefix_len = 2;
                }
            } }
    }

    var sign_len: i64 = 0;
    if (sign_char != 0) { sign_len = 1; }

    var content_len = sign_len + alt_prefix_len + digit_pad_zeros + dn;
    var pad: i64 = 0;
    if (width > 0) { if (content_len < width) { pad = width - content_len; } }

    var pad_char: i64 = 32;
    if (zero == 1) {
        if (left == 0) { pad_char = 48; }
    }

    if (left == 1) {
        # left-justify: content then padding.
        if (sign_char != 0) { _pf_putc(sign_char); }
        if (alt_prefix_len > 0) { _pf_puts(alt_prefix, alt_prefix_len); }
        k_write_fill(1, 48, digit_pad_zeros);
        if (dn > 0) { _pf_puts(&digits, dn); }
        k_write_fill(1, 32, pad);
    } else {
        if (pad_char == 48) {
            # zero-padding goes AFTER sign/prefix.
            if (sign_char != 0) { _pf_putc(sign_char); }
            if (alt_prefix_len > 0) { _pf_puts(alt_prefix, alt_prefix_len); }
            k_write_fill(1, 48, pad);
            k_write_fill(1, 48, digit_pad_zeros);
            if (dn > 0) { _pf_puts(&digits, dn); }
        } else {
            k_write_fill(1, 32, pad);
            if (sign_char != 0) { _pf_putc(sign_char); }
            if (alt_prefix_len > 0) { _pf_puts(alt_prefix, alt_prefix_len); }
            k_write_fill(1, 48, digit_pad_zeros);
            if (dn > 0) { _pf_puts(&digits, dn); }
        }
    }
    return 0;
}

# Emit `slen` bytes of `s` with flags applied — a LENGTH, not a NUL, so that
# `%c` can print the NUL byte GNU prints for an empty argument. `prec` truncates.
fn _pf_emit_str(s, slen, left, width, prec): i64 {
    var n = slen;
    if (prec >= 0) { if (n > prec) { n = prec; } }
    var pad: i64 = 0;
    if (width > n) { pad = width - n; }
    if (left == 0) { k_write_fill(1, 32, pad); }
    if (n > 0) { _pf_puts(s, n); }
    if (left == 1) { k_write_fill(1, 32, pad); }
    return 0;
}

# The escape modes, named once. ⚠ The ONLY difference between printf's two
# escape paths is the octal rule — `\0101` is backspace-then-`1` in a FORMAT
# string and `A` in a `%b` operand. GNU's own decoder is one function with one
# `octal_0` flag for exactly this; kriya's is now the same shape.
fn _pf_esc_mode_fmt(): i64 { return STR_ESC_ALLOW_C | STR_ESC_ALLOW_X | STR_ESC_DQUOTE; }
fn _pf_esc_mode_b(): i64 {
    return STR_ESC_ALLOW_C | STR_ESC_ALLOW_X | STR_ESC_DQUOTE | STR_ESC_OCTAL_PREFIX;
}

# Emit one decoded escape. Returns 1 if `\c` was seen (caller stops output
# entirely), 0 otherwise; `out_len_p` receives the input bytes consumed.
fn _pf_emit_decoded(s, i, slen, mode, out_len_p): i64 {
    var esc[STR_ESC_OUT_SIZE];
    var v = str_escape_decode(s, i, slen, mode, &esc);
    store64(out_len_p, load64(&esc + STR_ESC_O_LEN));
    if (v == STR_ESC_STOP) { return 1; }
    if (v == STR_ESC_ERR) {
        k_write( 2, "kriya printf: missing hexadecimal number in escape\n", 51);
        _pf_bad = 1;
        return 0;
    }
    if (v == STR_ESC_LITERAL) { _pf_putc(92); }
    _pf_putc(load64(&esc + STR_ESC_O_BYTE));
    return 0;
}

# Process backslash escapes in a string for `%b`. Returns 1 if `\c`
# was encountered (caller should stop output entirely).
fn _pf_emit_b(s): i64 {
    if (s == 0) { return 0; }
    var slen = strlen(s);
    var mode = _pf_esc_mode_b();
    var stopped: i64 = 0;
    var i: i64 = 0;
    while (i < slen) {
        var b = load8(s + i);
        if (b != 92) {
            _pf_putc(b);
            i = i + 1;
        } else {
            var elen_box[8];
            var stop = _pf_emit_decoded(s, i, slen, mode, &elen_box);
            if (stop == 1) {
                stopped = 1;
                i = slen;
            } else {
                # ⚠ A malformed `\x` stops this operand too — GNU exits 1 there
                # rather than printing the rest. Before the shared decoder `%b`
                # had no `\x` at all and printed a literal `xZ`.
                if (_pf_bad == 1) { i = slen; }
                else { i = i + load64(&elen_box); }
            }
        }
    }
    return stopped;
}

# Process FORMAT-string escapes (always-on). Returns 1 if `\c` was seen —
# GNU cancels the remaining output and exits 0. `out_len_p` receives the
# escape's length, the backslash included.
fn _pf_emit_escape(s, i, slen, out_len_p): i64 {
    return _pf_emit_decoded(s, i, slen, _pf_esc_mode_fmt(), out_len_p);
}

# e E f F g G a A — the conversions kriya does not implement, as opposed to ones
# that are simply invalid. Worth telling apart in the diagnostic.
fn _pf_is_float_conv(c): i64 {
    if (c == 101) { return 1; }   # e
    if (c == 69)  { return 1; }   # E
    if (c == 102) { return 1; }   # f
    if (c == 70)  { return 1; }   # F
    if (c == 103) { return 1; }   # g
    if (c == 71)  { return 1; }   # G
    if (c == 97)  { return 1; }   # a
    if (c == 65)  { return 1; }   # A
    return 0;
}

# l L h j t z — length modifiers, read past and ignored.
fn _pf_is_length_mod(c): i64 {
    if (c == 108) { return 1; }   # l
    if (c == 76)  { return 1; }   # L
    if (c == 104) { return 1; }   # h
    if (c == 106) { return 1; }   # j
    if (c == 116) { return 1; }   # t
    if (c == 122) { return 1; }   # z
    return 0;
}

# 1 if conversion `c` survives the directive's flags and precision — GNU's `ok`
# table: `'` and `I` rule out `a A c e E o s x X`, `#` rules out `c d i s u`, `0`
# rules out `c s`, and a precision rules out `c`.
fn _pf_conv_ok(c, hash, zero, quote, dotted): i64 {
    if (c == 100) { return 1 - hash; }           # d
    if (c == 105) { return 1 - hash; }           # i
    if (c == 117) { return 1 - hash; }           # u
    if (c == 111) { return 1 - quote; }          # o
    if (c == 120) { return 1 - quote; }          # x
    if (c == 88)  { return 1 - quote; }          # X
    if (c == 115) {                              # s
        if (hash == 1) { return 0; }
        if (zero == 1) { return 0; }
        return 1 - quote;
    }
    if (c == 99) {                               # c
        if (hash == 1) { return 0; }
        if (zero == 1) { return 0; }
        if (dotted == 1) { return 0; }
        return 1 - quote;
    }
    if (_pf_is_float_conv(c) == 1) {
        if (c == 97) { return 1 - quote; }       # a
        if (c == 65) { return 1 - quote; }       # A
        if (c == 101) { return 1 - quote; }      # e
        if (c == 69) { return 1 - quote; }       # E
        return 1;
    }
    return 0;
}

# The directive's text, `%` through `fmt + end` exclusive, for a diagnostic.
fn _pf_spec_text(fmt, start, end): i64 {
    var n = end - start;
    var t = alloc(n + 1);
    memcpy(t, fmt + start, n);
    store8(t + n, 0);
    return t;
}

# A failure that STOPS printf, named by `what`.
fn _pf_fatal(what, message): i64 {
    report_note("printf", what, message);
    _pf_bad = 1;
    return 0;
}

# Digits at `fmt + i` as a width or precision, SATURATING just past INT_MAX —
# every larger value gets the same answer. Stored at `out_p` only when there is
# a digit; returns the index after them.
fn _pf_field_digits(fmt, i, out_p): i64 {
    var v: i64 = 0;
    var any: i64 = 0;
    var more: i64 = 1;
    while (more == 1) {
        var c = load8(fmt + i);
        if (c < 48) { more = 0; }
        elif (c > 57) { more = 0; }
        else {
            v = v * 10 + (c - 48);
            if (v > 2147483647) { v = 2147483648; }
            any = 1;
            i = i + 1;
        }
    }
    if (any == 1) { store64(out_p, v); }
    return i;
}

# The directive at `fmt + i`, which is the `%`: read it, check it against GNU's
# table, take its arguments and print it. Returns the index after it.
fn _pf_directive(fmt, i): i64 {
    var start = i;
    i = i + 1;
    var c0 = load8(fmt + i);
    # `%%` and `%b` (and GNU's `%q`) are recognised BEFORE any flag, so nothing
    # may stand between them and the `%`: `%5%` and `%-b` fail the table below.
    if (c0 == 37) { _pf_putc(37); return i + 1; }
    if (c0 == 98) {
        if (_pf_emit_b(_pf_next_arg()) == 1) { _pf_stop = 1; }
        return i + 1;
    }
    if (c0 == 113) {
        _pf_fatal("%q", "shell-quoting conversion is not implemented");
        return i + 1;
    }
    var left: i64 = 0;
    var plus: i64 = 0;
    var space: i64 = 0;
    var hash: i64 = 0;
    var zero: i64 = 0;
    var quote: i64 = 0;
    var scanning: i64 = 1;
    while (scanning == 1) {
        var f = load8(fmt + i);
        if (f == 45) { left = 1; }
        elif (f == 43) { plus = 1; }
        elif (f == 32) { space = 1; }
        elif (f == 35) { hash = 1; }
        elif (f == 48) { zero = 1; }
        elif (f == 39) { quote = 1; }
        elif (f == 73) { quote = 1; }
        else { scanning = 0; }
        if (scanning == 1) { i = i + 1; }
    }
    # Width. A `*` value outside int is fatal here; one too large to PRINT is
    # decided below, once the conversion is known. `wtext` names a `*` value.
    var width: i64 = 0 - 1;
    var wtext: i64 = 0;
    if (load8(fmt + i) == 42) {
        i = i + 1;
        width = 0;
        var wa = _pf_next_arg();
        if (wa != 0) {
            var wv = _pf_num(wa, 0);
            if (wv > 2147483647) { _pf_fatal(wa, "invalid field width"); return i; }
            if (wv < (0 - 2147483647) - 1) { _pf_fatal(wa, "invalid field width"); return i; }
            wtext = wa;
            # INT_MIN is inside the range GNU checks, and its magnitude is not.
            if (wv < 0) { left = 1; width = 0 - wv; } else { width = wv; }
        }
    } else {
        i = _pf_field_digits(fmt, i, &width);
    }
    # Precision, the same way.
    var prec: i64 = 0 - 1;
    var dotted: i64 = 0;
    var ptext: i64 = 0;
    if (load8(fmt + i) == 46) {
        i = i + 1;
        dotted = 1;
        if (load8(fmt + i) == 42) {
            i = i + 1;
            prec = 0;
            var pa = _pf_next_arg();
            if (pa != 0) {
                var pv = _pf_num(pa, 0);
                if (pv > 2147483647) { _pf_fatal(pa, "invalid precision"); return i; }
                ptext = pa;
                if (pv < 0) { prec = 0 - 1; } else { prec = pv; }
            }
        } else {
            prec = 0;
            i = _pf_field_digits(fmt, i, &prec);
        }
    }
    var lm: i64 = 1;
    while (lm == 1) {
        if (_pf_is_length_mod(load8(fmt + i)) == 1) { i = i + 1; } else { lm = 0; }
    }
    var conv = load8(fmt + i);
    var end = i;
    if (conv != 0) { end = i + 1; }
    if (_pf_conv_ok(conv, hash, zero, quote, dotted) == 0) {
        # ⛔ NOT A WARNING, AND NOTHING GOES TO STDOUT. This used to write a
        # warning, emit the bare conversion letter (dropping the `%`) and exit 0
        # — so `printf '%f' 1.5` produced the text "f" and reported success. GNU
        # exits 1 on an invalid conversion and prints nothing for it.
        _pf_fatal(_pf_spec_text(fmt, start, end), "invalid conversion specification");
        return end;
    }
    if (_pf_is_float_conv(conv) == 1) {
        # A named kriya gap, not a user typo, so it gets its own message.
        _pf_fatal(_pf_spec_text(fmt, start, end), "floating-point conversions are not implemented");
        return end;
    }
    i = end;
    var arg = _pf_next_arg();
    var uns: i64 = 1;
    var numeric: i64 = 1;
    if (conv == 100) { uns = 0; }
    if (conv == 105) { uns = 0; }
    if (conv == 99) { numeric = 0; }
    if (conv == 115) { numeric = 0; }
    var v: i64 = 0;
    # Read even when the field is not printed: a bad argument is still reported.
    if (numeric == 1) { v = _pf_num(arg, uns); }
    # ⚠ THE LIMITS ARE GNU printf's, MEASURED, AND NOT INT_MAX FOR EVERY
    # CONVERSION: an integer or `%c` field is refused past INT_MAX - 2
    # (`%2147483645d` prints two gigabytes, `%2147483646d` nothing), while `%s`
    # takes a width up to INT_MAX, and a precision past it means no limit at all.
    # ⚠ That last one is 9.11's; 9.4 refuses it. GNU `stat` differs again.
    var lim: i64 = 2147483645;
    if (conv == 115) {
        lim = 2147483647;
        if (prec > 2147483647) { prec = 0 - 1; }
    }
    if (width > lim) {
        if (wtext == 0) { wtext = _pf_spec_text(fmt, start, end); }
        report_note("printf", wtext, "invalid field width");
        _pf_failed = 1;
        return i;
    }
    if (prec > lim) {
        if (ptext == 0) { ptext = _pf_spec_text(fmt, start, end); }
        report_note("printf", ptext, "invalid precision");
        _pf_failed = 1;
        return i;
    }
    if (conv == 99) {
        var cb[8];
        store8(&cb, 0);
        if (arg != 0) { store8(&cb, load8(arg)); }
        _pf_emit_str(&cb, 1, left, width, 0 - 1);
        return i;
    }
    if (conv == 115) {
        var sl: i64 = 0;
        if (arg != 0) { sl = strlen(arg); }
        _pf_emit_str(arg, sl, left, width, prec);
        return i;
    }
    var base: i64 = 10;
    var upper: i64 = 0;
    if (conv == 111) { base = 8; }
    if (conv == 120) { base = 16; }
    if (conv == 88) { base = 16; upper = 1; }
    _pf_emit_int(v, 1 - uns, base, upper, left, plus, space, hash, zero, width, prec);
    return i;
}

fn _pf_process(fmt): i64 {
    var slen = strlen(fmt);
    var go: i64 = 1;
    while (go == 1) {
        var used_before = _pf_ai;
        var i: i64 = 0;
        while (i < slen) {
            # ⚠ A bad escape or directive STOPS processing, matching GNU: output
            # already written stays (`printf 'abc\xZdef'` emits "abc"), but
            # nothing after the error is emitted. Without this the offending
            # bytes were printed as literals — `\xZ` left a stray `Z` on stdout.
            if (_pf_stop == 1) { i = slen; }
            elif (_pf_bad == 1) { i = slen; }
            else {
                var b = load8(fmt + i);
                if (b == 92) {
                    # ⚠ `\c` cancels the rest of the output HERE too, not just in
                    # `%b` — GNU exits on the spot, argument reuse included.
                    var elen_box[8];
                    if (_pf_emit_escape(fmt, i, slen, &elen_box) == 1) { _pf_stop = 1; }
                    i = i + load64(&elen_box);
                } elif (b == 37) {
                    i = _pf_directive(fmt, i);
                } else {
                    _pf_putc(b);
                    i = i + 1;
                }
            }
        }
        # GNU reapplies the FORMAT while a pass uses an argument and some remain.
        if (_pf_bad == 1) { go = 0; }
        elif (_pf_stop == 1) { go = 0; }
        elif (_pf_ai == used_before) { go = 0; }
        elif (_pf_ai >= _pf_nargs) { go = 0; }
    }
    # A pass that used no argument left the rest unused; GNU names the first.
    if (_pf_bad == 0) {
        if (_pf_stop == 0) {
            if (_pf_ai < _pf_nargs) {
                report_note("printf", kriya_arg(_pf_argv0 + _pf_ai),
                  "warning: ignoring excess arguments, starting with this one");
            }
        }
    }
    return 0;
}

fn cmd_printf(start: i64): i64 {
    _pf_init_spec();
    # ⛔ NOT `kriya_args_parse` (ADR 0025): printf has no options for a `-5` or a
    # `--` to be, so nothing after the utility name is one — except `--help` and
    # `--version` ALONE, and a leading `--`, dropped as POSIX XCU 1.4 asks.
    help_if_sole(_pf_spec, start);
    var n = kriya_argv_count();
    var first = start;
    if (first < n) {
        if (streq(kriya_arg(first), "--") == 1) { first = first + 1; }
    }
    if (first >= n) {
        k_write( 2, "kriya printf: error: missing FORMAT\n", 36);
        return EXIT_USAGE;
    }

    # ⚠ FORMAT is NOT an argument: the arguments start one past it, and
    # `_pf_ai` stays a plain 0-based argument index.
    _pf_argv0 = first + 1;
    _pf_nargs = n - first - 1;
    _pf_ai = 0;
    _pf_process(kriya_arg(first));
    if (_pf_bad == 1) { return EXIT_FAILURE; }
    if (_pf_failed == 1) { return EXIT_FAILURE; }
    return EXIT_SUCCESS;
}
