# ls — POSIX `ls(1)`: list directory contents (M3 closer).
#
# Argument shape:
#   ls [opts] [file...]
#
# Without operands, lists the current directory. With one or more
# operands, lists each (directory contents for directories, the entry
# itself for non-directories).
#
# Flags (this ship):
#   -a / --all              include `.` and `..` and other dotfiles.
#   -A / --almost-all       include dotfiles but skip `.` and `..`.
#   -l                      long form (mode nlink uid gid size mtime name).
#   -h / --human-readable   human-readable size suffixes (B/K/M/G/T/P)
#                           in -l form.
#   -r / --reverse          reverse the alphabetical sort.
#   -1                      force one entry per line (overrides the
#                           default multi-column layout).
#   -w / --width COLS       assume terminal width COLS for column
#                           packing (0 = auto-detect).
#   -F                      append type indicator (`/` dir, `*` exec,
#                           `@` symlink, `|` fifo, `=` socket).
#   -i / --inode            prepend the inode number.
#   -d / --directory        list directory operands as entries
#                           themselves, not their contents.
#   -R / --recursive        descend into subdirectories.
#
# Default output is GNU-style multi-column (column-major, fill down then
# across) sized to the terminal — ioctl(TIOCGWINSZ) on Linux, winsize()#60
# on agnos, else $COLUMNS / -w, falling back to 80. Off a tty with no width
# hint it degrades to one-per-line (script-safe, like GNU ls piped).
#
# ⭐ `-t` / `-S` shipped at 1.5.1 (and the insertion sort became a merge sort in
# the same pass), `--color` at 1.5.2 and quoting at 1.5.3. What is left is small
# and listed under roadmap 1.5.4 — the `-d`-with-no-operand bug, TAB column
# padding, the `no=` prefix position, and the remaining `--quoting-style` styles.
#
# ⭐ Owner/group NAMES shipped at 1.5.0 on `src/lib/userdb.cyr`, and `-n` with
# them — it forces numeric regardless, and in GNU it also IMPLIES `-l`.
# ⛔ The alignment is the part worth knowing: a resolved NAME is LEFT-justified
# and an unmapped NUMERIC id is RIGHT-justified, in the SAME column, both padded
# to the widest entry in the listing. Every other `-l` column is right-justified,
# so assuming one rule for this one is wrong half the time.
#
# Symlink policy: ls is purely informational. ADR 0003 doesn't apply.
# `-l` of a symlink renders `link -> target`; the target is not opened.
# `-R` does not follow symlinks into subdirectories (matches GNU default).
#
# Each operand is processed independently. Exit `EXIT_FAILURE` if any
# failed; partial successes still print.

var _ls_spec   = 0;
var _ls_a_idx  = 0;
var _ls_A_idx  = 0;
var _ls_l_idx  = 0;
var _ls_h_idx  = 0;
var _ls_r_idx  = 0;
var _ls_1_idx  = 0;
var _ls_F_idx  = 0;
var _ls_i_idx  = 0;
var _ls_n_idx  = 0;
var _ls_t_idx  = 0;
var _ls_S_idx  = 0;
var _ls_color_idx = 0;
var _ls_qs_idx = 0;
var _ls_d_idx  = 0;
var _ls_R_idx  = 0;
var _ls_w_idx  = 0;

fn _ls_init_spec(): i64 {
    if (_ls_spec != 0) { return 0; }
    var s = flags_new();
    _ls_a_idx = flags_add_bool(s, 97,  "all",             0, "include all entries including . and ..");
    _ls_A_idx = flags_add_bool(s, 65,  "almost-all",      0, "include dotfiles but skip . and ..");
    _ls_l_idx = flags_add_bool(s, 108, "",                0, "long form");
    _ls_h_idx = flags_add_bool(s, 104, "human-readable",  0, "human-readable size suffixes (with -l)");
    _ls_r_idx = flags_add_bool(s, 114, "reverse",         0, "reverse sort order");
    _ls_1_idx = flags_add_bool(s, 49,  "",                0, "force one entry per line");
    _ls_F_idx = flags_add_bool(s, 70,  "",                0, "append type indicator");
    _ls_i_idx = flags_add_bool(s, 105, "inode",           0, "print inode number");
    _ls_n_idx = flags_add_bool(s, 110, "numeric-uid-gid", 0, "list numeric uid/gid, never names");
    _ls_t_idx = flags_add_bool(s, 116, "",                0, "sort by modification time, newest first");
    _ls_S_idx = flags_add_bool(s, 83,  "",                0, "sort by size, largest first");
    _ls_color_idx = flags_add_str(s, 0, "color", 0, "colourise output: always|auto|never");
    _ls_qs_idx = flags_add_str(s, 0, "quoting-style", 0,
                               "literal|shell-escape|shell-escape-always");
    _ls_d_idx = flags_add_bool(s, 100, "directory",       0, "list dir operands as entries, not contents");
    _ls_R_idx = flags_add_bool(s, 82,  "recursive",       0, "descend into subdirectories");
    _ls_w_idx = flags_add_int(s, 119, "width",            0, "assume terminal width COLS (0 = auto)");
    _ls_spec = s;
    ls_help_declare();
    return 0;
}

# Help/introspection record for `ls`. ⭐ Split out so `kriya --list` can
# populate it WITHOUT running the utility — one declaration feeding `--help`,
# `--help=json` and `--list` alike.
fn ls_help_declare(): i64 {
    help_begin("ls", "List directory contents. With no operand, lists the current directory.",
               "ls [OPTIONS] [FILE...]");
    help_positional(0, HELP_POS_UNBOUNDED, "FILE");
    help_operands("Operands are files or directories. A directory is listed by its contents unless -d is given.");
    help_exit(1, "one or more operands could not be read");
    help_example("ls");
    help_example("ls -la /etc");
    help_example("ls -l --color=never");
    return 0;
}

fn _ls_report(operand, errno): i64 {
    k_write( 2, "kriya ls: ", 10);
    k_write( 2, operand, strlen(operand));
    k_write( 2, ": ", 2);
    if (errmsg_is_known(errno) == 1) {
        var m = errmsg_for(errno);
        k_write( 2, m, strlen(m));
    } else {
        k_write( 2, "errno ", 6);
        var buf[8];
        var i: i64 = 7;
        store8(&buf + i, 0);
        i = i - 1;
        var v = errno;
        if (v == 0) { store8(&buf + i, 48); i = i - 1; }
        while (v > 0) {
            store8(&buf + i, 48 + (v - (v / 10) * 10));
            v = v / 10;
            i = i - 1;
        }
        k_write( 2, &buf + i + 1, 6 - i);
    }
    k_write( 2, "\n", 1);
    return 0;
}

# --- per-entry record ---
#
# Layout (160 bytes):
#   offset 0   : pointer to name cstring (heap-allocated)
#   offset 8   : 144-byte stat buffer
#   offset 152 : pointer to symlink target cstring (or 0)

# ⛔ A RECORD WHOSE STAT FAILED IS A STATE, NOT A ZEROED STRUCT. `ls -l` used to
# discard `fs_stat_entry`'s return and render the all-zero buffer, printing
# `---------- 0 0 0 0 1970-01-01 00:00` and exiting 0 — a symlink shown as a
# regular file, an epoch-zero date, and every field a plausible-looking lie.
# Reproduced in a readable-but-not-searchable directory (`chmod 444`), where
# every per-entry stat fails with EACCES. GNU prints `?` for what it cannot know,
# reports `cannot access` per entry on stderr, and exits 1.
#
# ⚠ The fix is not the renderer alone: the flag has to reach the column-width
# pass (a `?` is one column wide, not the width of a fabricated zero), the
# long-format emitter, AND the exit-status rollup.
var _ls_stat_failed = 0;

# ⚠ Module scope rather than a sixth threaded parameter. `-n` is a pure display
# mode read once from the flags, and `_ls_print_dir` is three call sites deep
# from where the flags are parsed — threading it would touch every layer in
# between for a value none of them inspect. `_ls_stat_failed` above sets the
# precedent for display state living here.
var _ls_numeric = 0;

# ⭐ Shell-escape quoting, on when stdout is a TERMINAL — which is GNU's default
# and the reason `ls | cat` and `ls` on screen differ. ⚠ Piped output stays raw,
# which is what every script that parses `ls` depends on.
var _ls_quote = 0;

# ⚠ Set per LISTING in `-l`: when ANY entry needs quotes, the ones that do NOT
# get a single leading space, so every name starts in the same column as the
# first character inside a quote. Measured: an all-plain `-l` has no padding,
# and adding one quoted name shifts every other name right by one.
var _ls_long_qpad = 0;

fn _ls_rec_new(name_cstr): i64 {
    var rec = alloc(184);
    store64(rec, name_cstr);
    store64(rec + 152, 0);
    store64(rec + 160, 0);          # 1 = stat failed; fields are unknown
    store64(rec + 168, 0);          # 1 = symlink whose target does not resolve
    store64(rec + 176, 0);          # colour code for the -l link TARGET, or 0
    return rec;
}

fn _ls_rec_broken(rec): i64     { return load64(rec + 168); }
fn _ls_rec_tgt_code(rec): i64   { return load64(rec + 176); }

fn _ls_rec_bad(rec): i64        { return load64(rec + 160); }
fn _ls_rec_set_bad(rec): i64    { store64(rec + 160, 1); return 0; }

# Map a dirent d_type to the S_IF* bits, so the TYPE character stays correct even
# when the stat failed — which is what lets `ls -l` show `l?????????` for a
# symlink it could not stat, exactly as GNU does.
fn _ls_mode_from_dtype(dt): i64 {
    if (dt == 4)  { return 16384; }   # DT_DIR  -> S_IFDIR
    if (dt == 8)  { return 32768; }   # DT_REG  -> S_IFREG
    if (dt == 10) { return 40960; }   # DT_LNK  -> S_IFLNK
    if (dt == 2)  { return 8192;  }   # DT_CHR  -> S_IFCHR
    if (dt == 6)  { return 24576; }   # DT_BLK  -> S_IFBLK
    if (dt == 1)  { return 4096;  }   # DT_FIFO -> S_IFIFO
    if (dt == 12) { return 49152; }   # DT_SOCK -> S_IFSOCK
    return 0;
}

fn _ls_rec_name(rec): i64 { return load64(rec); }
fn _ls_rec_st(rec): i64   { return rec + 8; }
fn _ls_rec_link_target(rec): i64       { return load64(rec + 152); }
fn _ls_rec_set_link_target(rec, t): i64 {
    store64(rec + 152, t);
    return 0;
}

# --- rendering helpers (ls-internal; cross-utility shared lib lands
#     when a third consumer asks) ---

fn _ls_render_dec(v, buf): i64 {
    if (v == 0) { store8(buf, 48); return 1; }
    var tmp[32];
    var n: i64 = 0;
    var rem = v;
    while (rem > 0) {
        store8(&tmp + n, 48 + (rem - (rem / 10) * 10));
        rem = rem / 10;
        n = n + 1;
    }
    var i: i64 = 0;
    while (i < n) {
        store8(buf + i, load8(&tmp + n - 1 - i));
        i = i + 1;
    }
    return n;
}

# Number of decimal digits needed to render `v`.
fn _ls_dec_width(v): i64 {
    if (v == 0) { return 1; }
    var w: i64 = 0;
    var rem = v;
    while (rem > 0) {
        w = w + 1;
        rem = rem / 10;
    }
    return w;
}

# Emit `v` as decimal right-justified to `width` characters with
# leading space padding.
fn _ls_emit_dec_padded(v, width): i64 {
    var buf[32];
    var n = _ls_render_dec(v, &buf);
    var pad = width - n;
    var sp[2];
    store8(&sp, 32);
    while (pad > 0) {
        k_write( 1, &sp, 1);
        pad = pad - 1;
    }
    k_write( 1, &buf, n);
    return 0;
}

# Emit `s` LEFT-justified in a `width` column.
#
# ⛔ Left, where every other column in `-l` is right-justified, because that is
# what GNU does — and it does BOTH, in the SAME column: a resolved NAME is
# left-aligned and an unresolvable NUMERIC id is right-aligned. Measured on
# coreutils 9.4 and 9.11, a listing mixing the two renders
#     -rw-r--r-- 1 root                  root                   0 ...
#     -rw-r--r-- 1                  4242                   4343 0 ...
# ⚠ Guessing one rule for the column would be wrong half the time.
fn _ls_emit_str_padded(s, width): i64 {
    var n = strlen(s);
    k_write( 1, s, n);
    var pad = width - n;
    var sp[2];
    store8(&sp, 32);
    while (pad > 0) {
        k_write( 1, &sp, 1);
        pad = pad - 1;
    }
    return 0;
}

# Column width contributed by one owner/group cell.
# ⛔ An EMPTY name falls back to the NUMBER here, and ONLY here. gnulib's
# `idcache.c getuser()` ends `return match->name[0] ? match->name : NULL;` so
# `ls` treats a zero-length name as no name — while `stat.c` calls getpwuid
# directly and guards only NULL, so `stat -c %U` prints the empty string.
# Measured on a `:x:8104:8104::/h:/s` entry: GNU `ls -l` shows `8104` and GNU
# `stat -c %U` shows nothing. ⚠ Coreutils is inconsistent with ITSELF here, so
# pushing the guard down into userdb would make kriya's `stat` print `UNKNOWN`
# and REGRESS a case that already matched.
fn _ls_owner_name(id, is_user): i64 {
    var nm: i64 = 0;
    if (is_user == 1) { nm = userdb_user_name(id); }
    else { nm = userdb_group_name(id); }
    if (nm == 0) { return 0; }
    if (load8(nm) == 0) { return 0; }
    return nm;
}

fn _ls_owner_width(id, numeric, is_user): i64 {
    if (numeric == 0) {
        var nm = _ls_owner_name(id, is_user);
        if (nm != 0) { return strlen(nm); }
    }
    return _ls_dec_width(id);
}

# Emit one owner/group cell, name-or-number, with the alignment that shape
# implies. ⚠ `-n` forces the numeric branch even when a name exists.
fn _ls_emit_owner(id, width, numeric, is_user): i64 {
    if (numeric == 0) {
        var nm = _ls_owner_name(id, is_user);
        if (nm != 0) { return _ls_emit_str_padded(nm, width); }
    }
    return _ls_emit_dec_padded(id, width);
}

# Symbolic permissions (10-byte sequence: type + ugo rwx triples).
# Right-align a single `?` in a `width` column, matching the numeric emitters.
fn _ls_emit_q_padded(width): i64 {
    var pad = width - 1;
    while (pad > 0) { k_write( 1, " ", 1); pad = pad - 1; }
    k_write( 1, "?", 1);
    return 0;
}

fn _ls_render_symperm(mode, buf): i64 {
    var typ = mode & 61440;
    var c: i64 = 45;  # '-'
    if (typ == 16384) { c = 100; }
    if (typ == 40960) { c = 108; }
    if (typ == 8192)  { c = 99;  }
    if (typ == 24576) { c = 98;  }
    if (typ == 4096)  { c = 112; }
    if (typ == 49152) { c = 115; }
    store8(buf, c);

    var dash: i64 = 45;
    if ((mode & 256) != 0) { store8(buf + 1, 114); } else { store8(buf + 1, dash); }
    if ((mode & 128) != 0) { store8(buf + 2, 119); } else { store8(buf + 2, dash); }
    var ux = mode & 64;
    var setuid = mode & 2048;
    if (setuid != 0) {
        if (ux != 0) { store8(buf + 3, 115); } else { store8(buf + 3, 83); }
    } else {
        if (ux != 0) { store8(buf + 3, 120); } else { store8(buf + 3, dash); }
    }
    if ((mode & 32) != 0) { store8(buf + 4, 114); } else { store8(buf + 4, dash); }
    if ((mode & 16) != 0) { store8(buf + 5, 119); } else { store8(buf + 5, dash); }
    var gx = mode & 8;
    var setgid = mode & 1024;
    if (setgid != 0) {
        if (gx != 0) { store8(buf + 6, 115); } else { store8(buf + 6, 83); }
    } else {
        if (gx != 0) { store8(buf + 6, 120); } else { store8(buf + 6, dash); }
    }
    if ((mode & 4) != 0) { store8(buf + 7, 114); } else { store8(buf + 7, dash); }
    if ((mode & 2) != 0) { store8(buf + 8, 119); } else { store8(buf + 8, dash); }
    var ox = mode & 1;
    var sticky = mode & 512;
    if (sticky != 0) {
        if (ox != 0) { store8(buf + 9, 116); } else { store8(buf + 9, 84); }
    } else {
        if (ox != 0) { store8(buf + 9, 120); } else { store8(buf + 9, dash); }
    }
    return 10;
}

# Human-readable size: writes up to 6 bytes (e.g. "1.5K", "999", "10G").
# Rule: under 1024 → bare integer. Otherwise divide by 1024 with the
# appropriate suffix from BKMGTP; if quotient < 10 emit "X.XS", else
# integer + suffix. Matches GNU `ls -h` "smart rounding".
fn _ls_render_human(v, buf): i64 {
    var thresholds = "BKMGTP";
    var unit: i64 = 0;
    var val = v;
    var rem10: i64 = 0;  # tenths
    while (val >= 1024) {
        # Carry the next decimal digit when we'll need < 10 output.
        rem10 = ((val - (val / 1024) * 1024) * 10) / 1024;
        val = val / 1024;
        unit = unit + 1;
    }
    var n = _ls_render_dec(val, buf);
    if (unit > 0) {
        if (val < 10) {
            store8(buf + n, 46);  # '.'
            store8(buf + n + 1, 48 + rem10);
            n = n + 2;
        }
        store8(buf + n, load8(thresholds + unit));
        n = n + 1;
    }
    return n;
}

# Emit `v` as human-readable size right-justified to `width`.
fn _ls_emit_human_padded(v, width): i64 {
    var buf[16];
    var n = _ls_render_human(v, &buf);
    var pad = width - n;
    var sp[2];
    store8(&sp, 32);
    while (pad > 0) {
        k_write( 1, &sp, 1);
        pad = pad - 1;
    }
    k_write( 1, &buf, n);
    return 0;
}

fn _ls_human_width(v): i64 {
    var buf[16];
    return _ls_render_human(v, &buf);
}

# Emit `YYYY-MM-DD HH:MM ` (17 chars including trailing space) for the
# given epoch. Uses chrono's `epoch_to_date`.
fn _ls_emit_mtime(epoch): i64 {
    var d = epoch_to_date(epoch);
    var buf[20];
    var year  = load64(d);
    var month = load64(d + 8);
    var day   = load64(d + 16);
    var hour  = load64(d + 24);
    var min   = load64(d + 32);
    # Year: 4 digits.
    store8(&buf + 0, 48 + (year / 1000));
    store8(&buf + 1, 48 + ((year / 100) - ((year / 1000) * 10)));
    store8(&buf + 2, 48 + ((year / 10) - ((year / 100) * 10)));
    store8(&buf + 3, 48 + (year - (year / 10) * 10));
    store8(&buf + 4, 45);  # '-'
    store8(&buf + 5, 48 + (month / 10));
    store8(&buf + 6, 48 + (month - (month / 10) * 10));
    store8(&buf + 7, 45);  # '-'
    store8(&buf + 8, 48 + (day / 10));
    store8(&buf + 9, 48 + (day - (day / 10) * 10));
    store8(&buf + 10, 32);  # ' '
    store8(&buf + 11, 48 + (hour / 10));
    store8(&buf + 12, 48 + (hour - (hour / 10) * 10));
    store8(&buf + 13, 58);  # ':'
    store8(&buf + 14, 48 + (min / 10));
    store8(&buf + 15, 48 + (min - (min / 10) * 10));
    store8(&buf + 16, 32);  # trailing space
    k_write( 1, &buf, 17);
    return 0;
}

# Append a `-F`-style type suffix character (returns the byte written,
# or 0 if none).
fn _ls_type_suffix(st): i64 {
    var m = load64(st + 24);
    if ((m & 61440) == 16384) { return 47; }   # / dir
    if ((m & 61440) == 40960) { return 64; }   # @ symlink
    if ((m & 61440) == 4096)  { return 124; }  # | fifo
    if ((m & 61440) == 49152) { return 61; }   # = socket
    if ((m & 61440) == 32768) {
        # Regular file: '*' if any execute bit is set.
        if ((m & 73) != 0) { return 42; }  # 73 = 64|8|1 (ux|gx|ox)
    }
    return 0;
}

fn _ls_emit_suffix(st): i64 {
    var c = _ls_type_suffix(st);
    if (c != 0) {
        var sb[2];
        store8(&sb, c);
        k_write( 1, &sb, 1);
    }
    return 0;
}

# Read and cache the symlink target into the record (for -l rendering).
fn _ls_load_link_target(parent_dirfd, rec): i64 {
    # ⛔ Also decide whether the link is BROKEN, because `or` needs it and this
    # is the only place with both the dirfd and the name. ⚠ Gated on colour
    # being active AND `or` actually being set: it costs one extra stat per
    # symlink, and the non-colour path should not pay for a colour feature.
    # ⛔ `or` or `mi` being COLOURABLE is the switch that makes GNU stat the
    # target — and, having stat'd it, colour the `-l` target text by the
    # TARGET's own type. ⚠ Neither `mi=00` nor `mi=` counts, and a real
    # `dircolors -b` emits no `mi` at all; but it DOES emit `or`, so this is an
    # ordinary-user path rather than an exotic one.
    if (_ls_color == 1) {
        # ⚠ SET, not colourable: `or=0` still makes GNU stat the target and
        # colour it, even though `or=0` does not colour the link NAME.
        var want: i64 = 0;
        if (_ls_code(LSK_OR) != 0) { want = 1; }
        if (_ls_code(LSK_MI) != 0) { want = 1; }
        if (want == 1) {
            var tst[FS_STAT_BUFSZ];
            # flags 0 = FOLLOW, the opposite of `fs_lstat_at`'s 256.
            #ifndef CYRIUS_TARGET_AGNOS
            if (syscall(262, parent_dirfd, _ls_rec_name(rec), &tst, 0) != 0) {
                store64(rec + 168, 1);
                # ⚠ A MISSING target takes `mi` when set and falls back to `or`
                # — not to nothing. With `or=31` and no `mi`, GNU paints the
                # target text `31` just like the link name.
                var mc2 = _ls_code(LSK_MI);
                if (mc2 == 0) { mc2 = _ls_code(LSK_OR); }
                store64(rec + 176, mc2);
            } else {
                store64(rec + 176, _ls_color_for_stat(&tst, _ls_rec_name(rec), 0, 0));
            }
            #endif
        }
    }
    if (_ls_rec_link_target(rec) != 0) { return 0; }
    var buf = alloc(4096);
    var n = fs_readlinkat(parent_dirfd, _ls_rec_name(rec), buf, 4095);
    if (n < 0) { return n; }
    store8(buf + n, 0);
    _ls_rec_set_link_target(rec, buf);
    return 0;
}

# --- colour (1.5.2) ----------------------------------------------------
#
# ⛔ THERE IS A BUILT-IN TABLE, AND IT IS GATED ON LS_COLORS BEING NON-EMPTY.
# This took two passes to get right and the first reading was wrong. With
# `LS_COLORS` unset or empty, GNU's `ls --color=always` emits NO escapes at all
# — which looks exactly like "there is no default table". But set it to any
# valid key at all, even one that colours nothing (`rs=0`), and directories
# come out `01;34`: the compiled-in defaults are loaded and the variable is
# overlaid on top. So kriya needs both the table AND the gate.
#
# ⚠ `dircolors -p` is NOT the source of those defaults and disagrees with them:
# it gives `BLK 40;33;01` and `FIFO 40;33` where `ls`'s own defaults are `01;33`
# and `33`. The values below were measured out of `ls` itself, on stock
# coreutils 9.4 in a container as well as 9.11 here.
#
# ⚠ Reading it needs `kriya_getenv`, not the stdlib's: a `dircolors -b` value is
# ~1.9 KB and the stdlib scans only the first 8 KB of the environment, so
# whether the variable was found would depend on where the shell placed it.
# See `src/lib/env.cyr`.

enum LsColorWhen {
    LS_CW_NEVER  = 0;
    LS_CW_ALWAYS = 1;
    LS_CW_AUTO   = 2;
}

# Type keys, in the order `_ls_color_for` tests them.
enum LsColorKey {
    LSK_RS = 0;    # reset (the lazy leading prefix)
    LSK_NO = 1;    # normal — the fallback for anything unmatched
    LSK_FI = 2;    # regular file
    LSK_DI = 3;    # directory
    LSK_LN = 4;    # symlink
    LSK_PI = 5;    # fifo
    LSK_SO = 6;    # socket
    LSK_BD = 7;    # block device
    LSK_CD = 8;    # char device
    LSK_OR = 9;    # orphaned (broken) symlink
    LSK_MI = 10;   # missing target
    LSK_EX = 11;   # executable
    LSK_SU = 12;   # setuid
    LSK_SG = 13;   # setgid
    LSK_ST = 14;   # sticky
    LSK_OW = 15;   # other-writable
    LSK_TW = 16;   # sticky AND other-writable
    LSK_COUNT = 17;
}

var _ls_color      = 0;   # 1 = emit escapes
var _ls_color_init = 0;   # 0 = LS_COLORS not parsed yet
var _ls_ckey       = 0;   # LSK_COUNT slots: code cstring, or 0
var _ls_cext       = 0;   # 2 slots per entry: extension cstring, code cstring
var _ls_cext_n     = 0;
var _ls_color_lead = 0;   # 1 = the leading reset has been emitted

# Map a two-letter LS_COLORS key to an LSK_* slot, or (0 - 1).
fn _ls_ckey_index(a, b): i64 {
    if (a == 114) { if (b == 115) { return LSK_RS; } }   # rs
    if (a == 110) { if (b == 111) { return LSK_NO; } }   # no
    if (a == 102) { if (b == 105) { return LSK_FI; } }   # fi
    if (a == 100) { if (b == 105) { return LSK_DI; } }   # di
    if (a == 108) { if (b == 110) { return LSK_LN; } }   # ln
    if (a == 112) { if (b == 105) { return LSK_PI; } }   # pi
    if (a == 115) { if (b == 111) { return LSK_SO; } }   # so
    if (a == 98)  { if (b == 100) { return LSK_BD; } }   # bd
    if (a == 99)  { if (b == 100) { return LSK_CD; } }   # cd
    if (a == 111) { if (b == 114) { return LSK_OR; } }   # or
    if (a == 109) { if (b == 105) { return LSK_MI; } }   # mi
    if (a == 101) { if (b == 120) { return LSK_EX; } }   # ex
    if (a == 115) { if (b == 117) { return LSK_SU; } }   # su
    if (a == 115) { if (b == 103) { return LSK_SG; } }   # sg
    if (a == 115) { if (b == 116) { return LSK_ST; } }   # st
    if (a == 111) { if (b == 119) { return LSK_OW; } }   # ow
    if (a == 116) { if (b == 119) { return LSK_TW; } }   # tw
    return 0 - 1;
}

# Parse LS_COLORS once. ⚠ Parsed IN PLACE in a private copy: each `=` and `:`
# becomes a NUL so keys and values are plain cstrings pointing into it.
fn _ls_color_load(): i64 {
    if (_ls_color_init == 1) { return 0; }
    _ls_color_init = 1;
    _ls_ckey = alloc(LSK_COUNT * 8);
    var z: i64 = 0;
    while (z < LSK_COUNT) {
        store64(_ls_ckey + z * 8, 0);
        z = z + 1;
    }
    var env = kriya_getenv("LS_COLORS");
    if (env == 0) { return 0; }
    var n = strlen(env);
    if (n == 0) { return 0; }
    # ⭐ Non-empty: load the compiled-in defaults, then let the variable
    # overlay them. ⚠ `fi`, `or`, `mi` and `no` default to UNSET, not to a
    # code — a plain file is uncoloured, and a broken symlink falls through to
    # `ln`, which is why `or` looks like it defaults to `01;36`.
    store64(_ls_ckey + LSK_RS * 8, "0");
    store64(_ls_ckey + LSK_DI * 8, "01;34");
    store64(_ls_ckey + LSK_LN * 8, "01;36");
    store64(_ls_ckey + LSK_SO * 8, "01;35");
    store64(_ls_ckey + LSK_PI * 8, "33");
    store64(_ls_ckey + LSK_BD * 8, "01;33");
    store64(_ls_ckey + LSK_CD * 8, "01;33");
    store64(_ls_ckey + LSK_EX * 8, "01;32");
    store64(_ls_ckey + LSK_SU * 8, "37;41");
    store64(_ls_ckey + LSK_SG * 8, "30;43");
    store64(_ls_ckey + LSK_ST * 8, "37;44");
    store64(_ls_ckey + LSK_OW * 8, "34;42");
    store64(_ls_ckey + LSK_TW * 8, "30;42");
    var buf = alloc(n + 1);
    memcpy(buf, env, n + 1);
    # Worst case every item is an extension.
    _ls_cext = alloc((n + 1) * 16);
    var i: i64 = 0;
    while (i <= n) {
        # One item spans [i, e) where e is the next `:` or the end.
        var e = i;
        var scan: i64 = 1;
        while (scan == 1) {
            if (e >= n) { scan = 0; }
            elif (load8(buf + e) == 58) { scan = 0; }
            else { e = e + 1; }
        }
        if (e > i) {
            # Split on the first `=`.
            var q = i;
            var eqp: i64 = 0 - 1;
            while (q < e) {
                if (load8(buf + q) == 61) {
                    if (eqp < 0) { eqp = q; }
                }
                q = q + 1;
            }
            if (eqp > i) {
                store8(buf + eqp, 0);
                store8(buf + e, 0);
                var key = buf + i;
                var val = buf + eqp + 1;
                if (load8(key) == 42) {
                    # `*.ext=CODE` — the pattern includes the dot.
                    store64(_ls_cext + _ls_cext_n * 16, key + 1);
                    store64(_ls_cext + _ls_cext_n * 16 + 8, val);
                    _ls_cext_n = _ls_cext_n + 1;
                } else {
                    var ki = _ls_ckey_index(load8(key), load8(key + 1));
                    # ⚠ An unknown two-letter key is IGNORED rather than fatal.
                    # GNU prints a diagnostic and disables colour entirely; kriya
                    # ignores the item and colours the rest (roadmap 1.5.4).
                    if (ki >= 0) {
                        if (load8(key + 2) == 0) { store64(_ls_ckey + ki * 8, val); }
                    }
                }
            }
        }
        i = e + 1;
    }
    return 0;
}

fn _ls_code(k): i64 {
    if (_ls_ckey == 0) { return 0; }
    return load64(_ls_ckey + k * 8);
}

# ⛔ GNU's `is_colored()`: a code of "", "0" or "00" counts as NOT coloured.
# ⚠ AND IT GATES ONLY THE SUB-TYPE SELECTION, not the lookup — that distinction
# took a fuzz to find. `di=0` still emits `ESC[0m` around a directory, but
# `ow=0` falls THROUGH to `di`, because the other-writable branch asks
# `is_colored(ow)` before choosing it. Same for `st`/`tw`, for `su`/`sg`/`ex` on
# a regular file, and for the `no` prefix. Filtering it inside `_ls_code`
# instead — the obvious place — makes `di=0` print an uncoloured name.
fn _ls_is_colored(k): i64 {
    var c = _ls_code(k);
    if (c == 0) { return 0; }
    var l = strlen(c);
    if (l == 0) { return 0; }
    if (l == 1) {
        if (load8(c) == 48) { return 0; }
    }
    if (l == 2) {
        if (load8(c) == 48) {
            if (load8(c + 1) == 48) { return 0; }
        }
    }
    return 1;
}

# Does `name` end with `ext`? `fold` = 1 compares case-insensitively.
fn _ls_ext_match(name, ext, fold): i64 {
    var nl = strlen(name);
    var el = strlen(ext);
    if (el == 0) { return 0; }
    if (el > nl) { return 0; }
    var i: i64 = 0;
    while (i < el) {
        var a = load8(name + nl - el + i);
        var b = load8(ext + i);
        if (fold == 1) {
            a = icase_to_lower(a);
            b = icase_to_lower(b);
        }
        if (a != b) { return 0; }
        i = i + 1;
    }
    return 1;
}

# ⚠ Exact case first, then case-insensitive. Measured: `*.c` alone also matches
# `t.C`, but defining BOTH `*.c` and `*.C` makes each match its own case — which
# is exactly what a two-pass exact-then-folded search produces.
# ⚠ The LAST match in LS_COLORS order wins, not the first and not the longest:
# with `*.tar.gz=01;32:*.gz=33`, GNU colours `t.tar.gz` with `33`. Exact case is
# still preferred over a folded match, which is what makes `*.c` alone match
# `t.C` while defining both `*.c` and `*.C` keeps each exact.
fn _ls_ext_code(name): i64 {
    var found: i64 = 0;
    var i: i64 = 0;
    while (i < _ls_cext_n) {
        if (_ls_ext_match(name, load64(_ls_cext + i * 16), 0) == 1) {
            found = load64(_ls_cext + i * 16 + 8);
        }
        i = i + 1;
    }
    if (found != 0) { return found; }
    i = 0;
    while (i < _ls_cext_n) {
        if (_ls_ext_match(name, load64(_ls_cext + i * 16), 1) == 1) {
            found = load64(_ls_cext + i * 16 + 8);
        }
        i = i + 1;
    }
    return found;
}

# Which colour code applies to this entry, or 0 for none.
#
# ⛔ The precedence is measured, not guessed: `tw`/`ow`/`st` override `di`, and
# for a regular file `su`/`sg`/`ex` beat an EXTENSION match, which beats `fi`.
# An executable `run.c` takes `ex`; a non-executable `plain.c` takes `*.c`.
fn _ls_color_for(rec): i64 {
    return _ls_color_for_stat(_ls_rec_st(rec), _ls_rec_name(rec),
                              _ls_rec_bad(rec), _ls_rec_broken(rec));
}

fn _ls_color_for_stat(st, name, bad, broken): i64 {
    var mode = load64(st + 24);
    if (bad == 1) {
        var mc = _ls_code(LSK_MI);
        if (mc != 0) { return mc; }
        return _ls_code(LSK_OR);
    }
    if (fs_is_dir(st) == 1) {
        var other_w: i64 = 0;
        if ((mode & 2) != 0) { other_w = 1; }
        var sticky: i64 = 0;
        if ((mode & 512) != 0) { sticky = 1; }
        if (other_w == 1) {
            if (sticky == 1) {
                if (_ls_is_colored(LSK_TW) == 1) { return _ls_code(LSK_TW); }
            }
            if (_ls_is_colored(LSK_OW) == 1) { return _ls_code(LSK_OW); }
        } elif (sticky == 1) {
            if (_ls_is_colored(LSK_ST) == 1) { return _ls_code(LSK_ST); }
        }
        return _ls_code(LSK_DI);
    }
    if (fs_is_lnk(st) == 1) {
        # ⚠ `or` applies only when it is SET *and* the target does not resolve.
        # Unset, a broken link takes `ln` like any other — which is why `or`
        # appears to default to `01;36`.
        if (broken == 1) {
            if (_ls_is_colored(LSK_OR) == 1) { return _ls_code(LSK_OR); }
        }
        return _ls_code(LSK_LN);
    }
    # ⚠ `fs.cyr` exposes predicates for reg/dir/lnk only, so the remaining
    # types are tested against `FS_S_IFMT` directly rather than adding four
    # one-line helpers for a single caller.
    var ty = mode & FS_S_IFMT;
    if (ty == FS_S_IFIFO) { return _ls_code(LSK_PI); }
    if (ty == FS_S_IFSOCK) { return _ls_code(LSK_SO); }
    if (ty == FS_S_IFBLK) { return _ls_code(LSK_BD); }
    if (ty == FS_S_IFCHR) { return _ls_code(LSK_CD); }
    if ((mode & 2048) != 0) {
        if (_ls_is_colored(LSK_SU) == 1) { return _ls_code(LSK_SU); }
    }
    if ((mode & 1024) != 0) {
        if (_ls_is_colored(LSK_SG) == 1) { return _ls_code(LSK_SG); }
    }
    if ((mode & 73) != 0) {
        if (_ls_is_colored(LSK_EX) == 1) { return _ls_code(LSK_EX); }
    }
    var xc = _ls_ext_code(name);
    if (xc != 0) { return xc; }
    return _ls_code(LSK_FI);
}

# Emit one entry's NAME, wrapped in its colour when one applies.
#
# ⚠ The leading reset is LAZY — emitted once, before the first COLOURED entry,
# and never at all if nothing is coloured. Measured: listing only plain files
# with `di` set produces no escape bytes whatsoever. `rs=` overrides its code.
# ⚠ The `-F` type indicator is written by the CALLER, after this returns, which
# is what puts it OUTSIDE the escape exactly as GNU does.
# ⚠ Cyrius string literals have no octal escape: `"\033["` is NOT `ESC [`, it is
# a NUL followed by `3`. The byte is built explicitly instead — caught by a
# byte-exact comparison against GNU, which is the only kind that would.
fn _ls_emit_csi(): i64 {
    var b[2];
    store8(&b, 27);
    k_write( 1, &b, 1);
    k_write( 1, "[", 1);
    return 0;
}

# Write the (possibly quoted) name bytes. ⚠ One place, so colour and quoting
# cannot disagree about what the name is.
fn _ls_put_name(name, nlen): i64 {
    if (_ls_quote == 0) {
        k_write( 1, name, nlen);
        return 0;
    }
    var st = QUOTE_IF_NEEDED;
    if (_ls_quote == 2) { st = QUOTE_ALWAYS; }
    var qb = alloc(quote_bufsz(nlen));
    var qn = quote_shell(name, nlen, st, qb);
    k_write( 1, qb, qn);
    return 0;
}

# Display width of a name once quoting is applied — ⛔ NOT `strlen`. A quoted
# name is longer, and the column layout has to reserve the width it will
# actually occupy or the columns tear.
# Would this name come out quoted? ⚠ Asked by the `-l` alignment pass, which
# needs to know before any name is emitted.
fn _ls_name_is_quoted(name): i64 {
    if (_ls_quote == 0) { return 0; }
    if (_ls_quote == 2) { return 1; }
    var nlen = strlen(name);
    var qb = alloc(quote_bufsz(nlen));
    if (quote_shell(name, nlen, QUOTE_IF_NEEDED, qb) != nlen) { return 1; }
    return 0;
}

fn _ls_name_width(name): i64 {
    var nlen = strlen(name);
    if (_ls_quote == 0) { return nlen; }
    var st = QUOTE_IF_NEEDED;
    if (_ls_quote == 2) { st = QUOTE_ALWAYS; }
    var qb = alloc(quote_bufsz(nlen));
    return quote_shell(name, nlen, st, qb);
}

fn _ls_emit_name(rec): i64 {
    var name = _ls_rec_name(rec);
    var nlen = strlen(name);
    if (_ls_color == 0) {
        return _ls_put_name(name, nlen);
    }
    var code = _ls_color_for(rec);
    if (code == 0) {
        # ⚠ The `no` fallback takes the same `is_colored` gate: `no=0` means the
        # entry is left PLAIN, not wrapped in `ESC[0m`.
        if (_ls_is_colored(LSK_NO) == 1) { code = _ls_code(LSK_NO); }
    }
    if (code == 0) {
        return _ls_put_name(name, nlen);
    }
    if (_ls_color_lead == 0) {
        _ls_color_lead = 1;
        _ls_emit_csi();
        var rs = _ls_code(LSK_RS);
        if (rs != 0) { k_write( 1, rs, strlen(rs)); }
        else { k_write( 1, "0", 1); }
        k_write( 1, "m", 1);
    }
    # ⛔ When `no` (normal) is set, GNU restores it and then CLEARS before
    # applying the entry's own colour: `ESC[<no>m ESC[m ESC[<code>m name`.
    # ⚠ An entry that takes `no` ITSELF gets no such prefix — just `no`. The
    # empty `ESC[m` in the middle is not a typo; it is what GNU writes.
    var nc = _ls_code(LSK_NO);
    if (_ls_is_colored(LSK_NO) == 1) {
        if (code != nc) {
            _ls_emit_csi();
            k_write( 1, nc, strlen(nc));
            k_write( 1, "m", 1);
            _ls_emit_csi();
            k_write( 1, "m", 1);
        }
    }
    _ls_emit_csi();
    k_write( 1, code, strlen(code));
    k_write( 1, "m", 1);
    _ls_put_name(name, nlen);
    # ⚠ The trailing reset uses `rs` too when it is set: with `rs=99`, GNU
    # closes with `ESC[99m`, not `ESC[0m`.
    _ls_emit_csi();
    var rs2 = _ls_code(LSK_RS);
    if (rs2 != 0) { k_write( 1, rs2, strlen(rs2)); }
    else { k_write( 1, "0", 1); }
    k_write( 1, "m", 1);
    return 0;
}

# --- collection + sorting ---

# ⭐ The sort key, resolved from the command line rather than from a pair of
# booleans. `flags_get_bool` answers "was it given", and GNU resolves `-t` vs
# `-S` by ORDER: `ls -tS` sorts by SIZE and `ls -St` by TIME. Measured.
enum LsSortKey {
    LS_SORT_NAME = 0;
    LS_SORT_TIME = 1;
    LS_SORT_SIZE = 2;
}
var _ls_sortkey = 0;

# Three-way byte-comparison: < 0 if a<b, 0 if equal, > 0 if a>b.
# Cyrius stdlib only exposes `streq`; we need ordering for the sort.
fn _ls_strcmp(a, b): i64 {
    var i: i64 = 0;
    while (1 == 1) {
        var ca = load8(a + i);
        var cb = load8(b + i);
        if (ca != cb) { return ca - cb; }
        if (ca == 0) { return 0; }
        i = i + 1;
    }
    return 0;
}

# Which of `-t` / `-S` appeared LAST? ⚠ Both may be given, and the answer is
# not "whichever is set" — GNU takes the rightmost, so `ls -tS` is a SIZE sort
# and `ls -St` a TIME sort.
#
# ⛔ Asks the PARSER via `kriya_short_seq` rather than re-scanning argv here.
# The first version of this walked the raw argv bounded by
# `kriya_argv_option_end`, which stops at the first operand — while the parser
# permutes. `ls aa bb cc -rt` therefore honoured the `-r` and SILENTLY DROPPED
# the `-t` from the same cluster, sorting by name and exiting 0.
fn _ls_pick_sortkey(): i64 {
    var st = kriya_short_seq(_ls_spec, 116);   # -t
    var ss = kriya_short_seq(_ls_spec, 83);    # -S
    if (st == 0) {
        if (ss == 0) { return LS_SORT_NAME; }
        return LS_SORT_SIZE;
    }
    if (ss == 0) { return LS_SORT_TIME; }
    if (ss > st) { return LS_SORT_SIZE; }
    return LS_SORT_TIME;
}

# Three-way order of two entries under the active sort key: negative when `a`
# sorts first.
#
# ⭐ EVERY key falls through to the NAME comparison, which is what makes the
# order total: two distinct entries never compare equal, so `-r` is a true
# reversal rather than a stable-sort artefact. Measured against GNU — three
# files given an EXACT mtime tie come out `alpha mid zeta` under `-t` and
# `zeta mid alpha` under `-tr`, so the tie-break reverses too.
#
# ⚠ `-t` compares NANOSECONDS as well as seconds: two files one nanosecond
# apart sort correctly in GNU, so comparing `st_mtime` alone would be a silent
# wrong order on any filesystem with sub-second stamps.
fn _ls_cmp(a, b): i64 {
    if (_ls_sortkey == LS_SORT_TIME) {
        var ta = load64(_ls_rec_st(a) + FS_STAT_MTIME);
        var tb = load64(_ls_rec_st(b) + FS_STAT_MTIME);
        if (ta != tb) {
            if (ta > tb) { return 0 - 1; }      # newest first
            return 1;
        }
        var na = load64(_ls_rec_st(a) + FS_STAT_MTIME_NSEC);
        var nb = load64(_ls_rec_st(b) + FS_STAT_MTIME_NSEC);
        if (na != nb) {
            if (na > nb) { return 0 - 1; }
            return 1;
        }
    }
    if (_ls_sortkey == LS_SORT_SIZE) {
        var sa = load64(_ls_rec_st(a) + FS_STAT_SIZE);
        var sb = load64(_ls_rec_st(b) + FS_STAT_SIZE);
        if (sa != sb) {
            if (sa > sb) { return 0 - 1; }      # largest first
            return 1;
        }
    }
    return _ls_strcmp(_ls_rec_name(a), _ls_rec_name(b));
}

# Bottom-up merge sort. `reverse` negates the comparator.
#
# ⛔ Was an INSERTION sort, which is O(n^2) and showed it: `ls` over an
# 8,000-entry directory took 0.755 s against GNU's 0.004 s — a 190x gap on a
# directory size that is not unusual. The comparator had to be restructured for
# `-t`/`-S` anyway, and leaving a quadratic sort inside the release that is
# ABOUT sorting would have been an odd place to draw the line.
fn _ls_sort(entries, reverse): i64 {
    var n = vec_len(entries);
    if (n < 2) { return 0; }
    var src = alloc(n * 8);
    var dst = alloc(n * 8);
    var i: i64 = 0;
    while (i < n) {
        store64(src + i * 8, vec_get(entries, i));
        i = i + 1;
    }
    var width: i64 = 1;
    while (width < n) {
        var lo: i64 = 0;
        while (lo < n) {
            var mid = lo + width;
            var hi = lo + width + width;
            if (mid > n) { mid = n; }
            if (hi > n)  { hi = n; }
            var ai = lo;
            var bi = mid;
            var o = lo;
            while (o < hi) {
                var take_a: i64 = 0;
                if (ai >= mid) { take_a = 0; }
                elif (bi >= hi) { take_a = 1; }
                else {
                    var c = _ls_cmp(load64(src + ai * 8), load64(src + bi * 8));
                    if (reverse == 1) { c = 0 - c; }
                    if (c <= 0) { take_a = 1; }
                }
                if (take_a == 1) {
                    store64(dst + o * 8, load64(src + ai * 8));
                    ai = ai + 1;
                } else {
                    store64(dst + o * 8, load64(src + bi * 8));
                    bi = bi + 1;
                }
                o = o + 1;
            }
            lo = lo + width + width;
        }
        var tmp = src;
        src = dst;
        dst = tmp;
        width = width + width;
    }
    i = 0;
    while (i < n) {
        vec_set(entries, i, load64(src + i * 8));
        i = i + 1;
    }
    return 0;
}

# Collect entries from `dir_path`. Returns a vec of records, or 0 on
# open failure (caller reports its own error).
fn _ls_collect(dir_path, all_mode, almost_all): i64 {
    var dir_fd = fs_openat(0 - 100, dir_path, 65536, 0);  # O_RDONLY | O_DIRECTORY
    if (dir_fd < 0) { return dir_fd; }

    var entries = vec_new();
    var dent_buf = alloc(4096);
    var loop: i64 = 1;
    while (loop == 1) {
        var nb = fs_getdents64(dir_fd, dent_buf, 4096);
        if (nb < 0) {
            if ((0 - nb) == 4) {
                # EINTR — retry.
            } else {
                fs_close(dir_fd);
                return nb;
            }
        } else {
            if (nb == 0) { loop = 0; }
            else {
                var off: i64 = 0;
                while (off < nb) {
                    var ent = dent_buf + off;
                    var reclen = fs_dent_reclen(ent);
                    var name = fs_dent_name(ent);
                    var is_dotdot = fs_dent_is_dotdot(ent);
                    var include_it: i64 = 1;
                    if (is_dotdot == 1) {
                        if (all_mode == 0) { include_it = 0; }
                        if (almost_all == 1) { include_it = 0; }
                    } else {
                        if (load8(name) == 46) {
                            if (all_mode == 0) {
                                if (almost_all == 0) { include_it = 0; }
                            }
                        }
                    }
                    if (include_it == 1) {
                        var nlen = strlen(name);
                        var name_copy = alloc(nlen + 1);
                        memcpy(name_copy, name, nlen + 1);
                        var rec = _ls_rec_new(name_copy);
                        var ent_fp = path_join(dir_path, name);
                        var sr = fs_stat_entry(dir_fd, ent_fp, name, _ls_rec_st(rec), 0);
                        if (sr != 0) {
                            # Keep the type from the dirent so the row still says
                            # WHAT it is; everything else becomes `?`.
                            _ls_rec_set_bad(rec);
                            store64(_ls_rec_st(rec) + 24, _ls_mode_from_dtype(fs_dent_type(ent)));
                            k_write( 2, "kriya ls: cannot access '", 25);
                            k_write( 2, ent_fp, strlen(ent_fp));
                            k_write( 2, "': ", 3);
                            if (errmsg_is_known(0 - sr) == 1) {
                                var em = errmsg_for(0 - sr);
                                k_write( 2, em, strlen(em));
                            } else {
                                k_write( 2, "cannot stat", 11);
                            }
                            k_write( 2, "\n", 1);
                            _ls_stat_failed = 1;
                        }
                        # Cache symlink target if it'll be needed by -l.
                        if (sr == 0) {
                            if (fs_is_lnk(_ls_rec_st(rec)) == 1) {
                                _ls_load_link_target(dir_fd, rec);
                            }
                        }
                        vec_push(entries, rec);
                    }
                    off = off + reclen;
                }
            }
        }
    }
    fs_close(dir_fd);
    return entries;
}

# --- output ---

# Terminal width for multi-column packing. Priority: -w flag, then $COLUMNS, then the platform's
# live console geometry. Returns 0 to mean "not a terminal / unknown" → the caller falls back to
# one-per-line (script-safe, matching GNU ls piped output). An explicit -w or $COLUMNS forces
# columns even off a tty (a real GNU affordance + the host test hook).
fn _ls_term_width(): i64 {
    var wf = flags_get_int(_ls_spec, _ls_w_idx);
    if (wf > 0) { return wf; }
    var ce = kriya_getenv("COLUMNS");
    if (ce != 0) {
        var cw = atoi(ce);
        if (cw > 0) { return cw; }
    }
    #ifdef CYRIUS_TARGET_AGNOS
    # agnos has no isatty; winsize()#60 returns the live console grid as (cols<<16 | rows) from the
    # framebuffer geometry (same source kii/chakshu use), so we always column to the console.
    var packed = syscall(60);
    var acols = packed >> 16;
    if (acols > 0) { return acols; }
    return 80;
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    # Linux: only column to a real terminal (script-safe otherwise). ioctl(TIOCGWINSZ) → ws_col @2.
    if (k_isatty(1) == 0) { return 0; }
    var ws[8];
    var r = syscall(16, 1, 21523, &ws);              # SYS_IOCTL, TIOCGWINSZ = 0x5413
    if (r != 0) { return 80; }
    var lcols = load16(&ws + 2) & 65535;
    if (lcols > 0) { return lcols; }
    return 80;
    #endif
}

# Emit `n` spaces (column padding).
fn _ls_emit_spaces(n): i64 {
    var i: i64 = 0;
    while (i < n) { k_write( 1, " ", 1); i = i + 1; }
    return 0;
}

# Display width of one entry's cell: optional inode prefix (ino_w digits + a space), the name, and
# the -F type suffix if present. Matches exactly what _ls_print_columns emits per cell.
fn _ls_entry_width(rec, F_mode, inode_mode, ino_w): i64 {
    var dw = _ls_name_width(_ls_rec_name(rec));
    if (F_mode == 1) { if (_ls_type_suffix(_ls_rec_st(rec)) != 0) { dw = dw + 1; } }
    if (inode_mode == 1) { dw = dw + ino_w + 1; }
    return dw;
}

# GNU-style multi-column listing, COLUMN-major (fill down each column, then across) — the default
# `ls` layout to a terminal. Packs into the widest column count whose per-column widths + a 2-space
# gutter fit `width`; a single over-wide name degrades to one column.
fn _ls_print_columns(entries, F_mode, inode_mode, width): i64 {
    var n = vec_len(entries);
    if (n == 0) { return 0; }
    # Shared inode-column width (-i).
    var ino_w: i64 = 0;
    if (inode_mode == 1) {
        var i: i64 = 0;
        while (i < n) {
            var w = _ls_dec_width(load64(_ls_rec_st(vec_get(entries, i)) + 8));
            if (w > ino_w) { ino_w = w; }
            i = i + 1;
        }
    }
    # Per-entry display widths.
    var ew = alloc(n * 8);
    var i: i64 = 0;
    while (i < n) {
        store64(ew + i * 8, _ls_entry_width(vec_get(entries, i), F_mode, inode_mode, ino_w));
        i = i + 1;
    }
    var gutter: i64 = 2;
    # Column selection, matching GNU ls `calculate_columns` exactly. Iterate candidate COLUMN counts
    # c; the canonical row count for c columns is rows = ceil(n/c). SKIP "degenerate" counts whose
    # last column would be empty ((c-1)*rows >= n) — GNU never uses them (this is why d2's 5/6-column
    # layouts never appear). Each column reserves its widest entry + a 2-space gap for every column
    # EXCEPT the last, and every column is floored at MIN_COLUMN_WIDTH (3) — the floor only bites a
    # tiny final column. A layout is valid when its total reserved width is STRICTLY < the terminal
    # width. The most columns that fits wins; fall back to one column.
    var best_c: i64 = 1;
    var c: i64 = 1;
    while (c <= n) {
        var rows_c = (n + c - 1) / c;
        if (((c - 1) * rows_c) < n) {                       # non-degenerate: last column non-empty
            var total: i64 = 0;
            var k: i64 = 0;
            while (k < c) {
                var colmax: i64 = 0;
                var r: i64 = 0;
                while (r < rows_c) {
                    var idx = k * rows_c + r;
                    if (idx < n) {
                        var v = load64(ew + idx * 8);
                        if (v > colmax) { colmax = v; }
                    }
                    r = r + 1;
                }
                var field = colmax;
                if (k < c - 1) { field = colmax + gutter; }
                if (field < 3) { field = 3; }
                total = total + field;
                k = k + 1;
            }
            if (total < width) { best_c = c; }
        }
        c = c + 1;
    }
    var cols = best_c;
    var rows = (n + cols - 1) / cols;
    # Per-column max widths for the chosen layout.
    var colw = alloc(cols * 8);
    var k: i64 = 0;
    while (k < cols) {
        var colmax: i64 = 0;
        var r: i64 = 0;
        while (r < rows) {
            var idx = k * rows + r;
            if (idx < n) {
                var v = load64(ew + idx * 8);
                if (v > colmax) { colmax = v; }
            }
            r = r + 1;
        }
        store64(colw + k * 8, colmax);
        k = k + 1;
    }
    # Emit row by row; cell (row r, col k) is entry index k*rows + r (column-major).
    var r: i64 = 0;
    while (r < rows) {
        var last_k: i64 = 0;
        var kk: i64 = 0;
        while (kk < cols) {
            if (kk * rows + r < n) { last_k = kk; }
            kk = kk + 1;
        }
        var k2: i64 = 0;
        while (k2 <= last_k) {
            var idx = k2 * rows + r;
            if (idx < n) {
                var rec = vec_get(entries, idx);
                var st = _ls_rec_st(rec);
                if (inode_mode == 1) {
                    _ls_emit_dec_padded(load64(st + 8), ino_w);
                    k_write( 1, " ", 1);
                }
                _ls_emit_name(rec);
                if (F_mode == 1) { _ls_emit_suffix(st); }
                if (k2 < last_k) {
                    var pad = load64(colw + k2 * 8) - load64(ew + idx * 8);
                    _ls_emit_spaces(pad + gutter);
                }
            }
            k2 = k2 + 1;
        }
        k_write( 1, "\n", 1);
        r = r + 1;
    }
    return 0;
}

fn _ls_print_simple(entries, F_mode, inode_mode): i64 {
    # Default to GNU-style multi-column packing sized to the terminal; -1 forces one-per-line, and a
    # non-tty with no -w/$COLUMNS falls through to one-per-line (script-safe).
    var one_per_line = flags_get_bool(_ls_spec, _ls_1_idx);
    var width: i64 = 0;
    if (one_per_line == 0) { width = _ls_term_width(); }
    if (width > 0) { return _ls_print_columns(entries, F_mode, inode_mode, width); }

    var n = vec_len(entries);
    # Compute inode column width if -i.
    var ino_w: i64 = 0;
    if (inode_mode == 1) {
        var i: i64 = 0;
        while (i < n) {
            var rec = vec_get(entries, i);
            var w = _ls_dec_width(load64(_ls_rec_st(rec) + 8));
            if (w > ino_w) { ino_w = w; }
            i = i + 1;
        }
    }
    var i: i64 = 0;
    while (i < n) {
        var rec = vec_get(entries, i);
        var name = _ls_rec_name(rec);
        var st = _ls_rec_st(rec);
        if (inode_mode == 1) {
            _ls_emit_dec_padded(load64(st + 8), ino_w);
            k_write( 1, " ", 1);
        }
        _ls_emit_name(rec);
        if (F_mode == 1) { _ls_emit_suffix(st); }
        k_write( 1, "\n", 1);
        i = i + 1;
    }
    return 0;
}

fn _ls_print_long(entries, human, F_mode, inode_mode, numeric): i64 {
    var n = vec_len(entries);
    # Pass 1: compute widths.
    var w_nlink: i64 = 1;
    var w_uid:   i64 = 1;
    var w_gid:   i64 = 1;
    var w_size:  i64 = 1;
    var w_ino:   i64 = 1;
    var i: i64 = 0;
    while (i < n) {
        var rec = vec_get(entries, i);
        var st = _ls_rec_st(rec);
        if (_ls_rec_bad(rec) == 1) {
            # Every numeric field renders as a single `?`; contributing the
            # fabricated zeros here would pad the whole listing to their width.
            i = i + 1;
            continue;
        }
        var wn = _ls_dec_width(load64(st + 16));
        if (wn > w_nlink) { w_nlink = wn; }
        var wu = _ls_owner_width(load64(st + 28) & 4294967295, numeric, 1);
        if (wu > w_uid)   { w_uid = wu; }
        var wg = _ls_owner_width(load64(st + 32) & 4294967295, numeric, 0);
        if (wg > w_gid)   { w_gid = wg; }
        var sz: i64 = 0;
        if (human == 1) {
            sz = _ls_human_width(load64(st + 48));
        } else {
            sz = _ls_dec_width(load64(st + 48));
        }
        if (sz > w_size)  { w_size = sz; }
        if (inode_mode == 1) {
            var wi = _ls_dec_width(load64(st + 8));
            if (wi > w_ino) { w_ino = wi; }
        }
        i = i + 1;
    }
    # ⚠ Does any name in THIS listing quote? If so the unquoted ones are padded.
    _ls_long_qpad = 0;
    if (_ls_quote == 1) {
        var qi: i64 = 0;
        while (qi < n) {
            if (_ls_name_is_quoted(_ls_rec_name(vec_get(entries, qi))) == 1) {
                _ls_long_qpad = 1;
                qi = n;
            } else {
                qi = qi + 1;
            }
        }
    }
    # Pass 2: emit.
    i = 0;
    while (i < n) {
        var rec = vec_get(entries, i);
        var st = _ls_rec_st(rec);
        var name = _ls_rec_name(rec);
        var bad = _ls_rec_bad(rec);
        if (inode_mode == 1) {
            if (bad == 1) { _ls_emit_q_padded(w_ino); }
            else { _ls_emit_dec_padded(load64(st + 8), w_ino); }
            k_write( 1, " ", 1);
        }
        var perm_buf[16];
        _ls_render_symperm(load64(st + 24), &perm_buf);
        if (bad == 1) {
            # Type character survives (from the dirent); the nine permission
            # bits are genuinely unknown.
            var q: i64 = 1;
            while (q < 10) { store8(&perm_buf + q, 63); q = q + 1; }
        }
        k_write( 1, &perm_buf, 10);
        k_write( 1, " ", 1);
        if (bad == 1) {
            _ls_emit_q_padded(w_nlink); k_write( 1, " ", 1);
            _ls_emit_q_padded(w_uid);   k_write( 1, " ", 1);
            _ls_emit_q_padded(w_gid);   k_write( 1, " ", 1);
            _ls_emit_q_padded(w_size);  k_write( 1, " ", 1);
            k_write( 1, "               ? ", 17);      # mtime column, right-aligned
        } else {
            _ls_emit_dec_padded(load64(st + 16), w_nlink);
            k_write( 1, " ", 1);
            _ls_emit_owner(load64(st + 28) & 4294967295, w_uid, numeric, 1);
            k_write( 1, " ", 1);
            _ls_emit_owner(load64(st + 32) & 4294967295, w_gid, numeric, 0);
            k_write( 1, " ", 1);
            if (human == 1) {
                _ls_emit_human_padded(load64(st + 48), w_size);
            } else {
                _ls_emit_dec_padded(load64(st + 48), w_size);
            }
            k_write( 1, " ", 1);
            _ls_emit_mtime(load64(st + 88));
        }
        if (_ls_long_qpad == 1) {
            if (_ls_name_is_quoted(name) == 0) { k_write( 1, " ", 1); }
        }
        _ls_emit_name(rec);
        # Symlink target — QUOTED by the same rules as the name, and left
        # UNCOLOURED unless `or`/`mi` enabled target colouring.
        if (fs_is_lnk(st) == 1) {
            var tgt = _ls_rec_link_target(rec);
            if (tgt != 0) {
                k_write( 1, " -> ", 4);
                var tc = _ls_rec_tgt_code(rec);
                if (tc == 0) {
                    _ls_put_name(tgt, strlen(tgt));
                } else {
                    _ls_emit_csi();
                    k_write( 1, tc, strlen(tc));
                    k_write( 1, "m", 1);
                    _ls_put_name(tgt, strlen(tgt));
                    _ls_emit_csi();
                    var trs = _ls_code(LSK_RS);
                    if (trs != 0) { k_write( 1, trs, strlen(trs)); }
                    else { k_write( 1, "0", 1); }
                    k_write( 1, "m", 1);
                }
            }
        }
        if (F_mode == 1) { _ls_emit_suffix(st); }
        k_write( 1, "\n", 1);
        i = i + 1;
    }
    return 0;
}

fn _ls_print_dir(entries, long_mode, human, F_mode, inode_mode): i64 {
    if (long_mode == 1) {
        return _ls_print_long(entries, human, F_mode, inode_mode, _ls_numeric);
    }
    return _ls_print_simple(entries, F_mode, inode_mode);
}

# Print one directory's listing (and recurse if R_mode). `prefix_with_header`
# means emit "path:\n" header before the entries (used in -R / multi-dir).
fn _ls_list_dir(dir_path, all_mode, almost_all, long_mode, human, reverse, F_mode, inode_mode, R_mode, header): i64 {
    if (header == 1) {
        k_write( 1, dir_path, strlen(dir_path));
        k_write( 1, ":\n", 2);
    }
    var entries_or_err = _ls_collect(dir_path, all_mode, almost_all);
    if (entries_or_err < 0) {
        _ls_report(dir_path, 0 - entries_or_err);
        return entries_or_err;
    }
    var entries = entries_or_err;
    _ls_sort(entries, reverse);
    _ls_print_dir(entries, long_mode, human, F_mode, inode_mode);

    if (R_mode == 1) {
        var n = vec_len(entries);
        var i: i64 = 0;
        while (i < n) {
            var rec = vec_get(entries, i);
            var name = _ls_rec_name(rec);
            # Skip . and ..
            var skip: i64 = 0;
            if (load8(name) == 46) {
                if (load8(name + 1) == 0) { skip = 1; }
                if (skip == 0) {
                    if (load8(name + 1) == 46) {
                        if (load8(name + 2) == 0) { skip = 1; }
                    }
                }
            }
            if (skip == 0) {
                var st = _ls_rec_st(rec);
                # Only descend into REAL directories (not symlinks-to-dir).
                if (fs_is_dir(st) == 1) {
                    k_write( 1, "\n", 1);
                    var child = path_join(dir_path, name);
                    _ls_list_dir(child, all_mode, almost_all, long_mode, human, reverse, F_mode, inode_mode, R_mode, 1);
                }
            }
            i = i + 1;
        }
    }
    return 0;
}

# Print a single-entry listing for a non-directory operand (or a
# directory under -d). Caller has already lstat'd into st_buf.
fn _ls_print_entry(name, st_buf, long_mode, human, F_mode, inode_mode): i64 {
    # Build a one-entry vec, then route through the same printer.
    var rec = _ls_rec_new(name);
    memcpy(_ls_rec_st(rec), st_buf, 144);
    if (fs_is_lnk(st_buf) == 1) {
        var lb = alloc(4096);
        var n = fs_readlinkat(0 - 100, name, lb, 4095);
        if (n >= 0) {
            store8(lb + n, 0);
            _ls_rec_set_link_target(rec, lb);
        }
    }
    var v = vec_new();
    vec_push(v, rec);
    _ls_print_dir(v, long_mode, human, F_mode, inode_mode);
    return 0;
}

fn cmd_ls(start: i64): i64 {
    _ls_init_spec();
    if (kriya_args_parse_optval(_ls_spec, start, 0, "color") != 0) {
        k_write( 2, "kriya ls: error: bad option (see ADR 0002 for accepted syntax)\n", 63);
        return EXIT_USAGE;
    }

    var all_mode: i64 = 0;
    if (flags_get_bool(_ls_spec, _ls_a_idx) == 1) { all_mode = 1; }
    var almost_all: i64 = 0;
    if (flags_get_bool(_ls_spec, _ls_A_idx) == 1) { almost_all = 1; }
    var long_mode: i64 = 0;
    if (flags_get_bool(_ls_spec, _ls_l_idx) == 1) { long_mode = 1; }
    var human: i64 = 0;
    if (flags_get_bool(_ls_spec, _ls_h_idx) == 1) { human = 1; }
    var reverse: i64 = 0;
    if (flags_get_bool(_ls_spec, _ls_r_idx) == 1) { reverse = 1; }
    var F_mode: i64 = 0;
    if (flags_get_bool(_ls_spec, _ls_F_idx) == 1) { F_mode = 1; }
    var inode_mode: i64 = 0;
    if (flags_get_bool(_ls_spec, _ls_i_idx) == 1) { inode_mode = 1; }
    # ⚠ `-n` also implies `-l` in GNU; it is not merely a modifier of it.
    if (flags_get_bool(_ls_spec, _ls_n_idx) == 1) {
        _ls_numeric = 1;
        long_mode = 1;
    }
    _ls_sortkey = _ls_pick_sortkey();
    # ⚠ `--color` takes an OPTIONAL value: bare means `always`. GNU also accepts
    # `yes`/`force`, `tty`/`if-tty` and `no`/`none` as aliases.
    var cw = LS_CW_NEVER;
    var cv = flags_get_str(_ls_spec, _ls_color_idx);
    if (cv != 0) {
        if (load8(cv) == 0)              { cw = LS_CW_ALWAYS; }
        elif (streq(cv, "always") == 1)  { cw = LS_CW_ALWAYS; }
        elif (streq(cv, "yes") == 1)     { cw = LS_CW_ALWAYS; }
        elif (streq(cv, "force") == 1)   { cw = LS_CW_ALWAYS; }
        elif (streq(cv, "auto") == 1)    { cw = LS_CW_AUTO; }
        elif (streq(cv, "tty") == 1)     { cw = LS_CW_AUTO; }
        elif (streq(cv, "if-tty") == 1)  { cw = LS_CW_AUTO; }
        elif (streq(cv, "never") == 1)   { cw = LS_CW_NEVER; }
        elif (streq(cv, "no") == 1)      { cw = LS_CW_NEVER; }
        elif (streq(cv, "none") == 1)    { cw = LS_CW_NEVER; }
        else {
            k_write( 2, "kriya ls: error: invalid --color argument\n", 42);
            return EXIT_USAGE;
        }
    }
    if (cw == LS_CW_ALWAYS) { _ls_color = 1; }
    if (cw == LS_CW_AUTO) {
        # ⚠ agnos has no tty concept and `k_isatty` returns 0 there, so `=auto`
        # means no colour on that target — the fallback IS the normal path.
        if (k_isatty(1) == 1) { _ls_color = 1; }
    }
    if (_ls_color == 1) { _ls_color_load(); }
    # ⚠ GNU quotes on a terminal and not through a pipe, so the same command
    # produces different bytes depending on where it is pointed. That is
    # deliberate upstream: the terminal form is for a human to retype, the piped
    # form is what scripts have always parsed.
    if (k_isatty(1) == 1) { _ls_quote = 1; }
    # ⛔ `--quoting-style` exists here for a REASON BEYOND PARITY: without it,
    # 100% of ls's quoted output sits behind a pty, and on a host with no
    # `script(1)` the whole quoting block skips — so an `ls` that never quoted
    # would go green. That was demonstrated with a mutant before this flag
    # existed: 21 passed, 0 failed. The flag moves the algorithm onto the pipe
    # path and leaves the pty covering exactly one bit — whether a terminal
    # turns it on.
    # ⚠ Only the three styles kriya's helper actually implements are accepted.
    # The rest (`shell`, `c`, `escape`, `locale`, `clocale`) are REFUSED by name
    # rather than silently treated as the default (roadmap 1.6.x).
    var qs = flags_get_str(_ls_spec, _ls_qs_idx);
    if (qs != 0) {
        if (load8(qs) != 0) {
            if (streq(qs, "literal") == 1) { _ls_quote = 0; }
            elif (streq(qs, "shell-escape") == 1) { _ls_quote = 1; }
            elif (streq(qs, "shell-escape-always") == 1) { _ls_quote = 2; }
            else {
                k_write( 2, "kriya ls: error: --quoting-style must be ", 41);
                k_write( 2, "literal, shell-escape or shell-escape-always\n", 45);
                return EXIT_USAGE;
            }
        }
    }
    var d_mode: i64 = 0;
    if (flags_get_bool(_ls_spec, _ls_d_idx) == 1) { d_mode = 1; }
    var R_mode: i64 = 0;
    if (flags_get_bool(_ls_spec, _ls_R_idx) == 1) { R_mode = 1; }

    var npos = flags_positional_count(_ls_spec);

    # No operands → list cwd.
    if (npos < 1) {
        var dir = ".";
        #ifdef CYRIUS_TARGET_AGNOS
        # AGNOS-only: the AGNOS VFS rejects relative paths (vfs.cyr requires a
        # leading '/'), so the literal "." opens nothing and ls fails. Resolve
        # to an absolute path via k_getcwd (returns "/" on agnos). On Linux we
        # KEEP "." so `ls -R` section headers stay GNU-relative ("./sub:").
        var cwd[4096];
        var clen = k_getcwd(&cwd, 4096);
        if (clen > 0) { dir = &cwd; }
        #endif
        var r = _ls_list_dir(dir, all_mode, almost_all, long_mode, human, reverse, F_mode, inode_mode, R_mode, 0);
        if (r != 0) { return EXIT_FAILURE; }
        return EXIT_SUCCESS;
    }

    # Classify operands: split into non-directories (printed first as a
    # flat list) and directories (each gets its own section).
    var any_failed: i64 = 0;
    var nondir_entries = vec_new();
    var dir_paths      = vec_new();

    var i: i64 = 0;
    while (i < npos) {
        var p = flags_positional(_ls_spec, i);
        var st[144];
        var sr = fs_lstat_at(0 - 100, p, &st);
        if (sr != 0) {
            _ls_report(p, 0 - sr);
            any_failed = 1;
        } else {
            var is_dir: i64 = 0;
            if (fs_is_dir(&st) == 1) { is_dir = 1; }
            if (d_mode == 1)         { is_dir = 0; }
            if (is_dir == 1) {
                # ⛔ A RECORD, not the raw path, so the directory-section list
                # can go through the same `_ls_sort` the flat list does. It was
                # a bare `vec_push(dir_paths, p)` and therefore permanently in
                # ARGV ORDER under every flag: `ls d3 d1 d2` emitted
                # `d3: d1: d2:` where GNU emits `d1: d2: d3:`, and `-t`/`-r`
                # changed nothing. ⚠ The stat is already in hand here, so
                # carrying it costs nothing and is what makes `-t`/`-S` work on
                # the section order too.
                var dlen = strlen(p);
                var dname = alloc(dlen + 1);
                memcpy(dname, p, dlen + 1);
                var drec = _ls_rec_new(dname);
                memcpy(_ls_rec_st(drec), &st, 144);
                vec_push(dir_paths, drec);
            } else {
                # Single-entry record for the flat list.
                var nlen = strlen(p);
                var name_copy = alloc(nlen + 1);
                memcpy(name_copy, p, nlen + 1);
                var rec = _ls_rec_new(name_copy);
                memcpy(_ls_rec_st(rec), &st, 144);
                if (fs_is_lnk(&st) == 1) {
                    _ls_load_link_target(0 - 100, rec);
                }
                vec_push(nondir_entries, rec);
            }
        }
        i = i + 1;
    }

    # Emit non-directory operands first (sorted).
    if (vec_len(nondir_entries) > 0) {
        _ls_sort(nondir_entries, reverse);
        _ls_print_dir(nondir_entries, long_mode, human, F_mode, inode_mode);
    }

    # Then each directory operand, in the SAME order the flat list uses.
    _ls_sort(dir_paths, reverse);
    var ndir = vec_len(dir_paths);
    var multi_dir: i64 = 0;
    if (ndir > 1) { multi_dir = 1; }
    if (R_mode == 1) { multi_dir = 1; }
    var any_nondir = 0;
    if (vec_len(nondir_entries) > 0) { any_nondir = 1; }

    var di: i64 = 0;
    while (di < ndir) {
        var dp = _ls_rec_name(vec_get(dir_paths, di));
        var header: i64 = 0;
        if (multi_dir == 1) { header = 1; }
        if (any_nondir == 1) { header = 1; }
        # Separate sections with a blank line.
        if (di > 0) { k_write( 1, "\n", 1); }
        else {
            if (any_nondir == 1) { k_write( 1, "\n", 1); }
        }
        var r = _ls_list_dir(dp, all_mode, almost_all, long_mode, human, reverse, F_mode, inode_mode, R_mode, header);
        if (r != 0) { any_failed = 1; }
        di = di + 1;
    }

    if (any_failed == 1) { return EXIT_FAILURE; }
    # An entry we could not stat is a failure even when the listing printed.
    if (_ls_stat_failed == 1) { return EXIT_FAILURE; }
    return EXIT_SUCCESS;
}
