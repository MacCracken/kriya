# xargs — POSIX `xargs(1)`: build argument lists from stdin and exec.
#
# Argument shape:
#   xargs [opts] [CMD [INITIAL_ARGS...]]
#
# When CMD is omitted, defaults to `/bin/echo`.
#
# Flags:
#   -0 / --null            NUL-separated stdin items (pairs with find -print0)
#   -n N / --max-args=N    use at most N items per exec
#   -I REPLSTR             replace REPLSTR in CMD argv with the item; one exec
#                          per item; implies -n 1 (POSIX behaviour)
#   -r / --no-run-if-empty no exec when stdin had zero items (GNU default)
#   -t / --verbose         trace each command to stderr before running
#   -s N / --max-chars=N   cap argv+envp byte size per exec (default ~128 KiB)
#
# Item splitting:
#   default: whitespace (HT, LF, VT, FF, CR, SP), with backslash and
#            single/double quote escape handling — POSIX-faithful.
#   -I     : NEWLINE ONLY. POSIX gives a replacement string one LINE per
#            invocation, so blanks inside a line are part of the item. Leading
#            blanks are stripped, trailing ones are not (verified against GNU).
#            Quote/backslash handling stays active.
#   -0     : items are NUL-separated; no escape handling.
#
# Option recognition STOPS AT THE FIRST OPERAND (`kriya_argv_option_end`),
# because the operands here are another command's argv. Everything from that
# point is passed to the child verbatim — its flags, and its `--`.
#
# Exit codes (subset of POSIX/GNU):
#   0       all execs succeeded
#   123     one or more child commands exited non-zero
#   124     a child command exited with status 255 (GNU convention)
#   125     a child command was killed by a signal
#   126     command found but not executable
#   127     command not found
#   1       usage error or stdin read error

var _xa_spec     = 0;
var _xa_zero_idx = 0;
var _xa_r_idx    = 0;
var _xa_t_idx    = 0;
var _xa_n_idx    = 0;
var _xa_I_idx    = 0;
var _xa_s_idx    = 0;

var _xa_path_env = 0;
var _xa_env_vec  = 0;

fn _xa_init_spec(): i64 {
    if (_xa_spec != 0) { return 0; }
    var s = flags_new();
    _xa_zero_idx = flags_add_bool(s, 48,  "null",               0, "NUL-separated input");
    _xa_r_idx    = flags_add_bool(s, 114, "no-run-if-empty",    0, "skip exec when stdin had no items");
    _xa_t_idx    = flags_add_bool(s, 116, "verbose",            0, "echo each command to stderr");
    _xa_n_idx    = flags_add_int (s, 110, "max-args",           0, "max items per exec");
    _xa_I_idx    = flags_add_str (s, 73,  "replace",            0, "replace REPLSTR in command args");
    _xa_s_idx    = flags_add_int (s, 115, "max-chars",          0, "max argv+envp byte size per exec");
    _xa_spec = s;
    return 0;
}

fn _xa_report(msg): i64 {
    k_write( 2, "kriya xargs: ", 13);
    k_write( 2, msg, strlen(msg));
    k_write( 2, "\n", 1);
    return 0;
}

# --- env cache (same pattern as find) ---------------------------------

fn _xa_env_get(): i64 {
    if (_xa_env_vec != 0) { return _xa_env_vec; }
    var v = vec_new();
    var fd = k_open("/proc/self/environ", 0, 0);
    if (fd < 0) { _xa_env_vec = v; return v; }
    var cap: i64 = 4096;
    var buf = alloc(cap);
    var used: i64 = 0;
    var loop: i64 = 1;
    while (loop == 1) {
        if (used + 4096 > cap) {
            var newcap = cap * 2;
            var newbuf = alloc(newcap);
            memcpy(newbuf, buf, used);
            buf = newbuf;
            cap = newcap;
        }
        var n = k_read( fd, buf + used, 4096);
        if (n < 0) {
            if ((0 - n) == 4) { } else { loop = 0; }
        } else {
            if (n == 0) { loop = 0; }
            else { used = used + n; }
        }
    }
    k_close( fd);
    var start: i64 = 0;
    var i: i64 = 0;
    while (i < used) {
        if (load8(buf + i) == 0) {
            if (i > start) { vec_push(v, buf + start); }
            start = i + 1;
        }
        i = i + 1;
    }
    _xa_env_vec = v;
    return v;
}

# Thin wrapper over the shared resolver — see `fs_resolve_in_path` in
# `src/lib/fs.cyr`, which is also what `find -exec` uses. This file used to
# carry a byte-identical 45-line copy of it, so the CWD-execution hole below had
# to be found and fixed twice.
# ⚠ Returns 0 when the command is not found. The caller MUST NOT pass that to
# exec — it reports 127 instead.
fn _xa_resolve_exec(cmd): i64 {
    return fs_resolve_in_path(cmd, _xa_path_env);
}

# --- input parsing ----------------------------------------------------

# Read all of stdin into a fresh buffer. Returns (ptr, length via *out_len).
fn _xa_slurp_stdin(out_len_ptr): i64 {
    var cap: i64 = 4096;
    var buf = alloc(cap);
    var used: i64 = 0;
    var loop: i64 = 1;
    while (loop == 1) {
        if (used + 4096 > cap) {
            var newcap = cap * 2;
            var newbuf = alloc(newcap);
            memcpy(newbuf, buf, used);
            buf = newbuf;
            cap = newcap;
        }
        var n = k_read( 0, buf + used, 4096);
        if (n < 0) {
            if ((0 - n) == 4) { } else { return n; }
        } else {
            if (n == 0) { loop = 0; }
            else { used = used + n; }
        }
    }
    store64(out_len_ptr, used);
    return buf;
}

# Whitespace classifier — matches GNU xargs (HT, LF, VT, FF, CR, SP).
fn _xa_is_ws(c): i64 {
    if (c == 9)  { return 1; }
    if (c == 10) { return 1; }
    if (c == 11) { return 1; }
    if (c == 12) { return 1; }
    if (c == 13) { return 1; }
    if (c == 32) { return 1; }
    return 0;
}

# Split `buf`[0..len] into items, pushing newly-alloc'd NUL-terminated
# cstr copies into `out`. `zero_mode`=1 means NUL-separated input (no
# escape handling); 0 means whitespace-separated with backslash and
# single/double-quote semantics.
#
# ⛔ `line_mode`=1 SPLITS ON NEWLINE ONLY, and it is what `-I` requires. POSIX
# says a replacement string consumes one LINE per invocation; kriya split on
# blanks regardless, so `printf 'a b\n' | xargs -I{} rm -- {}` deleted files
# named `a` and `b` and left `a b` untouched — the wrong files, silently. The
# everyday `ls | xargs -I{} mv {} dest/` idiom mangled every name with a space
# in it the same way.
#
# ⚠ Leading blanks are stripped but TRAILING ONES ARE NOT — verified against GNU,
# which turns `"  a b  \n"` into `a b  `. Quote and backslash handling stay
# active, so `"a b"` and `a\ b` both yield `a b`. Empty lines produce no item.
# `-0` is unaffected: NUL splitting already means one item per record.
fn _xa_split(buf, len, zero_mode, line_mode, out): i64 {
    if (zero_mode == 1) {
        var start: i64 = 0;
        var i: i64 = 0;
        while (i < len) {
            if (load8(buf + i) == 0) {
                if (i > start) {
                    var slen = i - start;
                    var s = alloc(slen + 1);
                    memcpy(s, buf + start, slen);
                    store8(s + slen, 0);
                    vec_push(out, s);
                }
                start = i + 1;
            }
            i = i + 1;
        }
        if (start < len) {
            var rlen = len - start;
            var r = alloc(rlen + 1);
            memcpy(r, buf + start, rlen);
            store8(r + rlen, 0);
            vec_push(out, r);
        }
        return 0;
    }
    # Whitespace-split with backslash + quoting.
    var item_cap: i64 = 256;
    var item = alloc(item_cap);
    var item_len: i64 = 0;
    var quote: i64 = 0;    # 0 none, 39 single, 34 double
    var in_item: i64 = 0;
    var i: i64 = 0;
    while (i < len) {
        var c = load8(buf + i);
        var emit: i64 = 0;
        if (quote == 0) {
            # In line mode only a newline ends an item; blanks before the item
            # begins are dropped, blanks inside it are kept.
            var is_term: i64 = 0;
            if (line_mode == 1) {
                if (c == 10) { is_term = 1; }
            } else {
                if (_xa_is_ws(c) == 1) { is_term = 1; }
            }
            var skip_lead: i64 = 0;
            if (line_mode == 1) {
                if (in_item == 0) {
                    if (is_term == 0) {
                        if (c == 32) { skip_lead = 1; }
                        if (c == 9)  { skip_lead = 1; }
                    }
                }
            }
            if (is_term == 1) {
                if (in_item == 1) { emit = 1; }
            } elif (skip_lead == 1) {
                # leading blank, before the item starts — POSIX says ignore it
            } elif (c == 92) {
                # backslash: next byte literal
                if (i + 1 < len) {
                    if (item_len + 1 > item_cap) {
                        var nc = item_cap * 2;
                        var nb = alloc(nc);
                        memcpy(nb, item, item_len);
                        item = nb;
                        item_cap = nc;
                    }
                    store8(item + item_len, load8(buf + i + 1));
                    item_len = item_len + 1;
                    in_item = 1;
                    i = i + 1;
                }
            } elif (c == 39 || c == 34) {
                quote = c;
                in_item = 1;
            } else {
                if (item_len + 1 > item_cap) {
                    var nc2 = item_cap * 2;
                    var nb2 = alloc(nc2);
                    memcpy(nb2, item, item_len);
                    item = nb2;
                    item_cap = nc2;
                }
                store8(item + item_len, c);
                item_len = item_len + 1;
                in_item = 1;
            }
        } else {
            if (c == quote) {
                quote = 0;
            } else {
                if (item_len + 1 > item_cap) {
                    var nc3 = item_cap * 2;
                    var nb3 = alloc(nc3);
                    memcpy(nb3, item, item_len);
                    item = nb3;
                    item_cap = nc3;
                }
                store8(item + item_len, c);
                item_len = item_len + 1;
            }
        }
        if (emit == 1) {
            var s = alloc(item_len + 1);
            memcpy(s, item, item_len);
            store8(s + item_len, 0);
            vec_push(out, s);
            item_len = 0;
            in_item = 0;
        }
        i = i + 1;
    }
    if (in_item == 1) {
        var s2 = alloc(item_len + 1);
        memcpy(s2, item, item_len);
        store8(s2 + item_len, 0);
        vec_push(out, s2);
    }
    return 0;
}

# --- substring substitution -------------------------------------------

# Return a fresh cstr where every occurrence of `pat` (length plen) in
# `tok` is replaced with `repl` (length rlen). If pat is absent, returns
# tok unchanged.
fn _xa_substitute(tok, pat, plen, repl, rlen): i64 {
    var tlen = strlen(tok);
    # Count occurrences for sizing.
    var count: i64 = 0;
    var i: i64 = 0;
    while (i + plen <= tlen) {
        var mt: i64 = 1;
        var k: i64 = 0;
        while (k < plen) {
            if (load8(tok + i + k) != load8(pat + k)) { mt = 0; k = plen; }
            else { k = k + 1; }
        }
        if (mt == 1) { count = count + 1; i = i + plen; }
        else { i = i + 1; }
    }
    if (count == 0) { return tok; }
    var out_len = tlen + count * (rlen - plen);
    var out = alloc(out_len + 1);
    var oi: i64 = 0;
    var ti: i64 = 0;
    while (ti < tlen) {
        var mt2: i64 = 0;
        if (ti + plen <= tlen) {
            mt2 = 1;
            var k2: i64 = 0;
            while (k2 < plen) {
                if (load8(tok + ti + k2) != load8(pat + k2)) { mt2 = 0; k2 = plen; }
                else { k2 = k2 + 1; }
            }
        }
        if (mt2 == 1) {
            memcpy(out + oi, repl, rlen);
            oi = oi + rlen;
            ti = ti + plen;
        } else {
            store8(out + oi, load8(tok + ti));
            oi = oi + 1;
            ti = ti + 1;
        }
    }
    store8(out + oi, 0);
    return out;
}

# --- exec runner ------------------------------------------------------

fn _xa_emit_trace(args): i64 {
    var n = vec_len(args);
    var i: i64 = 0;
    while (i < n) {
        if (i > 0) { k_write( 2, " ", 1); }
        var a = vec_get(args, i);
        k_write( 2, a, strlen(a));
        i = i + 1;
    }
    k_write( 2, "\n", 1);
    return 0;
}

# Run `args` as a child; returns the GNU-shaped exit-code rollup the
# caller folds into the invocation's final exit code (0 / 123-127).
fn _xa_exec_one(args, trace_mode): i64 {
    if (vec_len(args) == 0) { return 0; }
    if (trace_mode == 1) { _xa_emit_trace(args); }
    var first = vec_get(args, 0);
    var resolved = _xa_resolve_exec(first);
    if (resolved == 0) {
        # POSIX xargs: 127 when the utility cannot be found. Reported here rather
        # than handed to execve as a bare name, which the kernel would resolve
        # against the current directory.
        k_write( 2, "kriya xargs: ", 13);
        k_write( 2, first, strlen(first));
        k_write( 2, ": command not found\n", 20);
        return 127;
    }
    vec_set(args, 0, resolved);
    var env = _xa_env_get();
    var rc = exec_env(args, env);
    if (rc == 0)        { return 0; }
    if (rc == 0 - 1)    { return 127; }     # fork failed / exec error
    if (rc == 255)      { return 124; }
    if (rc >= 0 && rc <= 255) { return 123; }
    return 123;
}

# --- entry point ------------------------------------------------------

fn cmd_xargs(start: i64): i64 {
    _xa_init_spec();
    # ⛔ OPTION RECOGNITION STOPS AT THE FIRST OPERAND, BECAUSE THE OPERANDS ARE
    # SOMEONE ELSE'S COMMAND LINE. Parsing the whole of argv meant xargs ate the
    # child's flags: `xargs sort -r` silently sorted ascending (`-r` taken as
    # --no-run-if-empty), `xargs head -n 2` ran head with no options, and
    # `ls -1 | xargs rm --` had its `--` GUARD DELETED — handing `rm` a list
    # starting `-r` and recursively deleting what the `--` existed to protect.
    var cmd_at = kriya_argv_option_end(_xa_spec, start);
    if (kriya_args_parse_range(_xa_spec, start, cmd_at, 0) != 0) {
        _xa_report("error: bad option (see ADR 0002 for accepted syntax)");
        return EXIT_USAGE;
    }
    _xa_path_env = getenv("PATH");
    _xa_env_vec = 0;

    var zero_mode = flags_get_bool(_xa_spec, _xa_zero_idx);
    var no_empty  = flags_get_bool(_xa_spec, _xa_r_idx);
    var trace     = flags_get_bool(_xa_spec, _xa_t_idx);
    var n_max     = flags_get_int (_xa_spec, _xa_n_idx);
    var repl_str  = flags_get_str (_xa_spec, _xa_I_idx);
    var size_max  = flags_get_int (_xa_spec, _xa_s_idx);
    if (size_max <= 0) { size_max = 131072; }

    # -I implies -n 1; the REPLSTR also implies "one exec per item".
    var per_item: i64 = 0;
    if (repl_str != 0) {
        if (load8(repl_str) != 0) {
            per_item = 1;
            n_max = 1;
        } else { repl_str = 0; }
    }

    # Default command: /bin/echo.
    # ⚠ Taken from argv VERBATIM starting at `cmd_at`, not from
    # `flags_positional` — the whole point of the boundary above is that these
    # tokens were never interpreted, so `-r`, `-n 2` and `--` reach the child
    # exactly as the user typed them.
    var argv_n = kriya_argv_count();
    var flat = kriya_argv_flat();
    var cmd_base = vec_new();
    if (cmd_at >= argv_n) {
        vec_push(cmd_base, "/bin/echo");
    } else {
        var ci = cmd_at;
        while (ci < argv_n) {
            vec_push(cmd_base, load64(flat + ci * 8));
            ci = ci + 1;
        }
    }
    var base_n = vec_len(cmd_base);
    var repl_plen: i64 = 0;
    if (repl_str != 0) { repl_plen = strlen(repl_str); }

    # Slurp stdin.
    var stdin_len: i64 = 0;
    var stdin_buf = _xa_slurp_stdin(&stdin_len);
    if (stdin_buf < 0) {
        _xa_report("error reading stdin");
        return EXIT_FAILURE;
    }

    var items = vec_new();
    _xa_split(stdin_buf, stdin_len, zero_mode, per_item, items);
    var n_items = vec_len(items);

    if (n_items == 0) {
        if (no_empty == 1) { return EXIT_SUCCESS; }
        # Default GNU pre-4.x ran once with no items; modern GNU defaults
        # to --no-run-if-empty. We match modern GNU (no-run when empty).
        return EXIT_SUCCESS;
    }

    var any_fail: i64 = 0;
    var sticky_rc: i64 = 0;

    # Per-item shape: -I REPLSTR. Each exec runs CMD-with-substitution + no
    # extra items appended (since CMD itself absorbed the substitution).
    if (per_item == 1) {
        var k: i64 = 0;
        while (k < n_items) {
            var it = vec_get(items, k);
            var ilen = strlen(it);
            var args = vec_new();
            var bi: i64 = 0;
            while (bi < base_n) {
                var tok = vec_get(cmd_base, bi);
                vec_push(args, _xa_substitute(tok, repl_str, repl_plen, it, ilen));
                bi = bi + 1;
            }
            var r = _xa_exec_one(args, trace);
            if (r != 0) { any_fail = 1; sticky_rc = r; }
            k = k + 1;
        }
        if (any_fail == 1) { return sticky_rc; }
        return EXIT_SUCCESS;
    }

    # Batch shape: build chunks until -n is hit OR size cap would be
    # exceeded (rough byte tally of argv).
    var i: i64 = 0;
    while (i < n_items) {
        var args = vec_new();
        var byte_tally: i64 = 0;
        var bi2: i64 = 0;
        while (bi2 < base_n) {
            var t2 = vec_get(cmd_base, bi2);
            vec_push(args, t2);
            byte_tally = byte_tally + strlen(t2) + 1;
            bi2 = bi2 + 1;
        }
        var added: i64 = 0;
        var stop_batch: i64 = 0;
        while (stop_batch == 0) {
            if (i >= n_items) { stop_batch = 1; }
            elif (n_max > 0 && added >= n_max) { stop_batch = 1; }
            else {
                var it2 = vec_get(items, i);
                var ilen2 = strlen(it2);
                if (added > 0 && byte_tally + ilen2 + 1 > size_max) {
                    stop_batch = 1;
                } else {
                    vec_push(args, it2);
                    byte_tally = byte_tally + ilen2 + 1;
                    added = added + 1;
                    i = i + 1;
                }
            }
        }
        if (added > 0) {
            var rr = _xa_exec_one(args, trace);
            if (rr != 0) { any_fail = 1; sticky_rc = rr; }
        } else {
            # No room for any item in a fresh batch — items oversized.
            _xa_report("error: argv size cap reached with no room for the next item");
            return EXIT_FAILURE;
        }
    }
    if (any_fail == 1) { return sticky_rc; }
    return EXIT_SUCCESS;
}
