# stat — file metadata dump with a printf-style format engine.
#
# Argument shape:
#   stat [opts] FILE...
#
# Flags:
#   -c / --format=FORMAT     printf-style format string emitted per file;
#                            newline appended after each.
#   --printf=FORMAT          like -c but `\n` / `\t` / `\\` are
#                            interpreted as escapes and NO trailing
#                            newline is auto-appended.
#   -L / --dereference       stat the symlink target instead of the link.
#   -t / --terse             one-line space-separated form (the GNU
#                            "terse" format string; intended for
#                            parsing — exact ordering documented below).
#
# Format specifiers (the M3 subset; covers the surface most scripts
# touch):
#   %n  file name (the operand as given)
#   %s  size in bytes
#   %a  permissions in octal (low 12 bits)
#   %A  permissions in symbolic form (`-rwxr-xr-x`)
#   %f  raw st_mode in hex (no `0x` prefix)
#   %F  file type ("regular file" / "directory" / "symbolic link" /
#                  "character special file" / "block special file" /
#                  "fifo" / "socket" / "unknown")
#   %u  numeric uid
#   %g  numeric gid
#   %i  inode number
#   %h  hard-link count
#   %d  device number, decimal
#   %D  device number, hex (no prefix)
#   %t  major device of st_rdev, hex
#   %T  minor device of st_rdev, hex
#   %b  number of 512-byte blocks allocated
#   %B  the size of each block reported by %b (always 512 on Linux)
#   %o  optimal I/O block size (st_blksize)
#   %X  atime in seconds since epoch
#   %Y  mtime in seconds since epoch
#   %Z  ctime in seconds since epoch
#   %%  literal `%`
#
# Deferred (separate follow-ups, named):
#   %x / %y / %z  — human-readable times. Waits on `lib/chrono.cyr`'s
#                   strftime-like formatter.
#   %U / %G       — user / group name lookup. Waits on a passwd/group
#                   parser (forthcoming with the user/group utility set).
#   %N            — quoted name + symlink target rendering. Trivial
#                   once we own a quoting helper; deferred for symmetry
#                   with the upcoming `ls` quoting story.
#   %w / %W       — birth time. Needs `statx(2)` not `stat(2)`.
#
# Symlink policy: stat is purely informational. Default is lstat
# (operates on the link itself) per POSIX / GNU; `-L` follows.
# ADR 0003's matrix doesn't apply.

# Set when a format asked for something kriya cannot render. `stat` used to emit
# the specifier's own text and exit 0 — so `stat -c %y f` printed the two bytes
# "%y" where a timestamp belonged, and a script substituting that into a
# filename or a comparison got literal garbage back with every sign of success.
var _st_bad: i64 = 0;

var _st_spec    = 0;
var _st_c_idx   = 0;
var _st_pr_idx  = 0;
var _st_L_idx   = 0;
var _st_t_idx   = 0;

fn _st_init_spec(): i64 {
    if (_st_spec != 0) { return 0; }
    var s = flags_new();
    _st_c_idx  = flags_add_str(s,  99,  "format",      0, "printf-style format string");
    _st_pr_idx = flags_add_str(s,  0,   "printf",      0, "like --format, with \\-escapes and no auto-newline");
    _st_L_idx  = flags_add_bool(s, 76,  "dereference", 0, "follow symlinks");
    _st_t_idx  = flags_add_bool(s, 116, "terse",       0, "one-line space-separated form");
    _st_spec = s;
    return 0;
}

fn _st_report(operand, errno): i64 {
    k_write( 2, "kriya stat: ", 12);
    k_write( 2, operand, strlen(operand));
    k_write( 2, ": ", 2);
    if (errmsg_is_known(errno) == 1) {
        var m = errmsg_for(errno);
        k_write( 2, m, strlen(m));
    } else {
        k_write( 2, "errno ", 6);
        var buf[8];
        var i: i64 = 7;
        store8(&buf + i, 0);
        i = i - 1;
        var v = errno;
        if (v == 0) { store8(&buf + i, 48); i = i - 1; }
        while (v > 0) {
            store8(&buf + i, 48 + (v - (v / 10) * 10));
            v = v / 10;
            i = i - 1;
        }
        k_write( 2, &buf + i + 1, 6 - i);
    }
    k_write( 2, "\n", 1);
    return 0;
}

# --- integer rendering helpers ---

# Render `v` as decimal digits into `buf`. Returns the byte count.
fn _st_render_dec(v, buf): i64 {
    if (v == 0) { store8(buf, 48); return 1; }
    var tmp[32];
    var n: i64 = 0;
    var rem = v;
    while (rem > 0) {
        store8(&tmp + n, 48 + (rem - (rem / 10) * 10));
        rem = rem / 10;
        n = n + 1;
    }
    # tmp holds digits in reverse; copy into buf in forward order.
    var i: i64 = 0;
    while (i < n) {
        store8(buf + i, load8(&tmp + n - 1 - i));
        i = i + 1;
    }
    return n;
}

# Render `v` as octal digits into `buf`. Returns the byte count.
fn _st_render_oct(v, buf): i64 {
    if (v == 0) { store8(buf, 48); return 1; }
    var tmp[32];
    var n: i64 = 0;
    var rem = v;
    while (rem > 0) {
        store8(&tmp + n, 48 + (rem & 7));
        rem = rem / 8;
        n = n + 1;
    }
    var i: i64 = 0;
    while (i < n) {
        store8(buf + i, load8(&tmp + n - 1 - i));
        i = i + 1;
    }
    return n;
}

# Render `v` as lowercase hex into `buf`. Returns the byte count.
fn _st_render_hex(v, buf): i64 {
    if (v == 0) { store8(buf, 48); return 1; }
    var tmp[32];
    var n: i64 = 0;
    var rem = v;
    while (rem > 0) {
        var d = rem & 15;
        var c: i64 = 48;
        if (d < 10) { c = 48 + d; }
        else        { c = 87 + d; }  # 'a' + (d - 10)
        store8(&tmp + n, c);
        rem = rem / 16;
        n = n + 1;
    }
    var i: i64 = 0;
    while (i < n) {
        store8(buf + i, load8(&tmp + n - 1 - i));
        i = i + 1;
    }
    return n;
}

# --- mode-bit helpers ---

# Return a static cstring describing the file-type word.
fn _st_type_name(mode): i64 {
    var typ = mode & 61440;  # S_IFMT
    if (typ == 32768) { return "regular file"; }            # S_IFREG
    if (typ == 16384) { return "directory"; }               # S_IFDIR
    if (typ == 40960) { return "symbolic link"; }           # S_IFLNK
    if (typ == 8192)  { return "character special file"; }  # S_IFCHR
    if (typ == 24576) { return "block special file"; }      # S_IFBLK
    if (typ == 4096)  { return "fifo"; }                    # S_IFIFO
    if (typ == 49152) { return "socket"; }                  # S_IFSOCK
    return "unknown";
}

# Render symbolic permissions into `buf`. Writes exactly 10 bytes.
fn _st_render_symperm(mode, buf): i64 {
    var typ = mode & 61440;
    var c: i64 = 45;  # '-'
    if (typ == 16384) { c = 100; }  # 'd'
    if (typ == 40960) { c = 108; }  # 'l'
    if (typ == 8192)  { c = 99;  }  # 'c'
    if (typ == 24576) { c = 98;  }  # 'b'
    if (typ == 4096)  { c = 112; }  # 'p'
    if (typ == 49152) { c = 115; }  # 's'
    store8(buf, c);

    # User
    var dash: i64 = 45;
    if ((mode & 256) != 0) { store8(buf + 1, 114); } else { store8(buf + 1, dash); }  # r/-
    if ((mode & 128) != 0) { store8(buf + 2, 119); } else { store8(buf + 2, dash); }  # w/-
    var ux: i64 = mode & 64;
    var setuid: i64 = mode & 2048;  # S_ISUID
    if (setuid != 0) {
        if (ux != 0) { store8(buf + 3, 115); } else { store8(buf + 3, 83); }  # s / S
    } else {
        if (ux != 0) { store8(buf + 3, 120); } else { store8(buf + 3, dash); }  # x / -
    }

    # Group
    if ((mode & 32) != 0) { store8(buf + 4, 114); } else { store8(buf + 4, dash); }
    if ((mode & 16) != 0) { store8(buf + 5, 119); } else { store8(buf + 5, dash); }
    var gx = mode & 8;
    var setgid: i64 = mode & 1024;  # S_ISGID
    if (setgid != 0) {
        if (gx != 0) { store8(buf + 6, 115); } else { store8(buf + 6, 83); }
    } else {
        if (gx != 0) { store8(buf + 6, 120); } else { store8(buf + 6, dash); }
    }

    # Other
    if ((mode & 4) != 0) { store8(buf + 7, 114); } else { store8(buf + 7, dash); }
    if ((mode & 2) != 0) { store8(buf + 8, 119); } else { store8(buf + 8, dash); }
    var ox = mode & 1;
    var sticky: i64 = mode & 512;  # S_ISVTX
    if (sticky != 0) {
        if (ox != 0) { store8(buf + 9, 116); } else { store8(buf + 9, 84); }  # t / T
    } else {
        if (ox != 0) { store8(buf + 9, 120); } else { store8(buf + 9, dash); }
    }
    return 10;
}

# --- format engine ---
#
# Emit the format `fmt` for stat buffer `st`, with operand name `name`.
# `interpret_escapes` controls whether `\n` / `\t` / `\\` are processed.
# `auto_newline` appends '\n' at the end (set for -c, unset for --printf).

fn _st_emit_spec(c, st, name): i64 {
    var buf[64];
    var n: i64 = 0;
    if (c == 110) {  # n
        k_write( 1, name, strlen(name));
        return 0;
    }
    if (c == 115) {  # s
        n = _st_render_dec(load64(st + 48), &buf);
    } else { if (c == 97) {  # a (octal perms)
        n = _st_render_oct(load64(st + 24) & 4095, &buf);
    } else { if (c == 65) {  # A (symbolic perms)
        n = _st_render_symperm(load64(st + 24), &buf);
    } else { if (c == 102) {  # f (hex raw mode — st_mode is 4 bytes, mask)
        n = _st_render_hex(load64(st + 24) & 4294967295, &buf);
    } else { if (c == 70) {  # F (type name)
        var t = _st_type_name(load64(st + 24));
        k_write( 1, t, strlen(t));
        return 0;
    } else { if (c == 117) {  # u
        n = _st_render_dec(load64(st + 28) & 4294967295, &buf);
    } else { if (c == 103) {  # g
        n = _st_render_dec(load64(st + 32) & 4294967295, &buf);
    } else { if (c == 105) {  # i
        n = _st_render_dec(load64(st + 8), &buf);
    } else { if (c == 104) {  # h
        n = _st_render_dec(load64(st + 16), &buf);
    } else { if (c == 100) {  # d (decimal)
        n = _st_render_dec(load64(st + 0), &buf);
    } else { if (c == 68) {  # D (hex)
        n = _st_render_hex(load64(st + 0), &buf);
    } else { if (c == 116) {  # t (major of rdev, hex)
        var rdev = load64(st + 40);
        # Linux major/minor encoding: major = ((rdev >> 8) & 0xfff) | ((rdev >> 32) & ~0xfff)
        # Simpler subset: major = (rdev >> 8) & 0xfff for typical devices.
        n = _st_render_hex((rdev / 256) & 4095, &buf);
    } else { if (c == 84) {  # T (minor of rdev, hex)
        var rdev2 = load64(st + 40);
        n = _st_render_hex(rdev2 & 255, &buf);
    } else { if (c == 98) {  # b (blocks)
        n = _st_render_dec(load64(st + 64), &buf);
    } else { if (c == 66) {  # B (block size — always 512 on Linux)
        n = _st_render_dec(512, &buf);
    } else { if (c == 111) {  # o (st_blksize)
        n = _st_render_dec(load64(st + 56), &buf);
    } else { if (c == 88) {  # X (atime)
        n = _st_render_dec(load64(st + 72), &buf);
    } else { if (c == 89) {  # Y (mtime)
        n = _st_render_dec(load64(st + 88), &buf);
    } else { if (c == 90) {  # Z (ctime)
        n = _st_render_dec(load64(st + 104), &buf);
    } else { if (c == 87) {  # W (birth time — stat(2) can't see it; 0 matches GNU when unavailable)
        n = _st_render_dec(0, &buf);
    } else { if (c == 37) {  # literal %
        store8(&buf, 37);
        n = 1;
    } else {
        # ⚠ Two different failures, and they deserve different answers.
        if (_st_is_deferred_spec(c) == 1) {
            # A REAL specifier kriya has not implemented. Emitting its source
            # text would be a wrong answer dressed as output; say so instead.
            k_write( 2, "kriya stat: %", 13);
            var eb[8];
            store8(&eb, c);
            k_write( 2, &eb, 1);
            k_write( 2, ": not implemented (see roadmap M12a/M12c)\n", 42);
            _st_bad = 1;
            n = 0;
        } else {
            # Genuinely unknown. GNU prints '?' — verified against `stat -c %@`,
            # which is what the previous "emit the source bytes, GNU behaviour"
            # comment here got wrong.
            store8(&buf, 63);
            n = 1;
        }
    } } } } } } } } } } } } } } } } } } } } }
    k_write( 1, &buf, n);
    return 0;
}

# Specifiers GNU defines and kriya does not yet render, as opposed to ones that
# are simply not specifiers. %x/%y/%z wait on chrono's strftime formatter, %U/%G
# on a passwd/group parser, %N on a quoting helper, %w on statx(2).
fn _st_is_deferred_spec(c): i64 {
    if (c == 120) { return 1; }   # x
    if (c == 121) { return 1; }   # y
    if (c == 122) { return 1; }   # z
    if (c == 85)  { return 1; }   # U
    if (c == 71)  { return 1; }   # G
    if (c == 78)  { return 1; }   # N
    if (c == 119) { return 1; }   # w
    return 0;
}

fn _st_emit_format(fmt, st, name, interpret_escapes, auto_newline): i64 {
    var i: i64 = 0;
    while (load8(fmt + i) != 0) {
        var c = load8(fmt + i);
        if (c == 37) {
            # %SPEC
            i = i + 1;
            var sc = load8(fmt + i);
            if (sc == 0) {
                # Trailing lone '%' — emit as-is.
                var bb[2];
                store8(&bb, 37);
                k_write( 1, &bb, 1);
            } else {
                _st_emit_spec(sc, st, name);
                i = i + 1;
            }
        } else {
            if (interpret_escapes == 1) {
                if (c == 92) {  # backslash
                    i = i + 1;
                    var ec = load8(fmt + i);
                    var bb2[2];
                    var emit: i64 = 1;
                    if (ec == 110)      { store8(&bb2, 10); }  # \n
                    else { if (ec == 116) { store8(&bb2, 9); }   # \t
                    else { if (ec == 114) { store8(&bb2, 13); }  # \r
                    else { if (ec == 92)  { store8(&bb2, 92); }  # \\
                    else { if (ec == 48)  { store8(&bb2, 0); }   # \0
                    else { if (ec == 39)  { store8(&bb2, 39); }  # \'
                    else { if (ec == 34)  { store8(&bb2, 34); }  # \"
                    else { if (ec == 0)   {
                        # Trailing lone backslash — emit as-is.
                        store8(&bb2, 92);
                        emit = 1;
                    } else {
                        # Unknown — keep backslash + char.
                        store8(&bb2, 92);
                        k_write( 1, &bb2, 1);
                        store8(&bb2, ec);
                    } } } } } } } }
                    k_write( 1, &bb2, 1);
                    if (ec != 0) { i = i + 1; }
                } else {
                    var bb3[2];
                    store8(&bb3, c);
                    k_write( 1, &bb3, 1);
                    i = i + 1;
                }
            } else {
                var bb4[2];
                store8(&bb4, c);
                k_write( 1, &bb4, 1);
                i = i + 1;
            }
        }
    }
    if (auto_newline == 1) {
        var nl[2];
        store8(&nl, 10);
        k_write( 1, &nl, 1);
    }
    return 0;
}

# Default multi-line format (epoch times — `%x`/`%y`/`%z` await chrono).
fn _st_default_format(): i64 {
    return "  File: %n\n  Size: %s\tBlocks: %b\tIO Block: %o\t%F\nDevice: %dh/%Dh\tInode: %i\tLinks: %h\nAccess: (%a/%A)  Uid: %u  Gid: %g\nAccess: %X\nModify: %Y\nChange: %Z\n";
}

# Terse format (GNU stat -t style — single line, space-separated).
# Column order matches GNU exactly: %W (birth) is between %Z and %o.
fn _st_terse_format(): i64 {
    return "%n %s %b %f %u %g %D %i %h %t %T %X %Y %Z %W %o";
}

fn cmd_stat(start: i64): i64 {
    _st_init_spec();
    if (kriya_args_parse(_st_spec, start) != 0) {
        k_write( 2, "kriya stat: error: bad option (see ADR 0002 for accepted syntax)\n", 65);
        return EXIT_USAGE;
    }

    var npos = flags_positional_count(_st_spec);
    if (npos < 1) {
        k_write( 2, "kriya stat: error: missing operand\n", 35);
        return EXIT_USAGE;
    }

    var deref: i64 = 0;
    if (flags_get_bool(_st_spec, _st_L_idx) == 1) { deref = 1; }
    var terse: i64 = 0;
    if (flags_get_bool(_st_spec, _st_t_idx) == 1) { terse = 1; }

    # Choose format. --printf wins over -c; both win over -t; default
    # is the multi-line layout.
    var fmt: i64 = 0;
    var interpret_escapes: i64 = 0;
    var auto_newline: i64 = 1;

    var c_arg  = flags_get_str(_st_spec, _st_c_idx);
    var pr_arg = flags_get_str(_st_spec, _st_pr_idx);

    if (pr_arg != 0) {
        if (load8(pr_arg) != 0) {
            fmt = pr_arg;
            interpret_escapes = 1;
            auto_newline = 0;
        }
    }
    if (fmt == 0) {
        if (c_arg != 0) {
            if (load8(c_arg) != 0) {
                fmt = c_arg;
            }
        }
    }
    if (fmt == 0) {
        if (terse == 1) { fmt = _st_terse_format(); }
        else            { fmt = _st_default_format(); }
    }

    var any_failed: i64 = 0;
    var i: i64 = 0;
    while (i < npos) {
        var p = flags_positional(_st_spec, i);
        var st[144];
        var sr: i64 = 0;
        if (deref == 1) {
            sr = k_stat(p, &st);
        } else {
            sr = fs_lstat_at(0 - 100, p, &st);
        }
        if (sr != 0) {
            _st_report(p, 0 - sr);
            any_failed = 1;
        } else {
            _st_emit_format(fmt, &st, p, interpret_escapes, auto_newline);
        }
        i = i + 1;
    }

    if (any_failed == 1) { return EXIT_FAILURE; }
    if (_st_bad == 1) { return EXIT_FAILURE; }
    return EXIT_SUCCESS;
}
