include "src/cmd/tail.cyr"
include "src/cmd/nl.cyr"
include "src/cmd/uniq.cyr"
include "src/cmd/tr.cyr"
include "src/cmd/cut.cyr"
include "src/cmd/sort.cyr"
include "src/cmd/printf.cyr"
include "src/cmd/grep.cyr"
include "src/cmd/find.cyr"
