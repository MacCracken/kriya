# kriya — BusyBox-style dispatcher.
#
# argv[0]'s basename selects the utility; `kriya <util> [args...]` is
# also accepted (for tests, benches, and fallback when symlinks are
# absent). See docs/adr/0001-busybox-dispatcher-vs-n-binaries.md.
#
# Stdlib (string, fmt, alloc, io, vec, str, syscalls, assert) is
# auto-included via cyrius.cyml [deps].stdlib.

include "src/lib/exit.cyr"
include "src/cmd/true.cyr"
include "src/cmd/false.cyr"

# Return pointer to the basename within a null-terminated path.
# Scans for the last '/'; result is a pointer into the original buffer
# (still null-terminated by virtue of the source).
fn kriya_basename(p): i64 {
    var len = strlen(p);
    var start: i64 = 0;
    var i: i64 = 0;
    while (i < len) {
        if (load8(p + i) == 47) {
            start = i + 1;
        }
        i = i + 1;
    }
    return p + start;
}

fn print_usage() {
    syscall(1, 2, "usage: kriya <utility> [args...]\n", 33);
    syscall(1, 2, "       or invoke a symlink named after the utility (e.g. `true`, `false`).\n", 76);
    return 0;
}

fn print_unknown(name) {
    syscall(1, 2, "kriya: unknown utility: ", 24);
    syscall(1, 2, name, strlen(name));
    syscall(1, 2, "\n", 1);
    return 0;
}

# Route `name` to the matching `cmd_*` function. `start` is the index
# in argv() where the utility's own arguments begin (1 for symlink
# form, 2 for `kriya <util>` form).
fn dispatch(name, start: i64): i64 {
    if (streq(name, "true"))  { return cmd_true(start); }
    if (streq(name, "false")) { return cmd_false(start); }
    print_unknown(name);
    return EXIT_USAGE;
}

fn main(): i64 {
    alloc_init();
    args_init();

    var arg0 = argv(0);
    var name = kriya_basename(arg0);
    var start: i64 = 1;

    if (streq(name, "kriya") == 1) {
        if (argc() < 2) {
            print_usage();
            return EXIT_USAGE;
        }
        name = argv(1);
        start = 2;
    }

    return dispatch(name, start);
}

var r = main();
syscall(SYS_EXIT, r);
