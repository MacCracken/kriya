# kriya — BusyBox-style dispatcher.
#
# argv[0]'s basename selects the utility; `kriya <util> [args...]` is
# also accepted (for tests, benches, and fallback when symlinks are
# absent). See docs/adr/0001-busybox-dispatcher-vs-n-binaries.md.
#
# Stdlib (string, fmt, alloc, io, vec, str, syscalls, assert) is
# auto-included via cyrius.cyml [deps].stdlib.

include "src/version_str.cyr"
include "src/lib/exit.cyr"
include "src/lib/errmsg.cyr"
include "src/lib/path.cyr"
include "src/lib/fs.cyr"
include "src/lib/protected.cyr"
include "src/lib/args.cyr"
include "src/cmd/true.cyr"
include "src/cmd/false.cyr"
include "src/cmd/echo.cyr"
include "src/cmd/pwd.cyr"
include "src/cmd/yes.cyr"
include "src/cmd/sleep.cyr"
include "src/cmd/mkdir.cyr"
include "src/cmd/rmdir.cyr"
include "src/cmd/touch.cyr"
include "src/cmd/ln.cyr"
include "src/cmd/cp.cyr"
include "src/cmd/mv.cyr"
include "src/cmd/rm.cyr"
include "src/cmd/basename.cyr"
include "src/cmd/dirname.cyr"
include "src/cmd/realpath.cyr"
include "src/cmd/readlink.cyr"
include "src/cmd/which.cyr"
include "src/cmd/stat.cyr"

fn print_usage() {
    syscall(1, 2, "usage: kriya <utility> [args...]\n", 33);
    syscall(1, 2, "       or invoke a symlink named after the utility (e.g. `true`, `false`).\n", 76);
    return 0;
}

fn print_unknown(name) {
    syscall(1, 2, "kriya: unknown utility: ", 24);
    syscall(1, 2, name, strlen(name));
    syscall(1, 2, "\n", 1);
    return 0;
}

# Route `name` to the matching `cmd_*` function. `start` is the index
# in argv() where the utility's own arguments begin (1 for symlink
# form, 2 for `kriya <util>` form).
fn dispatch(name, start: i64): i64 {
    if (streq(name, "true"))  { return cmd_true(start); }
    if (streq(name, "false")) { return cmd_false(start); }
    if (streq(name, "echo"))  { return cmd_echo(start); }
    if (streq(name, "pwd"))   { return cmd_pwd(start); }
    if (streq(name, "yes"))   { return cmd_yes(start); }
    if (streq(name, "sleep")) { return cmd_sleep(start); }
    if (streq(name, "mkdir")) { return cmd_mkdir(start); }
    if (streq(name, "rmdir")) { return cmd_rmdir(start); }
    if (streq(name, "touch")) { return cmd_touch(start); }
    if (streq(name, "ln"))    { return cmd_ln(start); }
    if (streq(name, "cp"))    { return cmd_cp(start); }
    if (streq(name, "mv"))    { return cmd_mv(start); }
    if (streq(name, "rm"))    { return cmd_rm(start); }
    if (streq(name, "basename")) { return cmd_basename(start); }
    if (streq(name, "dirname"))  { return cmd_dirname(start); }
    if (streq(name, "realpath")) { return cmd_realpath(start); }
    if (streq(name, "readlink")) { return cmd_readlink(start); }
    if (streq(name, "which"))    { return cmd_which(start); }
    if (streq(name, "stat"))     { return cmd_stat(start); }
    print_unknown(name);
    return EXIT_USAGE;
}

fn main(): i64 {
    alloc_init();
    args_init();

    var arg0 = argv(0);
    var name = path_basename_ptr(arg0);
    var start: i64 = 1;

    if (streq(name, "kriya") == 1) {
        if (argc() < 2) {
            print_usage();
            return EXIT_USAGE;
        }
        name = argv(1);
        start = 2;
    }

    return dispatch(name, start);
}

var r = main();
syscall(SYS_EXIT, r);
