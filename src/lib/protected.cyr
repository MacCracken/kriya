# protected.cyr — ADR 0004 protected-paths refusal mechanism.
#
# Hard floor for `kriya rm`: every operand is absolute-path-resolved
# and textually canonicalized (no symlink resolution); if the result
# matches any entry in the protected list, the entire `rm` invocation
# is refused with exit 2. There is no `--no-preserve-root` flag, no
# `KRIYA_*` env var, and no build-time bypass — the table is the
# only place to add or remove an entry, and any future expansion is
# strictly tightening.
#
# The table ships with `/` only at v0.3.0. Per ADR 0004, future
# maintainers can add entries (`/etc`, `/usr`, `/boot`, ...) without
# a new ADR — strictly tightening the policy is in-charter. REMOVING
# `/` requires a successor ADR and a major version bump.
#
# Mechanism (path-text only — no `realpath`, no symlink resolution):
#   1. Convert operand to absolute by joining against `getcwd()` if
#      relative.
#   2. `path_normalize` to collapse `.`, `..`, duplicate slashes.
#   3. String-equal compare against each entry in
#      `_protected_path_at(i)` for i in 0..count.
#
# `rm` never follows symlinks (ADR 0003 hard rule #1). The text-only
# canonicalization here mirrors that: a symlink-to-/ pointed at by
# the user is canonicalized as the symlink's *name*, not its target;
# `rm` would unlink the link, not touch `/`.

# Count of protected paths. Used by `is_protected_path` to iterate.
fn protected_path_count(): i64 {
    return 1;
}

# Return the i-th protected path as a static cstring. Out-of-range
# returns 0.
fn protected_path_at(i): i64 {
    if (i == 0) { return "/"; }
    return 0;
}

# Canonicalize `operand` into an absolute, textually-normalized path and return
# a heap-allocated cstring: relative operands are joined against `getcwd()`, `..`
# resolves TEXTUALLY, and symlinks are never dereferenced. This is the form the
# refusal-check compares against the protected list.
#
# The body moved to `fs_path_absolute` (`src/lib/fs.cyr`) at v1.1.11, unchanged,
# when `cp`'s copy-a-directory-into-itself guard turned out to need the same
# absolute-and-textually-normalized frame. This stays as the ADR-0004-facing name
# so the guard still reads in its own vocabulary; the contract above — including
# the `getcwd`-failure fallback — is documented and implemented there.
#
# ⚠ Any change to `fs_path_absolute` changes what `rm` refuses. `tests/kriya.tcyr`
# pins the 21 spellings of `/` that must stay refused; run it after touching it.
fn protected_canonicalize(operand): i64 {
    return fs_path_absolute(operand);
}

# 1 if `operand`'s canonical form matches any protected path, 0
# otherwise. The caller decides what to do — `cmd_rm` refuses the
# whole invocation with exit 2.
fn is_protected_path(operand): i64 {
    var canon = protected_canonicalize(operand);

    # ⛔ FAIL CLOSED WHEN THE PATH CANNOT BE CANONICALIZED. `fs_path_absolute`
    # returns an absolute path in every success case, so a RELATIVE result can
    # only mean its `getcwd` fallback fired — and without a cwd there is no way
    # to know what a relative operand names. The old behaviour was to hand back
    # the relative form, which then failed to string-match "/" and let `rm`
    # proceed: the refusal failed OPEN exactly when it could not do its job.
    # Reachable in practice — a cwd over 4095 bytes (30 nested 200-char
    # directories) makes `getcwd` fail, and `kriya pwd -P` reports it plainly.
    #
    # ⚠ Today the `/`-only table makes this mostly theoretical: an operand can
    # only resolve to "/" if it ENDS in "." or "..", and `_rm_is_dot_operand`
    # now refuses those outright. It stops being theoretical the moment the
    # table grows — and ADR 0004 explicitly invites maintainers to add `/etc`,
    # `/usr`, `/boot` without a successor ADR. `../../etc` from a deep cwd has
    # no dot final component and would sail straight through.
    if (path_is_absolute(canon) == 0) { return 1; }

    var n = protected_path_count();
    var i: i64 = 0;
    while (i < n) {
        var p = protected_path_at(i);
        if (streq(canon, p) == 1) { return 1; }
        i = i + 1;
    }
    return 0;
}

# 1 if `op` carried a trailing slash AND its final component (after stripping
# those slashes) is a symlink — the shape ADR 0010 refuses. ⭐ Shared since 1.8.2:
# `rm` refuses it as an operand and `find -delete` as a starting point (ADR 0027),
# because the hazard is the same in both — a second deletion path that let it
# through would be a hole in ADR 0010.
#
# ⛔ `rm -r link/` IS WORSE THAN EITHER FOLLOWING OR REFUSING. A trailing slash is
# POSIX-defined to resolve to the linked-to directory, so the walk descends into
# the target and EMPTIES IT — and then fails to unlink `link` itself, because
# `link/` is not a directory to `unlinkat(AT_REMOVEDIR)`. Measured identical in
# GNU: `real/` loses every file, the symlink survives, exit is non-zero. The
# operation reports failure AFTER destroying the data, so the user sees an error,
# sees the link still there, and reasonably concludes nothing happened.
#
# ⚠ It also contradicts kriya's own floor. ADR 0003 hard rule #1 is that `rm`
# never follows a symlink and no flag opts in; the trailing slash was a
# POSIX-blessed way to follow one, on the utility CLAUDE.md singles out as the
# most dangerous. ADR 0010 closes it.
#
# `rm link` (no slash) is untouched — it unlinks the link, which is both POSIX
# and ADR 0003.
fn protected_is_slashed_symlink(op): i64 {
    if (op == 0) { return 0; }
    var len = strlen(op);
    if (len < 2) { return 0; }

    # Must have carried at least one trailing slash.
    if (load8(op + len - 1) != 47) { return 0; }

    # Strip them; "/" itself is left to the ADR-0004 protected check.
    var stripping: i64 = 1;
    while (stripping == 1) {
        if (len > 1) {
            if (load8(op + len - 1) == 47) { len = len - 1; }
            else { stripping = 0; }
        } else {
            stripping = 0;
        }
    }
    if (len < 1) { return 0; }

    # Copy the stripped form so lstat sees the name without the slash — with the
    # slash, lstat resolves the target and reports a directory, which is exactly
    # the confusion this guard exists to remove.
    var bare = alloc(len + 1);
    memcpy(bare, op, len);
    store8(bare + len, 0);

    var st[144];
    if (fs_lstat_at(0 - 100, bare, &st) != 0) { return 0; }
    return fs_is_lnk(&st);
}
