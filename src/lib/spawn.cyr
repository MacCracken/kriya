# spawn.cyr — kriya's own fork + execve + waitpid, for utilities that run
# user-named commands (`find -exec`, `xargs`).
#
# ⛔ WHY THIS EXISTS RATHER THAN stdlib `exec_env`: THAT FUNCTION SILENCES THE
# CHILD. Its Linux arm opens `/dev/null` and `dup2`s it onto **fd 2** before
# exec (`lib/process.cyr`), so every diagnostic the child writes is discarded.
# Measured: `chmod 555 rot; kriya find rot -name '*.tmp' -exec rm {} \;` printed
# NOTHING and exited 0 while deleting nothing, where GNU prints a "Permission
# denied" line per file. A cleanup job written that way reports complete success
# having done nothing at all — the failure mode with no visible symptom.
#
# ⛔ IT ALSO COLLAPSES EVERY NON-EXIT OUTCOME TO -1. `exec_env` returns
# `WEXITSTATUS` on a normal exit and -1 for anything else, so "killed by a
# signal" and "fork failed" are indistinguishable, and a failed exec arrives as
# the child's `sys_exit(127)` — identical to a child that genuinely exited 127.
# POSIX `xargs` has to tell those apart: 127 not-found, 126 not-executable,
# 125 signalled, 124 exit-255, 123 any other nonzero. kriya reported 127 for a
# signalled child and 123 for a non-executable one.
#
# ⭐ THE CLOEXEC PIPE IS WHAT MAKES "EXEC FAILED" DISTINGUISHABLE. The child
# holds the write end with FD_CLOEXEC set: a successful `execve` closes it and
# the parent reads EOF; a failed one writes its errno through before exiting.
# There is no other way to separate an exec failure from a child that chose to
# exit with the same status.
#
# ⚠ agnos has no fork. It offers `execwait(path, len)` — a blocking load-and-run
# of a static ELF with no argv, no envp and no fd control — so that arm delegates
# to stdlib `exec_vec` and can only report an exit status. It also never had the
# `/dev/null` redirect, so the stderr bug was Linux-only to begin with.

# Encoded `k_spawn` result. Kept as small positive tags rather than a raw wait
# status because agnos cannot produce one, and a shared decoder beats two.
enum KSpawnR {
    K_SPAWN_SIGNAL_BASE = 1000;   # + signal number
    K_SPAWN_EXECFAIL    = 2000;   # + errno; the command never started
    K_SPAWN_FORKFAIL    = 3000;
}

fn k_spawn_exited(r): i64 {
    if (r < 0)    { return 0; }
    if (r >= 256) { return 0; }
    return 1;
}
fn k_spawn_exit_status(r): i64 { return r; }

fn k_spawn_signalled(r): i64 {
    if (r < K_SPAWN_SIGNAL_BASE) { return 0; }
    if (r >= K_SPAWN_EXECFAIL)   { return 0; }
    return 1;
}
fn k_spawn_signal(r): i64 { return r - K_SPAWN_SIGNAL_BASE; }

fn k_spawn_execfailed(r): i64 {
    if (r < K_SPAWN_EXECFAIL)  { return 0; }
    if (r >= K_SPAWN_FORKFAIL) { return 0; }
    return 1;
}
fn k_spawn_exec_errno(r): i64 { return r - K_SPAWN_EXECFAIL; }

# Run `args` (vec of cstr; args[0] is the path to exec) with `env` (vec of cstr),
# INHERITING fds 0, 1 and 2 untouched. Blocks until the child is reaped.
# Spawn `args` with `env`, executing `exec_path` rather than `args[0]`.
#
# ⛔ THE EXEC TARGET AND argv[0] ARE NOT THE SAME THING. `execvp` resolves the
# command name against PATH to decide WHAT to run, but hands the child argv[0]
# EXACTLY as written. kriya resolves for a real reason — a bare name must not be
# left for the kernel to resolve against the current directory, which in the
# `find /shared -exec` shape is attacker-writable — but overwriting args[0] with
# the resolved path made every -exec'd program report itself by absolute path:
#
#     /usr/bin/rm: cannot remove 'x': Permission denied     (kriya)
#     rm: cannot remove 'x': Permission denied              (GNU)
#
# ⚠ That divergence was invisible on the dev box for two releases: coreutils
# 9.11 basenames argv[0] before printing, so it printed `rm:` either way. The
# runner's 9.4 does not, which is what finally showed it. A passing GNU-parity
# test can be passing because of the local GNU's version, not because kriya is
# right.
fn k_spawn_as(exec_path, args, env): i64 {
    var argc = vec_len(args);
    if (argc < 1) { return K_SPAWN_FORKFAIL; }

    #ifdef CYRIUS_TARGET_AGNOS
    # ⚠ agnos divergence, and it is the stdlib's shape, not a choice here:
    # `exec_vec` takes only the vector and uses element 0 as BOTH the exec
    # target and argv[0], so the two cannot be separated. The resolved path
    # wins (running the right binary matters more than the error prefix); the
    # caller's vector is restored so a looping caller like `xargs` is unaffected.
    var saved = vec_get(args, 0);
    vec_set(args, 0, exec_path);
    var ar = exec_vec(args);
    vec_set(args, 0, saved);
    if (ar < 0) { return K_SPAWN_FORKFAIL; }
    if (ar > 255) { return 255; }
    return ar;
    #endif

    #ifndef CYRIUS_TARGET_AGNOS
    return _k_spawn_linux(exec_path, args, env, 0 - 1, 0);
    #endif
}

# `k_spawn_as`, with the child's working directory and stdin chosen (1.8.2): it
# `fchdir`s to `dirfd` before exec when `dirfd >= 0` — `find -execdir` / `-okdir`
# run the command in the directory holding the entry — and `flags` is KSpawnFlag
# bits. A failed `fchdir` is reported like a failed exec: the command never ran.
# ⚠ agnos has no working directory, so `find` refuses -execdir there before any
# of this; the arm answers fork-failed rather than run in the wrong place.
fn k_spawn_in(exec_path, args, env, dirfd, flags): i64 {
    if (vec_len(args) < 1) { return K_SPAWN_FORKFAIL; }
    #ifdef CYRIUS_TARGET_AGNOS
    if (dirfd >= 0) { return K_SPAWN_FORKFAIL; }
    return k_spawn_as(exec_path, args, env);
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    return _k_spawn_linux(exec_path, args, env, dirfd, flags);
    #endif
}

fn k_spawn(args, env): i64 {
    var argc = vec_len(args);
    if (argc < 1) { return K_SPAWN_FORKFAIL; }
    return k_spawn_as(vec_get(args, 0), args, env);
}

# `k_spawn_argv` flags.
enum KSpawnFlag {
    K_SPAWN_STDIN_NULL = 1;   # the child reads /dev/null, not our stdin
}

# Run `exec_path` with the NULL-terminated pointer arrays `argvp` and `envp`,
# as they are — nothing is allocated per call (1.7.0).
#
# ⛔ `k_spawn_as` builds a fresh argv and envp array from vectors on every call,
# and the allocator never frees: `xargs -n1` over 80,000 items peaked at 84.5 MB.
# A caller that runs a command per item keeps its arrays and passes them here.
#
# ⛔ K_SPAWN_STDIN_NULL IS WHAT LETS XARGS STREAM. xargs reads its own stdin as
# it goes, so a child that inherited it — `sh -c 'cat'` — would read the input
# meant for the commands still to come. GNU's `prep_child_for_exec` gives the
# child /dev/null; so does this. `find -exec` keeps stdin, as GNU's does.
fn k_spawn_argv(exec_path, argvp, envp, flags): i64 {
    return k_spawn_argv_in(exec_path, argvp, envp, flags, 0 - 1);
}

# `k_spawn_argv` in the directory `dirfd` (`find -execdir … +`, 1.8.2); `-1` for none.
fn k_spawn_argv_in(exec_path, argvp, envp, flags, dirfd): i64 {
    return k_spawn_argv_io(exec_path, argvp, envp, flags, dirfd, 0 - 1);
}

# ...and with the child's stdin taken from `infd` when it is `>= 0` (`xargs -o`'s
# /dev/tty, 1.8.2), which wins over K_SPAWN_STDIN_NULL.
fn k_spawn_argv_io(exec_path, argvp, envp, flags, dirfd, infd): i64 {
    if (load64(argvp) == 0) { return K_SPAWN_FORKFAIL; }
    #ifdef CYRIUS_TARGET_AGNOS
    # ⚠ agnos passes no arguments and no environment (`lib/process_agnos.cyr`);
    # only the program runs, as `k_spawn_as`'s agnos arm says. No working directory either.
    if (dirfd >= 0) { return K_SPAWN_FORKFAIL; }
    if (infd >= 0) { return K_SPAWN_FORKFAIL; }
    var v = vec_new();
    vec_push(v, exec_path);
    var ar = exec_vec(v);
    if (ar < 0) { return K_SPAWN_FORKFAIL; }
    if (ar > 255) { return 255; }
    return ar;
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    return _k_spawn_core(exec_path, argvp, envp, flags, dirfd, infd);
    #endif
}

# Linux arm of `k_spawn_as`. ⚠ The body stays inside `#ifndef CYRIUS_TARGET_AGNOS`
# — it uses fork/pipe/fcntl/waitpid, none of which agnos provides with these
# signatures. On agnos it compiles to the fall-through return and is never
# called, because `k_spawn_as` returns from its own agnos arm first.
fn _k_spawn_linux(exec_path, args, env, dirfd, flags): i64 {
    #ifndef CYRIUS_TARGET_AGNOS
    var argc = vec_len(args);
    if (argc < 1) { return K_SPAWN_FORKFAIL; }

    # ⭐ The exec target, separate from argv[0] — see `k_spawn_as`.
    var cmd = exec_path;
    var argv = alloc((argc + 1) * 8);
    var ai: i64 = 0;
    while (ai < argc) {
        store64(argv + ai * 8, vec_get(args, ai));
        ai = ai + 1;
    }
    store64(argv + argc * 8, 0);

    var envc = vec_len(env);
    var envp = alloc((envc + 1) * 8);
    var ei: i64 = 0;
    while (ei < envc) {
        store64(envp + ei * 8, vec_get(env, ei));
        ei = ei + 1;
    }
    store64(envp + envc * 8, 0);

    return _k_spawn_core(cmd, argv, envp, flags, dirfd, 0 - 1);
    #endif
    return K_SPAWN_FORKFAIL;
}

# fchdir(fd). ⛔ The stdlib wraps `sys_chdir` but not `fchdir`, and on aarch64 NO literal
# reaches fchdir (50): cyrius renumbers a literal 50 as x86 `listen`, silently, and passes
# x86's 81 through, where aarch64 81 is `sync`. Measured with qemu-aarch64 -strace: the child
# ran `listen(4, 0)` and failed ENOTSOCK. So aarch64 does `chdir("/proc/self/fd/N")` through
# the per-arch `sys_chdir`: the magic link names exactly the directory the descriptor holds,
# as fchdir would. Filed upstream: cyrius issues `2026-11-03-stdlib-has-no-sys-fchdir.md`.
fn _k_fchdir(fd): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    return 0 - 38;
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    #ifdef CYRIUS_ARCH_AARCH64
    var p[32];                                     # "/proc/self/fd/" + 10 digits + NUL
    memcpy(&p, "/proc/self/fd/", 14);
    var n = str_u64_digits(fd, 10, 0, &p + 14);
    store8(&p + 14 + n, 0);
    return sys_chdir(&p);
    #endif
    #ifndef CYRIUS_ARCH_AARCH64
    return syscall(81, fd);                        # x86_64 fchdir
    #endif
    #endif
}

# The fork and exec, on prepared arrays, WITHOUT the wait (1.8.2, `xargs -P`). `flags` is
# KSpawnFlag bits; the child `fchdir`s to `dirfd` first when it is `>= 0`, and reads `infd`
# when that is. Returns 0 with the pid in `*pidp` once execve has TAKEN the arguments — the
# CLOEXEC pipe closes only then — so the caller may reuse argv at once, which is what lets
# one argbatch buffer feed several running commands. Or K_SPAWN_EXECFAIL + errno, or
# K_SPAWN_FORKFAIL, the failed child already reaped.
fn _k_spawn_start(cmd, argv, envp, flags, dirfd, infd, pidp): i64 {
    #ifndef CYRIUS_TARGET_AGNOS
    # Two i32 fds in an 8-byte local. ⚠ `var fds[8]` is 8 BYTES here — a
    # function-local `var X[N]` is N bytes (roadmap M15a).
    var fds[8];
    var pr = syscall(22, &fds);                    # SYS_PIPE
    var rfd: i64 = 0 - 1;
    var wfd: i64 = 0 - 1;
    if (pr == 0) {
        rfd = load32(&fds) & 4294967295;
        wfd = load32(&fds + 4) & 4294967295;
        syscall(72, wfd, 2, 1);                    # SYS_FCNTL, F_SETFD, FD_CLOEXEC
    }

    var pid = sys_fork();
    if (pid < 0) {
        if (rfd >= 0) { k_close(rfd); k_close(wfd); }
        return K_SPAWN_FORKFAIL;
    }
    if (pid == 0) {
        # ⚠ fds 1 and 2 are deliberately NOT touched — that single omission is
        # the entire stderr fix — and fd 0 only when the caller asks.
        if (rfd >= 0) { k_close(rfd); }
        if ((flags & K_SPAWN_STDIN_NULL) != 0) {
            k_close(0);
            var nfd = k_open("/dev/null", 0, 0);
            if (nfd > 0) {
                sys_dup2(nfd, 0);
                k_close(nfd);
            }
        }
        if (infd >= 0) { sys_dup2(infd, 0); }
        var xr: i64 = 0;
        if (dirfd >= 0) { xr = _k_fchdir(dirfd); }
        if (xr == 0) { xr = sys_execve(cmd, argv, envp); }
        # Only reachable when execve failed. Report the errno through the pipe;
        # its closure on success is what the parent reads as "it started".
        if (wfd >= 0) {
            var eb[8];
            store64(&eb, 0 - xr);
            k_write( wfd, &eb, 8);
        }
        sys_exit(127);
    }

    var exec_errno: i64 = 0;
    if (rfd >= 0) {
        k_close(wfd);
        var rb[8];
        store64(&rb, 0);
        var n = k_read( rfd, &rb, 8);
        if (n == 8) { exec_errno = load64(&rb); }
        k_close(rfd);
    }

    if (exec_errno > 0) {
        var xb[4];
        sys_waitpid(pid, &xb, 0);
        return K_SPAWN_EXECFAIL + exec_errno;
    }
    store64(pidp, pid);
    return 0;
    #endif
    return K_SPAWN_FORKFAIL;
}

# A wait status, as the k_spawn results encode it.
fn _k_spawn_decode(st): i64 {
    if (WIFSIGNALED(st) == 1) { return K_SPAWN_SIGNAL_BASE + WTERMSIG(st); }
    if (WIFEXITED(st) == 1)   { return WEXITSTATUS(st); }
    return K_SPAWN_FORKFAIL;
}

# The fork, exec and wait: `_k_spawn_start`, then the wait for that one child.
fn _k_spawn_core(cmd, argv, envp, flags, dirfd, infd): i64 {
    #ifndef CYRIUS_TARGET_AGNOS
    var pid: i64 = 0;
    var r = _k_spawn_start(cmd, argv, envp, flags, dirfd, infd, &pid);
    if (r != 0) { return r; }
    var stbuf[4];
    sys_waitpid(pid, &stbuf, 0);
    return _k_spawn_decode(load32(&stbuf));
    #endif
    return K_SPAWN_FORKFAIL;
}

# Start a command and return without waiting (`xargs -P`): 0 with its pid in `*pidp`, or a
# failure as `k_spawn_argv` reports one. ⚠ agnos has no fork, so it answers fork-failed and
# `xargs` runs its commands one at a time there, which -P N permits.
fn k_spawn_start(exec_path, argvp, envp, flags, infd, pidp): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    return K_SPAWN_FORKFAIL;
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    return _k_spawn_start(exec_path, argvp, envp, flags, 0 - 1, infd, pidp);
    #endif
}

# Wait for ANY child started by `k_spawn_start`: its result, encoded as `k_spawn_argv`'s are,
# with its pid in `*pidp`; -1 when none is left.
fn k_spawn_reap(pidp): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    return 0 - 1;
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    var stbuf[4];
    var p = sys_waitpid(0 - 1, &stbuf, 0);
    if (p < 0) { return 0 - 1; }
    store64(pidp, p);
    return _k_spawn_decode(load32(&stbuf));
    #endif
}
