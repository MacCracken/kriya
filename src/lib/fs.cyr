# fs.cyr — kriya filesystem traversal primitives.
#
# Foundation for the TOCTOU-safe recursive walks in `cp -R`,
# cross-FS `mv`, and `rm -r` per ADR 0003. Every traversal step is
# `openat(parent_fd, name, O_NOFOLLOW | O_DIRECTORY)` from an explicit
# dirfd — no chdir, no path-relative open. A directory entry replaced
# by a symlink between the lstat that classified it and the open that
# descends fails with `ELOOP`, never silently follows.
#
# Stdlib wrappers for the `*at()` family and the AT_* / UTIME_*
# constants are pending Cyrius proposal
# `2026-05-17-syscalls-at-family-stdlib`. Until they land, these
# wrappers carry the Linux x86_64 syscall numbers inline as decimal
# literals. When the proposal accepts, the file sweeps to use
# `sys_openat` / `sys_unlinkat` / etc. — by name, no number magic.
#
# This file is filesystem-aware; pure path operations stay in
# `src/lib/path.cyr` (no overlap).
#
# Bytes referenced as decimal-with-comment per the running practice
# (no octal literal yet in Cyrius — see proposal
# `2026-05-17-octal-literal-syntax`).

# --- AT_* and related flag constants -------------------------------

enum FsAt {
    FS_AT_SYMLINK_NOFOLLOW = 256;     # 0x100
    FS_AT_REMOVEDIR        = 512;     # 0x200
    FS_AT_SYMLINK_FOLLOW   = 1024;    # 0x400
}

# AT_FDCWD = -100. Cyrius enum values don't accept the `0 - 100`
# expression form (CLAUDE.md: "no negative literals"), so it lives
# as a zero-cost function — every call site reads it by name.
fn fs_at_fdcwd(): i64 {
    return 0 - 100;
}

# Open flags pertinent to traversal. Subset of <fcntl.h>.
enum FsOpen {
    FS_O_RDONLY    = 0;
    FS_O_WRONLY    = 1;
    FS_O_TRUNC     = 512;        # 0o1000
    FS_O_DIRECTORY = 65536;      # 0o200000  (0x10000)
    FS_O_NOFOLLOW  = 131072;     # 0o400000  (0x20000)
    FS_O_CLOEXEC   = 524288;     # 0o2000000 (0x80000)
}

# linux_dirent64.d_type values. The kernel returns these in the
# `getdents64` stream and they short-circuit a per-entry lstat for
# the common cases (regular file vs directory vs symlink). DT_UNKNOWN
# means "fall back to lstat".
enum FsDType {
    FS_DT_UNKNOWN = 0;
    FS_DT_FIFO    = 1;
    FS_DT_CHR     = 2;
    FS_DT_DIR     = 4;
    FS_DT_BLK     = 6;
    FS_DT_REG     = 8;
    FS_DT_LNK     = 10;
    FS_DT_SOCK    = 12;
}

# struct stat field offsets (Linux x86_64). Mirrors the stdlib `Stat`
# enum in `syscalls_x86_64_linux.cyr` — duplicated here so fs.cyr's
# callers don't need to include the lower-level enum.
enum FsStat {
    FS_STAT_DEV        = 0;
    FS_STAT_INO        = 8;
    FS_STAT_NLINK      = 16;
    FS_STAT_MODE       = 24;
    FS_STAT_UID        = 28;
    FS_STAT_GID        = 32;
    FS_STAT_RDEV       = 40;
    FS_STAT_SIZE       = 48;
    FS_STAT_BLKSIZE    = 56;
    FS_STAT_BLOCKS     = 64;
    FS_STAT_ATIME      = 72;
    FS_STAT_ATIME_NSEC = 80;
    FS_STAT_MTIME      = 88;
    FS_STAT_MTIME_NSEC = 96;
    FS_STAT_CTIME      = 104;
    FS_STAT_CTIME_NSEC = 112;
    FS_STAT_BUFSZ      = 144;
}

# S_IFMT mask + type values (subset).
enum FsMode {
    FS_S_IFMT   = 61440;   # 0o170000
    FS_S_IFREG  = 32768;   # 0o100000
    FS_S_IFDIR  = 16384;   # 0o040000
    FS_S_IFLNK  = 40960;   # 0o120000
    FS_S_IFCHR  = 8192;    # 0o020000
    FS_S_IFBLK  = 24576;   # 0o060000
    FS_S_IFIFO  = 4096;    # 0o010000
    FS_S_IFSOCK = 49152;   # 0o140000
}

# --- type predicates on a 144-byte stat buffer ---------------------

fn fs_is_reg(stat_buf): i64 {
    var m = load64(stat_buf + 24);
    if ((m & 61440) == 32768) { return 1; }
    return 0;
}

fn fs_is_dir(stat_buf): i64 {
    var m = load64(stat_buf + 24);
    if ((m & 61440) == 16384) { return 1; }
    return 0;
}

fn fs_is_lnk(stat_buf): i64 {
    var m = load64(stat_buf + 24);
    if ((m & 61440) == 40960) { return 1; }
    return 0;
}

# Extract the low-12 mode bits (permission + setuid/gid/sticky).
fn fs_perms(stat_buf): i64 {
    return load64(stat_buf + 24) & 4095;
}

# --- syscall wrappers ----------------------------------------------
#
# All return Linux convention (`<0` is `-errno`).
#
# Numbers below are x86_64. When the stdlib at-family lands these
# become per-arch-routed; until then, x86_64-only (the kriya build
# target today).

# NOTE on the agnos branches below: agnos has NO dirfd-relative *at()
# calls and NO per-process cwd — only PATH-BASED syscalls (wrapped as
# k_open/k_stat/k_unlink/… in sys.cyr). So each *at wrapper routes to
# the path-based k_* when `dirfd == AT_FDCWD` (-100) — the top-level
# entry point, where the recursive walk seeds from an ABSOLUTE path —
# and returns -ENOSYS (-38) for any real dirfd (mid-recursion,
# relative-to-fd), which agnos cannot satisfy. Net effect: single-level
# / absolute-path ops work; dirfd-relative recursion fails cleanly at
# depth instead of misbehaving. The Linux branch (#ifndef) keeps the
# exact raw-syscall body unchanged.

fn fs_openat(dirfd, path, flags, mode): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    if (dirfd == k_at_fdcwd()) { return k_open(path, flags, mode); }
    return 0 - 38;                               # no open-relative-to-fd on agnos (ENOSYS)
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    return syscall(257, dirfd, path, flags, mode);
    #endif
}

# fstatat with explicit `flags`. Use AT_SYMLINK_NOFOLLOW (256) for
# lstat-equivalent, 0 for stat-equivalent.
fn fs_fstatat(dirfd, path, buf, flags): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    # agnos has no symlinks, so the NOFOLLOW flag is irrelevant → k_stat.
    if (dirfd == k_at_fdcwd()) { return k_stat(path, buf); }
    return 0 - 38;
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    return syscall(262, dirfd, path, buf, flags);
    #endif
}

fn fs_lstat_at(dirfd, path, buf): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    if (dirfd == k_at_fdcwd()) { return k_lstat(path, buf); }
    return 0 - 38;
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    return syscall(262, dirfd, path, buf, 256);  # AT_SYMLINK_NOFOLLOW
    #endif
}

# stat a directory ENTRY identified by (dirfd, name) during a readdir walk.
# `fullpath` is the entry's absolute path (dirpath joined with name) — the
# caller already has it. follow=1 -> stat (deref), 0 -> lstat. Linux uses the
# dirfd-relative *at (TOCTOU-safe per ADR 0003); agnos has no dirfd-relative
# call, so it stats `fullpath` directly (no symlinks there, so no TOCTOU gap).
# This is what lets ls -l / du show real metadata on agnos, where a real-dirfd
# fs_lstat_at would return -38.
fn fs_stat_entry(dirfd, fullpath, name, buf, follow): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    if (follow == 1) { return k_stat(fullpath, buf); }
    return k_lstat(fullpath, buf);
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    if (follow == 1) { return fs_fstatat(dirfd, name, buf, 0); }
    return fs_lstat_at(dirfd, name, buf);
    #endif
}

# Open a directory ENTRY for traversal during a readdir walk, the peer of
# `fs_stat_entry` above and with the same bargain: Linux descends from the
# `dirfd` with the bare `name` (TOCTOU-safe per ADR 0003), agnos opens
# `fullpath` because it has no dirfd-relative call at all.
#
# ⛔ WHY THE PAIR EXISTS RATHER THAN JUST `fs_opendir_nofollow`. Re-opening an
# accumulated PATH at each descent means every ancestor component is resolved
# again, so a directory swapped for a symlink mid-walk redirects the walk out of
# the tree. `O_NOFOLLOW` does not help — it guards only the FINAL component.
# `rm`, `cp` and `find` have always descended from a parent fd; `grep -r` was the
# one walk still re-resolving by path, and it could be steered into `/etc`.
#
# ⚠ `fs_opendir_nofollow(real_dirfd, …)` answers -ENOSYS on agnos, so a walk
# built on it alone fails at depth 1 there. That is what this wrapper exists to
# avoid: pass BOTH and each target uses the half it can.
fn fs_open_entry_dir(dirfd, fullpath, name): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    return k_open(fullpath, 65536, 0);            # O_DIRECTORY
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    return fs_opendir_nofollow(dirfd, name);
    #endif
}

# Same bargain for a regular file being read during a walk:
# O_RDONLY | O_NOFOLLOW, dirfd-relative on Linux and path-based on agnos.
fn fs_open_entry_file(dirfd, fullpath, name): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    return k_open(fullpath, 131072, 0);           # O_NOFOLLOW
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    return fs_openat(dirfd, name, 131072, 0);     # O_RDONLY | O_NOFOLLOW
    #endif
}

# Open a directory for traversal in the safe shape required by
# ADR 0003: O_RDONLY | O_DIRECTORY | O_NOFOLLOW. The mode argument
# is unused for read-only opens but the syscall signature wants it.
fn fs_opendir_nofollow(dirfd, name): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    # Pass O_DIRECTORY (k_open maps it to agnos AO_DIRECTORY) so the kernel
    # returns a getdents-capable dir fd; O_NOFOLLOW is moot (no symlinks).
    if (dirfd == k_at_fdcwd()) { return k_open(name, 65536, 0); }
    return 0 - 38;
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    # 0 | 65536 | 131072 = 196608.
    return syscall(257, dirfd, name, 196608, 0);
    #endif
}

fn fs_mkdirat(dirfd, path, mode): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    if (dirfd == k_at_fdcwd()) { return k_mkdir(path, mode); }
    return 0 - 38;
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    return syscall(258, dirfd, path, mode);
    #endif
}

# unlinkat with flags: 0 for files, AT_REMOVEDIR=512 for empty dirs.
fn fs_unlinkat(dirfd, path, flags): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    if (dirfd == k_at_fdcwd()) {
        if ((flags & 512) != 0) { return k_rmdir(path); }   # AT_REMOVEDIR
        return k_unlink(path);
    }
    return 0 - 38;
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    return syscall(263, dirfd, path, flags);
    #endif
}

fn fs_linkat(old_dirfd, old_path, new_dirfd, new_path, flags): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    # Path-based k_link needs BOTH dirfds at AT_FDCWD (no relative resolution).
    if (old_dirfd == k_at_fdcwd()) {
        if (new_dirfd == k_at_fdcwd()) { return k_link(old_path, new_path); }
    }
    return 0 - 38;
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    return syscall(265, old_dirfd, old_path, new_dirfd, new_path, flags);
    #endif
}

fn fs_symlinkat(target, dirfd, link): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    # k_symlink returns -38 on agnos (no symlinks) regardless of dirfd.
    if (dirfd == k_at_fdcwd()) { return k_symlink(target, link); }
    return 0 - 38;
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    return syscall(266, target, dirfd, link);
    #endif
}

fn fs_fchmodat(dirfd, path, mode, flags): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    # k_chmod returns -38 on agnos (no mode bits) regardless of dirfd.
    if (dirfd == k_at_fdcwd()) { return k_chmod(path, mode); }
    return 0 - 38;
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    return syscall(268, dirfd, path, mode, flags);
    #endif
}

fn fs_utimensat(dirfd, path, times, flags): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    # k_utimensat returns -38 on agnos (no utimensat) regardless of dirfd.
    if (dirfd == k_at_fdcwd()) { return k_utimensat(dirfd, path, times, flags); }
    return 0 - 38;
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    return syscall(280, dirfd, path, times, flags);
    #endif
}

fn fs_readlinkat(dirfd, path, buf, bufsize): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    # k_readlink returns -38 on agnos (no symlinks) regardless of dirfd.
    if (dirfd == k_at_fdcwd()) { return k_readlink(path, buf, bufsize); }
    return 0 - 38;
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    return syscall(267, dirfd, path, buf, bufsize);
    #endif
}

# rename(2): rename within a filesystem. Cross-FS returns -EXDEV (-18),
# letting the caller fall back to copy+unlink. SYS_RENAME = 82 on x86_64.
fn fs_rename(oldpath, newpath): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    return k_rename(oldpath, newpath);           # agnos path-based rename
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    return syscall(82, oldpath, newpath);
    #endif
}

# renameat(2): rename rooted at explicit dirfds. SYS_RENAMEAT = 264.
fn fs_renameat(old_dirfd, oldpath, new_dirfd, newpath): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    # Path-based k_rename needs BOTH dirfds at AT_FDCWD (no relative resolution).
    if (old_dirfd == k_at_fdcwd()) {
        if (new_dirfd == k_at_fdcwd()) { return k_rename(oldpath, newpath); }
    }
    return 0 - 38;
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    return syscall(264, old_dirfd, oldpath, new_dirfd, newpath);
    #endif
}

fn fs_close(fd): i64 {
    return k_close( fd);
}

# --- directory entry iteration -------------------------------------
#
# Linux `getdents64(fd, buf, count)` fills `buf` with a stream of
# `struct linux_dirent64`:
#   d_ino:    offset 0,  i64
#   d_off:    offset 8,  i64
#   d_reclen: offset 16, u16  (total record length incl padding)
#   d_type:   offset 18, u8
#   d_name:   offset 19, null-terminated cstring (padded)

# Route through k_getdents on BOTH targets: it picks the per-target
# syscall number (Linux #217 / agnos #29) AND translates agnos's packed
# dirent stream into the Linux linux_dirent64 layout the fs_dent_*
# accessors below read — so callers see one record format everywhere.
fn fs_getdents64(fd, buf, bufsize): i64 {
    return k_getdents(fd, buf, bufsize);
}

# Read d_reclen as a u16. Cyrius has no u16 load, so we assemble it
# from two u8 loads. d_reclen sits at offset 16 within the record.
fn fs_dent_reclen(ent): i64 {
    var lo = load8(ent + 16);
    var hi = load8(ent + 17);
    return (hi << 8) | lo;
}

fn fs_dent_type(ent): i64 {
    return load8(ent + 18);
}

# Pointer to the null-terminated name. Caller treats it as a cstring.
fn fs_dent_name(ent): i64 {
    return ent + 19;
}

# Is this dent named "." or ".."? The kernel always emits these as
# the first two entries of a directory read.
fn fs_dent_is_dotdot(ent): i64 {
    var n = ent + 19;
    if (load8(n) != 46) { return 0; }
    if (load8(n + 1) == 0) { return 1; }  # "."
    if (load8(n + 1) == 46) {
        if (load8(n + 2) == 0) { return 1; }  # ".."
    }
    return 0;
}

# --- canonical path resolution -------------------------------------
#
# `fs_realpath` walks a path component-by-component, normalising `.`
# and `..`, resolving every symlink it encounters, and producing an
# absolute canonical form. The three missing-component policies
# correspond to GNU `realpath`'s `-e`/`-m` and `readlink`'s `-f`:
#
#   FS_REALPATH_REQUIRE_ALL    every component must exist (default for
#                              `realpath` and `readlink -e`).
#   FS_REALPATH_REQUIRE_PARENT every component except the last must
#                              exist (the `readlink -f` mode — the
#                              last component is treated as "would-be
#                              created here" so the canonical path is
#                              defined even if the target doesn't yet).
#   FS_REALPATH_ALLOW_MISSING  no component need exist; once we hit
#                              an ENOENT, we stop lstat'ing and append
#                              the rest as text (`realpath -m`).
#
# Returns the result LENGTH (excluding the null terminator) on success.
# Returns a negative -errno on failure:
#   -ENOENT (-2)         a required component is missing per `mode`.
#   -ENAMETOOLONG (-36)  result wouldn't fit in `out_bufsize`.
#   -ELOOP (-40)         more than 40 symlink resolutions (cycle or
#                        pathologically deep chain).
#   other negative errno propagated from lstat/readlink/getcwd.

enum FsRealpathMode {
    FS_REALPATH_REQUIRE_ALL    = 0;
    FS_REALPATH_REQUIRE_PARENT = 1;
    FS_REALPATH_ALLOW_MISSING  = 2;
}

# Internal helper: strip the last component of `result` (in-place
# truncation by writing a null and updating the length). Mirrors
# `dirname` but operates on the caller's buffer to avoid an alloc.
# `ri` is the current length; returns the new length.
fn _fs_strip_last_component(result, ri): i64 {
    if (ri <= 1) { return 1; }  # don't strip the root
    var p = ri - 1;
    var scanning: i64 = 1;
    while (scanning == 1) {
        if (p == 0) {
            scanning = 0;
        } else {
            if (load8(result + p) == 47) {
                scanning = 0;
            } else {
                p = p - 1;
            }
        }
    }
    if (p == 0) {
        store8(result + 1, 0);
        return 1;
    }
    store8(result + p, 0);
    return p;
}

# Smallest doubling of `cap` that reaches `need`.
fn _fs_grow_cap(cap, need): i64 {
    var c = cap;
    if (c < 1) { c = 1; }
    while (c < need) { c = c * 2; }
    return c;
}

# Copy `used` bytes of `buf` into a fresh `need`-byte allocation.
# ⚠ Bump allocation, so the old block is not reclaimed. `realpath` is one-shot
# per process and grows at most a handful of times, so the waste is bounded and
# the alternative (a free-list for a path buffer) is not worth the machinery.
fn _fs_regrow(buf, used, need): i64 {
    var nb = alloc(need);
    memcpy(nb, buf, used);
    return nb;
}

fn fs_realpath(input, mode, out_buf, out_bufsize): i64 {
    if (input == 0)        { return 0 - 2; }
    if (load8(input) == 0) { return 0 - 2; }

    # ⭐ SIZED FROM THE INPUT, NOT A FIXED CEILING. v1.1.11 bounded the previously
    # unchecked seed copies, which turned a silently wrong answer into an honest
    # ENAMETOOLONG — but it left kriya refusing 16 KiB operands that GNU resolves
    # fine. The buffer was never a limit worth having; it was a constant nobody
    # had revisited. Starting from the operand's own length removes the refusal,
    # and `_fs_grow_cap` handles the symlink expansion beyond it.
    var in_len = strlen(input);
    var BUFSZ = _fs_grow_cap(16384, in_len + 2);
    var result    = alloc(BUFSZ);
    var remaining = alloc(BUFSZ);
    var ri: i64 = 0;

    # Seed result + remaining.
    #
    # ⛔ THE SEED COPIES ARE BOUNDS-CHECKED, AND THEY DID NOT USED TO BE. The
    # append path at the bottom of the segment loop has always answered
    # ENAMETOOLONG when `result` would overflow, which made the whole function
    # look guarded — but `input` came straight from argv and went into a fixed
    # 16 KiB `remaining` with no check at all. Measured: a 16,427-byte operand
    # made `kriya realpath -m` print `…/rp/d/.d` where GNU printed `…/rp/d/f`,
    # AND EXIT 0. Not a crash — a wrong canonical path reported as success, which
    # is worse, because `realpath`/`readlink -f` output is normally fed straight
    # into the next command.
    if (path_is_absolute(input) == 1) {
        store8(result, 47);
        store8(result + 1, 0);
        ri = 1;
        var ilen = in_len;                   # BUFSZ was sized from this
        memcpy(remaining, input + 1, ilen);  # also copies the null
    } else {
        var n = k_getcwd(result, BUFSZ);
        if (n < 0) { return n; }
        ri = n - 1;  # SYS_GETCWD returns length INCLUDING null
        if (ri < 1) { ri = 1; }
        var ilen = in_len;                   # BUFSZ was sized from this
        memcpy(remaining, input, ilen + 1);
    }

    var loop_count: i64 = 0;
    # ⚠ REQUIRE_PARENT-last only. ALLOW_MISSING used to set this too and that was
    # the bug: it stops resolving, so a symlink AFTER a missing component was
    # never followed. GNU keeps going.
    var stopped: i64 = 0;
    var rp: i64 = 0;

    while (load8(remaining + rp) != 0) {
        # Skip leading slashes (collapses "//").
        while (load8(remaining + rp) == 47) { rp = rp + 1; }
        if (load8(remaining + rp) == 0) { rp = rp; }
        else {
            # Find end of segment.
            var seg_end = rp;
            var sc: i64 = 1;
            while (sc == 1) {
                var c = load8(remaining + seg_end);
                if (c == 0) { sc = 0; }
                else {
                    if (c == 47) { sc = 0; }
                    else { seg_end = seg_end + 1; }
                }
            }
            var seg_len = seg_end - rp;

            # Classify.
            var is_dot: i64 = 0;
            var is_dotdot: i64 = 0;
            if (seg_len == 1) {
                if (load8(remaining + rp) == 46) { is_dot = 1; }
            }
            if (seg_len == 2) {
                if (load8(remaining + rp) == 46) {
                    if (load8(remaining + rp + 1) == 46) { is_dotdot = 1; }
                }
            }

            if (is_dot == 1) {
                rp = seg_end;
            } else {
                if (is_dotdot == 1) {
                    # ⛔ `..` IS A DIRECTORY ASSERTION ABOUT WHAT PRECEDES IT.
                    # Popping the text unconditionally is how `base/plainfile/..`
                    # used to answer `/…/base` with exit 0 — a canonical path
                    # invented by walking THROUGH a regular file. GNU says
                    # ENOTDIR, and so does `cd`. ⚠ Only the strict modes assert
                    # it: `realpath -m base/plainfile/..` answers `/…/base`, and
                    # that is measured, not assumed.
                    if (mode != 2) {
                        if (stopped == 0) {
                            var dst[144];
                            var dr = fs_fstatat(0 - 100, result, &dst, 0);
                            if (dr != 0) { return dr; }
                            if (fs_is_dir(&dst) == 0) { return 0 - 20; }
                        }
                    }
                    ri = _fs_strip_last_component(result, ri);
                    rp = seg_end;
                } else {
                    # Build candidate by appending seg to result.
                    var sep: i64 = 1;
                    if (ri == 1) {
                        if (load8(result) == 47) { sep = 0; }
                    }
                    # Grow rather than refuse. Only `result` carries state here;
                    # `remaining` is read-only until the symlink branch replaces
                    # it wholesale, and the scratch buffers are freshly allocated.
                    if (ri + sep + seg_len + 1 > BUFSZ) {
                        var need = ri + sep + seg_len + 1;
                        BUFSZ = _fs_grow_cap(BUFSZ, need);
                        result = _fs_regrow(result, ri + 1, BUFSZ);
                    }
                    if (sep == 1) {
                        store8(result + ri, 47);
                        ri = ri + 1;
                    }
                    memcpy(result + ri, remaining + rp, seg_len);
                    var candidate_end = ri + seg_len;
                    store8(result + candidate_end, 0);

                    if (stopped == 1) {
                        ri = candidate_end;
                        rp = seg_end;
                    } else {
                        var st[144];
                        var sr = fs_lstat_at(0 - 100, result, &st);
                        if (sr != 0) {
                            var errno = 0 - sr;
                            # ⛔ ALLOW_MISSING TOLERATES ANY LSTAT FAILURE, not
                            # only ENOENT — and it KEEPS GOING rather than
                            # appending the rest untouched. Both halves were
                            # wrong, and both are measured against GNU's
                            # `realpath -m`, which is the same mode:
                            #
                            #   `realpath -m nonexistent/../slink/sub/f` — GNU
                            #   resolves `slink` AFTER the missing component and
                            #   answers `real/sub/f`; stopping answered
                            #   `slink/sub/f`.
                            #
                            #   `realpath -m loopa` on a symlink loop — GNU
                            #   answers the path; refusing anything but ENOENT
                            #   made it an error (ELOOP), and `ln -sr` then fell
                            #   back to the raw operand and wrote a link that
                            #   silently pointed at a DIFFERENT REAL FILE.
                            #
                            # ⚠ gnulib calls this CAN_MISSING and the rule is
                            # simply "a component we cannot lstat is not a
                            # symlink" — so commit it and carry on. ENOTDIR and
                            # EACCES land here too, and both are ordinary.
                            if (mode == 2) {
                                ri = candidate_end;
                                rp = seg_end;
                            } else {
                                if (errno != 2) { return sr; }
                                # ENOENT — is this the last segment of remaining?
                                var is_last: i64 = 1;
                                var pp = seg_end;
                                while (load8(remaining + pp) == 47) { pp = pp + 1; }
                                if (load8(remaining + pp) != 0) { is_last = 0; }

                                if (mode == 0) { return 0 - 2; }  # REQUIRE_ALL
                                if (mode == 1) {
                                    if (is_last == 0) { return 0 - 2; }  # REQUIRE_PARENT, not last
                                }
                                # REQUIRE_PARENT on the last segment: commit, stop.
                                ri = candidate_end;
                                stopped = 1;
                                rp = seg_end;
                            }
                        } else {
                            var is_link = fs_is_lnk(&st);
                            # ⛔ THE LOOP LIMIT IS AN ERROR IN THE STRICT MODES AND
                            # A STOPPING POINT IN ALLOW_MISSING. `realpath -m` on a
                            # symlink loop answers the path under GNU rather than
                            # failing — and when it failed here, `ln -sr` fell back
                            # to the raw operand and wrote a link that silently
                            # pointed at a DIFFERENT REAL FILE. ⚠ `loop_count` is
                            # per-call and never resets, so refusing to follow any
                            # further symlink still terminates.
                            if (is_link == 1) {
                                if (loop_count >= 40) {
                                    if (mode == 2) { is_link = 0; }
                                }
                            }
                            if (is_link == 1) {
                                loop_count = loop_count + 1;
                                if (loop_count > 40) { return 0 - 40; }

                                var link_buf = alloc(BUFSZ);
                                var ln = fs_readlinkat(0 - 100, result, link_buf, BUFSZ - 1);
                                if (ln < 0) { return ln; }
                                store8(link_buf + ln, 0);

                                # Strip the segment we just appended (the symlink).
                                ri = candidate_end - seg_len - sep;
                                if (ri < 1) { ri = 1; }
                                store8(result + ri, 0);

                                # If link is absolute, reset result to "/".
                                if (path_is_absolute(link_buf) == 1) {
                                    store8(result, 47);
                                    store8(result + 1, 0);
                                    ri = 1;
                                }

                                # Build new remaining = link_target + "/" + (old remaining past seg_end).
                                var new_remaining = alloc(BUFSZ);
                                var copy_off: i64 = 0;
                                var tl = ln;
                                if (path_is_absolute(link_buf) == 1) {
                                    memcpy(new_remaining, link_buf + 1, tl);
                                    tl = tl - 1;
                                } else {
                                    memcpy(new_remaining, link_buf, tl);
                                }
                                var rest_off = seg_end;
                                # ⛔ REMEMBER WHETHER A SEPARATOR FOLLOWED THE
                                # LINK. `flink/` expands to the target and the
                                # slash-skipping below then DROPS the slash, so
                                # the directory assertion at the commit never
                                # sees it and `realpath flink/` answered the
                                # regular file with exit 0. ⚠ The slash is the
                                # whole statement being made about the path.
                                var had_sep: i64 = 0;
                                if (load8(remaining + seg_end) == 47) { had_sep = 1; }
                                while (load8(remaining + rest_off) == 47) { rest_off = rest_off + 1; }
                                var rest_len = strlen(remaining + rest_off);
                                # ⚠ `tl` is bounded by the readlink limit and `rest_len` by
                                # BUFSZ, so their SUM can approach twice BUFSZ — and each round
                                # of expansion grows `remaining`, so a chain of links is the
                                # natural way to reach it. Grow rather than refuse; the ELOOP
                                # counter above (40) is what actually bounds the chain.
                                if (tl + rest_len + 2 > BUFSZ) {
                                    BUFSZ = _fs_grow_cap(BUFSZ, tl + rest_len + 2);
                                    new_remaining = _fs_regrow(new_remaining, tl, BUFSZ);
                                }
                                if (rest_len > 0) {
                                    store8(new_remaining + tl, 47);
                                    memcpy(new_remaining + tl + 1, remaining + rest_off, rest_len + 1);
                                } else {
                                    if (had_sep == 1) {
                                        store8(new_remaining + tl, 47);
                                        store8(new_remaining + tl + 1, 0);
                                    } else {
                                        store8(new_remaining + tl, 0);
                                    }
                                }

                                remaining = new_remaining;
                                rp = 0;
                            } else {
                                # ⛔ A SEPARATOR AFTER A COMPONENT IS A DIRECTORY
                                # ASSERTION ABOUT THAT COMPONENT. `d/f/`, `d/f/.`
                                # and `d/f/x` all say "f is a directory", and
                                # `open(2)` agrees — GNU answers ENOTDIR for all
                                # three. ⭐ Asserted HERE, at the commit, rather
                                # than on the operand text afterwards, because
                                # the separator can arrive from a SYMLINK'S OWN
                                # TARGET: `slashlink -> d/f/` is ENOTDIR under
                                # GNU, and a check that reads argv cannot see it.
                                # ⭐ Free — `st` is the lstat the walk just did,
                                # and at the commit the entry is never a symlink.
                                if (mode != 2) {
                                    if (load8(remaining + seg_end) == 47) {
                                        if (fs_is_dir(&st) == 0) { return 0 - 20; }
                                    }
                                }
                                # Regular file/dir — commit.
                                ri = candidate_end;
                                rp = seg_end;
                            }
                        }
                    }
                }
            }
        }
    }

    # ⚠ THE TRAILING-SLASH ASSERTION USED TO LIVE HERE, reading the LAST BYTE OF
    # THE OPERAND. It caught `realpath flink/` and missed three things that are
    # the same statement in different spellings: `flink/.` (a `.` after the
    # component, no trailing slash on the operand), `flink/./.`, and a separator
    # arriving from a SYMLINK'S TARGET (`slashlink -> d/f/`, which argv never
    # sees). ⭐ Moved into the walk, where the separator is visible however it
    # got there and the stat is already in hand.
    #
    # ⚠ Two exemptions survive there, both measured: ALLOW_MISSING never
    # asserts (`-m flink/` answers the file), and a component tolerated as
    # missing is never committed, so `-E base/nope/` still answers the path
    # while `-e base/nope/` is already ENOENT from the walk.

    if (ri + 1 > out_bufsize) { return 0 - 36; }
    memcpy(out_buf, result, ri);
    store8(out_buf + ri, 0);
    return ri;
}

# Absolute, textually-normalized form of `operand`, as a heap cstring.
#
# ⚠ Lives here, not in `path.cyr`, precisely because it touches the filesystem:
# a relative operand is joined against `getcwd()`. `path.cyr`'s header commits to
# "pure string operations: nothing here touches the filesystem", and that
# boundary is worth more than the convenience of filing this next to
# `path_normalize`.
#
# Beyond the cwd lookup it is text-only: `..` resolves TEXTUALLY and symlinks are
# NOT dereferenced. Both callers depend on that for different reasons:
#
#   - `protected_canonicalize` (ADR 0004) — `rm` never follows symlinks
#     (ADR 0003 hard rule #1), so the root guard must judge the operand by the
#     name the user typed, not by wherever a link happens to point.
#   - `_cp_recursive_one` — the copy-a-directory-into-itself check needs both
#     operands expressed in one comparable frame before `path_is_under` can rule
#     on them; `cp -r /tmp/x/a a/sub` from /tmp/x is the same mistake as
#     `cp -r a a/sub` and only shares a prefix once both sides are absolute.
#
# On a `getcwd` failure it falls back to normalizing the operand as given: still
# exactly right for an already-absolute path, and merely non-matching for a
# relative one — the safe direction for the root guard, whose fallback comment
# has said so since v0.3.0.
fn fs_path_absolute(operand): i64 {
    if (operand == 0) {
        var z = alloc(2);
        store8(z, 47);                     # "/"
        store8(z + 1, 0);
        return path_normalize(z);
    }
    if (path_is_absolute(operand) == 1) {
        return path_normalize(operand);
    }
    var cwd_buf[4096];
    var n = k_getcwd(&cwd_buf, 4096);
    if (n < 0) {
        return path_normalize(operand);
    }
    var joined = path_join(&cwd_buf, operand);
    return path_normalize(joined);
}

# Resolve `cmd` to a path to hand `execve`, searching `path_env` (a PATH-shaped
# `a:b:c` cstring, or 0 when the variable is unset).
#
# Returns the resolved cstring, or **0 when nothing was found** — callers must
# treat 0 as "command not found" and report it (POSIX exit 127) rather than
# passing anything to exec.
#
# ⛔ RETURNING THE BARE NAME ON FAILURE IS A SANDBOX ESCAPE, NOT A CONVENIENCE.
# `execve("ls", …)` with no slash is resolved by the KERNEL relative to the
# current directory — there is no PATH search at the syscall layer. So both
# "PATH is unset" and "searched PATH and found nothing" used to end in
# `execve("ls")`, which runs `./ls` if one happens to be sitting there.
# Demonstrated: a directory containing an attacker-supplied `./ls`, then
# `printf 'ITEM\n' | env -u PATH xargs ls` printed `PWNED-FROM-CWD ITEM`, while
# GNU xargs ran /usr/bin/ls. Reachable the same way through `find -exec`.
#
# ⭐ An UNSET PATH falls back to `/bin:/usr/bin` — the value glibc's `execvp`
# uses from `confstr(_CS_PATH)`, so kriya lands where GNU lands.
#
# ⚠ An EMPTY PATH is different from an unset one and is left alone: POSIX
# defines a zero-length prefix as the current working directory, so `PATH=`
# legitimately means "." and is resolved as such — but explicitly, through the
# same access/stat check as any other entry, instead of by falling out of the
# bottom of the function.
#
# A `cmd` that already contains a slash is returned unchanged: POSIX says such a
# name is used as given, with no PATH search.
fn fs_resolve_in_path(cmd, path_env): i64 {
    if (cmd == 0) { return 0; }
    var i: i64 = 0;
    var has_slash: i64 = 0;
    while (load8(cmd + i) != 0) {
        if (load8(cmd + i) == 47) { has_slash = 1; }
        i = i + 1;
    }
    if (has_slash == 1) { return cmd; }

    var pe = path_env;
    if (pe == 0) { pe = "/bin:/usr/bin"; }

    var pp: i64 = 0;
    var done: i64 = 0;
    var found: i64 = 0;
    while (done == 0) {
        var seg_end = pp;
        var scanning: i64 = 1;
        while (scanning == 1) {
            var c = load8(pe + seg_end);
            if (c == 0) { scanning = 0; }
            elif (c == 58) { scanning = 0; }              # ':'
            else { seg_end = seg_end + 1; }
        }
        var slen = seg_end - pp;
        var entry: i64 = 0;
        if (slen == 0) {
            entry = alloc(2);
            store8(entry, 46);                            # '.' — POSIX zero-length prefix
            store8(entry + 1, 0);
        } else {
            entry = alloc(slen + 1);
            memcpy(entry, pe + pp, slen);
            store8(entry + slen, 0);
        }
        var candidate = path_join(entry, cmd);
        # k_access: X_OK on Linux, existence check on agnos (no permission model).
        if (k_access(candidate, 1) == 0) {
            var st[144];
            if (k_stat(candidate, &st) == 0) {
                if (fs_is_reg(&st) == 1) {
                    found = candidate;
                    done = 1;
                }
            }
        }
        if (done == 0) {
            if (load8(pe + seg_end) == 0) { done = 1; }
            else { pp = seg_end + 1; }
        }
    }
    return found;
}

# --- (dev, ino) set -------------------------------------------------
#
# An open-addressed hash set keyed on the pair that identifies a file
# uniquely on a running system — `st_dev` and `st_ino` — carrying one
# i64 payload per entry. Two callers, one implementation:
#
#   `cp --preserve=links`  payload = the FIRST destination path written
#                          for that inode, so a second source name that
#                          reaches the same inode is hard-linked to it
#                          rather than copied again.
#   `du`                   payload unused; membership alone answers
#                          "already counted", which IS the dedup.
#
# ⚠ Only files with `st_nlink > 1` belong in here. Inserting every file a
# walk touches would grow the table to the size of the tree for nothing —
# a link count of 1 cannot be reached twice — and that is the difference
# between a fixed cost and a per-file one on a large `du`.
#
# Linear probing, power-of-two capacity, doubling at half load. ⚠ Growth
# re-allocates and rehashes; the old table is NOT reclaimed (bump
# allocator, the same reasoning `_fs_regrow` above records). A tree with
# a million hard links leaves ~64 MB of dead tables behind across the
# doublings — accepted, because the alternative is a free-list for a
# table that lives exactly as long as the process does.

enum FsInoSet {
    FS_INOSET_CAP     = 0;     # header: slot count, always a power of two
    FS_INOSET_USED    = 8;     # header: occupied slots
    FS_INOSET_SLOTS   = 16;    # header: pointer to the slot array
    FS_INOSET_HDRSZ   = 24;
    FS_INOSET_S_STATE = 0;     # slot: 0 empty, 1 occupied
    FS_INOSET_S_DEV   = 8;
    FS_INOSET_S_INO   = 16;
    FS_INOSET_S_DATA  = 24;
    FS_INOSET_S_SZ    = 32;
    FS_INOSET_CAP0    = 64;    # 64 slots = 2 KiB, allocated once up front
}

# Mix (dev, ino) into a non-negative i64.
#
# ⛔ EVERY INTERMEDIATE HAS TO STAY POSITIVE. Cyrius `>>` is an ARITHMETIC
# shift, so a multiply that overflows into the sign bit poisons every mask
# below it and the index comes back negative — a load off the front of the
# array rather than a wrong-but-harmless bucket. The multipliers are sized
# so that the widest input (a 32-bit half of `ino`) cannot push the running
# sum past 2^56.
#
# Each multiplier is ODD, which makes the low bits a bijection of the input
# modulo any power of two — so the sequential inode numbers a directory walk
# actually produces spread across every bucket instead of clustering.
fn _fs_inoset_hash(dev, ino): i64 {
    var lo = ino & 4294967295;
    var hi = (ino >> 32) & 4294967295;
    var dv = dev & 16777215;
    var h  = lo * 1000003;
    h = h + hi * 65599;
    h = h + dv * 2654435761;
    return h;
}

fn fs_inoset_new(): i64 {
    var set = alloc(FS_INOSET_HDRSZ);
    if (set == 0) { return 0; }
    var bytes = FS_INOSET_CAP0 * FS_INOSET_S_SZ;
    var slots = alloc(bytes);
    if (slots == 0) { return 0; }
    memset(slots, 0, bytes);
    store64(set + FS_INOSET_CAP,   FS_INOSET_CAP0);
    store64(set + FS_INOSET_USED,  0);
    store64(set + FS_INOSET_SLOTS, slots);
    return set;
}

# The slot holding (dev, ino), or 0 when the key is absent.
fn fs_inoset_find(set, dev, ino): i64 {
    if (set == 0) { return 0; }
    var cap   = load64(set + FS_INOSET_CAP);
    var slots = load64(set + FS_INOSET_SLOTS);
    var mask  = cap - 1;
    var i     = _fs_inoset_hash(dev, ino) & mask;
    var found:  i64 = 0;
    var done:   i64 = 0;
    var probes: i64 = 0;
    while (done == 0) {
        if (probes >= cap) {
            done = 1;
        } else {
            var s = slots + i * FS_INOSET_S_SZ;
            if (load64(s + FS_INOSET_S_STATE) == 0) {
                done = 1;                          # an empty slot ends the chain
            } else {
                var hit: i64 = 0;
                if (load64(s + FS_INOSET_S_DEV) == dev) {
                    if (load64(s + FS_INOSET_S_INO) == ino) { hit = 1; }
                }
                if (hit == 1) {
                    found = s;
                    done  = 1;
                } else {
                    i      = (i + 1) & mask;
                    probes = probes + 1;
                }
            }
        }
    }
    return found;
}

# The payload of a slot returned by `fs_inoset_find`. 0 for a null slot,
# which is why a caller that stores 0 as a real payload must test the SLOT
# rather than the payload.
fn fs_inoset_data(slot): i64 {
    if (slot == 0) { return 0; }
    return load64(slot + FS_INOSET_S_DATA);
}

# Place a key known to be absent into a table known to have room. Returns 0,
# or -1 if every slot was occupied.
#
# ⚠ The probe counter is not decoration. Without it a full table spins
# forever, and a utility that hangs is worse than one that reports a failure
# — `fs_inoset_add` grows at half load so this cannot fire, and it stays here
# because "cannot fire" is an argument about today's caller.
fn _fs_inoset_place(set, dev, ino, data): i64 {
    var cap   = load64(set + FS_INOSET_CAP);
    var slots = load64(set + FS_INOSET_SLOTS);
    var mask  = cap - 1;
    var i     = _fs_inoset_hash(dev, ino) & mask;
    var done:   i64 = 0;
    var placed: i64 = 0;
    var probes: i64 = 0;
    while (done == 0) {
        if (probes >= cap) {
            done = 1;
        } else {
            var s = slots + i * FS_INOSET_S_SZ;
            if (load64(s + FS_INOSET_S_STATE) == 0) {
                store64(s + FS_INOSET_S_STATE, 1);
                store64(s + FS_INOSET_S_DEV,   dev);
                store64(s + FS_INOSET_S_INO,   ino);
                store64(s + FS_INOSET_S_DATA,  data);
                placed = 1;
                done   = 1;
            } else {
                i      = (i + 1) & mask;
                probes = probes + 1;
            }
        }
    }
    if (placed == 0) { return 0 - 1; }
    return 0;
}

fn _fs_inoset_grow(set): i64 {
    var old_cap   = load64(set + FS_INOSET_CAP);
    var old_slots = load64(set + FS_INOSET_SLOTS);
    var new_cap   = old_cap * 2;
    var bytes     = new_cap * FS_INOSET_S_SZ;
    var new_slots = alloc(bytes);
    if (new_slots == 0) { return 0 - 1; }
    memset(new_slots, 0, bytes);
    store64(set + FS_INOSET_CAP,   new_cap);
    store64(set + FS_INOSET_SLOTS, new_slots);
    var i: i64 = 0;
    while (i < old_cap) {
        var s = old_slots + i * FS_INOSET_S_SZ;
        if (load64(s + FS_INOSET_S_STATE) == 1) {
            _fs_inoset_place(set, load64(s + FS_INOSET_S_DEV),
                                  load64(s + FS_INOSET_S_INO),
                                  load64(s + FS_INOSET_S_DATA));
        }
        i = i + 1;
    }
    return 0;
}

# Insert (dev, ino) carrying `data`. Returns 1 when the key was NEW, 0 when
# it was already present, and -1 when the table could not grow.
#
# ⭐ THE FIRST PAYLOAD IS KEPT. A repeat insert changes nothing, which is
# what makes the master destination `cp` links to, and the name `du` charges
# the bytes to, the one the walk reached FIRST — matching GNU, where
# traversal order decides and nothing later overrides it.
fn fs_inoset_add(set, dev, ino, data): i64 {
    if (set == 0) { return 0 - 1; }
    if (fs_inoset_find(set, dev, ino) != 0) { return 0; }
    var cap  = load64(set + FS_INOSET_CAP);
    var used = load64(set + FS_INOSET_USED);
    # Grow at half load — linear probing degrades sharply past it, and at
    # 32 bytes a slot the memory is never the binding constraint here.
    if ((used + 1) * 2 > cap) {
        if (_fs_inoset_grow(set) != 0) { return 0 - 1; }
    }
    if (_fs_inoset_place(set, dev, ino, data) != 0) { return 0 - 1; }
    store64(set + FS_INOSET_USED, load64(set + FS_INOSET_USED) + 1);
    return 1;
}

fn fs_inoset_count(set): i64 {
    if (set == 0) { return 0; }
    return load64(set + FS_INOSET_USED);
}

# `st_nlink` and `st_dev`/`st_ino` off a 144-byte stat buffer. Named
# accessors because three call sites in two utilities were about to reach
# for the raw offsets, which is how one of them ends up reading `st_mode`.
fn fs_nlink(stat_buf): i64 { return load64(stat_buf + FS_STAT_NLINK); }
fn fs_dev(stat_buf):   i64 { return load64(stat_buf + FS_STAT_DEV); }
fn fs_ino(stat_buf):   i64 { return load64(stat_buf + FS_STAT_INO); }

# --- walk-ancestor stack --------------------------------------------
#
# The (dev, ino) of every directory on the path from the operand root to the
# entry being processed. A following walk (`cp -RL`, `du -L`) asks it one
# question: *is this directory one I am already inside?* — which is the only
# sound definition of a symlink cycle.
#
# ⛔ IT IS NOT THE SAME STRUCTURE AS `fs_inoset_*` AND THE DIFFERENCE IS
# LOAD-BEARING. A set of every directory ever VISITED also stops a cycle, and it
# is wrong: two symlinks pointing at one directory are not a loop, and GNU's
# `du -lL` counts that directory through both of them. Only membership of the
# CURRENT PATH means "descending here would not terminate".
#
# Linear scan, because the depth of a directory tree is tens, not thousands, and
# a hash would cost more to maintain across push/pop than it saves.

enum FsDirStack {
    FS_DSTK_CAP    = 0;    # header: entry capacity
    FS_DSTK_N      = 8;    # header: entries in use
    FS_DSTK_BUF    = 16;   # header: pointer to the entry array
    FS_DSTK_HDRSZ  = 24;
    FS_DSTK_E_DEV  = 0;
    FS_DSTK_E_INO  = 8;
    FS_DSTK_E_SZ   = 16;
    FS_DSTK_CAP0   = 64;   # 64 deep before the first grow
}

fn fs_dirstack_new(): i64 {
    var st = alloc(FS_DSTK_HDRSZ);
    if (st == 0) { return 0; }
    var buf = alloc(FS_DSTK_CAP0 * FS_DSTK_E_SZ);
    if (buf == 0) { return 0; }
    store64(st + FS_DSTK_CAP, FS_DSTK_CAP0);
    store64(st + FS_DSTK_N,   0);
    store64(st + FS_DSTK_BUF, buf);
    return st;
}

# 1 when (dev, ino) is a directory this walk is currently inside.
fn fs_dirstack_has(st, dev, ino): i64 {
    if (st == 0) { return 0; }
    var n   = load64(st + FS_DSTK_N);
    var buf = load64(st + FS_DSTK_BUF);
    var i: i64 = 0;
    var found: i64 = 0;
    while (i < n) {
        var e = buf + i * FS_DSTK_E_SZ;
        if (load64(e + FS_DSTK_E_DEV) == dev) {
            if (load64(e + FS_DSTK_E_INO) == ino) { found = 1; }
        }
        i = i + 1;
    }
    return found;
}

# Push a directory as the walk descends. Returns 0, or -1 if it could not grow —
# ⚠ which a caller must treat as "do not descend", not as "no cycle": descending
# with an unrecorded ancestor is how the unbounded recursion gets back in.
fn fs_dirstack_push(st, dev, ino): i64 {
    if (st == 0) { return 0 - 1; }
    var cap = load64(st + FS_DSTK_CAP);
    var n   = load64(st + FS_DSTK_N);
    if (n >= cap) {
        var new_cap = cap * 2;
        var nb = alloc(new_cap * FS_DSTK_E_SZ);
        if (nb == 0) { return 0 - 1; }
        memcpy(nb, load64(st + FS_DSTK_BUF), n * FS_DSTK_E_SZ);
        store64(st + FS_DSTK_CAP, new_cap);
        store64(st + FS_DSTK_BUF, nb);
    }
    var buf = load64(st + FS_DSTK_BUF);
    var e = buf + n * FS_DSTK_E_SZ;
    store64(e + FS_DSTK_E_DEV, dev);
    store64(e + FS_DSTK_E_INO, ino);
    store64(st + FS_DSTK_N, n + 1);
    return 0;
}

# ⚠ Every push needs its pop on EVERY return path out of the descent, including
# the error ones. An unpopped ancestor makes a later sibling look like a cycle
# and silently truncates the walk.
fn fs_dirstack_pop(st): i64 {
    if (st == 0) { return 0; }
    var n = load64(st + FS_DSTK_N);
    if (n > 0) { store64(st + FS_DSTK_N, n - 1); }
    return 0;
}

fn fs_dirstack_depth(st): i64 {
    if (st == 0) { return 0; }
    return load64(st + FS_DSTK_N);
}

# --- extended-attribute copy ----------------------------------------
#
# Copy every extended attribute from one OPEN DESCRIPTOR to another.
#
# ⛔ FD-ANCHORED, AND THAT IS A REQUIREMENT RATHER THAN A PREFERENCE. The M8
# security audit (`docs/audit/2026-05-18-security.md`, row 35354, mirroring
# uutils CVE-2026-35354) names the pattern to follow: a path-based restore
# re-resolves every component on every call, so a destination substituted
# between the write and the restore receives the attributes instead. `cp` holds
# both descriptors at the moment it needs them, so there is no reason to reach
# for a path — and the callers were restructured to keep them open rather than
# the other way round.
#
# ⚠ THE KERNEL'S SIZE PROTOCOL IS EASY TO GET WRONG and both halves are used
# here: a `size` of 0 returns the byte count the answer NEEDS without writing
# anything, and a buffer that is too small answers -ERANGE (-34) rather than
# truncating. Verified against the running kernel along with -ENODATA (-61) for
# a name that is not present.
#
# ⚠ `flistxattr` returns NUL-TERMINATED names laid END TO END — not an array,
# and not one string. The length is the total byte count and the caller walks it.
#
# ⚠ VALUES ARE BYTES. An attribute may hold an EMPTY value — which must still be
# SET, with size 0 — or embedded NUL bytes. Both round-trip through GNU
# (measured), so nothing here may reach for `strlen` on a value.

enum FsXattr {
    FS_XR_COPIED = 0;     # attributes successfully set on the destination
    FS_XR_FAILED = 8;     # attributes that could not be set
    FS_XR_ERRNO  = 16;    # errno of the FIRST failure
    # ⚠ A POINTER INTO THE SHARED LIST BUFFER, not a copy. It stays valid until
    # the NEXT `fs_xattr_copy` call regrows or overwrites that buffer — which is
    # long enough for the caller to print a diagnostic and no longer. Anything
    # that needs to outlive one call must copy the bytes.
    FS_XR_NAME   = 24;    # pointer to the NAME of the first failure
    FS_XR_SZ     = 32;
    FS_XR_ENOTSUP = 95;   # EOPNOTSUPP — the filesystem has no xattr support
    FS_XR_ENODATA = 61;   # the attribute is not there (or vanished mid-walk)
}

# Scratch buffers, grown on demand and reused across every file in a walk.
# ⚠ Pointers from `alloc`, never module-scope `var X[N]` — at module scope that
# form is N×8 bytes rather than N, which is roadmap M15a and the most expensive
# rule in this codebase.
var _fs_xa_list = 0;
var _fs_xa_list_cap = 0;
var _fs_xa_val = 0;
var _fs_xa_val_cap = 0;

fn _fs_xa_list_buf(need): i64 {
    if (_fs_xa_list_cap >= need) { return _fs_xa_list; }
    var cap = _fs_grow_cap(1024, need);
    var b = alloc(cap);
    if (b == 0) { return 0; }
    _fs_xa_list = b;
    _fs_xa_list_cap = cap;
    return b;
}

fn _fs_xa_val_buf(need): i64 {
    if (_fs_xa_val_cap >= need) { return _fs_xa_val; }
    var cap = _fs_grow_cap(1024, need);
    var b = alloc(cap);
    if (b == 0) { return 0; }
    _fs_xa_val = b;
    _fs_xa_val_cap = cap;
    return b;
}

# Offset of the name AFTER the one starting at `pos`, or -1 when the buffer is
# malformed (no terminator before the end). A return equal to `len` means the
# name at `pos` was the last one. ⭐ Pure, so the walk is unit-testable against a
# synthetic buffer without touching a filesystem.
fn fs_xattr_list_next(list, len, pos): i64 {
    var i = pos;
    while (i < len) {
        if (load8(list + i) == 0) { return i + 1; }
        i = i + 1;
    }
    return 0 - 1;
}

# 1 when `name` is in the `system.` namespace, which a plain xattr copy must not
# touch — see the call site for the measurement.
fn _fs_xa_is_system(name): i64 {
    var lit = "system.";
    var i: i64 = 0;
    while (i < 7) {
        if (load8(name + i) != load8(lit + i)) { return 0; }
        i = i + 1;
    }
    return 1;
}

# Copy src_fd's attributes onto dst_fd, filling the `FsXattr` record at `out`.
# Returns 0 when every attribute was copied (including when there were none),
# the FAILED count when some could not be set, and -1 when the source could not
# be listed at all.
fn fs_xattr_copy(src_fd, dst_fd, out): i64 {
    store64(out + FS_XR_COPIED, 0);
    store64(out + FS_XR_FAILED, 0);
    store64(out + FS_XR_ERRNO,  0);
    store64(out + FS_XR_NAME,   0);
    if (K_HAVE_XATTR == 0) { return 0; }

    var need = k_flistxattr(src_fd, 0, 0);
    if (need < 0) {
        var e0 = 0 - need;
        # ⚠ A source on a filesystem WITHOUT xattr support answers -ENOTSUP, and
        # that is "there is nothing to copy" rather than a failure — GNU is
        # silent there too, and a `cp --preserve=xattr` onto a plain ext4 tree
        # would otherwise report an error on every single file.
        if (e0 == FS_XR_ENOTSUP) { return 0; }
        if (e0 == FS_XR_ENODATA) { return 0; }
        store64(out + FS_XR_ERRNO, e0);
        return 0 - 1;
    }
    if (need == 0) { return 0; }

    # ⚠ `need + 2`, not `need + 1`. The kernel may return exactly the count it was
    # given when the list GREW between the probe and the read, and the sentinel
    # below then writes at index `got` — one past a buffer sized `need + 1` whose
    # capacity happened to land exactly there. Two bytes of slack costs nothing
    # and removes the case.
    var list = _fs_xa_list_buf(need + 2);
    if (list == 0) { store64(out + FS_XR_ERRNO, 12); return 0 - 1; }
    var got = k_flistxattr(src_fd, list, need + 1);
    if (got < 0) {
        var e1 = 0 - got;
        # A list that grew past the probe answers -ERANGE; a source that lost its
        # xattr support answers -ENOTSUP. Neither is worth failing a copy over.
        if (e1 == FS_XR_ENOTSUP) { return 0; }
        if (e1 == FS_XR_ENODATA) { return 0; }
        store64(out + FS_XR_ERRNO, e1);
        return 0 - 1;
    }
    store8(list + got, 0);

    var pos: i64 = 0;
    var done: i64 = 0;
    while (done == 0) {
        if (pos >= got) {
            done = 1;
        } else {
            var name = list + pos;
            var nxt = fs_xattr_list_next(list, got, pos);
            if (nxt < 0) {
                done = 1;                      # malformed: stop rather than run off
            } else {
                # ⛔ `system.*` IS EXCLUDED, and that is a security rule rather
                # than a tidiness one. `system.posix_acl_access` IS an extended
                # attribute, so a walk that copies everything copies the ACL —
                # and setting it CHANGES THE DESTINATION'S EFFECTIVE PERMISSIONS.
                # Measured: a 0600 file with `g:docker:rwx` copied with
                # `--preserve=xattr` came out 0670 with the ACL intact under
                # kriya and 0650 with no ACL under GNU, which excludes the
                # namespace through libattr's `/etc/xattr.conf`. ⚠ `security.*`
                # is NOT excluded — GNU carries `security.capability`, measured.
                var skip_ns: i64 = 0;
                if (_fs_xa_is_system(name) == 1) { skip_ns = 1; }
                var vneed: i64 = 0;
                if (skip_ns == 1) { vneed = 0 - 61; }
                else { vneed = k_fgetxattr(src_fd, name, 0, 0); }
                if (vneed < 0) {
                    # ⚠ An attribute that VANISHED between the list and the get is
                    # not a failure to report — the source is a live filesystem.
                    if ((0 - vneed) != FS_XR_ENODATA) {
                        store64(out + FS_XR_FAILED, load64(out + FS_XR_FAILED) + 1);
                        if (load64(out + FS_XR_ERRNO) == 0) {
                            store64(out + FS_XR_ERRNO, 0 - vneed);
                            store64(out + FS_XR_NAME, name);
                        }
                    }
                } else {
                    # ⚠ `vneed + 1`, so an EMPTY value still has a valid pointer to
                    # hand the kernel; the SIZE passed stays 0, which is what makes
                    # the empty attribute round-trip.
                    var val = _fs_xa_val_buf(vneed + 1);
                    if (val == 0) {
                        store64(out + FS_XR_FAILED, load64(out + FS_XR_FAILED) + 1);
                        if (load64(out + FS_XR_ERRNO) == 0) {
                            store64(out + FS_XR_ERRNO, 12);
                            store64(out + FS_XR_NAME, name);
                        }
                    } else {
                        # ⚠ THE CAPACITY, NOT THE PROBED SIZE. The buffer is at
                        # least `vneed + 1` and usually far larger (it only ever
                        # grows), so handing the kernel the probe's answer turns
                        # any growth in the window into an unconditional -ERANGE
                        # where the room to hold it was already there.
                        var vgot: i64 = 0;
                        if (vneed > 0) { vgot = k_fgetxattr(src_fd, name, val, _fs_xa_val_cap); }
                        if (vgot < 0) {
                            # ⚠ The SAME vanished-attribute race the probe above
                            # exempts, one syscall later. It was a failure here and
                            # an exemption there, which made a concurrent
                            # `removexattr` on the source fail the copy.
                            if ((0 - vgot) != FS_XR_ENODATA) {
                                store64(out + FS_XR_FAILED, load64(out + FS_XR_FAILED) + 1);
                                if (load64(out + FS_XR_ERRNO) == 0) {
                                    store64(out + FS_XR_ERRNO, 0 - vgot);
                                    store64(out + FS_XR_NAME, name);
                                }
                            }
                        } else {
                            var sr = k_fsetxattr(dst_fd, name, val, vgot, 0);
                            if (sr != 0) {
                                store64(out + FS_XR_FAILED, load64(out + FS_XR_FAILED) + 1);
                                if (load64(out + FS_XR_ERRNO) == 0) {
                                    store64(out + FS_XR_ERRNO, 0 - sr);
                                    store64(out + FS_XR_NAME, name);
                                }
                            } else {
                                store64(out + FS_XR_COPIED, load64(out + FS_XR_COPIED) + 1);
                            }
                        }
                    }
                }
                pos = nxt;
            }
        }
    }
    return load64(out + FS_XR_FAILED);
}

# 1 when `path` is an empty directory, 0 when it holds anything, and a negative
# errno when it could not be read.
#
# ⚠ `.` and `..` are entries too — the dotdot filter is the whole subtlety, and
# `fs_dent_is_dotdot` above already answers it for both.
fn fs_dir_is_empty(path): i64 {
    var fd = fs_openat(fs_at_fdcwd(), path, 65536, 0);      # O_RDONLY|O_DIRECTORY
    if (fd < 0) { return fd; }
    var buf = alloc(4096);
    var empty: i64 = 1;
    var loop:  i64 = 1;
    while (loop == 1) {
        var nb = fs_getdents64(fd, buf, 4096);
        if (nb < 0) {
            if ((0 - nb) != 4) { loop = 0; }                # not EINTR: stop
        } else {
            if (nb == 0) { loop = 0; }
            else {
                var off: i64 = 0;
                while (off < nb) {
                    var ent = buf + off;
                    if (fs_dent_is_dotdot(ent) == 0) { empty = 0; }
                    off = off + fs_dent_reclen(ent);
                }
                if (empty == 0) { loop = 0; }
            }
        }
    }
    fs_close(fd);
    return empty;
}
