# fs.cyr — kriya filesystem traversal primitives.
#
# Foundation for the TOCTOU-safe recursive walks in `cp -R`,
# cross-FS `mv`, and `rm -r` per ADR 0003. Every traversal step is
# `openat(parent_fd, name, O_NOFOLLOW | O_DIRECTORY)` from an explicit
# dirfd — no chdir, no path-relative open. A directory entry replaced
# by a symlink between the lstat that classified it and the open that
# descends fails with `ELOOP`, never silently follows.
#
# Stdlib wrappers for the `*at()` family and the AT_* / UTIME_*
# constants are pending Cyrius proposal
# `2026-05-17-syscalls-at-family-stdlib`. Until they land, these
# wrappers carry the Linux x86_64 syscall numbers inline as decimal
# literals. When the proposal accepts, the file sweeps to use
# `sys_openat` / `sys_unlinkat` / etc. — by name, no number magic.
#
# This file is filesystem-aware; pure path operations stay in
# `src/lib/path.cyr` (no overlap).
#
# Bytes referenced as decimal-with-comment per the running practice
# (no octal literal yet in Cyrius — see proposal
# `2026-05-17-octal-literal-syntax`).

# --- AT_* and related flag constants -------------------------------

enum FsAt {
    FS_AT_SYMLINK_NOFOLLOW = 256;     # 0x100
    FS_AT_REMOVEDIR        = 512;     # 0x200
    FS_AT_SYMLINK_FOLLOW   = 1024;    # 0x400
}

# AT_FDCWD = -100. Cyrius enum values don't accept the `0 - 100`
# expression form (CLAUDE.md: "no negative literals"), so it lives
# as a zero-cost function — every call site reads it by name.
fn fs_at_fdcwd(): i64 {
    return 0 - 100;
}

# Open flags pertinent to traversal. Subset of <fcntl.h>.
enum FsOpen {
    FS_O_RDONLY    = 0;
    FS_O_WRONLY    = 1;
    FS_O_TRUNC     = 512;        # 0o1000
    FS_O_DIRECTORY = 65536;      # 0o200000  (0x10000)
    FS_O_NOFOLLOW  = 131072;     # 0o400000  (0x20000)
    FS_O_CLOEXEC   = 524288;     # 0o2000000 (0x80000)
}

# linux_dirent64.d_type values. The kernel returns these in the
# `getdents64` stream and they short-circuit a per-entry lstat for
# the common cases (regular file vs directory vs symlink). DT_UNKNOWN
# means "fall back to lstat".
enum FsDType {
    FS_DT_UNKNOWN = 0;
    FS_DT_FIFO    = 1;
    FS_DT_CHR     = 2;
    FS_DT_DIR     = 4;
    FS_DT_BLK     = 6;
    FS_DT_REG     = 8;
    FS_DT_LNK     = 10;
    FS_DT_SOCK    = 12;
}

# struct stat field offsets (Linux x86_64). Mirrors the stdlib `Stat`
# enum in `syscalls_x86_64_linux.cyr` — duplicated here so fs.cyr's
# callers don't need to include the lower-level enum.
enum FsStat {
    FS_STAT_DEV        = 0;
    FS_STAT_INO        = 8;
    FS_STAT_NLINK      = 16;
    FS_STAT_MODE       = 24;
    FS_STAT_UID        = 28;
    FS_STAT_GID        = 32;
    FS_STAT_RDEV       = 40;
    FS_STAT_SIZE       = 48;
    FS_STAT_BLKSIZE    = 56;
    FS_STAT_BLOCKS     = 64;
    FS_STAT_ATIME      = 72;
    FS_STAT_ATIME_NSEC = 80;
    FS_STAT_MTIME      = 88;
    FS_STAT_MTIME_NSEC = 96;
    FS_STAT_CTIME      = 104;
    FS_STAT_CTIME_NSEC = 112;
    FS_STAT_BUFSZ      = 144;
}

# S_IFMT mask + type values (subset).
enum FsMode {
    FS_S_IFMT   = 61440;   # 0o170000
    FS_S_IFREG  = 32768;   # 0o100000
    FS_S_IFDIR  = 16384;   # 0o040000
    FS_S_IFLNK  = 40960;   # 0o120000
    FS_S_IFCHR  = 8192;    # 0o020000
    FS_S_IFBLK  = 24576;   # 0o060000
    FS_S_IFIFO  = 4096;    # 0o010000
    FS_S_IFSOCK = 49152;   # 0o140000
}

# --- type predicates on a 144-byte stat buffer ---------------------

fn fs_is_reg(stat_buf): i64 {
    var m = load64(stat_buf + 24);
    if ((m & 61440) == 32768) { return 1; }
    return 0;
}

fn fs_is_dir(stat_buf): i64 {
    var m = load64(stat_buf + 24);
    if ((m & 61440) == 16384) { return 1; }
    return 0;
}

fn fs_is_lnk(stat_buf): i64 {
    var m = load64(stat_buf + 24);
    if ((m & 61440) == 40960) { return 1; }
    return 0;
}

# Extract the low-12 mode bits (permission + setuid/gid/sticky).
fn fs_perms(stat_buf): i64 {
    return load64(stat_buf + 24) & 4095;
}

# --- syscall wrappers ----------------------------------------------
#
# All return Linux convention (`<0` is `-errno`).
#
# Numbers below are x86_64. When the stdlib at-family lands these
# become per-arch-routed; until then, x86_64-only (the kriya build
# target today).

# NOTE on the agnos branches below: agnos has NO dirfd-relative *at()
# calls and NO per-process cwd — only PATH-BASED syscalls (wrapped as
# k_open/k_stat/k_unlink/… in sys.cyr). So each *at wrapper routes to
# the path-based k_* when `dirfd == AT_FDCWD` (-100) — the top-level
# entry point, where the recursive walk seeds from an ABSOLUTE path —
# and returns -ENOSYS (-38) for any real dirfd (mid-recursion,
# relative-to-fd), which agnos cannot satisfy. Net effect: single-level
# / absolute-path ops work; dirfd-relative recursion fails cleanly at
# depth instead of misbehaving. The Linux branch (#ifndef) keeps the
# exact raw-syscall body unchanged.

fn fs_openat(dirfd, path, flags, mode): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    if (dirfd == k_at_fdcwd()) { return k_open(path, flags, mode); }
    return 0 - 38;                               # no open-relative-to-fd on agnos (ENOSYS)
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    return syscall(257, dirfd, path, flags, mode);
    #endif
}

# fstatat with explicit `flags`. Use AT_SYMLINK_NOFOLLOW (256) for
# lstat-equivalent, 0 for stat-equivalent.
fn fs_fstatat(dirfd, path, buf, flags): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    # agnos has no symlinks, so the NOFOLLOW flag is irrelevant → k_stat.
    if (dirfd == k_at_fdcwd()) { return k_stat(path, buf); }
    return 0 - 38;
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    return syscall(262, dirfd, path, buf, flags);
    #endif
}

fn fs_lstat_at(dirfd, path, buf): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    if (dirfd == k_at_fdcwd()) { return k_lstat(path, buf); }
    return 0 - 38;
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    return syscall(262, dirfd, path, buf, 256);  # AT_SYMLINK_NOFOLLOW
    #endif
}

# stat a directory ENTRY identified by (dirfd, name) during a readdir walk.
# `fullpath` is the entry's absolute path (dirpath joined with name) — the
# caller already has it. follow=1 -> stat (deref), 0 -> lstat. Linux uses the
# dirfd-relative *at (TOCTOU-safe per ADR 0003); agnos has no dirfd-relative
# call, so it stats `fullpath` directly (no symlinks there, so no TOCTOU gap).
# This is what lets ls -l / du show real metadata on agnos, where a real-dirfd
# fs_lstat_at would return -38.
fn fs_stat_entry(dirfd, fullpath, name, buf, follow): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    if (follow == 1) { return k_stat(fullpath, buf); }
    return k_lstat(fullpath, buf);
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    if (follow == 1) { return fs_fstatat(dirfd, name, buf, 0); }
    return fs_lstat_at(dirfd, name, buf);
    #endif
}

# Open a directory ENTRY for traversal during a readdir walk, the peer of
# `fs_stat_entry` above and with the same bargain: Linux descends from the
# `dirfd` with the bare `name` (TOCTOU-safe per ADR 0003), agnos opens
# `fullpath` because it has no dirfd-relative call at all.
#
# ⛔ WHY THE PAIR EXISTS RATHER THAN JUST `fs_opendir_nofollow`. Re-opening an
# accumulated PATH at each descent means every ancestor component is resolved
# again, so a directory swapped for a symlink mid-walk redirects the walk out of
# the tree. `O_NOFOLLOW` does not help — it guards only the FINAL component.
# `rm`, `cp` and `find` have always descended from a parent fd; `grep -r` was the
# one walk still re-resolving by path, and it could be steered into `/etc`.
#
# ⚠ `fs_opendir_nofollow(real_dirfd, …)` answers -ENOSYS on agnos, so a walk
# built on it alone fails at depth 1 there. That is what this wrapper exists to
# avoid: pass BOTH and each target uses the half it can.
fn fs_open_entry_dir(dirfd, fullpath, name): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    return k_open(fullpath, 65536, 0);            # O_DIRECTORY
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    return fs_opendir_nofollow(dirfd, name);
    #endif
}

# Same bargain for a regular file being read during a walk:
# O_RDONLY | O_NOFOLLOW, dirfd-relative on Linux and path-based on agnos.
fn fs_open_entry_file(dirfd, fullpath, name): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    return k_open(fullpath, 131072, 0);           # O_NOFOLLOW
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    return fs_openat(dirfd, name, 131072, 0);     # O_RDONLY | O_NOFOLLOW
    #endif
}

# Open a directory for traversal in the safe shape required by
# ADR 0003: O_RDONLY | O_DIRECTORY | O_NOFOLLOW. The mode argument
# is unused for read-only opens but the syscall signature wants it.
fn fs_opendir_nofollow(dirfd, name): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    # Pass O_DIRECTORY (k_open maps it to agnos AO_DIRECTORY) so the kernel
    # returns a getdents-capable dir fd; O_NOFOLLOW is moot (no symlinks).
    if (dirfd == k_at_fdcwd()) { return k_open(name, 65536, 0); }
    return 0 - 38;
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    # 0 | 65536 | 131072 = 196608.
    return syscall(257, dirfd, name, 196608, 0);
    #endif
}

fn fs_mkdirat(dirfd, path, mode): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    if (dirfd == k_at_fdcwd()) { return k_mkdir(path, mode); }
    return 0 - 38;
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    return syscall(258, dirfd, path, mode);
    #endif
}

# unlinkat with flags: 0 for files, AT_REMOVEDIR=512 for empty dirs.
fn fs_unlinkat(dirfd, path, flags): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    if (dirfd == k_at_fdcwd()) {
        if ((flags & 512) != 0) { return k_rmdir(path); }   # AT_REMOVEDIR
        return k_unlink(path);
    }
    return 0 - 38;
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    return syscall(263, dirfd, path, flags);
    #endif
}

fn fs_linkat(old_dirfd, old_path, new_dirfd, new_path, flags): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    # Path-based k_link needs BOTH dirfds at AT_FDCWD (no relative resolution).
    if (old_dirfd == k_at_fdcwd()) {
        if (new_dirfd == k_at_fdcwd()) { return k_link(old_path, new_path); }
    }
    return 0 - 38;
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    return syscall(265, old_dirfd, old_path, new_dirfd, new_path, flags);
    #endif
}

fn fs_symlinkat(target, dirfd, link): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    # k_symlink returns -38 on agnos (no symlinks) regardless of dirfd.
    if (dirfd == k_at_fdcwd()) { return k_symlink(target, link); }
    return 0 - 38;
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    return syscall(266, target, dirfd, link);
    #endif
}

fn fs_fchmodat(dirfd, path, mode, flags): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    # k_chmod returns -38 on agnos (no mode bits) regardless of dirfd.
    if (dirfd == k_at_fdcwd()) { return k_chmod(path, mode); }
    return 0 - 38;
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    return syscall(268, dirfd, path, mode, flags);
    #endif
}

fn fs_utimensat(dirfd, path, times, flags): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    # k_utimensat returns -38 on agnos (no utimensat) regardless of dirfd.
    if (dirfd == k_at_fdcwd()) { return k_utimensat(dirfd, path, times, flags); }
    return 0 - 38;
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    return syscall(280, dirfd, path, times, flags);
    #endif
}

fn fs_readlinkat(dirfd, path, buf, bufsize): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    # k_readlink returns -38 on agnos (no symlinks) regardless of dirfd.
    if (dirfd == k_at_fdcwd()) { return k_readlink(path, buf, bufsize); }
    return 0 - 38;
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    return syscall(267, dirfd, path, buf, bufsize);
    #endif
}

# rename(2): rename within a filesystem. Cross-FS returns -EXDEV (-18),
# letting the caller fall back to copy+unlink. SYS_RENAME = 82 on x86_64.
fn fs_rename(oldpath, newpath): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    return k_rename(oldpath, newpath);           # agnos path-based rename
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    return syscall(82, oldpath, newpath);
    #endif
}

# renameat(2): rename rooted at explicit dirfds. SYS_RENAMEAT = 264.
fn fs_renameat(old_dirfd, oldpath, new_dirfd, newpath): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    # Path-based k_rename needs BOTH dirfds at AT_FDCWD (no relative resolution).
    if (old_dirfd == k_at_fdcwd()) {
        if (new_dirfd == k_at_fdcwd()) { return k_rename(oldpath, newpath); }
    }
    return 0 - 38;
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    return syscall(264, old_dirfd, oldpath, new_dirfd, newpath);
    #endif
}

fn fs_close(fd): i64 {
    return k_close( fd);
}

# --- directory entry iteration -------------------------------------
#
# Linux `getdents64(fd, buf, count)` fills `buf` with a stream of
# `struct linux_dirent64`:
#   d_ino:    offset 0,  i64
#   d_off:    offset 8,  i64
#   d_reclen: offset 16, u16  (total record length incl padding)
#   d_type:   offset 18, u8
#   d_name:   offset 19, null-terminated cstring (padded)

# Route through k_getdents on BOTH targets: it picks the per-target
# syscall number (Linux #217 / agnos #29) AND translates agnos's packed
# dirent stream into the Linux linux_dirent64 layout the fs_dent_*
# accessors below read — so callers see one record format everywhere.
fn fs_getdents64(fd, buf, bufsize): i64 {
    return k_getdents(fd, buf, bufsize);
}

# Read d_reclen as a u16. Cyrius has no u16 load, so we assemble it
# from two u8 loads. d_reclen sits at offset 16 within the record.
fn fs_dent_reclen(ent): i64 {
    var lo = load8(ent + 16);
    var hi = load8(ent + 17);
    return (hi << 8) | lo;
}

fn fs_dent_type(ent): i64 {
    return load8(ent + 18);
}

# Pointer to the null-terminated name. Caller treats it as a cstring.
fn fs_dent_name(ent): i64 {
    return ent + 19;
}

# Is this dent named "." or ".."? The kernel always emits these as
# the first two entries of a directory read.
fn fs_dent_is_dotdot(ent): i64 {
    var n = ent + 19;
    if (load8(n) != 46) { return 0; }
    if (load8(n + 1) == 0) { return 1; }  # "."
    if (load8(n + 1) == 46) {
        if (load8(n + 2) == 0) { return 1; }  # ".."
    }
    return 0;
}

# --- canonical path resolution -------------------------------------
#
# `fs_realpath` walks a path component-by-component, normalising `.`
# and `..`, resolving every symlink it encounters, and producing an
# absolute canonical form. The three missing-component policies
# correspond to GNU `realpath`'s `-e`/`-m` and `readlink`'s `-f`:
#
#   FS_REALPATH_REQUIRE_ALL    every component must exist (default for
#                              `realpath` and `readlink -e`).
#   FS_REALPATH_REQUIRE_PARENT every component except the last must
#                              exist (the `readlink -f` mode — the
#                              last component is treated as "would-be
#                              created here" so the canonical path is
#                              defined even if the target doesn't yet).
#   FS_REALPATH_ALLOW_MISSING  no component need exist; once we hit
#                              an ENOENT, we stop lstat'ing and append
#                              the rest as text (`realpath -m`).
#
# Returns the result LENGTH (excluding the null terminator) on success.
# Returns a negative -errno on failure:
#   -ENOENT (-2)         a required component is missing per `mode`.
#   -ENAMETOOLONG (-36)  result wouldn't fit in `out_bufsize`.
#   -ELOOP (-40)         more than 40 symlink resolutions (cycle or
#                        pathologically deep chain).
#   other negative errno propagated from lstat/readlink/getcwd.

enum FsRealpathMode {
    FS_REALPATH_REQUIRE_ALL    = 0;
    FS_REALPATH_REQUIRE_PARENT = 1;
    FS_REALPATH_ALLOW_MISSING  = 2;
}

# Internal helper: strip the last component of `result` (in-place
# truncation by writing a null and updating the length). Mirrors
# `dirname` but operates on the caller's buffer to avoid an alloc.
# `ri` is the current length; returns the new length.
fn _fs_strip_last_component(result, ri): i64 {
    if (ri <= 1) { return 1; }  # don't strip the root
    var p = ri - 1;
    var scanning: i64 = 1;
    while (scanning == 1) {
        if (p == 0) {
            scanning = 0;
        } else {
            if (load8(result + p) == 47) {
                scanning = 0;
            } else {
                p = p - 1;
            }
        }
    }
    if (p == 0) {
        store8(result + 1, 0);
        return 1;
    }
    store8(result + p, 0);
    return p;
}

fn fs_realpath(input, mode, out_buf, out_bufsize): i64 {
    if (input == 0)        { return 0 - 2; }
    if (load8(input) == 0) { return 0 - 2; }

    var BUFSZ: i64 = 16384;
    var result    = alloc(BUFSZ);
    var remaining = alloc(BUFSZ);
    var ri: i64 = 0;

    # Seed result + remaining.
    #
    # ⛔ THE SEED COPIES ARE BOUNDS-CHECKED, AND THEY DID NOT USED TO BE. The
    # append path at the bottom of the segment loop has always answered
    # ENAMETOOLONG when `result` would overflow, which made the whole function
    # look guarded — but `input` came straight from argv and went into a fixed
    # 16 KiB `remaining` with no check at all. Measured: a 16,427-byte operand
    # made `kriya realpath -m` print `…/rp/d/.d` where GNU printed `…/rp/d/f`,
    # AND EXIT 0. Not a crash — a wrong canonical path reported as success, which
    # is worse, because `realpath`/`readlink -f` output is normally fed straight
    # into the next command.
    if (path_is_absolute(input) == 1) {
        store8(result, 47);
        store8(result + 1, 0);
        ri = 1;
        var ilen = strlen(input);
        if (ilen + 1 > BUFSZ) { return 0 - 36; }   # ENAMETOOLONG
        memcpy(remaining, input + 1, ilen);  # also copies the null
    } else {
        var n = k_getcwd(result, BUFSZ);
        if (n < 0) { return n; }
        ri = n - 1;  # SYS_GETCWD returns length INCLUDING null
        if (ri < 1) { ri = 1; }
        var ilen = strlen(input);
        if (ilen + 2 > BUFSZ) { return 0 - 36; }   # ENAMETOOLONG
        memcpy(remaining, input, ilen + 1);
    }

    var loop_count: i64 = 0;
    var stopped: i64 = 0;  # set when ALLOW_MISSING / REQUIRE_PARENT-last hits ENOENT
    var rp: i64 = 0;

    while (load8(remaining + rp) != 0) {
        # Skip leading slashes (collapses "//").
        while (load8(remaining + rp) == 47) { rp = rp + 1; }
        if (load8(remaining + rp) == 0) { rp = rp; }
        else {
            # Find end of segment.
            var seg_end = rp;
            var sc: i64 = 1;
            while (sc == 1) {
                var c = load8(remaining + seg_end);
                if (c == 0) { sc = 0; }
                else {
                    if (c == 47) { sc = 0; }
                    else { seg_end = seg_end + 1; }
                }
            }
            var seg_len = seg_end - rp;

            # Classify.
            var is_dot: i64 = 0;
            var is_dotdot: i64 = 0;
            if (seg_len == 1) {
                if (load8(remaining + rp) == 46) { is_dot = 1; }
            }
            if (seg_len == 2) {
                if (load8(remaining + rp) == 46) {
                    if (load8(remaining + rp + 1) == 46) { is_dotdot = 1; }
                }
            }

            if (is_dot == 1) {
                rp = seg_end;
            } else {
                if (is_dotdot == 1) {
                    ri = _fs_strip_last_component(result, ri);
                    rp = seg_end;
                } else {
                    # Build candidate by appending seg to result.
                    var sep: i64 = 1;
                    if (ri == 1) {
                        if (load8(result) == 47) { sep = 0; }
                    }
                    if (ri + sep + seg_len + 1 > BUFSZ) { return 0 - 36; }
                    if (sep == 1) {
                        store8(result + ri, 47);
                        ri = ri + 1;
                    }
                    memcpy(result + ri, remaining + rp, seg_len);
                    var candidate_end = ri + seg_len;
                    store8(result + candidate_end, 0);

                    if (stopped == 1) {
                        ri = candidate_end;
                        rp = seg_end;
                    } else {
                        var st[144];
                        var sr = fs_lstat_at(0 - 100, result, &st);
                        if (sr != 0) {
                            var errno = 0 - sr;
                            if (errno != 2) { return sr; }
                            # ENOENT — is this the last segment of remaining?
                            var is_last: i64 = 1;
                            var pp = seg_end;
                            while (load8(remaining + pp) == 47) { pp = pp + 1; }
                            if (load8(remaining + pp) != 0) { is_last = 0; }

                            if (mode == 0) { return 0 - 2; }  # REQUIRE_ALL
                            if (mode == 1) {
                                if (is_last == 0) { return 0 - 2; }  # REQUIRE_PARENT, not last
                            }
                            # ALLOW_MISSING or REQUIRE_PARENT-last: commit, stop.
                            ri = candidate_end;
                            stopped = 1;
                            rp = seg_end;
                        } else {
                            if (fs_is_lnk(&st) == 1) {
                                loop_count = loop_count + 1;
                                if (loop_count > 40) { return 0 - 40; }

                                var link_buf = alloc(BUFSZ);
                                var ln = fs_readlinkat(0 - 100, result, link_buf, BUFSZ - 1);
                                if (ln < 0) { return ln; }
                                store8(link_buf + ln, 0);

                                # Strip the segment we just appended (the symlink).
                                ri = candidate_end - seg_len - sep;
                                if (ri < 1) { ri = 1; }
                                store8(result + ri, 0);

                                # If link is absolute, reset result to "/".
                                if (path_is_absolute(link_buf) == 1) {
                                    store8(result, 47);
                                    store8(result + 1, 0);
                                    ri = 1;
                                }

                                # Build new remaining = link_target + "/" + (old remaining past seg_end).
                                var new_remaining = alloc(BUFSZ);
                                var copy_off: i64 = 0;
                                var tl = ln;
                                if (path_is_absolute(link_buf) == 1) {
                                    memcpy(new_remaining, link_buf + 1, tl);
                                    tl = tl - 1;
                                } else {
                                    memcpy(new_remaining, link_buf, tl);
                                }
                                var rest_off = seg_end;
                                while (load8(remaining + rest_off) == 47) { rest_off = rest_off + 1; }
                                var rest_len = strlen(remaining + rest_off);
                                # ⚠ Same class as the seed above: `tl` is bounded by the
                                # readlink limit and `rest_len` by BUFSZ, so their SUM can be
                                # nearly twice BUFSZ. Each round of symlink expansion grows
                                # `remaining`, so a chain of links is the natural way to reach it.
                                if (tl + rest_len + 2 > BUFSZ) { return 0 - 36; }   # ENAMETOOLONG
                                if (rest_len > 0) {
                                    store8(new_remaining + tl, 47);
                                    memcpy(new_remaining + tl + 1, remaining + rest_off, rest_len + 1);
                                } else {
                                    store8(new_remaining + tl, 0);
                                }

                                remaining = new_remaining;
                                rp = 0;
                            } else {
                                # Regular file/dir — commit.
                                ri = candidate_end;
                                rp = seg_end;
                            }
                        }
                    }
                }
            }
        }
    }

    if (ri + 1 > out_bufsize) { return 0 - 36; }
    memcpy(out_buf, result, ri);
    store8(out_buf + ri, 0);
    return ri;
}

# Absolute, textually-normalized form of `operand`, as a heap cstring.
#
# ⚠ Lives here, not in `path.cyr`, precisely because it touches the filesystem:
# a relative operand is joined against `getcwd()`. `path.cyr`'s header commits to
# "pure string operations: nothing here touches the filesystem", and that
# boundary is worth more than the convenience of filing this next to
# `path_normalize`.
#
# Beyond the cwd lookup it is text-only: `..` resolves TEXTUALLY and symlinks are
# NOT dereferenced. Both callers depend on that for different reasons:
#
#   - `protected_canonicalize` (ADR 0004) — `rm` never follows symlinks
#     (ADR 0003 hard rule #1), so the root guard must judge the operand by the
#     name the user typed, not by wherever a link happens to point.
#   - `_cp_recursive_one` — the copy-a-directory-into-itself check needs both
#     operands expressed in one comparable frame before `path_is_under` can rule
#     on them; `cp -r /tmp/x/a a/sub` from /tmp/x is the same mistake as
#     `cp -r a a/sub` and only shares a prefix once both sides are absolute.
#
# On a `getcwd` failure it falls back to normalizing the operand as given: still
# exactly right for an already-absolute path, and merely non-matching for a
# relative one — the safe direction for the root guard, whose fallback comment
# has said so since v0.3.0.
fn fs_path_absolute(operand): i64 {
    if (operand == 0) {
        var z = alloc(2);
        store8(z, 47);                     # "/"
        store8(z + 1, 0);
        return path_normalize(z);
    }
    if (path_is_absolute(operand) == 1) {
        return path_normalize(operand);
    }
    var cwd_buf[4096];
    var n = k_getcwd(&cwd_buf, 4096);
    if (n < 0) {
        return path_normalize(operand);
    }
    var joined = path_join(&cwd_buf, operand);
    return path_normalize(joined);
}

# Resolve `cmd` to a path to hand `execve`, searching `path_env` (a PATH-shaped
# `a:b:c` cstring, or 0 when the variable is unset).
#
# Returns the resolved cstring, or **0 when nothing was found** — callers must
# treat 0 as "command not found" and report it (POSIX exit 127) rather than
# passing anything to exec.
#
# ⛔ RETURNING THE BARE NAME ON FAILURE IS A SANDBOX ESCAPE, NOT A CONVENIENCE.
# `execve("ls", …)` with no slash is resolved by the KERNEL relative to the
# current directory — there is no PATH search at the syscall layer. So both
# "PATH is unset" and "searched PATH and found nothing" used to end in
# `execve("ls")`, which runs `./ls` if one happens to be sitting there.
# Demonstrated: a directory containing an attacker-supplied `./ls`, then
# `printf 'ITEM\n' | env -u PATH xargs ls` printed `PWNED-FROM-CWD ITEM`, while
# GNU xargs ran /usr/bin/ls. Reachable the same way through `find -exec`.
#
# ⭐ An UNSET PATH falls back to `/bin:/usr/bin` — the value glibc's `execvp`
# uses from `confstr(_CS_PATH)`, so kriya lands where GNU lands.
#
# ⚠ An EMPTY PATH is different from an unset one and is left alone: POSIX
# defines a zero-length prefix as the current working directory, so `PATH=`
# legitimately means "." and is resolved as such — but explicitly, through the
# same access/stat check as any other entry, instead of by falling out of the
# bottom of the function.
#
# A `cmd` that already contains a slash is returned unchanged: POSIX says such a
# name is used as given, with no PATH search.
fn fs_resolve_in_path(cmd, path_env): i64 {
    if (cmd == 0) { return 0; }
    var i: i64 = 0;
    var has_slash: i64 = 0;
    while (load8(cmd + i) != 0) {
        if (load8(cmd + i) == 47) { has_slash = 1; }
        i = i + 1;
    }
    if (has_slash == 1) { return cmd; }

    var pe = path_env;
    if (pe == 0) { pe = "/bin:/usr/bin"; }

    var pp: i64 = 0;
    var done: i64 = 0;
    var found: i64 = 0;
    while (done == 0) {
        var seg_end = pp;
        var scanning: i64 = 1;
        while (scanning == 1) {
            var c = load8(pe + seg_end);
            if (c == 0) { scanning = 0; }
            elif (c == 58) { scanning = 0; }              # ':'
            else { seg_end = seg_end + 1; }
        }
        var slen = seg_end - pp;
        var entry: i64 = 0;
        if (slen == 0) {
            entry = alloc(2);
            store8(entry, 46);                            # '.' — POSIX zero-length prefix
            store8(entry + 1, 0);
        } else {
            entry = alloc(slen + 1);
            memcpy(entry, pe + pp, slen);
            store8(entry + slen, 0);
        }
        var candidate = path_join(entry, cmd);
        # k_access: X_OK on Linux, existence check on agnos (no permission model).
        if (k_access(candidate, 1) == 0) {
            var st[144];
            if (k_stat(candidate, &st) == 0) {
                if (fs_is_reg(&st) == 1) {
                    found = candidate;
                    done = 1;
                }
            }
        }
        if (done == 0) {
            if (load8(pe + seg_end) == 0) { done = 1; }
            else { pp = seg_end + 1; }
        }
    }
    return found;
}
