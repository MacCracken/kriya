# src/lib/env.cyr — environment lookup without the 8 KB cliff.
#
# ⛔ WHY THIS EXISTS. The stdlib `getenv` reads `/proc/self/environ` into an
# 8 KB **stack** buffer and scans only what fits. Anything past that byte is
# silently invisible — and the failure is POSITION-DEPENDENT, because whether a
# variable lands inside the window depends on where the shell happened to put
# it, not on anything kriya or the user controls. Demonstrated with `ls`'s
# existing `COLUMNS` read, 40 directories and a 9 KB unrelated variable:
#
#   env COLUMNS=80 BIG=<9KB> kriya ls   -> columns          (COLUMNS early)
#   env BIG=<9KB> COLUMNS=80 kriya ls   -> one-per-line     (COLUMNS past 8 KB)
#   env BIG=<9KB> COLUMNS=80 /usr/bin/ls -C -w 80 -> columns (real getenv)
#
# ⚠ THE CAP IS NOT AN OVERSIGHT UPSTREAM, which is why the fix belongs here
# rather than there. `io.cyr` documents it: a function-local `var[8192]` still
# reserves stack in the prologue even when the agnos path returns before it, and
# agnos hands ring-3 only ~12 KB of init stack, so a larger stack buffer would
# overflow it. The constraint is real; it just does not apply to a HEAP buffer,
# which is what this module uses.
#
# ⛔ FIVE CALL SITES WERE AFFECTED, and `COLUMNS` was the least of them:
# `which`, `xargs` and `find` all look up **PATH**, which would simply appear
# unset — a command not found, or a search of nothing, with no diagnostic.
#
# On agnos there is no `/proc`, and the kernel stages envp on the init stack
# instead; the stdlib's `_agnos_getenv` already reads it and has no 8 KB
# window, so that path delegates unchanged.

enum EnvLimits {
    # Linux caps the whole argv+envp block at ARG_MAX; there is no environment
    # larger than this to read.
    ENV_MAX_BYTES = 2097152;
    ENV_START_CAP = 65536;
}

var _env_state = 0;    # 0 = not tried, 1 = tried
var _env_buf   = 0;
var _env_len   = 0;

# Slurp /proc/self/environ into a heap buffer. ⚠ `k_stat` reports size 0 for a
# procfs file, so the size cannot be asked for — it has to be read until EOF,
# growing when the buffer fills.
fn _env_load(): i64 {
    if (_env_state == 1) { return 0; }
    _env_state = 1;
    var fd = k_open("/proc/self/environ", 0, 0);
    if (fd < 0) { return 0; }
    var cap = ENV_START_CAP;
    var buf = alloc(cap);
    var total: i64 = 0;
    var loop: i64 = 1;
    while (loop == 1) {
        if (total >= cap) {
            if (cap >= ENV_MAX_BYTES) { loop = 0; continue; }
            var ncap = cap + cap;
            if (ncap > ENV_MAX_BYTES) { ncap = ENV_MAX_BYTES; }
            var nbuf = alloc(ncap);
            memcpy(nbuf, buf, total);
            buf = nbuf;
            cap = ncap;
        }
        var n = k_read( fd, buf + total, cap - total);
        if (n < 0) {
            # EINTR retries; anything else stops with what we have.
            if ((0 - n) != 4) { loop = 0; }
        } elif (n == 0) {
            loop = 0;
        } else {
            total = total + n;
        }
    }
    k_close( fd);
    _env_buf = buf;
    _env_len = total;
    return 0;
}

# Value of `name`, or 0 when unset. The returned pointer is NUL-terminated and
# points into the cached block — do not free it, and do not assume it survives
# a second read (there is not one; the block is loaded at most once).
fn kriya_getenv(name): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    # No /proc on agnos; the stdlib reads the init-stack envp and has no window.
    return getenv(name);
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    _env_load();
    if (_env_buf == 0) { return 0; }
    var nlen = strlen(name);
    var pos: i64 = 0;
    while (pos < _env_len) {
        # Each entry is `NAME=VALUE` NUL-terminated.
        var same: i64 = 1;
        var ci: i64 = 0;
        while (ci < nlen) {
            if (pos + ci >= _env_len) { same = 0; ci = nlen; }
            elif (load8(_env_buf + pos + ci) != load8(name + ci)) { same = 0; ci = nlen; }
            else { ci = ci + 1; }
        }
        if (same == 1) {
            if (pos + nlen < _env_len) {
                if (load8(_env_buf + pos + nlen) == 61) {
                    return _env_buf + pos + nlen + 1;
                }
            }
        }
        # Advance past this entry's NUL.
        var adv: i64 = 1;
        while (adv == 1) {
            if (pos >= _env_len) { adv = 0; }
            elif (load8(_env_buf + pos) == 0) { adv = 0; pos = pos + 1; }
            else { pos = pos + 1; }
        }
    }
    return 0;
    #endif
}
