# args.cyr — kriya-side argv helpers and option-parser wrapper.
#
# Bridges two stdlib layers:
#   - `lib/args.cyr`  exposes argv as a function: `argv(n)` walks
#     /proc/self/cmdline.
#   - `lib/flags.cyr` expects argv as a flat C-style array of
#     `cstr*` pointers (`argc`, `argv` parameters).
#
# We build the flat array once (cached) and offer a `start`-aware
# `args_parse` wrapper so each `cmd_<util>` can use stdlib `flags_*`
# without re-deriving the dispatcher offset every time. See
# docs/adr/0002-option-parsing-humans-and-agents.md.

var _kriya_argv_flat = 0;
var _kriya_argv_n    = 0;

# ⛔ `--boolopt=VALUE` USED TO BE ACCEPTED WITH THE VALUE THROWN AWAY, in every
# utility. `sort --reverse=nonsense` sorted and exited 0; so did
# `rm --force=nonsense`, `grep --count=nonsense`, `wc --lines=nonsense`. GNU
# answers "option '--reverse' doesn't allow an argument" and refuses. Accepting
# a flag while discarding what the user attached to it is the worst kind of
# gap — it looks like it worked.
#
# ⚠ THREE OPTIONS LEGITIMATELY TAKE A VALUE and must not be caught by that:
# `cp --preserve=LIST`, `sort --check=quiet`, `tail --follow=name`. The parser
# has no representation for an optional-value long (registering one as a string
# would make the bare `--preserve` swallow the next operand), so the utility
# opts in by name and reads the value back here. One slot is enough — no
# utility has two.
# The last expanded argv (clusters split, attached values separated). Exposed so
# a utility can collect EVERY occurrence of a repeatable option, which
# `flags_get_str` cannot do — it keeps only the last.
var _kriya_expanded   = 0;
var _kriya_expanded_n = 0;
# ⛔ PARALLEL TO `_kriya_expanded`: the `=VALUE` stripped from an opted-in bool
# long at the SAME index, or 0 (1.6.13). The expander rewrites `--preserve=links`
# to a bare `--preserve` so `flags_parse` accepts it, and the registry below keeps
# only the LAST value per name — so a utility whose options are ORDER-dependent
# (`cp -p --preserve=links --no-preserve=mode`) saw a bare flag where a list
# stood, and lost every value but the last. Reading it here keeps ONE notion of
# the option window — the expanded argv — rather than a second walk over the raw
# one (see `kriya_opt_seq`).
var _kriya_expanded_val = 0;

# ⭐ THE SHORT OPTION A BARE DIGIT RUN STANDS FOR, anywhere on the command line —
# grep's `-NUM`, which is `-C NUM` — or 0 (1.6.14). Registered by the utility
# before it parses (`kriya_set_digit_option`). ⚠ Distinct from `obs_num`, which
# is head/tail's obsolescent `-5` and valid in the FIRST position only.
var _kriya_digit_opt = 0;

fn kriya_set_digit_option(letter): i64 {
    _kriya_digit_opt = letter;
    return 0;
}

# ⭐ 1 when the utility has already parsed the first argument as its obsolescent
# count (`head -3c`, `tail +5f`), so the expander drops it (1.6.15). Set with
# `kriya_obs_consume_first` right before the parse; the parse clears it.
# ⚠ The utility parses that argument, not the expander: the grammar after the
# digits is head's own (`c b k m l q v`) or tail's own (`[+-]` `b c l` `f`, and
# a `+` form that is a file NAME unless GNU's operand rule says otherwise).
var _kriya_obs_drop = 0;

fn kriya_obs_consume_first(): i64 {
    _kriya_obs_drop = 1;
    return 0;
}

# 1 when `tok` is `-` followed by a digit: `-5`, `-12`, `-3i`.
# ⭐ Lifted from `seq` (1.6.14), which reads the shape as a NEGATIVE NUMBER — an
# operand — while grep reads it as `-NUM`, an option. One recogniser, and each
# caller decides what the shape means.
fn kriya_token_is_dashdigit(tok): i64 {
    if (tok == 0) { return 0; }
    if (load8(tok) != 45) { return 0; }
    var c = load8(tok + 1);
    if (c < 48) { return 0; }
    if (c > 57) { return 0; }
    return 1;
}

# ⚠ ONE SLOT WAS NOT ENOUGH. The note above used to end "no utility has two" —
# `uniq` has two (`--group` and `--all-repeated`), so the single slot became a
# small registry at 1.4.3. ⛔ Each name keeps its OWN captured value: sharing one
# value slot across two registered names would hand `--group`'s argument to
# `--all-repeated` whenever both appeared, silently.
enum KriyaOptval {
    KRIYA_OPTVAL_MAX = 4,
}

# ⚠ The largest duration `kriya_parse_duration_us` will return, in MICROSECONDS.
# i64's ceiling divided by a thousand, so both `N * mult` and the accumulated sum
# stay three orders of magnitude clear of a wrap. ⭐ About 292 YEARS — nothing
# legitimate is near it, and everything past it saturates rather than wrapping
# into a SHORT sleep, which is the failure mode that matters.
#
# ⚠ It is a ceiling on the RESULT, so the largest accepted operand depends on its
# unit: 9,223,372,036 seconds, or 106,751 days. Both boundaries are asserted.
enum KriyaDuration {
    KRIYA_DUR_MAX_US = 9223372036854775,
}
var _kriya_optval_names = 0;   # cstr array, KRIYA_OPTVAL_MAX slots
var _kriya_optval_vals  = 0;   # captured values, parallel
var _kriya_optval_n     = 0;
var _kriya_optval_want = 0;    # first registered name — kept for kriya_long_value()
var _kriya_optval_val  = 0;    # its captured value, or 0
var _kriya_expand_bad  = 0;    # 1 once the expander printed a fatal diagnostic

fn _kriya_optval_reset(): i64 {
    if (_kriya_optval_names == 0) {
        _kriya_optval_names = alloc(KRIYA_OPTVAL_MAX * 8);
        _kriya_optval_vals  = alloc(KRIYA_OPTVAL_MAX * 8);
    }
    var i: i64 = 0;
    while (i < KRIYA_OPTVAL_MAX) {
        store64(_kriya_optval_names + i * 8, 0);
        store64(_kriya_optval_vals + i * 8, 0);
        i = i + 1;
    }
    _kriya_optval_n = 0;
    _kriya_optval_want = 0;
    _kriya_optval_val = 0;
    return 0;
}

fn _kriya_optval_register(name): i64 {
    if (name == 0) { return 0; }
    if (_kriya_optval_n >= KRIYA_OPTVAL_MAX) { return 0; }
    store64(_kriya_optval_names + _kriya_optval_n * 8, name);
    _kriya_optval_n = _kriya_optval_n + 1;
    if (_kriya_optval_want == 0) { _kriya_optval_want = name; }
    return 0;
}

# Index of the registered name matching `tok+2` for `nlen` bytes, or -1.
fn _kriya_optval_find(tok, nlen): i64 {
    var i: i64 = 0;
    while (i < _kriya_optval_n) {
        var nm = load64(_kriya_optval_names + i * 8);
        if (strlen(nm) == nlen) {
            var q: i64 = 0;
            var eqn: i64 = 1;
            while (q < nlen) {
                if (load8(nm + q) != load8(tok + 2 + q)) { eqn = 0; }
                q = q + 1;
            }
            if (eqn == 1) { return i; }
        }
        i = i + 1;
    }
    return 0 - 1;
}

# The value captured for a registered long, or 0 when absent or given bare.
fn kriya_long_value_for(name): i64 {
    var i: i64 = 0;
    while (i < _kriya_optval_n) {
        if (streq(load64(_kriya_optval_names + i * 8), name) == 1) {
            return load64(_kriya_optval_vals + i * 8);
        }
        i = i + 1;
    }
    return 0;
}

# The `=VALUE` captured for the long name passed to `kriya_args_parse_optval`,
# or 0 when the option was absent or given bare.
fn kriya_long_value(): i64 { return _kriya_optval_val; }

# Build (once) and return a pointer to argv as a flat array of cstr*.
# Length is kriya_argv_count(). The array is allocated on the heap on
# first call; subsequent calls are O(1).
fn kriya_argv_flat(): i64 {
    if (_kriya_argv_flat != 0) { return _kriya_argv_flat; }
    var n = argc();
    var buf = alloc(n * 8);
    var i: i64 = 0;
    while (i < n) {
        store64(buf + i * 8, argv(i));
        i = i + 1;
    }
    _kriya_argv_flat = buf;
    _kriya_argv_n = n;
    return buf;
}

fn kriya_argv_count(): i64 {
    if (_kriya_argv_flat == 0) { kriya_argv_flat(); }
    return _kriya_argv_n;
}

# =====================================================================
# Clustered / attached short options
#
# ⛔ `rm -rf` DID NOT WORK, AND NEITHER DID `ls -la`, `grep -in`, `wc -lw`,
# `sort -rn`, `cp -rp`, `uniq -cd`, `tail -n5` OR `cut -c1-3`. Every one exited
# 2 with "bad option". For a coreutils replacement heading into an OS userland
# that is the most-typed gap there is — `rm -rf` alone appears in essentially
# every shell script ever written.
#
# The stdlib parser puts both forms explicitly out of scope (`lib/flags.cyr`  #skip-lint
# header: "NOT supported … -xyz bundled short bool flags … -xvalue attached
# short value"), so kriya EXPANDS THEM BEFORE HANDING ARGV OVER rather than
# reaching into upstream. `-rf` becomes `-r -f`; `-n5` becomes `-n 5`.
#
# ⭐ THE EXPANSION IS SPEC-DRIVEN, NOT A GUESS. It asks the caller's own flags
# spec whether each letter is a bool or takes a value, so `-rf` splits into two
# bools while `-c1-3` splits into an option and its value — with no per-utility
# table to drift out of sync.
#
# ⚠ Only the 28 utilities that route through `kriya_args_parse` are affected.
# `find`, `seq`, `env`, `du`, `df`, `date`, `echo`, `sleep`, `yes`, `true` and
# `false` walk argv themselves, which is exactly why `find -name`, `seq -5` and
# `du -sh` keep working: a multi-character single-dash token that is a PREDICATE
# or a NEGATIVE NUMBER never reaches this code.
# =====================================================================

# FlagType of the short option `ch` in `spec`, or -1 when `ch` is not registered.
# Reads `lib/flags.cyr`'s documented layout: context +0 entries_ptr,
# +16 entries_count; entry +0 short_ch, +16 type.
# ⚠ That layout is a published contract in the stdlib header, not a guess — but
# it IS a coupling. If a pin bump ever changes it, this is the first thing to
# re-read (see lessons.md § The compiler watchlist).
fn kriya_short_type(spec, ch): i64 {
    if (spec == 0) { return 0 - 1; }
    if (ch == 0)   { return 0 - 1; }
    var entries = load64(spec);
    var count   = load64(spec + 16);
    var i: i64 = 0;
    while (i < count) {
        var ep = entries + i * FLAGS_ENTRY_SIZE;
        if (load64(ep) == ch) { return load64(ep + 16); }
        i = i + 1;
    }
    return 0 - 1;
}

# The obsolescent bare-digit count where it is not accepted: anywhere but the
# first argument.
#
# ⛔ ACCEPTING IT ANYWHERE SILENTLY OVERRODE THE OPTION IN FRONT OF IT. `head -n 1
# -5 f` expanded the trailing `-5` into `-n 5` and honoured it — FIVE lines, exit
# 0, where the command says one. GNU 9.11 refuses the form outright in any but
# the first position (`head: invalid trailing option -- 5`, and `tail: option
# used in invalid context -- 5`, both non-zero), precisely because a digit that
# far from the front is far more likely a typo than an intent. A wrong answer
# that reports success is the failure mode this repo exists not to have.
#
# ⚠ The position is the argument's own, NOT "the first option": GNU reads only
# argv[1], so `head f -5` is refused too even though nothing optional precedes
# it. Measured against coreutils 9.11, not inferred.
fn _kriya_obsnum_trailing(tok, tlen): i64 {
    k_write( 2, "kriya ", 6);
    if (_help_name != 0) { k_write( 2, _help_name, strlen(_help_name)); }
    k_write( 2, ": error: invalid trailing option -- ", 36);
    k_write( 2, tok + 1, tlen - 1);
    k_write( 2, " (the bare-digit count is accepted only as the first argument)\n", 63);
    return 0;
}

# Does the option cluster `tok` (`-xyz`, tlen >= 2) hold a digit in OPTION
# position — before any value-taking short, whose attached remainder is a value?
fn _kriya_cluster_has_digit(spec, tok, tlen): i64 {
    var k: i64 = 1;
    var found: i64 = 0;
    while (k < tlen) {
        var c = load8(tok + k);
        if (c >= 48) {
            if (c <= 57) { found = 1; }
        }
        var ty = kriya_short_type(spec, c);
        if (ty > 0) { k = tlen; }              # the rest is this option's value
        k = k + 1;
    }
    return found;
}

# Expand a cluster holding digit runs: each run becomes `-<digit opt>` plus the
# run as its value; every other letter is handled as the plain cluster path
# handles it. Returns the new output cursor; sets `_kriya_dx_want` when the last
# letter is value-taking with nothing attached (its value is the next token).
#
# ⚠ GNU's rule, measured on grep 3.12: digits ACCUMULATE within one run — `-12`
# is 12 — and a new run restarts, whether in the same token (`-1i2` is 2) or the
# next (`-1 -2` is 2). Emitting one `-C RUN` per run and letting the parser keep
# the last value is exactly that.
var _kriya_dx_want = 0;

fn _kriya_expand_digits(spec, tok, tlen, out, oi): i64 {
    _kriya_dx_want = 0;
    var k: i64 = 1;
    while (k < tlen) {
        var c = load8(tok + k);
        var isdig: i64 = 0;
        if (c >= 48) {
            if (c <= 57) { isdig = 1; }
        }
        if (isdig == 1) {
            var j = k;
            var run: i64 = 1;
            while (run == 1) {
                if (j >= tlen) { run = 0; }
                else {
                    var dj = load8(tok + j);
                    if (dj < 48) { run = 0; }
                    elif (dj > 57) { run = 0; }
                    else { j = j + 1; }
                }
            }
            var f = alloc(3);
            store8(f, 45);
            store8(f + 1, _kriya_digit_opt);
            store8(f + 2, 0);
            store64(out + oi * 8, f);
            oi = oi + 1;
            var v = alloc(j - k + 1);
            memcpy(v, tok + k, j - k);
            store8(v + j - k, 0);
            store64(out + oi * 8, v);
            oi = oi + 1;
            k = j;
        } else {
            var ty = kriya_short_type(spec, c);
            var g = alloc(3);
            store8(g, 45);
            store8(g + 1, c);
            store8(g + 2, 0);
            store64(out + oi * 8, g);
            oi = oi + 1;
            if (ty > 0) {
                if (k + 1 < tlen) {
                    store64(out + oi * 8, tok + k + 1);
                    oi = oi + 1;
                } else {
                    _kriya_dx_want = 1;
                }
                k = tlen;
            } else {
                k = k + 1;
            }
        }
    }
    return oi;
}

# Rewrite `av[0..n)` with clusters expanded, returning the new count. The
# expanded array is written to `out` (caller-allocated, see the cap computed in
# `kriya_args_parse`). `av[0]` is the program name and passes through untouched.
#
# `obs_num` is the short option letter that an obsolescent bare-digit operand
# maps to — `head -5` meaning `head -n 5` — or 0 for utilities with no such
# form. It only fires on a token that is `-` followed by digits only, so a
# registered numeric short (`ls -1`) is unaffected: that is matched as an
# option first. ⚠ And only in the FIRST argument position — see
# `_kriya_obsnum_trailing`.
#
# ⚠ Since 1.6.15 `head` and `tail` parse that first argument THEMSELVES — their
# forms go well past bare digits (`-3c`, `+5f`) — and have the expander drop it
# (`kriya_obs_consume_first`). For them the rewrite below never fires, and what
# `obs_num` still does is refuse a bare-digit option anywhere else.
fn kriya_expand_shorts(spec, n, av, out, obs_num): i64 {
    var oi: i64 = 0;
    if (n > 0) {
        store64(out, load64(av));
        oi = 1;
    }
    var passthrough: i64 = 0;      # set once `--` is seen
    # ⛔ THE TOKEN AFTER A SEPARATED VALUE-TAKING OPTION IS A VALUE, NOT AN
    # OPTION, and the expander used to interpret it anyway. `realpath
    # --relative-base -Ps dlink` names a DIRECTORY called `-Ps`; the cluster
    # splitter turned it into `-P -s`, realpath's own scan skipped exactly one
    # token after the long option, and the orphaned `-s` switched the resolution
    # mode. GNU prints the resolved path; kriya printed the symlink.
    #
    # ⛔ AND IT COULD FABRICATE ONE. `realpath --relative-base -em nodir/leaf`
    # leaked an `-m`, so a path with a missing middle component came back as a
    # confident absolute path at EXIT 0 where GNU exits 1 — a wrong answer that
    # reports success, on a value the user chose.
    #
    # ⚠ Fixed HERE rather than in realpath, because the leak is the expander's:
    # every utility with a value-taking option had it, and a per-utility scan
    # that skips "one token" cannot be right when the expander has already turned
    # that one token into two.
    var pass_one: i64 = 0;
    var i: i64 = 1;
    while (i < n) {
        var tok  = load64(av + i * 8);
        var tlen = strlen(tok);
        var handled: i64 = 0;
        var want_value: i64 = 0;
        # The first argument, when the utility already parsed it as its
        # obsolescent count: dropped, never interpreted a second time.
        if (i == 1) {
            if (_kriya_obs_drop == 1) { handled = 1; }
        }

        if (passthrough + pass_one + handled == 0) {
            # `--` terminator: copy it and stop interpreting.
            if (tlen == 2) {
                if (load8(tok) == 45) {
                    if (load8(tok + 1) == 45) { passthrough = 1; }
                }
            }
            if (passthrough == 0) {
                # `--NAME=VALUE`. A bool long must refuse the argument; the one
                # long the caller opted in gets it stripped and stashed so
                # flags_parse still sees a plain `--NAME`.
                if (tlen > 3) {
                    if (load8(tok) == 45) {
                        if (load8(tok + 1) == 45) {
                            var eq: i64 = 0;
                            var e: i64 = 2;
                            while (e < tlen) {
                                if (load8(tok + e) == 61) {
                                    if (eq == 0) { eq = e; }
                                }
                                e = e + 1;
                            }
                            if (eq > 0) {
                                var nlen = eq - 2;
                                var lt = kriya_long_type(spec, tok + 2, nlen);
                                if (lt == 0) {                       # FLAG_BOOL
                                    # ⚠ `ovi`, NOT `oi` — `oi` is the EXPANSION OUTPUT
                                    # CURSOR in the enclosing scope, and reusing the
                                    # name here silently corrupted the rewritten argv.
                                    var ovi = _kriya_optval_find(tok, nlen);
                                    var opted: i64 = 0;
                                    if (ovi >= 0) { opted = 1; }
                                    if (opted == 1) {
                                        store64(_kriya_optval_vals + ovi * 8, tok + eq + 1);
                                        if (ovi == 0) { _kriya_optval_val = tok + eq + 1; }
                                        if (_kriya_expanded_val != 0) {
                                            store64(_kriya_expanded_val + oi * 8, tok + eq + 1);
                                        }
                                        var bare = alloc(nlen + 3);
                                        store8(bare, 45);
                                        store8(bare + 1, 45);
                                        var b: i64 = 0;
                                        while (b < nlen) {
                                            store8(bare + 2 + b, load8(tok + 2 + b));
                                            b = b + 1;
                                        }
                                        store8(bare + 2 + nlen, 0);
                                        store64(out + oi * 8, bare);
                                        oi = oi + 1;
                                        handled = 1;
                                    } else {
                                        k_write( 2, "kriya ", 6);
                                        k_write( 2, load64(av), strlen(load64(av)));
                                        k_write( 2, ": option '--", 12);
                                        k_write( 2, tok + 2, nlen);
                                        k_write( 2, "' doesn't allow an argument\n", 28);
                                        _kriya_expand_bad = 1;
                                        handled = 1;
                                    }
                                }
                            }
                        }
                    }
                }
                # ⛔ A TWO-BYTE SHORT NEVER REACHES THE CLUSTER SPLITTER — that
                # branch is guarded by `tlen > 2` — so `-n` was the one spelling
                # of a value-taking option whose value stayed interpreted. It is
                # also the COMMON one: `head -n -5` reported *invalid trailing
                # option -- 5* about the count it was given, blaming the value
                # for being an option, which is the same mistake `--width 32`
                # made in the other direction.
                if (handled == 0) {
                    if (tlen == 2) {
                        if (load8(tok) == 45) {
                            if (load8(tok + 1) != 45) {
                                if (kriya_short_type(spec, load8(tok + 1)) > 0) { want_value = 1; }
                            }
                        }
                    }
                }
                # A bare `--name` (no `=`) that takes a value claims the next
                # token. The attached spelling was already consumed above.
                if (handled == 0) {
                    if (tlen > 2) {
                        if (load8(tok) == 45) {
                            if (load8(tok + 1) == 45) {
                                var has_eq: i64 = 0;
                                var q: i64 = 2;
                                while (q < tlen) {
                                    if (load8(tok + q) == 61) { has_eq = 1; }
                                    q = q + 1;
                                }
                                if (has_eq == 0) {
                                    if (kriya_long_type(spec, tok + 2, tlen - 2) > 0) { want_value = 1; }
                                }
                            }
                        }
                    }
                }
                # ⭐ `grep -NUM` (1.6.14): a digit run in option position is the
                # registered digit option with the run as its value — `-5` is
                # `-C 5`, `-in2` is `-i -n -C 2` — anywhere on the line, as GNU's.
                # ⚠ Only for a utility that registered one, and only when the
                # cluster has a digit where an OPTION could stand: `-e5` and
                # `-A5` still read their `5` as the value they already were.
                if (handled == 0) {
                    if (_kriya_digit_opt != 0) {
                        if (tlen >= 2) {
                            if (load8(tok) == 45) {
                                if (load8(tok + 1) != 45) {
                                    var lead_ok: i64 = 0;
                                    if (kriya_token_is_dashdigit(tok) == 1) { lead_ok = 1; }
                                    if (kriya_short_type(spec, load8(tok + 1)) >= 0) { lead_ok = 1; }
                                    if (lead_ok == 1) {
                                        if (_kriya_cluster_has_digit(spec, tok, tlen) == 1) {
                                            oi = _kriya_expand_digits(spec, tok, tlen, out, oi);
                                            if (_kriya_dx_want == 1) { want_value = 1; }
                                            handled = 1;
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
                if (tlen > 2) {
                    if (handled == 0) {
                        if (load8(tok) == 45) {
                            if (load8(tok + 1) != 45) {
                                # ⚠ Only expand when the FIRST letter is a REGISTERED short.
                                # That single condition is what keeps a non-option token that
                                # merely starts with a dash — a `printf` format, a `tr` set,
                                # a negative operand — byte-identical to what it is today.
                                var t0 = kriya_short_type(spec, load8(tok + 1));
                                if (t0 >= 0) {
                                    var k: i64 = 1;
                                    var stop: i64 = 0;
                                    while (k < tlen) {
                                        if (stop == 0) {
                                            var c  = load8(tok + k);
                                            var ty = kriya_short_type(spec, c);
                                            var f  = alloc(3);
                                            store8(f, 45);          # '-'
                                            store8(f + 1, c);
                                            store8(f + 2, 0);
                                            store64(out + oi * 8, f);
                                            oi = oi + 1;
                                            if (ty > 0) {
                                                # INT or STR. Anything left in the token is the
                                                # attached value — and it is already a valid
                                                # cstring, so it needs no copy.
                                                if (k + 1 < tlen) {
                                                    store64(out + oi * 8, tok + k + 1);
                                                    oi = oi + 1;
                                                } else {
                                                    # Nothing attached: the value is the NEXT
                                                    # token, and it is a value whatever it looks
                                                    # like — `head -n -5`, `realpath -e -s`.
                                                    want_value = 1;
                                                }
                                                stop = 1;
                                            }
                                            # A bool keeps walking. An UNKNOWN letter is emitted
                                            # as its own `-X` on purpose, so the parser names the
                                            # offending letter instead of the whole cluster.
                                        }
                                        k = k + 1;
                                    }
                                    handled = 1;
                                }
                            }
                        }
                    }
                }
                # Obsolescent `head -5` / `tail -5` → `-n 5`, FIRST ARGUMENT
                # ONLY (`_kriya_obsnum_trailing` has why the position matters).
                if (handled == 0) {
                    if (obs_num != 0) {
                        if (tlen > 1) {
                            if (load8(tok) == 45) {
                                var d: i64 = 1;
                                var alldig: i64 = 1;
                                while (d < tlen) {
                                    if (load8(tok + d) < 48) { alldig = 0; }
                                    if (load8(tok + d) > 57) { alldig = 0; }
                                    d = d + 1;
                                }
                                if (alldig == 1) {
                                    if (i == 1) {
                                        var g = alloc(3);
                                        store8(g, 45);
                                        store8(g + 1, obs_num);
                                        store8(g + 2, 0);
                                        store64(out + oi * 8, g);
                                        oi = oi + 1;
                                        store64(out + oi * 8, tok + 1);
                                        oi = oi + 1;
                                        handled = 1;
                                    } else {
                                        _kriya_obsnum_trailing(tok, tlen);
                                        _kriya_expand_bad = 1;
                                        handled = 1;
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        if (handled == 0) {
            store64(out + oi * 8, tok);
            oi = oi + 1;
        }
        # ⚠ Cleared by assignment rather than by a reset: a value token sets no
        # `want_value` of its own, so one pass-through never chains into a second.
        pass_one = want_value;
        i = i + 1;
    }
    return oi;
}

# Parse argv[start..] against `spec` using stdlib `flags_parse`.
# `start` is the dispatcher offset (1 for symlink form, 2 for
# `kriya <util>` form). We slice argv so `flags_parse` sees its
# conventional layout: argv[0] is the utility name (treated as
# program name and otherwise ignored), argv[1..] are the args.
# Returns 0 on success, non-zero on parse error.
fn kriya_args_parse(spec, start: i64): i64 {
    return kriya_args_parse_obsnum(spec, start, 0);
}

# FlagType of the long option named by the `len` bytes at `name`, or -1 when it
# is not registered. Same layout contract as `kriya_short_type`.
fn kriya_long_type(spec, name, len): i64 {
    if (spec == 0) { return 0 - 1; }
    var entries = load64(spec);
    var count   = load64(spec + 16);
    var i: i64 = 0;
    while (i < count) {
        var ep = entries + i * FLAGS_ENTRY_SIZE;
        var ln = load64(ep + 8);
        if (ln != 0) {
            if (strlen(ln) == len) {
                var j: i64 = 0;
                var same: i64 = 1;
                while (j < len) {
                    if (load8(ln + j) != load8(name + j)) { same = 0; }
                    j = j + 1;
                }
                if (same == 1) { return load64(ep + 16); }
            }
        }
        i = i + 1;
    }
    return 0 - 1;
}

# Index of the first OPERAND at or after `start`: a token that does not start
# with `-` (a lone `-` included), or the one after a `--`, which is consumed.
# Everything before it is `spec`'s options and their values — or options it does
# not have, which the parser then refuses.
#
# ⛔ AN UNKNOWN OPTION USED TO END THE WINDOW, so it became the COMMAND: `echo hi
# | xargs -5 echo` ran a program called `-5` and exited 127, "command not
# found", where GNU says *invalid option -- '5'* — and a caller cannot tell a
# typo'd flag from a missing binary by 127. GNU's rule is the one here: before
# the command, a word that starts with `-` is an option, known or not (1.6.16).
#
# ⛔ THIS EXISTS BECAUSE `xargs` WAS PARSING THE CHILD'S COMMAND LINE AS ITS OWN.
# `echo t.txt | xargs sort -r` silently sorted ASCENDING — `-r` was eaten as
# `--no-run-if-empty` and `sort` ran with no options at all. `xargs head -n 2`
# ate `-n 2` as `--max-args`. Worst of all the `--` GUARD WAS CONSUMED AND
# DELETED, so `ls -1 | xargs rm --` handed `rm` an argument list beginning `-r`
# and recursively deleted a directory the `--` was written to protect.
#
# POSIX is explicit that option recognition stops at the first operand, and for
# a utility whose operands ARE another command line that is not a nicety.
#
# ⚠ Value-taking options are the whole difficulty: the scan has to know that
# `-n 5` swallows the following token while `-n5` does not, or the boundary
# lands one token off and the child loses its first argument. That is why this
# is spec-driven rather than a dash-counting heuristic.
fn kriya_argv_option_end(spec, start: i64): i64 {
    var n = kriya_argv_count();
    var flat = kriya_argv_flat();
    var i = start;
    var done: i64 = 0;
    while (done == 0) {
        if (i >= n) { done = 1; }
        else {
            var tok  = load64(flat + i * 8);
            var tlen = strlen(tok);
            if (tlen < 2) { done = 1; }                       # "" or a bare "-" operand
            else {
                if (load8(tok) != 45) { done = 1; }           # no leading '-' → operand
                else {
                    if (load8(tok + 1) == 45) {
                        if (tlen == 2) {
                            i = i + 1;                        # "--": consume, then stop
                            done = 1;
                        } elif (_kriya_tok_is_help(tok, tlen) == 1) {
                            # ⚠ `--help` is not in any spec — it is intercepted in
                            # `kriya_args_parse_range`. Without this arm the operand
                            # scan calls it the first OPERAND, so `xargs --help` made
                            # `--help` the COMMAND to run and printed nothing at all.
                            # Consuming it here keeps it inside the option window,
                            # while `xargs foo --help` still hands it to `foo`.
                            i = i + 1;
                        } elif (_kriya_tok_is_version(tok, tlen) == 3) {
                            # ⛔ SAME TRAP, SAME SHAPE. `--version` is in no spec
                            # either, so on arrival it reproduced the 1.3.0 bug
                            # exactly: `xargs --version` printed nothing, exited 0,
                            # and blocked reading stdin because `--version` had
                            # become the command to run. Any future
                            # intercepted-not-declared option needs an arm here.
                            i = i + 1;
                        } else {
                            # "--name" or "--name=value".
                            var eq: i64 = 0;
                            var e: i64 = 2;
                            while (e < tlen) {
                                if (load8(tok + e) == 61) {   # '='
                                    if (eq == 0) { eq = e; }
                                }
                                e = e + 1;
                            }
                            if (eq > 0) { i = i + 1; }        # value attached
                            else {
                                var lt = kriya_long_type(spec, tok + 2, tlen - 2);
                                i = i + 1;                    # unknown: the parser refuses it
                                if (lt > 0) { i = i + 1; }    # separate value token
                            }
                        }
                    } else {
                        var t0 = kriya_short_type(spec, load8(tok + 1));
                        if (t0 < 0) { i = i + 1; }            # unknown: the parser refuses it
                        else {
                            # Walk the cluster to find whether its LAST effective
                            # option takes a value with nothing attached.
                            var k: i64 = 1;
                            var eats_next: i64 = 0;
                            var stop: i64 = 0;
                            while (k < tlen) {
                                if (stop == 0) {
                                    var ty = kriya_short_type(spec, load8(tok + k));
                                    if (ty > 0) {
                                        if (k + 1 >= tlen) { eats_next = 1; }
                                        stop = 1;
                                    }
                                }
                                k = k + 1;
                            }
                            i = i + 1;
                            if (eats_next == 1) { i = i + 1; }
                        }
                    }
                }
            }
        }
    }
    if (i > n) { i = n; }
    return i;
}

# As `kriya_args_parse`, plus the obsolescent bare-digit form mapped onto the
# short option `obs_num` (`head`/`tail` pass 110 = 'n').
fn kriya_args_parse_obsnum(spec, start: i64, obs_num): i64 {
    return kriya_args_parse_range(spec, start, kriya_argv_count(), obs_num);
}

# Parse only argv[start..end) against `spec`. `end` is exclusive. Utilities
# whose operands are themselves a command line (`xargs`) use this with
# `kriya_argv_option_end` so the child's flags are never interpreted.
# As `kriya_args_parse`, plus one long option allowed to carry `=VALUE` — read
# it back with `kriya_long_value()` after parsing. Used by `cp --preserve=LIST`,
# `sort --check=quiet` and `tail --follow=name`, the three places where GNU
# defines an optional value that the stdlib parser cannot represent.
fn kriya_args_parse_optval(spec, start: i64, obs_num, optval_long): i64 {
    _kriya_optval_reset();
    _kriya_optval_register(optval_long);
    return kriya_args_parse_range(spec, start, kriya_argv_count(), obs_num);
}

# Two optional-value longs. ⚠ `uniq` is the first utility to need more than one;
# pass 0 for `b` if only one is wanted.
fn kriya_args_parse_optval2(spec, start: i64, obs_num, a, b): i64 {
    _kriya_optval_reset();
    _kriya_optval_register(a);
    _kriya_optval_register(b);
    return kriya_args_parse_range(spec, start, kriya_argv_count(), obs_num);
}

# 1 if argv[start..end) contains a bare `--help`, 2 if it contains `--help=...`,
# 0 otherwise. Checked BEFORE `flags_parse`, because `--help` is deliberately not
# a registered flag — registering it on 38 specs would be 38 chances to forget.
# 1 for a bare `--help`, 2 for `--help=...`, 0 otherwise.
# ⚠ THE `--help=json` SCHEMA IS A PUBLIC INTERFACE (ADR 0002). Additive changes
# within a major are allowed and consumers must tolerate unknown fields; removing
# or retyping a field is a break that bumps this and needs its own ADR.
enum KriyaHelpSchema {
    KRIYA_HELP_SCHEMA_VERSION = 1;
}

# ⚠ `kriya --list` is a SEPARATE public interface from `--help=json`, versioned
# on its own — a consumer may well parse one and not the other, and the two need
# not break together.
enum KriyaListSchema {
    KRIYA_LIST_SCHEMA_VERSION = 1;
}

# The `--help=FORMAT` token that `_kriya_wants_help` matched, so the caller can
# read the format back off it without rescanning argv.
var _kriya_help_tok = 0;

# 3 when `tok` is exactly `--version`.
#
# ⚠ `-V` is NOT a version alias, for the same reason `-h` is not a help alias
# (ADR 0002). GNU gives `sort -V` to version-STRING SORT, and kriya's `sort`
# header reserves it for exactly that (roadmap 1.8.1) — so claiming `-V` here
# would either collide on arrival or force `sort` to be the one utility where it
# means something else. A short letter that means one thing on 37 utilities and
# something else on one is worse than a short letter that never means it.
fn _kriya_tok_is_version(tok, tlen): i64 {
    if (tlen == 9) {
        if (streq(tok, "--version") == 1) { return 3; }
    }
    return 0;
}

fn _kriya_tok_is_help(tok, tlen): i64 {
    if (tlen == 6) {
        if (streq(tok, "--help") == 1) { return 1; }
    }
    if (tlen > 7) {
        var lit = "--help=";
        var k: i64 = 0;
        var pre: i64 = 1;
        while (k < 7) {
            if (load8(tok + k) != load8(lit + k)) { pre = 0; }
            k = k + 1;
        }
        if (pre == 1) { return 2; }
    }
    return 0;
}

fn _kriya_wants_help(start: i64, end: i64): i64 {
    var flat = kriya_argv_flat();
    var i = start;
    while (i < end) {
        var tok = load64(flat + i * 8);
        var tlen = strlen(tok);
        # `--` ends option recognition; a later `--help` is an operand.
        if (tlen == 2) {
            if (load8(tok) == 45) {
                if (load8(tok + 1) == 45) { return 0; }
            }
        }
        var hk = _kriya_tok_is_help(tok, tlen);
        if (hk == 0) { hk = _kriya_tok_is_version(tok, tlen); }
        if (hk != 0) {
            _kriya_help_tok = tok;
            return hk;
        }
        i = i + 1;
    }
    return 0;
}

fn kriya_args_parse_range(spec, start: i64, end: i64, obs_num): i64 {
    _kriya_expand_bad = 0;

    # ⭐ `--help` RENDERS AND EXITS HERE rather than returning a sentinel. Every
    # one of the 28 call sites has the shape
    # `if (kriya_args_parse(...) != 0) { report "bad option"; return EXIT_USAGE; }`
    # so any non-zero return would print "bad option" for a successful `--help`.
    # Threading a third outcome through all of them is 28 chances to get it wrong,
    # for a path that legitimately terminates the process anyway.
    #
    # ⚠ The write-failure flag is still honoured: `kriya ls --help > /dev/full`
    # must not exit 0. That is the one thing exiting early could have silently
    # broken (see the sticky state in `src/lib/sys.cyr`).
    var hw = _kriya_wants_help(start, end);
    if (hw == 1) {
        help_render(spec);
        if (k_write_failed() == 1) { syscall(SYS_EXIT, 1); }
        syscall(SYS_EXIT, 0);
    }
    if (hw == 2) {
        # `--help=json` is the ADR-0002 machine form. Renders and exits, exactly
        # as the human form above does, and for the same reason.
        help_format_dispatch(spec, _kriya_help_tok);
    }
    if (hw == 3) {
        help_render_version();
        if (k_write_failed() == 1) { syscall(SYS_EXIT, 1); }
        syscall(SYS_EXIT, 0);
    }
    var flat = kriya_argv_flat();
    var n = end;
    var head = start - 1;
    var slice_argc = n - head;
    if (slice_argc < 1) { slice_argc = 1; }
    var slice_argv = flat + head * 8;

    # Worst case one output token per byte of every input token (an all-bool
    # cluster), plus the tokens themselves.
    var cap: i64 = 0;
    var i: i64 = 0;
    while (i < slice_argc) {
        cap = cap + 1 + strlen(load64(slice_argv + i * 8));
        i = i + 1;
    }
    var out = alloc(cap * 8);
    # Zeroed, one slot per possible output token — see `_kriya_expanded_val`.
    _kriya_expanded_val = alloc(cap * 8);
    var zi: i64 = 0;
    while (zi < cap) {
        store64(_kriya_expanded_val + zi * 8, 0);
        zi = zi + 1;
    }
    var m = kriya_expand_shorts(spec, slice_argc, slice_argv, out, obs_num);
    _kriya_obs_drop   = 0;
    _kriya_expanded   = out;
    _kriya_expanded_n = m;
    # The expander already printed the precise diagnostic ("option '--x' doesn't
    # allow an argument", "invalid trailing option -- 5"), so return a plain
    # failure and let the caller's usage exit stand — it names the offender, and
    # the caller's line supplies the exit code every call site already agrees on.
    if (_kriya_expand_bad == 1) { return 0 - 1; }
    # ⭐ Every operand survives: the stdlib table grows its positionals since cyrius
    # v6.6.5. Before that it kept 128 and DISCARDED the rest while returning success
    # (`kriya rm *` on 200 files deleted 128 and exited 0), so 1.6.3–1.6.10 counted
    # operands here and exited 2 on a shortfall. `smoke-rm.sh` and `smoke-realpath.sh`
    # now assert that every operand is PROCESSED, which holds however it is satisfied.
    return flags_parse(spec, m, out);
}

# The expanded argv the last `kriya_args_parse*` handed to `flags_parse`, and
# its length: clusters already split (`-Ps` → `-P -s`), attached values already
# separated (`-n5` → `-n 5`), long forms normalised, `--` honoured, permutation
# resolved, `[0]` the utility name. Zero before the first parse.
#
# ⛔ EVERY ORDER-SENSITIVE QUESTION IS ASKED OF THIS ARRAY AND NOT OF `argv(i)`,
# BECAUSE THREE UTILITIES ASKED THE RAW ONE AND ALL THREE WERE WRONG ON A
# CLUSTER. `realpath -Ps slink` RESOLVED the symlink where GNU printed it
# untouched: the raw token is `-Ps`, the scan only recognised two-byte shorts,
# and the `-s` was invisible. The separated `-P -s` was right, so nothing went
# red. Utilities read the parser's own view or they get a second opinion about
# what the user wrote.
#
# ⚠ Two callers, two shapes: `kriya_opt_seq` below answers "where did THIS option
# last appear", while `ls`'s `_ls_scan_format` walks this array itself because it
# resolves a whole GROUP of selectors in one pass and needs their relative order,
# not one option's position.
fn kriya_expanded_argv(): i64 { return _kriya_expanded; }
fn kriya_expanded_argc(): i64 { return _kriya_expanded_n; }

# The `=VALUE` an opted-in bool long carried at expanded index `i`, or 0 when it
# was given bare (or `i` is anything else). See `_kriya_expanded_val`.
fn kriya_expanded_optval(i): i64 {
    if (_kriya_expanded_val == 0) { return 0; }
    if (i < 0) { return 0; }
    if (i >= _kriya_expanded_n) { return 0; }
    return load64(_kriya_expanded_val + i * 8);
}

# Where did the option spelled `-short_ch` / `--long_name` LAST appear on the
# command line? Returns a positive index into the expanded argv, or 0 if it
# never did. Either half may be 0 for an option that has only the other
# spelling. Call after `kriya_args_parse*`.
#
# ⛔ THIS EXISTS BECAUSE "WAS IT GIVEN" IS NOT ENOUGH FOR A PAIR THAT CONFLICTS,
# AND A PRECEDENCE RULE IS NOT AN ANSWER TO ONE. Measured against GNU coreutils
# 9.11: `head -c 3 -n 1` is the first LINE and `head -n 1 -c 3` the first three
# BYTES; `readlink -m -e nope` is exit 1 with no output and `readlink -e -m
# nope` prints the path; `ls -tS` is a SIZE sort and `ls -St` a TIME sort. Not
# one of those pairs can be expressed as "x beats y" — only the ORDER decides,
# and the flag table keeps a value per flag with no order at all.
#
# ⛔ AND IT WALKS THE EXPANDED ARGV, WHICH IS THE WHOLE POINT. `ls` first
# answered this by scanning the RAW argv up to `kriya_argv_option_end`, and that
# window stops at the first operand while the parser happily permutes — so
# `ls aa bb cc -rt` honoured the `-r` and SILENTLY DROPPED the `-t` from the
# same cluster, giving name order with exit 0. Two independent notions of "the
# option window", kept in sync by hand, is what produced that.
#
# ⚠ A value-taking option's VALUE is skipped, so `ls -w -t` cannot be read as a
# `-t` that the parser consumed as the width, and `head --lines -c` cannot be
# read as a `-c` that was really the line count. The question of which options
# take a value is put to the caller's own spec, so it cannot drift.
#
# ⚠ `--` ENDS THE SCAN. Past it every token is an operand, and a file genuinely
# named `-t` must not re-sort the listing.
fn kriya_opt_seq(spec, short_ch, long_name): i64 {
    var av = kriya_expanded_argv();
    var n  = kriya_expanded_argc();
    if (av == 0) { return 0; }
    var llen: i64 = 0;
    if (long_name != 0) { llen = strlen(long_name); }
    var seen: i64 = 0;
    var no_more: i64 = 0;
    var i: i64 = 1;
    while (i < n) {
        var tok  = load64(av + i * 8);
        var tlen = strlen(tok);
        var step: i64 = 1;
        if (no_more == 0) {
            if (tlen >= 2) {
                if (load8(tok) == 45) {
                    if (load8(tok + 1) == 45) {
                        if (tlen == 2) { no_more = 1; }
                        else {
                            # `--name` or the attached `--name=VALUE`, which the
                            # expander leaves whole for a value-taking long.
                            var eq: i64 = 0;
                            var e: i64 = 2;
                            while (e < tlen) {
                                if (eq == 0) {
                                    if (load8(tok + e) == 61) { eq = e; }
                                }
                                e = e + 1;
                            }
                            var nlen = tlen - 2;
                            if (eq > 0) { nlen = eq - 2; }
                            if (nlen == llen) {
                                var same: i64 = 1;
                                var j: i64 = 0;
                                while (j < nlen) {
                                    if (load8(tok + 2 + j) != load8(long_name + j)) { same = 0; }
                                    j = j + 1;
                                }
                                if (same == 1) { seen = i; }
                            }
                            if (eq == 0) {
                                if (kriya_long_type(spec, tok + 2, nlen) > 0) { step = 2; }
                            }
                        }
                    } else {
                        # The expansion guarantees a registered short is its own
                        # two-byte token with its value, if any, following.
                        var c  = load8(tok + 1);
                        var ty = kriya_short_type(spec, c);
                        if (ty >= 0) {
                            if (c == short_ch) { seen = i; }
                            if (ty > 0) { step = 2; }
                        }
                    }
                }
            }
        }
        i = i + step;
    }
    return seen;
}

# The short-only spelling of `kriya_opt_seq`, kept for the callers that have no
# long form to pass. ⚠ Not "boolean short" any more — the general scan skips a
# value-taking option's value rather than ignoring the option itself, which is
# what `head -c 3 -n 1` needs.
fn kriya_short_seq(spec, short_ch): i64 {
    return kriya_opt_seq(spec, short_ch, 0);
}

# Push every value given for the repeatable option `short_ch` / `--long_name`
# into `out` (a vec), in argv order. Returns how many were found.
#
# ⛔ THE STDLIB SPEC KEEPS ONLY THE LAST VALUE, and for a repeatable option that
# is a silent wrong answer rather than a missing feature: `grep -e alpha -e
# gamma` matched only `gamma`, with no diagnostic and exit 0, where GNU matched
# both. `flags_add_str` has one value slot, so the earlier occurrences were
# overwritten during parsing and there was nothing left to recover afterwards.
#
# ⭐ Walks the EXPANDED argv, not the raw one, so every spelling has already been
# normalised to `-e VALUE` — `-ealpha`, `-ie alpha` and `--regexp=alpha` all
# arrive here in the same shape. Call after `kriya_args_parse*`.
fn kriya_argv_collect(short_ch, long_name, out): i64 {
    var av = _kriya_expanded;
    var n  = _kriya_expanded_n;
    if (av == 0) { return 0; }
    var found: i64 = 0;
    var llen: i64 = 0;
    if (long_name != 0) { llen = strlen(long_name); }
    var i: i64 = 1;
    while (i < n) {
        var tok  = load64(av + i * 8);
        var tlen = strlen(tok);
        var take: i64 = 0;         # 1 = value is the next token
        var inline_at: i64 = 0;    # >0 = value starts at this offset in tok
        if (tlen == 2) {
            if (load8(tok) == 45) {
                if (load8(tok + 1) == short_ch) { take = 1; }
            }
        }
        if (tlen > 2) {
            if (load8(tok) == 45) {
                if (load8(tok + 1) == 45) {
                    if (llen > 0) {
                        # --long=VALUE or --long VALUE
                        var same: i64 = 1;
                        var j: i64 = 0;
                        while (j < llen) {
                            if (load8(tok + 2 + j) != load8(long_name + j)) { same = 0; }
                            j = j + 1;
                        }
                        if (same == 1) {
                            if (tlen == llen + 2) { take = 1; }
                            else {
                                if (load8(tok + 2 + llen) == 61) { inline_at = 2 + llen + 1; }
                            }
                        }
                    }
                }
            }
        }
        if (inline_at > 0) {
            vec_push(out, tok + inline_at);
            found = found + 1;
        } else {
            if (take == 1) {
                if (i + 1 < n) {
                    vec_push(out, load64(av + (i + 1) * 8));
                    found = found + 1;
                    i = i + 1;
                }
            }
        }
        i = i + 1;
    }
    return found;
}

# The largest count `kriya_parse_count`, `kriya_parse_bounded` and
# `kriya_parse_nonneg_int` return: i64's maximum,
# standing for "more than any input has".
enum KriyaCount {
    KRIYA_COUNT_MAX = 9223372036854775807;
}

# Parse a null-terminated cstring as a non-negative base-10 integer: digits
# only. Returns the value, or -1 on any of: null pointer, empty string,
# non-digit character, leading sign, or a value past 2^63 - 1.
#
# ⛔ IT WRAPPED UNTIL 1.6.16: past 2^63 the value turned negative, and past 2^64
# it came back small and positive — `18446744073709551617` was 1, so
# `du -d 18446744073709551617` ran at depth 1 and `uniq -w` compared one byte,
# at exit 0. Fifteen options read through it. It refuses an overflow now, and
# the callers where GNU does something else with a large value parse with
# `kriya_parse_bounded` (below) and choose: refuse, or saturate.
fn kriya_parse_nonneg_int(s): i64 {
    if (s == 0) { return 0 - 1; }
    if (load8(s) == 0) { return 0 - 1; }
    var n: i64 = 0;
    var i: i64 = 0;
    while (load8(s + i) != 0) {
        var c = load8(s + i);
        if (c < 48) { return 0 - 1; }
        if (c > 57) { return 0 - 1; }
        var d = c - 48;
        if (n > (KRIYA_COUNT_MAX - d) / 10) { return 0 - 1; }
        n = n * 10 + d;
        i = i + 1;
    }
    return n;
}

# A decimal number in GNU's `xstrto*` shape — optional leading blanks, one
# optional `+`, digits, nothing after — as its value; -1 when it is malformed;
# -2 when it is well formed but larger than `max`, overflow past 2^63 included
# (1.6.16). It never wraps.
#
# ⚠ -2 IS A SEPARATE ANSWER ON PURPOSE: the caller decides what "too large"
# means, and GNU decides differently per option. `du -d`, `nl -i` and `cut -f`
# refuse it; `sort -k`, `uniq -f` and `nl -l` saturate it to "more than any
# input has". One parser, both policies, and neither is a wrap.
fn kriya_parse_bounded(s, max): i64 {
    if (s == 0) { return 0 - 1; }
    var i: i64 = 0;
    var ws: i64 = 1;
    while (ws == 1) {
        var c = load8(s + i);
        var sp: i64 = 0;
        if (c == 32) { sp = 1; }
        if (c >= 9) {
            if (c <= 13) { sp = 1; }
        }
        if (sp == 1) { i = i + 1; } else { ws = 0; }
    }
    if (load8(s + i) == 43) { i = i + 1; }
    var n: i64 = 0;
    var nd: i64 = 0;
    var over: i64 = 0;
    var more: i64 = 1;
    while (more == 1) {
        var c = load8(s + i);
        if (c < 48) { more = 0; }
        elif (c > 57) { more = 0; }
        else {
            var d = c - 48;
            if (n > (KRIYA_COUNT_MAX - d) / 10) { over = 1; }
            else { n = n * 10 + d; }
            nd = nd + 1;
            i = i + 1;
        }
    }
    if (nd == 0) { return 0 - 1; }
    if (load8(s + i) != 0) { return 0 - 1; }
    if (over == 1) { return 0 - 2; }
    if (n > max) { return 0 - 2; }
    return n;
}

# The value of the decimal digits at the start of `s`, SATURATING at
# KRIYA_COUNT_MAX; how many digits were read goes to `*len_p` (0 when `s` does
# not start with one).
fn kriya_count_digits(s, len_p): i64 {
    var n: i64 = 0;
    var i: i64 = 0;
    var more: i64 = 1;
    while (more == 1) {
        var c = load8(s + i);
        if (c < 48) { more = 0; }
        elif (c > 57) { more = 0; }
        else {
            var d = c - 48;
            if (n > (KRIYA_COUNT_MAX - d) / 10) { n = KRIYA_COUNT_MAX; }
            else { n = n * 10 + d; }
            i = i + 1;
        }
    }
    store64(len_p, i);
    return n;
}

# `a * b` for two non-negative counts, saturating at KRIYA_COUNT_MAX.
fn kriya_count_mul(a, b): i64 {
    if (a == 0) { return 0; }
    if (b == 0) { return 0; }
    if (a > KRIYA_COUNT_MAX / b) { return KRIYA_COUNT_MAX; }
    return a * b;
}

# A `head` / `tail` count, once the utility has taken the leading sign that
# means something to it (`head -n -5`, `tail -n +5`): optional leading
# whitespace, one optional `+`, then decimal digits and nothing after — what
# GNU's `xstrtoumax` accepts, measured on coreutils 9.11. Returns -1 when
# invalid.
#
# ⛔ IT SATURATES; `kriya_parse_nonneg_int` WRAPS. `head -n 18446744073709551617`
# printed ONE line at exit 0 until 1.6.15. GNU 9.11 clamps an oversized count to
# its maximum, which reads as "more than the input has", and this clamps to
# KRIYA_COUNT_MAX. ⚠ GNU 9.4 refused the same number (*Value too large for
# defined data type*); the newer answer is the one kept, because the number is
# well formed and only large.
#
# ⚠ The whitespace is GNU's, not an accident of this parser, and it has a trap
# the callers depend on: `tail -n ' +3'` is the LAST three lines, because only
# the FIRST byte is looked at for tail's `+`. The `+` accepted here is the one
# `xstrtoumax` swallows after the whitespace, and it means nothing.
fn kriya_parse_count(s): i64 {
    if (s == 0) { return 0 - 1; }
    var i: i64 = 0;
    var ws: i64 = 1;
    while (ws == 1) {
        var c = load8(s + i);
        var sp: i64 = 0;
        if (c == 32) { sp = 1; }
        if (c >= 9) {
            if (c <= 13) { sp = 1; }
        }
        if (sp == 1) { i = i + 1; } else { ws = 0; }
    }
    if (load8(s + i) == 43) { i = i + 1; }
    var len: i64 = 0;
    var n = kriya_count_digits(s + i, &len);
    if (len == 0) { return 0 - 1; }
    if (load8(s + i + len) != 0) { return 0 - 1; }
    return n;
}

# Parse a GNU-style duration into MILLISECONDS: an optional fractional decimal
# with an optional unit suffix — `1`, `1.5`, `0.25`, `1s`, `2m`, `1h`, `1d`.
# Returns -1 on any of: null, empty, a sign, a bad digit, a bad suffix, more
# than one decimal point, or an empty numeric part.
#
# ⛔ AND -2, DISTINCTLY, WHEN THE VALUE IS WELL-FORMED BUT OUT OF RANGE. Until
# 1.6.3 the accumulator wrapped silently, so `sleep 9999999999999999` — a
# perfectly legal 317-million-year request — came back NEGATIVE and the caller,
# which only knew "< 0 means malformed", printed *"DURATION must be a
# non-negative number"* about an operand that was one. ⚠ A single error channel
# for two different failures makes the diagnostic lie; the second return value
# is what lets `sleep` say "out of range" and saturate instead.
#
# ⚠ MILLISECONDS, not seconds, because that is `sleep_ms`'s unit and the whole
# point is sub-second waits. Fractions beyond millisecond resolution are
# truncated, not rounded — `sleep 0.0001` is a no-op rather than a surprise.
#
# The source comment in `sleep.cyr` deferred this to "the wider duration-parser  #skip-lint
# in lib/chrono.cyr". Checked at pin 6.5.35: chrono has duration CONSTRUCTORS
# (`dur_seconds`, `dur_minutes`, …) but no duration STRING parser, so there is
# nothing upstream to wait for. ~50 lines here beats a blocked follow-up.  #skip-lint
# ⛔ MICROSECONDS, AND THE MILLISECOND VERSION IS NOW A WRAPPER. Truncating
# EACH operand to whole milliseconds before summing is a wrong answer that
# summing made reachable: two thousand `0.0004` operands are 0.8 s under GNU and
# were **42 ms** here, because every one of them truncated to zero. ⚠ Sub-ms
# resolution is still lost at the syscall — `sleep_ms` is what it is — but it is
# lost ONCE, at the end, instead of once per operand.
fn kriya_parse_duration_us(s): i64 {
    if (s == 0) { return 0 - 1; }
    var len = strlen(s);
    if (len == 0) { return 0 - 1; }

    # Trailing unit suffix. Bare digits mean seconds, as POSIX `sleep` requires.
    var mult: i64 = 1000000;                    # seconds -> us
    var last = load8(s + len - 1);
    var digits = len;
    if (last == 115) { mult = 1000000;      digits = len - 1; }     # s
    elif (last == 109) { mult = 60000000;   digits = len - 1; }     # m
    elif (last == 104) { mult = 3600000000; digits = len - 1; }     # h
    elif (last == 100) { mult = 86400000000; digits = len - 1; }    # d
    else {
        # Not a suffix — must be a digit or a trailing `.`, or the operand is
        # malformed. ⚠ `1.` IS A DECIMAL. Rejecting it while accepting `.5` was
        # an accident of this one check, not a decision: the loop below already
        # handles an empty fractional part.
        if (last == 46) {
            if (len == 1) { return 0 - 1; }         # "." alone
        } else {
            if (last < 48) { return 0 - 1; }
            if (last > 57) { return 0 - 1; }
        }
    }
    if (digits == 0) { return 0 - 1; }          # a bare suffix like "s"

    var whole: i64 = 0;
    var frac_us: i64 = 0;
    # ⛔ THE FRACTION IS ACCUMULATED IN MICROSECONDS AS IT IS READ, using a
    # running place value, rather than as six digits of the UNIT scaled at the
    # end. Six digits of a DAY is a granularity of 86.4 MILLISECONDS: measured
    # before this change, `sleep 0.0000009d` returned in 2 ms where GNU slept
    # 80. ⭐ `scale` starts at one unit in µs and is divided by ten per decimal
    # place, so it reaches zero exactly when the next digit is finer than a
    # microsecond — which is the resolution `sleep_ms` can express anyway — and
    # `frac_us` can never exceed one unit, so nothing can overflow.
    var scale = mult;
    var seen_dot: i64 = 0;
    var frac_digits: i64 = 0;
    var int_digits: i64 = 0;
    # ⛔ OVERFLOW IS RECORDED, NOT RETURNED MID-SCAN. Returning -2 on the first
    # oversized digit run leaves the REST of the operand unvalidated, so
    # `sleep 99999999999999999999.1.2` — two decimal points, plainly malformed —
    # saturated to ~292 years and SLEPT, where GNU exits 1. ⚠ A hang is the
    # dangerous direction for a typo.
    var over: i64 = 0;
    var i: i64 = 0;
    while (i < digits) {
        var c = load8(s + i);
        if (c == 46) {                          # '.'
            if (seen_dot == 1) { return 0 - 1; }
            seen_dot = 1;
        } else {
            if (c < 48) { return 0 - 1; }
            if (c > 57) { return 0 - 1; }
            if (seen_dot == 0) {
                # ⛔ CHECK BEFORE MULTIPLYING. Testing the product for a wrap
                # afterwards is the bug this replaces — signed overflow has
                # already happened by then, and the wrapped value can land
                # anywhere, including a small positive.
                if (whole > KRIYA_DUR_MAX_US / 10) { over = 1; }
                if (over == 0) {
                    whole = whole * 10 + (c - 48);
                    if (whole < 0) { over = 1; }
                }
                int_digits = int_digits + 1;
            } else {
                scale = scale / 10;
                frac_us = frac_us + (c - 48) * scale;
                frac_digits = frac_digits + 1;
            }
        }
        i = i + 1;
    }
    if (int_digits == 0) {
        if (frac_digits == 0) { return 0 - 1; } # "." or "" alone
    }
    if (over == 1) { return 0 - 2; }
    if (whole > KRIYA_DUR_MAX_US / mult) { return 0 - 2; }
    return whole * mult + frac_us;
}

# Milliseconds, for any caller that wants them. ⚠ Truncates — see above for why
# `sleep` does not use this one.
fn kriya_parse_duration_ms(s): i64 {
    var us = kriya_parse_duration_us(s);
    if (us < 0) { return us; }
    return us / 1000;
}

# Parse a null-terminated cstring as an octal file mode (POSIX
# `-m` argument shape for mkdir/install/chmod). Accepts 1-4 digit
# strings of 0..7, with or without a leading `0`. Returns the
# integer mode in the low 12 bits (setuid/setgid/sticky + rwx
# triplet), or -1 on any of: null pointer, empty string, non-octal
# digit, value >= 010000 (4096).
#
# Symbolic forms (`u+rwx`, `g-w`, …) are refused, exit 2, where GNU's `mkdir
# -m` takes them (roadmap 1.8.5).
fn kriya_parse_octal_mode(s): i64 {
    if (s == 0) { return 0 - 1; }
    if (load8(s) == 0) { return 0 - 1; }
    var n: i64 = 0;
    var i: i64 = 0;
    var digits: i64 = 0;
    while (load8(s + i) != 0) {
        var c = load8(s + i);
        if (c < 48) { return 0 - 1; }
        if (c > 55) { return 0 - 1; }
        n = n * 8 + (c - 48);
        if (n > 4095) { return 0 - 1; }
        digits = digits + 1;
        i = i + 1;
    }
    if (digits > 5) { return 0 - 1; }
    return n;
}
