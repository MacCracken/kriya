# sys.cyr — kriya's portable syscall layer.
#
# Commands call these `k_*` wrappers; the wrapper dispatches to the
# host's native syscall ABI. The two targets differ in BOTH numbers
# AND shape:
#
#   - Numbers: agnos read=#5/close=#6/open=#7/… vs Linux read=#0/
#     close=#3/open=#2/…. A raw `syscall(0,fd,buf,n)` "read" on Linux
#     is `exit()` on agnos — so raw Linux-numbered syscalls are a
#     silent footgun and must never appear in a command file.
#   - Shape: agnos paths are LENGTH-COUNTED (`open(name,namelen,flags)`,
#     `stat(path,pathlen,buf)`, `rename(old,oldlen,new,newlen)`), Linux
#     paths are NUL-terminated. These wrappers take a NUL-terminated
#     path and compute the length for agnos via `strlen`.
#   - Missing primitives: agnos has no cwd / lseek / statfs / ioctl /
#     chmod / utimensat / lstat. The wrapper returns a negative error and
#     the matching `K_HAVE_*` flag is 0, so a verb refuses cleanly rather
#     than misbehaving (e.g. `df` prints "not supported on this system").
#
# The agnos branch leans on the stdlib `SYS_*` constants + native
# `sys_*` wrappers from `syscalls_x86_64_agnos.cyr` (pulled in by the
# `syscalls` dep when building `--agnos`). The Linux branch uses the
# x86_64 numbers inline (same decimal-with-comment style as fs.cyr).

# --- capability flags: 1 where the target supports the primitive ---

#ifdef CYRIUS_TARGET_AGNOS
enum KSysCap {
    K_HAVE_TTY      = 0;   # no ioctl / termios
    K_HAVE_CWD      = 0;   # no per-process cwd — paths must be absolute
    K_HAVE_LSEEK    = 0;   # no lseek
    K_HAVE_STATFS   = 0;   # no statfs
    K_HAVE_SYMLINK  = 1;   # symlink#63 (un-gated 2026-08-11; ⚠ no lstat peer — k_lstat FOLLOWS)
    K_HAVE_READLINK = 1;   # readlink#70 — no-follow; the ONLY no-follow primitive agnos has
    K_HAVE_CHMOD    = 0;   # no chmod
    K_HAVE_UTIMES   = 0;   # no utimensat
    K_HAVE_ATFAMILY = 0;   # no *at(); fs.cyr uses abspath emulation
    K_HAVE_CHOWN    = 0;   # no ownership model at all
    K_HAVE_XATTR    = 0;   # no extended attributes
}
#endif
#ifndef CYRIUS_TARGET_AGNOS
enum KSysCap {
    K_HAVE_TTY      = 1;
    K_HAVE_CWD      = 1;
    K_HAVE_LSEEK    = 1;
    K_HAVE_STATFS   = 1;
    K_HAVE_SYMLINK  = 1;
    K_HAVE_READLINK = 1;
    K_HAVE_CHMOD    = 1;
    K_HAVE_UTIMES   = 1;
    K_HAVE_ATFAMILY = 1;
    K_HAVE_CHOWN    = 1;
    K_HAVE_XATTR    = 1;
}
#endif

# AT_FDCWD (-100) as a function — Cyrius enums reject negative literals.
fn k_at_fdcwd(): i64 { return 0 - 100; }

# =====================================================================
# Uniform-shape primitives (same call signature on both targets; only
# the syscall number differs, handled by the per-target branch).
# =====================================================================

fn k_read(fd, buf, n): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    # ⛔ -2 IS "NOT YET", NOT EOF — AND EVERY kriya APPLET DEPENDS ON THIS ONE FUNCTION GETTING IT  #skip-lint
    # RIGHT. agnos 1.56.40 makes `read()` answer -2 (WOULD_BLOCK) for an empty pipe whose write end
    # is still open, reserving 0 for a genuine EOF. Callers here branch on `n <= 0`, so without this
    # retry a `wc`/`grep`/`tee` reading from a CONCURRENT producer would stop at the first moment it
    # out-ran the writer and silently report a truncated result — the worst failure shape available,
    # because the output looks plausible.
    #
    # ⛔ a4 = 0, SPELLED OUT, OR THE KERNEL READS WHATEVER r10 HOLDS. Since agnos 1.57.8 a pipe or
    # channel read BLOCKS its caller when a4 == 0 and answers -2 (O_NONBLOCK) when it is anything
    # else, and a three-argument `syscall(5, …)` leaves r10 as the last code to touch it did — so
    # the same call blocked in the kernel on one pass and spun here on the next (1.7.1). The kernel's
    # wait is woken by the writer; the spin below paid up to a 10 ms timer tick per round once
    # `#44` stopped waking other CPUs (1.57.9). Before 1.57.8 a pipe read ignores a4 and -2 still
    # comes back; those kernels are what the loop below is kept for. (On the console's fd 0, a4 has
    # chosen since 1.44.x between the non-blocking line read and — at 0 — the blocking one.)
    #
    # ⭐ THE LOOP TERMINATES ON THE KERNEL'S OWN ANSWER, so it needs no timeout: the kernel returns 0
    # the instant the last write end closes (`pipe_writers_open` scans real fd tables), and 0 exits
    # this loop. A producer that neither writes nor exits blocks us forever — which is exactly what
    # Linux's blocking `read()` does in the same situation, so it is the correct semantic, not a hang
    # we failed to bound.
    #
    # ⛔ THE WAIT IS A PREEMPTIBLE SPIN, NOT `sleep_ms#41`. Before 1.57.7 sleep_ms was
    # `preempt_disable; sti; hlt` — it would starve the very producer this read is waiting for.
    var r = syscall(SYS_READ, fd, buf, n, 0);      # agnos #5, a4 = 0: block in the kernel
    while (r == 0 - 2) {
        syscall(44);                               # donate the rest of the slice to the producer
        var sp = 0;
        while (sp < 20000) { sp = sp + 1; }        # preemptible: the timer can take us off here
        r = syscall(SYS_READ, fd, buf, n, 0);
    }
    return r;
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    return syscall(0, fd, buf, n);                 # linux read #0
    #endif
}

# ⛔ STICKY WRITE-FAILURE STATE — THE SAFETY NET FOR ~540 IGNORED RETURN VALUES.
# v1.1.8 routed every write site through `k_write` so short writes stopped silently dropping data,
# but it did not make the ~540 call sites CHECK the result, and threading a status back through
# every applet's emit path is a rewrite, not a fix. So the failure is recorded here instead and the
# dispatcher consults it once, at exit (`src/main.cyr`).
#
# ⛔ WITHOUT THIS, A FAILED WRITE PRODUCED TRUNCATED OUTPUT **AND EXIT 0** — the worst shape there
# is, because the caller's `&&` chain proceeds on a lie. Measured against GNU: `seq 1 3 >/dev/full`
# is `seq: write error: No space left on device` / exit 1 on GNU, and was silent / exit 0 here.
# Same for `echo`, `printf`, `yes` and `wc` — every applet, because they all share this one writer.
#
# ⚠ It is a NET, NOT A REPLACEMENT for per-utility error handling: the dispatcher only speaks up
# when the applet itself returned success. An applet that already detected the failure and returned
# nonzero (`cp`, `mv`, `tee` on their destination fds) keeps its own exit code and message.
#
# ⚠ EPIPE reaches here only when the PARENT has SIGPIPE at SIG_IGN. kriya never touches the
# disposition, so at the default `kriya yes | head` is killed by the signal (141, matching GNU) and
# `write` never returns -EPIPE. But SIG_IGN survives execve — only installed handlers reset to
# SIG_DFL — and POSIX forbids a non-interactive shell from resetting a signal ignored at entry, so a
# parent that ignores SIGPIPE propagates it to everything it runs. ⭐ In that environment the write
# DOES return -EPIPE, this net exits 1 with "write error: broken pipe", and **GNU exits 1 there too**
# — so it is still parity, not divergence. An earlier version of this comment said EPIPE could not
# reach here at all, which is what made a hardcoded `141` in scripts/smoke-write-errors.sh look safe;
# that assertion went red on a CI runner whose parent ignores SIGPIPE.
# ⚠ ON agnos IT IS THE ONLY ENVIRONMENT THERE IS: the kernel has no SIGPIPE, and from 1.57.9 a write
# to a pipe nobody can read answers -1, which `k_write` records as EPIPE. `kriya yes | head -1` ends
# `write error: broken pipe` / exit 1 there — GNU's exit with SIGPIPE ignored, in kriya's words.
# ⚠ Only once nobody holds the read end: agnsh 2.0.0 keeps its own copy while it reaps a pipeline,
# and the write then waits for the shell (agnoshi issue 2026-09-26-pipeline-keeps-read-end-and-hangs).
var _K_WRITE_BAD:   i64 = 0;    # 1 once any write has failed
var _K_WRITE_ERRNO: i64 = 0;    # errno of the FIRST failure

fn _k_write_note(errno): i64 {
    # First failure wins — later ones are usually consequences of the first.
    if (_K_WRITE_BAD == 0) {
        _K_WRITE_BAD = 1;
        _K_WRITE_ERRNO = errno;
    }
    return 0;
}

fn k_write_failed(): i64 { return _K_WRITE_BAD; }
fn k_write_errno(): i64 { return _K_WRITE_ERRNO; }

# ⭐ CLEAR THE NET FOR ONE ERRNO THE APPLET HAS ALREADY HANDLED ITSELF.
#
# ⛔ NARROW ON PURPOSE — it clears only when the RECORDED errno is the one named,
# so an applet cannot accidentally forgive a failure it never looked at. The
# caller is asserting "this specific failure is not an error in this mode", which
# is a claim about one errno, not a licence to ignore writes.
#
# The consumer is `tee --output-error=…-nopipe` (and `-p`), whose entire meaning
# is that EPIPE on an output is not a failure: the mode drops that output and
# exits 0. Without this the applet returns success, the dispatcher's net sees the
# sticky EPIPE and prints `write error: broken pipe` / exit 1 — the correct answer
# for every other utility and the exact opposite of what `-p` asked for.
fn k_write_forgive(errno): i64 {
    if (_K_WRITE_BAD == 0) { return 0; }
    if (_K_WRITE_ERRNO != errno) { return 0; }
    _K_WRITE_BAD = 0;
    _K_WRITE_ERRNO = 0;
    return 1;
}

# How long a write may make NO progress before `k_write` gives up (agnos only; a Linux write blocks
# in the kernel). ⛔ TIME FIRST: the bound was 20,000 rounds of `sched_yield`#44, which was a short
# spin until agnos 1.57.7 made `#44` park the CPU until the next 10 ms tick when nothing else is
# READY — and 20,000 ticks is 200 s. A producer whose consumer had gone looked hung for minutes
# (issue 2026-09-26, found by agnos 1.57.9's end review). ⚠ The round count stays as a BACKSTOP
# for a clock that does not move: before 1.57.7 `uptime_ms`#40 counted timer ticks, and a
# foreground program ran with interrupts off. A round then cost microseconds, so 500,000 of them
# is seconds too.
enum KWriteStall {
    K_WRITE_STALL_MS     = 5000;
    K_WRITE_STALL_ROUNDS = 500000;
}

# 1 when a write that has taken nothing for `rounds` calls, over `waited_ms`, should stop trying.
fn _k_write_stalled(rounds, waited_ms): i64 {
    if (waited_ms >= K_WRITE_STALL_MS) { return 1; }
    if (rounds >= K_WRITE_STALL_ROUNDS) { return 1; }
    return 0;
}

# Two bitmasks over descriptors 0..62 (agnos hands out fewer than 32), each bit
# cleared by `k_close` before the number can be reused (1.7.1):
#
# ⛔ `_k_stalled` — ONE STALL PER DESCRIPTOR, NOT ONE PER CALL. Most utilities never
# look at what `k_write` returns — `grep` writes each line in two calls and carries
# on — so a descriptor that timed out once timed out again on every later call,
# five seconds each: measured in QEMU, a 185 KB `grep` into a stuck pipe was still
# hung at 40 s with the time bound alone. And any byte that did get through after
# the first give-up would sit behind a gap. Later writes to a marked descriptor
# fail at once, with the same ENOSPC.
#
# ⛔ `_k_files` — THE DESCRIPTORS KRIYA OPENED ITSELF, which on agnos are never
# pipes: `open#7` has no FIFOs to return. agnos answers every failed write with a
# bare -1, and calling it EPIPE on a FILE let `tee -p` — whose whole meaning is
# "a pipe error is not an error" — drop a FAT output silently at 4 KiB, the
# kernel's write-back limit, and exit 0. A file's -1 is EIO, and a file that
# takes nothing is ENOSPC at once: waiting cannot make room in a file.
var _k_stalled = 0;
var _k_files   = 0;

fn _k_fd_bit(fd): i64 {
    if (fd < 0) { return 0; }
    if (fd > 62) { return 0; }
    return 1 << fd;
}

fn _k_stall_mark(fd): i64 { _k_stalled = _k_stalled | _k_fd_bit(fd); return 0; }
fn _k_stall_dead(fd): i64 {
    var b = _k_fd_bit(fd);
    if (b == 0) { return 0; }
    if ((_k_stalled & b) != 0) { return 1; }
    return 0;
}
fn _k_file_mark(fd): i64 { _k_files = _k_files | _k_fd_bit(fd); return 0; }
fn _k_is_file(fd): i64 {
    var b = _k_fd_bit(fd);
    if (b == 0) { return 0; }
    if ((_k_files & b) != 0) { return 1; }
    return 0;
}
fn _k_fd_forget(fd): i64 {
    var b = _k_fd_bit(fd);
    _k_stalled = _k_stalled & (~b);
    _k_files = _k_files & (~b);
    return 0;
}

# Write all `n` bytes of `buf` to `fd`. Returns `n`, or a NEGATIVE errno — ⛔ NEVER A SHORT COUNT.
# Seven utilities wrap this in their own "write the rest" loop (`cp`, `cut`, `head`, `sort`,
# `tail`, `tee`, `tr`) that adds a non-negative result and calls again, so a short count from a
# write that could not progress came straight back here, failed again with 0, and looped for ever:
# on agnos, 200 s per round (1.7.1). A write that takes NOTHING is ENOSPC on both targets, as
# gnulib's `full_write` calls it, and the failure is recorded for the dispatcher either way.
fn k_write(fd, buf, n): i64 {
    # write is #1 on BOTH targets, but route it for one consistent layer.
    #ifdef CYRIUS_TARGET_AGNOS
    # ⛔ A SHORT WRITE IS NORMAL ON A PIPE, AND IGNORING IT SILENTLY DROPS DATA. agnos 1.56.40's
    # `pipe_write` refuses to overwrite unread bytes (ipc bite 10), so a producer faster than its
    # consumer gets back FEWER bytes than it offered — the POSIX contract, and one every caller here
    # used to ignore because it wrote with a raw `syscall(1, …)` and never looked at the result.
    # Measured: `grep . /etc/ssl/cert.pem | wc` delivered 70347 of 185311 bytes — streaming, but
    # lossy, and the missing 62% looked exactly like a plausible answer.
    #
    # ⭐ a4 = 0 MAKES A PIPE WRITE BLOCK (agnos 1.57.9): the kernel waits until a reader makes room
    # and returns every byte — or, once no read end is open anywhere, the part it took and then -1
    # (EPIPE; agnos has no SIGPIPE). ⛔ A three-argument `syscall(1, …)` passed whatever r10 held,
    # and a non-zero r10 is O_NONBLOCK: the same write blocked on one call and short-wrote on the
    # next. Before 1.57.9 a4 is ignored, a full ring short-writes (0 once full), and the loop below
    # is the only wait there is.
    #
    # ⛔ THE STALL BOUND IS NOT A TIMEOUT ON SUCCESS. Every accepted byte resets it, so a consumer
    # that keeps reading never trips it however slowly it reads; it fires only after
    # K_WRITE_STALL_MS with NO progress at all. From 1.57.9 a pipe never gets here — it blocks or
    # answers -1 — so what is left is an older kernel's full ring, whose reader may be gone (there
    # was no reader-gone signal then) or may have stopped reading for five seconds, and an inherited
    # descriptor that is not a pipe and takes nothing.
    # ⛔ The wait is a preemptible spin, not `sleep_ms#41`: before 1.57.7 that was
    # `preempt_disable; sti; hlt` and would starve the very consumer we are waiting for.
    if (_k_stall_dead(fd) == 1) { return 0 - 28; }  # it stalled out once already
    var done = 0;
    var rounds = 0;                                # consecutive calls that took nothing
    var since = 0;                                 # uptime_ms when the first of them returned
    while (done < n) {
        var r = syscall(1, fd, buf + done, n - done, 0);   # a4 = 0: a pipe write blocks
        if (r > 0) { done = done + r; rounds = 0; }
        elif (r < 0) {
            # ⚠ agnos returns a bare -1 with no errno. On a descriptor kriya did not open — the
            # stdout and stderr it inherited — its ABI names one cause, no read end open: EPIPE
            # on a pipe, "peer gone" on a channel. On a file kriya opened it is an I/O failure.
            var e: i64 = 32;
            if (_k_is_file(fd) == 1) { e = 5; }
            _k_write_note(e);
            return 0 - e;
        } elif (_k_is_file(fd) == 1) {
            _k_write_note(28);                     # a file that takes nothing: ENOSPC at once
            return 0 - 28;
        } else {
            if (rounds == 0) { since = syscall(SYS_UPTIME_MS); }
            rounds = rounds + 1;
            if (_k_write_stalled(rounds, syscall(SYS_UPTIME_MS) - since) == 1) {
                _k_write_note(28);
                _k_stall_mark(fd);
                return 0 - 28;
            }
            syscall(44);
            var sp = 0;
            while (sp < 2000) { sp = sp + 1; }
        }
    }
    return done;
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    # ⛔ THE LINUX ARM LOOPS TOO. It used to be a bare `syscall(1, fd, buf, n)`, which made the two
    # targets disagree about the one thing this function exists to guarantee: agnos retried a short
    # write, Linux dropped the remainder on the floor. Linux `write(2)` returns a short count
    # whenever a signal lands after some bytes are already transferred, and on a pipe past PIPE_BUF —
    # so this is a real path, not a theoretical one, and it loses data silently when it fires.
    var done = 0;
    while (done < n) {
        var r = syscall(1, fd, buf + done, n - done);
        if (r > 0) { done = done + r; }
        else {
            if (r < 0) {
                # EINTR (-4) means nothing was written and the call is restartable; anything else
                # is real. No stall counter is needed on this arm — a blocking Linux fd either makes
                # progress, errors, or blocks in the kernel.
                if (r != (0 - 4)) {
                    _k_write_note(0 - r);
                    return r;
                }
            } else {
                # write() answered 0 with bytes still outstanding: no progress is possible. ENOSPC,
                # as gnulib's `full_write` says — and not the short count it used to return.
                _k_write_note(28);
                return 0 - 28;
            }
        }
    }
    return done;
    #endif
}

# `count` copies of the byte `ch` on `fd`, a buffer at a time. Returns `count`, or
# the negative errno of a failed write — `k_write` never returns a short count.
#
# ⛔ THREE PADDERS WROTE ONE BYTE PER SYSTEM CALL: `nl`'s (buffered at 1.6.16),
# `printf`'s and `stat`'s. `printf %100000000d 5` took 50 s against GNU's 31 ms,
# and a width near 2^63 never finished at all (1.6.17).
# ⚠ It stops at the first failed write: a two-gigabyte field on a closed pipe
# must not turn into half a million failing system calls.
var _k_fill_buf = 0;
var _k_fill_ch  = 256;     # the byte the buffer holds; 256 = none yet

fn k_write_fill(fd, ch, count): i64 {
    if (count <= 0) { return 0; }
    if (_k_fill_buf == 0) { _k_fill_buf = alloc(4096); }
    if (_k_fill_ch != ch) {
        var k: i64 = 0;
        while (k < 4096) { store8(_k_fill_buf + k, ch); k = k + 1; }
        _k_fill_ch = ch;
    }
    var left = count;
    while (left > 0) {
        var chunk = left;
        if (chunk > 4096) { chunk = 4096; }
        var r = k_write(fd, _k_fill_buf, chunk);
        if (r < 0) { return r; }
        left = left - chunk;
    }
    return count;
}

fn k_close(fd): i64 {
    _k_fd_forget(fd);
    #ifdef CYRIUS_TARGET_AGNOS
    return syscall(SYS_CLOSE, fd);                 # agnos #6
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    return syscall(3, fd);                         # linux close #3
    #endif
}

# open(NUL-terminated path, flags, mode) -> fd / <0. On agnos `mode` is
# dropped (no mode bits) and the length is computed from the path.
fn k_open(path, flags, mode): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    # Translate Linux open-flag bits to agnos AO_* bits (agnos open#7 = name,
    # namelen, flags). Access mode (low 2 bits RDONLY=0/WRONLY=1/RDWR=2) and
    # O_TRUNC(0x200) match; O_CREAT and O_DIRECTORY differ; O_APPEND/O_NOFOLLOW/
    # O_CLOEXEC have no agnos analogue (dropped). `mode` is unused on agnos.
    var af = flags & 0x3;                                  # access mode (same low 2 bits)
    if ((flags & 0x40) != 0)    { af = af | 0x100; }       # Linux O_CREAT(0x40) -> agnos AO_CREAT(0x100)
    if ((flags & 0x200) != 0)   { af = af | 0x200; }       # O_TRUNC (0x200 on both)
    if ((flags & 0x10000) != 0) { af = af | 0x800; }       # Linux O_DIRECTORY(0x10000) -> agnos AO_DIRECTORY(0x800)
    var fd = syscall(SYS_OPEN, path, strlen(path), af);
    if (fd >= 0) { _k_file_mark(fd); }                     # never a pipe: see `_k_files`
    return fd;
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    return syscall(2, path, flags, mode);                  # linux open #2 (path,flags,mode)
    #endif
}

# getdents -> fills `buf` with a stream of Linux `linux_dirent64` records
# (d_ino@0:8, d_off@8:8, d_reclen@16:u16, d_type@18:u8, d_name@19:NUL-term),
# the canonical format fs.cyr's fs_dent_* accessors read. On agnos the kernel
# emits a DIFFERENT packed record (reclen@0:u16, type@2, namelen@3, ino@4:u32,
# name@8 namelen-bytes NUL-padded but not guaranteed terminated); we translate
# the stream here so every caller sees one format. agnos records are ~11 B
# smaller than Linux's, so we read agnos into a temp capped at half `bufsize`
# to guarantee the expanded translation fits.
fn k_getdents(fd, buf, bufsize): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    var cap = bufsize / 2;
    if (cap < 64) { cap = 64; }
    var tmp = alloc(cap);
    var ar = syscall(SYS_GETDENTS, fd, tmp, cap);          # agnos #29
    if (ar <= 0) { return ar; }                            # 0 = end of dir, <0 = error
    var ti = 0;
    var wo = 0;
    while (ti < ar) {
        var arec = tmp + ti;
        var areclen = load8(arec + 0) | (load8(arec + 1) << 8);   # agnos d_reclen (u16)
        if (areclen < 8) { ti = ar; }                      # malformed — stop
        else {
            var atype    = load8(arec + 2);                # already a DT_* value
            var anamelen = load8(arec + 3);
            # agnos d_ino is a u32 at +4 — assemble from bytes (no load32 in kriya).
            var aino = load8(arec + 4) | (load8(arec + 5) << 8) | (load8(arec + 6) << 16) | (load8(arec + 7) << 24);
            # Linux record: 19 header + namelen + 1 NUL, rounded up to 8.
            var lreclen = 19 + anamelen + 1;
            lreclen = (lreclen + 7) & (0 - 8);
            if (wo + lreclen > bufsize) { ti = ar; }        # out of room — return what we have
            else {
                var rec = buf + wo;
                store64(rec + 0, aino);                     # d_ino
                store64(rec + 8, wo + lreclen);             # d_off (synthetic next offset)
                store8(rec + 16, lreclen & 0xFF);           # d_reclen lo
                store8(rec + 17, (lreclen >> 8) & 0xFF);    # d_reclen hi
                store8(rec + 18, atype);                    # d_type
                var k = 0;
                while (k < anamelen) { store8(rec + 19 + k, load8(arec + 8 + k)); k = k + 1; }
                var pp = 19 + anamelen;
                while (pp < lreclen) { store8(rec + pp, 0); pp = pp + 1; }   # NUL-terminate + pad
                wo = wo + lreclen;
                ti = ti + areclen;
            }
        }
    }
    return wo;
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    # ⚠ Named constant, not the bare 217 — cyrlint flags a raw getdents because
    # the number and arity differ per target, and it is right to.
    return syscall(SYS_GETDENTS64, fd, buf, bufsize);
    #endif
}

# ⛔ DO NOT REPLACE `k_getdents` WITH stdlib `io.cyr`'s `xgetdents`, which is what
# cyrlint suggests for agnos-bound directory code. `xgetdents` calls agnos'
# `sys_getdents` and hands back the RAW AGNOS RECORD — reclen@0, type@2,
# namelen@3, a u32 ino@4, a name at +8 that is not guaranteed NUL-terminated.
# Every caller here reads `linux_dirent64` through `fs_dent_reclen` /
# `fs_dent_type` / the name accessor, so the swap would silently mis-parse every
# directory entry on agnos: wrong sizes, wrong types, unterminated names.
# The translation above is the reason this wrapper exists, and it is the part
# `xgetdents` does not do.

# =====================================================================
# Path metadata / mutation. NUL-terminated path in; agnos counts length.
# =====================================================================

# stat fills the caller's buffer in the canonical Linux 144-byte layout
# (mode@24, nlink@16, size@48, ino@8, blocks@64, mtime@88) on BOTH targets,
# so fs.cyr's fs_is_dir/fs_perms/etc. and every caller read one struct shape.
# agnos stat#33 returns a packed 48-byte struct (mode@0, nlink@8, size@16,
# ino@24, blocks@32, mtime@40) — translated here. Mode bits are standard Unix
# on both, so the S_IF* masks need no change.
#ifdef CYRIUS_TARGET_AGNOS
fn _k_agnos_stat(path, buf): i64 {
    var a[48];                                             # agnos packed stat
    var r = syscall(SYS_STAT, path, strlen(path), &a);     # agnos #33 (path,pathlen,statbuf)
    if (r != 0) { return r; }
    var z = 0;
    while (z < 144) { store8(buf + z, 0); z = z + 1; }     # clear the Linux struct first
    store64(buf +  8, load64(&a + 24));                    # st_ino    <- agnos ino@24
    store64(buf + 16, load64(&a +  8));                    # st_nlink  <- agnos nlink@8
    store64(buf + 24, load64(&a +  0));                    # st_mode   <- agnos mode@0
    store64(buf + 48, load64(&a + 16));                    # st_size   <- agnos size@16
    store64(buf + 64, load64(&a + 32));                    # st_blocks <- agnos blocks@32
    store64(buf + 88, load64(&a + 40));                    # st_mtime  <- agnos mtime@40
    return 0;
}
#endif

fn k_stat(path, buf): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    return _k_agnos_stat(path, buf);
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    return syscall(262, k_at_fdcwd(), path, buf, 0);       # linux newfstatat(AT_FDCWD,path,buf,0)
    #endif
}

# lstat — like stat but does NOT follow a final symlink. agnos has no
# symlinks, so it is identical to k_stat there.
# ⚠ NOT a true lstat on agnos, and since the 2026-08-11 K_HAVE_SYMLINK un-gate that is no longer
# harmless. agnos has no lstat peer at all, so this routes to path-based sys_stat#33 — which
# FOLLOWS the final symlink. Callers that exist specifically to tell a symlink-to-directory apart
# from a directory (_ln_is_real_dir) therefore get the wrong answer on agnos for that one shape.
# The plain `ln -s a b` path does not touch it. agnos roadmap carries `lstat` as unslotted-pending-
# a-consumer; this is that consumer. Until it lands, readlink#70 is the only no-follow primitive.
fn k_lstat(path, buf): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    return _k_agnos_stat(path, buf);                       # ⚠ FOLLOWS symlinks — see above
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    return syscall(262, k_at_fdcwd(), path, buf, 256);     # linux AT_SYMLINK_NOFOLLOW=256
    #endif
}

fn k_mkdir(path, mode): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    return syscall(SYS_MKDIR, path, strlen(path));         # agnos #9 (path,pathlen) — no mode
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    return syscall(83, path, mode);                        # linux mkdir #83
    #endif
}

fn k_rmdir(path): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    return syscall(SYS_RMDIR, path, strlen(path));         # agnos #10
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    return syscall(84, path);                              # linux rmdir #84
    #endif
}

fn k_unlink(path): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    return syscall(SYS_UNLINK, path, strlen(path));        # agnos #30
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    return syscall(87, path);                              # linux unlink #87
    #endif
}

fn k_rename(oldp, newp): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    return syscall(SYS_RENAME, oldp, strlen(oldp), newp, strlen(newp));  # agnos #31 (a4=r10)
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    return syscall(82, oldp, newp);                        # linux rename #82
    #endif
}

fn k_link(target, linkpath): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    return syscall(SYS_LINK, target, strlen(target), linkpath, strlen(linkpath));  # agnos #32 (a4)
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    return syscall(86, target, linkpath);                  # linux link #86
    #endif
}

# =====================================================================
# Primitives absent on agnos. Linux: native syscall. agnos: refuse with
# a negative error (callers gate on K_HAVE_*). ENOSYS=-38 by convention.
# =====================================================================

fn k_lseek(fd, off, whence): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    return 0 - 38;                                         # no lseek on agnos (ENOSYS)
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    return syscall(8, fd, off, whence);                    # linux lseek #8
    #endif
}

# isatty(fd) -> 1 if a terminal, else 0. Linux probes via ioctl(TCGETS);
# agnos has no ioctl/termios so nothing is ever a tty.
fn k_isatty(fd): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    return 0;
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    var tio[16];
    var r = syscall(16, fd, 21505, &tio);                  # SYS_IOCTL, TCGETS=21505
    if (r == 0) { return 1; }
    return 0;
    #endif
}

# getcwd(buf, sz) -> length-incl-NUL / <0. agnos has no cwd; the working
# directory is always root, so report "/".
fn k_getcwd(buf, sz): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    if (sz < 2) { return 0 - 36; }                         # ENAMETOOLONG
    store8(buf, 47);                                       # '/'
    store8(buf + 1, 0);
    return 2;                                              # length incl. NUL, matching Linux getcwd
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    return syscall(79, buf, sz);                           # linux getcwd #79
    #endif
}

fn k_statfs(path, buf): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    return 0 - 38;                                         # no statfs on agnos
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    return syscall(137, path, buf);                        # linux statfs #137
    #endif
}

# ⛔ The two arms below MUST stay symbolic on the agnos side. agnos reuses the Linux numbers for
# something else entirely — 88 is gpu_fill_rect and 89 is gpu_caps — so a "just flip the capability
# flag" un-gate that left `syscall(88, …)` reachable would have `ln -s` painting a rectangle. The
# named SYS_SYMLINK / SYS_READLINK resolve to 63 / 70 on agnos and to the right numbers on Linux.
# ⚠ agnos also takes explicit LENGTHS (4-arg, a4 in r10) where Linux takes NUL-terminated pointers,
# and it answers 0/-1 rather than a negative errno — see the note on _ln_report's caller.
fn k_symlink(target, linkpath): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    return syscall(SYS_SYMLINK, target, strlen(target), linkpath, strlen(linkpath));  # agnos #63 (a4)
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    return syscall(88, target, linkpath);                  # linux symlink #88
    #endif
}

# agnos readlink#70 is the NO-FOLLOW introspection peer of symlink#63: it resolves the final path
# component WITHOUT following it and returns the target byte count (NOT NUL-terminated) or -1.
# ⚠ It is the ONLY no-follow primitive on agnos — there is no lstat, and path-based sys_stat#33
# follows. So anything that must SEE a link rather than its target has to come through here.
fn k_readlink(path, buf, bufsize): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    return syscall(SYS_READLINK, path, strlen(path), buf, bufsize);   # agnos #70 (a4)
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    return syscall(89, path, buf, bufsize);                # linux readlink #89
    #endif
}

# access(path, mode) -> 0 if the access check passes. agnos has no
# permission model, so any existing path is treated as accessible
# (X_OK/R_OK/W_OK all collapse to "does it exist?"). mode bits: R=4 W=2 X=1.
fn k_access(path, mode): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    # ⛔ 144, NOT 48 — this buffer is `k_stat`'s OUTPUT, not agnos's wire format. The 48-byte
    # packed struct agnos #33 returns never reaches a caller: `_k_agnos_stat` takes it in its own
    # `var a[48]` and TRANSLATES it, zeroing and filling the canonical Linux 144-byte layout at
    # `buf` on both targets (see the comment above `_k_agnos_stat`). A function-local `var X[N]`
    # is N BYTES, so `var st[48]` gave the translator a 48-byte destination for a 144-byte write
    # and smashed 96 bytes of this frame — measured on the host with the same shape: the very next
    # local sits exactly 48 bytes away and the write walks straight through it into the return
    # address (SIGSEGV). Every other stat buffer in kriya is already `[144]`; this was the one
    # outlier, and the `# agnos 48-byte stat` comment is what made it look deliberate.
    # ⚠ agnos-arm only, and reachable from all four PATH-probing utilities — `which`, `env`,
    # `xargs` and `find -exec` all resolve a command through `k_access(candidate, 1)`.
    var st[144];                                           # canonical Linux stat layout (both targets)
    if (k_stat(path, &st) == 0) { return 0; }
    return 0 - 2;                                          # ENOENT
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    return syscall(21, path, mode);                        # linux access #21
    #endif
}

fn k_chmod(path, mode): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    return 0 - 38;                                         # no mode bits on agnos
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    return syscall(90, path, mode);                        # linux chmod #90
    #endif
}

# utimensat(dirfd, path, times, flags) — set atime/mtime. agnos has no
# such call; touch refuses the timestamp-set path there.
fn k_utimensat(dirfd, path, times, flags): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    return 0 - 38;                                         # no utimensat on agnos
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    return syscall(280, dirfd, path, times, flags);        # linux utimensat #280
    #endif
}

# --- ownership ------------------------------------------------------
#
# ⛔ THE FD FORMS ARE THE POINT, not a convenience. The M8 security audit
# (`docs/audit/2026-05-18-security.md`, row 35354) requires that anything
# restoring metadata onto a file cp just wrote acts on the OPEN DESCRIPTOR
# rather than re-resolving the path — a path-based restore re-walks every
# component and can land on a file substituted between the write and the
# restore. `cp` holds both descriptors at the moment it needs them, so
# there is no reason to reach for a path here.
#
# ⚠ agnos has no ownership model at all: no uid, no gid, no chown. These
# return -ENOSYS there and the callers gate on `K_HAVE_CHOWN`.

# The EFFECTIVE uid. ⚠ Used for exactly one decision: whether a failed ownership
# preservation is worth reporting. GNU is silent for an unprivileged caller —
# `cp -p` of a root-owned file is an everyday command and cannot succeed — and
# complains when it HAD the privilege and still failed, which is the case a
# root-run backup needs to hear about.
fn k_geteuid(): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    return 0;                                              # no uid model; treat as unprivileged-equivalent
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    return syscall(107);                                   # linux geteuid #107
    #endif
}

fn k_fchown(fd, uid, gid): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    return 0 - 38;                                         # no ownership on agnos
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    return syscall(93, fd, uid, gid);                      # linux fchown #93
    #endif
}

# fchownat with AT_SYMLINK_NOFOLLOW is how a SYMLINK's own ownership is set —
# there is no fd to hold for a symlink, so this is the one ownership call that
# must take a path. ⚠ `flags` is the caller's: 256 (AT_SYMLINK_NOFOLLOW) for a
# symlink, 0 to follow.
fn k_fchownat(dirfd, path, uid, gid, flags): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    return 0 - 38;                                         # no ownership on agnos
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    return syscall(260, dirfd, path, uid, gid, flags);     # linux fchownat #260
    #endif
}

fn k_fchmod(fd, mode): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    return 0 - 38;                                         # no mode bits on agnos
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    return syscall(91, fd, mode);                          # linux fchmod #91
    #endif
}

# `fchmodat2` (Linux 6.6+) — the one chmod that honours AT_EMPTY_PATH, so it can
# act on an O_PATH descriptor, which `fchmod` refuses with EBADF. ⚠ 452 on every
# architecture: syscalls added since 5.1 share one number. An older kernel
# answers -ENOSYS and the caller falls back (`fs_fd_chmod`).
fn k_fchmodat2(dirfd, path, mode, flags): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    return 0 - 38;                                         # no mode bits on agnos
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    return syscall(452, dirfd, path, mode, flags);         # linux fchmodat2 #452
    #endif
}

# --- extended attributes --------------------------------------------
#
# All three fd-anchored, for the reason above. ⚠ The size protocol is the
# kernel's and it is easy to get wrong: passing `size == 0` returns the number
# of bytes the answer NEEDS without writing anything, and passing a buffer too
# small returns -ERANGE (-34) rather than truncating. Both callers below probe
# with 0 first.
#
# ⚠ `flistxattr` returns a buffer of NUL-TERMINATED names laid end to end, not
# an array — the length is the total byte count, and the caller walks it.

fn k_flistxattr(fd, list, size): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    return 0 - 38;                                         # no xattrs on agnos
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    return syscall(196, fd, list, size);                   # linux flistxattr #196
    #endif
}

fn k_fgetxattr(fd, name, value, size): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    return 0 - 38;
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    return syscall(193, fd, name, value, size);            # linux fgetxattr #193
    #endif
}

# `statx(2)`, for what `stat(2)` has no field for — the birth time. ⚠ agnos has no
# statx and declines; aarch64's number differs (291), which is roadmap 1.7.4.
fn k_statx(dirfd, path, flags, mask, buf): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    return 0 - 38;
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    return syscall(332, dirfd, path, flags, mask, buf);   # linux statx #332
    #endif
}

# By PATH, following symlinks — `ls`'s `ca` probe, which must not need read
# permission on the file (an fd-anchored read would).
fn k_getxattr(path, name, value, size): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    return 0 - 38;
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    return syscall(191, path, name, value, size);          # linux getxattr #191
    #endif
}

# lgetxattr(2): the attribute of a symlink ITSELF, never its target — what
# `stat %C` reads for a link it was not told to follow (`-L`) (1.6.16).
# ⚠ 192 on x86-64 and 9 on aarch64; see roadmap 1.7.4 on raw numbers.
fn k_lgetxattr(path, name, value, size): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    return 0 - 38;
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    return syscall(192, path, name, value, size);          # linux lgetxattr #192
    #endif
}

fn k_fsetxattr(fd, name, value, size, flags): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    return 0 - 38;
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    return syscall(190, fd, name, value, size, flags);     # linux fsetxattr #190
    #endif
}

# By PATH. ⚠ Used for exactly one path, `/proc/self/fd/N` — the route to an
# O_PATH descriptor, which has no xattr call of its own — so it still names the
# open file rather than re-resolving a name (see `fs_fd_setxattr`).
fn k_setxattr(path, name, value, size, flags): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    return 0 - 38;
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    return syscall(188, path, name, value, size, flags);   # linux setxattr #188
    #endif
}
